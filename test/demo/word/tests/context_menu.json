      }
    },
    {
      "type": "resize",
      "width": 700,
      "height": 400
    },
    {
      "type": "script",
      "js": "document.getElementById('stage').scrollTop=180;"
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface p",
        "offset_x": 25,
        "offset_y": 10
      },
      "button": 1
    },
    {
      "type": "assert_script",
      "js": "var b=document.getElementById('word-context-menu').getBoundingClientRect();b.x>=0&&b.y>=0&&b.x+b.width<=700&&b.y+b.height<=400"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/context-menu-compact.png"
    },
    {
      "type": "key_press",
