      "target": {
        "selector": "#tab-view"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#view-reading"
      }
    },
    {
      "type": "script",
      "js": "var t=document.querySelector('#edit-surface strong').firstChild;window.getSelection().setBaseAndExtent(t,0,t,5);"
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface p",
        "offset_x": 25,
        "offset_y": 10
      },
      "button": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#word-context-menu"
      },
      "count": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#context-cut[disabled],#context-paste[disabled],#context-bold[disabled]"
      },
      "count": 3
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-copy"
      }
    },
    {
      "type": "assert_clipboard",
      "equals": "Hello"
