      "type": "click",
      "target": {
        "selector": "#context-select-all"
      }
    },
    {
      "type": "assert_script",
      "js": "window.getSelection().toString()==='Hello Word'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface p",
        "offset_x": 25,
        "offset_y": 10
      },
      "button": 1
