{
  "name": "Word document context menu preserves ranges, edits through commands, supports keyboard and read mode, and stays in bounds",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1280,
    "height": 800
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#new"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#edit-surface p"
      },
      "text": "Hello Word"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#edit-surface p"
      },
      "equals": "Hello Word"
    },
    {
      "type": "set_editing_selection",
      "target": {
        "selector": "#edit-surface p"
      },
      "start": 0,
      "end": 5
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface p",
        "offset_x": 25,
        "offset_y": 10
      },
      "button": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#word-context-menu"
      },
      "count": 1
    },
    {
      "type": "assert_selection",
      "is_collapsed": false,
      "check_dom": true
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#context-copy"
      },
      "attribute": "role",
      "equals": "menuitem"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/context-menu.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-copy"
      }
    },
    {
      "type": "assert_clipboard",
      "equals": "Hello"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#word-context-menu"
      },
      "count": 0
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#edit-surface p"
      },
      "equals": "Hello Word"
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface p",
        "offset_x": 25,
        "offset_y": 10
      },
      "button": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-cut"
      }
    },
    {
      "type": "assert_clipboard",
      "equals": "Hello"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#edit-surface p"
      },
      "equals": " Word"
    },
    {
      "type": "assert_selection",
      "is_collapsed": true,
      "check_dom": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface p",
        "offset_x": 25,
        "offset_y": 10
      },
      "button": 1
    },
    {
