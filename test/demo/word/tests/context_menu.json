      "target": {
        "selector": "#edit-surface p"
      },
      "equals": "Hello Word"
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface p",
        "offset_x": 25,
        "offset_y": 10
      },
      "button": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-undo"
      }
    },
    {
      "type": "assert_text",
