{
  "name": "Word ribbon groups collapse into command menus",
  "html": "test/demo/word/word.ls",
  "viewport": {"width": 920, "height": 540},
  "events": [
    {"type": "wait", "ms": 100},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return getComputedStyle(r).overflowX==='visible'&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right&&r.querySelectorAll('.ribbon-group[data-compact=true]').length>0})()"},
    {"type": "click", "target": {"selector": ".group-editing[data-compact=true] .ribbon-group-trigger"}},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.group-editing'),t=g.querySelector('.group-tools'),p=t.getBoundingClientRect(),r=document.querySelector('.ribbon-groups').getBoundingClientRect();return g.getAttribute('data-open')==='true'&&g.querySelector('.ribbon-group-trigger').getAttribute('aria-expanded')==='true'&&getComputedStyle(t).position==='absolute'&&p.width>100&&p.left>=r.left&&p.right<=r.right})()"},
    {"type": "render", "file": "temp/word-ribbon-compact.png"},
    {"type": "resize", "width": 900, "height": 540},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.group-editing'),s=getComputedStyle(g.querySelector('.group-tools'));return g.getAttribute('data-compact')==='true'&&g.getAttribute('data-open')===null&&s.display==='none'&&s.position!=='absolute'&&(!s.boxShadow||s.boxShadow==='none')})()"},
    {"type": "click", "target": {"selector": ".group-editing[data-compact=true] .ribbon-group-trigger"}},
    {"type": "click", "target": {"selector": "#ribbon-find"}},
    {"type": "assert_script", "js": "document.querySelector('.ribbon-group[data-open=true]')===null"},
    {"type": "resize", "width": 1000, "height": 600},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return r.querySelectorAll('.ribbon-group[data-compact=true]').length>0&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "resize", "width": 1440, "height": 600},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return getComputedStyle(r).overflowX==='visible'&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right&&r.querySelectorAll('.ribbon-group[data-compact=true]').length===0})()"},
    {"type": "wait", "ms": 50},
    {"type": "script", "js": "window.stableWrites=[];window.stableObserver=new MutationObserver(ms=>stableWrites.push(...ms));stableObserver.observe(document.querySelector('.ribbon-groups'),{subtree:true,attributes:true,attributeFilter:['data-compact','data-layout-key','data-measured-tab','data-measured-labels']})"},
    {"type": "resize", "width": 1430, "height": 600},
    {"type": "resize", "width": 1420, "height": 600},
    {"type": "resize", "width": 1410, "height": 600},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups'),ms=stableWrites.concat(stableObserver.takeRecords());stableObserver.disconnect();return ms.length===0&&r.querySelectorAll('.ribbon-group[data-compact=true]').length===0&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "script", "js": "window.ribbonWrites=[];window.ribbonObserver=new MutationObserver(ms=>{for(let m of ms)ribbonWrites.push(m)});ribbonObserver.observe(document.querySelector('.ribbon-groups'),{subtree:true,attributes:true,attributeOldValue:true,attributeFilter:['data-compact']})"},
    {"type": "resize", "width": 1000, "height": 600},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups'),ms=ribbonWrites.concat(ribbonObserver.takeRecords());window.compactAt1000=r.querySelectorAll('.ribbon-group[data-compact=true]').length;return window.compactAt1000>0&&ms.length===window.compactAt1000&&ms.every(m=>m.oldValue===null&&m.target.getAttribute('data-compact')==='true')&&r.lastElementChild.getAttribute('data-compact')==='true'&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "script", "js": "window.ribbonWrites=[]"},
    {"type": "resize", "width": 800, "height": 600},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups'),ms=ribbonWrites.concat(ribbonObserver.takeRecords()),n=r.querySelectorAll('.ribbon-group[data-compact=true]').length;window.compactAt800=n;return n>=window.compactAt1000&&ms.length===n-window.compactAt1000&&ms.every(m=>m.oldValue===null&&m.target.getAttribute('data-compact')==='true')&&r.lastElementChild.getAttribute('data-compact')==='true'&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "script", "js": "window.ribbonWrites=[]"},
    {"type": "resize", "width": 1440, "height": 600},
    {"type": "assert_script", "js": "(()=>{let ms=ribbonWrites.concat(ribbonObserver.takeRecords());return document.querySelectorAll('.ribbon-groups .ribbon-group[data-compact=true]').length===0&&ms.length===compactAt800&&ms.every(m=>m.oldValue==='true'&&m.target.getAttribute('data-compact')===null)})()"},
    {"type": "script", "js": "ribbonObserver.disconnect()"},
    {"type": "click", "target": {"selector": "#tab-insert"}},
    {"type": "resize", "width": 800, "height": 600},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return getComputedStyle(r).overflowX==='visible'&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right&&r.querySelectorAll('.ribbon-group[data-compact=true]').length>0})()"},
    {"type": "click", "target": {"selector": ".insert-ribbon .ribbon-group[data-compact=true] .ribbon-group-trigger"}},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.insert-ribbon .ribbon-group[data-open=true]');return g!=null&&g.querySelector('.group-tools').getBoundingClientRect().width>100})()"},
    {"type": "render", "file": "temp/word-ribbon-insert-compact.png"},
    {"type": "click", "target": {"selector": "#tab-layout"}},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "click", "target": {"selector": "#tab-references"}},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "click", "target": {"selector": "#tab-review"}},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "click", "target": {"selector": "#tab-view"}},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "click", "target": {"selector": "#tab-home"}},
    {"type": "wait", "ms": 100},
    {"type": "click", "target": {"selector": "#new"}},
    {"type": "wait", "ms": 100},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.ribbon-groups');return document.getElementById('word').getAttribute('data-tab')==='Home'&&r.querySelectorAll('.ribbon-group[data-compact=true]').length>0&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right})()"},
    {"type": "click", "target": {"selector": ".group-editing[data-compact=true] .ribbon-group-trigger"}},
    {"type": "assert_script", "js": "document.querySelector('.group-editing').getAttribute('data-open')==='true'"},
    {"type": "resize", "width": 1440, "height": 600},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.group-editing'),s=getComputedStyle(g.querySelector('.group-tools'));return g.getAttribute('data-compact')===null&&g.getAttribute('data-open')===null&&s.position!=='absolute'&&(!s.boxShadow||s.boxShadow==='none')})()"},
    {"type": "render", "file": "temp/word-ribbon-expanded.png"},
    {"type": "assert_pixel", "x": 1300, "y": 158, "min_r": 250, "min_g": 250, "min_b": 250}
  ]
}
