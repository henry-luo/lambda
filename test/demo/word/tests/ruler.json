{
  "name": "Word ruler stays visible across pages, zoom and horizontal scrolling",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1440,
    "height": 720
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#new"
      }
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#edit-surface p"
      },
      "text": "First page"
    },
    {
      "type": "key_combo",
      "key": "Enter",
      "mods_str": "ctrl"
    },
    {
      "type": "type_physical",
      "text": "Second page"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-page"
      },
      "count": 2
    },
    {
      "type": "scroll",
      "target": {
        "selector": "#stage",
        "offset_x": 600,
        "offset_y": 300
      },
      "dx": 0,
      "dy": -23
    },
    {
      "type": "assert_script",
      "js": "var s=document.getElementById(\"stage\"),r=document.querySelector(\".ruler\").getBoundingClientRect(),b=s.getBoundingClientRect(),c=document.querySelector(\".canvas-panel\").getBoundingClientRect();s.scrollTop>1000 && r.top>=c.top && Math.abs(r.bottom-b.top)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\"),b=r.getBoundingClientRect();r.contains(document.elementFromPoint(b.left+b.width/2,b.top+5))"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word-ruler-second-page.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#status-zoom-in"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#status-zoom-in"
      }
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),s=document.getElementById(\"stage\").getBoundingClientRect();Math.abs(r.bottom-s.top)<1 && r.top>=document.querySelector(\".canvas-panel\").getBoundingClientRect().top"
    },
    {
      "type": "resize",
      "width": 800,
      "height": 720
    },
    {
      "type": "scroll",
      "target": {
        "selector": "#stage",
        "offset_x": 200,
        "offset_y": 200
      },
      "dx": -4,
      "dy": 0
    },
    {
      "type": "assert_script",
      "js": "var s=document.getElementById(\"stage\"),c=document.getElementById(\"canvas-chrome\");s.scrollLeft>0 && Math.abs(s.scrollLeft-c.scrollLeft)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),s=document.getElementById(\"stage\").getBoundingClientRect();Math.abs(r.bottom-s.top)<1 && r.top>=document.querySelector(\".canvas-panel\").getBoundingClientRect().top"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word-ruler-horizontal.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#exit-focus"
      }
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),s=document.getElementById(\"stage\").getBoundingClientRect();Math.abs(r.bottom-s.top)<1 && r.top>=document.querySelector(\".canvas-panel\").getBoundingClientRect().top"
    },
    {
      "type": "click",
      "target": {
        "selector": "#exit-focus"
      }
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),s=document.getElementById(\"stage\").getBoundingClientRect();Math.abs(r.bottom-s.top)<1 && r.top>=document.querySelector(\".canvas-panel\").getBoundingClientRect().top"
    },
    {
      "type": "resize",
      "width": 1440,
      "height": 720
    },
    {
      "type": "click",
      "target": {
        "selector": "#status-zoom-out"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#status-zoom-out"
      }
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),s=document.getElementById(\"stage\").getBoundingClientRect();Math.abs(r.bottom-s.top)<1 && r.top>=document.querySelector(\".canvas-panel\").getBoundingClientRect().top"
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface .word-page[data-page=\"2\"] p"
      },
      "scroll_into_view": true
    },
    {
      "type": "key_press",
      "key": "End"
    },
    {
      "type": "script",
      "js": "window.rulerTypingScroll=document.getElementById(\"stage\").scrollTop"
    },
    {
      "type": "type_physical",
      "text": "!"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#edit-surface .word-page[data-page=\"1\"]"
      },
      "contains": "First page"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#edit-surface .word-page[data-page=\"2\"]"
      },
      "contains": "Second page!"
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#edit-surface"
      }
    },
    {
      "type": "assert_script",
      "js": "Math.abs(document.getElementById(\"stage\").scrollTop-window.rulerTypingScroll)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),s=document.getElementById(\"stage\").getBoundingClientRect();Math.abs(r.bottom-s.top)<1 && r.top>=document.querySelector(\".canvas-panel\").getBoundingClientRect().top"
    },
    {
      "type": "script",
      "js": "document.getElementById(\"stage\").scrollTop=0"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),s=document.getElementById(\"stage\").getBoundingClientRect();Math.abs(r.bottom-s.top)<1 && r.top>=document.querySelector(\".canvas-panel\").getBoundingClientRect().top"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ruler\").getBoundingClientRect(),p=document.getElementById(\"paper-wrap\").getBoundingClientRect();Math.abs(r.left-p.left)<1 && Math.abs(r.width-p.width)<1"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word-ruler-first-page.png"
    }
  ]
}
