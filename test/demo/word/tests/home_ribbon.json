{
  "name": "Word Home ribbon: Clipboard, Font, and Paragraph commands follow Word",
  "html": "test/demo/word/word.ls",
  "viewport": {"width": 1440, "height": 1000},
  "events": [
    {"type":"click","target":{"selector":"#new"}},
    {"type":"type","target":{"selector":"#edit-surface p"},"text":"hello world. again","clear":false},
    {"type":"set_editing_selection","target":{"selector":"#edit-surface p"},"start":0,"end":18},
    {"type":"click","target":{"selector":"#home-change-case"}},
    {"type":"click","target":{"selector":"#context-case-title"}},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Hello World. Again"},
    {"type":"click","target":{"selector":"#home-grow-font"}},
    {"type":"assert_value","target":{"selector":"#font-size"},"equals":"12"},
    {"type":"click","target":{"selector":"#home-highlight-menu"}},
    {"type":"click","target":{"selector":"#context-highlight-c8efc0"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface span[style]"},"attribute":"style","contains":"background-color: #c8efc0"},
    {"type":"assert_attribute","target":{"selector":"#home-highlight .color-bar"},"attribute":"style","contains":"#c8efc0"},
    {"type":"click","target":{"selector":"#home-font-color-menu"}},
    {"type":"click","target":{"selector":"#context-font-color-7030a0"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface span[style]"},"attribute":"style","contains":"color: #7030a0"},
    {"type":"click","target":{"selector":"#home-char-shading"}},
    {"type":"assert_attribute","target":{"selector":"#home-char-shading"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface span[style]"},"attribute":"style","contains":"background-color: #d9d9d9"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface span[style]"},"attribute":"style","contains":"background-color: #c8efc0"},
    {"type":"click","target":{"selector":"[id=\"para.numbering-menu\"]"}},
    {"type":"click","target":{"selector":"#context-list-upper-roman"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface ol"},"attribute":"style","contains":"list-style-type: upper-roman"},
    {"type":"assert_attribute","target":{"selector":"[id=\"para.numbering\"]"},"attribute":"aria-pressed","equals":"true"},
    {"type":"click","target":{"selector":"#home-borders"}},
    {"type":"click","target":{"selector":"#context-para-border-bottom"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface ol p"},"attribute":"style","contains":"border-bottom: 0.75pt solid currentColor"},
    {"type":"click","target":{"selector":"#line-spacing"}},
    {"type":"click","target":{"selector":"#context-spacing-2-5"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface ol p"},"attribute":"style","contains":"line-height: 2.5"},
    {"type":"click","target":{"selector":"#home-shading-menu"}},
    {"type":"click","target":{"selector":"#context-shading-fff2cc"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface ol p"},"attribute":"style","contains":"background-color: #fff2cc"},
    {"type":"click","target":{"selector":"#home-show-marks"}},
    {"type":"assert_attribute","target":{"selector":"#word"},"attribute":"class","contains":"show-marks"},
    {"type":"assert_attribute","target":{"selector":"#home-show-marks"},"attribute":"aria-pressed","equals":"true"},
    {"type":"render","file":"temp/word/tests/home-ribbon-marks.png"},
    {"type":"click","target":{"selector":"#home-show-marks"}},
    {"type":"assert_attribute","target":{"selector":"#home-show-marks"},"attribute":"aria-pressed","equals":"false"},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"click","target":{"selector":".edit-dialog-discard"}},
    {"type":"type","target":{"selector":"#edit-surface p"},"text":"plain bold","clear":false},
    {"type":"set_editing_selection","target":{"selector":"#edit-surface p"},"start":6,"end":10},
    {"type":"click","target":{"selector":"[id=\"format.bold\"]"}},
    {"type":"click","target":{"selector":"#edit-surface strong"}},
    {"type":"click","target":{"selector":"#home-format-painter"}},
    {"type":"assert_attribute","target":{"selector":"#home-format-painter"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#word"},"attribute":"class","contains":"format-painting"},
    {"type":"mouse_drag","target":{"selector":"#edit-surface p","offset_x":1,"offset_y":8},"to_target":{"selector":"#edit-surface p","offset_x":30,"offset_y":8}},
    {"type":"assert_count","target":{"selector":"#edit-surface strong"},"count":2},
    {"type":"assert_attribute","target":{"selector":"#home-format-painter"},"attribute":"aria-pressed","equals":"false"},
    {"type":"set_editing_selection","target":{"selector":"#edit-surface p"},"start":0,"end":3},
    {"type":"key_combo","key":"c","mods_str":"ctrl"},
    {"type":"click","target":{"selector":"#edit-surface .word-text-run:last-child strong"}},
    {"type":"key_press","key":"End"},
    {"type":"click","target":{"selector":"#home-paste-menu"}},
    {"type":"click","target":{"selector":"#context-paste-text"}},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"plain boldpla"},
    {"type":"assert_count","target":{"selector":"#edit-surface strong"},"count":2}
  ]
}
