{
  "name": "Word table cells accept pointer caret placement",
  "html": "test/demo/word/word.ls",
  "viewport": {"width": 1440, "height": 1000},
  "events": [
    {"type":"click","target":{"selector":"#new"}},
    {"type":"type","target":{"selector":"#edit-surface p"},"text":"Before the table"},
    {"type":"click","target":{"selector":"#tab-insert"}},
    {"type":"click","target":{"selector":"[id=\"insert.table\"]"}},
    {"type":"click","target":{"selector":".edit-dialog-insert_table"}},
    {"type":"click","target":{"selector":"#edit-surface tr:first-child th:nth-child(2)"}},
    {"type":"assert_caret","target":{"selector":"#edit-surface tr:first-child th:nth-child(2)"}},
    {"type":"type","text":"Owner"},
    {"type":"assert_text","target":{"selector":"#edit-surface tr:first-child th:nth-child(2)"},"equals":"Owner"},
    {"type":"click","target":{"selector":"#edit-surface tr:nth-child(3) td:nth-child(3)"}},
    {"type":"assert_caret","target":{"selector":"#edit-surface tr:nth-child(3) td:nth-child(3)"}},
    {"type":"type","text":"Mara"},
    {"type":"assert_text","target":{"selector":"#edit-surface tr:nth-child(3) td:nth-child(3)"},"equals":"Mara"},
    {"type":"click","target":{"selector":"#edit-surface tr:first-child th:nth-child(2)"}},
    {"type":"assert_caret","target":{"selector":"#edit-surface tr:first-child th:nth-child(2)"}},
    {"type":"type","text":"!"},
    {"type":"assert_text","target":{"selector":"#edit-surface tr:first-child th:nth-child(2)"},"equals":"Owner!"},
    {"type":"click","target":{"selector":"#edit-surface p"}},
    {"type":"assert_caret","target":{"selector":"#edit-surface p"}},
    {"type":"click","target":{"selector":"#tab-view"}},
    {"type":"click","target":{"selector":"#zoom-in"}},
    {"type":"assert_text","target":{"selector":"#zoom-label"},"equals":"110%"},
    {"type":"click","target":{"selector":"#edit-surface tr:nth-child(2) td:nth-child(2)"}},
    {"type":"assert_caret","target":{"selector":"#edit-surface tr:nth-child(2) td:nth-child(2)"}},
    {"type":"type","text":"Due"},
    {"type":"assert_text","target":{"selector":"#edit-surface tr:nth-child(2) td:nth-child(2)"},"equals":"Due"},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Before the table"},
    {"type":"render","file":"temp/word-table-caret.png"}
  ]
}
