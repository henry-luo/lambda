{
  "name": "Word Finder-style file browsing, selection, imports and cancellation",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#open"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#word-file-picker"
      },
      "count": 1
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#word-file-picker"
      },
      "attribute": "aria-modal",
      "equals": "true"
    },
    {
      "type": "assert_script",
      "js": "(()=>{let a=document.getElementById('word-picker-hidden'),b=document.getElementById('word-picker-sort'),x=a.parentElement.getBoundingClientRect(),y=b.parentElement.getBoundingClientRect(),c=a.getBoundingClientRect(),d=b.getBoundingClientRect();return Math.abs(x.height-y.height)<1&&Math.abs((x.top+x.height/2)-(y.top+y.height/2))<1&&Math.abs((c.top+c.height/2)-(d.top+d.height/2))<1})()"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#word-picker-open[disabled]"
      },
      "count": 1
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#word-picker-files"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#word-picker-place-project"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#word-picker-go"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-picker-location"
      },
      "clear": true,
      "text": "test/demo/word/tests"
    },
    {
      "type": "key_press",
      "key": "Enter"
    },
