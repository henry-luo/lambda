    {
      "type": "assert_focus",
      "target": {
        "selector": "#edit-surface"
      }
    },
    {
      "type": "resize",
      "width": 800,
      "height": 650
    },
    {
      "type": "click",
      "target": {
        "selector": "#open"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-discard"
      }
    },
    {
      "type": "assert_script",
      "js": "(()=>{let d=document.getElementById(\"word-file-picker\").getBoundingClientRect();return d.left>=0&&d.top>=0&&d.right<=800&&d.bottom<=650})()"
    },
    {
      "type": "assert_script",
      "js": "(()=>{let a=document.getElementById('word-picker-hidden'),b=document.getElementById('word-picker-sort'),x=a.parentElement.getBoundingClientRect(),y=b.parentElement.getBoundingClientRect(),c=a.getBoundingClientRect(),d=b.getBoundingClientRect();return Math.abs(x.height-y.height)<1&&Math.abs((x.top+x.height/2)-(y.top+y.height/2))<1&&Math.abs((c.top+c.height/2)-(d.top+d.height/2))<1})()"
    },
    {
      "type": "assert_script",
      "js": "(()=>{let d=document.getElementById(\"word-file-picker\").getBoundingClientRect(),b=document.getElementById(\"word-picker-open\").getBoundingClientRect();return b.width>0&&b.left>=d.left&&b.right<=d.right&&b.bottom<=d.bottom})()"
    },
    {
      "type": "script",
      "js": "document.querySelector(\".edit-dialog-cancel\").focus()"
    },
