        "selector": ".picker-file[data-picker-path$=\"/proc\"]"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById(\"word-file-picker\").getAttribute(\"data-path\").endsWith(\"/tests/proc\")"
    },
    {
      "type": "click",
      "target": {
        "selector": "#word-picker-back"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".picker-file[data-picker-path$=\"/import.md\"]"
