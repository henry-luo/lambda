{
  "name": "Word shape insertion, settings, history and persistence",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#new"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#edit-surface p"
      },
      "text": "Shape: ",
      "clear": false
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-insert"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#insert-shape"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".shape-choice"
      },
      "count": 15
    },
    {
      "type": "assert_script",
      "js": "var g=document.querySelector(\".shape-gallery\"),f=document.getElementById(\"shape-kind\").parentElement;g.scrollHeight>g.clientHeight && f.getBoundingClientRect().top>=g.getBoundingClientRect().bottom"
    },
    {
      "type": "assert_script",
      "js": "var g=document.querySelector(\".shape-gallery\"),b=g.getBoundingClientRect(),p=document.elementFromPoint(b.left+20,b.bottom+8);!g.contains(p)"
    },
    {
      "type": "scroll",
      "target": {
        "selector": ".shape-gallery",
        "offset_x": 30,
        "offset_y": 30
      },
      "dx": 0,
      "dy": -6
    },
    {
      "type": "assert_script",
      "js": "var g=document.querySelector(\".shape-gallery\"),b=g.getBoundingClientRect(),l=document.getElementById(\"shape-choice-heart\").getBoundingClientRect();g.scrollTop>0 && l.top>=b.top && l.bottom<=b.bottom+1"
    },
    {
      "type": "click",
      "target": {
        "selector": "#shape-choice-heart"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById(\"shape-kind\").value===\"heart\""
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word-shape-gallery-scrolled.png"
    },
    {
      "type": "script",
      "js": "document.querySelector(\".shape-gallery\").scrollTop=0"
    },
    {
      "type": "resize",
      "width": 900,
      "height": 640
    },
    {
      "type": "assert_script",
      "js": "var d=document.querySelector(\".edit-dialog-shape\"),b=d.getBoundingClientRect();b.top>=19 && b.bottom<=621 && d.scrollHeight>d.clientHeight"
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#shape-kind"
      },
      "value": "trapezoid"
    },
    {
      "type": "assert_script",
      "js": "var g=document.querySelector(\".shape-gallery\"),b=g.getBoundingClientRect();!g.contains(document.elementFromPoint(b.left+20,b.bottom+8))"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word-shape-gallery-small.png"
    },
    {
      "type": "scroll",
      "target": {
        "selector": ".edit-dialog-shape",
        "offset_x": 10,
        "offset_y": 90
      },
      "dx": 0,
      "dy": -20
    },
    {
      "type": "assert_script",
      "js": "var d=document.querySelector(\".edit-dialog-shape\"),b=d.getBoundingClientRect(),a=d.querySelector(\".primary\").getBoundingClientRect();d.scrollTop>0 && a.top>=b.top && a.bottom<=b.bottom"
    },
    {
      "type": "script",
      "js": "document.querySelector(\".edit-dialog-shape\").scrollTop=0"
    },
    {
      "type": "resize",
      "width": 1440,
      "height": 1000
    },
    {
      "type": "type",
      "target": {
        "selector": "#shape-width"
      },
      "text": "200",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#shape-height"
      },
      "text": "110",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#shape-fill"
      },
      "text": "invalid",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-shape .primary"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#dialog-error"
      },
      "count": 1
    },
    {
      "type": "assert_script",
      "js": "document.getElementById(\"shape-width\").value === \"200\""
    },
    {
      "type": "type",
      "target": {
        "selector": "#shape-fill"
      },
      "text": "#aabbcc",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#shape-choice-diamond"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById(\"shape-width\").value === \"200\""
    },
    {
      "type": "render",
      "file": "temp/word-shape-gallery.png"
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-shape .primary"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-dialog"
      },
      "count": 0
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#edit-surface img[data-word-shape]"
      },
      "count": 1
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "width",
      "equals": "200"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "height",
      "equals": "110"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "alt",
      "equals": "Diamond"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector(\"#edit-surface img\").getAttribute(\"src\").indexOf(\"data:image/svg+xml;base64,\") === 0"
    },
    {
      "type": "render",
      "file": "temp/word-shape-inserted.png"
    },
    {
      "type": "assert_pixel",
      "min_r": 168,
      "max_r": 172,
      "min_g": 185,
      "max_g": 189,
      "min_b": 202,
      "max_b": 206,
      "target": {
        "selector": "#edit-surface img",
        "offset_x": 100,
        "offset_y": 55
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#shape-settings"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#shape-width"
      },
      "text": "240",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#shape-fill"
      },
      "text": "#2864ad",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#shape-choice-ellipse"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-shape .primary"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "width",
      "equals": "240"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "alt",
      "equals": "Oval"
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "width",
      "equals": "200"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "alt",
      "equals": "Diamond"
    },
    {
      "type": "key_combo",
      "key": "y",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "width",
      "equals": "240"
    },
    {
      "type": "click",
      "target": {
        "selector": "#save"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/shapes.word.json",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#status"
      },
      "contains": "Saved"
    },
    {
      "type": "click",
      "target": {
        "selector": "#export"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/shapes.html",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#status"
      },
      "contains": "Exported"
    },
    {
      "type": "click",
      "target": {
        "selector": "#export"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/shapes.pdf",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#status"
      },
      "contains": "Exported"
    },
    {
      "type": "click",
      "target": {
        "selector": "#new"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#edit-surface img"
      },
      "count": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#open"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/shapes.word.json",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#edit-surface img[data-word-shape]"
      },
      "count": 1
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "width",
      "equals": "240"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface img"
      },
      "attribute": "alt",
      "equals": "Oval"
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface img"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#picture-settings"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-dialog.edit-dialog-shape"
      },
      "count": 1
    },
    {
      "type": "assert_script",
      "js": "document.getElementById(\"shape-width\").value === \"240\""
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-cancel"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-view"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#view-reading"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-insert"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#insert-shape"
      },
      "attribute": "disabled",
      "equals": "disabled"
    },
    {
      "type": "render",
      "file": "temp/word-shapes.png"
    }
  ]
}
