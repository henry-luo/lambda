{
  "name":"Word native editor workflow",
  "html":"test/demo/word/word.ls",
  "viewport":{"width":1440,"height":1000},
  "events":[
    {"type":"assert_count","target":{"selector":"#edit-surface h1"},"count":1},
    {"type":"assert_count","target":{"selector":"#edit-surface table tr"},"count":4},
    {"type":"assert_text","target":{"selector":"#word-count"},"contains":"words"},
    {"type":"render","file":"temp/word-initial.png"},
    {"type":"click","target":{"selector":"#tab-insert"}},
    {"type":"assert_attribute","target":{"selector":"#word"},"attribute":"data-tab","equals":"Insert"},
    {"type":"click","target":{"selector":"#tab-view"}},
    {"type":"click","target":{"selector":"#view-reading"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface"},"attribute":"contenteditable","equals":"false"},
    {"type":"click","target":{"selector":"#view-reading"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface"},"attribute":"contenteditable","equals":"true"},
    {"type":"click","target":{"selector":"#zoom-in"}},
    {"type":"assert_text","target":{"selector":"#zoom-label"},"equals":"110%"},
    {"type":"click","target":{"selector":"#zoom-reset"}},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"assert_text","target":{"selector":"#edit-surface"},"not_contains":"Handbook"},
    {"type":"type","target":{"selector":"#edit-surface"},"text":"Hello studio"},
    {"type":"assert_text","target":{"selector":"#edit-surface"},"contains":"Hello studio"},
    {"type":"assert_attribute","target":{"selector":"#word"},"attribute":"data-dirty","equals":"true"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface"},"not_contains":"Hello studio"},
    {"type":"key_combo","key":"y","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface"},"contains":"Hello studio"},
    {"type":"click","target":{"selector":"#save"}},
    {"type":"assert_count","target":{"selector":".edit-dialog"},"count":1},
    {"type":"type","target":{"selector":"#word-file-path"},"clear":true,"text":"temp/word/smoke.word.json"},
    {"type":"click","target":{"selector":".edit-dialog-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#word"},"attribute":"data-dirty","equals":"false"}
  ]
}
