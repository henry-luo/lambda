    {
      "type": "set_editing_selection",
      "target": {
        "selector": "#edit-surface ul > li:nth-child(2) p"
      },
      "start": 7,
      "end": 7
    },
    {
      "type": "click",
      "target": {
        "selector": "[id=\"para.indent\"]"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#edit-surface ul > li:nth-child(2)"
      },
      "attribute": "indent",
      "equals": "1"
    },
    {
      "type": "assert_script",
      "js": "var b=document.querySelector(\"#edit-surface ul > li:nth-child(2)\");Math.abs(b.getBoundingClientRect().x-b.parentElement.getBoundingClientRect().x-parseFloat(getComputedStyle(b.parentElement).paddingLeft)-parseFloat(getComputedStyle(b).fontSize)*1.75)<0.2"
    },
    {
      "type": "assert_script",
      "js": "var a=document.querySelector('#edit-surface ul > li');var b=document.querySelector('#edit-surface ul > li:nth-child(2)');Math.abs(b.getBoundingClientRect().x-a.getBoundingClientRect().x-parseFloat(getComputedStyle(b).fontSize)*1.75)<0.2"
    },
