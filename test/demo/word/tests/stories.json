{
  "name": "Word stories",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#new"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#edit-surface p"
      },
      "text": "First page",
      "clear": false
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-insert"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#insert-page-number"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-dialog.edit-dialog-stories"
      },
      "count": 1
    },
    {
      "type": "type",
      "target": {
        "selector": "#stories-header"
      },
      "text": "Studio handbook",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#stories-footer"
      },
      "text": "Page {PAGE} of {NUMPAGES}",
      "clear": true
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#stories-header-align"
      },
      "value": "right"
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-stories .primary"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-header"
      },
      "count": 1
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".word-header"
      },
      "equals": "Studio handbook"
    },
    {
      "type": "dblclick",
      "target": {
        "selector": ".word-header"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-dialog.edit-dialog-stories"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-cancel"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".word-footer"
      },
      "equals": "Page 1 of 1"
    },
    {
      "type": "set_editing_selection",
      "target": {
        "selector": "#edit-surface p"
      },
      "start": 10,
      "end": 10
    },
    {
      "type": "click",
      "target": {
        "selector": "#insert-page-break"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-page"
      },
      "count": 2
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-header"
      },
      "count": 2
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-footer"
      },
      "count": 2
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".word-page[data-page=\"1\"] .word-footer"
      },
      "equals": "Page 1 of 2"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".word-page[data-page=\"2\"] .word-footer"
      },
      "equals": "Page 2 of 2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#insert-header"
      }
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#stories-first"
      },
      "value": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-stories .primary"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-header"
      },
      "count": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-footer"
      },
      "count": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-page[data-page=\"1\"] .word-header"
      },
      "count": 0
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-header"
      },
      "count": 2
    },
    {
      "type": "key_combo",
      "key": "y",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-header"
      },
      "count": 1
    },
    {
      "type": "render",
      "file": "temp/word/stories.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#save"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/stories.word.json",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#status"
      },
      "contains": "Saved"
    },
    {
      "type": "click",
      "target": {
        "selector": "#export"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/stories.html",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#status"
      },
      "contains": "Exported"
    },
    {
      "type": "click",
      "target": {
        "selector": "#export"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/stories.pdf",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#status"
      },
      "contains": "Exported"
    },
    {
      "type": "click",
      "target": {
        "selector": "#open"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "temp/word/stories.html",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-page"
      },
      "count": 2
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".word-header"
      },
      "count": 1
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".word-footer"
      },
      "equals": "Page 2 of 2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-insert"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#insert-footer"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#stories-size"
      },
      "text": "24",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#stories-distance"
      },
      "text": "30",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-stories .primary"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#dialog-error"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-cancel"
      }
    }
  ]
}
