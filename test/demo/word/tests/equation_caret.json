{
  "name": "Word in-place equation caret: click to place, arrows to move, typing and Backspace edit the source",
  "html": "test/demo/word/word.ls",
  "viewport": {"width": 1680, "height": 1000},
  "events": [
    {"type":"click","target":{"selector":"#new"},"scroll_into_view":true},
    {"type":"type","target":{"selector":"#edit-surface p"},"text":"BeforeAfter","clear":false},
    {"type":"set_editing_selection","target":{"selector":"#edit-surface p"},"start":6,"end":6},
    {"type":"click","target":{"selector":"#tab-insert"},"scroll_into_view":true},
    {"type":"click","target":{"selector":"#insert-equation"},"scroll_into_view":true},
    {"type":"click","target":{"selector":".edit-dialog-btn.edit-dialog-equation"},"scroll_into_view":true},
    {"type":"assert_count","target":{"selector":"#math-caret"},"count":0},
    {"type":"click","target":{"selector":"#edit-surface img[data-word-equation]","offset_x":2,"offset_y":14}},
    {"type":"assert_count","target":{"selector":"#math-caret"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#object-handles"},"attribute":"class","contains":"math-editing"},
    {"type":"render","file":"temp/word/tests/equation-caret-start.png"},
    {"type":"key_press","key":"End"},
    {"type":"key_press","key":"-"},
    {"type":"key_press","key":"1"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img[data-word-equation]"},"attribute":"data-word-equation","contains":"a^{2}+b^{2}=c^{2}-1"},
    {"type":"assert_count","target":{"selector":"#math-caret"},"count":1},
    {"type":"key_press","key":"/"},
    {"type":"key_press","key":"2"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img[data-word-equation]"},"attribute":"data-word-equation","contains":"c^{2}-\\\\frac{1}{2}"},
    {"type":"key_press","key":"ArrowUp"},
    {"type":"key_press","key":"x"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img[data-word-equation]"},"attribute":"data-word-equation","contains":"\\\\frac{1x}{2}"},
    {"type":"render","file":"temp/word/tests/equation-caret-fraction.png"},
    {"type":"key_press","key":"Backspace"},
    {"type":"key_press","key":"Home"},
    {"type":"key_press","key":"ArrowRight"},
    {"type":"key_press","key":"ArrowRight"},
    {"type":"key_press","key":"3"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img[data-word-equation]"},"attribute":"data-word-equation","contains":"a^{23}+b^{2}"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img[data-word-equation]"},"attribute":"data-word-equation","contains":"a^{2}+b^{2}=c^{2}-\\\\frac{1}{2}"},
    {"type":"click","target":{"selector":"#edit-surface img[data-word-equation]","offset_x":2,"offset_y":14}},
    {"type":"key_press","key":"Escape"},
    {"type":"assert_count","target":{"selector":"#math-caret"},"count":0},
    {"type":"assert_count","target":{"selector":"#edit-surface img[data-word-equation]"},"count":1},
    {"type":"click","target":{"selector":"#edit-surface img[data-word-equation]","offset_x":2,"offset_y":14}},
    {"type":"key_press","key":"Home"},
    {"type":"key_press","key":"ArrowLeft"},
    {"type":"assert_count","target":{"selector":"#math-caret"},"count":0},
    {"type":"assert_script","js":"var s=window.getSelection();s.isCollapsed && s.anchorNode.nodeType===3 && s.anchorNode.textContent==='Before' && s.anchorOffset===6"}
  ]
}
