    },
    {
      "type": "type",
      "target": {
        "selector": "#object-distance"
      },
      "text": "-1",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-btn.edit-dialog-object_layout"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#dialog-error').textContent.indexOf('0\u2013100')>=0"
    },
    {
      "type": "type",
      "target": {
        "selector": "#object-distance"
      },
      "text": "12",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-btn.edit-dialog-object_layout"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('.edit-dialog')===null"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-align-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-align-left"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "Math.abs(document.querySelector('#edit-surface img[data-word-shape]').getBoundingClientRect().left-document.querySelector('#edit-surface p').getBoundingClientRect().left)<2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#pick-object-0"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#pick-object-1"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.object-pick[aria-pressed=true]').length===2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-group-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-group-objects"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('#edit-surface img[data-word-group]').length===1 && document.querySelectorAll('#edit-surface img').length===2"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#edit-surface').textContent.indexOf('The final paragraph stays intact.')>=0"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/tests/object-layout-group.png"
    },
    {
      "type": "pointer_drag",
      "target": {
        "selector": "#object-move"
      },
      "dx": 80,
      "dy": 40,
      "pointerType": "touch"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(JSON.parse(document.querySelector('#edit-surface img[data-word-group]').getAttribute('data-word-layout')).x-80)<2"
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(JSON.parse(document.querySelector('#edit-surface img[data-word-group]').getAttribute('data-word-layout')).x)<2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-rotate-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-object-rotate-right"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#edit-surface img[data-word-group]').getAttribute('data-word-rotation')==='90'"
    },
    {
      "type": "pointer_drag",
      "target": {
        "selector": "#object-se"
      },
      "dx": -25,
      "dy": 10,
      "pointerType": "touch"
    },
    {
      "type": "assert_script",
      "js": "(function(){var a=document.querySelector('#edit-surface img[data-word-group]');var p=JSON.parse(a.getAttribute('data-word-group'));return parseFloat(a.getAttribute('width'))>p.width && Math.abs(parseFloat(a.getAttribute('width'))/p.width-parseFloat(a.getAttribute('height'))/p.height)<0.02;})()"
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "ctrl"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-group-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-ungroup-objects"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('#edit-surface img[data-word-group]').length===0 && document.querySelectorAll('#edit-surface img').length===3"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#edit-surface img[data-word-shape]').getAttribute('data-word-rotation')==='90'"
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('#edit-surface img[data-word-group]').length===1"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/tests/object-layout-group-rotated.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#pick-object-0"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#pick-object-1"
      },
      "scroll_into_view": true
    },
    {
      "type": "set_editing_selection",
      "target": {
        "selector": "#edit-surface .word-page > p:last-of-type"
      },
      "start": 33,
      "end": 33
    },
    {
      "type": "type_physical",
      "text": " Layout works."
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.object-pick[aria-pressed=true]').length===0 && document.querySelectorAll('#edit-surface img[data-word-group]').length===1"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#edit-surface .word-page > p:last-of-type').textContent.indexOf('Layout works.')>=0"
    },
    {
      "type": "click",
      "target": {
        "selector": "#select-object-0"
      },
      "scroll_into_view": true
    },
    {
      "type": "key_combo",
      "key": "s",
      "mods_str": "ctrl+shift"
    },
