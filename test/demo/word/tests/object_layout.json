    },
    {
      "type": "assert_script",
      "js": "parseInt(getComputedStyle(document.querySelector('#edit-surface img[data-word-shape]')).zIndex)<0"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-wrap-menu"
      },
      "scroll_into_view": true
