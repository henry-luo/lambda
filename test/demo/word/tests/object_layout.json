{
  "name": "Word object arrangement, wrapping and selection pane",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#open"
      },
      "scroll_into_view": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#word-file-path"
      },
      "text": "test/demo/word/tests/object_layout.word.json",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-confirm"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#close-navigation"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#edit-surface img[data-word-shape]"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-object-format"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#word').getAttribute('data-tab')==='Object Format'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-wrap-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-wrap-square"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "getComputedStyle(document.querySelector('#edit-surface img[data-word-shape]')).float==='left'"
    },
    {
      "type": "assert_script",
      "js": "(function(){var a=document.querySelector('#edit-surface img[data-word-shape]');var t=a.parentNode.querySelector('.word-text-run').firstChild;var r=document.createRange();r.setStart(t,0);r.setEnd(t,5);return r.getBoundingClientRect().left>=a.getBoundingClientRect().right+6;})()"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/tests/object-layout-wrap.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-wrap-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-wrap-right"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "getComputedStyle(document.querySelector('#edit-surface img[data-word-shape]')).float==='right'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-wrap-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-wrap-topBottom"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "getComputedStyle(document.querySelector('#edit-surface img[data-word-shape]')).display==='block'"
    },
    {
      "type": "assert_script",
      "js": "(function(){var a=document.querySelector('#edit-surface img[data-word-shape]');var t=a.parentNode.querySelector('.word-text-run').firstChild;var r=document.createRange();r.setStart(t,0);r.setEnd(t,5);return r.getBoundingClientRect().top>=a.getBoundingClientRect().bottom+6;})()"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-position-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-position-top-right"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "getComputedStyle(document.querySelector('#edit-surface img[data-word-shape]')).position==='absolute'"
    },
    {
      "type": "assert_script",
      "js": "(function(){var a=document.querySelector('#edit-surface img[data-word-shape]');var p=a.closest('.word-page');var b=p.getBoundingClientRect();var c=getComputedStyle(p);return Math.abs(a.getBoundingClientRect().right-(b.right-parseFloat(c.paddingRight)))<2 && Math.abs(a.getBoundingClientRect().top-b.top-parseFloat(c.paddingTop))<2;})()"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/tests/object-layout-position.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-selection-pane"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('#selection-pane .object-list-row').length===3"
    },
    {
      "type": "click",
      "target": {
        "selector": "#show-object-0"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "getComputedStyle(document.querySelector('#edit-surface img[data-word-shape]')).visibility==='hidden'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#show-object-0"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "getComputedStyle(document.querySelector('#edit-surface img[data-word-shape]')).visibility==='visible'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-rotate-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-flip-x"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#edit-surface img[data-word-shape]').style.transform.replace(/\\s/g,'').indexOf('scale(-1,1)')>=0"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/tests/object-layout-pane.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#select-object-1"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-position-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
