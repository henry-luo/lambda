      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#select-object-2"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "(function(){var a=document.querySelector('#edit-surface img[data-word-shape]');var b=a.getBoundingClientRect();return document.elementFromPoint(b.left+b.width/2,b.top+b.height/2);})().getAttribute('alt')==='Studio picture'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#select-object-0"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-forward-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#context-layer-forward"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#select-object-2"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "(function(){var a=document.querySelector('#edit-surface img[data-word-shape]');var b=a.getBoundingClientRect();return document.elementFromPoint(b.left+b.width/2,b.top+b.height/2);})().hasAttribute('data-word-shape')"
    },
    {
      "type": "click",
      "target": {
        "selector": "#select-object-0"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#object-backward-menu"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
