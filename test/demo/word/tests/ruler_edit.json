    {
      "type": "script",
      "js": "window.rulerPx=function(s){return parseFloat(s)*(s.endsWith(\"pt\")?4/3:1)};window.rulerAligned=function(selector){var p=document.querySelector(selector||\"#edit-surface p\"),b=p.getBoundingClientRect(),c=getComputedStyle(p),page=p.closest(\".word-page\"),z=page.getBoundingClientRect().width/parseFloat(getComputedStyle(page).width),l=b.left+(window.rulerPx(c.paddingLeft)+window.rulerPx(c.borderLeftWidth))*z,r=b.right-(window.rulerPx(c.paddingRight)+window.rulerPx(c.borderRightWidth))*z;var ids=[\"first\",\"hanging\",\"indent\",\"right\"],xs=[l+window.rulerPx(c.textIndent)*z,l,l,r];for(var i=0;i<ids.length;i++){var h=document.getElementById(\"ruler-indent-\"+ids[i]).getBoundingClientRect();if(Math.abs(h.left+h.width/2-xs[i])>1)return false}return true};true"
    },
