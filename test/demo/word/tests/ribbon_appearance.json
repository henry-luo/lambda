    {
      "type": "click",
      "target": {
        "selector": "#tab-insert"
      }
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ribbon-groups\");r.clientWidth<=900 && getComputedStyle(r).overflowX==='visible' && r.querySelectorAll('.ribbon-group[data-compact=true]').length>0 && r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right"
    },
    {
      "type": "click",
      "target": {"selector": ".group-symbols[data-compact=true] .ribbon-group-trigger"}
    },
    {
      "type": "click",
      "target": {
        "selector": "#insert-equation"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "[role=\"dialog\"]"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "button.edit-dialog-cancel"
      }
    },
    {
      "type": "render",
      "file": "temp/word/tests/ribbon-insert-narrow.png"
    },
    {
      "type": "assert_script",
      "js": "var r=document.querySelector(\".ribbon-groups\"),s=document.getElementById(\"stage\");r.getBoundingClientRect().bottom<=s.getBoundingClientRect().top && getComputedStyle(r).overflowX==='visible' && r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#word"
      },
      "attribute": "data-dirty",
      "equals": "false"
    }
  ]
