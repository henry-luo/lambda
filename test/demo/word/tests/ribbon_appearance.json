{
  "name": "Word ribbon appearance and primary command accessibility",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "events": [
    {
      "type": "assert_style",
      "target": {"selector": ".ribbon-group .group-label"},
      "property": "display",
      "equals": "none"
    },
    {"type": "click", "target": {"selector": "#tab-view"}},
    {
      "type": "assert_attribute",
      "target": {"selector": "#view-ribbon-labels"},
      "attribute": "aria-pressed",
      "equals": "false"
    },
    {"type": "click", "target": {"selector": "#view-ribbon-labels"}},
    {
      "type": "assert_style",
      "target": {"selector": ".ribbon-group .group-label"},
      "property": "display",
      "equals": "block"
    },
    {"type": "click", "target": {"selector": "#tab-home"}},
    {
      "type": "script",
      "js": "window.wordRibbonHeight=document.querySelector(\".ribbon-groups\").getBoundingClientRect().height;window.wordRibbonLabelsFit=function(){return Array.from(document.querySelectorAll(\".ribbon-groups .ribbon-large,.ribbon-groups .table-large-tool\")).every(function(b){var r=b.getBoundingClientRect(),l=b.querySelector(\".tool-label\").getBoundingClientRect();var line=parseFloat(getComputedStyle(b.querySelector(\".tool-label\")).lineHeight);return l.left>=r.left-1 && l.right<=r.right+1 && l.bottom<=r.bottom+1 && l.height<=2*line+1;})};window.wordRibbonCaptionsFit=function(){var rr=document.querySelector(\".ribbon-groups\").getBoundingClientRect();return Math.abs(rr.height-window.wordRibbonHeight)<=1 && Array.from(document.querySelectorAll(\".ribbon-groups .group-label\")).every(function(g){var r=g.getBoundingClientRect(),t=g.parentElement.querySelector(\".group-tools\").getBoundingClientRect();return r.top>=t.bottom-1 && r.bottom<=rr.bottom;})};"
    },
    {
      "type": "render",
      "file": "temp/word/tests/ribbon-home.png"
    },
    {
      "type": "assert_script",
      "js": "window.wordRibbonCaptionsFit()"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-insert"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".insert-ribbon .ribbon-large"
      },
      "count": 14
    },
    {
      "type": "assert_script",
      "js": "window.wordRibbonLabelsFit()"
    },
    {
      "type": "assert_script",
      "js": "window.wordRibbonCaptionsFit()"
    },
    {
      "type": "render",
      "file": "temp/word/tests/ribbon-insert.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#insert-picture"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "[role=\"dialog\"]"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "button.edit-dialog-cancel"
      },
      "scroll_into_view": true
    },
    {
