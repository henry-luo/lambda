{
  "name": "Word corporate website and journal sources, undated citations, validation and numeric bibliography",
  "html": "test/demo/word/word.ls",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#new"
      },
      "scroll_into_view": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#edit-surface p"
      },
      "text": "Sources: ",
      "clear": false
    },
    {
      "type": "click",
      "target": {
        "selector": "#tab-references"
      },
      "scroll_into_view": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#new-source"
      },
      "scroll_into_view": true
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#source-kind"
      },
      "value": "webpage"
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#source-corporate"
      },
      "value": "true"
    },
    {
      "type": "type",
      "target": {
        "selector": "#source-author"
      },
      "text": "Open Studio",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#source-title"
      },
      "text": "Making together",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#source-container"
      },
      "text": "Open Studio",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#source-url"
      },
