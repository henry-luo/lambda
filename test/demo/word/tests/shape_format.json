    {
      "type": "assert_script",
      "js": "JSON.parse(document.querySelector(\"#edit-surface img[data-word-shape]\").getAttribute(\"data-word-shape\"))[\"fill\"]===\"#3478cc\""
    },
    {
      "type": "assert_script",
      "js": "JSON.parse(document.querySelector(\"#edit-surface img[data-word-shape]\").getAttribute(\"data-word-shape\"))[\"text\"]===\"Shape\""
