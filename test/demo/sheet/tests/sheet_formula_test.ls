// Formula calls use pure registered Lambda functions (S12.3.4v2).
import m: ~~.mod_model
import f: ~~.mod_formula

let initial=m.initial(m.blank())
let data=m.paste(m.select(initial,0,0),"10\t20\n30\t40")
let result=(expr) any^ => f.display(m.current(m.set_value(m.select(data,2,0),expr)),2,0);
[
 result("=SUM(A1:B2)")==100,
 result("=SUM(" ++ join(fill(16,"1"),",") ++ ")")==16,
 result("=SUM(" ++ join(fill(17,"1"),",") ++ ")")=="#VALUE!",
 result("=PRODUCT(2,3,4)")==24,
 result("=SUM(\"5\",TRUE,A1)")==16,
 result("=COUNT(\"5\",TRUE,A1)")==3,
 result("=SUM(\"abc\")")=="#VALUE!",
 result("=COUNT(\"abc\")")==0,
 result("=A1+5")==15,
 result("=AVERAGE(A1:B2)")==25,
 result("=MEDIAN(A1:B2)")==25,
 result("=COUNTA(A1:C2)")==4,
 result("=COUNTBLANK(A1:C2)")==2,
 result("=ABS(-5)")==5,
 result("=INT(-2.2)")== -3,
 result("=SIGN(-10)")== -1,
 result("=MOD(-5,3)")==1,
 result("=POWER(2,3)")==8,
 result("=SQRT(81)")==9,
 result("=ROUND(-1.25,1)")== -1.3,
 result("=ROUNDUP(1.21,1)")==1.3,
 result("=ROUNDDOWN(-1.29,1)")== -1.2,
 result("=LEN(\"abc\")")==3,
 result("=UPPER(\"Hello\")")=="HELLO",
 result("=LOWER(\"HELLO\")")=="hello",
 result("=TRIM(\"  a   b  \")")=="a b",
 result("=LEFT(\"Hello\",2)")=="He",
 result("=RIGHT(\"Hello\",2)")=="lo",
 result("=MID(\"Hello\",2,3)")=="ell",
 result("=CONCAT(\"a\",\"b\",3)")=="ab3",
 result("=\"a\"&\"b\"")=="ab",
 result("=\"a\"\"b\"")=="a\"b",
 result("=ROWS(A1:B2)")==2,
 result("=COLUMNS(A1:B2)")==2,
 result("=INDEX(A1:B2,2,2)")==40,
 result("=MATCH(30,A1:A2,0)")==2,
 result("=MATCH(25,A1:A2,1)")==1,
 result("=VLOOKUP(30,A1:B2,2,FALSE)")==40,
 result("=HLOOKUP(20,A1:B2,2,FALSE)")==40,
 result("=AVERAGE(\"bad\")")=="#VALUE!",
 result("=VLOOKUP(20,A1:B2,2,TRUE)")==20,
 result("=VLOOKUP(99,A1:B2,2,FALSE)")=="#N/A",
 result("=COUNTIF(A1:B2,\">=20\")")==3,
 result("=COUNTIF(A1:B2,\"*\")")==0,
 result("=SUMIF(A1:A2,\">=20\",B1:B2)")==40,
 result("=SUMPRODUCT(A1:A2,B1:B2)")==1400,
 result("=IF(A1<20,\"yes\",\"no\")")=="yes",
 result("=IF(FALSE,1/0,42)")==42,
 result("=IF(TRUE,7,1/0)")==7,
 result("=IFERROR(1/0,9)")==9,
 result("=IFERROR(3,1/0)")==3,
 result("=IFNA(NA(),8)")==8,
 result("=IFNA(1/0,8)")=="#DIV/0!",
 result("=ISERROR(1/0)")==true,
 result("=ISNA(NA())")==true,
 result("=ISNA(1/0)")==false,
 result("=ISNUMBER(A1)")==true,
 result("=ISTEXT(\"abc\")")==true,
 result("=ISBLANK(C1)")==true,
 result("=1e3+2")==1002,
 result("=50%^2")==0.25,
 result("=SUMPRODUCT(A1:A2,A1:B1)")=="#VALUE!",
 result("=AND(TRUE,1,2>1)")==true,
 result("=OR(FALSE,0,2<>3)")==true,
 result("=NOT(FALSE)")==true,
 result("=TRUE()")==true,
 result("=FALSE()")==false,
 result("=\"Alpha\"=\"alpha\"")==true,
 result("=2+3*4>=14")==true,
 result("=SQRT(-1)")=="#NUM!",
 result("=MOD(5,0)")=="#DIV/0!",
 result("=ABS()")=="#VALUE!",
 result("=NOTHING(1)")=="#NAME?",
 result("=IF(TRUE,1,NOTHING(1))")==1,
 result("=\"unterminated")=="#VALUE!"
]
