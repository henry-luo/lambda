// Additional Excel functions exercise real formula calls and workbook date systems.
import m: ~~.mod_model
import f: ~~.mod_formula
let initial=m.initial(m.blank())
let data=m.paste(m.select(initial,0,0),"1\t2\t45292\n2\t4\t45292\n3\t6\t45293\n4\t8\ttext\ntext\t10")
let result=(expr) any^ => f.display(m.current(m.set_value(m.select(data,8,0),expr)),8,0)
let result1904=(expr) any^ => f.display({*:m.current(m.set_value(m.select(data,8,0),expr)),date1904:true},8,0);
[
 result("=SLOPE(B1:B4,A1:A4)")==2,
 result("=INTERCEPT(B1:B4,A1:A4)")==0,
 result("=FORECAST.LINEAR(5,B1:B4,A1:A4)")==10,
 result("=FORECAST(5,B1:B4,A1:A4)")==10,
 result("=CORREL(A1:A4,B1:B4)")==1,
 result("=PEARSON(A1:A4,B1:B4)")==1,
 result("=RSQ(A1:A4,B1:B4)")==1,
 result("=COVARIANCE.P(A1:A4,B1:B4)")==2.5,
 result("=COVAR(A1:A4,B1:B4)")==2.5,
 result("=ROUND(COVARIANCE.S(A1:A4,B1:B4),6)")==3.333333,
 result("=STEYX(B1:B4,A1:A4)")==0,
 result("=SLOPE(B1:B5,A1:A5)")==2,
 result("=SLOPE(B1:B3,A1:A4)")=="#N/A",
 result("=SLOPE(A1:A2,C1:C2)")=="#DIV/0!",
 result("=STEYX(A1:A2,B1:B2)")=="#DIV/0!",
 result("=PERCENTILE.EXC(A1:A4,0.5)")==2.5,
 result("=PERCENTILE.EXC(A1:A4,0.25)")==1.25,
 result("=PERCENTILE.EXC(A1:A4,0.1)")=="#NUM!",
 result("=QUARTILE.EXC(A1:A4,3)")==3.75,
 result("=QUARTILE.EXC(A1:A4,0)")=="#NUM!",
 result("=RANK.AVG(45292,C1:C3)")==2.5,
 result("=RANK.AVG(45292,C1:C3,1)")==1.5,
 result("=ROUND(GEOMEAN(2,8),6)")==4,
 result("=ROUND(HARMEAN(2,4),6)")==2.666667,
 result("=GEOMEAN(0,2)")=="#NUM!",
 result("=HARMEAN(-1,2)")=="#NUM!",
 result("=CEILING.MATH(-5.5,2)")== -4,
 result("=CEILING.MATH(-5.5,2,1)")== -6,
 result("=FLOOR.MATH(-5.5,2)")== -6,
 result("=FLOOR.MATH(-5.5,2,1)")== -4,
 result("=CEILING.PRECISE(5.5,-2)")==6,
 result("=FLOOR.PRECISE(-5.5,-2)")== -6,
 result("=CEILING.MATH(5,0)")==0,
 result("=ROUND(SQRTPI(1),6)")==1.772454,
 result("=SQRTPI(-1)")=="#NUM!",
 result("=SINH(0)")==0,
 result("=COSH(0)")==1,
 result("=TANH(0)")==0,
 result("=GCD(24,36,60)")==12,
 result("=LCM(4,6,10)")==60,
 result("=GCD(A1:A4)")==1,
 result("=LCM(0,6)")==0,
 result("=GCD(-1,2)")=="#NUM!",
 result("=SLN(1000,100,3)")==300,
 result("=SYD(1000,100,3,1)")==450,
 result("=SYD(1000,100,3,4)")=="#NUM!",
 result("=NETWORKDAYS(DATE(2024,1,1),DATE(2024,1,7))")==5,
 result("=NETWORKDAYS(DATE(2024,1,7),DATE(2024,1,1))")== -5,
 result("=NETWORKDAYS(DATE(2024,1,1),DATE(2024,1,7),C1:C3)")==3,
 result("=NETWORKDAYS.INTL(DATE(2024,1,1),DATE(2024,1,7),11)")==6,
 result("=NETWORKDAYS.INTL(DATE(2024,1,1),DATE(2024,1,7),\"0000011\")")==5,
 result("=NETWORKDAYS.INTL(DATE(2024,1,1),DATE(2024,1,7),\"1111111\")")==0,
 result("=WORKDAY.INTL(DATE(2024,1,1),1,\"1111111\")")=="#VALUE!",
 result("=WORKDAY(DATE(2024,1,1),5)")==45299,
 result("=WORKDAY(DATE(2024,1,8),-5)")==45292,
 result("=WORKDAY(DATE(2024,1,1),1,C1:C3)")==45294,
