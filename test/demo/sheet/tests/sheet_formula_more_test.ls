 result("=WORKDAY(DATE(2024,1,6),1)")==45299,
 result("=WORKDAY(DATE(2024,1,6),-1)")==45296,
 result("=WORKDAY.INTL(DATE(2024,1,1),7,\"0000000\")")==45299,
 result("=NETWORKDAYS.INTL(DATE(2024,1,1),DATE(2024,1,7),0)")=="#NUM!",
 result("=WORKDAY.INTL(DATE(2024,1,1),1,\"00x0011\")")=="#VALUE!",
 result("=WORKDAY(0,-1)")=="#NUM!"
]
