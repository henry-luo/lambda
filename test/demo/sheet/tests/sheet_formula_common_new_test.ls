// Common scalar functions and reference semantics run through the formula call plans.
import m: ~~.mod_model
import f: ~~.mod_formula
let initial=m.initial(m.blank())
let data=m.paste(m.select(initial,0,0),"1\t2\t-100\t45292\n3\t4\t110\t45657")
let with_error=m.set_value(m.select(data,1,1),"=1/0")
let error_result=(expr) any^ => f.display(m.current(m.set_value(m.select(with_error,8,0),expr)),8,0)
let subtotal_sheet={*:m.current(data),hidden_rows:[1],cells:[*m.current(data).cells,{row:2,col:0,raw:"=SUBTOTAL(9,A1:A2)"}]}
let subtotal_result=(expr) any^ => f.display({*:subtotal_sheet,cells:[*subtotal_sheet.cells,{row:8,col:0,raw:expr}]},8,0)
let result=(expr) any^ => f.display(m.current(m.set_value(m.select(data,8,0),expr)),8,0);
[
 result("=PROPER(\"hello WORLD 2nd\")")=="Hello World 2nd",
 result("=TEXTBEFORE(\"one/two/three\",\"/\")")=="one",
 result("=TEXTAFTER(\"one/two/three\",\"/\",-1)")=="three",
 result("=TEXTBEFORE(\"one/two/three\",\"/\",-1)")=="one/two",
 result("=TEXTAFTER(\"ONE and TWO\",\"AND\",1,1)")==" TWO",
 result("=TEXTAFTER(\"abc\",\"x\",1,0,1)")=="",
 result("=TEXTBEFORE(\"abc\",\"x\",1,0,0,\"none\")")=="none",
 result("=TEXTBEFORE(\"abc\",\"x\")")=="#N/A",
 result("=TEXTBEFORE(\"abc\",\"x\",0)")=="#VALUE!",
 result("=DATEDIF(DATE(2020,1,15),DATE(2024,3,20),\"Y\")")==4,
 result("=DATEDIF(DATE(2020,1,15),DATE(2024,3,20),\"M\")")==50,
 result("=DATEDIF(DATE(2020,1,15),DATE(2024,3,20),\"YM\")")==2,
 result("=DATEDIF(DATE(2020,1,15),DATE(2024,3,20),\"MD\")")==5,
 result("=DATEDIF(DATE(2024,3,20),DATE(2020,1,15),\"D\")")=="#NUM!",
 result("=WEEKNUM(DATE(2024,1,1))")==1,
 result("=WEEKNUM(DATE(2024,1,7),2)")==1,
 result("=ISOWEEKNUM(DATE(2021,1,1))")==53,
 result("=WEEKNUM(DATE(2021,1,1),21)")==53,
 result("=ROW()")==9,
 result("=COLUMN()")==1,
 result("=ROW(B2)")==2,
 result("=COLUMN(B2)")==2,
 result("=ROW(B2:A1)")==1,
 result("=COLUMN(B2:A1)")==1,
 result("=INDIRECT(\"B2\")")==4,
 result("=SUM(INDIRECT(\"A1:B2\"))")==10,
 result("=INDIRECT(\"A1+1\")")=="#REF!",
 result("=OFFSET(A1,1,1)")==4,
 result("=SUM(OFFSET(A1,0,0,2,2))")==10,
 result("=OFFSET(A1,-1,0)")=="#REF!",
 result("=ADDRESS(2,27)")=="$AA$2",
 result("=ADDRESS(2,27,4)")=="AA2",
 result("=ADDRESS(2,27,2,FALSE)")=="R2C[27]",
 result("=MODE(1,2,2,3)")==2,
 result("=MODE.SNGL(1,2,3)")=="#N/A",
 result("=ROUND(IRR(B1:B2),4)")=="#NUM!",
 result("=ROUND(IRR(OFFSET(A1,0,0,2,1)),4)")=="#NUM!",
 result("=ROUND(IRR(C1:C2),6)")==0.1,
 result("=ROUND(XIRR(C1:C2,D1:D2),6)")==0.1,
 result("=ROUND(XNPV(0.1,C1:C2,D1:D2),6)")==0,
 result("=LOOKUP(3,A1:A2,B1:B2)")==4,
 result("=LOOKUP(2,A1:A2,B1:B2)")==2,
 result("=LOOKUP(0,A1:A2,B1:B2)")=="#N/A",
 result("=ROUND(RATE(12,-88.848788678,1000)*12,4)")==0.12,
 result("=ROUND(YEARFRAC(DATE(2024,1,1),DATE(2024,7,1),3),6)")==0.49863,
 result("=YEARFRAC(DATE(2024,1,1),DATE(2024,7,1),0)")==0.5,
 result("=YEARFRAC(DATE(2024,1,1),DATE(2024,7,1),8)")=="#NUM!",
 error_result("=ROW(B2)")==2,
 error_result("=COLUMN(B2)")==2,
 error_result("=OFFSET(B2,-1,-1)")==1,
 subtotal_result("=SUBTOTAL(9,A1:A3)")==4,
 subtotal_result("=SUBTOTAL(109,A1:A3)")==1,
 subtotal_result("=SUBTOTAL(2,A1:A3)")==2,
 subtotal_result("=SUBTOTAL(12,A1:A3)")=="#VALUE!",
 result("=YEARFRAC(DATE(2023,2,28),DATE(2024,2,29),0)")==1,
 result("=ROUND(YEARFRAC(DATE(2023,7,1),DATE(2024,1,1),1),6)")==0.50411,
 result("=ROUND(YEARFRAC(DATE(2023,7,1),DATE(2024,7,1),1),6)")==1,
 result("=LET(x,5,x+1)")==6,
 result("=LET(x,5,y,x*2,x+y)")==15,
 result("=LET(x,5,LET(x,7,x)+x)")==12,
 result("=LET(x,A1,x+2)")==3,
 result("=LET(A1,5,A1)")=="#VALUE!",
 result("=TEXT(1.234,\"0.00\")")=="1.23",
 result("=TEXT(0.125,\"0.0%\")")=="12.5%",
 result("=TEXT(DATE(2024,1,2),\"yyyy-mm-dd\")")=="2024-01-02",
 result("=TEXT(12345.5,\"$#,##0.00\")")=="$12,345.50",
 result("=TEXT(5,\"0.##\")")=="#VALUE!"
]
