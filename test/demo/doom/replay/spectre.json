    {"type": "click", "target": {"selector": "#seed"}},
    {"type": "assert_attribute", "target": {"selector": "#fuzz-noise"}, "attribute": "seed", "equals": "1"},
    {"type": "click", "target": {"selector": "#dead"}},
    {"type": "assert_attribute", "target": {"selector": "#shadow"}, "attribute": "data-state", "equals": "dead"}
  ]
}
