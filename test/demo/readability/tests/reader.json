{
  "name": "Readability demo: toggle reader view per tab, settings and shortcuts",
  "html": "test/demo/readability/readability.ls",
  "viewport": {"width": 1200, "height": 860},
  "events": [
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"original"},
    {"type":"assert_count","target":{"selector":"#page-frame[src$=\"meridian-trees.html\"]"},"count":1},
    {"type":"assert_count","target":{"selector":".tab"},"count":4},
    {"type":"advance_time","ms":500},
    {"type":"capture_surface","source":"page","file":"temp/readability/original.png"},

    {"type":"click","target":{"selector":"#reader-toggle"}},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"reader"},
    {"type":"assert_attribute","target":{"selector":"#reader-toggle"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_count","target":{"selector":"#page-frame"},"count":0},
    {"type":"assert_text","target":{"selector":"#reader-title"},"equals":"Shade by design: how street trees cool a city block"},
    {"type":"assert_text","target":{"selector":"#reader-site"},"equals":"The Meridian Ledger"},
    {"type":"assert_text","target":{"selector":"#reader-details"},"contains":"Ana Okafor · 14 July 2026 · 3 min read"},
    {"type":"assert_count","target":{"selector":"#reader-content h2"},"count":3},
    {"type":"assert_count","target":{"selector":"#reader-content figure img"},"count":1},
    {"type":"assert_count","target":{"selector":"#reader-content blockquote"},"count":1},
    {"type":"assert_text","target":{"selector":"#reader-content"},"contains":"shade is not a luxury on a hot street"},
    {"type":"assert_text","target":{"selector":"#reader-content"},"not_contains":"Most read"},
    {"type":"assert_text","target":{"selector":"#reader-content"},"not_contains":"SOLARIS"},
    {"type":"assert_text","target":{"selector":"#address-text"},"contains":"about:reader?url="},
    {"type":"capture_surface","source":"page","file":"temp/readability/reader-light.png"},

    {"type":"click","target":{"selector":"#tab-focaccia"}},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"original"},
    {"type":"assert_count","target":{"selector":"#page-frame[src$=\"crumb-focaccia.html\"]"},"count":1},
    {"type":"click","target":{"selector":"#reader-toggle"}},
    {"type":"assert_text","target":{"selector":"#reader-title"},"equals":"Overnight focaccia with rosemary and sea salt"},
    {"type":"assert_count","target":{"selector":"#reader-content ol li"},"count":7},
    {"type":"assert_text","target":{"selector":"#reader-content"},"not_contains":"Advertisement"},
    {"type":"click","target":{"selector":"#theme-sepia"}},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-theme","equals":"sepia"},
    {"type":"assert_attribute","target":{"selector":"#theme-sepia"},"attribute":"aria-pressed","equals":"true"},
    {"type":"click","target":{"selector":"#text-larger"}},
    {"type":"click","target":{"selector":"#text-larger"}},
    {"type":"assert_style","target":{"selector":".reader-article"},"property":"font-size","equals":"24px"},
    {"type":"assert_attribute","target":{"selector":"#text-larger"},"attribute":"disabled","equals":"disabled"},
    {"type":"capture_surface","source":"page","file":"temp/readability/reader-sepia.png"},

    {"type":"key_combo","key":"3","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-page","equals":"reader"},
    {"type":"key_combo","key":"r","mods_str":"ctrl+shift"},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"reader"},
    {"type":"click","target":{"selector":"#theme-dark"}},
    {"type":"assert_count","target":{"selector":"#reader-content pre code"},"count":1},
    {"type":"assert_count","target":{"selector":"#reader-content table th"},"count":3},
    {"type":"capture_surface","source":"page","file":"temp/readability/reader-dark.png"},
    {"type":"key_press","key":"Escape"},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"original"},

    {"type":"click","target":{"selector":"#tab-trees"}},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"reader"},
    {"type":"click","target":{"selector":"#view-original"}},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"original"},
    {"type":"assert_count","target":{"selector":"#page-frame[src$=\"meridian-trees.html\"]"},"count":1},
    {"type":"click","target":{"selector":"#tab-home"}},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-readerable","equals":"false"},
    {"type":"assert_attribute","target":{"selector":"#reader-toggle"},"attribute":"disabled","equals":"disabled"},
    {"type":"click","target":{"selector":"#reader-toggle"}},
    {"type":"assert_attribute","target":{"selector":"#readability-demo"},"attribute":"data-mode","equals":"original"},
    {"type":"capture_surface","source":"page","file":"temp/readability/front-page.png"}
  ]
}
