{
  "name": "Tetris closes after sustained gravity and repeated board replacement",
  "html": "test/demo/tetris/tetris.ls",
  "events": [
    {"type":"click","target":{"selector":"#overlay-action"}},
    {"type":"advance_time","ms":14000,"steps":280},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-mode","equals":"playing"},
    {"type":"key_press","key":"Space"},
    {"type":"key_press","key":"R"},
    {"type":"advance_time","ms":14000,"steps":280},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-mode","equals":"playing"},
    {"type":"key_press","key":"R"},
    {"type":"advance_time","ms":14000,"steps":280},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-mode","equals":"playing"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
