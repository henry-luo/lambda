{
  "name": "Mail demo: the demo mailbox — HTML and plain mail, reply and send, drafts, archive, delete, flag, folder tree, new mailbox, Get Mail",
  "html": "test/demo/mail/mail.ls",
  "viewport": {"width": 1280, "height": 800},
  "events": [
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-loaded", "equals": "true"},
    {"type": "click", "target": {"selector": "#add-demo"}},
    {"type": "assert_count", "target": {"selector": "#setup"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-account", "equals": "demo"},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-status", "equals": "online",
      "assert_timeout": 20000, "assert_interval": 200},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "188"},
    {"type": "assert_count", "target": {"selector": ".box"}, "count": 10},
    {"type": "assert_text", "target": {"selector": ".box.role-inbox .count"}, "equals": "12"},
    {"type": "assert_text", "target": {"selector": ".box.role-junk .count"}, "equals": "8"},
    {"type": "assert_text", "target": {"selector": "#box-title"}, "equals": "Inbox"},
    {"type": "assert_text", "target": {"selector": "#list .row[data-value=\"188\"] .subject"}, "equals": "Offsite agenda — final draft"},
    {"type": "assert_text", "target": {"selector": "#list .row[data-value=\"187\"] .sender"}, "equals": "José Álvarez"},
    {"type": "assert_text", "target": {"selector": "#list .row[data-value=\"188\"] .snippet"}, "contains": "final agenda"},
    {"type": "assert_count", "target": {"selector": "#list .row[data-value=\"184\"] .clip"}, "count": 1},

    {"type": "click", "target": {"selector": "#list .row[data-value=\"188\"]"}},
    {"type": "assert_attribute", "target": {"selector": "#viewer"}, "attribute": "data-uid", "equals": "188"},
    {"type": "assert_count", "target": {"selector": "#message-frame"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".avatar"}, "equals": "MC"},
    {"type": "assert_text", "target": {"selector": ".box.role-inbox .count"}, "equals": "11",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "wait", "ms": 400},
    {"type": "capture_surface", "source": "page", "file": "temp/mail/shots/demo.png"},

    {"type": "click", "target": {"selector": "#list .row[data-value=\"176\"]"}},
    {"type": "assert_count", "target": {"selector": "#text-body .quote.depth-2"}, "count": 1},

    {"type": "click", "target": {"selector": "#list .row[data-value=\"184\"]"}},
    {"type": "assert_attribute", "target": {"selector": "#attachments"}, "attribute": "data-count", "equals": "2"},
    {"type": "click", "target": {"selector": ".attachment[data-value=\"0\"]"}},
    {"type": "assert_count", "target": {"selector": "#preview .preview-image"}, "count": 1},
    {"type": "click", "target": {"selector": "#preview-close"}},

    {"type": "click", "target": {"selector": "#list .row[data-value=\"177\"]"}},
    {"type": "assert_count", "target": {"selector": "#remote-bar"}, "count": 1},
    {"type": "click", "target": {"selector": "#flag"}},
    {"type": "assert_count", "target": {"selector": "#list .row[data-value=\"177\"].flagged"}, "count": 1,
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_attribute", "target": {"selector": "#flag"}, "attribute": "aria-pressed", "equals": "true"},
    {"type": "wait", "ms": 400},
    {"type": "capture_surface", "source": "page", "file": "temp/mail/shots/demo-newsletter.png"},

    {"type": "click", "target": {"selector": "#reply"}},
    {"type": "assert_count", "target": {"selector": "#compose"}, "count": 1},
    {"type": "assert_value", "target": {"selector": "#compose-to"}, "equals": "Lambda Weekly <hello@weekly.lambda.demo>"},
    {"type": "assert_value", "target": {"selector": "#compose-subject"}, "equals": "Re: Lambda Weekly #112: Pattern matching for strings"},
    {"type": "assert_value", "target": {"selector": "#compose-body"}, "contains": "> Pattern matching for strings"},
    {"type": "click", "target": {"selector": "#compose-body"}},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Home"},
    {"type": "type_physical", "text": "Great issue, thanks!"},
    {"type": "assert_value", "target": {"selector": "#compose-body"}, "contains": "Great issue, thanks!\n\nOn "},
    {"type": "capture_surface", "source": "page", "file": "temp/mail/shots/demo-compose.png"},
    {"type": "click", "target": {"selector": "#compose-send"}},
    {"type": "assert_count", "target": {"selector": "#compose"}, "count": 0, "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_text", "target": {"selector": "#note"}, "equals": "Message sent."},

    {"type": "click", "target": {"selector": "#get-mail"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "189",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_text", "target": {"selector": "#list .row[data-value=\"189\"] .subject"}, "equals": "Quick one: demo slot confirmed"},

    {"type": "click", "target": {"selector": "#list .row[data-value=\"183\"]"}},
    {"type": "click", "target": {"selector": "#archive"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "188"},
    {"type": "assert_count", "target": {"selector": "#list .row[data-value=\"183\"]"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": "#viewer"}, "attribute": "data-uid", "equals": "182"},
    {"type": "click", "target": {"selector": "#delete"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "187"},
    {"type": "assert_attribute", "target": {"selector": "#viewer"}, "attribute": "data-uid", "equals": "181"},

    {"type": "click", "target": {"selector": ".box.role-sent"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "26",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_text", "target": {"selector": "#list .row[data-value=\"26\"] .sender"}, "equals": "To: Lambda Weekly"},
    {"type": "click", "target": {"selector": "#list .row[data-value=\"26\"]"}},
    {"type": "wait", "ms": 400},
    {"type": "capture_surface", "source": "page", "file": "temp/mail/shots/demo-sent.png"},
    {"type": "click", "target": {"selector": ".box.role-archive"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "61",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "click", "target": {"selector": ".box.role-trash"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "11",
      "assert_timeout": 10000, "assert_interval": 200},

    {"type": "click", "target": {"selector": ".box[data-value=\"Projects\"] .disclosure"}},
    {"type": "assert_count", "target": {"selector": ".box[data-value=\"Projects/Radiant\"]"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": ".box[data-value=\"Projects\"]"}, "attribute": "aria-expanded", "equals": "false"},
    {"type": "click", "target": {"selector": ".box[data-value=\"Projects\"] .disclosure"}},
    {"type": "assert_count", "target": {"selector": ".box[data-value=\"Projects/Radiant\"]"}, "count": 1},

    {"type": "click", "target": {"selector": ".new-box"}},
    {"type": "assert_count", "target": {"selector": "#new-box"}, "count": 1},
    {"type": "select_option", "target": {"selector": "#new-box-parent"}, "value": "Projects"},
    {"type": "type", "target": {"selector": "#new-box-name"}, "text": "Ideas"},
    {"type": "capture_surface", "source": "page", "file": "temp/mail/shots/demo-new-mailbox.png"},
    {"type": "click", "target": {"selector": "#new-box-save"}},
    {"type": "assert_count", "target": {"selector": "#new-box"}, "count": 0},
    {"type": "assert_count", "target": {"selector": ".box.depth-1[data-value=\"Projects/Ideas\"]"}, "count": 1,
      "assert_timeout": 10000, "assert_interval": 200},

    {"type": "click", "target": {"selector": "#compose-new"}},
    {"type": "type", "target": {"selector": "#compose-to"}, "text": "Maya Chen <maya.chen@northwind.example>"},
    {"type": "type", "target": {"selector": "#compose-subject"}, "text": "Demo notes"},
    {"type": "type", "target": {"selector": "#compose-body"}, "text": "Draft for later."},
    {"type": "click", "target": {"selector": "#compose-save"}},
    {"type": "assert_count", "target": {"selector": "#compose"}, "count": 0, "assert_timeout": 10000, "assert_interval": 200},
    {"type": "click", "target": {"selector": ".box.role-drafts"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "4",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "click", "target": {"selector": "#list .row[data-value=\"4\"]"}},
    {"type": "assert_count", "target": {"selector": "#draft-bar"}, "count": 1},
    {"type": "click", "target": {"selector": "#edit-draft"}},
    {"type": "assert_value", "target": {"selector": "#compose-subject"}, "equals": "Demo notes"},
    {"type": "click", "target": {"selector": "#compose-send"}},
    {"type": "assert_count", "target": {"selector": "#compose"}, "count": 0, "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "3",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "wait", "ms": 300}
  ]
}
