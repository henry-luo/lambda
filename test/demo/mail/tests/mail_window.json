{
  "name": "Mail demo: add an account, sync the Inbox, read HTML mail script-free, remote content, attachments, mailboxes",
  "html": "test/demo/mail/mail.ls",
  "viewport": {"width": 1280, "height": 800},
  "events": [
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-loaded", "equals": "true"},
    {"type": "assert_count", "target": {"selector": "#setup"}, "count": 1},
    {"type": "type", "target": {"selector": "#setup-name"}, "text": "Ada (fake)"},
    {"type": "type", "target": {"selector": "#setup-email"}, "text": "ada@fake.test"},
    {"type": "type", "target": {"selector": "#setup-password"}, "text": "secret"},
    {"type": "select_option", "target": {"selector": "#setup-provider"}, "value": "manual"},
    {"type": "assert_count", "target": {"selector": "#setup-imap-host"}, "count": 1},
    {"type": "type", "target": {"selector": "#setup-imap-host"}, "text": "127.0.0.1"},
    {"type": "type", "target": {"selector": "#setup-imap-port"}, "text": "{IMAP_PORT}", "clear": true},
    {"type": "select_option", "target": {"selector": "#setup-imap-security"}, "value": "plain"},
    {"type": "type", "target": {"selector": "#setup-user"}, "text": "ada"},
    {"type": "click", "target": {"selector": "#setup-save"}},
    {"type": "assert_count", "target": {"selector": "#setup"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "5",
      "assert_timeout": 20000, "assert_interval": 200},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-status", "equals": "online",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_count", "target": {"selector": ".box"}, "count": 3},
    {"type": "assert_text", "target": {"selector": ".box.role-drafts .box-name"}, "equals": "Drafts"},
    {"type": "assert_count", "target": {"selector": "#list .row.unread"}, "count": 3},
    {"type": "assert_text", "target": {"selector": "#list .row[data-value=\"2\"] .sender"}, "equals": "Élise"},
    {"type": "capture_surface", "source": "page", "file": "temp/mail/shots/list.png"},

    {"type": "click", "target": {"selector": "#list .row[data-value=\"5\"]"}},
    {"type": "assert_attribute", "target": {"selector": "#viewer"}, "attribute": "data-uid", "equals": "5",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_text", "target": {"selector": "#message-subject"}, "equals": "Weekly ✓"},
    {"type": "assert_attribute", "target": {"selector": "#viewer"}, "attribute": "data-blocked", "equals": "1"},
    {"type": "assert_count", "target": {"selector": "#remote-bar"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#message-frame[sandbox]"}, "count": 1},
    {"type": "wait", "ms": 300},
    {"type": "switch_frame", "selector": "#message-frame"},
    {"type": "assert_text", "target": {"selector": "#out"}, "equals": "static"},
    {"type": "assert_count", "target": {"selector": "#tracker[src]"}, "count": 0},
    {"type": "assert_count", "target": {"selector": "#logo[src^=\"data:image/png\"]"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#link[data-href=\"https://example.com/read\"]"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#link[onclick]"}, "count": 0},
    {"type": "switch_frame"},
    {"type": "assert_attribute", "target": {"selector": "#attachments"}, "attribute": "data-count", "equals": "1"},
    {"type": "capture_surface", "source": "page", "file": "temp/mail/shots/html.png"},

    {"type": "click", "target": {"selector": "#load-remote"}},
    {"type": "assert_attribute", "target": {"selector": "#viewer"}, "attribute": "data-remote", "equals": "true"},
    {"type": "assert_count", "target": {"selector": "#remote-bar"}, "count": 0},
    {"type": "click", "target": {"selector": ".attachment"}},
    {"type": "assert_text", "target": {"selector": ".preview-text"}, "equals": "attached notes"},
    {"type": "click", "target": {"selector": "#preview-close"}},
    {"type": "assert_count", "target": {"selector": "#preview"}, "count": 0},

    {"type": "click", "target": {"selector": "#list .row[data-value=\"1\"]"}},
    {"type": "assert_attribute", "target": {"selector": "#viewer"}, "attribute": "data-uid", "equals": "1",
      "assert_timeout": 10000, "assert_interval": 200},
    {"type": "assert_text", "target": {"selector": "#text-body"}, "contains": "first"},

    {"type": "click", "target": {"selector": ".box.role-drafts"}},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-box", "equals": "Entw&APw-rfe"},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-rows", "equals": "0"},
    {"type": "assert_attribute", "target": {"selector": "#mail"}, "attribute": "data-status", "equals": "online",
      "assert_timeout": 10000, "assert_interval": 200}
  ]
}
