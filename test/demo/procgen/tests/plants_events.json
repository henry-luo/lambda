{
  "name": "Procedural botany: growth, organs, species, resize and terrain navigation",
  "html": "test/demo/procgen/plants.ls",
  "viewport": {
    "width": 1240,
    "height": 1120
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
