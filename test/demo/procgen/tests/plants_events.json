        "selector": "h1"
      },
      "equals": "The glasshouse"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".generator-nav a"
      },
      "count": 5
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".species-tabs button"
      },
      "count": 11
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".seed"
      },
      "equals": "seed 2026"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#growth"
      },
      "equals": "4 / 5"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#angle"
      },
      "equals": "25\u00b0"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".stem"
      },
