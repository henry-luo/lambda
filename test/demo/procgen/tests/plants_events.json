    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/procgen/herb-desktop.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=flower]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".blossom"
      },
      "count": 8
    },
    {
      "type": "resize",
      "width": 760,
      "height": 1060
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".seed"
      },
      "equals": "seed 2026"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('.specimen-card').getBoundingClientRect().right <= window.innerWidth && document.querySelector('.botanical-controls').getBoundingClientRect().top >= document.querySelector('.specimen-card').getBoundingClientRect().bottom"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/procgen/flowers-tablet.png"
    },
    {
      "type": "resize",
      "width": 390,
      "height": 844
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".specimen-caption h2"
      },
      "equals": "Wild cosmos"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('.specimen-card').getBoundingClientRect().right <= window.innerWidth && document.querySelector('.species-tabs').getBoundingClientRect().right <= window.innerWidth"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/procgen/flowers-mobile.png"
    },
    {
      "type": "resize",
      "width": 1240,
      "height": 1120
    },
    {
      "type": "click",
      "target": {
        "selector": ".generator-nav a[href=\"world.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "h1"
      },
      "equals": "Oakesterly",
      "assert_timeout": 60000,
      "assert_interval": 250
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".map"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".generator-nav a[href=\"plants.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "h1"
      },
      "equals": "The glasshouse",
      "assert_timeout": 10000,
      "assert_interval": 100
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".seed"
      },
      "equals": "seed 2026"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=next]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".seed"
