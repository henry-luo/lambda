pub fn glyph(graphic,color="currentColor",weight=1.7) => <path d:strokes[graphic] or strokes.library,fill:"none",stroke:color,'stroke-width':weight,
    'stroke-linecap':"round",'stroke-linejoin':"round">
pub fn icon(graphic, size = 20) => <svg class:"app-icon",focusable:"false", width:string(size),height:string(size),viewBox:"0 0 24 24",'aria-hidden':"true",glyph(graphic)>
