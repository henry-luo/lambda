{
  "name": "Procart painterly: load painting, modes, seed replay, brush, photo, density, source toggle and mobile",
  "html": "test/demo/procart/painterly.ls",
  "viewport": {"width": 1440, "height": 1200},
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {"type": "assert_count", "target": {"selector": ".painterly-canvas"}, "count": 1},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getAttribute('src').startsWith('data:image/png;base64,')"},
    {"type": "assert_text", "target": {"selector": ".specimen-caption h2"}, "equals": "Oriented painterly"},
    {"type": "assert_script", "js": "document.querySelectorAll('.generator-nav a').length===9 && document.querySelector('.generator-nav [aria-current=page]').getAttribute('href')==='painterly.ls'"},
    {"type": "assert_count", "target": {"selector": ".stats-card .stat"}, "count": 5},
    {"type": "capture_surface", "source": "page", "file": "temp/procart-painterly/oriented.png"},
    {"type": "script", "js": "globalThis.firstPainting=document.querySelector('.painterly-canvas').getAttribute('src')"},
    {"type": "click", "target": {"selector": "[data-act=next]"}, "scroll_into_view": true},
    {"type": "assert_text", "target": {"selector": ".seed"}, "equals": "seed 2027"},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getAttribute('src')!==firstPainting"},
    {"type": "click", "target": {"selector": "[data-act=previous]"}, "scroll_into_view": true},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getAttribute('src')===firstPainting"},
    {"type": "click", "target": {"selector": "[data-act=single]"}, "scroll_into_view": true},
    {"type": "assert_text", "target": {"selector": ".specimen-caption h2"}, "equals": "Single scale"},
    {"type": "assert_script", "js": "document.querySelector('[data-act=single]').getAttribute('aria-pressed')==='true'"},
    {"type": "click", "target": {"selector": "[data-act=painterly]"}, "scroll_into_view": true},
    {"type": "assert_text", "target": {"selector": ".specimen-caption h2"}, "equals": "Two-scale painterly"},
    {"type": "click", "target": {"selector": "[data-act=oriented-single]"}, "scroll_into_view": true},
    {"type": "assert_text", "target": {"selector": ".specimen-caption h2"}, "equals": "Oriented strokes"},
    {"type": "click", "target": {"selector": "[data-act=oriented]"}, "scroll_into_view": true},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getAttribute('src')===firstPainting"},
    {"type": "click", "target": {"selector": "[data-act=brush]"}, "scroll_into_view": true},
    {"type": "assert_text", "target": {"selector": "#brush"}, "equals": "Round dab"},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getAttribute('src')!==firstPainting"},
    {"type": "click", "target": {"selector": "[data-act=photo]"}, "scroll_into_view": true},
    {"type": "assert_text", "target": {"selector": "#photo"}, "equals": "Mountains"},
    {"type": "click", "target": {"selector": "[data-act=less]"}, "scroll_into_view": true},
    {"type": "assert_text", "target": {"selector": "#detail"}, "equals": "2 / 5"},
    {"type": "capture_surface", "source": "page", "file": "temp/procart-painterly/mountains-round.png"},
    {"type": "click", "target": {"selector": "[data-act=original]"}, "scroll_into_view": true},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getAttribute('src').endsWith('photo/assets/mountains.jpg') && document.querySelector('[data-act=original]').getAttribute('aria-pressed')==='true'"},
    {"type": "click", "target": {"selector": "[data-act=original]"}, "scroll_into_view": true},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getAttribute('src').startsWith('data:image/png;base64,')"},
    {"type": "resize", "width": 390, "height": 1100},
    {"type": "assert_script", "js": "document.querySelector('.painterly-canvas').getBoundingClientRect().right<=window.innerWidth && document.querySelector('.painterly-canvas').getBoundingClientRect().width>300"},
    {"type": "capture_surface", "source": "page", "file": "temp/procart-painterly/mobile.png"}
  ]
}
