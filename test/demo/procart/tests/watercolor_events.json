    {"type": "assert_script", "js": "document.querySelectorAll('.generator-nav a').length===10 && document.querySelector('.generator-nav [aria-current=page]').getAttribute('href')==='watercolor.ls'"},
    {"type": "assert_count", "target": {"selector": ".species-tabs .species"}, "count": 5},
