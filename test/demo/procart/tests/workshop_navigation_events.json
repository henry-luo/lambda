{
  "name": "All procedural workshops open from their navigation and generate real content",
  "html": "test/demo/procart/world.ls",
  "viewport": {
    "width": 1240,
    "height": 1200
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.generator-nav a').length===6 && document.querySelector('.generator-nav a[href=\"meadow.ls\"]')!==null"
    },
    {
      "type": "click",
      "target": {
        "selector": ".generator-nav a[href=\"rocks.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "h1"
      },
      "equals": "Rocks & crystals"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('.workshop').getAttribute('data-workshop')==='rocks' && document.querySelector('.generator-nav [aria-current=page]').getAttribute('href')==='rocks.ls'"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".seed"
      },
      "equals": "seed 2026"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=\"granite\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".specimen-caption h2"
      },
      "equals": "Granite boulders"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#mineral-scene",
      "width": 320,
      "height": 240,
      "different_from_pixel": [
        0,
        0
      ],
      "count": {
        "min": 1000
      }
    },
    {
      "type": "script",
      "js": "globalThis.mineralMesh=document.querySelector(\"#mineral-model mesh\");globalThis.mineralHome=document.querySelector(\"#mineral-camera\").getAttribute(\"position\");"
    },
    {
      "type": "pointer_drag",
      "pointerType": "mouse",
      "target": {
        "selector": "#mineral-scene",
        "offset_x": 80,
        "offset_y": 80
      },
      "dx": 100,
      "dy": 30,
      "steps": 4
    },
    {
      "type": "assert_script",
      "js": "document.querySelector(\"#mineral-model mesh\")===mineralMesh && document.querySelector(\"#mineral-camera\").getAttribute(\"position\")!==mineralHome"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-camera=reset]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelector(\"#mineral-camera\").getAttribute(\"position\")===mineralHome"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=\"basalt\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".specimen-caption h2"
