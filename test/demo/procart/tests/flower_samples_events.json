    {
      "type": "click",
      "target": {
        "selector": "[data-act=rosette]"
      },
      "scroll_into_view": true
    },
    {
      "type": "script",
      "js": "globalThis.referenceHome=document.getElementById('botanical-camera').getAttribute('position');globalThis.referenceMesh=document.querySelector('#botanical-model mesh')"
    },
    {
      "type": "pointer_drag",
      "pointerType": "mouse",
      "target": {
        "selector": "#botanical-scene",
        "offset_x": 60,
        "offset_y": 60
      },
      "dx": 90,
      "dy": 25,
      "steps": 3
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('botanical-camera').getAttribute('position')!==referenceHome && document.querySelector('#botanical-model mesh')===referenceMesh"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-camera=reset]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('botanical-camera').getAttribute('position')===referenceHome"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=bluecrown]"
      },
      "scroll_into_view": true
    },
    {
      "type": "script",
      "js": "globalThis.petalCount=Array.from(document.querySelectorAll('#botanical-model mesh[geometry=round-petal]')).reduce((n,e)=>n+Number(e.getAttribute('data-count')),0)"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=grow]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#growth"
      },
      "equals": "5 / 5"
    },
    {
      "type": "assert_script",
      "js": "Array.from(document.querySelectorAll('#botanical-model mesh[geometry=round-petal]')).reduce((n,e)=>n+Number(e.getAttribute('data-count')),0)>petalCount"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=prune]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#growth"
      },
      "equals": "4 / 5"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=wider]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_text",
