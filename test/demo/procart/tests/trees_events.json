    {
      "type": "assert_text",
      "target": {
        "selector": "#tree-title"
      },
      "equals": "Summer broadleaf"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#branch-count"
      },
      "equals": "36"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#leaf-count"
      },
      "equals": "560"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#tree-depth"
      },
      "equals": "3"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "mesh[data-organ=bark]"
      },
      "count": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "mesh[data-organ=leaf]"
      },
      "min": 1
