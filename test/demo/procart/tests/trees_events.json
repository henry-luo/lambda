{
  "name": "Procart Tree studio: architecture, development, detail, saved replay and retained orbit",
  "html": "test/demo/procart/trees.ls",
  "viewport": {
    "width": 1440,
    "height": 1200
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
