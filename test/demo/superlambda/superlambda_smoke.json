{
  "name": "Superlambda keyboard, jumping, coins, pause, pointer controls and close",
  "html": "test/demo/superlambda/superlambda.ls",
  "viewport": {"width": 1024, "height": 800},
  "events": [
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-mode","equals":"ready"},
    {"type":"advance_time","ms":80,"steps":2},
    {"type":"click","target":{"selector":"#overlay-action"}},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-mode","equals":"playing"},
    {"type":"key_down","key":"ArrowRight"},
    {"type":"advance_time","ms":400,"steps":10},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-x","not_contains":"72"},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-moving","equals":"true"},
    {"type":"key_up","key":"ArrowRight"},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-moving","equals":"false"},
    {"type":"advance_time","ms":400,"steps":10},
    {"type":"key_down","key":"Space"},
    {"type":"advance_time","ms":240,"steps":6},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-grounded","equals":"false"},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-y","not_contains":"360"},
    {"type":"key_up","key":"Space"},
    {"type":"advance_time","ms":1600,"steps":40},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-grounded","equals":"true"},
    {"type":"key_press","key":"P"},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-mode","equals":"paused"},
    {"type":"advance_time","ms":1200,"steps":30},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-y","equals":"360"},
    {"type":"click","target":{"selector":"#overlay-action"}},
    {"type":"key_down","key":"ArrowRight"},
    {"type":"advance_time","ms":720,"steps":18},
    {"type":"key_up","key":"ArrowRight"},
    {"type":"assert_text","target":{"selector":"#coins"},"equals":"● 2"},
    {"type":"assert_text","target":{"selector":"#score"},"equals":"200"},
    {"type":"assert_text","target":{"selector":"#lives"},"equals":"3 / 3"},
    {"type":"key_press","key":"R"},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-x","equals":"72"},
    {"type":"assert_text","target":{"selector":"#score"},"equals":"0"},
    {"type":"mouse_down","target":{"selector":".control-right"}},
    {"type":"advance_time","ms":400,"steps":10},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-moving","equals":"true"},
    {"type":"mouse_up","target":{"selector":".control-right"}},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-moving","equals":"false"},
    {"type":"advance_time","ms":8000,"steps":200},
    {"type":"assert_attribute","target":{"selector":"#superlambda"},"attribute":"data-mode","equals":"playing"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
