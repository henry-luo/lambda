{
  "version": 3,
  "comment": "Lambda paint demo: a pressure-sized inking pen with smoothed tracking. Original settings for this demo.",
  "group": "",
  "parent_brush_name": "",
  "settings": {
    "opaque": {"base_value": 1.0, "inputs": {}},
