    {name:"Currency & Greek",chars:["€","£","¥","¢","α","β","γ","δ","ε","θ","λ","μ","π","σ","φ","Ω"]},
    {name:"Arrows",chars:["←","↑","→","↓","↔","↕","⇒","⇔"]}
