// Northstar / Strategy 2027 — an 18-slide fictional leadership briefing (illustrative data).
// ./lambda.exe view test/demo/slides/northstar.slides
<presentation id: "northstar", autostart: true, title: "Northstar / Strategy 2027", width: 1280, height: 720,
    <slide id: "opening", title: "A clearer path to durable growth", background: "#102738",
        <shape id: "cover-accent", x: 72, y: 62, width: 42, height: 6, kind: 'rect', fill: "#7de0c0", radius: 0>
        <text id: "cover-brand", x: 132, y: 51, width: 700, height: 35, font_size: 17, color: "#7de0c0", style: "font-weight:700;line-height:1.2;", "NORTHSTAR  /  STRATEGY & OPERATIONS">
        <text id: "headline", x: 72, y: 155, width: 720, height: 210, font_size: 68, color: "#ffffff", style: "font-weight:700;line-height:1.2;", "A clearer path\nto durable growth.">
        <text id: "cover-copy", x: 76, y: 402, width: 660, height: 90, font_size: 27, color: "#bed0d5", style: "font-weight:400;line-height:1.2;", "One operating system.\nA focused plan for the next stage.">
        <text id: "cover-date", x: 76, y: 560, width: 660, height: 35, font_size: 16, color: "#7de0c0", style: "font-weight:700;line-height:1.2;", "LEADERSHIP BRIEFING  /  2027">
        <content id: "hero", x: 815, y: 132, width: 380, height: 430,
            <svg width: 380, height: 430, viewBox: "0 0 380 430",
                <circle cx: 190, cy: 210, r: 72, fill: "none", stroke: "#355160", stroke-width: 1>
                <circle cx: 190, cy: 210, r: 122, fill: "none", stroke: "#355160", stroke-width: 1>
                <circle cx: 190, cy: 210, r: 172, fill: "none", stroke: "#355160", stroke-width: 1>
                <path d: "M30 348 L121 281 L190 210 L274 132 L344 56", fill: "none", stroke: "#7de0c0", stroke-width: 4>
                <circle cx: 30, cy: 348, r: 8, fill: "#7de0c0">
                <circle cx: 121, cy: 281, r: 8, fill: "#7de0c0">
                <circle cx: 190, cy: 210, r: 8, fill: "#7de0c0">
                <circle cx: 274, cy: 132, r: 8, fill: "#7de0c0">
                <circle cx: 344, cy: 56, r: 8, fill: "#7de0c0">
                <circle cx: 190, cy: 210, r: 30, fill: "#102738", stroke: "#7de0c0", stroke-width: 2>
                <path d: "M190 191 L195 205 L210 210 L195 215 L190 229 L185 215 L170 210 L185 205 Z", fill: "#7de0c0">
                <text x: 25, y: 407, fill: "#bed0d5", font-family: "Arial", font-size: 14, font-weight: 700, "FOCUS  /  MOMENTUM  /  SCALE">
            >
        >
        <shape id: "footer-rule", x: 72, y: 654, width: 1136, height: 1, kind: 'rect', fill: "#34505c", radius: 0>
        <text id: "brand", x: 72, y: 673, width: 650, height: 20, font_size: 12, color: "#acc2ca", style: "font-weight:700;line-height:1.2;", "NORTHSTAR  /  STRATEGY 2027  /  ILLUSTRATIVE DATA">
        <text id: "page-number", x: 1134, y: 669, width: 74, height: 26, font_size: 16, color: "#acc2ca", style: "font-weight:700;line-height:1.2;", "01 / 18">
        <cue start: 'entry',
            <parallel
                <effect target: "headline", kind: 'fly-in', duration: 480, delay: 0, easing: 'ease-out-cubic'>
                <effect target: "hero", kind: 'zoom-in', duration: 480, delay: 100, easing: 'ease-out-cubic'>
            >
        >
        <notes "A fictional board-style briefing. All company names, metrics and forecasts are illustrative. Use Next for each build and slide.">
    >
    <slide id: "chapter-2", title: "Grow with focus. Scale with discipline.", background: "#f3f6f5", transition: 'fade', transition_duration: 360,
        <shape id: "accent", x: 72, y: 47, width: 34, height: 5, kind: 'rect', fill: "#087f78", radius: 0>
        <text id: "section", x: 120, y: 39, width: 1000, height: 26, font_size: 15, color: "#087f78", style: "font-weight:700;line-height:1.2;", "01  /  THE THESIS">
        <text id: "headline", x: 72, y: 94, width: 1136, height: 70, font_size: 44, color: "#183747", style: "font-weight:700;line-height:1.2;", "Grow with focus. Scale with discipline.">
        <text id: "subtitle", x: 72, y: 169, width: 1136, height: 56, font_size: 21, color: "#617884", style: "font-weight:400;line-height:1.2;", "Three choices connect the customer promise to a repeatable operating model.">
        <group id: "hero", x: 72, y: 253, width: 1136, height: 276,
            <content id: "focus", x: 0, y: 0, width: 362, height: 276,
                <div style: "width:100%;height:276px;box-sizing:border-box;padding:26px;border:1px solid #dce5e5;border-radius:14px;background:#ffffff;color:#183747;font-size:20px;line-height:1.4;",
                    <div style: "font-size:15px;font-weight:700;letter-spacing:1.5px;color:#087f78;margin-bottom:16px;", "01 / WIN THE RIGHT CUSTOMER">
                    <div style: "font-size:30px;font-weight:700;line-height:1.1;color:#183747;margin-bottom:14px;", "Focus the market">
                    <div style: "font-size:20px;line-height:1.4;color:#617884;", "Prioritize operations teams in complex, multi-site businesses. Build depth before expanding breadth.">
                >
            >
            <content id: "value", x: 387, y: 0, width: 362, height: 276,
                <div style: "width:100%;height:276px;box-sizing:border-box;padding:26px;border:1px solid #dce5e5;border-radius:14px;background:#ffffff;color:#183747;font-size:20px;line-height:1.4;",
                    <div style: "font-size:15px;font-weight:700;letter-spacing:1.5px;color:#356cce;margin-bottom:16px;", "02 / PROVE THE VALUE">
                    <div style: "font-size:30px;font-weight:700;line-height:1.1;color:#183747;margin-bottom:14px;", "Shorten time to impact">
                    <div style: "font-size:20px;line-height:1.4;color:#617884;", "Turn fragmented workflows into measurable outcomes in the first 30 days.">
                >
            >
            <content id: "scale", x: 774, y: 0, width: 362, height: 276,
                <div style: "width:100%;height:276px;box-sizing:border-box;padding:26px;border:1px solid #dce5e5;border-radius:14px;background:#ffffff;color:#183747;font-size:20px;line-height:1.4;",
                    <div style: "font-size:15px;font-weight:700;letter-spacing:1.5px;color:#b86c47;margin-bottom:16px;", "03 / EARN THE RIGHT TO SCALE">
                    <div style: "font-size:30px;font-weight:700;line-height:1.1;color:#183747;margin-bottom:14px;", "Compound the model">
                    <div style: "font-size:20px;line-height:1.4;color:#617884;", "Align product, distribution and service around one measurable customer journey.">
                >
            >
        >
        <content id: "decision", x: 72, y: 551, width: 1136, height: 76,
            <div style: "width:100%;height:76px;box-sizing:border-box;padding:26px;border:1px solid #dce5e5;border-radius:14px;background:#e0f1eb;color:#183747;font-size:20px;line-height:1.4;",
                <div style: "font-size:21px;font-weight:700;color:#087f78;", "THE DECISION  /  Invest in activation and expansion before adding new segments.">
            >
        >
        <shape id: "footer-rule", x: 72, y: 654, width: 1136, height: 1, kind: 'rect', fill: "#dce5e5", radius: 0>
        <text id: "brand", x: 72, y: 673, width: 650, height: 20, font_size: 12, color: "#617884", style: "font-weight:700;line-height:1.2;", "NORTHSTAR  /  STRATEGY 2027  /  ILLUSTRATIVE DATA">
        <text id: "page-number", x: 1134, y: 669, width: 74, height: 26, font_size: 16, color: "#617884", style: "font-weight:700;line-height:1.2;", "02 / 18">
        <cue start: 'entry',
            <parallel
                <effect target: "headline", kind: 'fade-in', duration: 480, delay: 0, easing: 'ease-out-cubic'>
                <effect target: "hero", kind: 'fade-in', duration: 480, delay: 80, easing: 'ease-out-cubic'>
            >
        >
        <cue
            <effect target: "decision", kind: 'wipe-in', duration: 480, delay: 0, easing: 'ease-out-cubic'>
        >
        <notes "Reveal the decision after walking through the three pillars.">
    >
    <slide id: "chapter-3", title: "The market is moving from tools to outcomes.", background: "#f3f6f5", transition: 'push', transition_duration: 360,
        <shape id: "accent", x: 72, y: 47, width: 34, height: 5, kind: 'rect', fill: "#087f78", radius: 0>
        <text id: "section", x: 120, y: 39, width: 1000, height: 26, font_size: 15, color: "#087f78", style: "font-weight:700;line-height:1.2;", "02  /  MARKET CONTEXT">
        <text id: "headline", x: 72, y: 94, width: 1136, height: 70, font_size: 44, color: "#183747", style: "font-weight:700;line-height:1.2;", "The market is moving from tools to outcomes.">
        <text id: "subtitle", x: 72, y: 169, width: 1136, height: 56, font_size: 21, color: "#617884", style: "font-weight:400;line-height:1.2;", "Buyers want fewer handoffs, clearer accountability and a faster return on investment.">
        <group id: "hero", x: 72, y: 248, width: 1136, height: 358,
            <content id: "shift-0", x: 0, y: 0, width: 1136, height: 104,
                <div style: "width:100%;height:104px;box-sizing:border-box;padding:26px;border:1px solid #dce5e5;border-radius:14px;background:#ffffff;color:#183747;font-size:20px;line-height:1.4;",
                    <div style: "display:flex;align-items:center;gap:28px;",
                        <div style: "width:45px;font-size:30px;font-weight:700;color:#087f78;", "01">
                        <div style: "width:255px;font-size:25px;font-weight:700;", "Fragmented stacks">
                        <div style: "width:325px;color:#617884;font-size:20px;", "A different tool for every team">
                        <div style: "color:#087f78;font-size:25px;", ">">
                        <div style: "width:330px;font-weight:700;font-size:20px;", "One connected execution layer">
                    >
                >
            >
            <content id: "shift-1", x: 0, y: 120, width: 1136, height: 104,
                <div style: "width:100%;height:104px;box-sizing:border-box;padding:26px;border:1px solid #dce5e5;border-radius:14px;background:#ffffff;color:#183747;font-size:20px;line-height:1.4;",
                    <div style: "display:flex;align-items:center;gap:28px;",
                        <div style: "width:45px;font-size:30px;font-weight:700;color:#356cce;", "02">
                        <div style: "width:255px;font-size:25px;font-weight:700;", "Higher scrutiny">
                        <div style: "width:325px;color:#617884;font-size:20px;", "Software purchased on potential">
                        <div style: "color:#087f78;font-size:25px;", ">">
                        <div style: "width:330px;font-weight:700;font-size:20px;", "Expansion earned through proof">
                    >
                >
            >
            <content id: "shift-2", x: 0, y: 240, width: 1136, height: 104,
                <div style: "width:100%;height:104px;box-sizing:border-box;padding:26px;border:1px solid #dce5e5;border-radius:14px;background:#ffffff;color:#183747;font-size:20px;line-height:1.4;",
                    <div style: "display:flex;align-items:center;gap:28px;",
                        <div style: "width:45px;font-size:30px;font-weight:700;color:#b86c47;", "03">
                        <div style: "width:255px;font-size:25px;font-weight:700;", "Lean operating teams">
                        <div style: "width:325px;color:#617884;font-size:20px;", "More dashboards and manual checks">
                        <div style: "color:#087f78;font-size:25px;", ">">
                        <div style: "width:330px;font-weight:700;font-size:20px;", "Actionable exceptions and automation">
                    >
                >
            >
        >
        <shape id: "footer-rule", x: 72, y: 654, width: 1136, height: 1, kind: 'rect', fill: "#dce5e5", radius: 0>
        <text id: "brand", x: 72, y: 673, width: 650, height: 20, font_size: 12, color: "#617884", style: "font-weight:700;line-height:1.2;", "NORTHSTAR  /  STRATEGY 2027  /  ILLUSTRATIVE DATA">
        <text id: "page-number", x: 1134, y: 669, width: 74, height: 26, font_size: 16, color: "#617884", style: "font-weight:700;line-height:1.2;", "03 / 18">
        <cue start: 'entry',
            <parallel
                <effect target: "headline", kind: 'fade-in', duration: 480, delay: 0, easing: 'ease-out-cubic'>
                <effect target: "hero", kind: 'fade-in', duration: 480, delay: 80, easing: 'ease-out-cubic'>
            >
        >
        <notes "Position Northstar as an execution layer, with specific outcomes rather than a broad platform claim.">
