{
  "name": "Lambda Tetris keyboard, buttons, hold, pause, gravity and restart",
  "html": "test/demo/tetris.ls",
  "viewport": {"width": 900, "height": 1000},
  "events": [
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-mode","equals":"ready"},
    {"type":"assert_visible","target":{"selector":"#overlay-action"},"visible":true},
    {"type":"click","target":{"selector":"#overlay-action"}},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-mode","equals":"playing"},
    {"type":"key_press","key":"ArrowLeft"},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-x","equals":"2"},
    {"type":"key_press","key":"ArrowRight"},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-x","equals":"3"},
    {"type":"key_press","key":"ArrowUp"},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-rotation","equals":"1"},
    {"type":"key_press","key":"Z"},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-rotation","equals":"0"},
    {"type":"key_press","key":"ArrowDown"},
    {"type":"assert_text","target":{"selector":"#score"},"equals":"1"},
    {"type":"click","target":{"selector":".hold"}},
    {"type":"assert_text","target":{"selector":".hint"},"equals":"Available after locking"},
    {"type":"click","target":{"selector":".drop"}},
    {"type":"assert_text","target":{"selector":".hint"},"equals":"Swap once per piece"},
    {"type":"key_press","key":"P"},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-mode","equals":"paused"},
    {"type":"advance_time","ms":1600,"steps":32},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-y","equals":"0"},
    {"type":"click","target":{"selector":"#overlay-action"}},
    {"type":"advance_time","ms":850,"steps":17},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-y","equals":"1"},
    {"type":"click","target":{"selector":"#restart"}},
    {"type":"assert_text","target":{"selector":"#score"},"equals":"0"},
    {"type":"assert_text","target":{"selector":"#lines"},"equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#tetris"},"attribute":"data-mode","equals":"playing"}
  ]
}
