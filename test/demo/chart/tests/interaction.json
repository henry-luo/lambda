{
  "name": "Chart demo playback, independent selection, filtering and complete gallery",
  "viewport": {
    "width": 1180,
    "height": 1200
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_count",
      "target": {
        "selector": ".dashboard-gallery > .card"
      },
      "count": 44
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "[data-gallery-step], .gallery-page"
      },
      "count": 0
    },
    {
      "type": "assert_script",
      "js": "(function(){var b=[0,1,2,3].map(i=>document.getElementById('example-'+i).getBoundingClientRect());return Math.abs(b[0].top-b[1].top)<1&&Math.abs(b[0].top-b[2].top)<1&&b[0].left<b[1].left&&b[1].left<b[2].left&&b[3].top>b[0].top})()"
    },
    {
      "type": "advance_time",
      "ms": 200,
      "steps": 4
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-0 [data-play-command='pause']"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#animation-0 .lambda-chart"
      },
      "attribute": "data-chart-playback",
      "equals": "paused"
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-0 [data-play-command='seek']"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#animation-0 .playback-phase"
      },
      "equals": "seek"
    },
    {
      "type": "snapshot_surface",
      "source": "page",
      "name": "midpoint"
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-0 [data-play-command='play']"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-0 [data-play-command='pause']"
      }
    },
    {
      "type": "assert_surface",
      "source": "page",
      "reference": "midpoint",
      "region": [
        60,
        400,
        350,
        230
      ],
      "count": {
        "min": 20
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-0 [data-play-command='resume']"
      }
    },
    {
      "type": "advance_time",
      "ms": 3000,
      "steps": 6
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#animation-0 .lambda-chart"
      },
      "attribute": "data-chart-playback",
      "equals": "ended"
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-1 [data-play-command='play']"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#animation-1 .lambda-chart"
      },
      "attribute": "data-chart-playback",
      "equals": "playing"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#animation-0 .lambda-chart"
      },
      "attribute": "data-chart-playback",
      "equals": "ended"
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-1 [data-play-command='pause']"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#animation-1 [data-play-command='seek']"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#animation-1 path[data-chart-key]"
      },
      "min": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "#selection .points circle"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#selection .points circle"
      },
      "attribute": "fill",
      "equals": "#317e78"
    },
    {
      "type": "script",
      "js": "globalThis.zoomStart=JSON.parse(document.querySelector('#zoom [data-chart-frame]').getAttribute('data-chart-frame')).scales.x.domain[0]"
    },
    {
      "type": "mouse_down",
      "target": {
        "selector": "#zoom [data-chart-root]",
        "offset_x": 120,
        "offset_y": 120
      },
      "scroll_into_view": true
    },
    {
      "type": "mouse_move",
      "target": {
        "selector": "#zoom [data-chart-root]",
        "offset_x": 200,
        "offset_y": 120
      }
    },
    {
      "type": "mouse_up",
      "target": {
        "selector": "#zoom [data-chart-root]",
        "offset_x": 200,
        "offset_y": 120
      }
    },
    {
      "type": "assert_script",
      "js": "JSON.parse(document.querySelector('#zoom [data-chart-frame]').getAttribute('data-chart-frame')).scales.x.domain[0]!==zoomStart"
    },
    {
      "type": "dblclick",
      "target": {
        "selector": "#zoom [data-chart-root]",
        "offset_x": 120,
        "offset_y": 120
      }
    },
    {
      "type": "assert_script",
      "js": "JSON.parse(document.querySelector('#zoom [data-chart-frame]').getAttribute('data-chart-frame')).scales.x.domain[0]===zoomStart"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#linked [data-chart-view='chart-c1']"
      },
      "count": 8
    },
    {
      "type": "mouse_down",
      "target": {
        "selector": "#linked [data-chart-root='chart-c0']",
        "offset_x": 120,
        "offset_y": 100
      },
      "scroll_into_view": true
    },
    {
      "type": "mouse_move",
      "target": {
        "selector": "#linked [data-chart-root='chart-c0']",
        "offset_x": 280,
        "offset_y": 120
      }
    },
    {
      "type": "mouse_up",
      "target": {
        "selector": "#linked [data-chart-root='chart-c0']",
        "offset_x": 280,
        "offset_y": 120
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#linked .chart-brush"
      },
      "count": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#linked [data-chart-view='chart-c1']"
      },
      "min": 1,
      "max": 7
    },
    {
      "type": "dblclick",
      "target": {
        "selector": "#linked [data-chart-root='chart-c0']",
        "offset_x": 120,
        "offset_y": 100
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#linked [data-chart-view='chart-c1']"
      },
      "count": 8
    },
    {
      "type": "focus",
      "target": {
        "selector": "[data-chart-input='minimum']"
      },
      "scroll_into_view": true
    },
    {
      "type": "key_press",
      "key": "End"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "[data-chart-input='minimum']"
      },
      "equals": "350"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#linked [data-chart-view='chart-c1']"
      },
      "count": 1
    },
    {
      "type": "key_press",
      "key": "Home"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#linked [data-chart-view='chart-c1']"
      },
      "count": 8
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/chart-demo/interaction-desktop.png"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#example-8 .lambda-chart > svg"
      },
      "min": 1
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#example-43 .lambda-chart > svg"
      },
      "min": 1,
      "assert_timeout": 60000,
      "assert_interval": 50
    },
    {
      "type": "window_close"
    },
    {
      "type": "assert_window_closed",
      "closed": true
    }
  ]
}
