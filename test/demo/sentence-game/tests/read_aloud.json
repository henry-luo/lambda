{
  "name": "Sentence game read-aloud: the built sentence, its stop toggle and double-clicked cards (fake speech engine)",
  "html": "test/demo/sentence-game/sentence-game.ls",
  "viewport": {"width": 1180, "height": 1000},
  "env": [
    {"key": "LAMBDA_SPEECH_ENGINE", "value": "fake"},
    {"key": "LAMBDA_AUDIO_OUTPUT", "value": "offline"}
  ],
  "events": [
    {"type":"click","target":{"selector":"#level-1"}},
    {"type":"click","target":{"selector":"#pattern-pair"}},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"disabled","equals":"disabled"},
    {"type":"dblclick","target":{"selector":"#subject-cards .card"}},
    {"type":"assert_count","target":{"selector":"#subject-cards .card[aria-pressed=\"true\"]"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"false"},
    {"type":"focus","target":{"selector":"#predicate-cards .card"}},
    {"type":"key_press","key":"Enter"},
    {"type":"assert_count","target":{"selector":"#predicate-cards .card[aria-pressed=\"true\"]"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"disabled","present":false},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"data-say","contains":"."},
    {"type":"click","target":{"selector":"#read-aloud"}},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_text","target":{"selector":"#read-aloud"},"contains":"Stop"},
    {"type":"advance_time","ms":4000,"steps":240},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"false"},
    {"type":"assert_text","target":{"selector":"#read-aloud"},"contains":"Read aloud"},
    {"type":"click","target":{"selector":"#read-aloud"}},
    {"type":"advance_time","ms":300,"steps":18},
    {"type":"click","target":{"selector":"#read-aloud"}},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"false"},
    {"type":"click","target":{"selector":"#read-aloud"}},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"true"},
    {"type":"dblclick","target":{"selector":"#predicate-cards .card"}},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"false"},
    {"type":"advance_time","ms":3000,"steps":180},
    {"type":"click","target":{"selector":"#nav-level-2"}},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"disabled","equals":"disabled"},
    {"type":"dblclick","target":{"selector":"#word-bank .word-card"}},
    {"type":"assert_count","target":{"selector":"#ordered-words .placed-word"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"disabled","present":false},
    {"type":"click","target":{"selector":"#read-aloud"}},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"true"},
    {"type":"advance_time","ms":2000,"steps":120},
    {"type":"assert_attribute","target":{"selector":"#read-aloud"},"attribute":"aria-pressed","equals":"false"},
    {"type":"capture_surface","source":"page","file":"temp/sentence-game/read-aloud.png"}
  ]
}
