{
  "name": "Sentence game pattern picker, five-sentence book and restart",
  "html": "test/demo/sentence-game/sentence-game.ls",
  "viewport": {
    "width": 1180,
    "height": 1000
  },
  "events": [
    {"type":"click","target":{"selector":"#level-1"}},
    {"type":"assert_count","target":{"selector":".pattern-choice"},"count":14},
    {"type":"click","target":{"selector":"#pattern-pair"}},
    {"type":"assert_attribute","target":{"selector":"#primary"},"attribute":"disabled","equals":"disabled"},
    {"type":"focus","target":{"selector":"#sentence-game"}},
    {"type":"key_press","key":"A"},
    {"type":"assert_count","target":{"selector":"#subject-cards .card[aria-pressed=\"true\"]"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#primary"},"attribute":"disabled","equals":"disabled"},
    {"type":"focus","target":{"selector":"#sentence-game"}},
    {"type":"key_press","key":"J"},
    {"type":"assert_text","target":{"selector":"#sentence-preview"},"contains":"."},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-phase","equals":"saved"},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-count","equals":"1"},
    {"type":"assert_text","target":{"selector":"#feedback"},"contains":"!"},
    {"type":"assert_attribute","target":{"selector":"#subject-cards .card"},"attribute":"disabled","equals":"disabled"},
    {"type":"capture_surface","source":"page","file":"temp/sentence-game/saved.png"},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"click","target":{"selector":"#pattern-place"}},
    {"type":"click","target":{"selector":"#subject-cards .card .card-art"}},
    {"type":"click","target":{"selector":"#predicate-cards .card"}},
    {"type":"click","target":{"selector":"#where-cards .card"}},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-count","equals":"2"},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"click","target":{"selector":"#pattern-time"}},
    {"type":"click","target":{"selector":"#subject-cards .card"}},
    {"type":"click","target":{"selector":"#predicate-cards .card"}},
    {"type":"click","target":{"selector":"#when-cards .card"}},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-count","equals":"3"},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"click","target":{"selector":"#pattern-place-time"}},
    {"type":"click","target":{"selector":"#subject-cards .card"}},
    {"type":"click","target":{"selector":"#predicate-cards .card"}},
    {"type":"click","target":{"selector":"#where-cards .card"}},
    {"type":"click","target":{"selector":"#when-cards .card"}},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"click","target":{"selector":"#pattern-story"}},
    {"type":"click","target":{"selector":"#subject-cards .card"}},
    {"type":"click","target":{"selector":"#predicate-cards .card"}},
    {"type":"click","target":{"selector":"#object-cards .card"}},
    {"type":"click","target":{"selector":"#where-cards .card"}},
    {"type":"click","target":{"selector":"#when-cards .card"}},
    {"type":"click","target":{"selector":"#join-and"}},
    {"type":"click","target":{"selector":"#subject-cards .card"}},
    {"type":"click","target":{"selector":"#predicate-cards .card"}},
    {"type":"click","target":{"selector":"#object-cards .card"}},
    {"type":"click","target":{"selector":"#where-cards .card"}},
    {"type":"click","target":{"selector":"#when-cards .card"}},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-count","equals":"5"},
    {"type":"assert_count","target":{"selector":".sentence-chip"},"count":5},
    {"type":"focus","target":{"selector":"#primary"}},
    {"type":"key_press","key":"Enter"},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-phase","equals":"done"},
    {"type":"assert_count","target":{"selector":".recap-line"},"count":5},
    {"type":"assert_text","target":{"selector":"#finish-heading"},"equals":"You made a tiny book!"},
    {"type":"capture_surface","source":"page","file":"temp/sentence-game/finished.png"},
    {"type":"click","target":{"selector":"#play-again"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-count","equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-phase","equals":"pattern"},
    {"type":"assert_count","target":{"selector":".pattern-choice"},"count":14}
  ]
}
