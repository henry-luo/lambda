{
  "name": "Sentence game objects, conjunctions, mixed clauses and undo",
  "html": "test/demo/sentence-game/sentence-game.ls",
  "viewport": {"width": 1280, "height": 1150},
  "events": [
    {"type":"focus","target":{"selector":"#sentence-game"}},
    {"type":"key_press","key":"A"},
    {"type":"key_press","key":"J"},
    {"type":"assert_text","target":{"selector":"#sentence-preview"},"equals":"Grandma lays eggs."},
    {"type":"click","target":{"selector":"#join-and"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-joins","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#primary"},"attribute":"disabled","equals":"disabled"},
    {"type":"focus","target":{"selector":"#sentence-game"}},
    {"type":"key_press","key":"A"},
    {"type":"key_press","key":"J"},
    {"type":"assert_text","target":{"selector":"#sentence-preview"},"contains":", and "},
    {"type":"click","target":{"selector":"#undo-join"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-joins","equals":"0"},
    {"type":"assert_text","target":{"selector":"#sentence-preview"},"equals":"Grandma lays eggs."},
    {"type":"click","target":{"selector":"#join-but"}},
    {"type":"click","target":{"selector":"#mode-3"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-mode","equals":"3"},
    {"type":"assert_count","target":{"selector":".card"},"count":9},
    {"type":"assert_count","target":{"selector":"#object-cards .card"},"count":3},
    {"type":"assert_position","element_a":{"selector":"#subject-caption"},"element_b":{"selector":"#subject-cards"},"relation":"above"},
    {"type":"focus","target":{"selector":"#sentence-game"}},
    {"type":"key_press","key":"A"},
    {"type":"key_press","key":"J"},
    {"type":"assert_text","target":{"selector":"#sentence-preview"},"contains":"[object]"},
    {"type":"assert_attribute","target":{"selector":"#primary"},"attribute":"disabled","equals":"disabled"},
    {"type":"key_press","key":"Z"},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-object","equals":"pancakes"},
    {"type":"assert_text","target":{"selector":"#sentence-preview"},"equals":"Grandma lays eggs, but the joker wears blueberry pancakes."},
    {"type":"capture_surface","source":"page","file":"temp/sentence-game/three-parts.png"},
    {"type":"click","target":{"selector":"#join-or"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-joins","equals":"2"},
    {"type":"focus","target":{"selector":"#sentence-game"}},
    {"type":"key_press","key":"A"},
    {"type":"key_press","key":"J"},
    {"type":"key_press","key":"Z"},
    {"type":"assert_text","target":{"selector":"#sentence-preview"},"equals":"Grandma lays eggs, but the joker wears blueberry pancakes, or my robot wears a robot dance."},
    {"type":"assert_count","target":{"selector":".word-connector"},"count":2},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-count","equals":"1"},
    {"type":"assert_text","target":{"selector":"#feedback"},"contains":"conjunctions"},
    {"type":"capture_surface","source":"page","file":"temp/sentence-game/compound.png"},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-joins","equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-object","equals":""},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-mode","equals":"3"},
    {"type":"focus","target":{"selector":"#sentence-game"}},
    {"type":"key_press","key":"A"},
    {"type":"key_press","key":"J"},
    {"type":"key_press","key":"Z"},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-count","equals":"2"},
    {"type":"click","target":{"selector":"#primary"}},
    {"type":"click","target":{"selector":"#mode-2"}},
    {"type":"assert_attribute","target":{"selector":"#sentence-game"},"attribute":"data-mode","equals":"2"},
    {"type":"assert_count","target":{"selector":".card"},"count":6},
    {"type":"assert_count","target":{"selector":"#object-cards"},"count":0}
  ]
}
