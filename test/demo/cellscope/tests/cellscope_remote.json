{
  "name": "CellScope published models (requires network)",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "events": [
    {
      "type": "advance_time",
      "ms": 60
    },
    {
      "type": "script",
      "js": "document.getElementById('choose-muscle').click()"
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('model-loading').style.display==='flex'&&document.getElementById('loading-specimen').textContent==='Muscle Cell'&&document.getElementById('scene-pair').getAttribute('aria-busy')==='true'"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/cellscope-loading-muscle.png"
    },
    {
      "type": "advance_time",
      "ms": 32,
      "steps": 2
    },
    {
      "type": "assert_script",
      "js": "((()=>{const v=document.querySelector('#cell-scene');const slot=v.querySelector('#imported-specimen');const gs=Array.from(slot.querySelectorAll('geometry'));return slot.getAttribute('data-model')==='muscle'&&slot.getAttribute('data-error')===''&&v.getAttribute('data-model-source')==='https://assets.lanshuagent.com/models/muscle-cell-tripo-skeletal-fiber-textured-pbr.glb.bin'&&gs.length>0&&gs.reduce((n,g)=>n+JSON.parse(g.getAttribute('indices')).length,0)===5936499&&gs.every(g=>JSON.parse(g.getAttribute('normals')).length===JSON.parse(g.getAttribute('positions')).length&&JSON.parse(g.getAttribute('uvs')).length*3===JSON.parse(g.getAttribute('positions')).length*2)&&slot.querySelectorAll('texture').length===1&&slot.querySelector('texture').getAttribute('src').startsWith('data:image/jpeg;base64,')})())&&document.getElementById('model-loading').style.display==='none'&&document.getElementById('scene-pair').getAttribute('aria-busy')==='false'"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 256,
      "height": 192,
      "different_from_pixel": [
        0,
        0
      ],
      "count": {
        "min": 300
      }
    },
    {
      "type": "capture_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 1024,
      "height": 768,
      "file": "temp/cellscope-remote-muscle.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#part-muscle-mitochondria"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('detail-muscle-mitochondria').style.display==='block' && document.getElementById('scene-label').textContent==='MUSCLE CELL / TEXTURED 3D MODEL'"
    },
    {
      "type": "script",
      "js": "globalThis.loadedMuscle=document.querySelector('#cell-scene #imported-specimen').firstElementChild"
    },
    {
      "type": "click",
      "target": {
        "selector": "#zoom-in"
      }
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#cell-scene #imported-specimen').firstElementChild===loadedMuscle"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#peer"
      },
      "value": "plant"
    },
    {
      "type": "click",
      "target": {
        "selector": "#compare"
      }
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#peer-scene #imported-specimen').getAttribute('data-model')==='plant'&&document.querySelector('#cell-scene #imported-specimen').getAttribute('data-model')==='muscle'"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#peer-scene",
      "width": 256,
      "height": 192,
      "different_from_pixel": [
        0,
        0
      ],
      "count": {
        "min": 300
      }
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/cellscope-muscle-comparison.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#compare"
      }
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/cellscope-muscle-page.png"
    },
    {
      "type": "script",
      "js": "document.getElementById('choose-whiteBlood').click()"
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('model-loading').style.display==='flex'&&document.getElementById('loading-specimen').textContent==='White Blood Cell'&&document.getElementById('scene-pair').getAttribute('aria-busy')==='true'"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/cellscope-loading-whiteBlood.png"
    },
    {
      "type": "advance_time",
      "ms": 32,
      "steps": 2
    },
    {
      "type": "assert_script",
      "js": "(document.querySelector('#cell-scene #imported-specimen').getAttribute('data-model')==='whiteBlood' && document.querySelector('#cell-scene #imported-specimen').getAttribute('data-error')==='' && document.querySelector('#cell-scene').getAttribute('data-model-source').startsWith('https://'))&&document.getElementById('model-loading').style.display==='none'&&document.getElementById('scene-pair').getAttribute('aria-busy')==='false'"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 256,
      "height": 192,
      "different_from_pixel": [
        0,
        0
      ],
      "count": {
        "min": 300
      }
    },
    {
      "type": "capture_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 512,
      "height": 384,
      "file": "temp/cellscope-remote-whiteBlood.png"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/cellscope-remote-page.png"
    }
  ]
}
