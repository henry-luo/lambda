      "type": "assert_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 256,
      "height": 192,
      "reference": "focus",
      "count": {
        "min": 200
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#cut"
