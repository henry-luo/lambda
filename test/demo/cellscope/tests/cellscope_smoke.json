      "js": "(()=>{const c=document.querySelector('#cell-scene #camera');const p=c.getAttribute('position').trim().split(/[,\\s]+/).map(Number);return Number(c.getAttribute('fov'))<2&&Math.abs(Math.hypot(...p)-4)<0.00001&&c.getAttribute('fov')===document.querySelector('#peer-scene #camera').getAttribute('fov')})()"
