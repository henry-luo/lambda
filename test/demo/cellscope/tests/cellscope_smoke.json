{
  "name": "CellScope local model and procedural controls",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "events": [
    {
      "type": "advance_time",
      "ms": 60
    },
    {
      "type": "assert_script",
      "js": "Array.from(document.querySelectorAll('.specimen img')).every(el=>{const r=el.getBoundingClientRect();return r.width===48&&r.height===44})"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.specimen').length===6 && document.getElementById('choose-epithelial')===null"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('scene3d').length===2 && document.querySelectorAll('script').length===0"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#cell-scene #imported-specimen').getAttribute('data-model')==='plant' && document.querySelector('#cell-scene #imported-specimen').getAttribute('data-error')==='' && document.querySelector('#cell-scene texture').getAttribute('src').endsWith('/plant-basecolor.jpg')"
    },
    {
      "type": "click",
      "target": {
        "selector": "#choose-plant"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('cellscope').getAttribute('data-cell')==='plant'"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 256,
      "height": 192,
      "different_from_pixel": [
        0,
        0
      ],
      "count": {
        "min": 300
      }
    },
    {
      "type": "capture_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 512,
      "height": 384,
      "file": "temp/cellscope-plant.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#choose-muscle"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('cellscope').getAttribute('data-cell')==='muscle'"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 256,
      "height": 192,
