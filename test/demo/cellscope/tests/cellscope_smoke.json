{
  "name": "CellScope local specimen navigation and comparison",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "events": [
    {
      "type": "advance_time",
      "ms": 60
    },
    {
      "type": "assert_script",
      "js": "Array.from(document.querySelectorAll('.specimen img')).every(el=>{const r=el.getBoundingClientRect();return r.width===48&&r.height===44})"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.specimen').length===3&&['search','choose-epithelial','choose-neuron','choose-bacteria','choose-animal'].every(id=>document.getElementById(id)===null)&&Array.from(document.querySelectorAll('#peer option')).map(o=>o.value).join(',')==='plant,whiteBlood,muscle'"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('scene3d').length===2 && document.querySelectorAll('script').length===0"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#cell-scene #imported-specimen').getAttribute('data-model')==='plant' && document.querySelector('#cell-scene #imported-specimen').getAttribute('data-error')==='' && document.querySelector('#cell-scene texture').getAttribute('src').endsWith('/plant-basecolor.jpg')"
    },
    {
      "type": "click",
      "target": {
        "selector": "#choose-plant"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('cellscope').getAttribute('data-cell')==='plant'"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 256,
      "height": 192,
      "different_from_pixel": [
        0,
        0
      ],
      "count": {
        "min": 300
      }
    },
    {
      "type": "capture_surface",
      "source": "scene3d",
      "target": "#cell-scene",
      "width": 512,
      "height": 384,
      "file": "temp/cellscope-plant.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#part-plant-vacuole"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('cellscope').getAttribute('data-part')==='vacuole' && document.getElementById('detail-plant-vacuole').style.display==='block'"
    },
    {
      "type": "script",
      "js": "globalThis.loadedPlant=document.querySelector('#cell-scene #imported-specimen').firstElementChild"
    },
    {
      "type": "click",
      "target": {
        "selector": "#zoom-in"
      }
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#cell-scene #imported-specimen').firstElementChild===loadedPlant"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('model-error').style.display==='none' && document.querySelectorAll('#cell-scene texture').length===1"
    },
    {
      "type": "click",
      "target": {
        "selector": "#choose-plant"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#favorite"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#library"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('choose-whiteBlood').style.display==='none' && document.getElementById('choose-plant').style.display==='flex'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#gallery"
      }
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#peer"
      },
      "value": "plant"
    },
    {
      "type": "click",
      "target": {
        "selector": "#compare"
      }
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('cellscope').getAttribute('data-compare')==='true' && document.querySelector('#peer-scene #imported-specimen').getAttribute('data-model')==='plant'"
    },
