{
  "name": "MidtownMinimapZoomPanAndRecenter",
  "viewport": {"width": 1280, "height": 800},
  "events": [
    {"type": "wait", "ms": 400},
    {"type": "click", "target": {"selector": "#start"}},
    {"type": "key_press", "key": "m"},
    {"type": "wait", "ms": 150},
    {"type": "snapshot_surface", "source": "canvas", "target": "#map-plan", "name": "default-map"},
    {"type": "script", "js": "window.mapBox = selector => document.querySelector(selector).getBoundingClientRect(); window.mapMarker = () => { const marker = window.mapBox('.map-target-ring'); const car = window.mapBox('.map-car'); const x = marker.x - car.x; const y = marker.y - car.y; return x*x + y*y; }; window.mapAnchor = () => { const car = window.mapBox('.map-car'); const north = window.mapBox('.map-north span'); return [car.x, car.y, north.x, north.y].join(','); }; window.originalMarker = window.mapMarker(); window.originalAnchor = window.mapAnchor();"},
    {"type": "scroll", "x": 640, "y": 400, "dx": 0, "dy": -1},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 1, "dy": 0},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "default-map", "count": {"max": 0}},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": 1},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "default-map", "count": {"min": 1000}},
    {"type": "assert_script", "js": "window.mapAnchor() === window.originalAnchor && window.mapMarker() > window.originalMarker"},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "default-map", "count": {"max": 0}},
    {"type": "assert_script", "js": "Math.abs(window.mapMarker() - window.originalMarker) < 1"},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "default-map", "count": {"min": 1000}},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": 1},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "default-map", "count": {"max": 0}},
    {"type": "script", "js": "window.mapCarCentered = () => { const car = window.mapBox('#map-car'); const map = window.mapBox('#map-plan'); return Math.abs(car.x + car.width/2 - map.x - map.width/2) < 1 && Math.abs(car.y + car.height/2 - map.y - map.height/2) < 1; }; window.recenterVisible = () => getComputedStyle(document.getElementById('map-recenter')).display !== 'none'; window.initialCarX = window.mapBox('#map-car').x;"},
    {"type": "assert_script", "js": "window.mapCarCentered() && !window.recenterVisible()"},
    {"type": "mouse_down", "x": 1160, "y": 112},
    {"type": "mouse_move", "x": 1200, "y": 138},
    {"type": "mouse_up", "x": 1200, "y": 138},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "default-map", "count": {"min": 1000}},
    {"type": "assert_script", "js": "!window.mapCarCentered() && window.recenterVisible() && Math.abs(window.mapBox('#map-car').x - window.initialCarX - 40) < 1"},
    {"type": "click", "target": {"selector": "#map-recenter"}},
    {"type": "assert_script", "js": "window.mapCarCentered() && !window.recenterVisible()"},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "default-map", "count": {"max": 0}},
    {"type": "mouse_down", "x": 1160, "y": 112},
    {"type": "mouse_move", "x": 1130, "y": 255},
    {"type": "mouse_up", "x": 1130, "y": 255},
    {"type": "snapshot_surface", "source": "canvas", "target": "#map-plan", "name": "panned-map"},
    {"type": "script", "js": "window.parkedMarkerY = window.mapBox('#map-car').y;"},
    {"type": "mouse_move", "x": 640, "y": 400},
    {"type": "key_down", "key": "ArrowUp"},
    {"type": "wait", "ms": 1400},
    {"type": "key_up", "key": "ArrowUp"},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "panned-map", "count": {"max": 0}},
    {"type": "assert_script", "js": "window.recenterVisible() && Math.abs(window.mapBox('#map-car').y - window.parkedMarkerY) > 2"},
    {"type": "click", "target": {"selector": "#map-recenter"}},
    {"type": "assert_script", "js": "window.mapCarCentered() && !window.recenterVisible()"},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "pixels": [[24, 52, 60, 90, 51, 255], [176, 52, 60, 90, 51, 255], [24, 148, 46, 93, 120, 255], [176, 148, 46, 93, 120, 255], [100, 40, 0, 0, 0, 0]]},
    {"type": "assert_script", "js": "!window.mapCarCentered() && window.recenterVisible()"},
    {"type": "snapshot_surface", "source": "canvas", "target": "#map-plan", "name": "widest-map"},
    {"type": "scroll", "target": {"selector": "#map-plan"}, "dx": 0, "dy": -1},
    {"type": "assert_surface", "source": "canvas", "target": "#map-plan", "reference": "widest-map", "count": {"max": 0}},
    {"type": "click", "target": {"selector": "#map-recenter"}},
    {"type": "assert_script", "js": "window.mapCarCentered() && !window.recenterVisible()"}
  ]
}
