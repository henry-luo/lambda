{
  "name": "Chat: real local delivery, replies, read receipts, offline replay and search",
  "html": "test/demo/chat/chat.ls",
  "viewport": {"width": 1200, "height": 800},
  "events": [
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-online","equals":"true","assert_timeout":15000},
    {"type":"assert_count","target":{"selector":".contact"},"count":3},
    {"type":"capture_surface","source":"page","file":"temp/chat/shots/empty.png"},
    {"type":"type","target":{"selector":"#draft"},"text":"Hey Maya! Built entirely with Lambda 👋","clear":true},
    {"type":"click","target":{"selector":"#send"}},
    {"type":"assert_count","target":{"selector":".outgoing .bubble[data-status=\"delivered\"]"},"count":1,"assert_timeout":10000},
    {"type":"assert_text","target":{"selector":".message-text"},"equals":"Hey Maya! Built entirely with Lambda 👋"},
    {"type":"select_option","target":{"selector":"#profile"},"value":"maya"},
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-user","equals":"maya"},
    {"type":"assert_count","target":{"selector":".incoming .bubble[data-status=\"read\"]"},"count":1,"assert_timeout":10000},
    {"type":"type","target":{"selector":"#draft"},"text":"It works! Even the read receipts.","clear":true},
    {"type":"click","target":{"selector":"#send"}},
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-messages","equals":"2","assert_timeout":10000},
    {"type":"capture_surface","source":"page","file":"temp/chat/shots/conversation.png"},
    {"type":"click","target":{"selector":"#connection-toggle"}},
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-online","equals":"false","assert_timeout":5000},
    {"type":"select_option","target":{"selector":"#profile"},"value":"alex"},
    {"type":"type","target":{"selector":"#draft"},"text":"This one waits while you are offline.","clear":true},
    {"type":"click","target":{"selector":"#send"}},
    {"type":"assert_count","target":{"selector":".outgoing .bubble[data-status=\"sent\"]"},"count":1,"assert_timeout":10000},
    {"type":"select_option","target":{"selector":"#profile"},"value":"maya"},
    {"type":"click","target":{"selector":"#connection-toggle"}},
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-online","equals":"true","assert_timeout":10000},
    {"type":"assert_count","target":{"selector":".incoming .bubble[data-status=\"read\"]"},"count":2,"assert_timeout":10000},
    {"type":"type","target":{"selector":"#search"},"text":"Noah","clear":true},
    {"type":"assert_count","target":{"selector":".contact"},"count":1},
    {"type":"type","target":{"selector":"#search"},"text":"","clear":true},
    {"type":"click","target":{"selector":"#send"}},
    {"type":"assert_text","target":{"selector":"#notice"},"equals":"Write a message first."}
  ]
}
