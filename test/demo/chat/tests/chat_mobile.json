{
  "name": "Chat: narrow viewport, profile and conversation selection",
  "html": "test/demo/chat/chat.ls",
  "viewport": {"width": 390, "height": 844},
  "events": [
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-online","equals":"true","assert_timeout":15000},
    {"type":"assert_count","target":{"selector":"#draft"},"count":1},
    {"type":"type","target":{"selector":"#draft"},"text":"Hello from a small screen 👋","clear":true},
    {"type":"click","target":{"selector":"#send"}},
    {"type":"assert_count","target":{"selector":".outgoing .bubble[data-status=\"delivered\"]"},"count":1,"assert_timeout":10000},
    {"type":"select_option","target":{"selector":"#profile"},"value":"maya"},
    {"type":"assert_count","target":{"selector":".incoming .bubble[data-status=\"read\"]"},"count":1,"assert_timeout":10000},
    {"type":"capture_surface","source":"page","file":"temp/chat/shots/mobile.png"},
    {"type":"select_option","target":{"selector":"#peer-select"},"value":"noah"},
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-peer","equals":"noah"},
    {"type":"assert_attribute","target":{"selector":"#chat"},"attribute":"data-messages","equals":"0"}
  ]
}
