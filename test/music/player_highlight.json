{
  "name":"Whole notes and shared beams follow the selected highlight color",
  "html":"test/music/_player.ls",
  "viewport":{"width":1000,"height":800},
  "events":[
    {"type":"assert_attribute","target":{"selector":".music-highlight"},"attribute":"data-color","equals":"red"},
    {"type":"assert_count","target":{"selector":".music-swatch[aria-pressed=true]"},"count":1},
    {"type":"select_option","target":{"selector":"select[data-control=speed]"},"value":"0.5"},
    {"type":"click","target":{"selector":"button[data-action=play]"}},
    {"type":"wait","ms":200},
    {"type":"click","target":{"selector":"button[data-action=pause]"}},
    {"type":"assert_count","target":{"selector":"g[data-event-id][fill=red]"},"count":2},
    {"type":"assert_style","target":{"selector":"g[data-event-id][fill=red] line"},"property":"color","equals":"rgb(255, 0, 0)"},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=red] line"},"min_r":200,"max_g":180,"max_b":180,"search_radius":1},
    {"type":"click","target":{"selector":".music-swatch[data-color=blue] span"}},
    {"type":"assert_attribute","target":{"selector":".music-swatch[data-color=blue]"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_attribute","target":{"selector":".music-swatch[data-color=red]"},"attribute":"aria-pressed","equals":"false"},
    {"type":"assert_count","target":{"selector":"g[data-event-id][fill=blue]"},"count":2},
    {"type":"assert_style","target":{"selector":"g[data-event-id][fill=blue] line"},"property":"color","equals":"rgb(0, 0, 255)"},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=blue] line"},"min_b":200,"max_r":180,"max_g":180,"search_radius":1},
    {"type":"key_press","key":"Tab"},
    {"type":"assert_focus","target":{"selector":".music-swatch[data-color=yellow]"}},
    {"type":"key_press","key":"Space"},
    {"type":"assert_count","target":{"selector":"g[data-event-id][fill=yellow]"},"count":2},
    {"type":"assert_style","target":{"selector":"g[data-event-id][fill=yellow] line"},"property":"color","equals":"rgb(255, 255, 0)"},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=yellow] line"},"min_r":200,"min_g":200,"max_b":180,"search_radius":1},
    {"type":"click","target":{"selector":"button[data-action=play]"}},
    {"type":"wait","ms":1500},
    {"type":"click","target":{"selector":"button[data-action=pause]"}},
    {"type":"assert_count","target":{"selector":"g[data-beam-id][fill=yellow]"},"count":1},
    {"type":"assert_pixel","target":{"selector":"g[data-beam-id][fill=yellow] path"},"min_r":200,"min_g":200,"max_b":180,"search_radius":1},
    {"type":"click","target":{"selector":".music-swatch[data-color=red] span"}},
    {"type":"assert_count","target":{"selector":"g[data-beam-id][fill=red]"},"count":1},
    {"type":"assert_style","target":{"selector":"g[data-event-id][fill=red] line"},"property":"color","equals":"rgb(255, 0, 0)"},
    {"type":"click","target":{"selector":"button[data-action=stop]"}},
    {"type":"assert_count","target":{"selector":"g[data-highlight-id][fill]"},"count":0},
    {"type":"click","target":{"selector":".music-swatch[data-color=blue] span"}},
    {"type":"click","target":{"selector":"button[data-action=play]"}},
    {"type":"wait","ms":200},
    {"type":"click","target":{"selector":"button[data-action=pause]"}},
    {"type":"assert_count","target":{"selector":"g[data-event-id][fill=blue]"},"count":2},
    {"type":"click","target":{"selector":"button[data-action=stop]"}}
  ]
}
