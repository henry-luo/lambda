{
  "name": "RingworldAnimatesAndKeepsOrbitPanZoomIndependent",
  "viewport": {
    "width": 1120,
    "height": 900
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#ringworld"
      },
      "attribute": "data-ready",
      "equals": "true"
    },
    {
      "type": "collect_gc"
    },
    {
      "type": "assert_render_stats",
      "source": "document",
      "target": "#scene",
      "fields": {
        "shared_runtime": 0
      }
    },
    {
      "type": "snapshot_surface",
      "source": "scene3d",
      "target": "#ringworld",
      "width": 624,
      "height": 342,
      "name": "first"
    },
    {
      "type": "snapshot_render_stats",
      "source": "animation",
      "target": "#ringworld",
      "name": "action",
      "clip": "orbits"
    },
    {
      "type": "animation_tick",
      "seconds": 1
    },
    {
      "type": "assert_render_stats",
      "source": "animation",
      "target": "#ringworld",
      "fields": {
        "time": 1
      },
      "clip": "orbits"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#ringworld",
      "width": 624,
      "height": 342,
      "reference": "first",
      "count": {
        "min": 1001
      }
    },
    {
      "type": "script",
      "js": "globalThis.rPose=()=>({position:JSON.parse(document.getElementById('main').getAttribute('position')),target:JSON.parse(document.getElementById('main').getAttribute('target'))});\nglobalThis.rDist=(a,b)=>Math.hypot(a[0]-b[0],a[1]-b[1],a[2]-b[2]);\nglobalThis.rPolar=()=>{const p=rPose(),d=rDist(p.position,p.target);return Math.acos((p.position[1]-p.target[1])/d)};\nglobalThis.rTheta=()=>{const p=rPose();return Math.atan2(p.position[0]-p.target[0],p.position[2]-p.target[2])};\nglobalThis.rClick=id=>document.getElementById(id).click();rClick('play')"
    },
    {
      "type": "animation_tick",
      "seconds": 1
    },
    {
      "type": "assert_render_stats",
      "source": "animation",
      "target": "#ringworld",
      "fields": {
        "time": 1
      },
      "clip": "orbits"
    },
    {
      "type": "script",
      "js": "rClick('auto-play');globalThis.cameraBefore=rPose().position"
    },
    {
      "type": "mouse_down",
      "x": 500,
      "y": 400
    },
    {
      "type": "mouse_move",
      "x": 560,
      "y": 430
    },
    {
      "type": "mouse_up",
      "x": 560,
      "y": 430
    },
    {
      "type": "script",
      "js": "if(rDist(rPose().position,cameraBefore)<.1)throw new Error('native scene drag did not orbit')"
    },
    {
      "type": "script",
      "js": "if(document.getElementById('auto-play').getAttribute('aria-pressed')!=='false')throw new Error('drag did not stop auto play')"
    },
    {
      "type": "script",
      "js": "if(document.activeElement!==document.getElementById('ringworld'))throw new Error('scene did not receive keyboard focus')"
    },
    {
      "type": "script",
      "js": "rClick('auto-play');globalThis.keyTargetBefore=rPose().target;globalThis.tiltBefore=rPolar()"
    },
    {
      "type": "key_press",
      "key": "Right",
      "mods_str": ""
    },
    {
      "type": "key_press",
      "key": "Up",
      "mods_str": "shift"
    },
    {
      "type": "script",
      "js": "if(rDist(rPose().target,keyTargetBefore)<.001)throw new Error('arrow key did not pan');if(Math.abs(rPolar()-tiltBefore)<.001)throw new Error('shift-arrow did not tilt');if(document.getElementById('auto-play').getAttribute('aria-pressed')!=='false')throw new Error('camera key did not stop auto play')"
    },
    {
      "type": "script",
      "js": "rClick('pan-mode');globalThis.targetBefore=rPose().target"
    },
    {
      "type": "mouse_down",
      "x": 500,
      "y": 400
    },
    {
      "type": "mouse_move",
      "x": 560,
      "y": 430
    },
    {
      "type": "mouse_up",
      "x": 560,
      "y": 430
    },
    {
      "type": "script",
      "js": "if(rDist(rPose().target,targetBefore)<.1)throw new Error('pan mode did not move the target')"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#ringworld",
      "width": 624,
      "height": 342
    },
    {
      "type": "assert_render_stats",
      "source": "animation",
      "target": "#ringworld",
      "fields": {
        "animation_id": {
          "baseline": "action",
          "eq": 0
        },
        "time": 1
      },
      "clip": "orbits"
    },
    {
      "type": "script",
      "js": "rClick('auto-play');globalThis.zoomBefore=rDist(rPose().position,rPose().target)"
    },
    {
      "type": "scroll",
      "x": 500,
      "y": 400,
      "dy": 1
    },
    {
      "type": "script",
      "js": "if(Math.abs(rDist(rPose().position,rPose().target)-zoomBefore)<.01)throw new Error('wheel did not zoom');\nif(document.getElementById('auto-play').getAttribute('aria-pressed')!=='false')throw new Error('wheel did not stop auto play');\nrClick('tilt-up');rClick('orbit-right');rClick('zoom-in');rClick('zoom-out');rClick('top');\nif(rPolar()>.17)throw new Error('top preset');rClick('side');\nif(Math.abs(rPolar()-Math.PI/2)>1e-6)throw new Error('side preset');\nfor(let i=0;i<50;i++)rClick('zoom-in');if(Math.abs(rDist(rPose().position,rPose().target)-7)>1e-6)throw new Error('minimum zoom');\nfor(let i=0;i<50;i++)rClick('zoom-out');if(Math.abs(rDist(rPose().position,rPose().target)-38)>1e-6)throw new Error('maximum zoom');\nfor(let i=0;i<50;i++)rClick('tilt-up');if(rPolar()<.0799)throw new Error('tilt limit');\nrClick('reset');if(rDist(rPose().position,[7.5,4.8,11])>1e-6||rDist(rPose().target,[0,0,0])>1e-6)throw new Error('reset camera and pan');rClick('rewind');"
    },
    {
      "type": "assert_render_stats",
      "source": "animation",
      "target": "#ringworld",
      "fields": {
        "time": 0
      },
      "clip": "orbits"
    },
    {
      "type": "key_press",
      "key": "Space",
      "mods_str": ""
    },
    {
      "type": "animation_tick",
      "seconds": 0.25
    },
    {
      "type": "assert_render_stats",
      "source": "animation",
      "target": "#ringworld",
      "fields": {
        "time": 0.25
      },
      "clip": "orbits"
    }
  ]
}
