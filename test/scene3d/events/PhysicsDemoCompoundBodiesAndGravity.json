{
  "name": "PhysicsDemoCompoundBodiesAndGravity",
  "viewport": {
    "width": 1120,
    "height": 1000
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "(()=>{if(!globalThis.phWorld){const x=new XMLHttpRequest();x.open('GET','../../../scene3d/_physics_probe.js',false);x.send();(0,eval)(x.responseText)}return phWorld() && phWorld().getAttribute('data-ready')==='true';})()"
    },
    {
      "type": "script",
      "js": "phRequest({operation:\"reset\"})"
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0 && phState().bodies.length === 10"
    },
    {
      "type": "snapshot_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "name": "initial"
    },
    {
      "type": "script",
      "js": "phAction('pulse',false)"
    },
    {
      "type": "assert_script",
      "js": "Math.hypot(...phState().bodies[1].angular_velocity) > 0.4"
    },
    {
      "type": "script",
      "js": "phRequest({operation:'step',ticks:360})"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(phState().bodies[1].quaternion[3] - 1) > 0.0001"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "reference": "initial",
      "count": {
        "min": 100
      }
    },
    {
      "type": "script",
      "js": "globalThis.beforeGravity = phState().bodies[1].position[1]; phAction('gravity-on',false)"
    },
    {
      "type": "script",
      "js": "phRequest({operation:'step',ticks:120})"
    },
    {
      "type": "assert_script",
      "js": "phState().bodies[1].position[1] < globalThis.beforeGravity"
    },
    {
      "type": "click",
      "target": {
        "selector": "#gravity-off"
      }
    },
    {
      "type": "script",
      "js": "phRequest({operation:'step',ticks:2})"
    },
    {
      "type": "click",
      "target": {
        "selector": "#camera-top"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 482"
    },
    {
      "type": "script",
      "js": "phRequest({operation:\"reset\"})"
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0"
    }
  ]
}
