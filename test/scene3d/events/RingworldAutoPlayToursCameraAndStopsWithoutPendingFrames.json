{
  "name": "RingworldAutoPlayToursCameraAndStopsWithoutPendingFrames",
  "viewport": {
    "width": 1120,
    "height": 900
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#ringworld"
      },
      "attribute": "data-ready",
      "equals": "true"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#ringworld",
      "width": 624,
      "height": 342
    },
    {
      "type": "script",
      "js": "globalThis.rPose=()=>({position:JSON.parse(document.getElementById('main').getAttribute('position')),target:JSON.parse(document.getElementById('main').getAttribute('target'))});\nglobalThis.rDist=(a,b)=>Math.hypot(a[0]-b[0],a[1]-b[1],a[2]-b[2]);\nglobalThis.rPolar=()=>{const p=rPose(),d=rDist(p.position,p.target);return Math.acos((p.position[1]-p.target[1])/d)};\nglobalThis.rTheta=()=>{const p=rPose();return Math.atan2(p.position[0]-p.target[0],p.position[2]-p.target[2])};\nglobalThis.rClick=id=>document.getElementById(id).click();globalThis.autoButton=document.getElementById('auto-play');\nif(autoButton.getAttribute('aria-pressed')!=='false')throw new Error('auto play should start disabled');rClick('play');\nglobalThis.tourOrigin=rPose().position;globalThis.tourDistance=rDist(rPose().position,rPose().target);globalThis.tourTilt=rPolar();globalThis.tourAngle=rTheta();\nautoButton.click();if(autoButton.getAttribute('aria-pressed')!=='true'||autoButton.textContent!=='Stop Auto Play')throw new Error('auto play toggle did not start');"
    },
