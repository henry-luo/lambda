    {
      "type": "script",
      "js": "if(rDist(rPose().target,[0,0,0])<.5)throw new Error('auto play did not pan');\nif(Math.abs(rDist(rPose().position,rPose().target)-tourDistance)<1)throw new Error('auto play did not zoom');\nif(Math.abs(rPolar()-tourTilt)<.2)throw new Error('auto play did not tilt');\nif(Math.abs(rTheta()-tourAngle)<1)throw new Error('auto play did not orbit');\nif(document.getElementById('play').getAttribute('aria-pressed')!=='false')throw new Error('camera tour changed scene playback');"
