    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#ringworld",
      "width": 624,
      "height": 342
    },
    {
      "type": "script",
      "js": "\n        globalThis.autoButton=document.getElementById('auto-play');\n        if(autoButton.getAttribute('aria-pressed')!=='false')throw new Error('auto play should start disabled');\n        document.getElementById('play').click();\n        globalThis.tourOrigin=ringworld.camera.position.clone();\n        globalThis.tourDistance=ringworld.controls.getDistance();\n        globalThis.tourTilt=ringworld.controls.getPolarAngle();\n        globalThis.tourAngle=ringworld.controls.getAzimuthalAngle();\n        autoButton.click();\n        if(autoButton.getAttribute('aria-pressed')!=='true'||autoButton.textContent!=='Stop Auto Play')\n            throw new Error('auto play toggle did not start');\n    "
    },
