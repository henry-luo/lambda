{
  "name": "WebGl2ApiAndMultipleCanvasPixels",
  "viewport": {
    "width": 320,
    "height": 240
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-result",
      "equals": "passed"
