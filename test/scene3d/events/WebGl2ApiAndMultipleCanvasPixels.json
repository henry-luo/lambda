    {
      "type": "assert_script",
      "js": "Number(document.getElementById('result').getAttribute('data-checks'))>=30"
    },
    {
      "type": "assert_surface",
      "source": "page",
      "pixels": [
        [
          32,
          64,
          255,
          0,
          0
        ],
        [
          192,
          64,
          0,
          255,
          0
        ]
      ]
    }
  ]
}
