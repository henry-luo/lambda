{
  "name": "PhysicsDemoNavigationKeepsControlsAndPlaybackAlive",
  "viewport": {
    "width": 1120,
    "height": 1000
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/domino.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "globalThis.physicsDemo && physicsDemo.ready && physicsDemo.kind === 'domino'"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#launch"
      }
    },
    {
      "type": "advance_time",
      "ms": 1500,
      "steps": 150
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.playing && physicsDemo.state.tick >= 160 && physicsDemo.state.bodies[1].position[1] < 0.5"
    },
    {
      "type": "click",
      "target": {
        "selector": "#play-toggle"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.playing === false"
    },
    {
      "type": "script",
      "js": "physicsDemo.pausedTick = physicsDemo.state.tick"
    },
    {
      "type": "advance_time",
      "ms": 500,
      "steps": 50
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === physicsDemo.pausedTick"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 0 && document.getElementById('metric-primary').textContent === '0 / 32'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#step"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#camera-top"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 2 && physicsDemo.camera.position.y > 15"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===11 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/salvage.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "globalThis.physicsDemo && physicsDemo.ready && physicsDemo.kind === 'salvage'"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#pulse"
      }
    },
    {
      "type": "advance_time",
      "ms": 600,
      "steps": 60
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.playing && physicsDemo.state.tick >= 55 && Math.hypot(...physicsDemo.state.bodies[1].angular_velocity) > 0.4"
    },
    {
      "type": "click",
      "target": {
        "selector": "#gravity-on"
      }
    },
    {
      "type": "advance_time",
      "ms": 1000,
      "steps": 100
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.bodies[1].position[1] < 1.65"
    },
    {
      "type": "click",
      "target": {
        "selector": "#gravity-off"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 0"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===11 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/sorter.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "globalThis.physicsDemo && physicsDemo.ready && physicsDemo.kind === 'sorter'"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#run-sorter"
      }
    },
    {
      "type": "advance_time",
      "ms": 2000,
      "steps": 200
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.playing && physicsDemo.state.tick >= 220 && Math.abs(physicsDemo.state.bodies[1].quaternion[3] - 1) > 0.01"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 0 && physicsDemo.counted.size === 0"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===11 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/bounce.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "globalThis.physicsDemo && physicsDemo.ready && physicsDemo.kind === 'bounce'"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('.plot-card svg') !== null"
    },
    {
      "type": "click",
      "target": {
        "selector": "#drop"
      }
    },
    {
      "type": "advance_time",
      "ms": 1500,
      "steps": 150
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.playing && physicsDemo.state.tick >= 160 && physicsDemo.state.bodies[1].position[1] < 0.4 && physicsDemo.state.bodies[5].position[1] > 2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 0 && physicsDemo.state.bodies[1].position[1] === 3.8"
    },
    {
      "type": "click",
      "target": {
        "selector": "#step"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 2"
    }
  ]
}
