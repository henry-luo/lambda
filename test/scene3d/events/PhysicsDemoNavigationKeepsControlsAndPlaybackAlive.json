{
  "name": "PhysicsDemoNavigationKeepsControlsAndPlaybackAlive",
  "viewport": {
    "width": 1120,
    "height": 1000
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/domino.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "(()=>{if(!globalThis.phWorld){const x=new XMLHttpRequest();x.open('GET','../../../scene3d/_physics_probe.js',false);x.send();(0,eval)(x.responseText)}return phWorld() && phWorld().getAttribute('data-ready')==='true' && phWorld().getAttribute('data-demo') === 'domino';})()"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#launch"
      }
    },
    {
      "type": "advance_time",
      "ms": 1500,
      "steps": 150
    },
    {
      "type": "assert_script",
      "js": "(phWorld().getAttribute('data-playing')==='true') && phState().tick >= 160 && phState().bodies[1].position[1] < 0.5"
    },
    {
      "type": "click",
      "target": {
        "selector": "#play-toggle"
      }
    },
    {
      "type": "assert_script",
      "js": "(phWorld().getAttribute('data-playing')==='true') === false"
    },
    {
      "type": "script",
      "js": "globalThis.pausedTick = phState().tick"
    },
    {
      "type": "advance_time",
      "ms": 500,
      "steps": 50
    },
    {
      "type": "assert_script",
      "js": "phState().tick === globalThis.pausedTick"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0 && document.getElementById('metric-primary').textContent === '0 / 32'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#step"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#camera-top"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 2 && JSON.parse(document.getElementById('main').getAttribute('position'))[1] > 15"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===14 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/salvage.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "(()=>{if(!globalThis.phWorld){const x=new XMLHttpRequest();x.open('GET','../../../scene3d/_physics_probe.js',false);x.send();(0,eval)(x.responseText)}return phWorld() && phWorld().getAttribute('data-ready')==='true' && phWorld().getAttribute('data-demo') === 'salvage';})()"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#pulse"
      }
    },
    {
      "type": "advance_time",
      "ms": 600,
      "steps": 60
    },
    {
      "type": "assert_script",
      "js": "(phWorld().getAttribute('data-playing')==='true') && phState().tick >= 55 && Math.hypot(...phState().bodies[1].angular_velocity) > 0.4"
    },
    {
      "type": "click",
      "target": {
        "selector": "#gravity-on"
      }
    },
    {
      "type": "advance_time",
      "ms": 1000,
      "steps": 100
    },
    {
      "type": "assert_script",
      "js": "phState().bodies[1].position[1] < 1.65"
    },
    {
      "type": "click",
      "target": {
        "selector": "#gravity-off"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===14 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/sorter.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "(()=>{if(!globalThis.phWorld){const x=new XMLHttpRequest();x.open('GET','../../../scene3d/_physics_probe.js',false);x.send();(0,eval)(x.responseText)}return phWorld() && phWorld().getAttribute('data-ready')==='true' && phWorld().getAttribute('data-demo') === 'sorter';})()"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#run-sorter"
      }
    },
    {
      "type": "advance_time",
      "ms": 2000,
      "steps": 200
    },
    {
      "type": "assert_script",
      "js": "(phWorld().getAttribute('data-playing')==='true') && phState().tick >= 220 && Math.abs(phState().bodies[1].quaternion[3] - 1) > 0.01"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0 && phCount() === 0"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===14 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/bounce.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "(()=>{if(!globalThis.phWorld){const x=new XMLHttpRequest();x.open('GET','../../../scene3d/_physics_probe.js',false);x.send();(0,eval)(x.responseText)}return phWorld() && phWorld().getAttribute('data-ready')==='true' && phWorld().getAttribute('data-demo') === 'bounce';})()"
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs a').textContent==='Scene3D'"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('.plot-card svg') !== null"
    },
    {
      "type": "click",
      "target": {
        "selector": "#drop"
      }
    },
    {
      "type": "advance_time",
      "ms": 1500,
      "steps": 150
    },
    {
      "type": "assert_script",
      "js": "(phWorld().getAttribute('data-playing')==='true') && phState().tick >= 160 && phState().bodies[1].position[1] < 0.4 && phState().bodies[5].position[1] > 2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0 && phState().bodies[1].position[1] === 3.8"
    },
    {
      "type": "click",
      "target": {
        "selector": "#step"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 2"
    }
  ]
}
