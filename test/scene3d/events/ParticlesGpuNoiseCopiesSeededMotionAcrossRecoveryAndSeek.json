{
  "name": "ParticlesGpuNoiseCopiesSeededMotionAcrossRecoveryAndSeek",
  "viewport": {
    "width": 200,
    "height": 160
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "script",
      "js": "configureParticleNoise();particleRequest('capabilities')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.particles_noise===true"
    },
    {
      "type": "script",
      "js": "particleRequest('step',6)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[2]+.7337132643127442)<3e-6"
    },
    {
      "type": "script",
      "js": "particleResult.emitters[0].samples[0].position[2]=999;particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[2]+.7337132643127442)<3e-6"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].gpu_recoveries===1n&&Math.abs(particleResult.emitters[0].samples[0].position[2]+.7337132643127442)<3e-6"
    },
    {
      "type": "script",
      "js": "particleRequest('seek',.6)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].gpu_history_ticks===6n&&Math.abs(particleResult.emitters[0].samples[0].position[2]+.7337132643127442)<3e-6"
    }
  ]
}
