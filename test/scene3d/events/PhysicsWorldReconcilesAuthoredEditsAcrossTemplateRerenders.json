{
  "name": "PhysicsWorldReconcilesAuthoredEditsAcrossTemplateRerenders",
  "viewport": {
    "width": 260,
    "height": 200
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "typeof physicsRead === 'function'"
    },
    {
      "type": "script",
      "js": "physicsRead({operation:'step',ticks:60})"
    },
    {
      "type": "assert_script",
      "js": "physicsState !== null && physicsState.tick === 60 && boxHeight() < 3.9"
    },
    {
      "type": "script",
      "js": "globalThis.fallen = boxHeight()"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#world",
      "width": 160,
      "height": 120
    },
    {
      "type": "snapshot_surface",
      "name": "fallen",
      "source": "scene3d",
      "target": "#world",
      "width": 160,
      "height": 120
    },
    {
      "type": "click",
      "target": {
        "selector": "#redraw"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#lab"
      },
      "attribute": "data-redraws",
      "equals": "1"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#world",
      "width": 160,
      "height": 120
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 160,
      "height": 120,
      "region": [
        0,
        0,
        160,
        120
      ],
      "reference": "fallen",
      "count": {
        "max": 0
      }
    },
    {
      "type": "script",
      "js": "physicsRead({operation:'read'})"
    },
    {
      "type": "assert_script",
      "js": "physicsState !== null && physicsState.tick === 60 && boxHeight() === fallen"
    },
    {
      "type": "click",
      "target": {
        "selector": "#heavier"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#lab"
      },
      "attribute": "data-gravity",
      "equals": "-19.62"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#world",
      "width": 160,
      "height": 120
    },
    {
      "type": "script",
      "js": "physicsRead({operation:'read'})"
    },
    {
      "type": "assert_script",
      "js": "physicsState !== null && physicsState.tick === 60 && boxHeight() === fallen"
    },
    {
      "type": "script",
      "js": "globalThis.speed = boxBody().velocity[1]; physicsRead({operation:'step',ticks:1})"
    },
    {
      "type": "assert_script",
      "js": "physicsState !== null && physicsState.tick === 61 && Math.abs(boxBody().velocity[1] - speed + 19.62 / 120) < 1e-9"
    },
    {
      "type": "click",
      "target": {
        "selector": "#lift"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#lab"
      },
      "attribute": "data-lift",
      "equals": "6"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#world",
      "width": 160,
      "height": 120
    },
    {
      "type": "script",
      "js": "physicsRead({operation:'read'})"
    },
    {
      "type": "assert_script",
      "js": "physicsState !== null && physicsState.tick === 61 && boxHeight() === 6 && boxBody().velocity[1] < -4"
    },
    {
      "type": "click",
      "target": {
        "selector": "#dense"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#lab"
      },
      "attribute": "data-density",
      "equals": "3"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#world",
      "width": 160,
      "height": 120
    },
    {
      "type": "script",
      "js": "physicsRead({operation:'read'})"
    },
    {
      "type": "assert_script",
      "js": "physicsState !== null && physicsState.tick === 61 && boxHeight() === 6 && boxBody().mass === 3"
    },
    {
      "type": "click",
      "target": {
        "selector": "#second"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#lab"
      },
      "attribute": "data-second",
      "equals": "true"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#world",
      "width": 160,
      "height": 120
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 160,
      "height": 120,
      "region": [
        0,
        0,
        160,
        120
      ],
      "reference": "fallen",
      "count": {
        "min": 50
      }
    },
    {
      "type": "script",
      "js": "physicsRead({operation:'read'})"
    },
    {
      "type": "assert_script",
      "js": "physicsState !== null && physicsState.tick === 0 && physicsState.bodies.length === 3 && boxHeight() === 6 && boxBody().velocity[1] === 0"
    }
  ]
}
