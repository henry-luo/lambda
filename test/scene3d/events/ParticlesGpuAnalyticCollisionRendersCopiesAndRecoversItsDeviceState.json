{
  "name": "ParticlesGpuAnalyticCollisionRendersCopiesAndRecoversItsDeviceState",
  "viewport": {
    "width": 200,
    "height": 160
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "script",
      "js": "configureParticleAnalytic();particleRequest('capabilities')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.particles_gpu_analytic_collision===true&&particleResult.particles_gpu_collision_replay===true"
    },
    {
      "type": "script",
      "js": "particleRequest('step',2)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          255,
          0,
          0,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[1]-.101)<2e-5&&particleResult.emitters[0].samples[0].velocity[1]===20&&particleResult.emitters[0].samples[0].collision_status==='running'"
    },
    {
      "type": "script",
      "js": "particleResult.emitters[0].samples[0].position[1]=999;particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[1]-.101)<2e-5"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          255,
          0,
          0,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].gpu_recoveries===1n&&Math.abs(particleResult.emitters[0].samples[0].position[1]-.101)<2e-5"
    },
    {
      "type": "script",
      "js": "particleRequest('seek',.2)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].gpu_history_ticks===2n&&Math.abs(particleResult.emitters[0].samples[0].position[1]-.101)<2e-5"
    },
    {
      "type": "script",
      "js": "document.querySelector('particle-plane').setAttribute('offset','.1');particleRequest('reset')"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].samples[0].collision_status==='initial-overlap'&&particleResult.emitters[0].samples[0].velocity[1]===0"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          255,
          0,
          0,
          255
        ]
      ]
    }
  ]
}
