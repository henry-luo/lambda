{
  "name": "ParticlesGpuSpawnCommandsCopyFutureBirthsAndResetTheirTransientState",
  "viewport": {
    "width": 200,
    "height": 160
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "script",
      "js": "configureParticleSpawns('gpu');document.getElementById('main').setAttribute('type','orthographic');document.getElementById('main').setAttribute('view_height','4');queueParticleSpawns([{op:'spawn',emitter:'sparks',count:2,depth:1,position:[-1,0,0]}],2)"
    },
    {
      "type": "assert_script",
      "js": "particleResult.pending_commands===1n&&particleResult.tick===0"
    },
    {
      "type": "script",
      "js": "particleBatch.commands[0].position[0]=100;particleBatch.commands[0].count=100;particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          32,
          64,
          0,
          0,
          0,
          0
        ],
        [
          64,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          32,
          64,
          255,
          0,
          0,
          255
        ],
        [
          64,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].live===2n&&particleResult.emitters[0].samples[0].depth===1n&&Math.abs(particleResult.emitters[0].samples[0].position[0]+1)<1e-6"
    },
    {
      "type": "script",
      "js": "queueParticleSpawns([{op:'spawn',emitter:'sparks',count:1,depth:2,position:[1,0,0],velocity:[-1,0,0]}])"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].live===3n&&particleResult.emitters[0].samples[2].sequence===2n&&particleResult.emitters[0].samples[2].depth===2n&&Math.abs(particleResult.emitters[0].samples[2].velocity[0])<1e-6"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          35,
          64,
          255,
          0,
          0,
          255
        ],
        [
          96,
          64,
          255,
          0,
          0,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('seek',.3)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          35,
          64,
          0,
          0,
          0,
          0
        ],
        [
          96,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].live===0n&&particleResult.pending_spawn_count===0n"
    },
    {
      "type": "script",
      "js": "particleRequest('capabilities')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.particles_spawn_commands===true&&particleResult.particles_child_queues===true"
    }
  ]
}
