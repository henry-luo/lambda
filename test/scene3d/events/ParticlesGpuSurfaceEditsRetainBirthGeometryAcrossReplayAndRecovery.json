{
  "name": "ParticlesGpuSurfaceEditsRetainBirthGeometryAcrossReplayAndRecovery",
  "viewport": {
    "width": 200,
    "height": 160
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "script",
      "js": "configureParticleSurface('gpu');particleRequest('capabilities')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.particles_mesh_surface===true"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].surface_versions===1n&&particleResult.emitters[0].surface_triangles===2n&&particleResult.emitters[0].surface_bytes>0n&&particleResult.emitters[0].samples[0].velocity[2]===1"
    },
    {
      "type": "script",
      "js": "globalThis.savedSurfacePacket=particleResult;globalThis.firstSurfaceX=particleResult.emitters[0].samples[0].position[0];moveParticleSurface();particleRequest('step',1)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "savedSurfacePacket.emitters[0].surface_versions===1n&&particleResult.emitters[0].surface_versions===2n&&particleResult.emitters[0].live===2n&&Math.abs(particleResult.emitters[0].samples[0].position[0]-firstSurfaceX)<1e-6&&Math.abs(particleResult.emitters[0].samples[0].position[2]-.1)<1e-6&&particleResult.emitters[0].samples[1].position[0]>9.89"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 160,
      "height": 120,
      "pixels": [
        [
          80,
          60,
          255,
          0,
          0
        ],
        [
          120,
          60,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 160,
      "height": 120,
      "pixels": [
        [
          80,
          60,
          255,
          0,
          0
        ],
        [
          120,
          60,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].surface_versions===2n&&Math.abs(particleResult.emitters[0].samples[0].position[0]-firstSurfaceX)<1e-6"
    },
    {
      "type": "script",
      "js": "particleRequest('seek',.2)"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].surface_versions===1n&&particleResult.emitters[0].live===3n&&particleResult.emitters[0].samples[0].position[0]>9.89"
    },
    {
      "type": "script",
      "js": "particleRequest('reset')"
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].live===0n&&particleResult.emitters[0].surface_versions===1n"
    }
  ]
}
