{
  "name": "GLB viewer displays and inspects an animated model",
  "viewport": {"width": 1140, "height": 940},
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {"type":"assert_text","target":{"selector":".model-header h1"},"equals":"viewer.glb"},
    {"type":"assert_script","js":"document.querySelector('#model-tone').value === 'neutral'"},
    {"type":"assert_surface","source":"scene3d","target":"#model-scene","different_from_pixel":[0,0],"count":{"min":3000}},
    {"type":"select_option","target":{"selector":"#model-background"},"value":"#ffffff"},
    {"type":"assert_surface","source":"scene3d","target":"#model-scene","pixels":[[0,0,255,255,255]]},
    {"type":"select_option","target":{"selector":"#model-tone"},"value":"aces"},
    {"type":"assert_attribute","target":{"selector":"#model-scene"},"attribute":"tone-mapping","equals":"aces"},
    {"type":"select_option","target":{"selector":"#model-environment"},"value":"model-daylight"},
    {"type":"assert_attribute","target":{"selector":"#model-scene"},"attribute":"environment","equals":"model-daylight"},
    {"type":"select_option","target":{"selector":"#model-environment"},"value":"off"},
    {"type":"assert_script","js":"!document.querySelector('#model-scene').hasAttribute('environment')"},
    {"type":"click","target":{"selector":"#model-punctual"}},
    {"type":"assert_attribute","target":{"selector":"#model light"},"attribute":"visible","equals":"false"},
    {"type":"script","js":"document.querySelector('#model-point-size').focus()"},
    {"type":"key_press","key":"ArrowRight"},
    {"type":"assert_attribute","target":{"selector":"#model points"},"attribute":"size","equals":"2"},
    {"type":"click","target":{"selector":"#model-show-grid"}},
    {"type":"assert_attribute","target":{"selector":"#model-grid"},"attribute":"visible","equals":"true"},
    {"type":"snapshot_surface","source":"scene3d","target":"#model-scene","name":"filled"},
    {"type":"snapshot_render_stats","source":"scene3d","target":"#model-scene","name":"geometry"},
    {"type":"click","target":{"selector":"#model-wireframe"}},
    {"type":"assert_surface","source":"scene3d","target":"#model-scene","reference":"filled","count":{"min":3000}},
    {"type":"click","target":{"selector":"#model-wireframe"}},
    {"type":"click","target":{"selector":"#model-skeleton"}},
    {"type":"assert_surface","source":"scene3d","target":"#model-scene","reference":"filled","count":{"min":10}},
    {"type":"assert_render_stats","source":"scene3d","target":"#model-scene","fields":{"projection_generation":{"baseline":"geometry","eq":0}}},
    {"type":"click","target":{"selector":"#pan-mode"}},
    {"type":"assert_attribute","target":{"selector":"#pan-mode"},"attribute":"aria-pressed","equals":"true"},
    {"type":"click","target":{"selector":"#model-screen-pan"}},
    {"type":"assert_attribute","target":{"selector":"#model-screen-pan"},"attribute":"aria-pressed","equals":"false"},
    {"type":"script","js":"globalThis.beforePan = JSON.parse(document.querySelector('#model-camera').getAttribute('target'))"},
    {"type":"mouse_drag","target":{"selector":"#model-scene"},"dx":0,"dy":54},
    {"type":"assert_script","js":"(() => { const target = JSON.parse(document.querySelector('#model-camera').getAttribute('target')); return target[1] === beforePan[1] && Math.abs(target[2] - beforePan[2]) > 0.01; })()"},
    {"type":"click","target":{"selector":"[data-camera=reset]"}},
    {"type":"assert_attribute","target":{"selector":"#orbit-mode"},"attribute":"aria-pressed","equals":"true"},
    {"type":"snapshot_surface","source":"scene3d","target":"#model-scene","name":"home"},
    {"type":"click","target":{"selector":"#model-turn"}},
    {"type":"advance_time","ms":150,"steps":5},
    {"type":"assert_surface","source":"scene3d","target":"#model-scene","reference":"home","count":{"min":100}},
    {"type":"click","target":{"selector":"#model-turn"}},
    {"type":"assert_checked","target":{"selector":"[data-model-clip=model-asset-clip-0]"},"checked":true},
    {"type":"assert_checked","target":{"selector":"[data-model-clip=model-asset-clip-1]"},"checked":false},
    {"type":"click","target":{"selector":"#model-play"}},
    {"type":"assert_text","target":{"selector":"#model-play"},"equals":"Pause"},
    {"type":"animation_tick","seconds":0.5},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-0","fields":{"time":{"min":0.45}}},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-1","fields":{"time":0}},
    {"type":"click","target":{"selector":".model-clip:nth-child(2) span"}},
    {"type":"assert_checked","target":{"selector":"[data-model-clip=model-asset-clip-1]"},"checked":true},
    {"type":"animation_tick","seconds":0.25},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-0","fields":{"time":{"min":0.7}}},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-1","fields":{"time":{"min":0.2,"max":0.28}}},
    {"type":"click","target":{"selector":"[data-model-clip=model-asset-clip-0]"}},
    {"type":"assert_checked","target":{"selector":"[data-model-clip=model-asset-clip-0]"},"checked":false},
    {"type":"animation_tick","seconds":0.15},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-0","fields":{"time":0}},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-1","fields":{"time":{"min":0.34}}},
    {"type":"click","target":{"selector":"#model-play"}},
    {"type":"assert_text","target":{"selector":"#model-play"},"equals":"Play"},
    {"type":"script","js":"document.querySelector('#model-speed').focus()"},
    {"type":"key_press","key":"ArrowRight"},
    {"type":"assert_text","target":{"selector":"#model-speed-value"},"equals":"1.25"},
    {"type":"click","target":{"selector":"#model-play-all"}},
    {"type":"assert_checked","target":{"selector":"[data-model-clip=model-asset-clip-0]"},"checked":true},
    {"type":"assert_checked","target":{"selector":"[data-model-clip=model-asset-clip-1]"},"checked":true},
    {"type":"assert_text","target":{"selector":"#model-play"},"equals":"Pause"},
    {"type":"animation_tick","seconds":0.4},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-0","fields":{"time":{"min":0.45,"max":0.52}}},
    {"type":"assert_render_stats","source":"animation","target":"#model-scene","clip":"model-asset-clip-1","fields":{"time":{"min":0.45,"max":0.52}}},
    {"type":"click","target":{"selector":"#model-play"}},
    {"type":"click","target":{"selector":"[data-model-clip=model-asset-clip-0]"}},
    {"type":"click","target":{"selector":"[data-model-clip=model-asset-clip-1]"}},
    {"type":"click","target":{"selector":"#model-play"}},
    {"type":"assert_text","target":{"selector":"#model-animation-status"},"equals":"Select an animation to play."},
    {"type":"resize","width":540,"height":780},
    {"type":"assert_render_stats","source":"view","target":"#model-scene","fields":{"width":{"min":500,"max":540}}},
    {"type":"assert_render_stats","source":"view","target":"#model-inspector","fields":{"width":{"min":500,"max":540}}}
  ]
}
