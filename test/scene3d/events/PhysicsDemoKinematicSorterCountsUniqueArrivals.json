{
  "name": "PhysicsDemoKinematicSorterCountsUniqueArrivals",
  "viewport": {
    "width": 1120,
    "height": 1000
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "globalThis.physicsDemo && physicsDemo.ready"
    },
    {
      "type": "script",
      "js": "physicsDemo.restart()"
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 0"
    },
    {
      "type": "snapshot_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "name": "initial"
    },
    {
      "type": "script",
      "js": "physicsDemo.request({operation:'step',ticks:1200})"
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.counted.size >= 12 && physicsDemo.counted.size <= 18"
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.bins[0].size + physicsDemo.bins[1].size + physicsDemo.bins[2].size === physicsDemo.counted.size"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "reference": "initial",
      "count": {
        "min": 100
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#camera-top"
      }
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 1200"
    },
    {
      "type": "collect_gc",
      "count": 2
    },
    {
      "type": "script",
      "js": "physicsDemo.previousCount = physicsDemo.counted.size; physicsDemo.request({operation:'step',ticks:240})"
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.counted.size >= physicsDemo.previousCount && physicsDemo.counted.size <= 18"
    },
    {
      "type": "script",
      "js": "physicsDemo.restart()"
    },
    {
      "type": "assert_script",
      "js": "physicsDemo.state.tick === 0 && physicsDemo.counted.size === 0 && physicsDemo.bins.every(bin => bin.size === 0)"
    }
  ]
}
