{
  "name": "PhysicsDemoKinematicSorterCountsUniqueArrivals",
  "viewport": {
    "width": 1120,
    "height": 1000
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "(()=>{if(!globalThis.phWorld){const x=new XMLHttpRequest();x.open('GET','../../../scene3d/_physics_probe.js',false);x.send();(0,eval)(x.responseText)}return phWorld() && phWorld().getAttribute('data-ready')==='true';})()"
    },
    {
      "type": "script",
      "js": "phRequest({operation:\"reset\"})"
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0"
    },
    {
      "type": "snapshot_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "name": "initial"
    },
    {
      "type": "script",
      "js": "phRequest({operation:'step',ticks:1200})"
    },
    {
      "type": "assert_script",
      "js": "phCount() >= 12 && phCount() <= 18"
    },
    {
      "type": "assert_script",
      "js": "phBins()[0].length + phBins()[1].length + phBins()[2].length === phCount()"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "reference": "initial",
      "count": {
        "min": 100
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#camera-top"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 1200"
    },
    {
      "type": "collect_gc",
      "count": 2
    },
    {
      "type": "script",
      "js": "globalThis.previousCount = phCount(); phRequest({operation:'step',ticks:240})"
    },
    {
      "type": "assert_script",
      "js": "phCount() >= globalThis.previousCount && phCount() <= 18"
    },
    {
      "type": "script",
      "js": "phRequest({operation:\"reset\"})"
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0 && phCount() === 0 && phBins().every(bin => bin.length === 0)"
    }
  ]
}
