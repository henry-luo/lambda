{
  "name": "ParticlesTextureSheetsVisitCpuAndGpuAtlasFramesAcrossReplayAndRecovery",
  "viewport": {
    "width": 200,
    "height": 160
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "script",
      "js": "configureParticleSheet('cpu');particleRequest('capabilities')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.particles_texture_sheet===true"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          255,
          0,
          0,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          0,
          255,
          0,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].samples[0].frame===1&&particleResult.emitters[0].sheet_grid[0]===2"
    },
    {
      "type": "script",
      "js": "particleResult.emitters[0].samples[0].frame=999;particleResult.emitters[0].sheet_grid[0]=99;particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].samples[0].frame===1&&particleResult.emitters[0].sheet_grid[0]===2"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          0,
          255,
          0,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "document.getElementById('sparks').setAttribute('backend','gpu');particleRequest('seek',.3)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          0,
          0,
          255,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].samples[0].frame===2"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          0,
          0,
          255,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "const sheet=document.querySelector('particle-sheet');sheet.setAttribute('first','3');sheet.setAttribute('count','1');particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].samples[0].frame===2"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          255,
          255,
          255,
          255
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].samples[0].frame===3&&particleResult.emitters[0].gpu_recoveries===1n"
    }
  ]
}
