{
  "name": "Scene3dCollectionNavigatesEveryTileAndBreadcrumb",
  "viewport": {
    "width": 1200,
    "height": 1600
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===9 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "assert_script",
      "js": "Array.from(document.querySelectorAll('.demo-tile')).every(a=>{const r=a.getBoundingClientRect();return r.width>250&&r.left>=0&&r.right<=1200})"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/scene3d-index-desktop.png"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"cellscope/cellscope.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs [aria-current=page]').textContent===\"CellScope\""
    },
    {
      "type": "advance_time",
      "ms": 60
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('#cell-scene #imported-specimen').getAttribute('data-model')==='plant' && document.querySelector('#cell-scene #imported-specimen').getAttribute('data-error')==='' && document.querySelectorAll('#cell-scene geometry').length>0"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.demo-tile').length===9 && document.querySelector('h1').textContent==='Scene3D' && !document.querySelector('.scene3d-breadcrumbs')"
    },
    {
      "type": "click",
      "target": {
        "selector": ".demo-tile[href=\"physics/domino.ls\"]"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.querySelectorAll('.scene3d-breadcrumbs a').length===1 && document.querySelector('.scene3d-breadcrumbs [aria-current=page]').textContent===\"Domino circuit\""
    },
    {
      "type": "assert_script",
      "js": "globalThis.physicsDemo && physicsDemo.ready && physicsDemo.kind==='domino'"
    },
    {
      "type": "click",
      "target": {
        "selector": ".scene3d-breadcrumbs a"
      },
      "scroll_into_view": true
    },
