          2
        ],
        [
          80,
          52,
          255,
          255,
          255,
          255,
          2
        ],
        [
          112,
          52,
          255,
          255,
          255,
          255,
          2
        ],
        [
          16,
          20,
          0,
          0,
          0,
          255,
          2
        ],
        [
          48,
          20,
          0,
          0,
          0,
          255,
          2
        ],
        [
          80,
          20,
          0,
          0,
          0,
          255,
          2
        ],
        [
          112,
          20,
          0,
          0,
          0,
          255,
          2
        ]
      ]
