    {
      "type": "log",
      "message": "simulation diagnostics"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#untimed",
      "width": 32,
      "height": 32,
      "success": false,
      "diagnostic": "simulation requires a numeric time uniform"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#uncompiled",
      "width": 32,
      "height": 32,
      "success": false,
      "diagnostic": "simulation bad:"
    },
    {
      "type": "scene3d",
      "op": "snapshot",
      "target": "#unnamed",
      "width": 32,
      "height": 32,
      "success": false,
      "diagnostic": "shader uniform names no simulation variable"
    }
  ]
}
