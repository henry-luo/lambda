      "type": "assert_render_stats",
      "source": "scene3d",
      "target": "#drift",
      "fields": {
        "simulation_steps": {
          "baseline": "lifted",
          "eq": 2
        }
      }
    },
    {
      "type": "log",
      "message": "rewinding to 0.5 restarts from the initial records"
