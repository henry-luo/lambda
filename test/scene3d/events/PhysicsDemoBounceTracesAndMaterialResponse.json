{
  "name": "PhysicsDemoBounceTracesAndMaterialResponse",
  "viewport": {
    "width": 1120,
    "height": 1000
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "(()=>{if(!globalThis.phWorld){const x=new XMLHttpRequest();x.open('GET','../../../scene3d/_physics_probe.js',false);x.send();(0,eval)(x.responseText)}return phWorld() && phWorld().getAttribute('data-ready')==='true';})()"
    },
    {
      "type": "script",
      "js": "phRequest({operation:\"reset\"})"
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector('.plot-card svg') !== null"
    },
    {
      "type": "snapshot_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "name": "initial"
    },
    {
      "type": "script",
      "js": "phRequest({operation:'step',ticks:150})"
    },
    {
      "type": "assert_script",
      "js": "phState().bodies[1].position[1] < 0.4 && phState().bodies[5].position[1] > 2.5"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 1040,
      "height": 500,
      "reference": "initial",
      "count": {
        "min": 100
      }
    },
    {
      "type": "script",
      "js": "globalThis.lastQuery=phRequest({operation:'query',queries:[{type:'ray',origin:[3.4,5,0],direction:[0,-1,0],distance:8}]})"
    },
    {
      "type": "assert_script",
      "js": "lastQuery[0].body === 'ball-4'"
    },
    {
      "type": "collect_gc",
      "count": 2
    },
    {
      "type": "click",
      "target": {
        "selector": "#camera-top"
      }
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 150"
    },
    {
      "type": "script",
      "js": "phRequest({operation:\"reset\"})"
    },
    {
      "type": "assert_script",
      "js": "phState().tick === 0 && phState().bodies[1].position[1] === 3.8"
    }
  ]
}
