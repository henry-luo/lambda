{
  "name": "ParticlesBillboardsFaceCamerasAndKeepCopiedStateAcrossReplayAndRecovery",
  "viewport": {
    "width": 200,
    "height": 160
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "script",
      "js": "configureParticleBillboard('cpu');particleRequest('capabilities')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.particles_billboards===true"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          84,
          64,
          255,
          0,
          0,
          255
        ],
        [
          64,
          88,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].presentation==='billboard'&&particleResult.emitters[0].samples[0].age===0"
    },
    {
      "type": "script",
      "js": "document.getElementById('main').setAttribute('position','4 0 0');particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].presentation==='billboard'&&particleResult.emitters[0].samples[0].age===0"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          84,
          64,
          255,
          0,
          0,
          255
        ],
        [
          64,
          88,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "document.getElementById('sparks').setAttribute('presentation','mesh');particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].presentation==='mesh'&&particleResult.emitters[0].samples[0].age===0"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "const e=document.getElementById('sparks');e.setAttribute('backend','gpu');e.setAttribute('presentation','billboard');particleRequest('seek',.2)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          84,
          64,
          255,
          0,
          0,
          255
        ],
        [
          64,
          88,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].presentation==='billboard'&&Math.abs(particleResult.emitters[0].samples[0].age-.1)<1e-8&&particleResult.emitters[0].samples[0].position[0]===0"
    },
    {
      "type": "script",
      "js": "const turn=document.createElement('particle-rotation-curve');turn.setAttribute('times','0 1');turn.setAttribute('values','0 0 1.5707963267948966 0 0 1.5707963267948966');document.getElementById('sparks').appendChild(turn);particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].samples[0].rotation[2]===0"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          88,
          255,
          0,
          0,
          255
        ],
        [
          84,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          64,
          88,
          255,
          0,
          0,
          255
        ],
        [
          84,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].presentation==='billboard'&&Math.abs(particleResult.emitters[0].samples[0].age-.2)<1e-8&&Math.abs(particleResult.emitters[0].samples[0].rotation[2]-Math.PI/2)<1e-5&&particleResult.emitters[0].gpu_recoveries===1n"
    },
    {
      "type": "script",
      "js": "particleResult.emitters[0].presentation='mesh';particleResult.emitters[0].samples[0].rotation[2]=999;particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.emitters[0].presentation==='billboard'&&Math.abs(particleResult.emitters[0].samples[0].rotation[2]-Math.PI/2)<1e-5"
    }
  ]
}
