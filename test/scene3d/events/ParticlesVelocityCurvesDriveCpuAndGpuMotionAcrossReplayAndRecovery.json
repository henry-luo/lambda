{
  "name": "ParticlesVelocityCurvesDriveCpuAndGpuMotionAcrossReplayAndRecovery",
  "viewport": {
    "width": 200,
    "height": 160
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "script",
      "js": "configureParticleVelocity('cpu');particleRequest('capabilities')"
    },
    {
      "type": "assert_script",
      "js": "particleResult.particles_velocity_curves===true"
    },
    {
      "type": "script",
      "js": "particleRequest('step',3)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          68,
          64,
          255,
          0,
          0,
          255
        ],
        [
          60,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[0]-.24)<1e-5&&Math.abs(particleResult.emitters[0].samples[0].velocity[0]-1.8)<1e-5"
    },
    {
      "type": "script",
      "js": "particleResult.emitters[0].samples[0].velocity[0]=999;particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].velocity[0]-1.8)<1e-5"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          68,
          64,
          255,
          0,
          0,
          255
        ],
        [
          60,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "document.getElementById('sparks').setAttribute('backend','gpu');particleRequest('seek',.6)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          78,
          64,
          255,
          0,
          0,
          255
        ],
        [
          60,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[0]-.9)<1e-5&&Math.abs(particleResult.emitters[0].samples[0].velocity[0]-3)<1e-5&&particleResult.emitters[0].gpu_history_ticks===6n"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          78,
          64,
          255,
          0,
          0,
          255
        ],
        [
          60,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "document.querySelector('particle-velocity-curve').setAttribute('values','3 0 0 3 0 0 3 0 0');particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].velocity[0]-3)<1e-5"
    },
    {
      "type": "script",
      "js": "particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          85,
          64,
          255,
          0,
          0,
          255
        ],
        [
          60,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[0]-1.3)<1e-5&&Math.abs(particleResult.emitters[0].samples[0].velocity[0]-4)<1e-5"
    },
    {
      "type": "script",
      "js": "document.querySelector('particle-velocity-curve').remove();particleRequest('step',1)"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          86,
          64,
          255,
          0,
          0,
          255
        ],
        [
          60,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "type": "script",
      "js": "particleRequest('read')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(particleResult.emitters[0].samples[0].position[0]-1.4)<1e-5&&Math.abs(particleResult.emitters[0].samples[0].velocity[0]-1)<1e-5&&particleResult.emitters[0].gpu_history_ticks===0n"
    },
    {
      "type": "scene3d",
      "op": "lose_context",
      "target": "#world"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#world",
      "width": 128,
      "height": 128,
      "pixels": [
        [
          86,
          64,
          255,
          0,
          0,
          255
        ],
        [
          60,
          64,
          0,
          0,
          0,
          0
        ]
      ]
    }
  ]
}
