{
  "name": "CrystalGardenPanTiltZoomRendersAndResetsCamera",
  "viewport": {
    "width": 1120,
    "height": 950
  },
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {
      "type": "assert_script",
      "js": "document.querySelector('#garden[data-ready=true]')!==null && document.title==='Crystal garden / Scene3D'"
    },
    {
      "type": "script",
      "js": "globalThis.gPose=()=>({position:JSON.parse(document.getElementById('garden-camera').getAttribute('position')),target:JSON.parse(document.getElementById('garden-camera').getAttribute('target'))});\nglobalThis.gDist=(a,b)=>Math.hypot(a[0]-b[0],a[1]-b[1],a[2]-b[2]);globalThis.gPolar=()=>{const p=gPose();return Math.acos((p.position[1]-p.target[1])/gDist(p.position,p.target))};globalThis.gClick=id=>document.getElementById(id).click();\nglobalThis.initialCamera=gPose().position;globalThis.initialTarget=gPose().target"
    },
    {
      "type": "snapshot_surface",
      "source": "scene3d",
      "target": "#garden",
      "name": "initial"
    },
    {
      "type": "mouse_down",
      "x": 350,
      "y": 300
    },
    {
      "type": "mouse_move",
      "x": 430,
      "y": 340
    },
    {
      "type": "mouse_up",
      "x": 430,
      "y": 340
    },
    {
      "type": "assert_script",
      "js": "gDist(gPose().position,initialCamera)>.1 && document.activeElement===document.getElementById('garden')"
    },
    {
      "type": "assert_surface",
      "source": "scene3d",
      "target": "#garden",
      "reference": "initial",
      "count": {
        "min": 1000
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#pan-mode"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('pan-mode').getAttribute('aria-pressed')==='true'"
    },
    {
      "type": "script",
      "js": "globalThis.beforePan=gPose().target"
    },
    {
      "type": "mouse_down",
      "x": 350,
      "y": 300
    },
    {
      "type": "mouse_move",
      "x": 430,
      "y": 330
    },
    {
      "type": "mouse_up",
      "x": 430,
      "y": 330
    },
    {
      "type": "assert_script",
      "js": "gDist(gPose().target,beforePan)>.1"
    },
    {
      "type": "script",
      "js": "globalThis.beforeWheel=gDist(gPose().position,gPose().target)"
    },
    {
      "type": "scroll",
      "x": 350,
      "y": 300,
      "dy": 1
    },
    {
      "type": "assert_script",
      "js": "Math.abs(gDist(gPose().position,gPose().target)-beforeWheel)>.01"
    },
    {
      "type": "script",
      "js": "globalThis.beforeTilt=gPolar()"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tilt-up"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "gPolar()<beforeTilt-.01"
    },
    {
      "type": "script",
      "js": "globalThis.beforeZoom=gDist(gPose().position,gPose().target)"
    },
    {
      "type": "click",
      "target": {
        "selector": "#zoom-in"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "gDist(gPose().position,gPose().target)<beforeZoom"
    },
    {
      "type": "click",
      "target": {
        "selector": "#zoom-out"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "Math.abs(gDist(gPose().position,gPose().target)-beforeZoom)<.00001"
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/crystal-garden-ptz.png"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      },
      "scroll_into_view": true
    },
    {
      "type": "assert_script",
      "js": "gDist(gPose().position,initialCamera)<.00001 && gDist(gPose().target,initialTarget)<.00001 && document.getElementById('orbit-mode').getAttribute('aria-pressed')==='true'"
    },
    {
      "type": "click",
      "target": {
        "selector": "#garden"
      },
      "scroll_into_view": true
    },
    {
      "type": "script",
      "js": "globalThis.beforeKeyPan=gPose().target;globalThis.beforeKeyTilt=gPolar();globalThis.beforeKeyZoom=gDist(gPose().position,gPose().target)"
    },
    {
      "type": "key_press",
      "key": "Right"
    },
    {
      "type": "key_press",
      "key": "Up",
      "mods_str": "shift"
    },
    {
      "type": "assert_script",
      "js": "gDist(gPose().target,beforeKeyPan)>.001 && gPolar()<beforeKeyTilt-.001"
    },
    {
      "type": "key_press",
      "key": "+"
    },
    {
      "type": "assert_script",
      "js": "gDist(gPose().position,gPose().target)<beforeKeyZoom"
    },
    {
      "type": "key_press",
      "key": "R"
    },
    {
      "type": "assert_script",
      "js": "gDist(gPose().position,initialCamera)<.00001 && gDist(gPose().target,initialTarget)<.00001"
    },
    {
      "type": "script",
      "js": "for(let i=0;i<50;i++)gClick('zoom-in');for(let i=0;i<50;i++)gClick('tilt-up')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(gDist(gPose().position,gPose().target)-4)<.00001 && gPolar()>=.07999"
    },
    {
      "type": "script",
      "js": "for(let i=0;i<50;i++)gClick('zoom-out');for(let i=0;i<50;i++)gClick('tilt-down')"
    },
    {
      "type": "assert_script",
      "js": "Math.abs(gDist(gPose().position,gPose().target)-35)<.00001 && gPolar()<=Math.PI*.49001"
    },
    {
      "type": "click",
      "target": {
        "selector": "#reset"
      },
      "scroll_into_view": true
    }
  ]
}
