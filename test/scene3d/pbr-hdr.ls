// Standard materials lit only by an HDR image (the `hdr` case of mod_pbr.ls): the sphere grid in
// a generated studio (assets/hdr/), against Three.js r186's PMREMGenerator.fromEquirectangular
// (test/scene3d/oracle/).
import P: .mod_pbr

let d = P.description("hdr");
<html
    <head <style "html,body{margin:0;background:#202428} scene3d{display:block}">>
    <body (P.scene(d))>
>
