{
  "name": "Embedded Type 1 math paints exact outlines and retains selectable text",
  "html": "test/input/math_intensive_test.pdf",
  "viewport": {
    "width": 900,
    "height": 900
  },
  "events": [
    {
      "type": "assert_count",
      "target": {
        "selector": ".pdf-page"
      },
      "expected": 16
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "svg g[data-pdf-glyphs=\"type1\"]"
      },
      "min": 100
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".pdf-text-layer span"
      },
      "min": 100
    },
    {
      "type": "mouse_move",
      "x": 450,
      "y": 450
    },
    {
      "type": "scroll",
      "x": 450,
      "y": 450,
      "dx": 0,
      "dy": -16
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 800,
      "tolerance": 2
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".pdf-page[data-page=\"2\"] .pdf-text-layer"
      },
      "contains": "Mathematical"
    },
    {
      "type": "mouse_drag",
      "target": {
        "text": "Mathematical"
      },
      "to_target": {
        "text": "Operators"
      },
      "button": 0
    },
    {
      "type": "assert_selection",
      "is_collapsed": false,
      "check_dom": true
    },
    {
      "type": "key_combo",
      "key": "c",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_clipboard",
      "contains": "Mathematical"
    }
  ]
}
