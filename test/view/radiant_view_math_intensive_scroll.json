{
  "name": "Math intensive LaTeX wheel scrolling preserves viewport and SVG targeting",
  "html": "test/input/math_intensive_test.tex",
  "viewport": {
    "width": 1200,
    "height": 800
  },
  "events": [
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 0,
      "tolerance": 2
    },
    {
      "type": "mouse_move",
      "x": 600,
      "y": 400
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
