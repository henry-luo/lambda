{
  "name": "Math intensive LaTeX wheel scrolling preserves viewport and SVG targeting",
  "html": "test/input/math_intensive_test.tex",
  "viewport": {
    "width": 1200,
    "height": 800
  },
  "events": [
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 0,
      "tolerance": 2
    },
    {
      "type": "mouse_move",
      "x": 600,
      "y": 400
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 400,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 800,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 1200,
      "tolerance": 2
    },
    {
      "type": "assert_hit_test",
      "target": {
        "selector": "#calculus-and-vector-groups + .latex-equation svg text"
      },
      "expected_selector": "#calculus-and-vector-groups + .latex-equation svg text",
      "expected_tag": "text"
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 1600,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 2000,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 2400,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 2800,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": -8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 3200,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": 8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 2800,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": 8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 2400,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": 8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 2000,
      "tolerance": 2
    },
    {
      "type": "scroll",
      "x": 600,
      "y": 400,
      "dx": 0,
      "dy": 8
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 1600,
      "tolerance": 2
    },
    {
      "type": "mouse_move",
      "x": 600,
      "y": 400
    },
    {
      "type": "assert_scroll",
      "x": 0,
      "y": 1600,
      "tolerance": 2
    },
    {
      "type": "assert_hit_test",
      "target": {
        "selector": "#cases + .latex-equation svg",
        "offset_x": 1,
        "offset_y": 1
      },
      "expected_selector": "#cases + .latex-equation svg",
      "expected_tag": "svg"
    }
  ],
  "description": "Wheel offsets remain exact; resolve glyph and unpainted SVG hit probes from section geometry so TeX font-metric changes cannot move unrelated content under fixed probe coordinates."
}
