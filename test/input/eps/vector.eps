%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: -10 5 110 65
%%Title: Lambda EPS vector fixture
%%EndComments
/line {lineto} bind def
newpath -10 5 moveto 110 5 line 110 65 line -10 65 line closepath
gsave 1 0 0 setrgbcolor fill grestore
2 setlinewidth stroke
gsave
10 20 translate
newpath 0 0 moveto 20 10 line 30 0 line closepath
clip newpath
0 0 1 setrgbcolor
-10 -10 60 30 rectfill
grestore
showpage
%%EOF
