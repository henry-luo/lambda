// typed presentation attributes retain numeric data and expose DOM attribute text.
<html <head <style "body{margin:0;background:#000} svg{display:block;outline:none}">>
    <body
        <div id:"spread", style:"display:none", *:{'data-a':0}, *:{'data-a':"changed"},
            *:{'data-b':1}, *:{'data-a':2}>
        <div id:"unsupported", style:"display:none", 'data-value':complex(1, 2)>
        <svg id:"stage", width:240, height:100, viewBox:"0 0 240 100", tabindex:0,
            <rect id:"numeric", x:0, y:0, width:100, height:100, fill:"#fff", 'fill-opacity':0.13>
            <path id:"line", d:"M 120 50 H 220", stroke:"#fff", 'stroke-width':6, 'stroke-opacity':0.4>>
        <div style:"display:flex", "anonymous text" <span "neighbor">>
        <textarea id:"numeric-rows", rows:3>
        <textarea id:"text-rows", rows:"3">>>
