import profile: lambda.doc.latex.tex_engine.profile
import reconstruct: lambda.doc.latex.tex_engine.reconstruct
let kernel=input(sys.lambda.home ++ "/package/doc/latex/tex_engine/kernel.tex","text")^;
let options={script_expl3:true,echo_definitions:true,adapters:[],resources:{local:{},bundled:{}}};
let constructor={*:options,constructor_argument_mode:true};
let legacy_preload=profile.preload_expl3_kernel(kernel,options,100000)^;
let constructor_preload=profile.preload_expl3_kernel(kernel,constructor,100000)^;
let sources = ["\\ExplSyntaxOn\\meaning\\int_step_function:nnnN/\\meaning\\int_step_function:nN/\\meaning\\int_step_function:nnN\\ExplSyntaxOff", "\\ExplSyntaxOn\\meaning\\int_step_inline:nn/\\meaning\\int_step_inline:nnn/\\meaning\\int_step_inline:nnnn\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nN{4}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nnN{-2}{3}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nnnN{-3}{2}{4}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nnnN{4}{-2}{-3}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nnnN{4}{1}{2}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nnnN{2}{-1}{4}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nnnN{1}{0}{3}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nn{4}{[#1]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nnn{-1}{3}{[#1]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nnnn{4}{-2}{-3}{[#1]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nnnn{1}{0}{3}{[#1]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nn{3}{[#1:\\int_step_inline:nn{2}{(##1)}]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nn{2}{[#1:\\int_use:N\\g__kernel_prg_map_int]}(\\int_use:N\\g__kernel_prg_map_int)\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\edef\\x{\\int_step_function:nnnN{1}{2}{5}\\f}\\meaning\\x\\ExplSyntaxOff", "\\ExplSyntaxOn\\let\\x\\int_step_inline:nn\\x{3}{[#1]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nn{4}{[#1]\\int_compare:nNnT{#1}={2}{\\prg_break:}}X\\ExplSyntaxOff", "\\ExplSyntaxOn\\int_step_inline:nn{0}{BAD}X\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_function:nnnN{1+2}{1+1}{10-1}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\meaning\\int_step_variable:nNn/\\meaning\\int_step_variable:nnNn/\\meaning\\int_step_variable:nnnNn\\ExplSyntaxOff", "\\ExplSyntaxOn\\ifx\\int_step_tokens:nn\\int_step_function:nN Y\\else N\\fi/\\ifx\\int_step_tokens:nnn\\int_step_function:nnN Y\\else N\\fi/\\ifx\\int_step_tokens:nnnn\\int_step_function:nnnN Y\\else N\\fi\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_tokens:nn{3}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_tokens:nnn{-1}{2}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\f#1{[#1]}\\int_step_tokens:nnnn{5}{-2}{0}\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\int_step_variable:nNn{3}\\l_x_tl{[\\l_x_tl]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\int_step_variable:nnNn{-2}{2}\\l_x_tl{[\\l_x_tl]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\int_step_variable:nnnNn{4}{-2}{0}\\l_x_tl{[\\l_x_tl]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\tl_set:Nn\\l_x_tl{old}\\int_step_variable:nNn{0}\\l_x_tl{BAD}[\\l_x_tl]\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\int_step_variable:nnnNn{1}{0}{4}\\l_x_tl{[\\l_x_tl]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\tl_new:N\\l_y_tl\\int_step_variable:nNn{2}\\l_x_tl{[\\l_x_tl/\\int_step_variable:nNn{2}\\l_y_tl{(\\l_y_tl)}]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl{\\int_step_variable:nNn{2}\\l_x_tl{[\\l_x_tl]}}/\\tl_if_empty:NTF\\l_x_tl{EMPTY}{SET}\\ExplSyntaxOff", "\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\let\\v\\int_step_variable:nNn\\v{3}\\l_x_tl{[\\l_x_tl]}\\ExplSyntaxOff", "\\ExplSyntaxOn\\meaning\\cs_gset_protected:Npe/\\meaning\\cs_gset_protected:Npx/\\meaning\\cs_set_protected:Npe/\\meaning\\cs_set_protected:Npx\\ExplSyntaxOff", "\\ExplSyntaxOn\\ifx\\cs_gset_protected:Npe\\cs_gset_protected:Npx Y\\else N\\fi/\\ifx\\cs_set_protected:Npe\\cs_set_protected:Npx Y\\else N\\fi\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\x{X}{\\cs_gset_protected:Npe\\f#1{#1\\x}}\\meaning\\f/\\f{A}\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\x{X}{\\cs_set_protected:Npe\\f#1{#1\\x}\\f{A}}\\ifdefined\\f Y\\else N\\fi\\ExplSyntaxOff", "\\ExplSyntaxOn\\protected\\def\\x{X}\\cs_gset_protected:Npe\\f{\\x}\\meaning\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\def\\x{X}\\cs_gset_protected:Npx\\f{\\x}\\meaning\\f\\ExplSyntaxOff", "\\ExplSyntaxOn\\globaldefs=-1\\scan_stop:{\\cs_gset_protected:Npe\\f{X}}\\ifdefined\\f Y\\else N\\fi\\ExplSyntaxOff", "\\ExplSyntaxOn\\globaldefs=1\\scan_stop:{\\cs_set_protected:Npe\\f{X}}\\ifdefined\\f Y\\else N\\fi\\ExplSyntaxOff"];
// The expected text and diagnostics were captured with the native TeX engine.
[for (entry in [{options:options,preload:legacy_preload},{options:constructor,preload:constructor_preload}])
  [for (source in sources) (let r=profile.expand_with_kernel(source,kernel,entry.options,100000,entry.preload)^,
    {text:reconstruct.reconstruct(r)^.text,messages:r.messages,diagnostics:r.diagnostic_records,issue:r.issue})]];
// Undefined expl3 controls remain guarded when their native meaning is not implemented.
let guarded=profile.expand_with_kernel("\\ExplSyntaxOn\\tl_new:N\\l_x_tl\\tl_new:N\\l_y_tl\\int_step_variable:nNn{2}\\l_x_tl{[\\l_x_tl:\\int_step_variable:nNn{2}\\l_y_tl{(\\l_y_tl)}]}\\ExplSyntaxOff",kernel,options,100000,legacy_preload)^;
{issue:guarded.issue,unsupported:guarded.unsupported}
