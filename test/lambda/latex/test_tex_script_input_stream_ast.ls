// Complete ASTs captured from the retired native TeX and LaTeX engines.
import profile: lambda.doc.latex.tex_engine.profile
import digest: lambda.doc.latex.tex_engine.digest
let kernel=input(sys.lambda.home ++ "/package/doc/latex/tex_engine/kernel.tex","text")^;
let options={echo_definitions:true,constructor_argument_mode:true,adapters:[],resources:{local:{'stream-data.txt':{data:"alpha\nbeta\n"}},bundled:{}}};
let preload=profile.preload_kernel(kernel,options,100000)^;
let cases=[{source:"\\openin0=stream-data.txt\\relax\\readline0 to\\foo\\begin{document}\\foo\\end{document}", expected:<latex_document <document source_offset: 47, <paragraph "alpha\r">>>},
{source:"\\def\\bar{A}\\openin0=stream-data.txt\\relax\\readline0 to\\foo\\begin{document}\\bar\\foo\\end{document}", expected:<latex_document <paragraph <def source_offset: 0, argument_groups: [{ kind: "required", raw: "\\bar", start: 4, end: 8}, { kind: "required", raw: "A", start: 8, end: 58}], "\\bar" <curly_group "A">>> <document source_offset: 58, <paragraph "Aalpha\r">>>},
{source:"\\begin{document}\\openin0=stream-data.txt\\relax\\readline0 to\\foo\\foo\\closein0 Done\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph "alpha\rDone">>>},
{source:"\\openin0=stream-data.txt\\relax\\ifeof0 BAD\\else YES\\fi\\begin{document}X\\end{document}", expected:<latex_document <paragraph "YES"> <document source_offset: 53, <paragraph "X">>>},
{source:"\\openin0=stream-data.txt\\relax\\readline0 to\\foo\\readline0 to\\bar\\closein0\\begin{document}\\foo/\\bar\\end{document}", expected:<latex_document <document source_offset: 73, <paragraph "alpha\r/beta\r">>>},
{source:"\\begin{document}\\textbf{\\openin0=stream-data.txt\\relax\\readline0 to\\foo\\foo}\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph <textbf source_offset: 16, <openin source_offset: 24, argument_groups: []> "0=stream-data.txt" <relax source_offset: 48, argument_groups: []> <readline source_offset: 54, argument_groups: []> "0 to" <foo source_offset: 67, argument_groups: []> <foo source_offset: 71, argument_groups: []>>>>>},
{source:"\\def\\x{\\openin0=stream-data.txt\\relax}\\x\\readline0 to\\foo\\begin{document}\\foo\\end{document}", expected:<latex_document <paragraph <def source_offset: 0, argument_groups: [{ kind: "required", raw: "\\x", start: 4, end: 6}, { kind: "required", raw: "\\openin0=stream-data.txt\\relax", start: 6, end: 57}], "\\x" <curly_group <openin source_offset: 7, argument_groups: []> "0=stream-data.txt" <relax source_offset: 31, argument_groups: []>>>> <document source_offset: 57, <paragraph "alpha\r">>>},
{source:"\\openin0=missing\\relax\\ifeof0 YES\\else BAD\\fi\\begin{document}X\\end{document}", expected:<latex_document <paragraph "YES"> <document source_offset: 45, <paragraph "X">>>},
{source:"\\def\\foo{A}\\ifeof0 YES\\else NO\\fi\\begin{document}X\\end{document}", expected:<latex_document <paragraph <def source_offset: 0, argument_groups: [{ kind: "required", raw: "\\foo", start: 4, end: 8}, { kind: "required", raw: "A", start: 8, end: 19}], "\\foo" <curly_group "A">> "YES"> <document source_offset: 33, <paragraph "X">>>},
{source:"\\begin{document}$x\\ifeof0 +1\\else -1\\fi$\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph <inline_math source_offset: 17, source: "x+1", ast: <math "x" <operator value: "+"> "1">>>>>},
{source:"\\def\\foo{A}\\openin0=stream-data.txt\\relax\\begin{document}\\foo\\end{document}", expected:<latex_document <paragraph <def source_offset: 0, argument_groups: [{ kind: "required", raw: "\\foo", start: 4, end: 8}, { kind: "required", raw: "A", start: 8, end: 41}], "\\foo" <curly_group "A">>> <document source_offset: 41, <paragraph "A">>>},
{source:"\\begin{document}\\textbf{abc\\closein0 xyz}\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph <textbf source_offset: 16, "abc" <closein source_offset: 27, argument_groups: []> "0 xyz">>>>},
{source:"\\begin{document}\\textbf{\\ifeof0 YES\\else NO\\fi}\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph <textbf source_offset: 16, "YES">>>>},
{source:"\\begin{document}$x\\openin0=stream-data.txt\\relax y$\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph <inline_math source_offset: 17, source: "xy", ast: <math ["x", "y"]>>>>>},
{source:"\\begin{document}$x\\readline0 to\\foo y$\\end{document}", expected:<latex_document tex_diagnostics: [{ code: "tex-read-terminal", message: "cannot \\read from the terminal in a document run", offset: 31, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <inline_math source_offset: 17, source: "xy", ast: <math ["x", "y"]>>>>>},
{source:"\\begin{document}\\def\\foo{A}\\ifeof0 YES\\else NO\\fi X\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph <def source_offset: 16, argument_groups: [{ kind: "required", raw: "\\foo", start: 20, end: 24}, { kind: "required", raw: "A", start: 24, end: 35}], "\\foo" <curly_group "A">> "YESX">>>},
{source:"\\openin0=stream-data.txt\\relax\\begin{document}\\textbf{A\\closein0 B}X\\end{document}", expected:<latex_document <document source_offset: 30, <paragraph <textbf source_offset: 46, "A" <closein source_offset: 55, argument_groups: []> "0 B"> "X">>>},
{source:"\\openin0=stream-data.txt\\relax\\read0 to\\foo\\begin{document}\\foo\\end{document}", expected:<latex_document <document source_offset: 43, <paragraph "alpha ">>>},
{source:"\\begin{document}\\let\\x\\ifeof\\x0 Y\\else N\\fi\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph "Y">>>},
{source:"\\openin0=stream-data.txt\\relax\\readline0 to\\foo\\begin{document}\\section{\\foo}\\end{document}", expected:<latex_document <document source_offset: 47, <section source_offset: 63, title: <curly_group "alpha\r">>>>},
{source:"\\begin{document}\\ifeof0 \\section{A}\\else B\\fi\\end{document}", expected:<latex_document <document source_offset: 0, <section source_offset: 24, title: <curly_group "A">>>>},
{source:"\\begin{document}\\ifeof0 \\textbf{A}\\else B\\fi\\end{document}", expected:<latex_document <document source_offset: 0, <paragraph <textbf source_offset: 24, "A">>>>},
{source:"\\openin0=stream-data.txt\\relax\\readline0 to\\foo\\begin{document}\\foo \\textbf{B}\\end{document}", expected:<latex_document <document source_offset: 47, <paragraph "alpha\r" <textbf source_offset: 68, "B">>>>},
{source:"\\begin{document}$x\\openin0=stream-data.txt\\relax\\readline0 to\\v\\v y$\\end{document}",expected:<latex_document <document source_offset: 0, <paragraph <inline_math source_offset: 17, source: "xalpha\ry", ast: <math ["x", "a", "l", "p", "h", "a", "y"]> > > > >},
{source:"\\begin{document}$x\\openin0=stream-data.txt\\relax\\readline0 to\\v\\ifeof0 T\\else F\\fi\\v y$\\end{document}",expected:<latex_document <document source_offset: 0, <paragraph <inline_math source_offset: 17, source: "xFalpha\ry", ast: <math ["x", "F", "a", "l", "p", "h", "a", "y"]> > > > >},
{source:"\\endlinechar=9 \\openin0=stream-data.txt\\relax\\readline0 to\\v\\begin{document}$x\\v y$\\end{document}",expected:<latex_document <document source_offset: 60, <paragraph <inline_math source_offset: 77, source: "xalpha\ty", ast: <math ["x", "a", "l", "p", "h", "a", "y"]> > > > >},
{source:"\\endlinechar=10 \\openin0=stream-data.txt\\relax\\readline0 to\\v\\begin{document}$x\\v y$\\end{document}",expected:<latex_document <document source_offset: 61, <paragraph <inline_math source_offset: 78, source: "xalpha\ny", ast: <math ["x", "a", "l", "p", "h", "a", "y"]> > > > >},
{source:"\\endlinechar=11 \\openin0=stream-data.txt\\relax\\readline0 to\\v\\begin{document}$x\\v y$\\end{document}",expected:<latex_document <document source_offset: 61, <paragraph <inline_math source_offset: 78, source: ("xalpha" ++ chr(11) ++ "y"), ast: <math ["x", "a", "l", "p", "h", "a", "y"]> > > > >},
{source:"\\endlinechar=12 \\openin0=stream-data.txt\\relax\\readline0 to\\v\\begin{document}$x\\v y$\\end{document}",expected:<latex_document <document source_offset: 61, <paragraph <inline_math source_offset: 78, source: "xalpha\fy", ast: <math ["x", "a", "l", "p", "h", "a", "y"]> > > > >},
{source:"\\endlinechar=13 \\openin0=stream-data.txt\\relax\\readline0 to\\v\\begin{document}$x\\v y$\\end{document}",expected:<latex_document <document source_offset: 61, <paragraph <inline_math source_offset: 78, source: "xalpha\ry", ast: <math ["x", "a", "l", "p", "h", "a", "y"]> > > > >},
{source:"\\endlinechar=32 \\openin0=stream-data.txt\\relax\\readline0 to\\v\\begin{document}$x\\v y$\\end{document}",expected:<latex_document <document source_offset: 61, <paragraph <inline_math source_offset: 78, source: "xalpha y", ast: <math ["x", "a", "l", "p", "h", "a", "y"]> > > > >}];
[for (c in cases) (let r=profile.expand_with_kernel(c.source,kernel,options,100000,preload)^, let d=digest.digest(r)^, {issue:d.issue, matches:d.ast==c.expected})]
// The legacy eager constructor mode must still reject its known unsafe mapping.
let legacy=profile.expand_with_kernel(cases[5].source,kernel,{*:options,constructor_argument_mode:false},100000)^;
let rejected=digest.digest(legacy)^;
{issue:rejected.issue, unsupported:rejected.unsupported}
