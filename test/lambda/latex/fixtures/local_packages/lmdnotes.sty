\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lmdnotes}[2026/10/07 Phase IV fixture package]
\RequirePackage{xcolor}
\newif\if@lmdnotes@draft
\DeclareOption{draft}{\@lmdnotes@drafttrue}
