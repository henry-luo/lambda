import profile: lambda.doc.latex.tex_engine.profile
import reconstruct: lambda.doc.latex.tex_engine.reconstruct
let kernel=input("lmd/package/doc/latex/tex_engine/kernel.tex","text")^;
let cases=[
 "\\setbox0=\\hbox{}\\ifvoid0 V\\else N\\fi",
 "\\setbox0=\\hbox{Hi}A\\copy0!\\box0!\\copy0 B",
 "\\setbox0=\\vbox{Hi}\\ifvbox0 Y\\else N\\fi\\ifhbox0 N\\else Y\\fi",
 "\\setbox0=\\vtop{Hi}\\ifvbox0 Y\\else N\\fi",
 "\\ifvoid0 Y\\else N\\fi",
 "\\copy0\\box0 Z",
 "\\setbox0=\\hbox{A}\\setbox1=\\copy0\\copy0/\\copy1",
 "\\setbox0=\\hbox{A}\\setbox1=\\box0\\ifvoid0 Y\\else N\\fi\\copy1",
 "\\setbox0=\\hbox{A}\\setbox0=\\copy0\\copy0",
 "\\setbox0=\\hbox{A}\\setbox0=\\box0\\copy0",
 "\\setbox0=\\hbox{A}{\\setbox0=\\hbox{B}\\copy0}\\copy0",
 "\\setbox0=\\hbox{A}{\\global\\setbox0=\\hbox{B}\\copy0}\\copy0",
 "\\setbox0=\\hbox{A}{\\box0}\\ifvoid0 Y\\else N\\fi",
 "\\setbox0=\\hbox{A}{\\setbox0=\\hbox{B}\\box0}\\copy0",
 "\\setbox0=\\hbox{A}{\\setbox0=\\hbox{B}{\\box0}\\ifvoid0 Y\\else N\\fi}\\copy0",
 "\\setbox0=\\hbox{A}{\\global\\setbox0=\\hbox{B}{\\box0}}\\ifvoid0 Y\\else N\\fi",
 "\\newbox\\a\\setbox\\a=\\hbox{X}\\copy\\a",
 "\\def\\index{5}\\setbox\\index=\\hbox{X}\\copy5",
 "\\let\\s\\setbox\\let\\b\\hbox\\s0=\\b{X}\\copy0",
 "\\setbox0\\hbox to 10pt{X}\\copy0",
 "\\setbox0\\vbox spread 2pt{X}\\copy0",
 "\\afterassignment A\\setbox0=\\hbox{B}\\copy0",
 "\\everyhbox={H}\\setbox0=\\hbox{B}\\copy0",
 "\\everyvbox={V}\\setbox0=\\vbox{B}\\copy0",
 "\\everyhbox={\\global\\count0=7}\\setbox0=\\hbox{B}\\the\\count0\\copy0",
 "\\setbox0=\\hbox{A\\hbox{B}C}\\copy0",
 "\\setbox0=\\hbox{a%note\n b}\\copy0",
 "\\setbox0=\\hbox{\\def\\x{Q}\\x}\\copy0\\ifdefined\\x N\\else Y\\fi",
 "\\setbox0=\\hbox{\\global\\def\\x{Q}\\x}\\copy0\\x",
 "\\setbox0=\\hbox{\\aftergroup A B}\\copy0",
 "\\setbox0=\\hbox{A}\\setbox1=\\hbox{B\\copy0 C}\\copy1",
 "\\setbox0=\\hbox{A}\\setbox1=\\hbox{B\\box0 C}\\ifvoid0 Y\\else N\\fi\\copy1",
 "\\setbox0=\\hbox{A}{\\setbox1=\\copy0\\box0\\copy1}\\ifvoid0 Y\\else N\\fi",
 "\\globaldefs=1 {\\setbox0=\\hbox{X}}\\copy0",
 "\\globaldefs=-1 {\\global\\setbox0=\\hbox{X}}\\ifvoid0 Y\\else N\\fi",
 "\\setbox0=\\hbox{A}\\ifhbox0 H\\else X\\fi\\ifvbox0 X\\else V\\fi\\ifvoid0 X\\else N\\fi",
 "\\setbox0=\\hbox{A}\\unhcopy0/\\unhbox0/\\ifvoid0 V\\else N\\fi",
 "\\setbox0=\\vbox{A}\\unvcopy0/\\unvbox0/\\ifvoid0 V\\else N\\fi",
 "\\setbox0=\\hbox{A}\\unvcopy0\\unvbox0",
 "\\setbox0=\\vbox{A}\\unhcopy0\\unhbox0",
 "\\setbox0=\\hbox{A}\\lastbox/\\copy0",
 "\\setbox0=\\hbox{A}\\setbox0=\\lastbox\\ifvoid0 Y\\else N\\fi",
 "\\setbox0=\\vbox{A}\\vsplit0 to 5pt/\\ifvoid0 Y\\else N\\fi",
 "\\setbox0=\\vbox{A}\\setbox1=\\vsplit0 to 5pt\\copy1/\\ifvoid0 Y\\else N\\fi",
 "\\setbox0=\\vbox{A}\\vsplit0 5pt X",
 "\\vsplit0 to 5pt X",
 "\\setbox0=\\hbox{A}{\\unhbox0}\\ifvoid0 Y\\else N\\fi",
 "\\setbox0=\\hbox{A}{\\setbox0=\\hbox{B}\\unhbox0}\\copy0",
 "\\setbox0=\\hbox{A}\\showbox0",
 "\\setbox0=\\hbox{A}\\setbox1=\\copy0\\showbox1",
 "A \\setbox0=\\hbox{\\unskip X}\\copy0",
 "A \\setbox0=\\hbox{\\setbox1=\\hbox{\\unskip X}\\copy1}\\copy0",
 "\\setbox0=\\hbox{A \\unskip B}\\copy0",
 "\\setbox0=\\hbox{A\\hskip1pt\\unskip B}\\copy0",
 "\\setbox0=\\hbox{A}{\\setbox0=\\copy0\\box0}\\ifvoid0 N\\else Y\\fi\\copy0",
 "\\setbox0=\\hbox{A}{\\setbox0=\\copy0{\\box0}\\ifvoid0 V\\else N\\fi}\\copy0",
 "\\setbox0=\\hbox{A}{\\setbox0=\\copy0{\\global\\setbox0=\\copy0\\box0}}\\ifvoid0 V\\else N\\fi",
 "\\setbox0=\\hbox{A}{\\setbox0=\\box0\\box0}\\ifvoid0 V\\else N\\fi",
 "\\setbox0=\\hbox{A}{\\setbox0=\\copy0{\\setbox0=\\copy0\\box0}\\copy0}\\copy0",
 "\\setbox0=\\hbox{A}{\\setbox0=\\hbox{B}\\global\\setbox0=\\copy0\\setbox0=\\copy0\\box0}\\copy0",
 "\\setbox0=\\hbox{A}{\\setbox1=\\copy0{\\box0}\\copy1}\\ifvoid0 V\\else N\\fi",
 "\\setbox0=\\hbox{A}{\\setbox0=\\copy0\\global\\setbox0=\\copy0{\\setbox0=\\copy0\\box0}}\\copy0"];
let results=[for(source in cases) {
 let ex=profile.expand_with_kernel(source,kernel,{echo_definitions:true,constructor_argument_mode:false,adapters:[],resources:{local:{},bundled:{}}},100000)^;
 let tex=parse(source,{type:"tex"})^;
 {supported:ex.issue==null,text:reconstruct.reconstruct(ex)^.text==tex.text,
  messages:ex.messages==tex.messages,diagnostics:ex.diagnostic_records==tex.diagnostics}
}];
{cases:len(results),supported:all([for(r in results) r.supported]),text:all([for(r in results) r.text]),
 messages:all([for(r in results) r.messages]),diagnostics:all([for(r in results) r.diagnostics])}
