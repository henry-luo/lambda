// D10.2.2v2: diagnostics and trees were captured from the retired engines.
import profile: lambda.doc.latex.tex_engine.profile
import digest: lambda.doc.latex.tex_engine.digest
let kernel=input(sys.lambda.home ++ "/package/doc/latex/tex_engine/kernel.tex","text")^;
let options={echo_definitions:true,constructor_argument_mode:true,adapters:[],resources:{local:{},bundled:{}}};
let preload=profile.preload_kernel(kernel,options,100000)^;
let cases=[
{source:"\\begin{document}\\newcounter{n}\\newcounter{n}\\arabic{n}\\end{document}",diagnostics:[{ code: "latex-counter-defined", message: "LaTeX Error: Counter `n' already defined", offset: 44, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "latex-counter-defined", message: "LaTeX Error: Counter `n' already defined", offset: 44, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 16, argument_groups: [{ kind: "required", raw: "n", start: 27, end: 30}], "n"> <newcounter source_offset: 30, argument_groups: [{ kind: "required", raw: "n", start: 41, end: 53}], "n"> "0">>>},
{source:"\\begin{document}\\newcounter{n}\\alph{n}\\end{document}",diagnostics:[{ code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 37, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 37, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 16, argument_groups: [{ kind: "required", raw: "n", start: 27, end: 38}], "n">>>>},
{source:"\\begin{document}\\newcounter{n}\\setcounter{n}{27}\\alph{n}\\end{document}",diagnostics:[{ code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 55, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 55, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 16, argument_groups: [{ kind: "required", raw: "n", start: 27, end: 30}], "n"> <setcounter source_offset: 30, argument_groups: [{ kind: "required", raw: "n", start: 41, end: 44}, { kind: "required", raw: "27", start: 44, end: 56}], ["n", "27"]>>>>},
{source:"\\begin{document}\\newcounter{n}\\setcounter{n}{10}\\fnsymbol{n}\\end{document}",diagnostics:[{ code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 59, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 59, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 16, argument_groups: [{ kind: "required", raw: "n", start: 27, end: 30}], "n"> <setcounter source_offset: 30, argument_groups: [{ kind: "required", raw: "n", start: 41, end: 44}, { kind: "required", raw: "10", start: 44, end: 60}], ["n", "10"]>>>>},
{source:"\\begin{document}\\newcounter{n}\\setcounter{n}{1+2}\\arabic{n}\\end{document}",diagnostics:[{ code: "latex-counter-value", message: "counter value has trailing material", offset: 48, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "latex-counter-value", message: "counter value has trailing material", offset: 48, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 16, argument_groups: [{ kind: "required", raw: "n", start: 27, end: 30}], "n"> <setcounter source_offset: 30, argument_groups: [{ kind: "required", raw: "n", start: 41, end: 44}, { kind: "required", raw: "1+2", start: 44, end: 48}], ["n", "1+2"]> "+21">>>},
{source:"\\begin{document}\\newcounter{n}\\setcounter{n}{1\\relax A}\\arabic{n}\\end{document}",diagnostics:[{ code: "latex-counter-value", message: "counter value has trailing material", offset: 54, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "latex-counter-value", message: "counter value has trailing material", offset: 54, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 16, argument_groups: [{ kind: "required", raw: "n", start: 27, end: 30}], "n"> <setcounter source_offset: 30, argument_groups: [{ kind: "required", raw: "n", start: 41, end: 44}, { kind: "required", raw: "1\\relax A", start: 44, end: 54}], *[["n", "1"], <relax source_offset: 46, argument_groups: []>, " A"]> "A1">>>},
{source:"\\begin{document}\\newcounter{n}\\setcounter{n}{\\numexpr1+2\\relax A}\\arabic{n}\\end{document}",diagnostics:[{ code: "latex-counter-value", message: "counter value has trailing material", offset: 64, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "latex-counter-value", message: "counter value has trailing material", offset: 64, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 16, argument_groups: [{ kind: "required", raw: "n", start: 27, end: 30}], "n"> <setcounter source_offset: 30, argument_groups: [{ kind: "required", raw: "n", start: 41, end: 44}, { kind: "required", raw: "\\numexpr1+2\\relax A", start: 44, end: 64}], "n" <numexpr source_offset: 45, argument_groups: []> "1+2" <relax source_offset: 56, argument_groups: []> " A"> "A3">>>},
{source:"\\begin{document}\\count20=25\\newcounter{n}\\setcounter{n}{3}\\arabic{n}\\end{document}",diagnostics:[{ code: "tex-no-room", message: "No room for a new register", offset: 41, line: 1}],expected_ast:<latex_document tex_diagnostics: [{ code: "tex-no-room", message: "No room for a new register", offset: 41, line: 1}], tex_packages: [], <document source_offset: 0, <paragraph <newcounter source_offset: 27, argument_groups: [{ kind: "required", raw: "n", start: 38, end: 41}], "n"> <setcounter source_offset: 41, argument_groups: [{ kind: "required", raw: "n", start: 52, end: 55}, { kind: "required", raw: "3", start: 55, end: 67}], ["n", "3"]> "3">>>},
{source:"\\begin{document}\n\\newcounter{n}\n\\newcounter{n}\n\\arabic{n}\\end{document}",diagnostics:[{ code: "latex-counter-defined", message: "LaTeX Error: Counter `n' already defined", offset: 47, line: 4}]},
{source:"\\begin{document}\\def\\doit{\\newcounter{n}}\\doit\\doit\\end{document}",diagnostics:[{ code: "latex-counter-defined", message: "LaTeX Error: Counter `n' already defined", offset: 51, line: 1}]},
{source:"\\begin{document}\\def\\id{n}\\newcounter{\\id}\\newcounter{\\id}\\end{document}",diagnostics:[{ code: "latex-counter-defined", message: "LaTeX Error: Counter `n' already defined", offset: 58, line: 1}]},
{source:"\\begin{document}\\newcounter{n}\\alph{n}\\newcounter{n}\\Alph{n}\\end{document}",diagnostics:[{ code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 37, line: 1}, { code: "latex-counter-defined", message: "LaTeX Error: Counter `n' already defined", offset: 52, line: 1}, { code: "latex-counter-too-large", message: "LaTeX Error: Counter too large", offset: 59, line: 1}]},
{source:"\\begin{document}\\newcounter{é}\\newcounter{é}\\end{document}",diagnostics:[{ code: "latex-counter-defined", message: "LaTeX Error: Counter `é' already defined", offset: 46, line: 1}]},
{source:"\\begin{document}\\def\\valueA{1+2}\\newcounter{n}\\setcounter{n}{\\valueA}\\arabic{n}\\end{document}",diagnostics:[{ code: "latex-counter-value", message: "counter value has trailing material", offset: 68, line: 1}]}
];
[for (c in cases) (let r=profile.expand_with_kernel(c.source,kernel,options,100000,preload)^,
    let d=digest.digest(r)^, let t=parse(c.source,{type:"tex"}) ^ { null },
    let a=parse(c.source,{type:"latex"}) ^ { null },
    {issue:r.issue,diagnostics_match:r.diagnostic_records==c.diagnostics,
     tex_match:t!=null and t.diagnostics==c.diagnostics,
     document_match:a!=null and a.tex_diagnostics==c.diagnostics,
     ast_match:if(c.expected_ast==null) null else d.ast==c.expected_ast and a==c.expected_ast})]
let child="\\newcounter{n}\n\\newcounter{n}\n";
let child_source="\\input{counter-child.tex}\\begin{document}X\\end{document}";
let child_options={*:options,resources:{local:{'counter-child.tex':{data:child}},bundled:{}}};
let child_expected=<latex_document tex_diagnostics:[{code:"latex-counter-defined",message:"LaTeX Error: Counter `n' already defined",offset:25,line:1}],tex_packages:[], <document source_offset:25,<paragraph "X">>>;
let c=profile.expand_with_kernel(child_source,kernel,child_options,100000)^;
let child_ast=digest.digest(c)^;
{issue:c.issue,child_matches:child_ast.ast==child_expected}
