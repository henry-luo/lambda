import profile: lambda.doc.latex.tex_engine.profile
import reconstruct: lambda.doc.latex.tex_engine.reconstruct
let kernel=input(sys.lambda.home ++ "/package/doc/latex/tex_engine/kernel.tex","text")^;
let options={script_expl3:true,echo_definitions:true,adapters:[],resources:{local:{},bundled:{}}};
let constructor={*:options,constructor_argument_mode:true};
let legacy_preload=profile.preload_expl3_kernel(kernel,options,100000)^;
let constructor_preload=profile.preload_expl3_kernel(kernel,constructor,100000)^;
let sources = ["\\ExplSyntaxOn\\meaning\\str_count:n/\\meaning\\str_count:N/\\meaning\\str_count_spaces:n/\\meaning\\str_count_ignore_spaces:n\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{}|\\str_count_spaces:n{}|\\str_count_ignore_spaces:n{}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{}|\\str_count_ignore_spaces:n{}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{a}|\\str_count_ignore_spaces:n{a}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aa}|\\str_count_ignore_spaces:n{aa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaa}|\\str_count_ignore_spaces:n{aaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaa}|\\str_count_ignore_spaces:n{aaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaa}|\\str_count_ignore_spaces:n{aaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaa}|\\str_count_ignore_spaces:n{aaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{aaaaaaaaaaaaaaaaa}|\\str_count_ignore_spaces:n{aaaaaaaaaaaaaaaaa}\\ExplSyntaxOff", "\\ExplSyntaxOn\\str_count:n{