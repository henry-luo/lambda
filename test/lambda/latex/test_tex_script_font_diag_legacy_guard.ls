import profile: lambda.doc.latex.tex_engine.profile
import digest: lambda.doc.latex.tex_engine.digest
let kernel=input(sys.lambda.home ++ "/package/doc/latex/tex_engine/kernel.tex","text")^;
let options={echo_definitions:true,adapters:[],resources:{local:{},bundled:{}}};
let preload=profile.preload_kernel(kernel,options,100000)^;
let sources = ["\\begin{document}A\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen8\\f\\relaxB\\end{document}", "\\begin{document}A{\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen8\\f\\relax}B\\end{document}", "\\begin{document}A\\textbf{\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen8\\f\\relax}B\\end{document}", "\\begin{document}A\\section{\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen8\\f\\relax}XB\\end{document}", "\\begin{document}A\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen0\\f=3sp\\relaxB\\end{document}", "\\begin{document}A{\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen0\\f=3sp\\relax}B\\end{document}", "\\begin{document}A\\textbf{\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen0\\f=3sp\\relax}B\\end{document}", "\\begin{document}A\\section{\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen0\\f=3sp\\relax}XB\\end{document}", "\\begin{document}A\\the\\fontdimen0\\nullfont\\relaxB\\end{document}", "\\begin{document}A{\\the\\fontdimen0\\nullfont\\relax}B\\end{document}", "\\begin{document}A\\textbf{\\the\\fontdimen0\\nullfont\\relax}B\\end{document}", "\\begin{document}A\\section{\\the\\fontdimen0\\nullfont\\relax}XB\\end{document}"];
[for (source in sources) (let r=digest.digest(profile.expand_with_kernel(source,kernel,options,100000,preload)^)^, {issue:r.issue,unsupported:r.unsupported})]
