import profile: lambda.doc.latex.tex_engine.profile
import digest: lambda.doc.latex.tex_engine.digest
let kernel = input(sys.lambda.home# ++ "/package/doc/latex/tex_engine/kernel.tex", "text")^;
fn report(source) any^ {
    let exp = profile.expand_with_kernel(source, kernel, {resources: {local: {}, bundled: {}}}, 100000)^;
    let result = digest.digest(exp)^;
    {issue: result.issue, unsupported: result.unsupported, complete: result.complete,
        matches_native: if (result.ast == null) null else result.ast == (parse(source, {type:"latex"})^)}
}
"document:"; report("\\documentclass{article}\\begin{document}Hello \\textbf{world}!\\end{document}")
"paragraphs:"; report("\\begin{document}A\n\nB\\end{document}")
"nested inline:"; report("\\begin{document}A \\emph{one \\textbf{two}}.\\end{document}")
"plain text:"; report("Hello world")
"unknown command:"; report("\\begin{document}\\mystery{X}\\end{document}")
"inline math:"; report("\\begin{document}$x$\\end{document}")
"newline and Unicode:"; report("\\begin{document}é  \nB\\end{document}")
"space before break:"; report("\\begin{document}A \n\nB\\end{document}")
"source comment:"; report("\\begin{document}A% comment\nB\\end{document}")
"definition echo pending:"; report("\\def\\my{X}\\begin{document}\\my\\end{document}")
"headings:"; report("\\begin{document}\\section{Intro}Hi\\subsection{Next}Bye\\end{document}")
"formatted heading:"; report("\\begin{document}\\section{One \\textbf{Two}}Hi\\end{document}")
"class options:"; report("\\documentclass[12pt,twoside]{article}\\begin{document}A\\end{document}")
"declarations:"; report("\\documentclass{article}\\usepackage[margin=1in]{geometry}\\title{Title}\\author{Jane}\\date{Now}\\begin{document}\\maketitle\\tableofcontents Body\\end{document}")
"command whitespace:"; report("\\begin{document}\\maketitle  \nText\\end{document}")
"inline groups:"; report("\\begin{document}A {x {y} z} B\\end{document}")
"nested environments:"; report("\\begin{document}A\\begin{quote}Hello \\textbf{world}.\\begin{center}Mid\\end{center}End\\end{quote}B\\end{document}")
"display math:"; report("\\begin{document}$$x+y=10$$\\end{document}")
"math spaces:"; report("\\begin{document}A $a + b$ B\\end{document}")
"math superscript:"; report("\\begin{document}$x^2$\\end{document}")
"math scripts:"; report("\\begin{document}$x_i^2+y_{10}+z^{ab}$\\end{document}")
"repeated math scripts pending:"; report("\\begin{document}$x^2^3$\\end{document}")
"adjacent math atoms:"; report("\\begin{document}$abc+12xy$\\end{document}")
"math commands:"; report("\\begin{document}$\\frac{a}{b}+\\sqrt{x}+\\sqrt[3]{x}+\\alpha$\\end{document}")
"scripted math command:"; report("\\begin{document}$\\sum_i^2$\\end{document}")
"parenthesized math:"; report("\\begin{document}A \\(x+\\alpha\\) B\\end{document}")
"bracketed math:"; report("\\begin{document}\\[\\frac{a}{b}\\]\\end{document}")
"list environment:"; report("\\begin{document}\\begin{itemize}\\item First\\item Second\\end{itemize}\\end{document}")
"nested lists:"; report("\\begin{document}\\begin{enumerate}\\item A\\begin{itemize}\\item B\\end{itemize}\\item C\\end{enumerate}\\end{document}")
"labeled items:"; report("\\begin{document}\\begin{description}\\item[Label] Text\\item[Other] More\\end{description}\\end{document}")
"heading variants:"; report("\\begin{document}\\section*{Star}\\section[Short]{Long}\\end{document}")
"formatted title:"; report("\\title{Hello \\textbf{World}}\\author{J.  Doe}\\begin{document}X\\end{document}")
fn report_echo_ast(source) any^ {
    let exp = profile.expand_with_kernel(source, kernel, {echo_definitions: true, resources: {local: {}, bundled: {}}}, 100000)^;
    let result = digest.digest(exp)^;
    {issue: result.issue, unsupported: result.unsupported, incomplete: exp.echo_incomplete,
        matches_native: if (result.ast == null) null else result.ast == (parse(source, {type:"latex"})^)}
}
"echoed definition AST:"; report_echo_ast("\\def\\my{X}\\begin{document}\\my\\end{document}")
"echoed command AST:"; report_echo_ast("\\newcommand{\\hi}[1]{Hello #1}\\begin{document}\\hi{Bob}\\end{document}")
"echoed optional command AST:"; report_echo_ast("\\newcommand*{\\hi}[2][Hi]{#1 #2}\\begin{document}\\hi{Bob}\\end{document}")
"echoed prefixed definition AST:"; report_echo_ast("\\global \\long\\def\\my{X}\\begin{document}\\my\\end{document}")
"echoed environment AST:"; report_echo_ast("\\newenvironment{boxy}[1]{<#1>}{!}\\begin{document}\\begin{boxy}{A}X\\end{boxy}\\end{document}")
"echoed parameter definition AST:"; report_echo_ast("\\def\\id#1{#1}\\begin{document}\\id{A}\\end{document}")
"echoed multiline definition AST:"; report_echo_ast("\\def\\x{A\nB}\\begin{document}\\x\\end{document}")
"echoed delimited definition AST:"; report_echo_ast("\\def\\f#1,#2;{#2/#1}\\begin{document}\\f A,B;\\end{document}")
"echoed multiline environment AST:"; report_echo_ast("\\newenvironment{boxy}{A\nB}{C}\\begin{document}\\begin{boxy}X\\end{boxy}\\end{document}")
"echoed commented definition AST:"; report_echo_ast("\\def\\x{A% comment\nB}\\begin{document}\\x\\end{document}")
"echoed blank-line definition AST:"; report_echo_ast("\\def\\x{A\n\nB}\\begin{document}\\x\\end{document}")
"robust definition AST:"; report_echo_ast("\\DeclareRobustCommand{\\x}{A}\\begin{document}\\x\\end{document}")
"unknown no argument:"; report("\\begin{document}A \\mystery B\\end{document}")
"unknown starred:"; report("\\begin{document}\\mystery*{X}\\end{document}")
"unknown nested argument:"; report("\\begin{document}\\mystery{X \\textbf{Y}}\\end{document}")
"unknown empty argument:"; report("\\begin{document}\\mystery{}\\end{document}")
"unknown multiple arguments:"; report("\\begin{document}\\mystery{X}{Y}\\end{document}")
"unknown optional argument:"; report("\\begin{document}\\mystery[opt]{X}\\end{document}")
"text underline:"; report("\\begin{document}\\underline{X}\\end{document}")
"unknown environment:"; report("\\begin{document}\\begin{strange}Hello\\end{strange}\\end{document}")
"nested unknown environments:"; report("\\begin{document}\\begin{outer}A\\begin{inner}B\\end{inner}C\\end{outer}\\end{document}")
"unknown environment option pending:"; report("\\begin{document}\\begin{strange}[x]Hello\\end{strange}\\end{document}")
"unknown whitespace before group:"; report("\\begin{document}\\mystery {X}\\end{document}")
"unknown comment before group:"; report("\\begin{document}\\mystery% hi\n{X}\\end{document}")
"unknown mixed arguments:"; report("\\begin{document}\\mystery{X}{}[opt]{Y}\\end{document}")
"unknown nested multiple arguments:"; report("\\begin{document}\\mystery{X \\textbf{Y}}{Z}\\end{document}")
"robust starred definition AST:"; report_echo_ast("\\DeclareRobustCommand*{\\foo}[1]{X #1}\\begin{document}\\foo{Q}\\end{document}")
"unknown comment between arguments:"; report("\\begin{document}\\mystery{A}% hello\n{B}\\end{document}")
"unknown multiple comments in arguments:"; report("\\begin{document}\\mystery% a\n % b\n[A]% c\n{B}\\end{document}")
"unknown nested optional brackets:"; report("\\begin{document}\\mystery[a[b]c]{X}\\end{document}")
"unknown formatted optional argument:"; report("\\begin{document}\\mystery[{A} \\textbf{B}]{X}\\end{document}")
"unknown optional comment:"; report("\\begin{document}\\mystery[A% ] ignore\nB]{X}\\end{document}")
"echoed document command AST:"; report_echo_ast("\\NewDocumentCommand\\foo{m}{[#1]}\\begin{document}\\foo{A}\\end{document}")
"echoed optional document command AST:"; report_echo_ast("\\NewDocumentCommand{\\foo}{O{Z}}{[#1]}\\begin{document}\\foo\\end{document}")
"parenthesized command arguments:"; report("\\begin{document}\\mystery(1,2){X}\\end{document}")
"nested parenthesized command argument:"; report("\\begin{document}\\mystery(a(b)c)[opt]{X}\\end{document}")
"coordinate chains:"; report("\\begin{document}\\mystery(0,0)(-1.2,+3)(5,6)\\end{document}")
"parenthesized prose:"; report("\\begin{document}\\mystery() and \\mystery(text)\\end{document}")
"spaced parenthesized prose:"; report("\\begin{document}\\mystery (1,2)\\end{document}")
"empty parentheses before argument:"; report("\\begin{document}\\mystery(){X}\\end{document}")
"parenthesis comment between groups:"; report("\\begin{document}\\mystery(1,2)%comment\n{X}\\end{document}")
"unclosed parentheses:"; report("\\begin{document}\\mystery(x\\end{document}")
"non-coordinate parentheses before comment:"; report("\\begin{document}\\mystery(a)%comment\n{X}\\end{document}")
"coordinate comment:"; report("\\begin{document}\\mystery(1,%hi\n2)\\end{document}")
"coordinate control:"; report("\\begin{document}\\mystery(\\1,2)\\end{document}")
"formatted parentheses:"; report("\\begin{document}\\mystery(a\\textbf{B}){X}\\end{document}")
"coordinate form feed:"; report("\\begin{document}\\mystery(1," ++ chr(12) ++ "2)\\end{document}")
"coordinate vertical tab:"; report("\\begin{document}\\mystery(1," ++ chr(11) ++ "2)\\end{document}")
"expanded parenthesis mapping pending:"; report_echo_ast("\\def\\arg{(1,2)}\\begin{document}\\mystery\\arg\\end{document}")
"expanded coordinate mapping pending:"; report_echo_ast("\\def\\arg{1,2}\\begin{document}\\mystery(\\arg)\\end{document}")
"expanded parenthesis with argument mapping pending:"; report_echo_ast("\\def\\arg{(a)}\\begin{document}\\mystery\\arg{X}\\end{document}")
"literal escapes:"; report("\\begin{document}A\\$B\\%C\\#D\\&E\\_F\\{G\\}H\\end{document}")
"spacing commands:"; report("\\begin{document}A\\quad B\\qquad C\\,D\\;E\\:F\\!G\\end{document}")
"spacing and empty groups:"; report("\\begin{document}A\\quad{}B\\qquad{}C\\end{document}")
"row separator:"; report("\\begin{document}A\\\\B\\\\[2pt]C\\end{document}")
"escaped and spacing inside formatting:"; report("\\begin{document}\\textbf{A\\%B\\quad C}\\end{document}")
"escaped control followed by space:"; report("\\begin{document}A\\% B\\, C\\\\ D\\end{document}")
"expanded literal escape AST:"; report_echo_ast("\\def\\mark{\\%}\\begin{document}A\\mark B\\end{document}")
"expanded spacing command AST:"; report_echo_ast("\\def\\spaceout{\\quad}\\begin{document}A\\spaceout B\\end{document}")
"expanded row separator AST:"; report_echo_ast("\\def\\linebreak{\\\\}\\begin{document}A\\linebreak B\\end{document}")
"expanded control symbol spacing AST:"; report_echo_ast("\\def\\spaceout{\\,}\\begin{document}A\\spaceout B\\end{document}")
"expanded spacing followed by punctuation:"; report_echo_ast("\\def\\s{\\quad}\\begin{document}A\\s!B\\end{document}")
"expanded spacing followed by group:"; report_echo_ast("\\def\\s{\\quad}\\begin{document}A\\s{}B\\end{document}")
"expanded spacing followed by extra spaces:"; report_echo_ast("\\def\\s{\\quad}\\begin{document}A\\s  B\\end{document}")
"direct spacing before expanded letter:"; report_echo_ast("\\def\\s{B}\\begin{document}A\\quad\\s\\end{document}")
"spacing followed by comment:"; report_echo_ast("\\begin{document}A\\quad%abc\nB\\end{document}")
"spacing followed by whitespace and comment:"; report_echo_ast("\\begin{document}A\\quad %abc\nB\\end{document}")
"spacing followed by multiple whitespace:"; report_echo_ast("\\begin{document}A\\quad  B\\end{document}")
"spacing around indented comment:"; report_echo_ast("\\begin{document}A\\quad %é\n  B\\end{document}")
"spacing around CRLF comment:"; report_echo_ast("\\begin{document}A\\quad %abc\r\n B\\end{document}")
"spacing around consecutive comments:"; report_echo_ast("\\begin{document}A\\quad %abc\n  %def\n B\\end{document}")
