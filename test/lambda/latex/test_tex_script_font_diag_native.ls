import profile: lambda.doc.latex.tex_engine.profile
import reconstruct: lambda.doc.latex.tex_engine.reconstruct
let kernel=input(sys.lambda.home ++ "/package/doc/latex/tex_engine/kernel.tex","text")^;
let options={echo_definitions:true,adapters:[],resources:{local:{},bundled:{}}};
let constructor={*:options,constructor_argument_mode:true};
let legacy_preload=profile.preload_kernel(kernel,options,100000)^;
let constructor_preload=profile.preload_kernel(kernel,constructor,100000)^;
let sources = ["\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen0\\f\\relaxX", "\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen-1\\f\\relaxX", "\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen9\\f\\relaxX", "\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen0\\f=7sp\\relaxX", "\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen-1\\f=7sp\\relaxX", "\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen9\\f=7sp\\relaxX", "\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\fontdimen8\\f=7sp\\relax\\the\\fontdimen8\\f\\relaxX", "\\font\\f=cmr10 at 1sp \\relax\\fontdimen8\\f=5sp\\relax\\font\\g=cmr10 at 2sp \\relax\\the\\fontdimen65536\\f\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\the\\fontdimen0\\f\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\the\\fontdimen-1\\f\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\the\\fontdimen9\\f\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\fontdimen0\\f=7sp\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\fontdimen-1\\f=7sp\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\fontdimen9\\f=7sp\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\fontdimen8\\f=7sp\\relax\\the\\fontdimen8\\f\\relaxX", "\\font\\f=cmr10 at 10pt \\relax\\font\\g=cmr10 at 12pt \\relax\\the\\fontdimen65536\\f\\relaxX", "\\the\\fontdimen0\\nullfont\\relax X", "\\the\\fontdimen8\\nullfont\\relax X", "\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\n\\the\\fontdimen8\\f\\relax X", "\\font\\f=cmr10 at 1sp \\relax\\font\\g=cmr10 at 2sp \\relax\\let\\alias\\f\\the\\fontdimen8\\alias\\relax X"];
// The expected text and diagnostics were captured with the native TeX engine.
[for (entry in [{options:options,preload:legacy_preload},{options:constructor,preload:constructor_preload}])
  [for (source in sources) (let r=profile.expand_with_kernel(source,kernel,entry.options,100000,entry.preload)^,
    {text:reconstruct.reconstruct(r)^.text,messages:r.messages,diagnostics:r.diagnostic_records,issue:r.issue})]]
