let matrix = [[-1.2,2.8,0.0],[3.5,-4.1,5.2]]
shape(abs(matrix)) == [2,3]
shape(round(matrix)) == [2,3]
shape(floor(matrix)) == [2,3]
shape(ceil(matrix)) == [2,3]
flatten(abs(transpose(matrix))) == [1.2,3.5,2.8,4.1,0.0,5.2]
shape(abs(transpose(matrix))) == [3,2]
flatten(round(matrix)) == [-1.0,3.0,0.0,4.0,-4.0,5.0]
shape(abs(reshape(matrix,[1,2,3]))) == [1,2,3]
