import ui: lambda.ui.blade

[
    ["unknown shared property",(ui.button({missing:true}) or null) == null],
    ["shared props require map",(ui.input("bad") or null) == null],
    ["shared enums validated",(ui.button({variant:'unknown'}) or null) == null],
    ["controlled null owns value",(ui.input({value:null,default_value:"x"}) or null) == null],
    ["checked false owns value",(ui.checkbox({checked:false,default_checked:true}) or null) == null],
    ["typed select uniqueness",(ui.select({options:[{value:1,label:"A"},{value:"1",label:"B"}]}) or null) == null],
    ["shared collection id",(ui.tabs({items:[{key:1,label:"One"}]}) or null) == null],
    ["panel material validated",(ui.panel({material:'plastic'}) or null) == null],
    ["RPG props require map",(ui.meter("bad") or null) == null],
    ["RPG unknown property",(ui.item_slot({missing:true}) or null) == null],
    ["RPG unknown icon",(ui.rpg_icon({name:'missing'}) or null) == null],
    ["RPG icon requires name",(ui.rpg_icon() or null) == null],
    ["ability requires icon",(ui.ability() or null) == null],
    ["meter resource validated",(ui.meter({resource:'unknown'}) or null) == null],
    ["meter positive maximum",all([for (v in [0,-1,nan,inf]) (ui.meter({max:v}) or null) == null])],
    ["meter finite bounded value",all([for (v in [-1,101,nan,inf]) (ui.meter({value:v}) or null) == null])],
    ["meter show value bool",(ui.meter({show_value:1}) or null) == null],
    ["slot rarity validated",(ui.item_slot({rarity:'mythic'}) or null) == null],
    ["slot selected bool",(ui.item_slot({selected:1}) or null) == null],
    ["slot positive integer quantity",all([for (v in [0,-1,1.5]) (ui.item_slot({quantity:v}) or null) == null])],
    ["slot finite positive size",all([for (v in [0,-1,inf]) (ui.item_slot({size:v}) or null) == null])],
    ["ability cooldown range",all([for (v in [-1,101,nan]) (ui.ability({icon:'fire',cooldown:v}) or null) == null])],
    ["ability hotkey text",(ui.ability({icon:'fire',hotkey:1}) or null) == null],
    ["leaf children rejected",(ui.render(<blade.meter "bad">) or null) == null],
    ["direct RPG props validated",(ui.render(<blade.item_slot rarity:'missing'>) or null) == null],
    ["array errors propagate",(ui.render([<blade.button missing:true>]) or null) == null],
    ["page child errors propagate",(ui.page(<blade.meter max:0>) or null) == null],
    ["nested slot errors propagate",(ui.render(<blade.tabs id:"tabs",items:[{key:1,label:"One",children:<blade.input type:'bad'>}]>) or null) == null],
    ["panel child errors propagate",(ui.render(<blade.panel <blade.meter max:0>>) or null) == null],
    ["RPG errors in shared slots propagate",(ui.render(<blade.tabs id:"rpg-tabs",items:[{key:1,label:"One",children:<blade.ability icon:'missing'>}]>) or null) == null],
    ["provider RPG errors propagate",(ui.render(<blade.config_provider <blade.item_slot rarity:'missing'>>) or null) == null],
    ["unknown nested tags rejected",(ui.render(<blade.panel <blade.missing>>) or null) == null],
    ["unknown tags rejected",(ui.render(<blade.missing>) or null) == null],
    ["page options validated",(ui.page("x",{missing:true}) or null) == null],
    ["provider disabled bool",(ui.config_provider({disabled:1}) or null) == null],
    ["provider direction validated",(ui.config_provider({direction:'up'}) or null) == null],
    ["shared diagnostics use Blade family",(ui.button({missing:true}) ^ {starts_with(^.message,"blade: button:")}) == true],
    ["RPG diagnostics use Blade family",(ui.meter({max:0}) ^ {starts_with(^.message,"blade: meter:")}) == true]
]
