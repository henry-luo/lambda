{
  "name": "SVG image mutation and recording resource ownership",
  "html": "test/ui/svg_image_mutation.html",
  "viewport": {
    "width": 500,
    "height": 240
  },
  "events": [
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 80,
      "y": 80,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_hit_test",
      "x": 20,
      "y": 20,
      "expected_selector": "#dynamic"
    },
    {
      "type": "click",
      "target": {
        "selector": "#dynamic"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#scene"
      },
      "attribute": "data-image-click",
      "equals": "yes"
    },
    {
      "type": "click",
      "target": {
        "selector": "#resize"
      }
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 120,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 70,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_hit_test",
      "x": 120,
      "y": 20,
      "expected_selector": "#dynamic"
    },
    {
      "type": "click",
      "target": {
        "selector": "#replace"
      }
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 80,
      "y": 80,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_hit_test",
      "x": 80,
      "y": 80,
      "expected_selector": "#dynamic"
    },
    {
      "type": "click",
      "target": {
        "selector": "#remove"
      }
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 80,
      "y": 80,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#restore"
      }
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 80,
      "y": 80,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_hit_test",
      "x": 80,
      "y": 80,
      "expected_selector": "#dynamic"
    }
  ]
}
