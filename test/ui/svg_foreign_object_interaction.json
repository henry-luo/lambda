      "type": "click",
      "x": 50,
      "y": 45
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#scene"
      },
      "attribute": "data-last",
      "equals": "embedded-button"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#scene"
      },
      "attribute": "data-client",
      "equals": "50,45"
    },
