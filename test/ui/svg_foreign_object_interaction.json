{
  "name": "SVG foreignObject uses transformed HTML hit targets, focus, wheel, clipping and live mutation",
  "html": "test/ui/svg_foreign_object_interaction.html",
  "viewport": {
    "width": 500,
    "height": 380
  },
  "events": [
    {
      "type": "assert_pixel",
      "x": 50,
      "y": 45,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_hit_test",
      "x": 50,
      "y": 45,
      "expected_selector": "#embedded-button"
    },
