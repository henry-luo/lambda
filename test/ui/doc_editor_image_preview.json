{
  "name": "Doc editor previews raster images and SVG",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "sample1.jpg"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_sample1_jpg .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#image-preview img"}, "count": 1},
    {"type": "assert_rect", "target": {"selector": "#image-preview img"}, "width": 640, "height": 427, "tolerance": 2},
    {"type": "assert_count", "target": {"selector": ".tab-source"}, "count": 0},
    {"type": "click", "target": {"selector": ".tree-filter-clear"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "svg_img_shapes.svg"},
    {"type": "click", "target": {"selector": ".tree-hit-__test_ui .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_ui_svg_img_shapes_svg .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#image-preview img"}, "count": 1},
    {"type": "assert_rect", "target": {"selector": "#image-preview img"}, "width": 120, "height": 60, "tolerance": 2},
    {"type": "assert_count", "target": {"selector": ".tab-source"}, "count": 1},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "<svg"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_count", "target": {"selector": "#image-preview img"}, "count": 1}
  ]
}
