{
  "name":"DBench reviews and executes an explicit SQLite write",
  "html": "temp/dbench-prepared/write/dbench/dbench.ls",
  "prepare": ["python3", "test/demo/dbench/tests/_prepare_ui.py", "write"],
  "viewport":{"width":1280,"height":800},
  "input_turn_ms":0,
  "events":[
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"type","target":{"selector":"#target"},"text":"temp/dbench-write-ui.sqlite","clear":true},
    {"type":"click","target":{"selector":"#connect"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"items"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"type","target":{"selector":"#sql"},"text":"WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<1000) SELECT x FROM n","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"type","target":{"selector":"#sql"},"text":"INSERT INTO items VALUES (?1,?2); SELECT 9","clear":true},
    {"type":"type","target":{"selector":"#sql-params"},"text":"[1,\"O'Reilly\"]","clear":true},
    {"type":"script","js":"let e=document.getElementById('sql');e.focus();e.setSelectionRange(0,e.value.indexOf(';'))"},
    {"type":"click","target":{"selector":"#write-review"}},
    {"type":"assert_text","target":{"selector":".write-review"},"contains":"temp/dbench-write-ui.sqlite"},
    {"type":"assert_text","target":{"selector":"#write-statement"},"contains":"INSERT INTO items"},
    {"type":"assert_script","js":"!document.getElementById('write-statement').textContent.includes('SELECT 9')"},
    {"type":"assert_text","target":{"selector":"#write-parameters"},"contains":"O'Reilly"},
    {"type":"click","target":{"selector":"#write-cancel"}},
    {"type":"assert_count","target":{"selector":".write-review"},"equals":0},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"script","js":"let e=document.getElementById('sql');e.focus();e.setSelectionRange(0,e.value.indexOf(';'))"},
    {"type":"click","target":{"selector":"#write-review"}},
    {"type":"click","target":{"selector":"#write-confirm"}},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"O'Reilly"},
    {"type":"type","target":{"selector":"#sql"},"text":"UPDATE items SET value='bad'; DROP TABLE items","clear":true},
    {"type":"type","target":{"selector":"#sql-params"},"text":"[]","clear":true},
    {"type":"click","target":{"selector":"#write-review"}},
    {"type":"click","target":{"selector":"#write-confirm"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"SQL write failed"},
    {"type":"click","target":{"selector":"#write-cancel"}},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"O'Reilly"},
    {"type":"type","target":{"selector":"#sql"},"text":"CREATE TABLE added (id INTEGER PRIMARY KEY)","clear":true},
    {"type":"click","target":{"selector":"#write-review"}},
    {"type":"click","target":{"selector":"#write-confirm"}},
    {"type":"assert_count","target":{"selector":"[data-table=added]"},"equals":1},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"items"}
  ]
}
