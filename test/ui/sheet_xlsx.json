{
  "name": "Sheet opens an XLSX workbook and preserves the original",
  "html": "test/demo/sheet/sheet.ls",
  "viewport": {"width": 1440, "height": 900},
  "input_turn_ms": 0,
  "events": [
    {"type":"wait", "ms":100},
    {"type":"click", "target":{"selector":"#open"}},
    {"type":"type", "target":{"selector":"#file-path"}, "text":"test/input/xlsx/basic.xlsx", "clear":true},
    {"type":"click", "target":{"selector":"#dialog-confirm"}},
    {"type":"assert_attribute", "target":{"selector":"#sheet"}, "attribute":"data-sheets", "equals":"2"},
    {"type":"assert_text", "target":{"selector":"#cell-A1"}, "contains":"Product"},
    {"type":"assert_text", "target":{"selector":"#cell-C1"}, "contains":"00123"},
    {"type":"assert_text", "target":{"selector":"#cell-B2"}, "contains":"12.5"},
    {"type":"assert_text", "target":{"selector":"#cell-D2"}, "contains":"14.5"},
    {"type":"assert_text", "target":{"selector":"#cell-E2"}, "contains":"42"},
    {"type":"assert_text", "target":{"selector":"#cell-F2"}, "contains":"2024-01-01"},
    {"type":"click", "target":{"selector":"#sheet-tab-1"}},
    {"type":"assert_text", "target":{"selector":"#cell-A1"}, "contains":"Second worksheet"},
    {"type":"click", "target":{"selector":"#save"}},
    {"type":"assert_script", "js":"document.getElementById('file-path').value==='workbook.sheet.json'"},
    {"type":"type", "target":{"selector":"#file-path"}, "text":"test/input/xlsx/basic.xlsx", "clear":true},
    {"type":"click", "target":{"selector":"#dialog-confirm"}},
    {"type":"assert_text", "target":{"selector":"#status"}, "contains":"XLSX export is not supported"}
  ]
}
