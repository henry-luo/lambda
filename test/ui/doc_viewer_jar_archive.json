{
  "name": "View JAR as a directory and read manifest, classes and resources",
  "html": "test/input/zip/sample.jar",
  "viewport": {
    "width": 1280,
    "height": 1000
  },
  "events": [
    {
      "type": "assert_text",
      "target": {
        "selector": ".project-root .tree-label"
      },
      "equals": "sample.jar"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/META-INF'] > .tree-row .tree-label"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/META-INF'] > .tree-row .tree-label"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/META-INF/MANIFEST.MF'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".document-name"
      },
      "equals": "MANIFEST.MF"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#source-preview"
      },
      "contains": "Main-Class: example.Hello"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/example'] > .tree-row .tree-label"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/example/Hello.class'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".document-name"
      },
      "equals": "Hello.class"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#source-preview"
      },
      "contains": "CAFEBABE"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/resources'] > .tree-row .tree-label"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/resources/message.txt'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#source-preview"
      },
      "equals": "Hello from JAR!\n"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/resources/opaque.bin'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#source-preview"
      },
      "contains": "00FF504B00"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/config'] > .tree-row .tree-label"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/config/settings.json'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".property-entry[data-property-name='answer'] .property-value"
      },
      "equals": "42"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tab-source"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#source-preview"
      },
      "contains": "\"answer\":42"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/META-INF'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/META-INF/MANIFEST.MF'] > .tree-row .tree-label"
      },
      "count": 0
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/META-INF'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".tree-entry[data-tree-path$='sample.jar/META-INF/MANIFEST.MF'] > .tree-row .tree-label"
      },
      "count": 1
    }
  ]
}
