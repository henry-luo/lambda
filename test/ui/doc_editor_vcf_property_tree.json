{
  "name": "Document editor inspects vCard contacts and repeated fields",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1600},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "contacts.vcf"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_contacts_vcf .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#property-preview"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='VCARD']"}, "count": 2},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='VCARD'] > .property-row .property-value", "index": 0}, "equals": "Jane Smith"},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='VCARD'] > .property-row .property-value", "index": 1}, "equals": "Bob Johnson"},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='VCARD'] > .property-row .property-toggle", "index": 0}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='EMAIL']"}, "count": 2},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='EMAIL'] > .property-row .property-value", "index": 0}, "equals": "jane.smith@company.org"},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='TEL']"}, "count": 3},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='EMAIL'] > .property-row .property-toggle", "index": 0}},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='EMAIL'] .property-entry[data-property-name='parameters'] > .property-row .property-toggle"}},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='EMAIL'] .property-entry[data-property-name='type'] > .property-row .property-value"}, "equals": "work"},
    {"type": "click", "target": {"selector": "#property-filter"}},
    {"type": "type", "target": {"selector": "#property-filter"}, "text": "tel"},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='VCARD']"}, "count": 2},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='TEL']"}, "count": 4},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='EMAIL']"}, "count": 0},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_count", "target": {"selector": "#source-preview"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-filter-clear"}},
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "simple.vcf"},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_simple_vcf .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='VCARD']"}, "count": 1},
    {"type": "assert_attribute", "target": {"selector": ".property-entry[data-property-name='VCARD'] > .property-row .property-toggle"}, "attribute": "aria-expanded", "equals": "true"},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='FN'] > .property-row .property-value"}, "equals": "John Doe"},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='VCARD'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='FN']"}, "count": 0},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='VCARD'] > .property-row .property-toggle"}},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='FN'] > .property-row .property-value"}, "equals": "John Doe"}
  ]
}
