{
  "name": "drag selection paints before release and extends past the virtual viewport while the pointer is held",
  "command": "edit",
  "html": "temp/edit-ui/source_drag_select.txt",
  "prepare": ["python3", "test/ui/edit/gen_large_source.py", "temp/edit-ui/source_drag_select.txt", "300"],
  "viewport": {"width": 850, "height": 400},
  "events": [
    {"type": "mouse_move", "target": {"text": "line 000002"}},
    {"type": "mouse_down", "target": {"text": "line 000002"}, "button": 0},
    {"type": "assert_pixel", "x": 100, "y": 73, "min_r": 230, "force_render": true},
    {"type": "mouse_move", "x": 350, "y": 78},
    {"type": "assert_selection", "is_collapsed": false, "check_dom": true},
    {"type": "assert_pixel", "x": 100, "y": 73, "max_r": 170, "min_b": 210},
    {"type": "mouse_move", "x": 350, "y": 405},
    {"type": "advance_time", "ms": 480, "steps": 30},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "not_contains": "line 000002"},
    {"type": "assert_selection", "is_collapsed": false, "check_dom": true},
    {"type": "mouse_up", "x": 350, "y": 405, "button": 0},
    {"type": "advance_time", "ms": 480, "steps": 30},
    {"type": "type", "text": "X"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 2, Col 2"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/source_drag_select.txt", "contains": "lazy dog\nX"},
    {"type": "assert_file", "path": "temp/edit-ui/source_drag_select.txt", "not_contains": "line 000015:"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "ArrowDown", "mods_str": "super"},
    {"type": "mouse_down", "target": {"text": "line 000300"}, "button": 0},
    {"type": "mouse_move", "x": 135, "y": 28},
    {"type": "advance_time", "ms": 530, "steps": 33},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "not_contains": "line 000300:"},
    {"type": "assert_selection", "is_collapsed": false, "check_dom": true},
    {"type": "mouse_up", "x": 135, "y": 28, "button": 0},
    {"type": "type", "text": "Y"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/source_drag_select.txt", "not_contains": "line 000299:"},
    {"type": "assert_file", "path": "temp/edit-ui/source_drag_select.txt", "contains": "Yline 000300:"}
  ]
}
