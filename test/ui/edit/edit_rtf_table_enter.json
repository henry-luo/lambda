{
  "name": "Enter within an RTF table cell stays in the cell",
  "command": "edit",
  "html": "test/fixtures/edit/table.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_table_enter.rtf",
  "events": [
    {"type": "click", "target": {"text": "Alpha"}},
    {"type": "key_press", "key": "End"},
    {"type": "key_press", "key": "Enter"},
    {"type": "type", "text": "More"},
    {"type": "assert_count", "target": {"selector": "#edit-surface table td"}, "count": 4},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_table_enter.rtf", "contains": "Alpha\\line More"},
    {"type": "key_combo", "key": "/", "mods_str": "super"},
    {"type": "key_combo", "key": "/", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": "#edit-surface table td"}, "count": 4}
  ]
}
