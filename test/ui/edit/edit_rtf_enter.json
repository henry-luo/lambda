{
  "name": "create a blank paragraph in rich RTF with Enter",
  "command": "edit",
  "html": "test/ui/edit/sample-plain.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_enter.rtf",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type": "click", "target": {"text": "Alpha"}},
    {"type": "key_press", "key": "End"},
    {"type": "key_press", "key": "Enter"},
    {"type": "key_press", "key": "Enter"},
    {"type": "type", "text": "Tail"},
    {"type": "assert_count", "target": {"selector": "#edit-surface p"}, "count": 3},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_enter.rtf", "contains": "\\par \\par Tail"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""}
  ]
}
