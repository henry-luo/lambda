{
  "name": "src Save As accepts Enter and Cmd+S without saving the original",
  "command": "edit",
  "html": "test/ui/edit/sample.txt",
  "working_copy": "temp/edit-ui/edit_src_save_as_keyboard.txt",
  "events": [
    {"type": "write_file", "path": "temp/edit-ui/edit_src_save_as_keyboard_copy.txt", "content": "old copy\n"},
    {"type": "click", "target": {"text": "second line"}},
    {"type": "type", "text": "COPYKEY"},
    {"type": "key_combo", "key": "s", "mods_str": "super+shift"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-save_as"}, "count": 1},
    {"type": "assert_focus", "target": {"selector": "#edit-dialog-path"}},
    {"type": "type", "text": "edit_src_save_as_keyboard_copy.txt", "clear": true},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-exists"}, "count": 1},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard_copy.txt", "equals": "old copy\n"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard.txt", "not_contains": "COPYKEY"},
    {"type": "key_combo", "key": "s", "mods_str": "ctrl"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-exists"}, "count": 1},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard_copy.txt", "equals": "old copy\n"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard.txt", "not_contains": "COPYKEY"},
    {"type": "key_press", "key": "Escape"},
    {"type": "key_combo", "key": "s", "mods_str": "super+shift"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-save_as"}, "count": 1},
    {"type": "assert_focus", "target": {"selector": "#edit-dialog-path"}},
    {"type": "type", "text": "edit_src_save_as_keyboard_copy.txt", "clear": true},
    {"type": "key_press", "key": "Tab"},
    {"type": "key_press", "key": "Tab"},
    {"type": "key_press", "key": "Tab"},
    {"type": "assert_focus", "target": {"selector": "#edit-dialog-path"}},
    {"type": "key_combo", "key": "Tab", "mods_str": "shift"},
    {"type": "assert_focus", "target": {"selector": ".edit-dialog-save_as_ok"}},
    {"type": "key_press", "key": "Tab"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-exists"}, "count": 1},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard.txt", "not_contains": "COPYKEY"},
    {"type": "assert_focus", "target": {"selector": ".edit-dialog-cancel"}},
    {"type": "key_press", "key": "Tab"},
    {"type": "assert_focus", "target": {"selector": ".edit-dialog-overwrite"}},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard_copy.txt", "contains": "COPYKEY"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard.txt", "not_contains": "COPYKEY"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog"}, "count": 0},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": "*"},
    {"type": "window_close"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-close"}, "count": 1},
    {"type": "assert_focus", "target": {"selector": ".edit-dialog-cancel"}},
    {"type": "key_combo", "key": "s", "mods_str": "ctrl"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard_copy.txt", "contains": "COPYKEY"},
    {"type": "key_press", "key": "Tab"},
    {"type": "key_press", "key": "Tab"},
    {"type": "assert_focus", "target": {"selector": ".edit-dialog-save"}},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_window_closed", "closed": true},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_save_as_keyboard_copy.txt", "not_contains": "COPYKEY"}
  ]
}
