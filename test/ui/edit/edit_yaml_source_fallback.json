{
  "name": "invalid YAML remains editable as source without changing other lines",
  "command": "edit",
  "html": "test/fixtures/edit/source-fallback.yaml",
  "working_copy": "temp/edit-ui/edit_yaml_source_fallback.yaml",
  "events": [
    {"type": "assert_count", "target": {"selector": ".src-text"}, "count": 1},
    {"type": "click", "target": {"text": "one"}},
    {"type": "key_press", "key": "End"},
    {"type": "type_physical", "text": " more"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_yaml_source_fallback.yaml", "equals": "# Keep comments and invalid source available for repair.\nname: \"bad\\q\"\nitems:\n  - one more\n"}
  ]
}
