{
  "name": "INI edits retain comment characters and reject truncated values",
  "command": "edit",
  "html": "test/fixtures/edit/sample.ini",
  "working_copy": "temp/edit-ui/edit_ini_value_preservation.ini",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type": "click", "target": {"selector": "input[aria-label='port']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "abc;def"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".property-status"}, "contains": "value would be changed"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_ini_value_preservation.ini", "contains": "port=42 # port comment"},
    {"type": "click", "target": {"selector": "input[aria-label='port']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "\"abc;def\""},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_ini_value_preservation.ini", "contains": "port=\"abc;def\" # port comment"}
  ]
}
