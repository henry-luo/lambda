{
  "name": "Save As resolves a name against the document's folder, refuses unusable targets, and continues the session on the copy",
  "command": "edit",
  "html": "test/ui/edit/sample.md",
  "working_copy": "temp/edit-ui/edit_md_save_as.md",
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "write_file", "path": "temp/edit-ui/edit_md_save_as_copy.md", "content": "old copy\n"},
    {"type": "click", "target": {"text": "short paragraph"}},
    {"type": "type", "text": "COPY"},
    {"type": "key_combo", "key": "s", "mods_str": "super+shift"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-save_as"}, "count": 1},
    {"type": "click", "target": {"selector": "#edit-dialog-path"}},
    {"type": "type", "text": "missing-folder/copy.md", "clear": true},
    {"type": "click", "target": {"selector": ".edit-dialog-save_as_ok"}},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-save_as"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "missing-folder does not exist"},
    {"type": "assert_file", "path": "temp/edit-ui/missing-folder", "exists": false},
    {"type": "click", "target": {"selector": "#edit-dialog-path"}},
    {"type": "type", "text": "edit_md_save_as_copy.txt", "clear": true},
    {"type": "click", "target": {"selector": ".edit-dialog-save_as_ok"}},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "is not a Markdown file name"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_save_as_copy.txt", "exists": false},
    {"type": "click", "target": {"selector": "#edit-dialog-path"}},
    {"type": "type", "text": "edit_md_save_as_copy.md", "clear": true},
    {"type": "click", "target": {"selector": ".edit-dialog-save_as_ok"}},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-exists"}, "count": 1},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_save_as_copy.md", "equals": "old copy\n"},
    {"type": "click", "target": {"selector": ".edit-dialog-overwrite"}},
    {"type": "assert_count", "target": {"selector": ".edit-dialog"}, "count": 0},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_save_as_copy.md", "contains": "COPY"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_save_as_copy.md", "contains": "title: Edit mode sample"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_save_as.md", "not_contains": "COPY"},
    {"type": "assert_text", "target": {"selector": ".edit-name"}, "equals": "edit_md_save_as_copy.md"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""},
    {"type": "type", "text": "2"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_save_as_copy.md", "contains": "COPY2"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_save_as.md", "not_contains": "COPY"}
  ]
}
