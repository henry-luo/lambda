{
  "name": "insert and remove TSV columns across every row",
  "command": "edit",
  "html": "test/fixtures/edit/sample.tsv",
  "working_copy": "temp/edit-ui/edit_tsv_columns.tsv",
  "events": [
    {"type": "click", "target": {"selector": "#grid-cell-0-0"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "Title"},
    {"type": "click", "target": {"selector": "button[title='Add column']"}},
    {"type": "click", "target": {"selector": "#grid-cell-1-2"}},
    {"type": "type", "text": "new"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_tsv_columns.tsv", "equals": "Title\tNotes\t\nAlice\tPlain\tnew\n"},
    {"type": "click", "target": {"selector": "button[title='Remove column 2']"}},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_tsv_columns.tsv", "equals": "Title\t\nAlice\tnew\n"}
  ]
}
