{
  "name": "rendered math and scrolled paragraph positions survive toolbar refresh, typing and history",
  "command": "edit",
  "html": "test/ui/edit/math.md",
  "working_copy": "temp/edit-ui/edit_md_math_scroll.md",
  "viewport": {"width": 1000, "height": 600},
  "events": [
    {"type": "scroll_to", "y": 200},
    {"type": "assert_count", "target": {"selector": "#edit-surface svg.lambda-math"}, "count": 2},
    {"type": "assert_count", "target": {"selector": "#edit-surface .edit-view-source"}, "count": 0},
    {"type": "assert_rect", "target": {"selector": "#edit-surface p svg.lambda-math"}, "width": 5.5, "tolerance": 2},
    {"type": "assert_rect", "target": {"selector": "#edit-surface p", "index": 10}, "y": 351.4, "tolerance": 2},
    {"type": "click", "target": {"text": "Edit this paragraph"}},
    {"type": "assert_scroll", "y": 200, "tolerance": 1},
    {"type": "assert_rect", "target": {"selector": "#edit-surface p", "index": 10}, "y": 351.4, "tolerance": 2},
    {"type": "type", "text": "Added "},
    {"type": "assert_scroll", "y": 200, "tolerance": 1},
    {"type": "assert_rect", "target": {"selector": "#edit-surface p", "index": 10}, "y": 351.4, "tolerance": 2},
    {"type": "assert_count", "target": {"selector": "#edit-surface svg.lambda-math"}, "count": 2},
    {"type": "assert_rect", "target": {"selector": "#edit-surface p svg.lambda-math"}, "width": 5.5, "tolerance": 2},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_scroll", "y": 200, "tolerance": 1},
    {"type": "assert_rect", "target": {"selector": "#edit-surface p svg.lambda-math"}, "y": 324.9, "width": 5.5, "tolerance": 2},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_scroll", "y": 200, "tolerance": 1},
    {"type": "assert_rect", "target": {"selector": "#edit-surface p", "index": 10}, "y": 351.4, "tolerance": 2},
    {"type": "assert_count", "target": {"selector": "#edit-surface svg.lambda-math"}, "count": 2},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_scroll", "y": 200, "tolerance": 1},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_math_scroll.md", "contains": "$\\frac{1}{2}$"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_math_scroll.md", "contains": "$$\n\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}\n$$"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_math_scroll.md", "contains": "Added "}
  ]
}
