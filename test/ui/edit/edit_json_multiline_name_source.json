{
  "name": "edit JSON names with escaped line breaks in the property view",
  "command": "edit",
  "html": "test/fixtures/edit/json-multiline-name.json",
  "working_copy": "temp/edit-ui/edit_json_multiline_name_source.json",
  "events": [
    {"type": "assert_count", "target": {"selector": ".src-text"}, "count": 0},
    {"type": "assert_value", "target": {"selector": "input.property-key[data-key-literal='json']"}, "equals": "\"line\\nbreak\""},
    {"type": "click", "target": {"selector": "input.property-value"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "2"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_json_multiline_name_source.json", "equals": "{\"line\\nbreak\": 2}\n"},
    {"type": "click", "target": {"selector": "input.property-key[data-key-literal='json']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "42"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".property-status"}, "contains": "quoted JSON string"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_json_multiline_name_source.json", "equals": "{\"line\\nbreak\": 2}\n"},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "\"new\\nname\""},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_json_multiline_name_source.json", "equals": "{\"new\\nname\": 2}\n"}
  ]
}
