{
  "name": "Cmd+F finds as you type, Enter and Shift+Enter step through matches with their count, a match far away scrolls into view, and Escape returns to the selected match",
  "command": "edit",
  "html": "temp/edit-ui/find_source.txt",
  "prepare": ["python3", "test/ui/edit/gen_large_source.py", "temp/edit-ui/find_source.txt", "300"],
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "click", "target": {"text": "line 000003"}},
    {"type": "key_press", "key": "Home"},
    {"type": "key_combo", "key": "f", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": ".src-find"}, "count": 1},
    {"type": "assert_focus", "target": {"selector": "#src-find-input"}},
    {"type": "type", "text": "Brown fox"},
    {"type": "assert_text", "target": {"selector": ".src-find-count"}, "equals": "3 of 300"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 3, Col 33"},
    {"type": "assert_count", "target": {"selector": ".src-match"}, "count": 34},
    {"type": "render", "file": "temp/edit-ui/edit_src_find_open.png"},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_text", "target": {"selector": ".src-find-count"}, "equals": "4 of 300"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 4, Col 33"},
    {"type": "key_combo", "key": "Enter", "mods_str": "shift"},
    {"type": "key_combo", "key": "Enter", "mods_str": "shift"},
    {"type": "assert_text", "target": {"selector": ".src-find-count"}, "equals": "2 of 300"},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "zzz"},
    {"type": "assert_text", "target": {"selector": ".src-find-count"}, "equals": "No results"},
    {"type": "assert_count", "target": {"selector": ".src-match"}, "count": 0},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "line 000250"},
    {"type": "assert_text", "target": {"selector": ".src-find-count"}, "equals": "1 of 1"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 250, Col 12"},
    {"type": "assert_text", "target": {"selector": ".src-match"}, "equals": "line 000250"},
    {"type": "key_press", "key": "Escape"},
    {"type": "assert_count", "target": {"selector": ".src-find"}, "count": 0},
    {"type": "assert_focus", "target": {"selector": "#edit-surface"}},
    {"type": "type", "text": "X"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/find_source.txt", "contains": "lazy dog\nX: the quick brown fox"},
    {"type": "render", "file": "temp/edit-ui/edit_src_find.png"}
  ]
}
