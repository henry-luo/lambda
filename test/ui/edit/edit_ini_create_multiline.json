{
  "name": "convert a single-line INI value into a quoted multiline value",
  "command": "edit",
  "html": "test/fixtures/edit/sample.ini",
  "working_copy": "temp/edit-ui/edit_ini_create_multiline.ini",
  "events": [
    {"type": "click", "target": {"selector": "textarea[aria-label='port']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "\"alpha\""},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_count", "target": {"selector": "textarea[aria-label='port']"}, "count": 1},
    {"type": "click", "target": {"selector": "textarea[aria-label='port']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "\"alpha\nbeta\""},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_ini_create_multiline.ini", "contains": "port=\"alpha\nbeta\" # port comment"}
  ]
}
