{
  "name": "Alt+Z soft-wraps long lines with their numbers aligned, the caret at the end of a line taller than the view stays visible, the wheel scrolls by rows inside that line, and Alt+Z unwraps with the text column scrolled sideways to the caret",
  "command": "edit",
  "source": true,
  "html": "test/ui/edit/wrap_sample.txt",
  "working_copy": "temp/edit-ui/edit_src_wrap.txt",
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "click", "target": {"text": "second line"}},
    {"type": "key_combo", "key": "z", "mods_str": "alt"},
    {"type": "assert_count", "target": {"selector": ".src-wrap"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 2"},
    {"type": "assert_rect", "target": {"selector": ".src-num", "index": 4}, "height": 60},
    {"type": "assert_rect", "target": {"selector": ".edit-doc > div", "index": 4}, "height": 60},
    {"type": "render", "file": "temp/edit-ui/edit_src_wrap.png"},
    {"type": "key_combo", "key": "Down", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 9, Col 10"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "Up"},
    {"type": "key_press", "key": "End"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 7, Col 5006"},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "contains": "margin-top: -"},
    {"type": "type", "text": "END"},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "contains": "token0499END"},
    {"type": "render", "file": "temp/edit-ui/edit_src_wrap_end.png"},
    {"type": "scroll", "x": 400, "y": 300, "dx": 0, "dy": 1},
    {"type": "assert_text", "target": {"selector": ".src-num"}, "equals": "7"},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "contains": "margin-top: -"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_wrap.txt", "contains": "token0499END\nafter the long line\n"},
    {"type": "key_combo", "key": "z", "mods_str": "alt"},
    {"type": "assert_count", "target": {"selector": ".src-wrap"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "contains": "margin-left: -"}
  ]
}
