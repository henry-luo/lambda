{
  "name": "add a CSV row with keyboard",
  "command": "edit",
  "html": "test/fixtures/edit/sample.csv",
  "working_copy": "temp/edit-ui/edit_csv_add_keyboard.csv",
  "events": [
    {"type": "assert_count", "target": {"selector": ".property-grid-wrap button"}, "count": 0},
    {"type": "click", "target": {"selector": "#grid-cell-0-1"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "destination"},
    {"type": "key_combo", "key": "F10", "mods_str": "shift"},
    {"type": "assert_focus", "target": {"selector": "#property-grid-menu [aria-label='Add row']"}},
    {"type": "key_press", "key": "End"},
    {"type": "assert_focus", "target": {"selector": "#property-grid-menu [aria-label='Remove field']"}},
    {"type": "key_press", "key": "Escape"},
    {"type": "assert_count", "target": {"selector": "#property-grid-menu"}, "count": 0},
    {"type": "assert_focus", "target": {"selector": "#grid-cell-0-1"}},
    {"type": "key_combo", "key": "F10", "mods_str": "shift"},
    {"type": "key_press", "key": "Enter"},
    {"type": "type", "text": "Cara,Rome"},
    {"type": "assert_value", "target": {"selector": "#property-new-value"}, "equals": "Cara,Rome"},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-add-property"}, "count": 0},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_csv_add_keyboard.csv", "contains": "name,destination\n"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_csv_add_keyboard.csv", "contains": "Cara,Rome\n"}
  ]
}
