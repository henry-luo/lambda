{
  "name": "valid UTF-8 source preserves NUL in editing, history, clipboard, save and reload",
  "command": "edit",
  "html": "temp/edit-ui/edit_src_nul.pdf",
  "prepare": ["python3", "-c", "from pathlib import Path; p=Path('temp/edit-ui/edit_src_nul.pdf'); p.parent.mkdir(parents=True,exist_ok=True); p.write_bytes(b'A\\0B\\r\\n\\0Z\\r\\n')"],
  "events": [
    {"type": "assert_text", "target": {"selector": ".src-text .edit-doc > div:first-child"}, "equals": "A\u0000B"},
    {"type": "click", "target": {"selector": ".src-text .edit-doc > div:first-child"}},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Saved edit_src_nul.pdf"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_nul.pdf", "equals": "A\u0000B\r\n\u0000Z\r\n"},
    {"type": "click", "target": {"selector": ".src-text .edit-doc > div:first-child"}},
    {"type": "key_press", "key": "End"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 1, Col 4"},
    {"type": "type_physical", "text": "x"},
    {"type": "key_press", "key": "Home"},
    {"type": "key_press", "key": "ArrowRight"},
    {"type": "key_press", "key": "ArrowRight"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 1, Col 3"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "assert_text", "target": {"selector": ".src-text .edit-doc > div:first-child"}, "equals": "ABx"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".src-text .edit-doc > div:first-child"}, "equals": "A\u0000Bx"},
    {"type": "key_combo", "key": "z", "mods_str": "super shift"},
    {"type": "assert_text", "target": {"selector": ".src-text .edit-doc > div:first-child"}, "equals": "ABx"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "click", "target": {"selector": ".src-text .edit-doc > div:nth-child(2)"}},
    {"type": "key_press", "key": "Home"},
    {"type": "key_combo", "key": "End", "mods_str": "shift"},
    {"type": "key_combo", "key": "x", "mods_str": "super"},
    {"type": "assert_clipboard", "equals": "\u0000Z"},
    {"type": "key_combo", "key": "v", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_nul.pdf", "equals": "A\u0000Bx\r\n\u0000Z\r\n"},
    {"type": "type_physical", "text": "y"},
    {"type": "write_file", "path": "temp/edit-ui/edit_src_nul.pdf", "content": "%PDF-1.7\u0000é\r\n"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-changed"}, "count": 1},
    {"type": "click", "target": {"selector": ".edit-dialog-reload"}},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-changed"}, "count": 0},
    {"type": "assert_text", "target": {"selector": ".src-text .edit-doc > div:first-child"}, "equals": "%PDF-1.7\u0000é"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_nul.pdf", "equals": "%PDF-1.7\u0000é\r\n"}
  ]
}
