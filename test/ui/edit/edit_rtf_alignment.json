{
  "name": "edit RTF while preserving paragraph alignment",
  "command": "edit",
  "html": "test/ui/edit/sample-alignment.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_alignment.rtf",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 0}, "attribute": "style", "contains": "text-align: center"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 1}, "attribute": "style", "contains": "text-align: right"},
    {"type": "click", "target": {"selector": ".edit-surface p", "index": 0}},
    {"type": "key_press", "key": "End"},
    {"type": "type", "text": " edited"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_alignment.rtf", "contains": "\\pard\\qc Center edited"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_alignment.rtf", "contains": "\\pard\\qr Right"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""}
  ]
}
