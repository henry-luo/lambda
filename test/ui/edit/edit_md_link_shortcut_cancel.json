    {"type": "type", "text": "replacement"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_link_shortcut_cancel.md", "contains": "replacement"}
  ]
}
