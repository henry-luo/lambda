{
  "name": "creating a list retains the typing caret",
  "command": "edit",
  "html": "test/ui/edit/sample-heading.html",
  "working_copy": "temp/edit-ui/edit_html_list_create_caret.html",
  "events": [
    {"type": "click", "target": {"text": "Plain heading text"}},
    {"type": "key_press", "key": "End"},
    {"type": "key_combo", "key": "8", "mods_str": "ctrl+shift"},
    {"type": "type", "text": "!"},
    {"type": "assert_text", "target": {"selector": "#edit-surface ul li"}, "equals": "Plain heading text!"},
    {"type": "key_combo", "key": "s", "mods_str": "ctrl"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_html_list_create_caret.html", "contains": "Plain heading text!"}
  ]
}
