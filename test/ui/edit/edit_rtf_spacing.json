{
  "name": "edit RTF while preserving paragraph spacing",
  "command": "edit",
  "html": "test/fixtures/edit/paragraph-spacing.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_spacing.rtf",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 0}, "attribute": "style", "contains": "margin-top: 20"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 0}, "attribute": "style", "contains": "margin-bottom: 10"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 1}, "attribute": "style", "contains": "margin-top: 20"},
    {"type": "click", "target": {"selector": ".edit-surface p", "index": 0}},
    {"type": "key_press", "key": "End"},
    {"type": "type", "text": " edited"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_spacing.rtf", "contains": "\\sb300\\sa150 First edited"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_spacing.rtf", "contains": "\\pard Plain"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""}
  ]
}
