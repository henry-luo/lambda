{
  "name": "Tab over selected lines indents them, Shift+Tab dedents, each is one undo step, and the selection keeps its text",
  "command": "edit",
  "source": true,
  "html": "test/ui/edit/sample.txt",
  "working_copy": "temp/edit-ui/edit_src_indent.txt",
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "click", "target": {"text": "second line"}},
    {"type": "key_press", "key": "Home"},
    {"type": "key_combo", "key": "Down", "mods_str": "shift"},
    {"type": "key_combo", "key": "Down", "mods_str": "shift"},
    {"type": "key_combo", "key": "Down", "mods_str": "shift"},
    {"type": "key_press", "key": "Tab"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 5, Col 1"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_indent.txt", "contains": "Source editor sample\n  second line\n      indented line\n  fourth line with some words in it\n\nsixth"},
    {"type": "key_combo", "key": "Tab", "mods_str": "shift"},
    {"type": "key_combo", "key": "Tab", "mods_str": "shift"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_indent.txt", "contains": "Source editor sample\nsecond line\n  indented line\nfourth line with some words in it\n\nsixth"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_indent.txt", "contains": "Source editor sample\nsecond line\n    indented line\nfourth line"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_indent.txt", "contains": "Source editor sample\nsecond line\n    indented line\nfourth line with"},
    {"type": "assert_focus", "target": {"selector": "#edit-surface"}},
    {"type": "click", "target": {"text": "seventh"}},
    {"type": "key_combo", "key": "Tab", "mods_str": "shift"},
    {"type": "assert_focus", "target": {"selector": "#edit-surface"}},
    {"type": "type", "text": "Z"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_indent.txt", "contains": "Z"}
  ]
}
