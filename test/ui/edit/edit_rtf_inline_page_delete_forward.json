{
  "name": "forward delete and undo an inline RTF page break",
  "command": "edit",
  "html": "test/fixtures/edit/inline-page-break.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_inline_page_delete_forward.rtf",
  "events": [
    {"type": "click", "target": {"selector": ".edit-surface p", "offset_x": 5, "offset_y": 8}},
    {"type": "key_press", "key": "End"},
    {"type": "key_press", "key": "Delete"},
    {"type": "assert_count", "target": {"selector": ".edit-surface .edit-rtf-page-break"}, "count": 0},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": ".edit-surface .edit-rtf-page-break"}, "count": 1},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_inline_page_delete_forward.rtf", "contains": "First\\page Second"}
  ]
}
