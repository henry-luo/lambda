{
  "name": "source editing keys: Enter keeps indentation, Backspace joins lines, a shift selection is replaced, Tab indents, undo and redo",
  "command": "edit",
  "html": "test/ui/edit/sample.txt",
  "working_copy": "temp/edit-ui/edit_src_keys.txt",
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "click", "target": {"text": "indented line"}},
    {"type": "key_press", "key": "End"},
    {"type": "key_press", "key": "Enter"},
    {"type": "type", "text": "next"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 4, Col 9"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_keys.txt", "contains": "    indented line\n    next\nfourth line"},
    {"type": "key_press", "key": "Home"},
    {"type": "key_press", "key": "Home"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 3, Col 18"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_keys.txt", "contains": "    indented line    next\nfourth line"},
    {"type": "key_press", "key": "ArrowDown"},
    {"type": "key_press", "key": "Home"},
    {"type": "key_combo", "key": "ArrowRight", "mods_str": "shift+alt"},
    {"type": "type", "text": "FIFTH"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_keys.txt", "contains": "\nFIFTH line with some words"},
    {"type": "key_press", "key": "Home"},
    {"type": "key_press", "key": "Tab"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_keys.txt", "contains": "\n  FIFTH line"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_keys.txt", "contains": "\nfourth line with some words"},
    {"type": "key_combo", "key": "z", "mods_str": "super+shift"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_keys.txt", "contains": "\nFIFTH line with some words"},
    {"type": "assert_class", "target": {"selector": ".edit-btn-redo"}, "class": "edit-btn"},
    {"type": "click", "target": {"selector": ".edit-btn-undo"}},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_keys.txt", "contains": "\nfourth line with some words"}
  ]
}
