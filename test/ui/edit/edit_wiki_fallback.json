{
  "name": "markup that cannot survive a rich round trip opens in source mode",
  "command": "edit",
  "html": "test/ui/edit/sample-wiki-fallback.wiki",
  "working_copy": "temp/edit-ui/edit_wiki_fallback.wiki",
  "viewport": {"width": 1000, "height": 700},
