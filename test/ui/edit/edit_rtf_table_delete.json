{
  "name": "delete RTF table columns and rows with undo",
  "command": "edit",
  "html": "test/fixtures/edit/table.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_table_delete.rtf",
  "events": [
    {"type": "click", "target": {"selector": "#edit-surface table td", "index": 1}, "button": 1},
    {"type": "click", "target": {"selector": ".edit-btn-table_column_delete"}},
    {"type": "assert_count", "target": {"selector": "#edit-surface table td"}, "count": 2},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_table_delete.rtf", "contains": "\\cellx1200 "},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_table_delete.rtf", "contains": "\\cellx1000 "},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": "#edit-surface table td"}, "count": 4},
    {"type": "click", "target": {"text": "Delta"}, "button": 1},
    {"type": "click", "target": {"selector": ".edit-btn-table_row_delete"}},
    {"type": "assert_count", "target": {"selector": "#edit-surface table tr"}, "count": 1},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_table_delete.rtf", "contains": "\\cellx1200\\cellx3000"},
    {"type": "key_combo", "key": "/", "mods_str": "super"},
    {"type": "key_combo", "key": "/", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": "#edit-surface table tr"}, "count": 1}
  ]
}
