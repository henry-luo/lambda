{
  "name": "a handle resizes, Style repaints through the style attribute, Duplicate remaps ids, Back reorders, and zoom leaves the file alone",
  "command": "edit",
  "html": "test/ui/edit/sample.svg",
  "working_copy": "temp/edit-ui/edit_svg_resize_style.svg",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type": "click", "target": {"selector": "#box"}},
    {"type": "mouse_drag", "target": {"selector": ".edit-handle[data-edit-handle='se']"}, "to_target": {"selector": ".edit-handle[data-edit-handle='se']", "offset_x": 34, "offset_y": 24}},
    {"type": "assert_attribute", "target": {"selector": "#box"}, "attribute": "width", "equals": "150"},
    {"type": "assert_attribute", "target": {"selector": "#box"}, "attribute": "height", "equals": "100"},
    {"type": "assert_attribute", "target": {"selector": "#box"}, "attribute": "x", "equals": "20"},
    {"type": "click", "target": {"selector": "#dot"}},
    {"type": "click", "target": {"selector": ".edit-btn-style"}},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-style"}, "count": 1},
    {"type": "assert_value", "target": {"selector": "#edit-dialog-fill"}, "equals": "#ffcc00"},
    {"type": "click", "target": {"selector": "#edit-dialog-fill"}},
    {"type": "type", "text": "#00aa00", "clear": true},
    {"type": "click", "target": {"selector": ".edit-dialog-style_ok"}},
    {"type": "assert_count", "target": {"selector": ".edit-dialog"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": "#dot"}, "attribute": "style", "equals": "fill:#00aa00;stroke:#000000"},
    {"type": "key_combo", "key": "d", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": "#dot-2"}, "count": 1},
    {"type": "assert_attribute", "target": {"selector": "#dot-2"}, "attribute": "cx", "equals": "230"},
    {"type": "click", "target": {"selector": ".edit-btn-back"}},
    {"type": "click", "target": {"selector": ".edit-btn-zoom_in"}},
    {"type": "assert_text", "target": {"selector": ".edit-zoom"}, "equals": "125%"},
    {"type": "assert_attribute", "target": {"selector": ".edit-canvas"}, "attribute": "width", "equals": "500"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""},
    {"type": "assert_file", "path": "temp/edit-ui/edit_svg_resize_style.svg", "contains": "<rect id=\"box\" x=\"20\" y=\"20\" width=\"150\" height=\"100\""},
    {"type": "assert_file", "path": "temp/edit-ui/edit_svg_resize_style.svg", "contains": "<circle id=\"dot\" cx=\"220\" cy=\"60\" r=\"40\" style=\"fill:#00aa00;stroke:#000000\"/>"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_svg_resize_style.svg", "contains": "<title>Sample drawing</title>\n  <circle id=\"dot-2\" cx=\"230\" cy=\"70\""},
    {"type": "assert_file", "path": "temp/edit-ui/edit_svg_resize_style.svg", "contains": "width=\"400\" height=\"300\" viewBox=\"0 0 400 300\""},
    {"type": "click", "target": {"selector": ".edit-btn-zoom_fit"}},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""}
  ]
}
