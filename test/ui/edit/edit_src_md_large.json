{
  "name": "a 100,000-line Markdown file is highlighted at both ends, scrolled by wheel, and typing keeps the colors",
  "command": "edit",
  "source": true,
  "html": "temp/edit-ui/large_source.md",
  "prepare": ["python3", "test/ui/edit/gen_large_source.py", "temp/edit-ui/large_source.md", "100000", "--markdown"],
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "assert_text", "target": {"selector": ".tok-heading"}, "equals": "## Section 0"},
    {"type": "click", "target": {"text": "quoted line 0"}},
    {"type": "key_combo", "key": "ArrowDown", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 100009"},
    {"type": "assert_text", "target": {"selector": ".tok-heading"}, "equals": "## Section 7691"},
    {"type": "assert_count", "target": {"selector": ".tok-fence"}, "count": 6},
    {"type": "assert_count", "target": {"selector": ".tok-strong"}, "count": 4},
    {"type": "click", "target": {"text": "bold"}},
    {"type": "type", "text": "WORD"},
    {"type": "assert_text", "target": {"selector": ".tok-strong"}, "contains": "WORD"},
    {"type": "assert_count", "target": {"selector": ".tok-strong"}, "count": 4},
    {"type": "scroll", "x": 400, "y": 300, "dx": 0, "dy": 13},
    {"type": "assert_text", "target": {"selector": ".tok-heading"}, "equals": "## Section 7686"},
    {"type": "key_combo", "key": "ArrowUp", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".tok-heading"}, "equals": "## Section 0"}
  ]
}
