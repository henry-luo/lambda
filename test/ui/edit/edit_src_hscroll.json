{
  "name": "the horizontal track, thumb, wheel and caret move text in a fixed viewport, and resizing keeps the scroll origin",
  "command": "edit",
  "source": true,
  "html": "test/ui/edit/wrap_sample.txt",
  "working_copy": "temp/edit-ui/edit_src_hscroll.txt",
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "present": false},
    {"type": "assert_visible", "target": {"selector": ".src-hthumb"}, "visible": true},
    {"type": "click", "target": {"selector": ".src-hscroll", "offset_x": 300, "offset_y": 6}},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "contains": "margin-left: -"},
    {"type": "resize", "width": 850, "height": 720},
    {"type": "assert_rect", "target": {"selector": "#edit-surface"}, "relative_to": ".src-viewport", "x": -930, "tolerance": 16},
    {"type": "resize", "width": 1000, "height": 720},
    {"type": "click", "target": {"selector": ".src-hscroll", "offset_x": 2, "offset_y": 6}},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "present": false},
    {"type": "mouse_down", "target": {"text": "long:"}, "button": 0},
    {"type": "mouse_move", "x": 999, "y": 178},
    {"type": "advance_time", "ms": 400, "steps": 25},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "contains": "margin-left: -"},
    {"type": "assert_selection", "is_collapsed": false, "check_dom": true},
    {"type": "mouse_up", "x": 999, "y": 178, "button": 0},
    {"type": "key_combo", "key": "c", "mods_str": "super"},
    {"type": "assert_clipboard", "contains": "token0010"},
    {"type": "key_press", "key": "Home"},
    {"type": "mouse_drag", "target": {"selector": ".src-hthumb", "offset_x": 3, "offset_y": 4}, "to_x": 985, "to_y": 691},
    {"type": "click", "target": {"text": "token0495"}},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 7, Col 495"},
    {"type": "key_press", "key": "Home"},
    {"type": "click", "target": {"text": "long:"}},
    {"type": "key_press", "key": "End"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 7, Col 5006"},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "contains": "margin-left: -"},
    {"type": "assert_rect", "target": {"selector": ".src-num", "index": 0}, "x": 0, "tolerance": 30},
    {"type": "type", "text": "Z"},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "contains": "token0499Z"},
    {"type": "click", "target": {"text": "token0495"}},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 7, Col 495"},
    {"type": "key_press", "key": "Home"},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "present": false},
    {"type": "scroll", "x": 500, "y": 300, "dx": -2, "dy": 0},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "contains": "margin-left: -"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 7, Col 1"},
    {"type": "key_combo", "key": "z", "mods_str": "alt"},
    {"type": "assert_count", "target": {"selector": ".src-hthumb"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": "#edit-surface"}, "attribute": "style", "present": false},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_hscroll.txt", "contains": "token0499Z\nafter the long line\n"}
  ]
}
