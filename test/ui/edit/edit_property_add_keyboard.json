{
  "name": "add a property with keyboard and undo",
  "command": "edit",
  "html": "test/fixtures/edit/sample.properties",
  "working_copy": "temp/edit-ui/edit_property_add_keyboard.properties",
  "events": [
    {"type": "click", "target": {"selector": ".property-add"}},
    {"type": "type", "text": "newkey"},
    {"type": "assert_value", "target": {"selector": "#property-new-key"}, "equals": "newkey"},
    {"type": "key_press", "key": "Tab"},
    {"type": "type", "text": "newvalue"},
    {"type": "assert_value", "target": {"selector": "#property-new-value"}, "equals": "newvalue"},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-add-property"}, "count": 0},
    {"type": "assert_count", "target": {"selector": "input[aria-label='newkey']"}, "count": 1},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_count", "target": {"selector": "input[aria-label='newkey']"}, "count": 0},
    {"type": "key_combo", "key": "z", "mods_str": "super+shift"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_property_add_keyboard.properties", "contains": "newkey=newvalue"}
  ]
}
