{
  "name": "save an unlisted text format using its suffix",
  "command": "edit",
  "html": "test/ui/edit/sample-custom.custom",
  "working_copy": "temp/edit-ui/edit_custom_source_save_as.custom",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type": "write_file", "path": "temp/edit-ui/edit_custom_copy.custom", "content": "old copy\n"},
    {"type": "write_file", "path": "temp/edit-ui/edit_custom_refused.png", "content": "old image\n"},
    {"type": "assert_count", "target": {"selector": ".src-text"}, "count": 1},
    {"type": "click", "target": {"selector": ".src-text"}},
    {"type": "key_combo", "key": "End", "mods_str": "super"},
    {"type": "type", "text": "edited"},
    {"type": "key_combo", "key": "s", "mods_str": "super+shift"},
    {"type": "click", "target": {"selector": "#edit-dialog-path"}},
    {"type": "type", "text": "edit_custom_refused.png", "clear": true},
    {"type": "click", "target": {"selector": ".edit-dialog-save_as_ok"}},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "is not a source text file name"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_custom_refused.png", "equals": "old image\n"},
    {"type": "click", "target": {"selector": "#edit-dialog-path"}},
    {"type": "type", "text": "edit_custom_copy.custom", "clear": true},
    {"type": "click", "target": {"selector": ".edit-dialog-save_as_ok"}},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-exists"}, "count": 1},
    {"type": "click", "target": {"selector": ".edit-dialog-overwrite"}},
    {"type": "assert_file", "path": "temp/edit-ui/edit_custom_copy.custom", "contains": "edited"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_custom_source_save_as.custom", "not_contains": "edited"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""}
  ]
}
