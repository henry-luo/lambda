{
  "name": "with soft wrap, Up and Down move the caret by rows through a wrapped line; a narrower window wraps it into more rows, with its number as tall as its text",
  "command": "edit",
  "source": true,
  "html": "test/ui/edit/wrap_sample.txt",
  "working_copy": "temp/edit-ui/edit_src_wrap_rows.txt",
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "click", "target": {"text": "short after medium"}},
    {"type": "key_press", "key": "Home"},
    {"type": "key_combo", "key": "z", "mods_str": "alt"},
    {"type": "assert_rect", "target": {"selector": ".edit-doc > div", "index": 4}, "height": 60},
    {"type": "key_press", "key": "ArrowUp"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 5, "},
    {"type": "key_press", "key": "ArrowUp"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 5, "},
    {"type": "key_press", "key": "ArrowUp"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 5, Col 1  ·"},
    {"type": "key_press", "key": "ArrowUp"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 4, Col 1  ·"},
    {"type": "key_press", "key": "ArrowDown"},
    {"type": "key_press", "key": "ArrowDown"},
    {"type": "key_press", "key": "ArrowDown"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 5, "},
    {"type": "key_press", "key": "ArrowDown"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 6, Col 1  ·"},
    {"type": "resize", "width": 600, "height": 720},
    {"type": "assert_rect", "target": {"selector": ".src-num", "index": 4}, "height": 100},
    {"type": "assert_rect", "target": {"selector": ".edit-doc > div", "index": 4}, "height": 100},
    {"type": "key_combo", "key": "z", "mods_str": "alt"},
    {"type": "key_press", "key": "ArrowUp"},
    {"type": "assert_text", "target": {"selector": ".src-status-left"}, "contains": "Ln 5, Col 1  ·"}
  ]
}
