{
  "name": "Markdown parts the editor cannot edit show view-only and save back as written",
  "command": "edit",
  "html": "test/ui/edit/kept.md",
  "working_copy": "temp/edit-ui/edit_md_view_only.md",
  "viewport": {"width": 1000, "height": 900},
  "events": [
    {"type": "assert_count", "target": {"selector": "#edit-surface .edit-view-only"}, "count": 5},
    {"type": "assert_count", "target": {"selector": "#edit-surface .edit-view-block"}, "count": 5},
    {"type": "assert_count", "target": {"selector": "#edit-surface .edit-view-source"}, "count": 2},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "contains": "E = mc^2"},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "contains": "[home]: https://example.com"},
    {"type": "assert_count", "target": {"selector": "#edit-surface .edit-view-only kbd"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#edit-surface .edit-view-note"}, "count": 2},
    {"type": "assert_count", "target": {"selector": "#edit-surface .edit-view-only b"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "not_contains": "[^1]"},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "not_contains": "<kbd>"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""},
    {"type": "click", "target": {"text": "An editable paragraph"}},
    {"type": "type", "text": "XYZ"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": "*"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Saved edit_md_view_only.md"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_view_only.md", "contains": "XYZ"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_view_only.md", "contains": "\n\nText with a footnote[^1] and <kbd>Ctrl</kbd> keys.\n\n"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_view_only.md", "contains": "\n\n<div class=\"box\">\n<b>raw</b> block\n</div>\n\n"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_view_only.md", "contains": "\n\n$$\nE = mc^2\n$$\n\n"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_view_only.md", "contains": "\n\n[^1]: The footnote, with  two spaces.\n\n"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_md_view_only.md", "contains": "\n\n[home]: https://example.com\n"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""}
  ]
}
