{
  "name": "CSV grid commits and navigates vertically with the keyboard",
  "command": "edit",
  "html": "test/fixtures/edit/sample.csv",
  "working_copy": "temp/edit-ui/edit_csv_grid_vertical.csv",
  "events": [
    {"type": "click", "target": {"selector": "#grid-cell-1-1"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "New\nYork"},
    {"type": "key_combo", "key": "Enter", "mods_str": "super"},
    {"type": "assert_focus", "target": {"selector": "#grid-cell-2-1"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "Rome"},
    {"type": "key_combo", "key": "Enter", "mods_str": "super+shift"},
    {"type": "assert_focus", "target": {"selector": "#grid-cell-1-1"}},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_csv_grid_vertical.csv", "contains": "Alice,\"New\nYork\"\nBob,Rome\n"}
  ]
}
