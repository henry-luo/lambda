{
  "name": "edit continued property keys and values while preserving untouched entries",
  "command": "edit",
  "html": "test/fixtures/edit/continued.properties",
  "working_copy": "temp/edit-ui/edit_properties_continuation.properties",
  "events": [
    {"type": "assert_count", "target": {"selector": ".property-value"}, "count": 4},
    {"type": "assert_value", "target": {"selector": ".property-key", "index": 0}, "equals": "longkey"},
    {"type": "assert_value", "target": {"selector": ".property-value", "index": 0}, "equals": "onetwo"},
    {"type": "click", "target": {"selector": ".property-value", "index": 0}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "changed"},
    {"type": "key_press", "key": "Enter"},
    {"type": "click", "target": {"selector": ".property-value", "index": 3}},
    {"type": "type", "text": "enabled"},
    {"type": "key_press", "key": "Enter"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_properties_continuation.properties", "contains": "long\\\n  key=changed\nkeep=left\\\n  right\ntail=end\nunassigned=enabled\n"}
  ]
}
