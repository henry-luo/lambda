{
  "name": "apply RTF strikethrough without enabling inline code",
  "command": "edit",
  "html": "test/ui/edit/sample-strike.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_strike.rtf",
  "viewport": {
    "width": 1000,
    "height": 700
  },
  "events": [
    {
      "type": "click",
      "target": {
        "text": "Alpha"
      }
    },
    {
      "type": "key_combo",
      "key": "a",
      "mods_str": "super"
    },
    {
      "type": "assert_selection",
      "is_collapsed": false,
      "check_dom": true
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-compact-format summary"
      }
    },
    {
      "type": "assert_selection",
      "is_collapsed": false,
      "check_dom": true
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-btn-code"
      },
      "count": 0
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-btn-strike"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#edit-surface del"
      },
      "count": 1
    },
    {
      "type": "key_combo",
      "key": "s",
      "mods_str": "super"
    },
    {
      "type": "assert_file",
      "path": "temp/edit-ui/edit_rtf_strike.rtf",
      "contains": "\\strike "
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".edit-dirty"
      },
      "equals": ""
    }
  ]
}
