{
  "name": "copy and cut take the model selection, also past the rendered window, and paste puts it back exactly, also right after a click",
  "command": "edit",
  "html": "temp/edit-ui/clipboard_source.txt",
  "prepare": ["python3", "test/ui/edit/gen_large_source.py", "temp/edit-ui/clipboard_source.txt", "300"],
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "click", "target": {"text": "line 000003"}},
    {"type": "key_press", "key": "Home"},
    {"type": "key_combo", "key": "End", "mods_str": "shift"},
    {"type": "key_combo", "key": "c", "mods_str": "super"},
    {"type": "assert_clipboard", "equals": "line 000003: the quick brown fox jumps over the lazy dog"},
    {"type": "key_press", "key": "ArrowUp"},
    {"type": "key_press", "key": "Home"},
    {"type": "key_combo", "key": "PageDown", "mods_str": "shift"},
    {"type": "key_combo", "key": "PageDown", "mods_str": "shift"},
    {"type": "key_combo", "key": "PageDown", "mods_str": "shift"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 95, Col 1"},
    {"type": "key_combo", "key": "c", "mods_str": "super"},
    {"type": "assert_clipboard", "contains": "line 000002: the quick brown fox jumps over the lazy dog\nline 000003:"},
    {"type": "assert_clipboard", "contains": "line 000050:"},
    {"type": "assert_clipboard", "contains": "line 000094: the quick brown fox jumps over the lazy dog\n"},
    {"type": "assert_clipboard", "not_contains": "line 000095"},
    {"type": "key_combo", "key": "x", "mods_str": "super"},
    {"type": "assert_clipboard", "contains": "line 000050:"},
    {"type": "assert_text", "target": {"selector": ".edit-status"}, "contains": "Ln 2, Col 1"},
    {"type": "assert_text", "target": {"selector": "#edit-surface"}, "contains": "line 000095:"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/clipboard_source.txt", "contains": "lazy dog\nline 000095:"},
    {"type": "assert_file", "path": "temp/edit-ui/clipboard_source.txt", "not_contains": "line 000050:"},
    {"type": "key_combo", "key": "v", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/clipboard_source.txt", "contains": "line 000001: the quick brown fox jumps over the lazy dog\nline 000002:"},
    {"type": "assert_file", "path": "temp/edit-ui/clipboard_source.txt", "contains": "line 000094: the quick brown fox jumps over the lazy dog\nline 000095:"},
    {"type": "click", "target": {"text": "line 000090"}},
    {"type": "key_press", "key": "End"},
    {"type": "key_combo", "key": "v", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/clipboard_source.txt", "contains": "line 000090: the quick brown fox jumps over the lazy dogline 000002:"}
  ]
}
