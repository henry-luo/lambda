{
  "name": "change RTF paragraph alignment with keyboard and undo",
  "command": "edit",
  "html": "test/ui/edit/sample-alignment.rtf",
  "working_copy": "temp/edit-ui/edit_rtf_alignment_keys.rtf",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type": "click", "target": {"selector": ".edit-surface p", "index": 2}},
    {"type": "key_combo", "key": "e", "mods_str": "super+shift"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 2}, "attribute": "style", "contains": "text-align: center"},
    {"type": "key_combo", "key": "r", "mods_str": "super+shift"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 2}, "attribute": "style", "contains": "text-align: right"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 2}, "attribute": "style", "contains": "text-align: center"},
    {"type": "key_combo", "key": "j", "mods_str": "super+shift"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 2}, "attribute": "style", "contains": "text-align: justify"},
    {"type": "key_combo", "key": "l", "mods_str": "super+shift"},
    {"type": "assert_attribute", "target": {"selector": ".edit-surface p", "index": 2}, "attribute": "style", "present": false},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_rtf_alignment_keys.rtf", "contains": "\\pard\\qc Left"},
    {"type": "assert_text", "target": {"selector": ".edit-dirty"}, "equals": ""}
  ]
}
