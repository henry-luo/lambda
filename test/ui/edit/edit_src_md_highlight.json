{
  "name": "Markdown source is highlighted from the parser's spans, and edits keep and update the colors",
  "command": "edit",
  "source": true,
  "html": "test/ui/edit/sample.md",
  "working_copy": "temp/edit-ui/edit_src_md_highlight.md",
  "viewport": {"width": 1000, "height": 720},
  "events": [
    {"type": "assert_count", "target": {"selector": ".tok-meta"}, "count": 3},
    {"type": "assert_count", "target": {"selector": ".tok-heading"}, "count": 2},
    {"type": "assert_text", "target": {"selector": ".tok-strong"}, "equals": "**bold text**"},
    {"type": "assert_text", "target": {"selector": ".tok-emphasis"}, "equals": "*italic text*"},
    {"type": "assert_text", "target": {"selector": ".tok-link"}, "equals": "[link]"},
    {"type": "assert_count", "target": {"selector": ".tok-fence"}, "count": 2},
    {"type": "assert_text", "target": {"selector": ".tok-code"}, "equals": "let x = 1;"},
    {"type": "assert_count", "target": {"selector": ".tok-list-marker"}, "count": 2},
    {"type": "assert_count", "target": {"selector": ".tok-quote"}, "count": 1},
    {"type": "click", "target": {"text": "bold text"}},
    {"type": "type", "text": "Z"},
    {"type": "assert_count", "target": {"selector": ".tok-strong"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".tok-strong"}, "contains": "Z"},
    {"type": "click", "target": {"text": "short paragraph"}},
    {"type": "key_press", "key": "End"},
    {"type": "type", "text": " **new**"},
    {"type": "assert_count", "target": {"selector": ".tok-strong"}, "count": 2},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_src_md_highlight.md", "contains": "testing the editor. **new**\n"},
    {"type": "render", "file": "temp/edit-ui/edit_src_md_highlight.png"}
  ]
}
