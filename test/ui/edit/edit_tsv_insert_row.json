{
  "name": "insert a TSV row while a cell edit is pending",
  "command": "edit",
  "html": "test/fixtures/edit/sample.tsv",
  "working_copy": "temp/edit-ui/edit_tsv_insert_row.tsv",
  "events": [
    {"type": "click", "target": {"selector": "#grid-cell-0-0"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "Title"},
    {"type": "click", "target": {"selector": ".property-grid tbody tr:nth-child(2) th"}, "button": 1},
    {"type": "click", "target": {"selector": "#property-grid-menu [aria-label='Insert row above']"}},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_tsv_insert_row.tsv", "equals": "Title\tNotes\n\t\nAlice\tPlain\n"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_tsv_insert_row.tsv", "equals": "Title\tNotes\nAlice\tPlain\n"}
  ]
}
