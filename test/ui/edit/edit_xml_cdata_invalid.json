{
  "name": "preserve an invalid CDATA draft until it is corrected",
  "command": "edit",
  "html": "test/fixtures/edit/xml-values.xml",
  "working_copy": "temp/edit-ui/edit_xml_cdata_invalid.xml",
  "viewport": {"width": 1000, "height": 800},
  "events": [
    {"type": "click", "target": {"selector": "textarea[aria-label='#cdata']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "bad]]>value"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".property-status"}, "contains": "CDATA cannot contain"},
    {"type": "assert_value", "target": {"selector": "textarea[aria-label='#cdata']"}, "equals": "bad]]>value"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_xml_cdata_invalid.xml", "contains": "<![CDATA[literal <tag>\nmore]]>"},
    {"type": "window_close"},
    {"type": "assert_count", "target": {"selector": ".edit-dialog-invalid-close"}, "count": 1},
    {"type": "click", "target": {"selector": ".edit-dialog-cancel"}},
    {"type": "click", "target": {"selector": "textarea[aria-label='#cdata']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "good <value>"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_xml_cdata_invalid.xml", "contains": "<![CDATA[good <value>]]>"}
  ]
}
