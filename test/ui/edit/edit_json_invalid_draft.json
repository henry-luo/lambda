{
  "name": "invalid JSON property drafts block save until corrected",
  "command": "edit",
  "html": "test/fixtures/edit/property-tree.json",
  "working_copy": "temp/edit-ui/edit_json_invalid_draft.json",
  "events": [
    {"type": "click", "target": {"selector": "textarea[aria-label='name']"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "Coffee"},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": ".property-status"}, "contains": "Invalid value"},
    {"type": "assert_value", "target": {"selector": "textarea[aria-label='name']"}, "equals": "Coffee"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_json_invalid_draft.json", "contains": "\"name\": \"Tea\""},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "\"Coffee\""},
    {"type": "key_combo", "key": "s", "mods_str": "super"},
    {"type": "assert_file", "path": "temp/edit-ui/edit_json_invalid_draft.json", "contains": "\"name\": \"Coffee\""}
  ]
}
