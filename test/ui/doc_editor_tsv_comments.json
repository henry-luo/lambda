{
  "name": "Document editor reads a commented whitespace table with a TSV extension",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1600},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "css_cascade_memory_baseline.tsv"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "scroll", "target": {"selector": "#project-tree"}, "dx": 0, "dy": -200},
    {"type": "click", "target": {"selector": ".tree-hit-__test_css_cascade_memory_baseline_tsv .tree-label"}},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "css_cascade_memory_baseline.tsv"},
    {"type": "assert_count", "target": {"selector": ".csv-table thead th"}, "count": 15},
    {"type": "assert_count", "target": {"selector": ".csv-table tbody tr"}, "count": 12},
    {"type": "assert_text", "target": {"selector": ".csv-table thead th:first-child"}, "equals": "fixture"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:first-child td", "index": 0}, "equals": "jqueryui"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:first-child td", "index": 2}, "equals": "176242"},
    {"type": "render", "file": "./temp/doc_editor_tsv_comments.png"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "# CSS cascade memory regression baseline"}
  ]
}
