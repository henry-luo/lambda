{
  "name": "project editor navigation rich",
  "html": "temp/view-pane-rich",
  "prepare": [
    "python3",
    "-c",
    "from pathlib import Path;import shutil;p=Path('temp/view-pane-rich');p.mkdir(parents=True,exist_ok=True);shutil.copyfile('test/ui/edit/sample.md',p/'first.md');shutil.copyfile('test/fixtures/edit/sample.json',p/'second.json')"
  ],
  "viewport": {
    "width": 1100,
    "height": 700
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='/first.md'] .tree-label"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".tab-edit"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "p"
      }
    },
    {
      "type": "type",
      "text": "CHANGED"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='/second.json'] .tree-label"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-dialog-navigate"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-cancel"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-format-markdown"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='/second.json'] .tree-label"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-save"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".document-name"
      },
      "equals": "second.json"
    },
    {
      "type": "assert_file",
      "path": "temp/view-pane-rich/first.md",
      "contains": "CHANGED"
    }
  ]
}
