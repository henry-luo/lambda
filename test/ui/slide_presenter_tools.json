{
  "name": "Presenter notes, cached preview, independent timer and navigation tools",
  "html": "test/demo/slides/presenter_tools.slides",
  "viewport": {"width": 1280, "height": 800},
  "events": [
    {"type": "assert_count", "target": {"selector": ".slide-canvas > .slide-layer"}, "equals": 1},
    {"type": "assert_count", "target": {"selector": ".slide-preview-canvas > .slide-layer"}, "equals": 0},
    {"type": "click", "target": {"selector": "[data-slide-tool=console]"}},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-console", "equals": "true"},
    {"type": "assert_text", "target": {"selector": ".slide-notes"}, "contains": "Welcome the audience"},
    {"type": "assert_text", "target": {"selector": ".slide-preview-title"}, "contains": "One shared design"},
    {"type": "assert_count", "target": {"selector": ".slide-preview-canvas > .slide-layer"}, "equals": 1},
    {"type": "assert_style", "target": {"selector": "#presenter-demo-preview-s1-o3"}, "property": "opacity", "equals": "1"},
    {"type": "click", "target": {"selector": "[data-slide-tool=timer-toggle]"}},
    {"type": "click", "target": {"selector": "[data-slide-tool=timer-reset]"}},
    {"type": "assert_text", "target": {"selector": ".slide-timer"}, "equals": "00:00:00"},
    {"type": "advance_time", "ms": 3000, "steps": 3},
    {"type": "assert_text", "target": {"selector": ".slide-timer"}, "equals": "00:00:00"},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-timer-running", "equals": "false"},
    {"type": "click", "target": {"selector": "[data-slide-tool=timer-toggle]"}},
    {"type": "advance_time", "ms": 2100, "steps": 7},
    {"type": "assert_text", "target": {"selector": ".slide-timer"}, "equals": "00:00:02"},
    {"type": "key_press", "key": "o"},
    {"type": "assert_style", "target": {"selector": ".slide-overview"}, "property": "display", "equals": "block"},
    {"type": "assert_count", "target": {"selector": ".slide-canvas > .slide-layer"}, "equals": 1},
    {"type": "click", "target": {"selector": "[data-slide-destination='3']"}},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-index", "equals": "2"},
    {"type": "assert_style", "target": {"selector": ".slide-overview"}, "property": "display", "equals": "none"},
    {"type": "assert_text", "target": {"selector": "#presenter-demo-notes-s2"}, "contains": "No speaker notes"},
    {"type": "assert_visible", "target": {"selector": ".slide-preview-end"}, "visible": true},
    {"type": "focus", "target": {"selector": ".slide-picker"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "intro"},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-overview", "equals": "false"},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-index", "equals": "0"},
    {"type": "assert_value", "target": {"selector": ".slide-picker"}, "equals": "1"},
    {"type": "assert_count", "target": {"selector": ".slide-preview-canvas > .slide-layer"}, "equals": 1},
    {"type": "assert_focus", "target": {"selector": "#presenter-demo"}},
    {"type": "key_press", "key": "p"},
    {"type": "key_press", "key": "h"},
    {"type": "assert_style", "target": {"selector": ".slide-controls"}, "property": "display", "equals": "none"},
    {"type": "key_press", "key": "b"},
    {"type": "assert_pixel", "target": {"selector": ".slide-stage", "offset_x": 100, "offset_y": 100}, "max_r": 0, "max_g": 0, "max_b": 0},
    {"type": "key_press", "key": "Escape"},
    {"type": "assert_style", "target": {"selector": ".slide-blackout"}, "property": "display", "equals": "none"},
    {"type": "key_press", "key": "l"},
    {"type": "mouse_move", "target": {"selector": ".slide-stage", "offset_x": 100, "offset_y": 100}},
    {"type": "assert_style", "target": {"selector": ".slide-pointer"}, "property": "display", "equals": "block"},
    {"type": "assert_pixel", "target": {"selector": ".slide-stage", "offset_x": 100, "offset_y": 100}, "min_r": 240, "max_g": 80, "max_b": 90},
    {"type": "key_press", "key": "Escape"},
    {"type": "assert_style", "target": {"selector": ".slide-pointer"}, "property": "display", "equals": "none"},
    {"type": "click", "target": {"selector": ".slide-toolbar-toggle"}},
    {"type": "assert_style", "target": {"selector": ".slide-controls"}, "property": "display", "equals": "flex"},
    {"type": "resize", "width": 960, "height": 640},
    {"type": "key_press", "key": "p"},
    {"type": "assert_count", "target": {"selector": ".slide-preview-canvas > .slide-layer"}, "equals": 1},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-console", "equals": "true"},
    {"type": "key_press", "key": "l"},
    {"type": "mouse_move", "target": {"selector": ".slide-stage", "offset_x": 100, "offset_y": 100}},
    {"type": "assert_style", "target": {"selector": ".slide-pointer"}, "property": "display", "equals": "block"},
    {"type": "mouse_move", "target": {"selector": ".slide-console", "offset_x": 50, "offset_y": 50}},
    {"type": "assert_style", "target": {"selector": ".slide-pointer"}, "property": "display", "equals": "none"},
    {"type": "key_press", "key": "Escape"},
    {"type": "focus", "target": {"selector": ".slide-picker"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type", "text": "absent"},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-index", "equals": "0"},
    {"type": "assert_text", "target": {"selector": ".slide-status"}, "contains": "slide number or ID"},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-blackout", "equals": "false"}
  ]
}
