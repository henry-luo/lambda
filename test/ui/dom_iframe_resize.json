{
  "name":"Iframe documents retain their DOM and reflow across asynchronous and srcdoc resizing",
  "html":"test/ui/dom_iframe_resize.html",
  "viewport":{"width":800,"height":900},
  "events":[
    {"type":"switch_frame","selector":"#async-html"},
    {"type":"script","js":"globalThis.retainedBody=document.body;globalThis.initialBodyWidth=document.body.getBoundingClientRect().width;globalThis.resizeMarker=\"retained\""},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#async-md"},
    {"type":"script","js":"globalThis.retainedBody=document.body;globalThis.initialBodyWidth=document.body.getBoundingClientRect().width;globalThis.resizeMarker=\"retained\""},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#inline"},
    {"type":"script","js":"globalThis.retainedBody=document.body;globalThis.initialBodyWidth=document.body.getBoundingClientRect().width;globalThis.resizeMarker=\"retained\""},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#async-lambda"},
    {"type":"click","target":{"selector":"#counter"}},
    {"type":"assert_attribute","target":{"selector":"#counter-body"},"attribute":"data-loads","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#counter-body"},"attribute":"data-clicks","equals":"1"},
    {"type":"switch_frame"},
    {"type":"script","js":"document.querySelectorAll(\".box\").forEach(el=>{el.style.width=\"520px\";el.style.height=\"240px\"})"},
    {"type":"switch_frame","selector":"#async-lambda"},
    {"type":"assert_attribute","target":{"selector":"#counter-body"},"attribute":"data-loads","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#counter-body"},"attribute":"data-clicks","equals":"1"},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#async-html"},
    {"type":"assert_script","js":"document.body===retainedBody && resizeMarker===\"retained\" && document.body.getBoundingClientRect().width>initialBodyWidth+250"},
    {"type":"assert_rect","target":{"selector":"#sized"},"width":516,"height":118,"tolerance":1},
    {"type":"assert_style","target":{"selector":"#mode"},"property":"color","equals":"rgb(20, 100, 160)"},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#async-md"},
    {"type":"assert_script","js":"document.body===retainedBody && resizeMarker===\"retained\" && document.body.getBoundingClientRect().width>initialBodyWidth+250"},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#inline"},
    {"type":"assert_script","js":"document.body===retainedBody && resizeMarker===\"retained\" && document.body.getBoundingClientRect().width>initialBodyWidth+250"},
    {"type":"assert_rect","target":{"selector":"#sized"},"width":516,"height":118,"tolerance":1},
    {"type":"switch_frame"},
    {"type":"script","js":"document.querySelectorAll(\".box\").forEach(el=>{el.style.width=\"220px\";el.style.height=\"160px\"})"},
    {"type":"switch_frame","selector":"#async-lambda"},
    {"type":"assert_attribute","target":{"selector":"#counter-body"},"attribute":"data-loads","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#counter-body"},"attribute":"data-clicks","equals":"1"},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#async-html"},
    {"type":"assert_script","js":"document.body===retainedBody && resizeMarker===\"retained\" && document.body.getBoundingClientRect().width<initialBodyWidth-30"},
    {"type":"assert_rect","target":{"selector":"#sized"},"width":216,"height":78,"tolerance":1},
    {"type":"assert_style","target":{"selector":"#mode"},"property":"color","equals":"rgb(120, 40, 30)"},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#async-md"},
    {"type":"assert_script","js":"document.body===retainedBody && resizeMarker===\"retained\" && document.body.getBoundingClientRect().width<initialBodyWidth-30"},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#inline"},
    {"type":"assert_script","js":"document.body===retainedBody && resizeMarker===\"retained\" && document.body.getBoundingClientRect().width<initialBodyWidth-30"},
    {"type":"assert_rect","target":{"selector":"#sized"},"width":216,"height":78,"tolerance":1},
    {"type":"switch_frame"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
