{
  "name": "Doc editor opens box.html",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".tree-row"}, "max": 65},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_html"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".tree-row"}, "max": 129},
    {"type": "assert_visible", "target": {"selector": ".tree-load-more"}, "visible": true},
    {"type": "click", "target": {"selector": ".tree-load-more"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-row"}, "min": 130, "max": 193},
    {"type": "click", "target": {"selector": ".tree-hit-__test_html .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_html_box_html"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".tree-row"}, "min": 194, "max": 257},
    {"type": "click", "target": {"selector": ".tree-hit-__test_html_box_html"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": "#html-preview"}, "count": 1},
    {"type": "switch_frame", "selector": "#html-preview"},
    {"type": "assert_text", "target": {"selector": "h1"}, "contains": "Box Model Layout Test Cases"},
    {"type": "assert_style", "target": {"selector": "h1"}, "property": "text-align", "equals": "center"},
    {"type": "switch_frame"},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "box.html"}
  ]
}
