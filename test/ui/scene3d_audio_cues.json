{
  "name":"Scene3D sample cues preserve copied identities, exact deadlines and scene-clock holds",
  "html":"test/ui/scene3d_audio.html",
  "viewport":{"width":200,"height":160},
  "env":[{"key":"LAMBDA_AUDIO_OUTPUT","value":"offline"}],
  "input_turn_ms":0,
  "event_interval_ms":0,
  "events":[
    {"type":"script","js":"audioSceneRequest('open')"},
    {"type":"script","js":"audioSceneCue('queue')"},
    {"type":"assert_script","js":"sceneAudio.cue_pending.length===4&&sceneAudio.sources[0].armed&&typeof sceneAudio.audio_frame==='bigint'&&sceneAudio.cue_receipt[0]===1n&&sceneAudio.sources[0].state==='ready'"},
    {"type":"script","js":"sceneAudio.cue_pending[0].requested=999n;audioSceneCue('retry')"},
    {"type":"assert_script","js":"sceneAudio.cue_pending.length===4&&sceneAudio.cue_pending[0].requested===audioCueBatch.events[0].frame&&sceneAudio.cue_sequence===1n"},
    {"type":"advance_time","ms":50,"steps":1},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.cue_pending.length===0&&sceneAudio.cue_history.length===4&&sceneAudio.cue_history.every((event,index)=>event.status==='applied'&&event.actual===audioCueBatch.events[index].frame)&&sceneAudio.sources[0].state==='ready'&&sceneAudio.sources[0].cursor===0&&sceneAudio.document_players===2n"},
    {"type":"script","js":"audioSceneCue('retry')"},
    {"type":"assert_script","js":"sceneAudio.cue_history.length===4&&sceneAudio.cue_pending.length===0&&sceneAudio.cue_receipt[3]===4n"},
    {"type":"script","js":"audioSceneCue('hold')"},
    {"type":"assert_script","js":"sceneAudio.cue_pending.length===1&&sceneAudio.cue_pending[0].held&&sceneAudio.cue_pending[0].clock==='scene'"},
    {"type":"advance_time","ms":30,"steps":3},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.cue_pending.length===1&&sceneAudio.sources[0].state==='ready'"},
    {"type":"script","js":"audioSceneCue('release')"},
    {"type":"advance_time","ms":20,"steps":2},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.cue_pending.length===0&&sceneAudio.cue_history.length===5&&sceneAudio.sources[0].state==='playing'&&sceneAudio.sources[0].pitch===1&&!sceneAudio.sources[0].pitch_follow"},
    {"type":"script","js":"audioSceneCue('hold')"},
    {"type":"script","js":"audioSceneCue('cancel')"},
    {"type":"assert_script","js":"sceneAudio.cue_pending.length===0&&sceneAudio.cue_history[5].status==='cancelled'"},
    {"type":"script","js":"audioSceneRequest('reset')"},
    {"type":"assert_script","js":"sceneAudio.cue_epoch===2n&&sceneAudio.cue_sequence===0n&&sceneAudio.cue_pending.length===0&&sceneAudio.sources[0].state==='ready'&&sceneAudio.document_players===1n"}
  ]
}
