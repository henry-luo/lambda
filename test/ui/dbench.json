{
  "name": "DBench sample, table browsing, SQL and virtual grid",
  "html": "test/demo/dbench/dbench.ls",
  "viewport": {"width": 1280, "height": 800},
  "input_turn_ms": 0,
  "events": [
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"customers"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"Customer 001"},
    {"type":"type","target":{"selector":"#object-filter"},"text":"products","clear":true},
    {"type":"assert_count","target":{"selector":".navigator [data-table]"},"equals":1},
    {"type":"type","target":{"selector":"#object-filter"},"text":"","clear":true},
    {"type":"assert_count","target":{"selector":".navigator [data-table]"},"equals":5},
    {"type":"click","target":{"selector":"#result-0-1"}},
    {"type":"click","target":{"selector":"#inspect-value"}},
    {"type":"assert_text","target":{"selector":"#value-content"},"contains":"Customer 001"},
    {"type":"click","target":{"selector":"#value-next"}},
    {"type":"assert_text","target":{"selector":"#value-content"},"contains":"customer001@example.test"},
    {"type":"click","target":{"selector":"#inspect-value"}},
    {"type":"assert_script","js":"document.querySelectorAll('#result-grid td[data-row]').length<500"},
    {"type":"click","target":{"selector":"#result-0-0"}},
    {"type":"key_press","key":"ArrowDown"},
    {"type":"key_press","key":"ArrowRight","mods_str":"shift"},
    {"type":"assert_count","target":{"selector":"#result-grid td[aria-selected=true]"},"equals":2},
    {"type":"assert_attribute","target":{"selector":"#result-grid"},"attribute":"aria-activedescendant","equals":"result-1-1"},
    {"type":"key_press","key":"c","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Selection copied"},
    {"type":"click","target":{"selector":"[data-table=orders]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"orders"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"click","target":{"selector":"#refresh"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"orders"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"click","target":{"selector":"#details"}},
    {"type":"assert_text","target":{"selector":".details"},"contains":"orders_customer"},
    {"type":"assert_text","target":{"selector":".details"},"contains":"Foreign key customer_id"},
    {"type":"click","target":{"selector":"#details"}},
    {"type":"click","target":{"selector":"#next"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-offset","equals":"256"},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Keyset page loaded"},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"257"},
    {"type":"click","target":{"selector":"#next"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-offset","equals":"512"},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"513"},
    {"type":"click","target":{"selector":"#previous"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-offset","equals":"256"},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"257"},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Keyset page loaded"},
    {"type":"click","target":{"selector":"#previous"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-offset","equals":"0"},
    {"type":"click","target":{"selector":"[data-sort=customer_id]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"click","target":{"selector":"#next"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Keyset page loaded"},
    {"type":"click","target":{"selector":"[data-table=customers]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"customers"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"click","target":{"selector":"[data-sort=email]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"click","target":{"selector":"#next"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"pages can shift"},
    {"type":"select_option","target":{"selector":"#filter-column"},"value":"city"},
    {"type":"type","target":{"selector":"#filter-value"},"text":"Penang","clear":true},
    {"type":"click","target":{"selector":"#apply-filter"}},
    {"type":"assert_text","target":{"selector":"#result-0-3"},"contains":"Penang"},
    {"type":"assert_script","js":"+document.getElementById('dbench').dataset.rows===50"},
    {"type":"click","target":{"selector":"[data-table=wide_records]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"wide_records"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"assert_script","js":"(()=>{let g=document.getElementById('result-grid');return +g.dataset.lastColumn<81 && g.querySelectorAll('td[data-row]').length<500})()"},
    {"type":"click","target":{"selector":"#result-0-0"}},
    {"type":"key_press","key":"End","mods_str":"ctrl+shift"},
    {"type":"assert_script","js":"document.getElementById('result-255-80')!==null && document.getElementById('result-255-80').getAttribute('aria-selected')==='true' && document.getElementById('result-grid').getAttribute('aria-activedescendant')==='result-255-80'"},
    {"type":"key_press","key":"c","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Selection copied"},
    {"type":"key_press","key":"Home","mods_str":"ctrl"},
    {"type":"assert_script","js":"document.getElementById('result-0-0')!==null"},
    {"type":"script","js":"const p=document.getElementById('result-scroll');p.scrollTop=2500;p.scrollLeft=9000;p.dispatchEvent(new Event('scroll'))"},
    {"type":"assert_script","js":"(()=>{let g=document.getElementById('result-grid');return +g.dataset.firstRow>0 && +g.dataset.firstColumn>0 && g.querySelectorAll('td[data-row]').length<500})()"},
    {"type":"type","target":{"selector":"#sql"},"text":"SELECT ?1 AS n, ?2 AS text","clear":true},
    {"type":"type","target":{"selector":"#sql-params"},"text":"not-json","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_text","target":{"selector":".error"},"contains":"JSON array"},
    {"type":"type","target":{"selector":"#sql-params"},"text":"[42,\"O'Reilly\"]","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"42"},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"O'Reilly"},
    {"type":"type","target":{"selector":"#sql-params"},"text":"[]","clear":true},
    {"type":"type","target":{"selector":"#sql"},"text":"SELECT customer_id AS id, customer_id AS id, note FROM customers WHERE customer_id IN (1,5) ORDER BY customer_id","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-mode","equals":"query"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"2"},
    {"type":"assert_text","target":{"selector":"#result-0-2"},"contains":"NULL"},
    {"type":"assert_text","target":{"selector":"#result-1-2"},"contains":"Preferred"},
    {"type":"click","target":{"selector":"#result-0-2"}},
    {"type":"click","target":{"selector":"#inspect-value"}},
    {"type":"assert_text","target":{"selector":"#value-content"},"contains":"NULL"},
    {"type":"click","target":{"selector":"#inspect-value"}},
    {"type":"assert_script","js":"document.querySelectorAll('#result-grid th[data-sort],#result-grid button[data-sort]').length>=3"},
    {"type":"type","target":{"selector":"#sql"},"text":"SELECT order_id FROM orders ORDER BY order_id","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"click","target":{"selector":"#more"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"512"},
    {"type":"click","target":{"selector":"#disconnect"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"false"},
    {"type":"click","target":{"selector":"#sample"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"customers"}
  ]
}
