{
  "name": "designMode uses the document body as the editing host",
  "html": "test/html/editable-dom-designmode.html",
  "viewport": {"width": 640, "height": 240},
  "events": [
    {"type": "log", "message": "=== contenteditable_designmode ==="},
    {"type": "assert_text", "target": {"selector": "#out"}, "equals": "on"},
    {"type": "set_editing_selection", "target": {"selector": "#surface"}, "start": 0, "end": 4},
    {"type": "click", "target": {"selector": "#bold"}},
    {"type": "assert_text", "target": {"selector": "#out"}, "equals": "on:true|<b>seed</b>text"},
    {"type": "click", "target": {"selector": "#off"}},
    {"type": "assert_text", "target": {"selector": "#out"}, "equals": "off:false|<b>seed</b>text"}
  ]
}
