{
  "version": 1,
  "defaults": {
    "font_dir": "test/layout/data/font",
    "jobs": 0
  },
  "suites": [
    {
      "name": "music",
      "globs": ["test/ui/music/*.json"],
      "headless": false,
      "tags": ["music", "native-gui"]
    },
    {
      "name": "baseline",
      "worker_mb": 1024,
      "globs": ["test/ui/*.json"],
      "exclude": [
        "test/ui/dom_*.json",
        "test/ui/svg-dom-contract.json",
        "test/ui/js-loop-listener-*.json",
        "test/ui/editable-*.json",
        "test/ui/rte_*.json",
        "test/ui/hit_test_*.json",
        "test/ui/test_webview_*.json",
        "test/ui/test_caret_*.json",
        "test/ui/test_editing_*.json",
        "test/ui/test_form_*.json",
        "test/ui/test_iframe_*.json",
        "test/ui/rsc_scale_editing_geometry_matrix.json"
      ],
      "tags": ["baseline"]
    },
    {
      "name": "dtna",
      "worker_mb": 1024,
      "globs": ["test/ui/dtna/*.json"],
      "tags": ["dtna", "baseline"]
    },
    {
      "name": "timeline",
      "worker_mb": 1024,
      "globs": ["test/ui/timeline/*.json"],
      "tags": ["timeline", "baseline"]
    },
    {
      "name": "bold",
      "globs": ["test/ui/bold/*.json"],
      "tags": ["bold", "baseline"]
    },
    {
      "name": "wired",
      "globs": ["test/ui/wired/*.json"],
      "tags": ["wired", "baseline"]
    },
    {
      "name": "clay",
      "globs": ["test/ui/clay/*.json"],
      "tags": ["clay", "baseline"]
    },
    {
      "name": "blade",
      "globs": ["test/ui/blade/*.json"],
      "tags": ["blade", "baseline"]
    },
    {
      "name": "draw",
      "globs": ["test/ui/draw/*.json"],
      "tags": ["draw", "baseline"]
    },
    {
      "name": "finder",
      "globs": ["test/ui/finder/*.json"],
      "tags": ["finder"]
    },
    {
      "name": "photos",
      "globs": ["test/ui/photos/*.json"],
      "tags": ["photos", "extended"]
    },
    {
      "name": "photo_album",
      "globs": ["test/ui/photo_album/*.json"],
      "tags": ["photo_album", "baseline"]
    },
    {
      "name": "note",
      "globs": ["test/ui/note/*.json"],
      "tags": ["note"]
    },
    {
      "name": "greetings",
      "globs": ["test/ui/greetings/*.json"],
      "tags": ["greetings"]
    },
    {
      "name": "dom",
      "globs": [
        "test/ui/dom/*.json",
        "test/ui/dom_*.json"
      ],
      "tags": ["dom"]
    },
    {
      "name": "editor",
      "globs": [
        "test/ui/editor4b/*.json",
        "test/ui/editor4c/*.json",
        "test/ui/editor4c_phase_c/*.json",
        "test/ui/editable-*.json",
        "test/ui/rte_*.json",
        "test/ui/test_caret_*.json",
        "test/ui/test_editing_*.json",
        "test/ui/test_form_*.json",
        "test/ui/test_iframe_*.json",
        "test/ui/rsc_scale_editing_geometry_matrix.json",
        "test/ui/svg-dom-contract.json",
        "test/ui/js-loop-listener-*.json"
      ],
      "tags": ["editor"]
    },
    {
      "name": "hit-test",
      "globs": [
        "test/ui/hit-test/*.json",
        "test/ui/hit_test_*.json"
      ],
      "tags": ["hit-test"]
    },
    {
      "name": "edit",
      "globs": [
        "test/ui/edit/*.json"
      ],
      "tags": ["edit", "editor"]
    },
    {
      "name": "view",
      "globs": [
        "test/view/*.json"
      ],
      "default_page": "test/html/index.html",
      "tags": ["view"]
    },
    {
      "name": "native-gui",
      "globs": ["test/ui/test_webview_*.json"],
      "headless": false,
      "tags": ["native-gui"]
    }
  ]
}
