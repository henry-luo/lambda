{
  "name": "upstream ProseMirror selection, clipboard, history, composition, and teardown",
  "html": "test/editable-editors/fixtures/prosemirror/typing.html",
  "viewport": {"width": 720, "height": 360},
  "events": [
    {"type": "assert_count", "target": {"selector": ".ProseMirror"}, "min": 1},
    {"type": "assert_rect", "target": {"selector": ".ProseMirror"}, "height": 18, "tolerance": 3},
    {"type": "click", "target": {"selector": ".ProseMirror", "offset_x": 2, "offset_y": 8}},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "\"from\":1,\"to\":1"},
    {"type": "focus", "target": {"selector": ".ProseMirror"}},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "type_physical", "target": {"selector": ".ProseMirror"}, "text": "replace"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "replace"},
    {"type": "key_combo", "key": "z", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "seed"},
    {"type": "key_combo", "key": "z", "mods_str": "super+shift"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "replace"},
    {"type": "key_press", "key": "End"},
    {"type": "paste_text", "target": {"selector": ".ProseMirror"}, "text": "-clip"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "replace-clip"},
    {"type": "ime_compose", "phase": "begin"},
    {"type": "ime_compose", "phase": "update", "preedit": "に", "caret": 1},
    {"type": "ime_compose", "phase": "commit", "commit": "日本"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "replace-clip日本"},
    {"type": "assert_rect", "target": {"selector": ".ProseMirror"}, "height": 22, "tolerance": 3},
    {"type": "key_combo", "key": "a", "mods_str": "super"},
    {"type": "key_combo", "key": "c", "mods_str": "super"},
    {"type": "assert_clipboard", "contains": "replace-clip日本"},
    {"type": "key_combo", "key": "x", "mods_str": "super"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "\"text\":\"\""},
    {"type": "paste_text", "target": {"selector": ".ProseMirror"}, "text": "replace-clip日本"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "replace-clip日本"},
    {"type": "click", "target": {"selector": "#destroy"}},
    {"type": "assert_attribute", "target": {"selector": "#state"}, "attribute": "data-destroyed", "equals": "true"},
    {"type": "assert_count", "target": {"selector": ".ProseMirror"}, "equals": 0}
  ]
}
