{
  "name":"Standalone authored After timing activates without Play or autostart",
  "html":"test/demo/slides/fixtures/advance_after.slides",
  "viewport":{"width":640,"height":480},
  "input_turn_ms":0,
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"assert_attribute","target":{"selector":"#slides"},"attribute":"data-slide-index","equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#slides"},"attribute":"data-slide-phase","equals":"cue"},
    {"type":"advance_time","ms":70,"steps":2},
    {"type":"click","target":{"selector":"#slides .slide-stage"}},
    {"type":"assert_attribute","target":{"selector":"#slides"},"attribute":"data-slide-index","equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#slides"},"attribute":"data-slide-timed","equals":"true"},
    {"type":"advance_time","ms":250,"steps":5},
    {"type":"assert_attribute","target":{"selector":"#slides"},"attribute":"data-slide-index","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#slides"},"attribute":"data-slide-phase","equals":"waiting"},
    {"type":"assert_attribute","target":{"selector":"#slides"},"attribute":"data-slide-timed","equals":"false"}
  ]
}
