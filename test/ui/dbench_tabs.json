{
  "name":"DBench tabs retain independent sessions and results",
  "html":"test/demo/dbench/dbench.ls",
  "viewport":{"width":1280,"height":800},
  "input_turn_ms":0,
  "events":[
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"type","target":{"selector":"#sql"},"text":"SELECT customer_id FROM customers ORDER BY customer_id","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"More rows available","assert_timeout":30000},
    {"type":"click","target":{"selector":"#tab-new"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-active-tab","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true","assert_timeout":30000},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"type","target":{"selector":"#sql"},"text":"SELECT 77 AS answer","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"77","assert_timeout":30000},
    {"type":"script","js":"document.getElementById('dbench').dispatchEvent(new CustomEvent('dbench_result',{detail:{type:'batch',tab:1,generation:999,token:999,op:'query',columns:[['bad','integer']],rows:[[666]],done:true,offset:0}}))"},
    {"type":"script","js":"document.getElementById('dbench').dispatchEvent(new CustomEvent('dbench_result',{detail:{type:'batch',tab:1,generation:1,token:999,op:'query',columns:[['bad','integer']],rows:[[666]],done:true,offset:0}}))"},
    {"type":"script","js":"document.getElementById('tab-2').focus()"},
    {"type":"key_press","key":"ArrowLeft"},
    {"type":"assert_focus","target":{"selector":"#tab-1"}},
    {"type":"key_press","key":"Enter"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-active-tab","equals":"1"},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"1"},
    {"type":"assert_script","js":"document.getElementById('sql').value === 'SELECT customer_id FROM customers ORDER BY customer_id'","assert_timeout":30000},
    {"type":"click","target":{"selector":"#more"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"300","assert_timeout":30000},
    {"type":"click","target":{"selector":"#tab-2"}},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"77"},
    {"type":"assert_script","js":"document.getElementById('sql').value === 'SELECT 77 AS answer'","assert_timeout":30000},
    {"type":"click","target":{"selector":"[data-tab-close='1']"}},
    {"type":"assert_count","target":{"selector":"#tab-1"},"equals":0},
    {"type":"script","js":"document.getElementById('dbench').dispatchEvent(new CustomEvent('dbench_result',{detail:{type:'connected',tab:1,generation:1,schema:[]}}))"},
    {"type":"assert_count","target":{"selector":"#tab-1"},"equals":0},
    {"type":"click","target":{"selector":"#tab-new"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-active-tab","equals":"3"},
    {"type":"click","target":{"selector":"#tab-2"}},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"77"},
    {"type":"click","target":{"selector":"#tab-3"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true","assert_timeout":30000},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"type","target":{"selector":"#sql"},"text":"WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<200000) SELECT sum(x) FROM n","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"click","target":{"selector":"#tab-2"}},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"77"},
    {"type":"wait","ms":1500},
    {"type":"click","target":{"selector":"#tab-3"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"20000100000"},
    {"type":"type","target":{"selector":"#sql"},"text":"WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<100000000) SELECT sum(x) FROM n","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"click","target":{"selector":"#tab-2"}},
    {"type":"click","target":{"selector":"[data-tab-close='3']"}},
    {"type":"assert_count","target":{"selector":"#tab-3"},"equals":0},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-active-tab","equals":"2"},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"77"},
    {"type":"click","target":{"selector":"#sample"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-generation","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true","assert_timeout":30000},
    {"type":"script","js":"document.getElementById('dbench').dispatchEvent(new CustomEvent('dbench_result',{detail:{type:'disconnected',tab:2,generation:1,message:'stale'}}))"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true"}
  ]
}
