{
  "name": "Equal template branches retain DOM identity through later text updates",
  "html": "test/ui/lambda_equal_render.ls",
  "viewport": {"width": 400, "height": 200},
  "events": [
    {"type": "click", "target": {"selector": "#noop"}},
    {"type": "assert_attribute", "target": {"selector": "#owner"}, "attribute": "data-kept", "equals": "yes"},
    {"type": "assert_attribute", "target": {"selector": "#owner"}, "attribute": "data-same", "equals": "true"},
    {"type": "click", "target": {"selector": "#noop"}},
    {"type": "assert_attribute", "target": {"selector": "#owner"}, "attribute": "data-same", "equals": "true"},
    {"type": "click", "target": {"selector": "#change"}},
    {"type": "assert_text", "target": {"selector": "#value"}, "equals": "1"},
    {"type": "click", "target": {"selector": "#noop"}},
    {"type": "assert_attribute", "target": {"selector": "#owner"}, "attribute": "data-same", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#owner"}, "attribute": "data-kept", "equals": "yes"},
    {"type": "click", "target": {"selector": "#change"}},
    {"type": "assert_text", "target": {"selector": "#value"}, "equals": "2"}
  ]
}
