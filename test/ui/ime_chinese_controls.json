{
  "name": "ime_chinese_controls",
  "html": "test/demo/ime/chinese.ls",
  "viewport": {
    "width": 900,
    "height": 750
  },
  "events": [
    {
      "type": "script",
      "js": "document.body.setAttribute('data-ime-directory','test/ime/fixture')"
    },
    {
      "type": "focus",
      "target": {
        "selector": "#input"
      }
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#input"
      },
      "text": "beijing"
    },
    {
      "type": "assert_ime_popup",
      "count": 2,
      "page": 0,
      "highlight": 0
    },
    {
      "type": "key_press",
      "key": "down"
    },
    {
      "type": "key_press",
      "key": "down"
    },
    {
      "type": "assert_ime_popup",
      "page": 1,
      "highlight": 0
    },
    {
      "type": "key_press",
      "key": "pageup"
    },
    {
      "type": "assert_ime_popup",
      "page": 0,
      "highlight": 0
    },
    {
      "type": "key_press",
      "key": "escape"
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#input"
      },
      "text": "zongguo"
    },
    {
      "type": "click",
      "target": {
        "selector": "#fuzzy"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#input"
      }
    },
    {
      "type": "assert_preedit",
      "target": {
        "selector": "#input"
      },
      "equals": "zongguo"
    },
    {
      "type": "key_press",
      "key": "space"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#input"
      },
      "equals": "中国"
    },
    {
      "type": "click",
      "target": {
        "selector": "#inherit"
      }
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#input"
      },
      "text": "bei"
    },
    {
      "type": "click",
      "target": {
        "selector": "#window-off"
      }
    },
    {
      "type": "assert_preedit",
      "target": {
        "selector": "#input"
      },
      "equals": ""
    },
    {
      "type": "assert_ime_popup",
      "visible": false
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#input"
      },
      "text": "x"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#input"
      },
      "equals": "中国x"
    },
    {
      "type": "click",
      "target": {
        "selector": "#window-on"
      }
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#input"
      },
      "text": "beijing"
    },
    {
      "type": "key_press",
      "key": "space"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#input"
      },
      "equals": "中国x北京"
    },
    {
      "type": "click",
      "target": {
        "selector": "#document-off"
      }
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#input"
      },
      "text": "y"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#input"
      },
      "equals": "中国x北京y"
    },
    {
      "type": "click",
      "target": {
        "selector": "#window-off"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#document-on"
      }
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#input"
      },
      "text": "zongguo"
    },
    {
      "type": "key_press",
      "key": "space"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#input"
      },
      "equals": "中国x北京y中国"
    }
  ]
}
