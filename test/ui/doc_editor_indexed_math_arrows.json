{
  "name": "Document editor renders indexed math arrow SVGs",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1800},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "indexed_math_test.md"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_indexed_math_test_md .tree-label"}},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "indexed_math_test.md"},
    {"type": "assert_count", "target": {"selector": "#rendered-preview svg[viewBox='0 0 1469 522']"}, "min": 2},
    {"type": "assert_count", "target": {"selector": "#rendered-preview .slice-1-of-1 svg[viewBox='0 0 1469 522']"}, "count": 0},
    {"type": "assert_attribute", "target": {"selector": "#rendered-preview svg[viewBox='0 0 1469 522'] path"}, "attribute": "d", "contains": "h1360"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": "span class=\"lm_nulldelimiter"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": "\uE000"},
    {"type": "assert_count", "target": {"selector": "#rendered-preview .math-error"}, "count": 0}
  ]
}
