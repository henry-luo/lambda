{
  "name": "Document editor renders indexed math arrow SVGs",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1800},
  "description": "Target the Arrows section and its glyphs; font-driven TeX metrics may change SVG viewBoxes and choose text instead of outline paths.",
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "indexed_math_test.md"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_indexed_math_test_md .tree-label"}},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "indexed_math_test.md"},
    {"type": "assert_count", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math"}, "count": 15},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 0}, "contains": "→"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 1}, "contains": "←"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 2}, "contains": "↔"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 3}, "contains": "⇒"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 4}, "contains": "⇐"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 5}, "contains": "⇔"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 6}, "contains": "↦"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 7}, "contains": "⟶"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 8}, "contains": "⟵"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 9}, "contains": "↪"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 10}, "contains": "↩"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 11}, "contains": "⇝"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 12}, "contains": "↑"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 13}, "contains": "↓"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2:nth-of-type(17) + p svg.lambda-math", "index": 14}, "contains": "↕"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": "span class=\"lm_nulldelimiter"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": "\uE000"},
    {"type": "assert_count", "target": {"selector": "#rendered-preview .math-error"}, "count": 0}
  ]
}
