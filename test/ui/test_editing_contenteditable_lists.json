    {"type": "assert_text", "target": {"selector": "#out"}, "equals": "true|<ul><li><p>item</p></li></ul>"},
    {"type": "set_editing_selection", "target": {"selector": "#surface"}, "start": 0, "end": 4},
    {"type": "click", "target": {"selector": "#list"}},
    {"type": "assert_text", "target": {"selector": "#out"}, "equals": "true|<p>item</p>"}
  ]
}
