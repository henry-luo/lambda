{
  "name":"Draw live inspector, rotation handle, flips and transformed hit testing",
  "html":"test/demo/draw/draw.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"select_option","target":{"selector":"#object-list"},"value":"n2"},
    {"type":"assert_count","target":{"selector":"#apply-properties"},"count":0},
    {"type":"type","target":{"selector":"#prop-label"},"text":"Rotate me","clear":true},
    {"type":"assert_text","target":{"selector":"#shape-n2 text"},"equals":"Rotate me"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"0"},
    {"type":"click","target":{"selector":"#rotate"}},
    {"type":"assert_value","target":{"selector":"#prop-rotation"},"equals":"90"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 > g"},"attribute":"transform","equals":"rotate(90 430 340)"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"2"},
    {"type":"click","target":{"selector":"#flip-x"}},
    {"type":"assert_attribute","target":{"selector":"#flip-x"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 .shape-graphic"},"attribute":"transform","contains":"scale(-1 1)"},
    {"type":"click","target":{"selector":"#flip-y"}},
    {"type":"assert_attribute","target":{"selector":"#flip-y"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 .shape-graphic"},"attribute":"transform","contains":"scale(-1 -1)"},
    {"type":"type","target":{"selector":"#prop-rotation"},"text":"30","clear":true},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 > g"},"attribute":"transform","contains":"rotate(30"},
    {"type":"type","target":{"selector":"#prop-fill"},"text":"#12","clear":true},
    {"type":"assert_value","target":{"selector":"#prop-fill"},"equals":"#12"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 .shape-graphic rect"},"attribute":"fill","equals":"#e8eeff"},
    {"type":"type","target":{"selector":"#prop-fill"},"text":"#123456","clear":true},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 .shape-graphic rect"},"attribute":"fill","equals":"#123456"},
    {"type":"click","target":{"selector":"#rotate"}},
    {"type":"assert_value","target":{"selector":"#prop-rotation"},"equals":"120"},
    {"type":"type","target":{"selector":"#prop-rotation"},"text":"0","clear":true},
    {"type":"click","target":{"selector":"#selection-title"}},
    {"type":"pointer_drag","target":{"selector":"#paper","offset_x":298,"offset_y":180},"pointerType":"mouse","dx":56,"dy":56,"steps":4},
    {"type":"assert_value","target":{"selector":"#prop-rotation"},"equals":"90"},
    {"type":"click","target":{"selector":"#paper","offset_x":298,"offset_y":187}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-selected","equals":"n2"},
    {"type":"render","file":"temp/draw/selection/rotated.png"},
    {"type":"click","target":{"selector":"#export"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/draw/selection/rotated.svg","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""}
  ]
}
