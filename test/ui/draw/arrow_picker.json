{
  "name":"Draw visual arrowhead pickers, mouse and keyboard choices",
  "html":"test/demo/draw/draw.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"select_option","target":{"selector":"#object-list"},"value":"e1"},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"value","equals":"triangle"},
    {"type":"assert_text","target":{"selector":"#prop-end-arrow"},"equals":""},
    {"type":"click","target":{"selector":"#prop-end-arrow"}},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"aria-expanded","equals":"true"},
    {"type":"assert_focus","target":{"selector":"#end-arrow-option-triangle"}},
    {"type":"assert_count","target":{"selector":"#end-arrow-options .arrow-preview"},"count":6},
    {"type":"assert_count","target":{"selector":"#end-arrow-options marker"},"count":5},
    {"type":"assert_text","target":{"selector":"#end-arrow-options"},"equals":""},
    {"type":"render","file":"temp/draw/arrow-picker/end-menu.png"},
    {"type":"click","target":{"selector":"#end-arrow-option-diamond"}},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"value","equals":"diamond"},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"aria-expanded","equals":"false"},
    {"type":"assert_focus","target":{"selector":"#prop-end-arrow"}},
    {"type":"assert_attribute","target":{"selector":"#end-arrow-preview > svg > path"},"attribute":"marker-end","equals":"url(#preview-end-arrow)"},
    {"type":"assert_attribute","target":{"selector":"#preview-end-arrow path"},"attribute":"d","contains":"L 6 0"},
    {"type":"assert_attribute","target":{"selector":"#edge-e1 .connector-line"},"attribute":"marker-end","equals":"url(#arrow-end-e1)"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"1"},
    {"type":"key_press","key":"down"},
    {"type":"assert_focus","target":{"selector":"#end-arrow-option-diamond"}},
    {"type":"key_press","key":"down"},
    {"type":"assert_focus","target":{"selector":"#end-arrow-option-circle"}},
    {"type":"key_press","key":"enter"},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"value","equals":"circle"},
    {"type":"assert_count","target":{"selector":"#preview-end-arrow circle"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"2"},
    {"type":"click","target":{"selector":"#prop-start-arrow"}},
    {"type":"assert_focus","target":{"selector":"#start-arrow-option-none"}},
    {"type":"key_press","key":"end"},
    {"type":"assert_focus","target":{"selector":"#start-arrow-option-bar"}},
    {"type":"key_press","key":"enter"},
    {"type":"assert_attribute","target":{"selector":"#prop-start-arrow"},"attribute":"value","equals":"bar"},
    {"type":"assert_attribute","target":{"selector":"#start-arrow-preview > svg > path"},"attribute":"marker-start","equals":"url(#preview-start-arrow)"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"3"},
    {"type":"click","target":{"selector":"#prop-start-arrow"}},
    {"type":"key_press","key":"home"},
    {"type":"key_press","key":"escape"},
    {"type":"assert_attribute","target":{"selector":"#prop-start-arrow"},"attribute":"value","equals":"bar"},
    {"type":"assert_attribute","target":{"selector":"#prop-start-arrow"},"attribute":"aria-expanded","equals":"false"},
    {"type":"assert_focus","target":{"selector":"#prop-start-arrow"}},
    {"type":"click","target":{"selector":"#prop-end-arrow"}},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#prop-from-shape"}},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"aria-expanded","equals":"false"},
    {"type":"click","target":{"selector":"#prop-end-arrow"}},
    {"type":"click","target":{"selector":"#selection-title"}},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"aria-expanded","equals":"false"},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"select_option","target":{"selector":"#object-list"},"value":"e1"},
    {"type":"assert_attribute","target":{"selector":"#prop-start-arrow"},"attribute":"value","equals":"none"},
    {"type":"assert_count","target":{"selector":"#start-arrow-preview marker"},"count":0},
    {"type":"assert_attribute","target":{"selector":"#prop-end-arrow"},"attribute":"value","equals":"circle"},
    {"type":"click","target":{"selector":"#prop-end-arrow"}},
    {"type":"click","target":{"selector":"#end-arrow-option-none"}},
    {"type":"assert_attribute","target":{"selector":"#edge-e1 .connector-line"},"attribute":"marker-end","equals":"none"},
    {"type":"assert_count","target":{"selector":"#end-arrow-preview marker"},"count":0},
    {"type":"click","target":{"selector":"#prop-start-arrow"}},
    {"type":"render","file":"temp/draw/arrow-picker/start-menu.png"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""}
  ]
}
