{
  "name":"Drawing package canvases isolate identical vertex ids, paint servers, selection and history",
  "html":"test/ui/draw/_canvases.ls",
  "viewport":{"width":1200,"height":700},
  "events":[
    {"type":"assert_count","target":{"selector":".lambda-draw"},"count":2},
    {"type":"assert_count","target":{"selector":"#left-fill-a"},"count":1},
    {"type":"assert_count","target":{"selector":"#right-fill-a"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#left-arrow-end-e"},"attribute":"id","equals":"left-arrow-end-e"},
    {"type":"click","target":{"selector":"#left-shape-a"}},
    {"type":"assert_attribute","target":{"selector":"#left"},"attribute":"data-selection","equals":"a"},
    {"type":"assert_attribute","target":{"selector":"#right"},"attribute":"data-selection","equals":""},
    {"type":"pointer_drag","pointerType":"mouse","target":{"selector":"#left-shape-a"},"dx":40,"dy":20,"steps":3},
    {"type":"assert_attribute","target":{"selector":"#left"},"attribute":"data-history","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#right"},"attribute":"data-history","equals":"0"},
    {"type":"click","target":{"selector":"#left [data-draw-action='undo']"}},
    {"type":"assert_attribute","target":{"selector":"#left"},"attribute":"data-history","equals":"0"},
    {"type":"click","target":{"selector":"#right-shape-b"}},
    {"type":"assert_attribute","target":{"selector":"#right"},"attribute":"data-selection","equals":"b"},
    {"type":"type","target":{"selector":"#right-field-label"},"text":"Edited custom","clear":true},
    {"type":"click","target":{"selector":"#right [data-draw-action='select']"}},
    {"type":"assert_attribute","target":{"selector":"#right"},"attribute":"data-history","equals":"1"},
    {"type":"assert_text","target":{"selector":"#right-shape-b"},"contains":"Edited custom"},
    {"type":"assert_text","target":{"selector":"#left-shape-b"},"contains":"Custom"},
    {"type":"assert_attribute","target":{"selector":"#left"},"attribute":"data-error","equals":""},
    {"type":"assert_attribute","target":{"selector":"#right"},"attribute":"data-error","equals":""},
    {"type":"click","target":{"selector":"#left [data-draw-action='connect']"}},
    {"type":"pointer_drag","pointerType":"mouse","target":{"selector":"#left .draw-paper","offset_x":130,"offset_y":120},"dx":240,"dy":0,"steps":3},
    {"type":"assert_count","target":{"selector":"#left-edge-e1 .connector-line"},"count":1},
    {"type":"assert_count","target":{"selector":"#right-edge-e1"},"count":0},
    {"type":"assert_attribute","target":{"selector":"#left"},"attribute":"data-history","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#right"},"attribute":"data-history","equals":"1"},
    {"type":"click","target":{"selector":"#left [data-draw-action='undo']"}},
    {"type":"assert_count","target":{"selector":"#left-edge-e1"},"count":0},
    {"type":"assert_attribute","target":{"selector":"#left"},"attribute":"data-history","equals":"0"},
    {"type":"render","file":"temp/draw/package-canvases.png"}
  ]
}
