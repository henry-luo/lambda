{
  "name":"Draw editable connector arrowheads, ports, endpoint dragging and bends",
  "html":"test/demo/draw/draw.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"select_option","target":{"selector":"#object-list"},"value":"e1"},
    {"type":"click","target":{"selector":"#prop-start-arrow"}},
    {"type":"click","target":{"selector":"#start-arrow-option-diamond"}},
    {"type":"click","target":{"selector":"#prop-end-arrow"}},
    {"type":"click","target":{"selector":"#end-arrow-option-circle"}},
    {"type":"select_option","target":{"selector":"#prop-from-port"},"value":"north"},
    {"type":"select_option","target":{"selector":"#prop-to-port"},"value":"south"},
    {"type":"select_option","target":{"selector":"#prop-routing"},"value":"curved"},
    {"type":"select_option","target":{"selector":"#prop-stroke-style"},"value":"dash-dot"},
    {"type":"type","target":{"selector":"#prop-stroke-width"},"text":"4","clear":true},
    {"type":"type","target":{"selector":"#prop-label"},"text":"Customer route","clear":true},
    {"type":"type","target":{"selector":"#prop-label-position"},"text":"0.25","clear":true},
    {"type":"click","target":{"selector":"#selection-title"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"9"},
    {"type":"assert_attribute","target":{"selector":"#edge-e1 .connector-line"},"attribute":"marker-start","equals":"url(#arrow-start-e1)"},
    {"type":"assert_attribute","target":{"selector":"#edge-e1 .connector-line"},"attribute":"marker-end","equals":"url(#arrow-end-e1)"},
    {"type":"assert_attribute","target":{"selector":"#arrow-end-e1 circle"},"attribute":"r","equals":"5"},
    {"type":"assert_attribute","target":{"selector":"#edge-e1 .connector-line"},"attribute":"stroke-dasharray","equals":"16 8 0 8"},
    {"type":"assert_text","target":{"selector":"#edge-e1 text"},"equals":"Customer route"},
    {"type":"click","target":{"selector":"#reverse-edge"}},
    {"type":"assert_value","target":{"selector":"#prop-from-shape"},"equals":"n2"},
    {"type":"assert_value","target":{"selector":"#prop-to-shape"},"equals":"n1"},
    {"type":"assert_value","target":{"selector":"#prop-start-arrow"},"equals":"diamond"},
    {"type":"pointer_drag","pointerType":"mouse","target":{"selector":"#paper","offset_x":125,"offset_y":208},"dx":533,"dy":-56,"steps":4},
    {"type":"assert_value","target":{"selector":"#prop-to-shape"},"equals":"n4"},
    {"type":"assert_value","target":{"selector":"#prop-to-port"},"equals":"auto"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"11"},
    {"type":"pointer_drag","pointerType":"mouse","target":{"selector":"#paper","offset_x":506,"offset_y":263},"dx":-70,"dy":70,"steps":3},
    {"type":"assert_attribute","target":{"selector":"#edge-e1 .connector-line"},"attribute":"d","contains":"630"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"12"},
    {"type":"click","target":{"selector":"#reset-bend"}},
    {"type":"assert_attribute","target":{"selector":"#edge-e1 .connector-line"},"attribute":"d","not_contains":"630"},
    {"type":"select_option","target":{"selector":"#prop-to-shape"},"value":"n2"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","contains":"invalid"},
    {"type":"assert_value","target":{"selector":"#prop-to-shape"},"equals":"n4"},
    {"type":"select_option","target":{"selector":"#prop-to-shape"},"value":"n5"},
    {"type":"select_option","target":{"selector":"#prop-to-shape"},"value":"n4"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""},
    {"type":"render","file":"temp/draw/enhanced/connector.png"}
  ]
}
