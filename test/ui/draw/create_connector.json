      "pointerType": "touch",
      "dx": -83,
      "dy": 125,
      "steps": 3
    },
    {
      "type": "assert_attribute",
      "attribute": "data-edges",
      "equals": "5",
      "target": {
        "selector": "#draw"
      }
    },
    {
      "type": "assert_attribute",
      "attribute": "data-history",
      "equals": "4",
      "target": {
        "selector": "#draw"
      }
    },
    {
      "type": "assert_value",
      "equals": "",
      "target": {
        "selector": "#prop-from-shape"
      }
    },
    {
      "type": "assert_value",
      "equals": "n2",
      "target": {
        "selector": "#prop-to-shape"
      }
    },
    {
      "type": "assert_attribute",
      "attribute": "data-error",
      "equals": "",
