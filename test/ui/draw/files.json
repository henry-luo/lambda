{
  "name":"Draw editable JSON round trip, SVG export and modal keyboard",
  "html":"test/demo/draw/draw.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"click","target":{"selector":"#save"}},
    {"type":"assert_focus","target":{"selector":"#file-path"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-dialog","equals":"save"},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#file-cancel"}},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#file-confirm"}},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#file-path"}},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-dialog","equals":""},
    {"type":"click","target":{"selector":"#blank"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-shapes","equals":"0"},
    {"type":"click","target":{"selector":"#open"}},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-shapes","equals":"5"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-edges","equals":"4"},
    {"type":"click","target":{"selector":"#export"}},
    {"type":"assert_value","target":{"selector":"#file-path"},"equals":"temp/draw/diagram.svg"},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"diagram.svg"},
    {"type":"click","target":{"selector":"#open"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/draw/missing.json","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-dialog","equals":"open"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","not_equals":""},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-shapes","equals":"5"},
    {"type":"key_press","key":"escape"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-dialog","equals":""},
    {"type":"assert_focus","target":{"selector":"#open"}}
  ]
}
