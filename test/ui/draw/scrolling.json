    {"type": "key_press", "key": "right"},
    {"type": "assert_value", "target": {"selector": "#prop-x"}, "equals": "351"},
    {"type": "assert_rect", "target": {"selector": "#paper"}, "relative_to": "#stage", "x": 101, "y": -1, "tolerance": 2},
    {"type": "mouse_down", "target": {"selector": "#stage", "offset_x": 674, "offset_y": 160}},
    {"type": "assert_state_store", "target": {"selector": "#stage"}, "scrollbar_v_dragging": true},
