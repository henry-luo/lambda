    {"type": "assert_state_store", "target": {"selector": "#stage"}, "scrollbar_v_dragging": false},
    {"type": "mouse_down", "target": {"selector": "#stage", "offset_x": 360, "offset_y": 332}},
    {"type": "assert_state_store", "target": {"selector": "#stage"}, "scrollbar_h_dragging": true},
    {"type": "mouse_move", "target": {"selector": "#stage", "offset_x": 380, "offset_y": 332}},
    {"type": "mouse_up", "target": {"selector": "#stage", "offset_x": 380, "offset_y": 332}},
    {"type": "assert_state_store", "target": {"selector": "#stage"}, "scrollbar_h_dragging": false},
    {"type": "assert_attribute", "target": {"selector": "#draw"}, "attribute": "data-history", "equals": "1"},
    {"type": "click", "target": {"selector": "#fit"}},
