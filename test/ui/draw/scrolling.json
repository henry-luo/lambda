{
  "name": "Draw independent overflow panels, canvas scrollbars and selection after scrolling",
  "html": "test/demo/draw/draw.ls",
  "viewport": {"width": 1135, "height": 550},
  "events": [
    {"type": "advance_time", "ms": 50},
    {"type": "select_option", "target": {"selector": "#object-list"}, "value": "n2"},
    {"type": "assert_text", "target": {"selector": "#zoom-label"}, "equals": "38%"},
    {"type": "assert_rect", "target": {"selector": "#paper"}, "relative_to": "#stage", "x": 126, "y": 24, "tolerance": 2},
    {"type": "assert_pixel", "x": 208, "y": 140, "min_r": 185, "max_r": 200, "min_g": 185, "max_g": 200, "min_b": 185, "max_b": 200},
    {"type": "assert_pixel", "x": 1130, "y": 140, "min_r": 185, "max_r": 200, "min_g": 185, "max_g": 200, "min_b": 185, "max_b": 200},
    {"type": "scroll", "target": {"selector": ".library"}, "dx": 0, "dy": -1},
    {"type": "assert_state_store", "target": {"selector": ".library"}, "view_scroll_y": 50, "tolerance": 1},
    {"type": "scroll", "target": {"selector": ".inspector"}, "dx": 0, "dy": -1},
    {"type": "assert_state_store", "target": {"selector": ".inspector"}, "view_scroll_y": 50, "tolerance": 1},
    {"type": "assert_rect", "target": {"selector": "#paper"}, "relative_to": "#stage", "x": 126, "y": 24, "tolerance": 2},
    {"type": "scroll", "target": {"selector": "#stage"}, "dx": -0.5, "dy": -0.5},
