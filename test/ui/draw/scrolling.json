    {"type": "click", "target": {"selector": "#zoom-in"}},
    {"type": "click", "target": {"selector": "#zoom-in"}},
    {"type": "click", "target": {"selector": "#zoom-in"}},
    {"type": "click", "target": {"selector": "#zoom-in"}},
