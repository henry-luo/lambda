{
  "name":"Draw repaints consecutive connector previews while the pointer stays down",
  "html":"test/demo/draw/draw.ls",
  "viewport":{"width":1280,"height":820},
  "event_interval_ms":0,
  "input_turn_ms":0,
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"click","target":{"selector":"#blank"}},
    {"type":"click","target":{"selector":"#grid"}},
    {"type":"click","target":{"selector":"#tool-connect"}},
    {"type":"mouse_down","target":{"selector":"#paper","offset_x":100,"offset_y":100}},
    {"type":"mouse_move","target":{"selector":"#paper","offset_x":250,"offset_y":100}},
    {"type":"render_pending"},
    {"type":"assert_pixel","target":{"selector":"#edge-to-handle"},"force_render":false,"max_r":150,"max_g":190,"min_b":220,"search_radius":7},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-drag","equals":"connect"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"1"},
    {"type":"mouse_move","target":{"selector":"#paper","offset_x":350,"offset_y":200}},
    {"type":"render_pending"},
    {"type":"assert_pixel","target":{"selector":"#edge-to-handle"},"force_render":false,"max_r":150,"max_g":190,"min_b":220,"search_radius":7},
    {"type":"assert_pixel","target":{"selector":"#paper","offset_x":250,"offset_y":106},"force_render":false,"min_r":245,"min_g":245,"min_b":245},
    {"type":"mouse_move","target":{"selector":"#paper","offset_x":400,"offset_y":280}},
    {"type":"render_pending"},
    {"type":"assert_pixel","target":{"selector":"#edge-to-handle"},"force_render":false,"max_r":150,"max_g":190,"min_b":220,"search_radius":7},
    {"type":"assert_pixel","target":{"selector":"#paper","offset_x":356,"offset_y":200},"force_render":false,"min_r":245,"min_g":245,"min_b":245},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-drag","equals":"connect"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"1"},
    {"type":"render","file":"temp/draw/live-creation.png"},
    {"type":"mouse_up","target":{"selector":"#paper","offset_x":400,"offset_y":280}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-drag","equals":""},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"2"},
    {"type":"mouse_down","target":{"selector":"#edge-to-handle"}},
    {"type":"mouse_move","target":{"selector":"#paper","offset_x":450,"offset_y":180}},
    {"type":"render_pending"},
    {"type":"assert_pixel","target":{"selector":"#edge-to-handle"},"force_render":false,"max_r":150,"max_g":190,"min_b":220,"search_radius":7},
    {"type":"assert_pixel","target":{"selector":"#paper","offset_x":406,"offset_y":280},"force_render":false,"min_r":245,"min_g":245,"min_b":245},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-drag","equals":"to"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"2"},
    {"type":"mouse_move","target":{"selector":"#paper","offset_x":450,"offset_y":340}},
    {"type":"render_pending"},
    {"type":"assert_pixel","target":{"selector":"#edge-to-handle"},"force_render":false,"max_r":150,"max_g":190,"min_b":220,"search_radius":7},
    {"type":"assert_pixel","target":{"selector":"#paper","offset_x":456,"offset_y":180},"force_render":false,"min_r":245,"min_g":245,"min_b":245},
    {"type":"render","file":"temp/draw/live-endpoint.png"},
    {"type":"key_press","key":"Escape"},
    {"type":"render_pending"},
    {"type":"assert_pixel","target":{"selector":"#edge-to-handle"},"force_render":false,"max_r":150,"max_g":190,"min_b":220,"search_radius":7},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-drag","equals":""},
    {"type":"mouse_up","target":{"selector":"#paper","offset_x":450,"offset_y":340}},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"assert_count","target":{"selector":".connector-line"},"count":0}
  ]
}
