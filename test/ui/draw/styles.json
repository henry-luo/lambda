{
  "name":"Draw pattern fills, outline styles, text and style clipboard",
  "html":"test/demo/draw/draw.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"select_option","target":{"selector":"#object-list"},"value":"n2"},
    {"type":"select_option","target":{"selector":"#prop-variant"},"value":"cylinder"},
    {"type":"select_option","target":{"selector":"#prop-pattern"},"value":"crosshatch"},
    {"type":"type","target":{"selector":"#prop-fill"},"text":"#fff1d6","clear":true},
    {"type":"type","target":{"selector":"#prop-pattern-color"},"text":"#123456","clear":true},
    {"type":"type","target":{"selector":"#prop-stroke"},"text":"#654321","clear":true},
    {"type":"select_option","target":{"selector":"#prop-stroke-style"},"value":"dashed"},
    {"type":"type","target":{"selector":"#prop-stroke-width"},"text":"3","clear":true},
    {"type":"type","target":{"selector":"#prop-font-size"},"text":"20","clear":true},
    {"type":"select_option","target":{"selector":"#prop-font-weight"},"value":"bold"},
    {"type":"select_option","target":{"selector":"#prop-text-align"},"value":"left"},
    {"type":"type","target":{"selector":"#prop-opacity"},"text":"0.5","clear":true},
    {"type":"click","target":{"selector":"#selection-title"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-history","equals":"11"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 polygon"},"attribute":"fill","equals":"url(#fill-n2)"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 polygon"},"attribute":"stroke","equals":"#654321"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 polygon"},"attribute":"stroke-width","equals":"3"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 polygon"},"attribute":"stroke-dasharray","equals":"12 9"},
    {"type":"assert_attribute","target":{"selector":"#fill-n2 path"},"attribute":"stroke","equals":"#123456"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 text"},"attribute":"font-size","equals":"20"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 text"},"attribute":"font-weight","equals":"bold"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2 text"},"attribute":"text-anchor","equals":"start"},
    {"type":"assert_attribute","target":{"selector":"#shape-n2"},"attribute":"opacity","equals":"0.5"},
    {"type":"click","target":{"selector":"#copy-style"}},
    {"type":"select_option","target":{"selector":"#object-list"},"value":"n4"},
    {"type":"click","target":{"selector":"#paste-style"}},
    {"type":"assert_attribute","target":{"selector":"#shape-n4 rect"},"attribute":"fill","equals":"url(#fill-n4)"},
    {"type":"assert_attribute","target":{"selector":"#shape-n4 rect"},"attribute":"stroke-width","equals":"3"},
    {"type":"assert_attribute","target":{"selector":"#shape-n4 text"},"attribute":"font-weight","equals":"bold"},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"assert_attribute","target":{"selector":"#shape-n4 rect"},"attribute":"fill","equals":"#e4f4ed"},
    {"type":"click","target":{"selector":"#showcase"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-shapes","equals":"12"},
    {"type":"assert_count","target":{"selector":"#paper pattern"},"count":9},
    {"type":"assert_count","target":{"selector":"#shape-n10 polygon"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#shape-n12 rect"},"attribute":"fill","equals":"none"},
    {"type":"render","file":"temp/draw/enhanced/showcase.png"},
    {"type":"click","target":{"selector":"#export"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/draw/enhanced/showcase.svg","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#draw"},"attribute":"data-error","equals":""}
  ]
}
