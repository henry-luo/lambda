{
  "name": "upstream ProseMirror publishes authoritative state after physical typing",
  "html": "test/editable-editors/fixtures/prosemirror/typing.html",
  "viewport": {"width": 720, "height": 360},
  "events": [
    {"type": "assert_count", "target": {"selector": ".ProseMirror"}, "count": 1, "comment": "The parsed seed DOM is replaced by one live ProseMirror root."},
    {"type": "focus", "target": {"selector": ".ProseMirror"}},
    {"type": "key_press", "key": "End"},
    {"type": "type_physical", "target": {"selector": ".ProseMirror"}, "text": "!"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "seed!"}
  ]
}
