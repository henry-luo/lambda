{
  "name":"DBench cancels a streamed query export without publication",
  "html": "temp/dbench-prepared/stream_cancel/dbench/dbench.ls",
  "prepare": ["python3", "test/demo/dbench/tests/_prepare_ui.py", "stream_cancel"],
  "viewport":{"width":1280,"height":800},
  "input_turn_ms":0,
  "events":[
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"type","target":{"selector":"#sql"},"text":"WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<1000000) SELECT x FROM n","clear":true},
    {"type":"click","target":{"selector":"#run"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-mode","equals":"query"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"click","target":{"selector":"#export"}},
    {"type":"type","target":{"selector":"#export-path"},"text":"temp/dbench-stream-cancel.csv","clear":true},
    {"type":"select_option","target":{"selector":"#export-scope"},"value":"complete"},
    {"type":"click","target":{"selector":"#export-save"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Exported","assert_timeout":30000},
    {"type":"click","target":{"selector":"#cancel"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Cancellation requested"}
  ]
}
