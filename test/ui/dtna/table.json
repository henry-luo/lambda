{
 "name":"dtna table sorts, filters, pages and selects enabled typed rows across pages",
 "html":"test/ui/dtna/table.ls",
 "viewport":{"width":1000,"height":800},
 "events":[
  {"type":"assert_count","target":{"selector":"#people tbody [data-dtna-row]"},"count":2},
  {"type":"assert_text","target":{"selector":"#people [data-dtna-row='0'] strong"},"equals":"Cora"},
  {"type":"assert_text","target":{"selector":"#people [data-dtna-row='0'] td:nth-child(4)"},"equals":"30"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-expand='0']"}},
  {"type":"assert_text","target":{"selector":"#person-detail"},"equals":"Account details"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-select='0']"}},
  {"type":"assert_attribute","target":{"selector":"#people [data-dtna-table-all]"},"attribute":"aria-checked","equals":"true"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-select='1']"}},
  {"type":"assert_text","target":{"selector":"#chosen"},"equals":"[1]"},
  {"type":"click","target":{"selector":"#people [aria-label='Next page']"}},
  {"type":"assert_text","target":{"selector":"#page"},"equals":"2"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-select='2']"}},
  {"type":"assert_attribute","target":{"selector":"#people [data-dtna-table-all]"},"attribute":"aria-checked","equals":"mixed"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-all]"}},
  {"type":"assert_text","target":{"selector":"#chosen"},"equals":"[1, 3, 4]"},
  {"type":"click","target":{"selector":"#people [aria-label='Previous page']"}},
  {"type":"assert_attribute","target":{"selector":"#people [data-dtna-table-select='0']"},"attribute":"aria-checked","equals":"true"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-sort='1']"}},
  {"type":"assert_attribute","target":{"selector":"#people [aria-sort]"},"attribute":"aria-sort","equals":"ascending"},
  {"type":"assert_text","target":{"selector":"#people tbody strong"},"equals":"Ada"},
  {"type":"assert_text","target":{"selector":"#page"},"equals":"1"},
  {"type":"key_press","key":"enter"},
  {"type":"assert_attribute","target":{"selector":"#people [aria-sort]"},"attribute":"aria-sort","equals":"descending"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-filter='2'][data-dtna-filter-option='2']"}},
  {"type":"assert_count","target":{"selector":"#people tbody [data-dtna-row]"},"count":1},
  {"type":"assert_text","target":{"selector":"#people tbody strong"},"equals":"Ben"},
  {"type":"assert_text","target":{"selector":"#last"},"equals":"filter"},
  {"type":"click","target":{"selector":"#people [data-dtna-table-filter='2'][data-dtna-filter-option='0']"}},
  {"type":"assert_count","target":{"selector":"#people tbody [data-dtna-row]"},"count":2},
  {"type":"assert_text","target":{"selector":"#people tfoot"},"equals":"Four records"}
 ]
}
