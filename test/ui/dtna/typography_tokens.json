      "equals": "32px"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-small"
      },
      "height": 40,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-small-five"
      },
      "property": "font-size",
      "equals": "14px"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-small-five"
      },
      "height": 22,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-dynamic"
      },
