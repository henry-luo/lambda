    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-sibling"
      },
      "height": 24,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-draft"
      },
      "property": "font-size",
      "equals": "16px"
    },
    {
      "type": "click",
      "target": {
        "selector": "#font-draft"
      }
    },
    {
      "type": "key_press",
      "key": "end"
    },
    {
      "type": "type",
      "text": "ab"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-dynamic"
      },
      "property": "font-size",
