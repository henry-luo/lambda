    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-dynamic"
      },
      "height": 44,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-draft"
      },
      "property": "font-size",
      "equals": "20px"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#font-draft"
      },
      "equals": "seedab"
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#font-draft"
      }
    },
    {
      "type": "assert_caret",
      "target": {
        "selector": "#font-draft"
      },
      "char_offset": 6
    },
    {
      "type": "key_press",
      "key": "home"
    },
    {
      "type": "key_press",
      "key": "end",
      "mods_str": "shift"
    },
    {
      "type": "key_press",
      "key": "backspace"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-dynamic"
      },
      "property": "font-size",
      "equals": "28px"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-dynamic"
      },
      "height": 36,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-draft"
      },
      "property": "font-size",
      "equals": "16px"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#font-draft"
      },
      "equals": ""
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#font-draft"
      }
    },
    {
      "type": "assert_caret",
      "target": {
        "selector": "#font-draft"
      },
      "char_offset": 0
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-sibling"
      },
      "property": "font-size",
      "equals": "16px"
    },
    {
      "type": "render",
      "file": "temp/ui_dtna/typography_tokens.png"
    }
  ]
}
