{
  "name": "dtna scoped heading token derivation and retained native editing",
  "html": "test/ui/dtna/typography_tokens.ls",
  "viewport": {
    "width": 600,
    "height": 900
  },
  "events": [
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-default"
      },
      "property": "font-size",
      "equals": "38px"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-default"
      },
      "height": 46,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-large"
      },
      "property": "font-size",
      "equals": "54px"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-large"
      },
      "height": 62,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-large-five"
      },
      "property": "font-size",
      "equals": "24px"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-large-five"
      },
      "height": 32,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-inherited"
      },
      "property": "font-size",
      "equals": "54px"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#font-inherited"
      },
      "height": 62,
      "tolerance": 0.2
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#font-small"
      },
