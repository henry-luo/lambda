{
  "name":"simple read-only small and total Pagination modes",
  "html":"test/ui/dtna/pagination_modes.ls",
  "viewport":{"width":800,"height":600},
  "events":[
    {"type":"assert_value","target":{"selector":"#simple-pages [data-dtna-page-simple]"},"equals":"3"},
    {"type":"click","target":{"selector":"#simple-pages [aria-label='Next page']"}},
    {"type":"assert_value","target":{"selector":"#simple-pages [data-dtna-page-simple]"},"equals":"4"},
    {"type":"click","target":{"selector":"#simple-pages [data-dtna-page-simple]"}},
    {"type":"type","clear":true,"text":"999"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_text","target":{"selector":"#last-request"},"equals":"simple-pages:100:10"},
    {"type":"assert_value","target":{"selector":"#simple-pages [data-dtna-page-simple]"},"equals":"100"},
    {"type":"key_press","key":"up"},
    {"type":"assert_value","target":{"selector":"#simple-pages [data-dtna-page-simple]"},"equals":"99"},
    {"type":"key_press","key":"down"},
    {"type":"assert_value","target":{"selector":"#simple-pages [data-dtna-page-simple]"},"equals":"100"},
    {"type":"type","clear":true,"text":"0"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_value","target":{"selector":"#simple-pages [data-dtna-page-simple]"},"equals":"1"},
    {"type":"type","clear":true,"text":"3"},
    {"type":"click","target":{"selector":"#blur-target"}},
    {"type":"assert_text","target":{"selector":"#last-request"},"equals":"simple-pages:3:10"},
    {"type":"assert_value","target":{"selector":"#simple-pages [data-dtna-page-simple]"},"equals":"3"},
    {"type":"click","target":{"selector":"#fixed-simple [data-dtna-page-simple]"}},
    {"type":"type","clear":true,"text":"7"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_text","target":{"selector":"#last-request"},"equals":"fixed-simple:7:10"},
    {"type":"assert_value","target":{"selector":"#fixed-simple [data-dtna-page-simple]"},"equals":"4"},
    {"type":"assert_count","target":{"selector":"#readonly-pages input"},"count":0},
    {"type":"click","target":{"selector":"#readonly-pages [aria-label='Previous page']"}},
    {"type":"assert_text","target":{"selector":"#readonly-pages .dtna-page-current"},"equals":"7"},
    {"type":"assert_rect","target":{"selector":"#small-pages button"},"height":24,"width":24,"tolerance":0.2},
    {"type":"assert_text","target":{"selector":"#small-pages .dtna-page-total"},"equals":"1–10 of 52"},
    {"type":"click","target":{"selector":"#small-pages [data-dtna-page='6']"}},
    {"type":"assert_text","target":{"selector":"#small-pages .dtna-page-total"},"equals":"51–52 of 52"},
    {"type":"assert_text","target":{"selector":"#empty-pages .dtna-page-total"},"equals":"0/0"},
    {"type":"assert_count","target":{"selector":"#single-page"},"count":0},
    {"type":"render","file":"temp/ui_dtna/pagination_modes.png"}
  ]
}
