{
  "name":"Repository diff mounts asynchronously, switches modes, loads untracked files and refreshes",
  "html":"temp/diff-ui-repository.ls",
  "prepare":["python3","test/ui/_diff_repository.py"],
  "viewport":{"width":1100,"height":720},
  "default_timeout":15000,
  "events":[
    {"type":"wait","ms":150},
    {"type":"assert_text","target":{"selector":".diff-status"},"contains":"2 changed files"},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"working"},
    {"type":"click","target":{"selector":"[data-diff-mode=staged]"}},
    {"type":"wait","ms":100},
    {"type":"assert_text","target":{"selector":".diff-status"},"contains":"1 changed files"},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"original"},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"staged"},
    {"type":"click","target":{"selector":"[data-diff-mode=unstaged]"}},
    {"type":"wait","ms":100},
    {"type":"assert_text","target":{"selector":".diff-status"},"contains":"2 changed files"},
    {"type":"click","target":{"selector":"[data-diff-id='1']"}},
    {"type":"wait","ms":100},
    {"type":"assert_text","target":{"selector":".diff-file-header"},"contains":"untracked.txt"},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"untracked"},
    {"type":"click","target":{"selector":"[data-diff-command=refresh]"}},
    {"type":"wait","ms":100},
    {"type":"assert_text","target":{"selector":".diff-file-header"},"contains":"untracked.txt"},
    {"type":"assert_text","target":{"selector":".diff-status"},"contains":"2 changed files"},
    {"type":"click","target":{"selector":"[data-diff-id='0']"}},
    {"type":"wait","ms":100},
    {"type":"assert_text","target":{"selector":".diff-file-header"},"contains":"tracked.txt"},
    {"type":"assert_text","target":{"selector":".diff-status"},"contains":"2 changed files"},
    {"type":"click","target":{"selector":"[data-diff-mode=staged]"}},
    {"type":"click","target":{"selector":"[data-diff-mode=working]"}},
    {"type":"wait","ms":100},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"working"},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"original"}
  ]
}
