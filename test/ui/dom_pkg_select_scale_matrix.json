{
  "name": "RSC12 select pointer-commit device-scale matrix",
  "html": "test/lambda/ui/dom_pkg_select.ls",
  "description": "The same logical select click opens the dropdown and commits the same option at four device scales. select_option resets to the first option between scales so each scale asserts the full open-commit-close cycle from the same start state.",
  "device_scale": 1.0,
  "events": [
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "a"},
    {"type": "click", "target": {"selector": ".sel"}},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": true},
    {"type": "click", "target": {"selector": ".sel", "offset_x": 20.25, "offset_y": 40.25}},
    {"type": "render_pending"},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "b"},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": false},
    {"type": "select_option", "target": {"selector": ".sel"}, "value": "a"},
    {"type": "render_pending"},

    {"type": "set_device_scale", "scale": 1.25},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "a"},
    {"type": "click", "target": {"selector": ".sel"}},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": true},
    {"type": "click", "target": {"selector": ".sel", "offset_x": 20.25, "offset_y": 40.25}},
    {"type": "render_pending"},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "b"},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": false},
    {"type": "select_option", "target": {"selector": ".sel"}, "value": "a"},
    {"type": "render_pending"},

    {"type": "set_device_scale", "scale": 1.5},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "a"},
    {"type": "click", "target": {"selector": ".sel"}},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": true},
    {"type": "click", "target": {"selector": ".sel", "offset_x": 20.25, "offset_y": 40.25}},
    {"type": "render_pending"},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "b"},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": false},
    {"type": "select_option", "target": {"selector": ".sel"}, "value": "a"},
    {"type": "render_pending"},

    {"type": "set_device_scale", "scale": 2.0},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "a"},
    {"type": "click", "target": {"selector": ".sel"}},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": true},
    {"type": "click", "target": {"selector": ".sel", "offset_x": 20.25, "offset_y": 40.25}},
    {"type": "render_pending"},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "b"},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": false},
    {"type": "select_option", "target": {"selector": ".sel"}, "value": "a"}
  ]
}
