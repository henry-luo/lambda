{
  "name": "Presentation opacity, transform and leaf visibility commit without layout; inherited visibility resolves descendants",
  "html": "test/ui/presentation_paint_only.ls",
  "viewport": {
    "width": 700,
    "height": 300
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#fade"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "paint-only"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "opacity",
      "equals": "0.5"
    },
    {
      "type": "click",
      "target": {
        "selector": "#toggle"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "eligible"
    },
    {
      "type": "click",
      "target": {
        "selector": "#move"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "paint-only"
    },
    {
      "type": "click",
      "x": 330,
      "y": 100
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#probe"
      },
      "attribute": "data-hit",
      "equals": "moved"
    },
    {
      "type": "click",
      "x": 230,
      "y": 100
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#probe"
      },
      "attribute": "data-hit",
      "equals": "probe"
    },
    {
      "type": "click",
      "target": {
        "selector": "#hide"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "paint-only"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#leaf"
      },
      "property": "visibility",
      "equals": "hidden"
    },
    {
      "type": "click",
      "target": {
        "selector": "#show"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "paint-only"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#leaf"
      },
      "min_r": 247,
      "max_g": 8,
      "max_b": 8
    },
    {
      "type": "click",
      "target": {
        "selector": "#hide-group"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "eligible"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#group > div"
      },
      "property": "visibility",
      "equals": "hidden"
    },
    {
      "type": "click",
      "target": {
        "selector": "#filter-color"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "paint-only"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#filtered"
      },
      "min_r": 126,
      "max_r": 129,
      "min_g": 126,
      "max_g": 129,
      "min_b": 126,
      "max_b": 129
    },
    {
      "type": "click",
      "target": {
        "selector": "#filter-spatial"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "eligible"
    },
    {
      "type": "click",
      "target": {
        "selector": "#filter-color"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "eligible"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#filtered"
      },
      "min_r": 126,
      "max_r": 129,
      "min_g": 126,
      "max_g": 129,
      "min_b": 126,
      "max_b": 129
    },
    {
      "type": "click",
      "target": {
        "selector": "#filter-none"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "eligible"
    },
    {
      "type": "click",
      "target": {
        "selector": "#filter-color"
      }
    },
    {
      "type": "assert_reconcile_mode",
      "mode": "incremental",
      "reason": "eligible"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#filtered"
      },
      "min_r": 126,
      "max_r": 129,
      "min_g": 126,
      "max_g": 129,
      "min_b": 126,
      "max_b": 129
    }
  ]
}