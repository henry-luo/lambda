{
  "name": "Grid resolved track lists retain used geometry and full computed reads",
  "html": "test/ui/css_grid_computed.html",
  "viewport": {
    "width": 640,
    "height": 480
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-pending",
      "equals": "1 / 1 / 2 / 3"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-pending-width",
      "equals": "50"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-pending-inline",
      "equals": "||var(--areas)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-placement-inline",
      "equals": "2 / Bar / span 3 / 4"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-plain",
      "equals": "[start] 20px [middle] 280px [end]"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-repeated",
      "equals": "[pre a] 20px [b a] 20px [b a] 20px [b post]"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-fit",
      "equals": "[a] 300px [b a] 0px [b a] 0px [b a] 0px [b]"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-implicit",
      "equals": "5px 5px [a] 20px [b] 5px 5px 5px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-areas",
      "equals": "10px 10px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-empty",
      "equals": "[first] 40px [last]"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-nongrid",
      "equals": "[a] 20px minmax(0px, 1fr)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-long",
      "equals": "999,200,10px 10px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-rows",
      "equals": "10px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-nogridrepeat",
      "equals": "repeat(2, [Red blue] 10px [tail])"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-inherited",
      "equals": "[Em] 20px 25%"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-keywordnames",
      "equals": "[Red] 20px [red] 30px [tail]"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-keyword-width",
      "equals": "20"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-adjacent",
      "equals": "none"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
