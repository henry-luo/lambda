    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-nogridrepeat",
      "equals": "repeat(2, [Red blue] 20px [tail])"
    },
    {
      "type": "click",
      "target": {
        "selector": "#restore"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#restored"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-placement",
      "equals": "2 / Bar / span 3 / 4"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-placement-var",
      "equals": "Foo / 3"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-placement-width",
      "equals": "50"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-pending",
      "equals": "1 / 1 / 2 / 3"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-pending-width",
      "equals": "50"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-pending-inline",
      "equals": "||var(--areas)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-placement-inline",
      "equals": "2 / Bar / span 3 / 4"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-plain",
      "equals": "[start] 20px [middle] 280px [end]"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-nogridrepeat",
