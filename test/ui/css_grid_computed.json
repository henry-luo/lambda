      "equals": "minmax(15px, 2fr) fit-content(calc(25% + 10px))"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-flow",
      "equals": "column dense"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-line",
      "equals": "span 2 Foo"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-placement",
      "equals": "2 / Bar / span 3 / 4"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-placement-copy",
      "equals": "Name"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-placement-var",
      "equals": "Foo / 3"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-decimal",
      "equals": "2"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-badspan",
      "equals": "Foo"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-mathline",
      "equals": "2"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-mathspan",
      "equals": "span 1"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-area-invalid",
      "equals": "Foo / Bar"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-bare-span",
      "equals": "2"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-placement-inherited",
      "equals": "Foo / Bar"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-placement-width",
      "equals": "50"
    },
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#changed"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
