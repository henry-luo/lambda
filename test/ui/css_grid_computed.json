      "equals": "2 / auto / span 3 / 4"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-placement-var",
      "equals": "Bar / 4"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-placement-width",
      "equals": "80"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-pending",
      "equals": "1 / auto / 2 / 3"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-pending-width",
      "equals": "30"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-pending-inline",
      "equals": "||"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-placement-inline",
      "equals": ""
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-changed-plain",
      "equals": "[start] 20px [middle] 380px [end]"
