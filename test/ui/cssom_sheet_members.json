{
  "name": "CSSOM stylesheet owners, nullable href and disabled cascade",
  "html": "test/ui/cssom_sheet_members.html",
  "viewport": {
    "width": 320,
    "height": 140
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-owner-node",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-parent-sheet",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-owner-rule",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-inline-href",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-constructed-owner",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-constructed-href",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-initial-enabled",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-disable-cascade",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-enable-cascade",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-disabled-coercion",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-constructed-disabled",
      "equals": "true"
    }
  ]
}
