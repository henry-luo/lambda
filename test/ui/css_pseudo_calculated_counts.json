{
  "name": "Pseudo calculated counts use pseudo and inherited declaration fonts",
  "html": "test/ui/css_pseudo_calculated_counts.html",
  "viewport": {
    "width": 480,
    "height": 200
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-values",
      "equals": "5|5|8|8"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#patch"
      },
      "width": 20,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 15,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-dirty-values",
      "equals": "7|7|8|8"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#patch"
      },
      "width": 28,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 25,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#inherit"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-inherited-values",
      "equals": "60|90|8|8"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#patch"
      },
      "width": 240,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 230,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    }
  ]
}
