{
  "name": "SVG hit queries reuse geometry without retaining stale styles, instances or scroll coordinates",
  "html": "test/ui/svg_hit_query_cache.html",
  "viewport": {
    "width": 360,
    "height": 220
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#scene"
      },
      "attribute": "data-hits",
      "equals": "glyph,sibling,overflow,scene,glyph,scene,glyph,sibling"
    },
    {
      "type": "assert_pixel",
      "x": 85,
      "y": 65,
      "min_b": 247,
      "max_r": 8,
      "max_g": 8
    },
    {
      "type": "assert_hit_test",
      "x": 10,
      "y": 45,
      "expected_selector": "#overflow"
    },
    {
      "type": "scroll",
      "x": 200,
      "y": 180,
      "dx": 0,
      "dy": -0.4
    },
    {
      "type": "assert_hit_test",
      "x": 85,
      "y": 45,
      "expected_selector": "#glyph"
    },
    {
      "type": "assert_hit_test",
      "x": 10,
      "y": 25,
      "expected_selector": "#overflow"
    }
  ]
}
