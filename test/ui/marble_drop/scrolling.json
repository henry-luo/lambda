{
  "name": "Marble Drop viewport thumb dragging, track paging and wheel scrolling at both densities",
  "html": "test/demo/marble-drop/marble-drop.ls",
  "viewport": {
    "width": 1200,
    "height": 800
  },
  "device_scale": 2,
  "event_interval_ms": 0,
  "input_turn_ms": 0,
  "events": [
    {
      "type": "assert_scroll",
      "y": 0,
      "tolerance": 0
    },
    {
      "type": "mouse_move",
      "x": 1194,
      "y": 40
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "html"
      },
      "scrollbar_v_hovered": true
    },
    {
      "type": "mouse_down",
      "x": 1194,
      "y": 40
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "html"
      },
      "scrollbar_v_dragging": true,
      "drag_active": true,
      "drag_target": true
    },
    {
      "type": "mouse_move",
      "x": 1194,
      "y": 150
    },
    {
      "type": "assert_scroll",
      "y": 100,
      "tolerance": 99
    },
    {
      "type": "assert_pixel",
      "x": 1194,
      "y": 40,
      "r": 246,
      "g": 246,
      "b": 246,
      "tolerance": 4
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/marble-drop/scroll-drag-2x.png"
    },
    {
      "type": "mouse_move",
      "x": 600,
      "y": 40
    },
    {
      "type": "assert_scroll",
