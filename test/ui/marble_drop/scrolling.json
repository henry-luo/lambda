      "type": "assert_state_store",
      "target": {
        "selector": "html"
      },
      "scrollbar_v_dragging": false,
      "drag_active": false,
      "drag_target": false
    },
    {
      "type": "mouse_down",
      "x": 1194,
      "y": 750
    },
    {
      "type": "assert_scroll",
      "y": 301.4,
      "tolerance": 1
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "html"
      },
      "scrollbar_v_dragging": false
    },
    {
      "type": "mouse_up",
