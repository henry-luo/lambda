{
  "html": "test/lambda/ui/dom_pkg_select.ls",
  "description": "RSC12: select pointer commit is invariant at device scale 2.0",
  "device_scale": 2.0,
  "events": [
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "a"},
    {"type": "click", "target": {"selector": ".sel"}},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": true},
    {"type": "click", "target": {"selector": ".sel", "offset_x": 20.25, "offset_y": 40.25}},
    {"type": "render_pending"},
    {"type": "assert_value", "target": {"selector": ".sel"}, "equals": "b"},
    {"type": "assert_state_store", "target": {"selector": ".sel"}, "open_dropdown": false}
  ]
}
