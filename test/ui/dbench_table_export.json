{
  "name": "DBench streams the filtered and sorted whole table while preserving its page",
  "html": "temp/dbench-prepared/table_export/dbench/dbench.ls",
  "prepare": ["python3", "test/demo/dbench/tests/_prepare_ui.py", "table_export"],
  "viewport": {"width": 1280, "height": 800},
  "input_turn_ms": 0,
  "events": [
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"click","target":{"selector":"[data-table=orders]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"select_option","target":{"selector":"#filter-column"},"value":"status"},
    {"type":"type","target":{"selector":"#filter-value"},"text":"new","clear":true},
    {"type":"click","target":{"selector":"#apply-filter"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"click","target":{"selector":"[data-sort=order_id]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"click","target":{"selector":"[data-sort=order_id]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"click","target":{"selector":"#next"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-offset","equals":"256","assert_timeout":30000},
    {"type":"click","target":{"selector":"#export"}},
    {"type":"type","target":{"selector":"#export-path"},"text":"temp/dbench-table-export.csv","clear":true},
    {"type":"select_option","target":{"selector":"#export-scope"},"value":"table"},
    {"type":"click","target":{"selector":"#export-save"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Created temp/dbench-table-export.csv","assert_timeout":60000},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-offset","equals":"256"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-table","equals":"orders"},
    {"type":"click","target":{"selector":"#next"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-offset","equals":"512","assert_timeout":30000},
    {"type":"type","target":{"selector":"#filter-value"},"text":"no-such-status","clear":true},
    {"type":"click","target":{"selector":"#apply-filter"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"0"},
    {"type":"click","target":{"selector":"#export"}},
    {"type":"type","target":{"selector":"#export-path"},"text":"temp/dbench-table-empty.csv","clear":true},
    {"type":"click","target":{"selector":"#export-save"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Created temp/dbench-table-empty.csv","assert_timeout":30000}
  ]
}
