    {
      "type": "assert_pixel",
      "x": 85,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 247,
      "max_g": 255,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 105,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 135,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
