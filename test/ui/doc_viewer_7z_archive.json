{
  "name": "Captured 7z member preview",
  "html": "test/input/archive/7z-solid.7z",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "events": [
    {
      "type": "assert_text",
      "target": {
        "selector": ".project-root .tree-label"
      },
      "equals": "7z-solid.7z"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='7z-solid.7z/file4'] > .tree-row .tree-label"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".document-name"
      },
      "equals": "file4"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#source-preview"
      },
      "equals": "aaaaaaaaaaaa\nbbbbbbbbbbbb\ncccccccccccc\ndddddddddddd\n"
    }
  ]
}
