{
  "name": "SMIL detached clock stops, pinned DOM survives and reattachment restores cached paint",
  "html": "test/ui/svg_smil_detach.html",
  "viewport": {
    "width": 380,
    "height": 150
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#mid"
      }
    },
    {
      "type": "assert_pixel",
      "x": 70,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 190,
      "y": 20,
      "min_r": 120,
      "max_r": 136,
      "min_g": 0,
      "max_g": 8,
      "min_b": 120,
      "max_b": 136
    },
    {
      "type": "click",
      "target": {
        "selector": "#detach"
      }
    },
    {
      "type": "assert_pixel",
      "x": 70,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 190,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "advance_time",
      "ms": 1000
    },
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-detached-time",
      "equals": "10"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-connected",
      "equals": "false"
    },
    {
      "type": "click",
      "target": {
        "selector": "#attach"
      }
    },
    {
      "type": "assert_pixel",
      "x": 120,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 70,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 190,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#rewind"
      }
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 120,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 190,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#moving"
      },
      "attribute": "x",
      "equals": "10"
    }
  ]
}
