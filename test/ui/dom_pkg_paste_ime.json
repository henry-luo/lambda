{
  "name": "F6: paste and IME-commit policy live in the dom package",
  "html": "test/ui/test_form_input.html",
  "viewport": { "width": 800, "height": 600 },
  "events": [
    { "type": "log", "message": "=== paste: CR/LF become spaces on a single-line control, CRLF collapsing to one ===" },
    { "type": "click", "target": { "selector": "#name" } },
    { "type": "paste_text", "target": { "selector": "#name" }, "text": "one\ntwo\r\nthree" },
    { "type": "assert_value", "target": { "selector": "#name" }, "equals": "one two three" },
    { "type": "log", "message": "paste is truncated to the maxlength budget, not rejected" },
    { "type": "click", "target": { "selector": "#code" } },
    { "type": "paste_text", "target": { "selector": "#code" }, "text": "abcdefgh" },
    { "type": "assert_value", "target": { "selector": "#code" }, "equals": "abcde" },
    { "type": "log", "message": "a textarea keeps its newlines" },
    { "type": "click", "target": { "selector": "#bio" } },
    { "type": "paste_text", "target": { "selector": "#bio" }, "text": "x\ny" },
    { "type": "assert_value", "target": { "selector": "#bio" }, "equals": "x\ny" },
    { "type": "log", "message": "=== IME commit obeys the same newline policy — native never did, so this differs by path ===" },
    { "type": "click", "target": { "selector": "#pwd" } },
    { "type": "ime_compose", "phase": "begin" },
    { "type": "ime_compose", "phase": "update", "preedit": "x", "caret": 1 },
    { "type": "ime_compose", "phase": "commit", "commit": "a\nb" },
    { "type": "assert_value", "target": { "selector": "#pwd" }, "equals": "a b" }
  ]
}
