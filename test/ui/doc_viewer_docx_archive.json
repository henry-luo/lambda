{
  "name": "View DOCX as a Word document",
  "html": "test/input/zip/office.docx",
  "viewport": {
    "width": 1280,
    "height": 1000
  },
  "events": [
    {
      "type": "assert_count",
      "target": {
        "selector": "#docx-preview .docx-document"
      },
      "count": 1
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#docx-preview p"
      },
      "equals": "Hello"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".project-tree"
      },
      "count": 0
    }
  ]
}
