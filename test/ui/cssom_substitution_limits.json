{
  "name": "CSSOM per-value substitution budgets and bounded empty dependencies",
  "html": "test/ui/cssom_substitution_limits.html",
  "viewport": {
    "width": 400,
    "height": 180
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-byte-boundary",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-byte-overflow",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-utf8-byte-budget",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-consumer-fallback",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-authored-retained",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-comments-count-bytes",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-token-boundary",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-token-overflow",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-unused-large-fallback",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-registered-default",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-registered-inheritance",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-owner-inheritance",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live-budget-recompute",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-empty-dag",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-empty-live-recompute",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#verify"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-used-fallback-width",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-used-invalid-padding",
      "equals": "true"
    }
  ]
}
