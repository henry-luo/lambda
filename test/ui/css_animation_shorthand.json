{
  "name": "Animation shorthand reaches cascade, computed style and frame sampling",
  "html": "test/ui/css_animation_shorthand.html",
  "viewport": {"width": 240, "height": 340},
  "events": [
    {"type": "assert_style", "target": {"selector": "#single"}, "property": "animation-name", "equals": "fade"},
    {"type": "assert_style", "target": {"selector": "#multiple"}, "property": "animation-duration", "equals": "2s, 4s"},
    {"type": "assert_style", "target": {"selector": "#paused"}, "property": "animation-play-state", "equals": "paused"},
    {"type": "assert_style", "target": {"selector": "#override"}, "property": "animation-duration", "equals": "4s"},
    {"type": "assert_style", "target": {"selector": "#single"}, "property": "opacity", "equals": "0.5", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#multiple"}, "property": "width", "equals": "40px", "animated": true, "tolerance": 0.1},
    {"type": "assert_style", "target": {"selector": "#paused"}, "property": "opacity", "equals": "0.5", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#override"}, "property": "opacity", "equals": "0.25", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#reset"}, "property": "opacity", "equals": "1"},
    {"type": "assert_style", "target": {"selector": "#variables"}, "property": "opacity", "equals": "0.5", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#repeated"}, "property": "opacity", "equals": "0.5", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#quoted"}, "property": "opacity", "equals": "0.5", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#stepstart"}, "property": "opacity", "equals": "0.25", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#stepboth"}, "property": "opacity", "equals": "0.4", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#stepnone"}, "property": "opacity", "equals": "0.333333", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#delayed"}, "property": "opacity", "equals": "0", "animated": true, "tolerance": 0.01},
    {"type": "advance_time", "ms": 500, "steps": 10},
    {"type": "assert_style", "target": {"selector": "#single"}, "property": "opacity", "equals": "0.75", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#multiple"}, "property": "width", "equals": "45px", "animated": true, "tolerance": 0.1},
    {"type": "assert_style", "target": {"selector": "#paused"}, "property": "opacity", "equals": "0.5", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#repeated"}, "property": "opacity", "equals": "0.75", "animated": true, "tolerance": 0.01},
    {"type": "click", "target": {"selector": "#change"}},
    {"type": "assert_style", "target": {"selector": "#paused"}, "property": "opacity", "equals": "0.25", "animated": true, "tolerance": 0.01},
    {"type": "advance_time", "ms": 2000, "steps": 20},
    {"type": "assert_style", "target": {"selector": "#fraction"}, "property": "opacity", "equals": "0.5", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#expired"}, "property": "opacity", "equals": "1", "animated": true, "tolerance": 0.01},
    {"type": "click", "target": {"selector": "#change"}},
    {"type": "advance_time", "ms": 100, "steps": 2},
    {"type": "assert_style", "target": {"selector": "#expired"}, "property": "opacity", "equals": "1", "animated": true, "tolerance": 0.01},
    {"type": "assert_style", "target": {"selector": "#paused"}, "property": "opacity", "equals": "0.25", "animated": true, "tolerance": 0.01}
  ]
}
