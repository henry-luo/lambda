{
  "name": "Document editor previews TSV as a resizable table",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1600},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "test_tab.tsv"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_tab_tsv .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#csv-preview table.csv-table"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".csv-table thead th"}, "count": 3},
    {"type": "assert_count", "target": {"selector": ".csv-table tbody tr"}, "count": 200},
    {"type": "assert_text", "target": {"selector": ".csv-table thead th", "index": 0}, "equals": "test_name"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:nth-child(2) td", "index": 2}, "equals": "4971"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:nth-child(3) td", "index": 0}, "equals": "annexB\tquoted_name"},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 150, "tolerance": 5},
    {"type": "mouse_drag", "target": {"selector": ".csv-table thead th:first-child .csv-resize", "offset_x": 5, "offset_y": 12}, "dx": 70, "dy": 0, "button": 0},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 220, "tolerance": 5},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "test_name\texit_code\telapsed_us"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 220, "tolerance": 5},
    {"type": "assert_count", "target": {"selector": ".csv-more"}, "count": 1},
    {"type": "scroll", "target": {"selector": "#csv-preview"}, "dx": 0, "dy": -200},
    {"type": "click", "target": {"selector": ".csv-more"}},
    {"type": "assert_count", "target": {"selector": ".csv-table tbody tr"}, "count": 204},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:last-child td", "index": 0}, "equals": "case_0201"},
    {"type": "assert_count", "target": {"selector": ".csv-more"}, "count": 0},
    {"type": "render", "file": "./temp/doc_editor_tsv_table.png"}
  ]
}
