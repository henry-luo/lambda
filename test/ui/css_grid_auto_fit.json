{
  "name": "Auto-fit preserves placement before collapsing tracks and gutters",
  "html": "test/ui/css_grid_auto_fit.html",
  "viewport": {
    "width": 640,
    "height": 480
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-last",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-separated",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-flex",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-negative",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-span",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-row",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-negative-implicit",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-normal-implicit",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-between",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-around",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-percentage-gap",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-neighbors",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-pattern",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-font",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-variable",
      "equals": "true"
    },
    {
      "type": "assert_pixel",
      "x": 10,
      "y": 45,
      "min_r": 0,
      "max_r": 5,
      "min_g": 125,
      "max_g": 131,
      "min_b": 0,
      "max_b": 5
    },
    {
      "type": "assert_pixel",
      "x": 75,
      "y": 45,
      "min_r": 250,
      "max_r": 255,
      "min_g": 250,
      "max_g": 255,
      "min_b": 250,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#changed"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-insert-resize",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-font-change",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-variable-change",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#restore"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#restored"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-remove-restore",
      "equals": "true"
    }
  ]
}
