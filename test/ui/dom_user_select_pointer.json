{
  "name":"Pointer selection honors user-select none, auto descendants and text overrides",
  "html":"test/ui/dom_user_select_pointer.html",
  "viewport":{"width":640,"height":500},
  "events":[
    {"type":"assert_script","js":"getComputedStyle(document.querySelector('section')).userSelect==='none' && getComputedStyle(document.getElementById('automatic')).userSelect==='auto' && getComputedStyle(document.getElementById('override')).userSelect==='text'"},
    {"type":"script","js":"window.getSelection().removeAllRanges()"},
    {"type":"mouse_down","target":{"selector":"#blocked","offset_x":10,"offset_y":14}},
    {"type":"mouse_move","target":{"selector":"#blocked","offset_x":150,"offset_y":14}},
    {"type":"mouse_up","target":{"selector":"#blocked","offset_x":150,"offset_y":14}},
    {"type":"assert_selection","is_collapsed":true,"check_dom":true},
    {"type":"assert_focus","target":{"selector":"#button"}},
    {"type":"dblclick","target":{"selector":"#blocked","offset_x":70,"offset_y":14}},
    {"type":"assert_selection","is_collapsed":true,"check_dom":true},
    {"type":"script","js":"window.getSelection().removeAllRanges()"},
    {"type":"mouse_down","target":{"selector":"#automatic","offset_x":10,"offset_y":14}},
    {"type":"mouse_move","target":{"selector":"#automatic","offset_x":150,"offset_y":14}},
    {"type":"mouse_up","target":{"selector":"#automatic","offset_x":150,"offset_y":14}},
    {"type":"assert_selection","is_collapsed":true,"check_dom":true},
    {"type":"script","js":"window.getSelection().removeAllRanges()"},
    {"type":"mouse_down","target":{"selector":"#override","offset_x":10,"offset_y":14}},
    {"type":"mouse_move","target":{"selector":"#override","offset_x":150,"offset_y":14}},
    {"type":"mouse_up","target":{"selector":"#override","offset_x":150,"offset_y":14}},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"script","js":"window.getSelection().removeAllRanges()"},
    {"type":"mouse_down","target":{"selector":"#ordinary","offset_x":10,"offset_y":14}},
    {"type":"mouse_move","target":{"selector":"#ordinary","offset_x":150,"offset_y":14}},
    {"type":"mouse_up","target":{"selector":"#ordinary","offset_x":150,"offset_y":14}},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"script","js":"window.getSelection().removeAllRanges()"},
    {"type":"mouse_down","target":{"selector":"#input","offset_x":10,"offset_y":14}},
    {"type":"mouse_move","target":{"selector":"#input","offset_x":150,"offset_y":14}},
    {"type":"mouse_up","target":{"selector":"#input","offset_x":150,"offset_y":14}},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
