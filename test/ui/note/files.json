{
  "name":"Notes atomic saves, overwrite, external changes, Open and close guard",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"write_file","path":"temp/note/ui.note.json","content":"old notebook"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"paste_text","target":{"selector":"#edit-surface p"},"text":"A thought to keep"},
    {"type":"key_combo","key":"s","mods_str":"ctrl"},
    {"type":"assert_focus","target":{"selector":"#dialog-value"}},
    {"type":"set_editing_selection","target":{"selector":"#dialog-value"},"start":0,"end":1000},
    {"type":"paste_text","target":{"selector":"#dialog-value"},"text":"temp/note/ui.note.json"},
    {"type":"click","target":{"selector":"#dialog-confirm"}},
    {"type":"assert_text","target":{"selector":".dialog-card h2"},"equals":"Replace Notebook?"},
    {"type":"assert_file","path":"temp/note/ui.note.json","equals":"old notebook"},
    {"type":"click","target":{"selector":"#dialog-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-dirty","equals":"false"},
    {"type":"assert_file","path":"temp/note/ui.note.json","contains":"A thought to keep"},
    {"type":"assert_file","path":"temp/note/ui.note.json","contains":"lambda-notes"},
    {"type":"write_file","path":"temp/note/ui.note.json","content":"external change"},
    {"type":"key_combo","key":"s","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":".dialog-card h2"},"equals":"Notebook Changed"},
    {"type":"assert_file","path":"temp/note/ui.note.json","equals":"external change"},
    {"type":"click","target":{"selector":"#dialog-cancel"}},
    {"type":"assert_count","target":{"selector":".dialog-card"},"count":0},
    {"type":"key_combo","key":"s","mods_str":"ctrl"},
    {"type":"click","target":{"selector":"#dialog-confirm"}},
    {"type":"assert_file","path":"temp/note/ui.note.json","contains":"A thought to keep"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"key_combo","key":"o","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":".dialog-card h2"},"equals":"Save Your Notes?"},
    {"type":"click","target":{"selector":"#dialog-cancel"}},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-dirty","equals":"true"},
    {"type":"key_combo","key":"o","mods_str":"ctrl"},
    {"type":"click","target":{"selector":"#dialog-discard"}},
    {"type":"paste_text","target":{"selector":"#dialog-value"},"text":"temp/note/ui.note.json"},
    {"type":"click","target":{"selector":"#dialog-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-dirty","equals":"false"},
    {"type":"assert_count","target":{"selector":".note-row"},"count":8},
    {"type":"click","target":{"selector":"#row-note-20"}},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"A thought to keep"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-dirty","equals":"true"},
    {"type":"click","target":{"selector":"#more"}},
    {"type":"click","target":{"selector":"#close-notebook"}},
    {"type":"assert_text","target":{"selector":".dialog-card h2"},"equals":"Save Your Notes?"},
    {"type":"click","target":{"selector":"#dialog-cancel"}},
    {"type":"assert_window_closed","closed":false},
    {"type":"capture_surface","source":"page","file":"temp/note/files.png"}
  ]
}
