{
  "name":"Notes toolbar marks, text colors and highlights preserve the selected text",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"type_physical","text":"Color Notes"},
    {"type":"assert_count","target":{"selector":".editor-tools #bold,.editor-tools #italic,.editor-tools #underline"},"count":3},
    {"type":"click","target":{"selector":"#format-note"}},
    {"type":"assert_count","target":{"selector":".format-popover #bold,.format-popover #italic,.format-popover #underline"},"count":0},
    {"type":"assert_count","target":{"selector":".format-popover #bullets"},"count":1},
    {"type":"key_press","key":"escape"},
    {"type":"set_editing_selection","target":{"selector":"#edit-surface p"},"start":0,"end":5},
    {"type":"click","target":{"selector":"#bold"}},
    {"type":"assert_text","target":{"selector":"#edit-surface strong"},"equals":"Color"},
    {"type":"click","target":{"selector":"#italic"}},
    {"type":"assert_text","target":{"selector":"#edit-surface em"},"equals":"Color"},
    {"type":"click","target":{"selector":"#underline"}},
    {"type":"assert_text","target":{"selector":"#edit-surface u"},"equals":"Color"},
    {"type":"click","target":{"selector":"#text-color"}},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"click","target":{"selector":"#color-red"}},
    {"type":"assert_text","target":{"selector":"#edit-surface span[style]"},"equals":"Color"},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"color","equals":"rgb(196, 72, 63)"},
    {"type":"click","target":{"selector":"#highlight"}},
    {"type":"click","target":{"selector":"#highlight-yellow"}},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"background-color","equals":"rgb(255, 240, 155)"},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"color","equals":"rgb(196, 72, 63)"},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"click","target":{"selector":"#text-color"}},
    {"type":"type","target":{"selector":"#color-value"},"text":"#bad","clear":true},
    {"type":"click","target":{"selector":"#color-apply"}},
    {"type":"assert_count","target":{"selector":"#color-picker .color-error"},"count":1},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"color","equals":"rgb(196, 72, 63)"},
    {"type":"type","target":{"selector":"#color-value"},"text":"#204060","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#color-picker"},"count":0},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"color","equals":"rgb(32, 64, 96)"},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"background-color","equals":"rgb(255, 240, 155)"},
    {"type":"click","target":{"selector":"#highlight"}},
    {"type":"click","target":{"selector":"#color-clear"}},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"background-color","equals":"rgba(0, 0, 0, 0)"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"background-color","equals":"rgb(255, 240, 155)"},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"capture_surface","source":"page","file":"temp/note/formatting.png"},
    {"type":"click","target":{"selector":"#folder-all"}},
    {"type":"click","target":{"selector":"#row-weekend"}},
    {"type":"click","target":{"selector":"#row-note-20"}},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"color","equals":"rgb(32, 64, 96)"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"click","target":{"selector":"#text-color"}},
    {"type":"click","target":{"selector":"#color-blue"}},
    {"type":"type_physical","text":"Blue"},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Blue"},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"color","equals":"rgb(53, 110, 181)"},
    {"type":"assert_style","target":{"selector":"#edit-surface p span:last-child"},"property":"color","equals":"rgb(53, 110, 181)"},
    {"type":"assert_caret","target":{"selector":"#edit-surface p span:last-child"},"visible":true},
    {"type":"click","target":{"selector":"#highlight"}},
    {"type":"capture_surface","source":"page","file":"temp/note/highlight-picker.png"},
    {"type":"key_press","key":"escape"},
    {"type":"resize","width":840,"height":650},
    {"type":"assert_script","js":"['bold','italic','underline','text-color','highlight'].every(function(id){var b=document.getElementById(id).getBoundingClientRect();return b.width>0&&b.x>=0&&b.x+b.width<=840})"},
    {"type":"click","target":{"selector":"#text-color"}},
    {"type":"capture_surface","source":"page","file":"temp/note/color-picker-compact.png"}
  ]
}
