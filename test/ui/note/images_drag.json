{
  "name":"Notes moves selected images with mouse and touch, drop caret, cancellation and undo",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"paste_text","text":"Before\nDestination words\nList item\n","html":"<p>Before</p><p>Destination words</p><ul><li>List item</li></ul><p></p>"},
    {"type":"paste_image","file":"test/ui/note/fixtures/clipboard.png"},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:last-child img"},"count":1},
    {"type":"click","target":{"selector":"#edit-surface img"}},
    {"type":"click","target":{"selector":"#image-smaller"}},
    {"type":"mouse_down","target":{"selector":"#image-move"}},
    {"type":"mouse_move","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2)","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#image-drop-caret"},"count":1},
    {"type":"assert_script","js":"var b=document.querySelector('#image-drop-caret').getBoundingClientRect(); b.width===2&&b.height>0"},
    {"type":"capture_surface","source":"page","file":"temp/note/image-drag-caret.png"},
    {"type":"mouse_up","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2)","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2) > img:first-child"},"count":1},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:last-child img"},"count":0},
    {"type":"assert_count","target":{"selector":"#edit-surface img"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img"},"attribute":"width","equals":"128"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img"},"attribute":"height","equals":"80"},
    {"type":"assert_text","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2)"},"equals":"Destination words"},
    {"type":"click","button":1,"target":{"selector":"#image-move"}},
    {"type":"assert_count","target":{"selector":"#note-context-menu"},"count":1},
    {"type":"click","target":{"selector":"#context-copy"}},
    {"type":"assert_clipboard","mime":"image/png","file":"test/ui/note/fixtures/clipboard.png"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:last-child img"},"count":1},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2) img"},"count":0},
    {"type":"key_combo","key":"z","mods_str":"ctrl+shift"},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2) > img:first-child"},"count":1},
    {"type":"mouse_drag","target":{"selector":"#image-move"},"to_target":{"selector":"#edit-surface .edit-doc > p:nth-child(2)","offset_x":300,"offset_y":10}},
    {"type":"assert_script","js":"var p=document.querySelector('#edit-surface .edit-doc > p:nth-child(2)');p.lastChild===p.querySelector('img')"},
    {"type":"assert_text","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2)"},"equals":"Destination words"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2) > img:first-child"},"count":1},
    {"type":"mouse_down","target":{"selector":"#image-move"}},
    {"type":"mouse_move","target":{"selector":"#edit-surface .edit-doc > p:first-child","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#image-drop-caret"},"count":1},
    {"type":"key_press","key":"escape"},
    {"type":"assert_count","target":{"selector":"#image-drop-caret"},"count":0},
    {"type":"mouse_up","target":{"selector":"#edit-surface .edit-doc > p:first-child","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2) > img:first-child"},"count":1},
    {"type":"mouse_drag","target":{"selector":"#image-move"},"to_target":{"selector":"#note-list"}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:nth-child(2) > img:first-child"},"count":1},
    {"type":"pointer_drag","target":{"selector":"#image-move"},"pointerType":"touch","to_target":{"selector":"#edit-surface .edit-doc > p:first-child","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:first-child > img:first-child"},"count":1},
    {"type":"pointer_drag","target":{"selector":"#image-move"},"pointerType":"touch","to_target":{"selector":"#edit-surface .edit-doc > p:last-child","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:last-child > img"},"count":1},
    {"type":"assert_script","js":"var a=document.querySelector('#edit-surface img').getBoundingClientRect(),b=document.querySelector('#image-tools').getBoundingClientRect();Math.abs(a.x-b.x)<3&&Math.abs(a.y-b.y)<3&&Math.abs(a.width-b.width)<5"},
    {"type":"mouse_drag","target":{"selector":"#image-move"},"to_target":{"selector":"#edit-surface li","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface li img"},"count":1},
    {"type":"assert_text","target":{"selector":"#edit-surface li"},"equals":"List item"},
    {"type":"assert_count","target":{"selector":"#edit-surface img"},"count":1},
    {"type":"click","target":{"selector":"#image-larger"}},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img"},"attribute":"width","equals":"160"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#edit-surface img"},"attribute":"width","equals":"128"},
    {"type":"capture_surface","source":"page","file":"temp/note/image-drag-final.png"},
    {"type":"click","target":{"selector":"#edit-surface .edit-doc > p:first-child","offset_x":300,"offset_y":10}},
    {"type":"paste_image","file":"test/ui/note/fixtures/clipboard.png"},
    {"type":"assert_count","target":{"selector":"#edit-surface img"},"count":2},
    {"type":"click","target":{"selector":"#edit-surface li img"}},
    {"type":"mouse_drag","target":{"selector":"#image-move"},"to_target":{"selector":"#edit-surface .edit-doc > p:first-child","offset_x":2,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:first-child img"},"count":2},
    {"type":"assert_count","target":{"selector":"#edit-surface li img"},"count":0},
    {"type":"assert_attribute","target":{"selector":"#edit-surface .edit-doc > p:first-child img:first-of-type"},"attribute":"width","equals":"128"},
    {"type":"assert_script","js":"var imgs=document.querySelectorAll('#edit-surface .edit-doc > p:first-child img');imgs[1].getBoundingClientRect().width===160"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_count","target":{"selector":"#edit-surface li img"},"count":1},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-doc > p:first-child img"},"count":1}
  ]
}
