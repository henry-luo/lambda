{
  "name":"Notes list marker clicks place the caret at the current item start",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"paste_text","text":"Above\nFirst\nSecond\nNumbered\nWrapped","html":"<p>Above</p><ul><li>First</li><li><p>Second</p></li></ul><ol><li>Numbered</li><li><p>Wrapped</p></li></ol>"},
    {"type":"click","target":{"selector":"#edit-surface ul > li:first-child","offset_x":-14,"offset_y":10}},
    {"type":"assert_caret","target":{"selector":"#edit-surface ul > li:first-child"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"X"},
    {"type":"assert_text","target":{"selector":"#edit-surface ul > li:first-child"},"equals":"XFirst"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface ul > li:first-child"},"equals":"First"},
    {"type":"click","target":{"selector":"#edit-surface ul > li:nth-child(2) p","offset_x":-14,"offset_y":10}},
    {"type":"assert_caret","target":{"selector":"#edit-surface ul > li:nth-child(2) p"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"X"},
    {"type":"assert_text","target":{"selector":"#edit-surface ul > li:nth-child(2) p"},"equals":"XSecond"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface ul > li:nth-child(2) p"},"equals":"Second"},
    {"type":"click","target":{"selector":"#edit-surface ol > li:first-child","offset_x":-14,"offset_y":10}},
    {"type":"assert_caret","target":{"selector":"#edit-surface ol > li:first-child"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"X"},
    {"type":"assert_text","target":{"selector":"#edit-surface ol > li:first-child"},"equals":"XNumbered"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface ol > li:first-child"},"equals":"Numbered"},
    {"type":"click","target":{"selector":"#edit-surface ol > li:nth-child(2) p","offset_x":-14,"offset_y":10}},
    {"type":"assert_caret","target":{"selector":"#edit-surface ol > li:nth-child(2) p"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"X"},
    {"type":"assert_text","target":{"selector":"#edit-surface ol > li:nth-child(2) p"},"equals":"XWrapped"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface ol > li:nth-child(2) p"},"equals":"Wrapped"},
    {"type":"assert_text","target":{"selector":"#edit-surface .edit-doc > p"},"equals":"Above"},
    {"type":"capture_surface","source":"page","file":"temp/note/list-marker-caret.png"}
  ]
}
