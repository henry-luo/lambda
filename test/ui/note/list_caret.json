{
  "name":"Notes retains the caret after list Enter and marker autoformat",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"paste_text","text":"First","html":"<ul><li>First</li></ul>"},
    {"type":"assert_text","target":{"selector":"#edit-surface ul > li"},"equals":"First"},
    {"type":"click","target":{"selector":"#edit-surface ul > li","offset_x":100,"offset_y":10}},
    {"type":"assert_caret","target":{"selector":"#edit-surface ul > li"},"visible":true,"char_offset":5},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface ul > li"},"count":2},
    {"type":"assert_caret","target":{"selector":"#edit-surface ul > li:nth-child(2)"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"Second"},
    {"type":"assert_text","target":{"selector":"#edit-surface ul > li:nth-child(2)"},"equals":"Second"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface ul > li"},"count":3},
    {"type":"assert_caret","target":{"selector":"#edit-surface ul > li:nth-child(3)"},"visible":true,"char_offset":0},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface ul > li"},"count":2},
    {"type":"assert_caret","target":{"selector":"#edit-surface .edit-doc > p"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"After"},
    {"type":"assert_text","target":{"selector":"#edit-surface .edit-doc > p"},"equals":"After"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"type_physical","text":"-"},
    {"type":"type_physical","text":" "},
    {"type":"assert_count","target":{"selector":"#edit-surface ul > li"},"count":1},
    {"type":"assert_caret","target":{"selector":"#edit-surface ul > li"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"Bullet"},
    {"type":"assert_text","target":{"selector":"#edit-surface ul > li"},"equals":"Bullet"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_caret","target":{"selector":"#edit-surface ul > li:nth-child(2)"},"visible":true,"char_offset":0},
    {"type":"capture_surface","source":"page","file":"temp/note/list-caret-bullet.png"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"type_physical","text":"1."},
    {"type":"type_physical","text":" "},
    {"type":"assert_count","target":{"selector":"#edit-surface ol > li"},"count":1},
    {"type":"assert_caret","target":{"selector":"#edit-surface ol > li"},"visible":true,"char_offset":0},
    {"type":"type_physical","text":"Numbered"},
    {"type":"assert_text","target":{"selector":"#edit-surface ol > li"},"equals":"Numbered"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_caret","target":{"selector":"#edit-surface ol > li:nth-child(2)"},"visible":true,"char_offset":0},
    {"type":"capture_surface","source":"page","file":"temp/note/list-caret-ordered.png"},
    {"type":"click","target":{"selector":"#folder-all"}},
    {"type":"click","target":{"selector":"#row-kyoto"}},
    {"type":"click","target":{"selector":"#edit-surface li.edit-task:nth-child(3) p","offset_x":300,"offset_y":10}},
    {"type":"assert_caret","target":{"selector":"#edit-surface li.edit-task:nth-child(3) p"},"visible":true,"char_offset":21},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface li.edit-task"},"count":4},
    {"type":"assert_caret","target":{"selector":"#edit-surface li.edit-task:nth-child(4)"},"visible":true,"char_offset":0},
    {"type":"capture_surface","source":"page","file":"temp/note/list-caret-task.png"},
    {"type":"type_physical","text":"Water bottle"},
    {"type":"assert_text","target":{"selector":"#edit-surface li.edit-task:nth-child(4)"},"equals":"Water bottle"},
    {"type":"assert_caret","target":{"selector":"#edit-surface li.edit-task:nth-child(4)"},"visible":true,"char_offset":12},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-task-done"},"count":0}
  ]
