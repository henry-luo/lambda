{
  "name":"Notes text and note context menus preserve selection, clipboard edits and window bounds",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":700,"height":400},
  "events":[
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"type_physical","text":"Hello Notes"},
    {"type":"set_editing_selection","target":{"selector":"#edit-surface p"},"start":0,"end":5},
    {"type":"click","target":{"selector":"#edit-surface p","offset_x":25,"offset_y":10},"button":1},
    {"type":"assert_count","target":{"selector":"#note-context-menu"},"count":1},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"assert_script","js":"var b=document.getElementById('note-context-menu').getBoundingClientRect();b.x>=0&&b.y>=0&&b.x+b.width<=700&&b.y+b.height<=400"},
    {"type":"capture_surface","source":"page","file":"temp/note/context-text.png"},
    {"type":"click","target":{"selector":"#context-copy"}},
    {"type":"assert_clipboard","equals":"Hello"},
    {"type":"assert_count","target":{"selector":"#note-context-menu"},"count":0},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Hello Notes"},
    {"type":"click","target":{"selector":"#edit-surface p","offset_x":25,"offset_y":10},"button":1},
    {"type":"click","target":{"selector":"#context-cut"}},
    {"type":"assert_clipboard","equals":"Hello"},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":" Notes"},
    {"type":"assert_selection","is_collapsed":true,"check_dom":true},
    {"type":"click","target":{"selector":"#edit-surface p","offset_x":2,"offset_y":10},"button":1},
    {"type":"click","target":{"selector":"#context-paste"}},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Hello Notes"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":" Notes"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Hello Notes"},
    {"type":"click","target":{"selector":"#edit-surface p","offset_x":25,"offset_y":10},"button":1},
    {"type":"click","target":{"selector":"#context-select-all"}},
    {"type":"assert_selection","is_collapsed":false,"check_dom":true},
    {"type":"click","target":{"selector":"#edit-surface p","offset_x":25,"offset_y":10},"button":1},
    {"type":"click","target":{"selector":"#context-color"}},
    {"type":"assert_count","target":{"selector":"#color-picker"},"count":1},
    {"type":"click","target":{"selector":"#color-blue"}},
    {"type":"assert_style","target":{"selector":"#edit-surface span[style]"},"property":"color","equals":"rgb(53, 110, 181)"},
    {"type":"click","target":{"selector":"#edit-surface p","offset_x":25,"offset_y":10},"button":1},
    {"type":"key_press","key":"down"},
    {"type":"assert_focus","target":{"selector":"#context-cut"}},
    {"type":"key_press","key":"escape"},
    {"type":"assert_count","target":{"selector":"#note-context-menu"},"count":0},
    {"type":"assert_focus","target":{"selector":"#edit-surface"}},
    {"type":"key_combo","key":"m","mods_str":"ctrl+shift"},
    {"type":"assert_count","target":{"selector":"#note-context-menu"},"count":1},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#edit-surface p","offset_x":25,"offset_y":10},"button":1},
    {"type":"click","target":{"selector":"#save-status"}},
    {"type":"assert_count","target":{"selector":"#note-context-menu"},"count":0},
    {"type":"resize","width":1280,"height":800},
    {"type":"click","target":{"selector":"#folder-all"}},
    {"type":"click","target":{"selector":"#row-weekend"},"button":1},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-selected","equals":"weekend"},
    {"type":"assert_attribute","target":{"selector":"#context-pin"},"attribute":"aria-label","equals":"Unpin Note"},
    {"type":"capture_surface","source":"page","file":"temp/note/context-note.png"},
    {"type":"click","target":{"selector":"#context-pin"}},
    {"type":"assert_count","target":{"selector":"#note-context-menu"},"count":0},
    {"type":"click","target":{"selector":"#row-ideas"},"button":1},
    {"type":"click","target":{"selector":"#context-move-notes"}},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-selected","equals":"ideas"},
    {"type":"click","target":{"selector":"#row-ideas"},"button":1},
    {"type":"click","target":{"selector":"#context-delete"}},
    {"type":"click","target":{"selector":"#folder-trash"}},
    {"type":"click","target":{"selector":"#row-ideas"},"button":1},
    {"type":"assert_count","target":{"selector":"#context-restore"},"count":1},
    {"type":"click","target":{"selector":"#context-restore"}},
    {"type":"assert_count","target":{"selector":".note-row"},"count":0}
  ]
}
