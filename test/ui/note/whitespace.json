{
  "name":"Notes preserves repeated spaces, empty paragraphs and soft line breaks",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"type_physical","text":"A   B"},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"A   B"},
    {"type":"assert_style","target":{"selector":"#edit-surface p"},"property":"white-space","equals":"pre-wrap"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface p"},"count":2},
    {"type":"assert_caret","target":{"selector":"#edit-surface p:nth-child(2)"}},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface p"},"count":3},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface p"},"count":4},
    {"type":"assert_caret","target":{"selector":"#edit-surface p:nth-child(4)"}},
    {"type":"type_physical","text":"C"},
    {"type":"assert_text","target":{"selector":"#edit-surface p:nth-child(4)"},"equals":"C"},
    {"type":"capture_surface","source":"page","file":"temp/note/whitespace-paragraphs.png"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"key_press","key":"enter"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_count","target":{"selector":"#edit-surface p"},"count":3},
    {"type":"type_physical","text":"D"},
    {"type":"assert_text","target":{"selector":"#edit-surface p:nth-child(3)"},"equals":"D"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"type_physical","text":"E"},
    {"type":"key_combo","key":"enter","mods_str":"shift"},
    {"type":"key_combo","key":"enter","mods_str":"shift"},
    {"type":"type_physical","text":"F"},
    {"type":"assert_count","target":{"selector":"#edit-surface p"},"count":1},
    {"type":"assert_count","target":{"selector":"#edit-surface p br"},"count":2},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"contains":"F"},
    {"type":"capture_surface","source":"page","file":"temp/note/whitespace-soft-breaks.png"}
  ]
}
