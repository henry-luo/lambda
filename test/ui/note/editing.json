{
  "name":"Notes native typing, rich formatting, per-note undo, tables and moving",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"key_combo","key":"n","mods_str":"ctrl"},
    {"type":"type","target":{"selector":"#edit-surface p"},"text":"Hello Notes"},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Hello Notes"},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-dirty","equals":"true"},
    {"type":"set_editing_selection","target":{"selector":"#edit-surface p"},"start":0,"end":5},
    {"type":"click","target":{"selector":"#format-note"}},
    {"type":"click","target":{"selector":"#bold"}},
    {"type":"assert_text","target":{"selector":"#edit-surface strong"},"equals":"Hello"},
    {"type":"click","target":{"selector":"#folder-all"}},
    {"type":"click","target":{"selector":"#row-weekend"}},
    {"type":"click","target":{"selector":"#row-note-20"}},
    {"type":"assert_text","target":{"selector":"#edit-surface strong"},"equals":"Hello"},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_count","target":{"selector":"#edit-surface strong"},"count":0},
    {"type":"assert_text","target":{"selector":"#edit-surface p"},"equals":"Hello Notes"},
    {"type":"key_combo","key":"y","mods_str":"ctrl"},
    {"type":"assert_count","target":{"selector":"#edit-surface strong"},"count":1},
    {"type":"click","target":{"selector":"#format-note"}},
    {"type":"click","target":{"selector":"#style-h2"}},
    {"type":"assert_text","target":{"selector":"#edit-surface h2"},"equals":"Hello Notes"},
    {"type":"click","target":{"selector":"#checklist"}},
    {"type":"assert_count","target":{"selector":"#edit-surface li.edit-task"},"count":1},
    {"type":"click","target":{"selector":"#edit-surface li.edit-task","offset_x":8,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-task-done"},"count":1},
    {"type":"click","target":{"selector":"#more"}},
    {"type":"select_option","target":{"selector":"#move-note"},"value":"work"},
    {"type":"click","target":{"selector":"#folder-work"}},
    {"type":"assert_count","target":{"selector":".note-row"},"count":3},
    {"type":"click","target":{"selector":"#row-note-20"}},
    {"type":"assert_text","target":{"selector":"#edit-surface"},"contains":"Hello Notes"},
    {"type":"click","target":{"selector":"#new-note"}},
    {"type":"click","target":{"selector":"#insert-table"}},
    {"type":"assert_count","target":{"selector":"#edit-surface table tr"},"count":3},
    {"type":"assert_count","target":{"selector":"#edit-surface table td"},"count":6},
    {"type":"capture_surface","source":"page","file":"temp/note/editing.png"}
  ]
}
