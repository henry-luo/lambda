{
  "name":"Notes folders, search, pin, trash, checklist and keyboard navigation",
  "html":"test/demo/note/note.ls",
  "viewport":{"width":1280,"height":800},
  "events":[
    {"type":"assert_count","target":{"selector":".note-row"},"count":7},
    {"type":"assert_text","target":{"selector":"#edit-surface h1"},"equals":"A slower kind of weekend"},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-task"},"count":4},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-dirty","equals":"false"},
    {"type":"capture_surface","source":"page","file":"temp/note/initial.png"},
    {"type":"click","target":{"selector":"#folder-travel"}},
    {"type":"assert_count","target":{"selector":".note-row"},"count":1},
    {"type":"assert_text","target":{"selector":"#edit-surface h1"},"equals":"Kyoto, someday"},
    {"type":"click","target":{"selector":"#folder-all"}},
    {"type":"type","target":{"selector":"#search"},"text":"noodles","clear":true},
    {"type":"assert_count","target":{"selector":".note-row"},"count":1},
    {"type":"assert_focus","target":{"selector":"#search"}},
    {"type":"type","target":{"selector":"#search"},"text":"nothing-matches","clear":true},
    {"type":"assert_count","target":{"selector":".note-row"},"count":0},
    {"type":"assert_text","target":{"selector":".list-empty strong"},"equals":"No matching notes"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#row-weekend"}},
    {"type":"key_press","key":"down"},
    {"type":"assert_attribute","target":{"selector":"#notes"},"attribute":"data-selected","equals":"ideas"},
    {"type":"click","target":{"selector":"#row-weekend"}},
    {"type":"click","target":{"selector":"#edit-surface li.edit-task:nth-child(2)"}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-task-done"},"count":1},
    {"type":"click","target":{"selector":"#edit-surface li.edit-task:nth-child(2)","offset_x":8,"offset_y":10}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-task-done"},"count":2},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"assert_count","target":{"selector":"#edit-surface .edit-task-done"},"count":1},
    {"type":"click","target":{"selector":"#delete-note"}},
    {"type":"assert_count","target":{"selector":".note-row"},"count":6},
    {"type":"click","target":{"selector":"#folder-trash"}},
    {"type":"assert_text","target":{"selector":"#edit-surface h1"},"equals":"A slower kind of weekend"},
    {"type":"click","target":{"selector":"#restore-note"}},
    {"type":"assert_count","target":{"selector":".note-row"},"count":0},
    {"type":"click","target":{"selector":"#folder-all"}},
    {"type":"assert_count","target":{"selector":".note-row"},"count":7},
    {"type":"click","target":{"selector":"#new-folder"}},
    {"type":"type","target":{"selector":"#dialog-value"},"text":"Ideas to keep","clear":true},
    {"type":"click","target":{"selector":"#dialog-confirm"}},
    {"type":"assert_text","target":{"selector":"#list-heading"},"equals":"Ideas to keep"},
    {"type":"assert_count","target":{"selector":".note-row"},"count":0},
    {"type":"capture_surface","source":"page","file":"temp/note/folder.png"}
  ]
}
