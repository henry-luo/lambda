{
  "name": "Document editor paints the DCT image PDF",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_input_dct_image_ascii_pdf"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_dct_image_ascii_pdf"}},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "dct_image_ascii.pdf"},
    {"type": "assert_count", "target": {"selector": "#pdf-preview .pdf-page svg image"}, "count": 1},
    {"type": "assert_rect", "target": {"selector": "#pdf-preview .pdf-page svg"}, "width": 144, "height": 144, "tolerance": 2},
    {"type": "assert_pixel", "target": {"selector": "#pdf-preview .pdf-page svg", "offset_x": 18, "offset_y": 18}, "min_r": 150, "max_g": 100, "max_b": 125},
    {"type": "render", "file": "./temp/pdfs/doc_editor_dct_image_ascii.png"}
  ]
}
