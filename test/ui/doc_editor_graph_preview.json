{
  "name": "Doc editor previews Mermaid and DOT graphs with source tabs",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "test_graph"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_input"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_input_test_graph_mmd"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_graph_mmd .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph.lambda-graph"}, "count": 1},
    {"type": "assert_attribute", "target": {"selector": "#rendered-preview graph.lambda-graph"}, "attribute": "data-radiant-layout", "equals": "lambda-graph"},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph node[data-node-id='A']"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph edge"}, "min": 1},
    {"type": "assert_position", "element_a": {"selector": "#rendered-preview graph node[data-node-id='A']"}, "element_b": {"selector": "#rendered-preview graph node[data-node-id='B']"}, "relation": "above", "gap": 10},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "flowchart TD"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph.lambda-graph"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_graph_dot .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph.lambda-graph"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph node[data-node-id='A']"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph edge"}, "min": 1},
    {"type": "assert_position", "element_a": {"selector": "#rendered-preview graph node[data-node-id='A']"}, "element_b": {"selector": "#rendered-preview graph node[data-node-id='B']"}, "relation": "left_of", "gap": 10},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "digraph example"}
  ]
}
