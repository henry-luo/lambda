{
  "name": "Doc editor renders LaTeX and Textile inline",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "assert_style", "target": {"selector": ".tree-hit-__test_input_basic_test_tex .tree-label"}, "property": "cursor", "equals": "pointer"},
    {"type": "assert_style", "target": {"selector": ".tree-hit-__test_input_basic_test_tex .file-icon"}, "property": "cursor", "equals": "pointer"},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_basic_test_tex .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#latex-preview"}, "count": 0},
    {"type": "assert_count", "target": {"selector": "#rendered-preview"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2"}, "contains": "Basic Test"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "contains": "Bold text"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "\\documentclass"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h2"}, "contains": "Basic Test"},
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "simple.textile"},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_simple_textile .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#rendered-preview"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#rendered-preview h1"}, "contains": "Simple Textile Test"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview strong"}, "contains": "strong text"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview code"}, "contains": "inline code"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "h1. Simple Textile Test"}
  ]
}
