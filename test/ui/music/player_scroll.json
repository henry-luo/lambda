{
  "name":"Music sheet scrolls independently and follows sounding notes",
  "html":"test/music/_player.ls",
  "viewport":{"width":800,"height":600},
  "events":[
    {"type":"resize","width":800,"height":600},
    {"type":"assert_rect","target":{"selector":".music-swatch"},"width":24,"height":24,"tolerance":0.5},
    {"type":"assert_rect","target":{"selector":".music-status"},"width":240,"tolerance":0.5},
    {"type":"assert_rect","target":{"selector":".music-controls"},"y":16,"tolerance":0.5},
    {"type":"assert_rect","target":{"selector":"select[data-control=speed]"},"x":292,"tolerance":1},
    {"type":"focus","target":{"selector":".music-sheet-viewport"}},
    {"type":"key_press","key":"PageDown"},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":1},
    {"type":"assert_rect","target":{"selector":".music-controls"},"y":16,"tolerance":0.5},
    {"type":"click","target":{"selector":"button[data-action=play]"}},
    {"type":"wait","ms":150},
    {"type":"click","target":{"selector":"button[data-action=pause]"}},
    {"type":"focus","target":{"selector":".music-seek"}},
    {"type":"key_press","key":"Home"},
    {"type":"assert_text","target":{"selector":".music-status"},"contains":"0.0 / 54.5 s"},
    {"type":"assert_rect","target":{"selector":"select[data-control=speed]"},"x":292,"tolerance":1},
    {"type":"assert_rect","target":{"selector":".music-status"},"width":240,"tolerance":0.5},
    {"type":"key_press","key":"End"},
    {"type":"key_press","key":"ArrowLeft"},
    {"type":"assert_text","target":{"selector":".music-status"},"contains":"54.5 / 54.5 s"},
    {"type":"assert_rect","target":{"selector":"select[data-control=speed]"},"x":292,"tolerance":1},
    {"type":"assert_rect","target":{"selector":".music-status"},"width":240,"tolerance":0.5},
    {"type":"assert_count","target":{"selector":"g[data-event-id][fill=red]"},"count":2},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=red] path"},"min_r":200,"max_g":180,"max_b":180,"search_radius":3},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":1},
    {"type":"assert_rect","target":{"selector":".music-controls"},"y":16,"tolerance":0.5},
    {"type":"resize","width":480,"height":500},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=red] path"},"min_r":200,"max_g":180,"max_b":180,"search_radius":3},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":1},
    {"type":"resize","width":800,"height":600},
    {"type":"focus","target":{"selector":".music-seek"}},
    {"type":"key_press","key":"Home"},
    {"type":"assert_text","target":{"selector":".music-status"},"contains":"0.0 / 54.5 s"},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=red] path"},"min_r":200,"max_g":180,"max_b":180,"search_radius":3},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":1},
    {"type":"resize","width":800,"height":400},
    {"type":"select_option","target":{"selector":"select[data-control=speed]"},"value":"2"},
    {"type":"click","target":{"selector":".music-seek","offset_x":96,"offset_y":8}},
    {"type":"click","target":{"selector":"button[data-action=play]"}},
    {"type":"wait","ms":2800},
    {"type":"click","target":{"selector":"button[data-action=pause]"}},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=red] path"},"min_r":200,"max_g":180,"max_b":180,"search_radius":3},
    {"type":"assert_pixel","target":{"selector":"g[data-event-id][fill=red] path","index":1},"min_r":200,"max_g":180,"max_b":180,"search_radius":3},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":1},
    {"type":"assert_rect","target":{"selector":".music-controls"},"y":16,"tolerance":0.5},
    {"type":"click","target":{"selector":"button[data-action=stop]"}}
  ]
}
