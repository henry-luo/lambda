{
  "name":"Lyrics follow verses, melismas, colors and seeking on the MIDI clock",
  "html":"test/music/_lyrics_player.ls",
  "viewport":{"width":800,"height":800},
  "events":[
    {"type":"resize","width":800,"height":800},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=text][fill]"},"count":0},
    {"type":"click","target":{"selector":"button[data-action=play]"}},
    {"type":"wait","ms":100},
    {"type":"click","target":{"selector":"button[data-action=pause]"}},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=text][data-verse='1'][fill=red]"},"count":1},
    {"type":"assert_text","target":{"selector":"g[data-lyric-kind=text][fill=red] text"},"equals":"Sing"},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=text][data-verse='2'][fill]"},"count":0},
    {"type":"click","target":{"selector":".music-swatch[data-color=blue] span"}},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=text][fill=blue]"},"count":1},
    {"type":"assert_style","target":{"selector":"g[data-lyric-kind=text][fill=blue] text"},"property":"color","equals":"rgb(0, 0, 255)"},
    {"type":"render","file":"temp/music-p3/lyrics-blue.png"},
    {"type":"click","target":{"selector":".music-seek","offset_x":34,"offset_y":8}},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=text][data-verse='2'][fill=blue]"},"count":1},
    {"type":"assert_text","target":{"selector":"g[data-lyric-kind=text][fill=blue] text"},"equals":"Glow"},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=text][data-verse='1'][fill]"},"count":0},
    {"type":"click","target":{"selector":".music-seek","offset_x":61,"offset_y":8}},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=extend][fill=blue]"},"count":4},
    {"type":"assert_text","target":{"selector":"g[data-lyric-kind=text][data-verse='1'][fill=blue] text"},"equals":"shine"},
    {"type":"assert_style","target":{"selector":"g[data-lyric-kind=extend][fill=blue] line"},"property":"color","equals":"rgb(0, 0, 255)"},
    {"type":"click","target":{"selector":".music-swatch[data-color=yellow] span"}},
    {"type":"assert_count","target":{"selector":"g[data-lyric-kind=extend][fill=yellow]"},"count":4},
    {"type":"assert_text","target":{"selector":"g[data-lyric-kind=text][data-verse='1'][fill=yellow] text"},"equals":"shine"},
    {"type":"resize","width":480,"height":500},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":1},
    {"type":"render","file":"temp/music-p3/lyrics-follow.png"},
    {"type":"click","target":{"selector":"button[data-action=stop]"}},
    {"type":"assert_count","target":{"selector":"g[data-lyric-id][fill]"},"count":0},
    {"type":"assert_count","target":{"selector":"g[data-event-id][fill]"},"count":0},
    {"type":"resize","width":800,"height":800},
    {"type":"click","target":{"selector":"button[data-action=play]"}},
    {"type":"wait","ms":100},
    {"type":"click","target":{"selector":"button[data-action=pause]"}},
    {"type":"assert_text","target":{"selector":"g[data-lyric-kind=text][fill=yellow] text"},"equals":"Sing"},
    {"type":"click","target":{"selector":"button[data-action=stop]"}}
  ]
}
