    {"type": "assert_pixel", "target": {"selector": "#positive", "offset_x": 8, "offset_y": 10},
     "min_r": 0, "max_r": 0, "min_g": 0, "max_g": 0, "min_b": 255, "max_b": 255},
    {"type": "assert_pixel", "target": {"selector": "#positive", "offset_x": 28, "offset_y": 10},
     "min_r": 255, "max_r": 255, "min_g": 255, "max_g": 255, "min_b": 255, "max_b": 255}
  ]
}
