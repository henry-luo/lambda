{
  "name": "window.onpopstate receives the traversed history state",
  "html": "test/ui/dom/history_onpopstate_property.html",
  "viewport": {"width": 640, "height": 480},
  "events": [
    {"type": "click", "target": {"selector": "#history-push"}},
    {"type": "assert_text", "target": {"selector": "#history-status"}, "equals": "pushed"},
    {"type": "click", "target": {"selector": "#history-back"}},
    {"type": "wait", "ms": 20},
    {"type": "assert_text", "target": {"selector": "#history-status"}, "equals": "initial"}
  ]
}
