{
  "name": "SVG paint and stroke-width computed style uses the shared presentation cascade",
  "html": "test/ui/cssom_svg_paint.html",
  "viewport": {
    "width": 420,
    "height": 200
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-default-fill",
      "equals": "rgb(0, 0, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-default-stroke",
      "equals": "none"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-default-width",
      "equals": "1px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-html-defaults",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-attribute-fill",
      "equals": "rgb(255, 0, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-attribute-stroke",
      "equals": "rgb(0, 0, 255)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-attribute-width",
      "equals": "2px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-inherited-fill",
      "equals": "rgb(0, 128, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-inherited-current-color",
      "equals": "rgb(0, 0, 255)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-inherited-em-owner",
      "equals": "60px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-cascade-css-over-attribute",
      "equals": "rgb(0, 0, 255)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live-current-color",
      "equals": "rgb(12, 34, 56)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live-color-change",
      "equals": "rgb(90, 80, 70)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-invalid-paint-preserves",
      "equals": "rgb(255, 0, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-invalid-string-preserves",
      "equals": "rgb(255, 0, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-invalid-width-preserves",
      "equals": "4px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-invalid-var-inherits",
      "equals": "rgb(0, 128, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-variable-paint",
      "equals": "rgb(1, 2, 3)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-variable-width",
      "equals": "5px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-percentage-width",
      "equals": "12.5%"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-absolute-width",
      "equals": "96px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-em-width",
      "equals": "24px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-math-width",
      "equals": "27px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-mixed-math-width",
      "equals": "calc(10% + 24px)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-number-math-width",
      "equals": "6px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-negative-math-clamped",
      "equals": "0px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-paint-url-fallback",
      "equals": "url(\"https://example.test/paint.svg#p\") rgb(255, 0, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-relative-url",
      "equals": "url(\"#paint\") rgb(255, 0, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-empty-url",
      "equals": "url(\"\") rgb(255, 0, 0)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-sheet-url",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-imported-url",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-long-url",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-context-paint",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live-attribute",
      "equals": "rgb(128, 0, 128)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-initial-reset",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#verify"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-after-layout",
      "equals": "true"
    }
  ]
}
