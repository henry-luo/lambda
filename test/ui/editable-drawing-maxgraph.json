{
  "name": "maxGraph SVG probe moves, resizes, reconnects, pans, and recreates a graph host",
  "html": "test/html/editable-maxgraph.html",
  "viewport": {"width": 720, "height": 640},
  "events": [
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-ready", "equals": "true", "assert_timeout": 1000},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"modelXml\":\"<GraphDataModel"},
    {"type": "assert_count", "target": {"selector": "#drawing-host svg"}, "equals": 1},
    {"type": "assert_count", "target": {"selector": "#drawing-host canvas"}, "equals": 0},
    {"type": "assert_attribute", "target": {"selector": "#drawing-capabilities"}, "attribute": "data-library", "equals": "maxgraph"},
    {"type": "assert_text", "target": {"selector": "#drawing-capabilities"}, "contains": "\"legacyCommandsPresent\":false"},
    {"type": "click", "target": {"selector": "#add-vertex"}},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-action-dispatched", "equals": "addVertex"},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"id\":\"added\""},
    {"type": "click", "target": {"selector": "#resize-source"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"width\":145"},
    {"type": "click", "target": {"selector": "#reconnect-edge"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"target\":\"added\""},
    {"type": "click", "target": {"selector": "#undo"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"target\":\"target\""},
    {"type": "click", "target": {"selector": "#redo"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"target\":\"added\""},
    {"type": "click", "target": {"selector": "#pan-zoom"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"scale\":1.2"},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"groups\":"},
    {"type": "mouse_drag", "target": {"selector": "#drawing-host", "offset_x": 95, "offset_y": 70}, "dx": 15, "dy": 10, "button": 0},
    {"type": "assert_attribute", "target": {"selector": "#drawing-host"}, "attribute": "data-maxgraph-pointer-down", "equals": "source"},
    {"type": "scroll", "target": {"selector": "#drawing-host"}, "dx": 0, "dy": -1},
    {"type": "assert_attribute", "target": {"selector": "#drawing-host"}, "attribute": "data-maxgraph-wheel", "equals": "zoomed"},
    {"type": "focus", "target": {"selector": "#drawing-host"}},
    {"type": "assert_focus", "target": {"selector": "#drawing-host"}},
    {"type": "key_press", "key": "m"},
    {"type": "assert_attribute", "target": {"selector": "#drawing-host"}, "attribute": "data-maxgraph-key", "equals": "moved"},
    {"type": "click", "target": {"selector": "#destroy"}},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-destroyed", "equals": "true"},
    {"type": "assert_count", "target": {"selector": "#drawing-host svg"}, "equals": 0},
    {"type": "click", "target": {"selector": "#recreate"}},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-recreated", "equals": "true", "assert_timeout": 1000},
    {"type": "assert_count", "target": {"selector": "#drawing-host svg"}, "equals": 1},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"source\":\"source\""}
  ]
}
