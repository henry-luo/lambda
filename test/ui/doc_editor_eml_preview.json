{
  "name": "Document editor shows EML headers and wrapped plain-text body",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 900, "height": 5000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_input_test_eml"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_eml .tree-label"}},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "test.eml"},
    {"type": "assert_count", "target": {"selector": "#eml-preview .eml-header-table tbody tr"}, "count": 17},
    {"type": "assert_count", "target": {"selector": ".eml-header-table tr[data-header-name='phone']"}, "count": 0},
    {"type": "assert_text", "target": {"selector": ".eml-header-table tr[data-header-name='subject'] td"}, "equals": "Test Email with Multiple Headers"},
    {"type": "assert_text", "target": {"selector": ".eml-header-table tr[data-header-name='received'] td"}, "contains": "mx.company.org"},
    {"type": "assert_text", "target": {"selector": "#eml-body"}, "contains": "Hello Jane,\n\nThis is a test email"},
    {"type": "assert_text", "target": {"selector": "#eml-body"}, "contains": "Best regards,"},
    {"type": "assert_style", "target": {"selector": "#eml-body"}, "property": "white-space", "equals": "pre-wrap"},
    {"type": "render", "file": "./temp/doc_editor_eml_preview.png"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "From: John Doe"}
  ]
}
