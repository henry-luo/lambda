{
  "name": "Sheet pointer ranges, cancellation, capture release and edit handoff",
  "html": "test/demo/sheet/sheet.ls",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "input_turn_ms": 0,
  "events": [
    {
      "type": "wait",
      "ms": 100
    },
    {
      "type": "script",
      "js": "window.sheetScrollport=document.getElementById('grid-scroll')"
    },
    {
      "type": "mouse_down",
      "target": {
        "selector": "#cell-C5"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sheet"
      },
      "attribute": "data-selecting",
      "equals": "true"
    },
    {
      "type": "mouse_move",
      "target": {
        "selector": "#cell-E8",
        "offset_x": 2,
        "offset_y": 2
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "td[aria-selected=true]"
      },
      "equals": 12
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#selection-label"
      },
      "contains": "C5:E8"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sheet"
      },
      "attribute": "data-cell",
      "equals": "E8"
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('formula-input').value==='16200'"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#cell-E8",
        "offset_x": 8,
        "offset_y": 8
      },
      "min_r": 185,
      "max_r": 220,
      "min_g": 210,
      "max_g": 240,
      "min_b": 240
    },
    {
      "type": "mouse_up",
      "target": {
        "selector": "#cell-E8",
        "offset_x": 2,
        "offset_y": 2
      }
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#cell-E8",
        "offset_x": 8,
        "offset_y": 8
      },
      "min_r": 185,
      "max_r": 220,
      "min_g": 210,
      "max_g": 240,
      "min_b": 240
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "td[aria-selected=true]"
      },
      "equals": 12
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#selection-label"
      },
      "contains": "C5:E8"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sheet"
      },
      "attribute": "data-dirty",
      "equals": "false"
    },
    {
      "type": "assert_script",
      "js": "document.getElementById('undo').disabled"
    },
    {
      "type": "mouse_move",
      "target": {
        "selector": "#cell-G10"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "td[aria-selected=true]"
      },
      "equals": 12
    },
    {
      "type": "mouse_down",
      "target": {
        "selector": "#cell-E8"
      }
    },
    {
      "type": "mouse_move",
      "target": {
        "selector": "#cell-C5"
      }
    },
    {
      "type": "mouse_up",
      "target": {
        "selector": "#cell-C5"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "td[aria-selected=true]"
      },
      "equals": 12
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#selection-label"
      },
      "contains": "C5:E8"
    },
    {
      "type": "click",
      "target": {
        "selector": "#cell-A4"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "td[aria-selected=true]"
      },
      "equals": 1
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#selection-label"
      },
      "contains": "A4"
    },
    {
      "type": "click",
      "target": {
        "selector": "#cell-C5"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#cell-E8"
      },
      "mods_str": "shift"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "td[aria-selected=true]"
      },
      "equals": 12
