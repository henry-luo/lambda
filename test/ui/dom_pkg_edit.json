{
  "name": "F5: the dom package's beforeinput applier owns text editing",
  "html": "test/ui/test_form_input.html",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "events": [
    {
      "type": "log",
      "message": "=== insertText / delete* applied in Lambda, spliced natively ==="
    },
    {
      "type": "click",
      "target": {
        "selector": "#name"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#name"
      },
      "text": "hello world"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#name"
      },
      "equals": "hello world"
    },
    {
      "type": "key_press",
      "key": "Backspace"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#name"
      },
      "equals": "hello worl"
    },
    {
      "type": "log",
      "message": "alt+Backspace: word boundary comes from the Lambda scanner"
    },
    {
      "type": "key_press",
      "key": "Backspace",
      "mods_str": "alt"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#name"
      },
      "equals": "hello "
    },
    {
      "type": "key_press",
      "key": "Home"
    },
    {
      "type": "key_press",
      "key": "Delete"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#name"
      },
      "equals": "ello "
    },
    {
      "type": "log",
      "message": "textarea: Enter inserts a newline through the applier"
    },
    {
      "type": "click",
      "target": {
        "selector": "#bio"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#bio"
      },
      "text": "ab"
    },
    {
      "type": "key_press",
      "key": "Enter"
    },
    {
      "type": "type",
      "target": {
        "selector": "#bio"
      },
      "text": "cd"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#bio"
      },
      "equals": "ab\ncd"
    },
    {
      "type": "log",
      "message": "single-line input: Enter is not a value edit"
    },
    {
      "type": "click",
      "target": {
        "selector": "#code"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#code"
      },
      "text": "ab"
    },
    {
      "type": "key_press",
      "key": "Enter"
    },
    {
      "type": "type",
      "target": {
        "selector": "#code"
      },
      "text": "cd"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#code"
      },
      "equals": "abcd"
    },
    {
      "type": "log",
      "message": "maxlength: field holds 'abcd', so exactly one of XYZ fits \u2014 truncate, not reject"
    },
    {
      "type": "click",
      "target": {
        "selector": "#code"
      }
    },
    {
      "type": "key_press",
      "key": "End"
    },
    {
      "type": "type",
      "target": {
        "selector": "#code"
      },
      "text": "XYZ"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#code"
      },
      "equals": "abcdX"
    }
  ]
}