import shell: lambda.ui.workspace.shell

<html <head <style shell.css ++ ".workspace-document button:focus-visible { outline:3px solid #cc0000; }">>
    <body
        <section id:"shell-one",class:"workspace-shell",style:shell.variables({primary:"#102030",text:"#203040"})^,
            <div class:"workspace-chrome",<button id:"one-first","First"><button id:"one-next","Next">>
            <div class:"workspace-chrome workspace-document",<button id:"document-button","Document">>>
        <section id:"shell-two",class:"workspace-shell",style:shell.variables({primary:"#a04020",text:"#405060"})^,
            <div class:"workspace-chrome",<button id:"two-first","First"><button id:"two-next","Next">>>
        <div id:"outside",style:"color:#123456","Outside">
    >>
