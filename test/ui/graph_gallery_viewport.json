{
  "name": "Graphviz gallery opens from the index, fits previews, and keeps them ready while scrolling",
  "html": "test/lambda/graph/test_graph.ls",
  "viewport": {"width": 1280, "height": 800},
  "events": [
    {"type":"assert_text","target":{"selector":"h1"},"equals":"Graphs"},
    {"type":"click","target":{"selector":"a[href='test_graph_upstream_dot.ls']"}},
    {"type":"wait","ms":90},
    {"type":"assert_count","target":{"selector":".graph-card"},"equals":30},
    {"type":"assert_count","target":{"selector":".graph-card .lambda-graph"},"equals":30},
    {"type":"assert_count","target":{"selector":".graph-card .graph-content[style*='translate(']"},"equals":30},
    {"type":"assert_attribute","target":{"selector":".graph-card:first-child .graph-content"},"attribute":"style","contains":"translate("},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":5},
    {"type":"click","target":{"selector":".graph-card:first-child"}},
    {"type":"assert_count","target":{"selector":"#graph-viewer .lambda-graph"},"equals":1},
    {"type":"assert_text","target":{"selector":"#viewer-count"},"equals":"1 / 30"},
    {"type":"click","target":{"selector":"#viewer-next"}},
    {"type":"assert_text","target":{"selector":"#viewer-title"},"equals":"clust1.gv"},
    {"type":"click","target":{"selector":"#viewer-source-button"}},
    {"type":"assert_text","target":{"selector":"#viewer-source"},"contains":"digraph"},
    {"type":"click","target":{"selector":"#viewer-source-button"}},
    {"type":"assert_visible","target":{"selector":"#viewer-stage"},"visible":true},
    {"type":"click","target":{"selector":"#viewer-previous"}},
    {"type":"assert_text","target":{"selector":"#viewer-title"},"equals":"clust.gv"},
    {"type":"click","target":{"selector":"[data-gallery-action='back']"}},
    {"type":"assert_visible","target":{"selector":"#gallery-list"},"visible":true},
    {"type":"wait","ms":100},
    {"type":"scroll","x":800,"y":600,"dy":-10000},
    {"type":"assert_scroll","x":0,"y":0,"tolerance":5,"negate":true},
    {"type":"assert_count","target":{"selector":".graph-card:last-child .lambda-graph"},"equals":1},
    {"type":"click","target":{"selector":".graph-card:last-child"}},
    {"type":"assert_text","target":{"selector":"#viewer-count"},"equals":"30 / 30"}
  ]
}
