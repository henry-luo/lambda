{
  "name": "Shared SVG cascade keeps strongest selector-list priorities distinct",
  "html": "test/ui/svg_cascade_priorities.html",
  "viewport": {
    "width": 350,
    "height": 100
  },
  "events": [
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 247,
      "max_g": 255,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 80,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#container"
      },
      "attribute": "class",
      "equals": "site-info"
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 247,
      "max_g": 255,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 80,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 247,
      "max_g": 255,
      "min_b": 0,
      "max_b": 8
    }
  ]
}
