{
  "name": "upstream Editor.js reload preserves saved blocks and destroy releases the host",
  "html": "test/editable-editors/fixtures/editorjs/typing.html",
  "viewport": {"width": 720, "height": 420},
  "events": [
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "seed"},
    {"type": "assert_rect", "target": {"selector": ".ce-paragraph"}, "height": 18, "tolerance": 3},
    {"type": "click", "target": {"selector": ".ce-paragraph"}},
    {"type": "assert_rect", "target": {"selector": ".ce-toolbar__plus"}, "width": 26, "height": 26, "tolerance": 2},
    {"type": "key_press", "key": "End"},
    {"type": "type_physical", "target": {"selector": ".ce-paragraph"}, "text": "-persist"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "seed-persist"},
    {"type": "assert_rect", "target": {"selector": ".ce-paragraph"}, "height": 18, "tolerance": 3},
    {"type": "click", "target": {"selector": "#reload"}},
    {"type": "assert_attribute", "target": {"selector": "#state"}, "attribute": "data-reloaded", "equals": "true"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "seed-persist"},
    {"type": "click", "target": {"selector": "#destroy"}},
    {"type": "assert_attribute", "target": {"selector": "#state"}, "attribute": "data-destroyed", "equals": "true"},
    {"type": "assert_count", "target": {"selector": ".ce-block"}, "equals": 0}
  ]
}
