{
  "name": "Sketch live inspector, style history, resize and lettering",
  "html": "test/demo/sketch/sketch.ls",
  "viewport": {
    "width": 1280,
    "height": 1000
  },
  "events": [
    {
      "type": "advance_time",
      "ms": 50
    },
    {
      "type": "click",
      "target": {
        "selector": "#blank"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#tool-rect"
      }
    },
    {
      "type": "pointer_drag",
      "target": {
        "selector": "#stage",
        "offset_x": 300,
        "offset_y": 240
      },
      "pointerType": "mouse",
      "dx": 100,
      "dy": 80,
      "steps": 3
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#swatch-8"
      },
      "mods_str": "shift"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o2 rect"
      },
      "attribute": "fill",
      "equals": "#7665d9"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "3"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#stage",
        "offset_x": 350,
        "offset_y": 280
      },
      "min_r": 108,
      "max_r": 130,
      "min_g": 90,
      "max_g": 115,
      "min_b": 200,
      "max_b": 225
    },
    {
      "type": "click",
      "target": {
        "selector": "#swatch-5"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o2 rect"
      },
      "attribute": "stroke",
      "equals": "#be5046"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "4"
    },
    {
      "type": "type",
      "target": {
        "selector": "#prop-x"
      },
      "text": "300",
      "clear": true
    },
    {
      "type": "key_press",
      "key": "tab"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o2 rect"
      },
      "attribute": "x",
      "equals": "300"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "5"
    },
    {
      "type": "type",
      "target": {
        "selector": "#prop-fill"
      },
      "text": "invalid",
      "clear": true
    },
    {
      "type": "key_press",
      "key": "tab"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o2 rect"
      },
      "attribute": "fill",
      "equals": "#7665d9"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "5"
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#prop-fill"
      },
      "equals": "#7665d9"
    },
    {
      "type": "type",
      "target": {
        "selector": "#prop-fill"
      },
      "text": "#418b80",
      "clear": true
    },
    {
      "type": "key_press",
      "key": "tab"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "6"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o2 rect"
      },
      "attribute": "fill",
      "equals": "#418b80"
    },
    {
      "type": "click",
      "target": {
        "selector": "#undo"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o2 rect"
      },
      "attribute": "fill",
      "equals": "#7665d9"
    },
    {
      "type": "click",
      "target": {
        "selector": "#redo"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o2 rect"
      },
      "attribute": "fill",
      "equals": "#418b80"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tool-select"
      }
    },
    {
      "type": "pointer_drag",
      "target": {
        "selector": "#resize-handle"
      },
      "pointerType": "mouse",
      "dx": 40,
      "dy": 30,
      "steps": 3
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "7"
    },
    {
      "type": "click",
      "target": {
        "selector": "#dock-tab-layers"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#layer-add"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#prop-layer_name"
      },
      "text": "Ink accents",
      "clear": true
    },
    {
      "type": "key_press",
      "key": "tab"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#layer-l3"
      },
      "contains": "Ink accents"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "9"
    },
    {
      "type": "click",
      "target": {
        "selector": "#dock-tab-properties"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#tool-text"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#prop-text"
      },
      "text": "Hello",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#prop-font_size"
      },
      "text": "40",
      "clear": true
    },
    {
      "type": "key_press",
      "key": "tab"
    },
    {
      "type": "click",
      "target": {
        "selector": "#stage",
        "offset_x": 300,
        "offset_y": 420
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-objects",
      "equals": "2"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#object-o4 text"
      },
      "equals": "Hello"
    },
    {
      "type": "click",
      "target": {
        "selector": "#swatch-4"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#object-o4 text"
      },
      "attribute": "fill",
      "equals": "#dd734b"
    },
    {
      "type": "render",
      "file": "temp/sketch/inspector.png"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-error",
      "equals": ""
    }
  ]
}
