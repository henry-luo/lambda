{
  "name": "Sketch rectangle selection, grouped edits and cancellation",
  "html": "test/demo/sketch/sketch.ls",
  "viewport": {"width":1280,"height":900},
  "events": [
    {"type":"advance_time","ms":50},
    {"type":"click","target":{"selector":"#blank"}},
    {"type":"click","target":{"selector":"#tool-rect"}},
    {"type":"pointer_drag","target":{"selector":"#stage","offset_x":250,"offset_y":220},"pointerType":"mouse","dx":80,"dy":60,"steps":3},
    {"type":"pointer_drag","target":{"selector":"#stage","offset_x":430,"offset_y":250},"pointerType":"mouse","dx":100,"dy":70,"steps":3},
    {"type":"click","target":{"selector":"#tool-ellipse"}},
    {"type":"pointer_drag","target":{"selector":"#stage","offset_x":600,"offset_y":420},"pointerType":"mouse","dx":80,"dy":60,"steps":3},
    {"type":"click","target":{"selector":"#save"}},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"click","target":{"selector":"#tool-select"}},
    {"type":"mouse_down","target":{"selector":"#stage","offset_x":220,"offset_y":180}},
    {"type":"mouse_move","target":{"selector":"#stage","offset_x":560,"offset_y":360}},
    {"type":"assert_count","target":{"selector":"#marquee"},"count":1},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-history","equals":"4"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-dirty","equals":"false"},
    {"type":"render","file":"temp/sketch/selection-draft.png"},
    {"type":"mouse_up","target":{"selector":"#stage","offset_x":560,"offset_y":360}},
    {"type":"assert_count","target":{"selector":"#marquee"},"count":0},
    {"type":"assert_count","target":{"selector":".selected-object"},"count":2},
    {"type":"assert_count","target":{"selector":"#resize-handle"},"count":0},
    {"type":"assert_text","target":{"selector":"#selection-title"},"equals":"2 objects selected"},
    {"type":"pointer_drag","target":{"selector":"#stage","offset_x":280,"offset_y":250},"pointerType":"mouse","dx":40,"dy":20,"steps":3},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-history","equals":"5"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"2"},
    {"type":"assert_pixel","target":{"selector":"#stage","offset_x":260,"offset_y":230},"min_r":245,"min_g":235,"min_b":220},
    {"type":"assert_pixel","target":{"selector":"#stage","offset_x":320,"offset_y":270},"min_r":210,"max_r":235,"min_g":95,"max_g":130,"min_b":60,"max_b":90},
    {"type":"mouse_down","target":{"selector":"#stage","offset_x":310,"offset_y":260}},
    {"type":"mouse_move","target":{"selector":"#stage","offset_x":330,"offset_y":280}},
    {"type":"key_press","key":"escape"},
    {"type":"mouse_up","target":{"selector":"#stage","offset_x":330,"offset_y":280}},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-history","equals":"5"},
    {"type":"mouse_down","target":{"selector":"#stage","offset_x":180,"offset_y":150}},
    {"type":"mouse_move","target":{"selector":"#stage","offset_x":800,"offset_y":600}},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"3"},
    {"type":"key_press","key":"escape"},
    {"type":"mouse_up","target":{"selector":"#stage","offset_x":800,"offset_y":600}},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"2"},
    {"type":"key_press","key":"m"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-tool","equals":"marquee"},
    {"type":"pointer_drag","target":{"selector":"#stage","offset_x":310,"offset_y":250},"pointerType":"mouse","dx":300,"dy":130,"steps":3},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection","equals":"o3"},
    {"type":"key_press","key":"v"},
    {"type":"click","target":{"selector":"#stage","offset_x":320,"offset_y":270},"mods_str":"shift"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"2"},
    {"type":"key_combo","key":"d","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-objects","equals":"5"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-history","equals":"6"},
    {"type":"key_press","key":"delete"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-objects","equals":"3"},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-objects","equals":"5"},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-objects","equals":"3"},
    {"type":"key_combo","key":"a","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"3"},
    {"type":"click","target":{"selector":"#tool-pan"}},
    {"type":"pointer_drag","target":{"selector":"#stage","offset_x":500,"offset_y":170},"pointerType":"mouse","dx":60,"dy":40,"steps":3},
    {"type":"click","target":{"selector":"#zoom-in"}},
    {"type":"click","target":{"selector":"#tool-select"}},
    {"type":"pointer_drag","target":{"selector":"#stage","offset_x":10,"offset_y":10},"pointerType":"touch","dx":930,"dy":670,"steps":4},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-selection-count","equals":"3"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-history","equals":"5"},
    {"type":"assert_count","target":{"selector":".selected-object"},"count":3},
    {"type":"render","file":"temp/sketch/selection.png"},
    {"type":"assert_attribute","target":{"selector":"#sketch"},"attribute":"data-error","equals":""}
  ]
}
