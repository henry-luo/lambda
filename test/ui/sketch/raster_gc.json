{
  "name": "Sketch image clipboard snapshots survive collecting allocations",
  "html": "test/demo/sketch/sketch.ls",
  "viewport": {
    "width": 1000,
    "height": 800
  },
  "env": [
    {
      "key": "LAMBDA_GC_FORCE_EVERY",
      "value": "1"
    },
    {
      "key": "LAMBDA_GC_POISON_FREED",
      "value": "1"
    }
  ],
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#blank"
      }
    },
    {
      "type": "focus",
      "target": {
        "selector": "#stage"
      }
    },
    {
      "type": "paste_image",
      "file": "test/ui/note/fixtures/clipboard.png"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#artwork image"
      },
      "count": 1
    },
    {
      "type": "key_combo",
      "key": "c",
      "mods_str": "ctrl"
    },
    {
      "type": "key_combo",
      "key": "v",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#artwork image"
      },
      "count": 2
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "ctrl"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#artwork image"
      },
      "count": 1
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-error",
      "equals": ""
    },
    {
      "type": "paste_text",
      "text": "caption",
      "html": "<p>Caption<img src=\"data:image/png;base64,\"></p>"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#artwork image"
      },
      "count": 2
    },
    {
      "type": "key_combo",
      "key": "c",
      "mods_str": "ctrl"
    },
    {
      "type": "paste_text",
      "text": "changed plain text"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#artwork image"
      },
      "count": 3
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-error",
      "equals": ""
    }
  ]
}
