        "selector": "#object-o2 path"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "#undo"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-objects",
      "equals": "0"
