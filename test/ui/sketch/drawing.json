{
  "html": "test/demo/sketch/sketch.ls",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "name": "drawing",
  "events": [
    {
      "type": "advance_time",
      "ms": 50
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-objects",
      "equals": "13"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-layers",
      "equals": "3"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#stage",
        "offset_x": 600,
        "offset_y": 320
      },
      "min_r": 210,
      "max_r": 240,
      "min_g": 95,
      "max_g": 145,
      "min_b": 50,
      "max_b": 110
    },
    {
      "type": "click",
      "target": {
        "selector": "#blank"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-objects",
      "equals": "0"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tool-brush"
      }
    },
    {
      "type": "pointer_drag",
      "target": {
        "selector": "#stage",
        "offset_x": 220,
        "offset_y": 200
      },
      "pointerType": "mouse",
      "dx": 140,
      "dy": 80,
      "steps": 5
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-objects",
      "equals": "1"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
