    {
      "type": "pointer_drag",
      "target": {
        "selector": "#node-0"
      },
      "pointerType": "mouse",
      "dx": -20,
      "dy": 20,
      "steps": 3
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-history",
      "equals": "9"
    },
    {
      "type": "click",
      "target": {
        "selector": "#save"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#file-confirm"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-dirty",
      "equals": "false"
    },
    {
      "type": "render",
      "file": "temp/sketch/drawing.png"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-error",
      "equals": ""
