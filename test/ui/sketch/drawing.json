    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-pen",
      "equals": "0"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
      },
      "attribute": "data-objects",
      "equals": "4"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tool-nodes"
