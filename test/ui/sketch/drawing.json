        "offset_y": 300
      }
    },
    {
      "type": "mouse_move",
      "target": {
        "selector": "#stage",
        "offset_x": 490,
        "offset_y": 330
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#sketch"
