{
  "name":"Timeline application player completion, stale tokens, timeout, and paused wait",
  "html":"test/ui/timeline/media_lifetime.ls",
  "viewport":{"width":900,"height":650},
  "input_turn_ms":0,
  "events":[
    {"type":"click","target":{"selector":"[data-timeline-command='play']"}},
    {"type":"assert_text","target":{"selector":"#starts"},"equals":"1"},
    {"type":"advance_time","ms":100,"steps":10},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-active","equals":"a"},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-playback","equals":"playing"},
    {"type":"click","target":{"selector":"#finish"}},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-active","equals":"b"},
    {"type":"assert_text","target":{"selector":"#pauses"},"equals":"1"},
    {"type":"click","target":{"selector":"[data-timeline-command='play']"}},
    {"type":"assert_text","target":{"selector":"#starts"},"equals":"2"},
    {"type":"advance_time","ms":100,"steps":10},
    {"type":"click","target":{"selector":"#stale"}},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-active","equals":"a"},
    {"type":"advance_time","ms":200,"steps":20},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-active","equals":"b"},
    {"type":"assert_text","target":{"selector":"#timeouts"},"equals":"1"},
    {"type":"click","target":{"selector":"[data-timeline-command='play']"}},
    {"type":"advance_time","ms":160,"steps":16},
    {"type":"click","target":{"selector":"[data-timeline-command='pause']"}},
    {"type":"advance_time","ms":1000,"steps":10},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-active","equals":"a"},
    {"type":"assert_text","target":{"selector":"#timeouts"},"equals":"1"},
    {"type":"click","target":{"selector":"[data-timeline-command='resume']"}},
    {"type":"advance_time","ms":130,"steps":13},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-active","equals":"a"},
    {"type":"advance_time","ms":10,"steps":1},
    {"type":"assert_attribute","target":{"selector":".lambda-timeline-chart"},"attribute":"data-timeline-active","equals":"b"},
    {"type":"assert_text","target":{"selector":"#timeouts"},"equals":"2"}
  ]
}
