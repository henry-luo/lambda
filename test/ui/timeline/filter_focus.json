{
  "name": "Timeline filtering and collapsing preserve a usable focus target",
  "html": "test/ui/timeline/filter_focus.ls",
  "viewport": {"width": 800, "height": 700},
  "events": [
    {"type": "assert_focus", "target": {"selector": "[data-timeline-id='b']"}},
    {"type": "key_press", "key": "c"},
    {"type": "assert_attribute", "target": {"selector": ".lambda-timeline-chart"}, "attribute": "data-timeline-active", "equals": "c"},
    {"type": "assert_attribute", "target": {"selector": ".lambda-timeline-chart"}, "attribute": "data-timeline-selected", "equals": "[\n  \"b\"\n]"},
    {"type": "assert_focus", "target": {"selector": "[data-timeline-group='g']"}},
    {"type": "click", "target": {"selector": "[data-timeline-group='g']"}},
    {"type": "click", "target": {"selector": "[data-timeline-id='b']"}},
    {"type": "click", "target": {"selector": "[data-timeline-search]"}},
    {"type": "type", "text": "Gamma"},
    {"type": "assert_attribute", "target": {"selector": ".lambda-timeline-chart"}, "attribute": "data-timeline-active", "equals": "c"},
    {"type": "assert_focus", "target": {"selector": "[data-timeline-search]"}},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "type", "text": "missing"},
    {"type": "assert_count", "target": {"selector": ".lambda-timeline-item"}, "count": 0},
    {"type": "assert_focus", "target": {"selector": "[data-timeline-search]"}},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "key_press", "key": "Backspace"},
    {"type": "assert_count", "target": {"selector": ".lambda-timeline-item"}, "count": 3},
    {"type": "assert_attribute", "target": {"selector": ".lambda-timeline-chart"}, "attribute": "data-timeline-active", "equals": "c"},
    {"type": "assert_focus", "target": {"selector": "[data-timeline-search]"}}
  ]
}
