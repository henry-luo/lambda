import timeline: lambda.chart.timeline

let rich=<p id:"authored-rich",title:"Authored tooltip", "An E\u0301" <em class:"emphasis", "cole"> " opens.">
let spec={id:"rich-search",width:640,search:{fields:["content"],highlight:true,diacritics:"ignore"},
    events:[{id:"school",at:"2000",title:"School",content:rich}]}
let model=timeline.model(spec);
<html <head <style "body{font-family:Arial;margin:16px}">> <body apply(model)>>
