    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-restored-values",
      "equals": "0.7|0.8|0.3"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#patch"
      },
      "width": 70,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 76,
      "max_g": 78,
      "min_b": 76,
      "max_b": 78
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#owner",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
