      "width": 30,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 178,
      "max_g": 180,
      "min_b": 178,
      "max_b": 180
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#owner",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 231,
      "max_g": 233,
      "min_b": 231,
      "max_b": 233
