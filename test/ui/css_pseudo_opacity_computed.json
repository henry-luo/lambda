      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 127,
      "max_g": 129,
      "min_b": 127,
      "max_b": 129
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#owner",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 216,
      "max_g": 218,
      "min_b": 216,
      "max_b": 218
    },
    {
      "type": "click",
      "target": {
        "selector": "#restore"
