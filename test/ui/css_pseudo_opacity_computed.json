      "type": "assert_rect",
      "target": {
        "selector": "#patch"
      },
      "width": 100,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
