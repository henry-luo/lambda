{
  "name": "Calculated pseudo opacity uses declaration fonts",
  "html": "test/ui/css_pseudo_opacity_computed.html",
  "viewport": {
    "width": 480,
    "height": 200
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-values",
      "equals": "0.5|0.8|0.2"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#patch"
      },
      "width": 50,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 127,
      "max_g": 129,
      "min_b": 127,
      "max_b": 129
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#owner",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 229,
      "max_g": 231,
      "min_b": 229,
      "max_b": 231
    },
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-dirty-values",
      "equals": "0.7|0.8|0.3"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#patch"
      },
      "width": 70,
      "height": 12
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#patch",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 76,
      "max_g": 78,
      "min_b": 76,
      "max_b": 78
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#owner",
        "offset_x": 5,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 200,
      "max_g": 202,
      "min_b": 200,
      "max_b": 202
    },
    {
      "type": "click",
      "target": {
        "selector": "#inherit"
