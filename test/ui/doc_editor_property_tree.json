{
  "name": "Document editor expands and filters parsed property files",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1600},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "property_tree"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_property_tree_json .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#property-preview"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='outer']"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='outer'] .property-entry"}, "count": 0},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='outer'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='a']"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='a'] > .property-row .property-value"}, "equals": "1"},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='outer'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='a']"}, "count": 0},
    {"type": "click", "target": {"selector": "#property-filter"}},
    {"type": "type", "target": {"selector": "#property-filter"}, "text": "b"},
    {"type": "assert_value", "target": {"selector": "#property-filter"}, "equals": "b"},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='outer'] .property-entry"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='b']"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='a']"}, "count": 0},
    {"type": "click", "target": {"selector": ".property-filter-clear"}},
    {"type": "assert_value", "target": {"selector": "#property-filter"}, "equals": ""},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_count", "target": {"selector": "#source-preview"}, "count": 1},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_property_tree_yaml .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='address']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='address'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='street']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='hobbies'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='hobbies'] .property-entry[data-property-name='0']"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_property_tree_toml .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='database']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='database'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='credentials']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='credentials'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='username']"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='username'] > .property-row .property-value"}, "equals": "editor"},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_property_tree_ics .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='VCALENDAR']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='VCALENDAR'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='VEVENT']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='VEVENT'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='ATTENDEE']"}, "count": 2},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='VALARM']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='ATTENDEE'] > .property-row .property-toggle", "index": 0}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='parameters']"}, "count": 1},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='parameters'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='CN']"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='CN'] > .property-row .property-value"}, "equals": "Alice"},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='VALARM'] > .property-row .property-toggle"}},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='DESCRIPTION']"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='DESCRIPTION'] > .property-row .property-value"}, "equals": "Review starts soon"},
    {"type": "click", "target": {"selector": "#property-filter"}},
    {"type": "type", "target": {"selector": "#property-filter"}, "text": "attendee"},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='ATTENDEE']"}, "count": 2},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='VALARM']"}, "count": 0}
  ]
}
