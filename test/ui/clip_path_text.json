{
  "name": "clip-path clips text glyphs, on plain, rotated and rotated-child boxes",
  "html": "test/ui/clip_path_text.html",
  "viewport": {"width": 700, "height": 320},
  "events": [
    {"type": "assert_pixel", "target": {"selector": "#plain", "offset_x": 60, "offset_y": 30}, "force_render": true, "max_r": 80, "min_b": 150},
    {"type": "assert_pixel", "target": {"selector": "#plain", "offset_x": 280, "offset_y": 30}, "min_r": 240},
    {"type": "assert_pixel", "target": {"selector": "#rotated", "offset_x": 60, "offset_y": 30}, "max_r": 80, "min_b": 150},
    {"type": "assert_pixel", "target": {"selector": "#rotated", "offset_x": 280, "offset_y": 30}, "min_r": 240},
    {"type": "assert_pixel", "target": {"selector": "#rotated-child", "offset_x": 60, "offset_y": 30}, "max_r": 80, "min_b": 150},
    {"type": "assert_pixel", "target": {"selector": "#rotated-child", "offset_x": 280, "offset_y": 30}, "min_r": 240}
  ]
}
