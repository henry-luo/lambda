{
  "name": "Flex factors remain computed on grid-item parents",
  "html": "test/ui/css_flex_grid_parent.html",
  "viewport": {
    "width": 480,
    "height": 180
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-grow",
      "equals": "3|3"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-shrink",
      "equals": "3|3"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#growRed"
      },
      "relative_to": "#growHost",
      "x": 0,
      "y": 0,
      "width": 90,
      "height": 20,
      "tolerance": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#growHost",
        "offset_x": 85,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#growHost",
        "offset_x": 95,
        "offset_y": 5
      },
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#shrinkRed"
      },
      "relative_to": "#shrinkHost",
      "x": 0,
      "y": 0,
      "width": 30,
      "height": 20,
      "tolerance": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#shrinkHost",
        "offset_x": 25,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#shrinkHost",
        "offset_x": 35,
        "offset_y": 5
      },
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-dirty-grow",
      "equals": "4|4"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-dirty-shrink",
      "equals": "4|4"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#growRed"
      },
      "relative_to": "#growHost",
      "x": 0,
      "y": 0,
      "width": 96,
      "height": 20,
      "tolerance": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#growHost",
        "offset_x": 91,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#growHost",
        "offset_x": 101,
        "offset_y": 5
      },
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#shrinkRed"
      },
      "relative_to": "#shrinkHost",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 20,
      "tolerance": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#shrinkHost",
        "offset_x": 19,
        "offset_y": 5
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#shrinkHost",
        "offset_x": 29,
        "offset_y": 5
      },
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 255,
      "max_b": 255
    }
  ]
}
