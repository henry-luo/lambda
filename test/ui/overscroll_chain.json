{
  "name": "Wheel scroll chains only unused movement and obeys overscroll behavior",
  "html": "test/ui/overscroll_chain.html",
  "viewport": {"width": 400, "height": 500},
  "events": [
    {"type": "scroll", "target": {"selector": "#auto-inner"}, "dx": 0, "dy": -1},
    {"type": "assert_state_store", "target": {"selector": "#auto-inner"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 50, "tolerance": 1},
    {"type": "assert_state_store", "target": {"selector": "#auto-outer"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 0, "tolerance": 1},
    {"type": "scroll", "target": {"selector": "#auto-inner"}, "dx": 0, "dy": -4},
    {"type": "assert_state_store", "target": {"selector": "#auto-inner"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 140, "tolerance": 1},
    {"type": "assert_state_store", "target": {"selector": "#auto-outer"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 110, "tolerance": 1},
    {"type": "scroll", "target": {"selector": "#contained"}, "dx": 0, "dy": -4},
    {"type": "assert_state_store", "target": {"selector": "#contained"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 140, "tolerance": 1},
    {"type": "assert_state_store", "target": {"selector": "#contained-outer"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 0, "tolerance": 1},
    {"type": "scroll", "target": {"selector": "#override"}, "dx": 0, "dy": -4},
    {"type": "assert_state_store", "target": {"selector": "#override"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 140, "tolerance": 1},
    {"type": "assert_state_store", "target": {"selector": "#override-outer"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 60, "tolerance": 1},
    {"type": "scroll", "target": {"selector": "#hidden-inner"}, "dx": 0, "dy": -1},
    {"type": "assert_state_store", "target": {"selector": "#hidden-inner"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 0, "tolerance": 1},
    {"type": "assert_state_store", "target": {"selector": "#hidden-outer"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 50, "tolerance": 1},
    {"type": "scroll", "target": {"selector": "#horizontal-inner"}, "dx": -4, "dy": 0},
    {"type": "assert_state_store", "target": {"selector": "#horizontal-inner"},
     "view_state": true, "kind": "scroll", "view_scroll_x": 140, "tolerance": 1},
    {"type": "assert_state_store", "target": {"selector": "#horizontal-outer"},
     "view_state": true, "kind": "scroll", "view_scroll_x": 0, "tolerance": 1}
  ]
}
