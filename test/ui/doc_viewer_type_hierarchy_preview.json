{
  "name": "Document viewer renders the type hierarchy DOT graph",
  "html": "test/ui/doc_viewer.ls",
  "viewport": {"width": 1280, "height": 900},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "type_hierarchy.dot"},
    {"type": "click", "target": {"selector": ".tree-hit-__doc .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__doc_img .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__doc_img_type_hierarchy_dot .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph.lambda-graph"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph node[data-node-id='scalar']"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#rendered-preview graph edge"}, "min": 20}
  ]
}
