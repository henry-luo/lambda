{
  "name": "editor4c-phase-c: Enter and Shift+Enter keep an indented list item aligned",
  "html": "test/html/editor-dom.html",
  "viewport": {"width": 900, "height": 700},
  "events": [
    {"type": "wait", "ms": 250},
    {"type": "click", "target": {"selector": ".rdt-surface li", "index": 1}},
    {"type": "wait", "ms": 80},
    {"type": "click", "target": {"selector": "button.rdt-btn[title=\"Indent list item (Tab)\"]"}},
    {"type": "render_pending"},
    {"type": "assert_attribute", "target": {"selector": ".rdt-surface li", "index": 1}, "attribute": "style", "contains": "margin-inline-start:1.75em"},
    {"type": "key_press", "key": "Enter"},
    {"type": "render_pending"},
    {"type": "assert_count", "target": {"selector": ".rdt-surface li"}, "equals": 4},
    {"type": "assert_attribute", "target": {"selector": ".rdt-surface li", "index": 2}, "attribute": "style", "contains": "margin-inline-start:1.75em"},
    {"type": "type", "target": {"selector": ".rdt-surface"}, "text": "New line"},
    {"type": "key_combo", "key": "Enter", "mods_str": "shift"},
    {"type": "type", "target": {"selector": ".rdt-surface"}, "text": "continued"},
    {"type": "render_pending"},
    {"type": "assert_count", "target": {"selector": ".rdt-surface li"}, "equals": 4},
    {"type": "assert_count", "target": {"selector": ".rdt-surface li br"}, "equals": 1},
    {"type": "assert_attribute", "target": {"selector": ".rdt-surface li", "index": 2}, "attribute": "style", "contains": "margin-inline-start:1.75em"},
    {"type": "assert_text", "target": {"selector": ".rdt-surface li", "index": 2}, "contains": "continued"}
  ]
}
