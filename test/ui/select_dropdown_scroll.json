      "scale": 2
    },
    {
      "type": "click",
      "target": {
        "selector": "#fonts"
      }
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#fonts"
      },
      "open_dropdown": true,
      "dropdown_scroll_y": 570
    },
    {
      "type": "mouse_down",
      "x": 214,
      "y": 210
    },
    {
      "type": "mouse_move",
      "x": 300,
      "y": 20
    },
    {
      "type": "mouse_up",
      "x": 300,
      "y": 20
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#fonts"
      },
      "dropdown_dragging": false,
      "dropdown_scroll_y": 0,
      "doc_scroll_y": 0
    },
    {
      "type": "capture_surface",
      "source": "page",
      "file": "temp/word/tests/font-scroll-2x.png"
    },
    {
      "type": "click",
      "x": 100,
      "y": 64
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#fonts"
      },
      "equals": "0"
    }
