{
  "name": "Doc viewer shifts clean tree rows after directory resize",
  "html": "test/ui/doc_viewer.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "assert_rect", "target": {"selector": ".tree-entry[data-tree-path='./test/layout'] + .tree-entry > .tree-row"},
     "relative_to": ".tree-hit-__test_layout", "y": 28, "height": 28, "tolerance": 2},
    {"type": "click", "target": {"selector": ".tree-hit-__test_layout .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_layout_data"}, "count": 1},
    {"type": "assert_position", "element_a": {"selector": ".tree-hit-__test_validator_test_data"},
     "element_b": {"selector": ".tree-hit-__test_layout"}, "relation": "below", "gap": 800},
    {"type": "click", "target": {"selector": ".tree-hit-__test_layout .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_layout_data"}, "count": 0},
    {"type": "assert_rect", "target": {"selector": ".tree-entry[data-tree-path='./test/layout'] + .tree-entry > .tree-row"},
     "relative_to": ".tree-hit-__test_layout", "y": 28, "height": 28, "tolerance": 2},
    {"type": "click", "target": {"selector": ".tree-hit-__test_layout .tree-label"}},
    {"type": "assert_position", "element_a": {"selector": ".tree-hit-__test_validator_test_data"},
     "element_b": {"selector": ".tree-hit-__test_layout"}, "relation": "below", "gap": 800}
  ]
}
