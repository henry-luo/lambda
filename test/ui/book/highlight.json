{
  "name": "Books demo: drag-select in the chapter frame, highlight, merge, recolor, remove and jump to a highlight",
  "html": "test/ui/book/_library.ls",
  "viewport": {"width": 1280, "height": 820},
  "events": [
    {"type": "log", "message": "Alice, Chapter I: the frame starts at (273, 89) in the window"},
    {"type": "click", "target": {"selector": ".grid [data-book=alice]"}},
    {"type": "wait", "ms": 200},
    {"type": "click", "target": {"selector": "[data-ebook-command=next]"}},
    {"type": "wait", "ms": 150},
    {"type": "click", "target": {"selector": "[data-ebook-command=next]"}},
    {"type": "wait", "ms": 200},
    {"type": "assert_text", "target": {"selector": ".ebook-status"}, "equals": "3 / 15"},
    {"type": "assert_count", "target": {"selector": ".ebook-highlights button"}, "count": 0},

    {"type": "log", "message": "a drag across two lines selects under the pointer and opens the bar"},
    {"type": "mouse_down", "target": {"selector": ".ebook-frame", "offset_x": 50, "offset_y": 270}},
    {"type": "mouse_move", "target": {"selector": ".ebook-frame", "offset_x": 200, "offset_y": 272}},
    {"type": "mouse_move", "target": {"selector": ".ebook-frame", "offset_x": 400, "offset_y": 302}},
    {"type": "mouse_up", "target": {"selector": ".ebook-frame", "offset_x": 400, "offset_y": 302}},
    {"type": "wait", "ms": 150},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlight-bar"}, "attribute": "data-open", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlight-bar"}, "attribute": "data-mode", "equals": "new"},
    {"type": "click", "target": {"selector": ".ebook-swatch[data-ebook-color=yellow]"}},
    {"type": "wait", "ms": 250},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlight-bar"}, "attribute": "data-open", "equals": "false"},
    {"type": "assert_count", "target": {"selector": ".ebook-highlights button"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".ebook-highlights button:nth-child(1) .ebook-highlight-quote"}, "contains": "Alice was beginning to get very tired"},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlights button:nth-child(1)"}, "attribute": "title", "contains": "the book her sister"},

    {"type": "log", "message": "a selection crossing italic text maps back to the same characters"},
    {"type": "mouse_down", "target": {"selector": ".ebook-frame", "offset_x": 147, "offset_y": 472}},
    {"type": "mouse_move", "target": {"selector": ".ebook-frame", "offset_x": 250, "offset_y": 472}},
    {"type": "mouse_move", "target": {"selector": ".ebook-frame", "offset_x": 327, "offset_y": 472}},
    {"type": "mouse_up", "target": {"selector": ".ebook-frame", "offset_x": 327, "offset_y": 472}},
    {"type": "wait", "ms": 150},
    {"type": "click", "target": {"selector": ".ebook-swatch[data-ebook-color=pink]"}},
    {"type": "wait", "ms": 250},
    {"type": "assert_count", "target": {"selector": ".ebook-highlights button"}, "count": 2},
    {"type": "assert_text", "target": {"selector": ".ebook-highlights button:nth-child(2) .ebook-highlight-quote"}, "contains": "so very rem"},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlights button:nth-child(2)"}, "attribute": "data-ebook-color", "equals": "pink"},

    {"type": "log", "message": "a click on a highlight edits it: recolor"},
    {"type": "click", "target": {"selector": ".ebook-frame", "offset_x": 240, "offset_y": 472}},
    {"type": "wait", "ms": 150},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlight-bar"}, "attribute": "data-mode", "equals": "edit"},
    {"type": "assert_attribute", "target": {"selector": ".ebook-swatch[data-ebook-color=pink]"}, "attribute": "aria-pressed", "equals": "true"},
    {"type": "click", "target": {"selector": ".ebook-swatch[data-ebook-color=blue]"}},
    {"type": "wait", "ms": 250},
    {"type": "assert_count", "target": {"selector": ".ebook-highlights button"}, "count": 2},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlights button:nth-child(2)"}, "attribute": "data-ebook-color", "equals": "blue"},

    {"type": "log", "message": "an overlapping selection merges into one highlight"},
    {"type": "mouse_down", "target": {"selector": ".ebook-frame", "offset_x": 300, "offset_y": 270}},
    {"type": "mouse_move", "target": {"selector": ".ebook-frame", "offset_x": 500, "offset_y": 334}},
    {"type": "mouse_move", "target": {"selector": ".ebook-frame", "offset_x": 700, "offset_y": 334}},
    {"type": "mouse_up", "target": {"selector": ".ebook-frame", "offset_x": 700, "offset_y": 334}},
    {"type": "wait", "ms": 150},
    {"type": "click", "target": {"selector": ".ebook-swatch[data-ebook-color=green]"}},
    {"type": "wait", "ms": 250},
    {"type": "assert_count", "target": {"selector": ".ebook-highlights button"}, "count": 2},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlights button:nth-child(1)"}, "attribute": "data-ebook-color", "equals": "green"},
    {"type": "assert_text", "target": {"selector": ".ebook-highlights button:nth-child(1) .ebook-highlight-quote"}, "contains": "Alice was beginning"},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlights button:nth-child(1)"}, "attribute": "title", "contains": "thought Alice"},

    {"type": "log", "message": "Remove deletes the clicked highlight"},
    {"type": "click", "target": {"selector": ".ebook-frame", "offset_x": 60, "offset_y": 270}},
    {"type": "wait", "ms": 150},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlight-bar"}, "attribute": "data-mode", "equals": "edit"},
    {"type": "click", "target": {"selector": ".ebook-unhighlight"}},
    {"type": "wait", "ms": 250},
    {"type": "assert_count", "target": {"selector": ".ebook-highlights button"}, "count": 1},
    {"type": "assert_attribute", "target": {"selector": ".ebook-highlights button:nth-child(1)"}, "attribute": "data-ebook-color", "equals": "blue"},

    {"type": "log", "message": "a highlight in the list opens its chapter from elsewhere in the book"},
    {"type": "click", "target": {"selector": "[data-ebook-command=next]"}},
    {"type": "wait", "ms": 200},
    {"type": "assert_text", "target": {"selector": ".ebook-status"}, "equals": "4 / 15"},
    {"type": "click", "target": {"selector": ".ebook-highlights button:nth-child(1)"}},
    {"type": "wait", "ms": 200},
    {"type": "assert_text", "target": {"selector": ".ebook-status"}, "equals": "3 / 15"}
  ]
}
