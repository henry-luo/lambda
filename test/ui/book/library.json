{
  "name": "Books demo: shelves, collections, sorting, search, and opening and closing a book in the ebook reader",
  "html": "test/ui/book/_library.ls",
  "viewport": {"width": 1280, "height": 820},
  "events": [
    {"type": "log", "message": "a fresh library: nothing to continue, every book up next, six collections"},
    {"type": "assert_text", "target": {"selector": ".shelf-head h1"}, "equals": "Home"},
    {"type": "assert_count", "target": {"selector": ".continue"}, "count": 0},
    {"type": "assert_count", "target": {"selector": ".grid .book"}, "count": 7},
    {"type": "assert_count", "target": {"selector": ".grid .book img.cover"}, "count": 7},
    {"type": "assert_count", "target": {"selector": ".collections .collection"}, "count": 6},
    {"type": "assert_text", "target": {"selector": "[data-section=unread] .nav-count"}, "equals": "7"},

    {"type": "log", "message": "a collection shelf, sorted by title past a leading article, then by author"},
    {"type": "click", "target": {"selector": ".nav [data-section=Gothic]"}},
    {"type": "assert_text", "target": {"selector": ".shelf-head h1"}, "equals": "Gothic"},
    {"type": "assert_count", "target": {"selector": ".grid .book"}, "count": 2},
    {"type": "click", "target": {"selector": ".nav [data-section=all]"}},
    {"type": "assert_attribute", "target": {"selector": ".nav [data-section=all]"}, "attribute": "aria-current", "equals": "page"},
    {"type": "click", "target": {"selector": "[data-sort=title]"}},
    {"type": "assert_attribute", "target": {"selector": "[data-sort=title]"}, "attribute": "aria-pressed", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": ".grid .book:nth-child(1)"}, "attribute": "data-book", "equals": "sherlock"},
    {"type": "assert_attribute", "target": {"selector": ".grid .book:nth-child(7)"}, "attribute": "data-book", "equals": "time-machine"},
    {"type": "click", "target": {"selector": "[data-sort=author]"}},
    {"type": "assert_attribute", "target": {"selector": ".grid .book:nth-child(7)"}, "attribute": "data-book", "equals": "frankenstein"},

    {"type": "log", "message": "search matches authors as you type; a section clears it"},
    {"type": "type", "target": {"selector": "#search"}, "text": "wells"},
    {"type": "assert_text", "target": {"selector": ".shelf-head h1"}, "equals": "Results for “wells”"},
    {"type": "assert_count", "target": {"selector": ".results .book"}, "count": 1},
    {"type": "assert_attribute", "target": {"selector": ".results .book"}, "attribute": "data-book", "equals": "time-machine"},
    {"type": "click", "target": {"selector": ".nav [data-section=home]"}},
    {"type": "assert_value", "target": {"selector": "#search"}, "equals": ""},
    {"type": "assert_text", "target": {"selector": ".shelf-head h1"}, "equals": "Home"},

    {"type": "log", "message": "a cover opens the book in the package reader; Library returns to the shelves"},
    {"type": "click", "target": {"selector": ".grid [data-book=alice]"}},
    {"type": "wait", "ms": 200},
    {"type": "assert_count", "target": {"selector": ".ebook-reader"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".ebook-title"}, "equals": "Alice's Adventures in Wonderland"},
    {"type": "assert_text", "target": {"selector": ".ebook-status"}, "equals": "1 / 15"},
    {"type": "click", "target": {"selector": "[data-ebook-command=next]"}},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": ".ebook-status"}, "equals": "2 / 15"},
    {"type": "click", "target": {"selector": "[data-act=close]"}},
    {"type": "assert_count", "target": {"selector": ".ebook-reader"}, "count": 0},
    {"type": "assert_count", "target": {"selector": ".continue"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "[data-section=reading] .nav-count"}, "equals": "1"},

    {"type": "log", "message": "Escape also closes the reader; the most recent book leads Continue Reading"},
    {"type": "click", "target": {"selector": ".grid [data-book=dracula]"}},
    {"type": "wait", "ms": 200},
    {"type": "assert_text", "target": {"selector": ".ebook-title"}, "equals": "Dracula"},
    {"type": "key_press", "key": "Escape"},
    {"type": "assert_count", "target": {"selector": ".continue"}, "count": 2},
    {"type": "assert_attribute", "target": {"selector": ".continue-row .continue:nth-child(1)"}, "attribute": "data-book", "equals": "dracula"},
    {"type": "assert_count", "target": {"selector": ".grid .book"}, "count": 5}
  ]
}
