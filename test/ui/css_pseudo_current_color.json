{
  "name":"Pseudo currentColor reads use the receiving pseudo through defaults and inheritance",
  "html":"test/ui/css_pseudo_current_color.html",
  "viewport":{"width":480,"height":240},
  "events":[
    {"type":"click","target":{"selector":"#check"}},
