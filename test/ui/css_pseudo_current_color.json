    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-after","equals":"rgb(0, 128, 0)|rgb(0, 128, 0)|rgb(0, 128, 0)"},
    {"type":"assert_pixel","target":{"selector":"#patch","offset_x":8,"offset_y":8},"min_r":0,"max_r":0,"min_g":0,"max_g":0,"min_b":255,"max_b":255},
    {"type":"assert_pixel","target":{"selector":"#patch","offset_x":8,"offset_y":2},"min_r":0,"max_r":0,"min_g":128,"max_g":128,"min_b":0,"max_b":0},
    {"type":"click","target":{"selector":"#change"}},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-dirty-before","equals":"rgb(128, 0, 128)|rgb(128, 0, 128)|rgb(128, 0, 128)|rgb(128, 0, 128)"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-dirty-after","equals":"rgb(0, 0, 255)|rgb(0, 0, 255)|rgb(0, 0, 255)"},
    {"type":"assert_pixel","target":{"selector":"#patch","offset_x":8,"offset_y":8},"min_r":128,"max_r":128,"min_g":0,"max_g":0,"min_b":128,"max_b":128},
    {"type":"assert_pixel","target":{"selector":"#patch","offset_x":8,"offset_y":2},"min_r":0,"max_r":0,"min_g":0,"max_g":0,"min_b":255,"max_b":255},
    {"type":"click","target":{"selector":"#literal"}},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-literal-before","equals":"rgb(128, 0, 128)|rgb(128, 0, 128)|rgb(128, 0, 128)|rgb(128, 0, 128)"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-literal-after","equals":"rgb(0, 0, 255)|rgb(255, 0, 0)|rgb(0, 0, 255)"},
    {"type":"assert_pixel","target":{"selector":"#patch","offset_x":8,"offset_y":8},"min_r":128,"max_r":128,"min_g":0,"max_g":0,"min_b":128,"max_b":128},
    {"type":"assert_pixel","target":{"selector":"#patch","offset_x":8,"offset_y":2},"min_r":255,"max_r":255,"min_g":0,"max_g":0,"min_b":0,"max_b":0}
  ]
