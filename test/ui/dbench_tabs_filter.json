{
  "name":"DBench restores each tab's table filter",
  "html":"test/demo/dbench/dbench.ls",
  "viewport":{"width":1280,"height":800},
  "input_turn_ms":0,
  "events":[
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"select_option","target":{"selector":"#filter-column"},"value":"city"},
    {"type":"type","target":{"selector":"#filter-value"},"text":"Penang","clear":true},
    {"type":"click","target":{"selector":"#apply-filter"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"click","target":{"selector":"#tab-new"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true","assert_timeout":30000},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"select_option","target":{"selector":"#filter-column"},"value":"name"},
    {"type":"type","target":{"selector":"#filter-value"},"text":"Customer 001","clear":true},
    {"type":"click","target":{"selector":"#apply-filter"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false","assert_timeout":30000},
    {"type":"click","target":{"selector":"#tab-1"}},
    {"type":"assert_script","js":"document.getElementById('filter-column').value==='city' && document.getElementById('filter-value').value==='Penang'","assert_timeout":5000},
    {"type":"click","target":{"selector":"#tab-2"}},
    {"type":"assert_script","js":"document.getElementById('filter-column').value==='name' && document.getElementById('filter-value').value==='Customer 001'","assert_timeout":5000}
  ]
}
