    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-contributions",
      "equals": "0,0,200,1"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
