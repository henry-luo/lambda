      "target": {
        "selector": "#report"
      },
      "attribute": "data-explicit",
      "equals": "222,0,3,1"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-automatic",
      "equals": "349,0,1,1"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-items",
