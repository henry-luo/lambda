{
  "name": "Sheet clock and random formulas",
  "html": "test/demo/sheet/sheet.ls",
  "viewport": {"width": 1440, "height": 900},
  "input_turn_ms": 0,
  "events": [
    {"type":"wait", "ms":100},
    {"type":"click", "target":{"selector":"#cell-B14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=ISNUMBER(TODAY())", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-B14"}, "contains":"TRUE"},
    {"type":"click", "target":{"selector":"#cell-C14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=NOW()>=TODAY()", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-C14"}, "contains":"TRUE"},
    {"type":"click", "target":{"selector":"#cell-D14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=AND(RANDOM()>=0,RANDOM()<1)", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-D14"}, "contains":"TRUE"},
    {"type":"click", "target":{"selector":"#cell-E14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=IF(B14,TODAY(),1/0)>0", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-E14"}, "contains":"TRUE"},
    {"type":"click", "target":{"selector":"#cell-B14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=RAND()", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"click", "target":{"selector":"#cell-C14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=B14", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"click", "target":{"selector":"#cell-D14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=B14=C14", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-D14"}, "contains":"TRUE"},
    {"type":"click", "target":{"selector":"#cell-B16"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=SEQUENCE(2)+RAND()", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"click", "target":{"selector":"#cell-C16"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=ABS(B17-B16-1)<0.000001", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-C16"}, "contains":"TRUE"}
  ]
}
