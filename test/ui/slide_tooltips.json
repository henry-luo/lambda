        "selector": ".slide-controls [data-slide-command=previous]"
      }
    },
    {
      "type": "assert_visible",
      "target": {
        "selector": ".slide-tooltip"
      },
      "visible": true
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".slide-tooltip"
      },
      "equals": "Previous (Left Arrow)"
    },
    {
      "type": "assert_script",
      "js": "(()=>{const t=document.querySelector('.slide-tooltip').getBoundingClientRect(),b=document.querySelector('.slide-controls').getBoundingClientRect();return t.left>=0 && t.right<=window.innerWidth+1 && t.top<b.top})()"
