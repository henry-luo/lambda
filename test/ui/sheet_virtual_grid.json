{
  "name": "Sheet virtual grid mounts visible rows and columns and reveals offscreen cells",
  "html": "test/demo/sheet/sheet.ls",
  "viewport": {"width": 1440, "height": 900},
  "input_turn_ms": 0,
  "events": [
    {"type": "wait", "ms": 200},
    {"type": "script", "js": "window.sheetBeforeSmallScroll=document.getElementById('sheet-grid');window.sheetBeforeLastRow=window.sheetBeforeSmallScroll.dataset.lastRow;window.sheetBeforeLastColumn=window.sheetBeforeSmallScroll.dataset.lastColumn;const p=document.getElementById('grid-scroll');p.scrollTop=27;p.scrollLeft=30;p.dispatchEvent(new Event('scroll'))"},
    {"type": "wait", "ms": 100},
    {"type": "assert_script", "js": "(()=>{const p=document.getElementById('grid-scroll'),g=document.getElementById('sheet-grid');return p.scrollTop>0 && p.scrollLeft>0 && g===window.sheetBeforeSmallScroll && g.dataset.lastRow===window.sheetBeforeLastRow && g.dataset.lastColumn===window.sheetBeforeLastColumn && +g.dataset.firstRow===0 && document.getElementById('cell-A1')!==null})()"},
    {"type": "resize", "width": 1440, "height": 650},
    {"type": "assert_script", "js": "+document.getElementById('sheet-grid').dataset.lastRow<+window.sheetBeforeLastRow"},
    {"type": "resize", "width": 1440, "height": 900},
    {"type": "assert_script", "js": "+document.getElementById('sheet-grid').dataset.lastRow>=+window.sheetBeforeLastRow"},
    {"type": "assert_script", "js": "(()=>{const n=getComputedStyle(document.getElementById('cell-C5')),e=getComputedStyle(document.getElementById('cell-H20'));return n.fontSize==='12px' && e.fontSize==='12px' && n.textAlign==='right' && e.textAlign==='left'})()"},
    {"type": "click", "target": {"selector": "#status-zoom-in"}},
    {"type": "assert_script", "js": "getComputedStyle(document.getElementById('cell-H20')).fontSize==='13.2px'"},
    {"type": "click", "target": {"selector": "#status-zoom-out"}},
    {"type": "assert_script", "js": "(()=>{const g=document.getElementById('sheet-grid');return +g.dataset.firstRow===0 && +g.dataset.lastRow<60 && +g.dataset.firstColumn===0 && +g.dataset.lastColumn<20 && g.querySelectorAll('td[data-row]').length<500})()"},
    {"type": "script", "js": "const p=document.getElementById('grid-scroll');p.scrollTop=900;p.scrollLeft=1100;p.dispatchEvent(new Event('scroll'))"},
    {"type": "wait", "ms": 100},
    {"type": "assert_script", "js": "(()=>{const p=document.getElementById('grid-scroll'),g=document.getElementById('sheet-grid');return p.scrollTop>0 && p.scrollLeft>0 && +g.dataset.firstRow>0 && +g.dataset.firstColumn>0 && !document.getElementById('cell-A1') && g.querySelectorAll('td[data-row]').length<500})()"},
    {"type": "type", "target": {"selector": "#name-box"}, "text": "A1", "clear": true},
    {"type": "key_press", "key": "Enter"},
    {"type": "wait", "ms": 100},
    {"type": "assert_script", "js": "document.getElementById('cell-A1')!==null && document.getElementById('grid-scroll').scrollTop===0 && document.getElementById('grid-scroll').scrollLeft===0"},
    {"type": "assert_focus", "target": {"selector": "#sheet-grid"}},
    {"type": "type", "target": {"selector": "#name-box"}, "text": "T60", "clear": true},
    {"type": "key_press", "key": "Enter"},
    {"type": "wait", "ms": 100},
    {"type": "assert_script", "js": "(()=>{const p=document.getElementById('grid-scroll'),g=document.getElementById('sheet-grid');return document.getElementById('cell-T60')!==null && p.scrollTop>0 && p.scrollLeft>0 && g.querySelectorAll('td[data-row]').length<500})()"},
    {"type": "click", "target": {"selector": "#open"}},
    {"type": "type", "target": {"selector": "#file-path"}, "text": "test/demo/sheet/tests/fixtures/large.sheet.json", "clear": true},
    {"type": "click", "target": {"selector": "#dialog-confirm"}},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": "#cell-A1"}, "contains": "First"},
    {"type": "script", "js": "const p=document.getElementById('grid-scroll');for(let i=0;i<100;i++){p.scrollTop=1000000+i*27;p.scrollLeft=45000+i*12;p.dispatchEvent(new Event('scroll'))}"},
    {"type": "assert_script", "js": "(()=>{const p=document.getElementById('grid-scroll'),g=document.getElementById('sheet-grid');return p.scrollTop>1000000 && +g.dataset.firstRow>37000 && +g.dataset.firstColumn>300 && g.querySelectorAll('td[data-row]').length<500})()", "assert_timeout": 30000},
    {"type": "type", "target": {"selector": "#name-box"}, "text": "ALL100000", "clear": true},
    {"type": "key_press", "key": "Enter"},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": "#cell-ALL100000"}, "contains": "Last"},
    {"type": "assert_script", "js": "(()=>{const p=document.getElementById('grid-scroll'),g=document.getElementById('sheet-grid');return g.getAttribute('aria-rowcount')==='100000' && g.getAttribute('aria-colcount')==='1000' && +g.dataset.firstRow>99900 && +g.dataset.firstColumn>980 && p.scrollTop>2000000 && p.scrollLeft>100000 && g.querySelectorAll('td[data-row]').length<500})()"},
    {"type": "type", "target": {"selector": "#name-box"}, "text": "A1", "clear": true},
    {"type": "key_press", "key": "Enter"},
    {"type": "key_press", "key": "F2"},
    {"type": "type", "target": {"selector": "#cell-editor"}, "text": "Saved draft", "clear": true},
    {"type": "script", "js": "const p=document.getElementById('grid-scroll');p.scrollTop=2000000;p.dispatchEvent(new Event('scroll'))"},
    {"type": "wait", "ms": 100},
    {"type": "type", "target": {"selector": "#name-box"}, "text": "A1", "clear": true},
    {"type": "key_press", "key": "Enter"},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": "#cell-A1"}, "contains": "Saved draft"}
  ]
}
