{
  "name": "upstream Editor.js publishes typing and block insertion mutations",
  "html": "test/editable-editors/fixtures/editorjs/typing.html",
  "default_timeout": 10000,
  "viewport": {"width": 720, "height": 420},
  "events": [
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "seed"},
    {"type": "assert_text", "target": {"selector": "#changes"}, "equals": "[]"},
    {"type": "focus", "target": {"selector": ".ce-paragraph"}},
    {"type": "key_press", "key": "End"},
    {"type": "type_physical", "target": {"selector": ".ce-paragraph"}, "text": "-change"},
    {"type": "assert_text", "target": {"selector": "#state"}, "contains": "seed-change"},
    {"type": "assert_text", "target": {"selector": "#changes"}, "contains": "block-changed"},
    {"type": "key_press", "key": "Enter"},
    {"type": "assert_count", "target": {"selector": ".ce-block"}, "equals": 5},
    {"type": "assert_text", "target": {"selector": "#changes"}, "contains": "block-added"}
  ]
}
