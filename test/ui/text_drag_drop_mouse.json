{
  "name": "text drag-and-drop driven by real mouse events (ES21)",
  "html": "test/ui/text_drag_drop_mouse.html",
  "viewport": {"width": 500, "height": 400},
  "events": [
    {"type": "render_pending"},
    {"type": "log", "message": "=== select HELLO in #src, then drag it into #dst ==="},
    {"type": "click", "target": {"selector": "#src"}},
    {"type": "set_editing_selection", "target": {"selector": "#src"}, "start": 0, "end": 5},
    {"type": "render_pending"},
    {"type": "assert_editing_value", "target": {"selector": "#src"}, "equals": "HELLO world"},
    {"type": "assert_editing_value", "target": {"selector": "#dst"}, "equals": ""},

    {"type": "log", "message": "--- press inside the selection: arms a drag, not a new selection ---"},
    {"type": "mouse_down", "x": 35, "y": 24, "button": 0},
    {"type": "mouse_move", "x": 90, "y": 40},
    {"type": "mouse_move", "x": 30, "y": 62},
    {"type": "mouse_up", "x": 30, "y": 62, "button": 0},
    {"type": "render_pending"},

    {"type": "log", "message": "--- a plain drag moves: source loses it, target gains it ---"},
    {"type": "assert_editing_value", "target": {"selector": "#dst"}, "equals": "HELLO"},
    {"type": "assert_editing_value", "target": {"selector": "#src"}, "equals": " world"},

    {"type": "log", "message": "--- ctrl-drag copies instead: #dst keeps its text ---"},
    {"type": "click", "target": {"selector": "#dst"}},
    {"type": "set_editing_selection", "target": {"selector": "#dst"}, "start": 0, "end": 5},
    {"type": "render_pending"},
    {"type": "mouse_down", "x": 35, "y": 62, "button": 0, "mods_str": "ctrl"},
    {"type": "mouse_move", "x": 90, "y": 80, "mods_str": "ctrl"},
    {"type": "mouse_move", "x": 20, "y": 95, "mods_str": "ctrl"},
    {"type": "mouse_up", "x": 20, "y": 95, "button": 0, "mods_str": "ctrl"},
    {"type": "render_pending"},
    {"type": "assert_editing_value", "target": {"selector": "#ta"}, "equals": "HELLO"},
    {"type": "assert_editing_value", "target": {"selector": "#dst"}, "equals": "HELLO"},

    {"type": "log", "message": "--- a press outside the selection still starts a plain selection ---"},
    {"type": "click", "target": {"selector": "#src"}},
    {"type": "set_editing_selection", "target": {"selector": "#src"}, "start": 0, "end": 2},
    {"type": "render_pending"},
    {"type": "mouse_down", "x": 55, "y": 24, "button": 0},
    {"type": "mouse_move", "x": 90, "y": 24},
    {"type": "mouse_up", "x": 90, "y": 24, "button": 0},
    {"type": "render_pending"},
    {"type": "assert_editing_value", "target": {"selector": "#src"}, "equals": " world"},

    {"type": "log", "message": "--- drag a selection at the END out: the press offset must not survive as a stale anchor ---"},
    {"type": "set_editing_value", "target": {"selector": "#src"}, "text": "HELLO world"},
    {"type": "set_editing_value", "target": {"selector": "#dst"}, "text": ""},
    {"type": "set_editing_value", "target": {"selector": "#ta"}, "text": ""},
    {"type": "click", "target": {"selector": "#src"}},
    {"type": "set_editing_selection", "target": {"selector": "#src"}, "start": 6, "end": 11},
    {"type": "render_pending"},
    {"type": "mouse_down", "x": 90, "y": 24, "button": 0},
    {"type": "mouse_move", "x": 60, "y": 45},
    {"type": "mouse_move", "x": 20, "y": 62},
    {"type": "mouse_up", "x": 20, "y": 62, "button": 0},
    {"type": "render_pending"},
    {"type": "assert_editing_value", "target": {"selector": "#src"}, "equals": "HELLO "},
    {"type": "assert_editing_value", "target": {"selector": "#dst"}, "equals": "world"},

    {"type": "log", "message": "--- double-click inside a selection still selects a word, it does not drag ---"},
    {"type": "set_editing_value", "target": {"selector": "#src"}, "text": "alpha beta"},
    {"type": "click", "target": {"selector": "#src"}},
    {"type": "set_editing_selection", "target": {"selector": "#src"}, "start": 0, "end": 10},
    {"type": "render_pending"},
    {"type": "dblclick", "target": {"selector": "#src"}, "x": 20, "y": 24},
    {"type": "render_pending"},
    {"type": "assert_editing_value", "target": {"selector": "#src"}, "equals": "alpha beta"},

    {"type": "log", "message": "--- a click inside a selection collapses to the press offset on release ---"},
    {"type": "set_editing_value", "target": {"selector": "#src"}, "text": "abcdefghij"},
    {"type": "click", "target": {"selector": "#src"}},
    {"type": "set_editing_selection", "target": {"selector": "#src"}, "start": 0, "end": 7},
    {"type": "render_pending"},
    {"type": "mouse_down", "x": 43, "y": 24, "button": 0},
    {"type": "mouse_up", "x": 43, "y": 24, "button": 0},
    {"type": "render_pending"},
    {"type": "assert_form_selection", "target": {"selector": "#src"}, "start": 3, "end": 3}
  ]
}
