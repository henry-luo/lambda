{
  "name": "Document editor renders nested HTML email body",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 900, "height": 5000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_input_html_nested_eml"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_html_nested_eml .tree-label"}},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "html_nested.eml"},
    {"type": "assert_text", "target": {"selector": ".eml-header-table tr[data-header-name='subject'] td"}, "equals": "Field Notes: a new map for darker skies"},
    {"type": "assert_text", "target": {"selector": "#eml-body .mail-hero"}, "contains": "A new map for darker skies"},
    {"type": "assert_style", "target": {"selector": "#eml-body .mail-hero"}, "property": "background-color", "equals": "rgb(24, 48, 74)"},
    {"type": "assert_count", "target": {"selector": "#eml-body head"}, "count": 0},
    {"type": "assert_count", "target": {"selector": "#eml-body.eml-html-body h2"}, "count": 2},
    {"type": "assert_text", "target": {"selector": "#eml-body h2:first-of-type"}, "equals": "Watch the sky"},
    {"type": "assert_style", "target": {"selector": "#eml-body h2:first-of-type"}, "property": "font-size", "equals": "17px"},
    {"type": "assert_text", "target": {"selector": "#eml-body .mail-callout strong"}, "equals": "New to stargazing?"},
    {"type": "assert_text", "target": {"selector": "#eml-body li strong"}, "equals": "Find the Summer Triangle"},
    {"type": "assert_text", "target": {"selector": "#eml-body table"}, "contains": "Meteor watch from the north lawn"},
    {"type": "assert_text", "target": {"selector": "#eml-body a"}, "equals": "September observing guide"},
    {"type": "assert_count", "target": {"selector": "#eml-body pre"}, "count": 0},
    {"type": "render", "file": "./temp/doc_editor_eml_html_preview.png"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "Content-Type: multipart/mixed"}
  ]
}
