{
  "name": "DBench saves non-secret profiles, reloads them and connects to SQLite",
  "html": "temp/dbench-prepared/profiles/dbench/dbench.ls",
  "prepare": ["python3", "test/demo/dbench/tests/_prepare_ui.py", "profiles"],
  "viewport": {"width": 1280, "height": 800},
  "input_turn_ms": 0,
  "events": [
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true","assert_timeout":30000},
    {"type":"click","target":{"selector":"#profile-open"}},
    {"type":"focus","target":{"selector":"#sql"}},
    {"type":"key_press","key":"Enter","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-mode","equals":"table"},
    {"type":"type","target":{"selector":"#profile-file"},"text":"temp/dbench-profile-missing.json","clear":true},
    {"type":"click","target":{"selector":"#profile-load"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Profile operation failed","assert_timeout":30000},
    {"type":"type","target":{"selector":"#profile-file"},"text":"temp/dbench-profile-network.json","clear":true},
    {"type":"type","target":{"selector":"#profile-name"},"text":"Remote sample","clear":true},
    {"type":"select_option","target":{"selector":"#profile-engine"},"value":"postgresql"},
    {"type":"type","target":{"selector":"#profile-host"},"text":"db.example","clear":true},
    {"type":"type","target":{"selector":"#profile-database"},"text":"sales","clear":true},
    {"type":"type","target":{"selector":"#profile-user"},"text":"reader","clear":true},
    {"type":"type","target":{"selector":"#profile-ca"},"text":"certs/root.pem","clear":true},
    {"type":"type","target":{"selector":"#profile-password"},"text":"never-save-this","clear":true},
    {"type":"click","target":{"selector":"#profile-save"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Saved profile temp/dbench-profile-network.json","assert_timeout":30000},
    {"type":"click","target":{"selector":"#profile-save"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Profile operation failed","assert_timeout":30000},
    {"type":"key_press","key":"Escape"},
    {"type":"assert_count","target":{"selector":".profile-panel"},"equals":0},
    {"type":"click","target":{"selector":"#profile-open"}},
    {"type":"assert_script","js":"document.getElementById('profile-password').value===''"},
    {"type":"type","target":{"selector":"#profile-host"},"text":"wrong.example","clear":true},
    {"type":"click","target":{"selector":"#profile-load"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Loaded profile temp/dbench-profile-network.json","assert_timeout":30000},
    {"type":"assert_script","js":"document.getElementById('profile-host').value==='db.example' && document.getElementById('profile-user').value==='reader' && document.getElementById('profile-password').value===''"},
    {"type":"type","target":{"selector":"#profile-file"},"text":"temp/dbench-profile-sqlite.json","clear":true},
    {"type":"type","target":{"selector":"#profile-name"},"text":"Local sample","clear":true},
    {"type":"select_option","target":{"selector":"#profile-engine"},"value":"sqlite"},
    {"type":"type","target":{"selector":"#profile-path"},"text":"test/demo/dbench/sample.sqlite","clear":true},
    {"type":"click","target":{"selector":"#profile-save"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Saved profile temp/dbench-profile-sqlite.json","assert_timeout":30000},
    {"type":"type","target":{"selector":"#profile-path"},"text":"does-not-exist.sqlite","clear":true},
    {"type":"click","target":{"selector":"#profile-load"}},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Loaded profile temp/dbench-profile-sqlite.json","assert_timeout":30000},
    {"type":"assert_script","js":"document.getElementById('profile-path').value==='test/demo/dbench/sample.sqlite'"},
    {"type":"click","target":{"selector":"#profile-connect"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-generation","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true","assert_timeout":30000},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-editable-sqlite","equals":"true"}
  ]
}
