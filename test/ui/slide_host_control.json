{
  "name": "Embedded slide player driven by a host: no controls, slide_command events, deck position",
  "html": "test/ui/slide_host_control.ls",
  "viewport": {"width": 500, "height": 400},
  "events": [
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-duration", "equals": "3200"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-toolbar", "equals": "false"},
    {"type": "assert_script", "js": "document.querySelector('.slide-toolbar-hide')===null && document.querySelector('.slide-toolbar-reveal')===null && getComputedStyle(document.querySelector('.slide-controls')).display==='none'"},
    {"type": "click", "target": {"selector": "[data-host='play']"}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-autoplay", "equals": "true"},
    {"type": "assert_script", "js": "globalThis.t0=+document.getElementById('film').getAttribute('data-slide-position-at'); document.getElementById('film').getAttribute('data-slide-position')==='0'"},
    {"type": "advance_time", "ms": 1600},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-index", "equals": "1"},
    {"type": "assert_script", "js": "const f=document.getElementById('film'); const p=+f.getAttribute('data-slide-position'), at=+f.getAttribute('data-slide-position-at'); p>=1400 && Math.abs((p-(at-t0)))<0.5"},
    {"type": "click", "target": {"selector": "[data-host='pause']"}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-paused", "equals": "true"},
    {"type": "click", "target": {"selector": "[data-host='seek:1550']"}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-position", "equals": "1550"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-phase", "equals": "transition"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-paused", "equals": "true"},
    {"type": "advance_time", "ms": 500},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-position", "equals": "1550"},
    {"type": "click", "target": {"selector": "[data-host='speed:2']"}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-rate", "equals": "2"},
    {"type": "assert_script", "js": "document.querySelector('.slide-speed-value').textContent==='2×'"},
    {"type": "click", "target": {"selector": "[data-host='resume']"}},
    {"type": "advance_time", "ms": 900},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-index", "equals": "2"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-autoplay", "equals": "false"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-position", "equals": "3200"},
    {"type": "click", "target": {"selector": "[data-host='seek:9000']"}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-slide-position", "equals": "3200"},
    {"type": "key_press", "key": "h", "target": {"selector": "#film"}},
    {"type": "assert_script", "js": "getComputedStyle(document.querySelector('.slide-controls')).display==='none'"}
  ]
}
