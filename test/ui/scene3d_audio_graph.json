{
  "name": "Scene3D native bus graphs route copied sources and retain their graph identity",
  "html": "test/ui/scene3d_audio.html",
  "viewport": {"width": 200, "height": 160},
  "env": [{"key":"LAMBDA_AUDIO_OUTPUT","value":"offline"}],
  "input_turn_ms": 0,
  "event_interval_ms": 0,
  "events": [
    {"type":"script","js":"globalThis.audioWorld=document.getElementById('world');globalThis.effectsBus=document.createElement('audio-bus');effectsBus.setAttribute('id','effects');effectsBus.setAttribute('gain','.5');effectsBus.setAttribute('smoothing','0');audioWorld.appendChild(effectsBus);globalThis.masterBus=document.createElement('audio-bus');masterBus.setAttribute('id','master');masterBus.setAttribute('gain','.5');masterBus.setAttribute('smoothing','0');audioWorld.appendChild(masterBus);document.getElementById('speaker').setAttribute('bus','effects');audioSceneRequest('open')"},
    {"type":"assert_script","js":"sceneAudio.buses.length===2&&sceneAudio.buses[0].id==='master'&&sceneAudio.buses[1].id==='effects'&&typeof sceneAudio.buses[1].identity==='bigint'&&sceneAudio.routing_generation>0n&&sceneAudio.sources[0].bus==='effects'"},
    {"type":"script","js":"globalThis.effectsIdentity=sceneAudio.buses[1].identity;audioSceneRequest('play')"},
    {"type":"advance_time","ms":25,"steps":1},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.sources[0].state==='playing'&&sceneAudio.buses[0].peak>.1&&sceneAudio.buses[0].peak<.13&&sceneAudio.buses[1].peak>.2&&sceneAudio.buses[1].frames>0n"},
    {"type":"script","js":"sceneAudio.buses[1].gain=99;effectsBus.setAttribute('gain','.25');audioSceneRequest('read')"},
    {"type":"advance_time","ms":25,"steps":1},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.buses[1].gain===.25&&sceneAudio.buses[1].identity===effectsIdentity&&sceneAudio.buses[0].peak>.05&&sceneAudio.buses[0].peak<.065"},
    {"type":"script","js":"effectsBus.setAttribute('mute','true')"},
    {"type":"advance_time","ms":25,"steps":1},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.buses[0].peak===0&&sceneAudio.buses[1].mute&&sceneAudio.sources[0].state==='playing'"},
    {"type":"script","js":"globalThis.peerSource=document.createElement('audio-source');peerSource.setAttribute('id','peer');peerSource.setAttribute('clip','tone');peerSource.setAttribute('position','-1 0 0');peerSource.setAttribute('smoothing','0');peerSource.setAttribute('loop','true');audioWorld.appendChild(peerSource);effectsBus.setAttribute('mute','false');effectsBus.setAttribute('solo','true');audioSceneRequest('play','peer')"},
    {"type":"advance_time","ms":25,"steps":1},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.sources.length===2&&sceneAudio.sources[1].state==='playing'&&sceneAudio.buses[1].solo&&sceneAudio.buses[0].peak>.05&&sceneAudio.buses[0].peak<.065"},
    {"type":"script","js":"globalThis.ceilingInsert=document.createElement('audio-effect');ceilingInsert.setAttribute('type','limiter');ceilingInsert.setAttribute('ceiling','.1');effectsBus.appendChild(ceilingInsert)"},
    {"type":"advance_time","ms":25,"steps":1},
    {"type":"script","js":"audioSceneRequest('read')"},
    {"type":"assert_script","js":"sceneAudio.buses[1].inserts[0].type==='limiter'&&Math.abs(sceneAudio.buses[1].inserts[0].ceiling-.1)<1e-6&&Math.abs(sceneAudio.buses[1].peak-.025)<1e-6&&Math.abs(sceneAudio.buses[0].peak-.0125)<1e-6&&!sceneAudio.routing_faulted"},
    {"type":"script","js":"audioSceneRequest('reset')"},
    {"type":"assert_script","js":"sceneAudio.sources[0].state==='ready'&&sceneAudio.sources[1].state==='ready'&&!sceneAudio.routing_active&&sceneAudio.buses[1].identity===effectsIdentity&&sceneAudio.document_players===1n"}
  ]
}
