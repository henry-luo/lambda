      "type": "assert_hit_test",
      "x": 40,
      "y": 40,
      "expected_selector": "#straight-path"
    },
    {
      "type": "click",
      "x": 40,
      "y": 40
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#scene"
      },
      "attribute": "data-last",
      "equals": "straight-path"
    },
