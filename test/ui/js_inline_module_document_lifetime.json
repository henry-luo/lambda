{
  "name": "Inline modules retain distinct records and the document URL across history updates",
  "html": "test/ui/js_inline_module_document_lifetime.html",
  "events": [
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-first",
      "equals": "first"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-static",
      "equals": "external-module"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-meta",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-second",
      "equals": "second"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-dynamic",
      "equals": "external-module"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-third",
      "equals": "third"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#result"
      },
      "attribute": "data-final-meta",
      "equals": "true"
    }
  ]
}
