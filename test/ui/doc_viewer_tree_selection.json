{
  "name": "Doc viewer keeps directory state during document actions",
  "html": "lmd/package/doc/doc_viewer.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__doc .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__doc_Lambda_Cheatsheet_md"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__doc_Lambda_Cheatsheet_md .tree-label"}},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "Lambda_Cheatsheet.md"},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__doc_Lambda_Cheatsheet_md.selected"}, "count": 1},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_count", "target": {"selector": ".source-tab-panel"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__doc_Lambda_Cheatsheet_md"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__doc", "offset_x": 250, "offset_y": 14}},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__doc_Lambda_Cheatsheet_md"}, "count": 0},
    {"type": "click", "target": {"selector": ".tree-hit-__doc", "offset_x": 250, "offset_y": 14}},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__doc_Lambda_Cheatsheet_md.selected"}, "count": 1}
  ]
}
