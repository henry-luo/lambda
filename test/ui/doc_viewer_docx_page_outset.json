{
  "name": "DOCX clips cover art to the paper and paints signed crop outsets",
  "html": "test/input/docx/drawing-page-outset.docx",
  "viewport": {"width": 1100, "height": 800},
  "events": [
    {"type": "resize", "width": 1100, "height": 800},
    {"type": "assert_count", "target": {"selector": ".docx-import-notes li"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".docx-document > .docx-anchor"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".docx-document p", "index": 0}, "equals": "Cover"},
    {"type": "assert_script", "js": "const paper = document.querySelector('.docx-document').getBoundingClientRect(); const art = document.querySelector('.docx-document > .docx-anchor').getBoundingClientRect(); Math.abs(art.x - paper.x + 20) < 1 && Math.abs(art.y - paper.y + 10) < 1"},
    {"type": "assert_rect", "target": {"selector": ".docx-image-crop"}, "width": 200, "height": 100, "tolerance": 1},
    {"type": "assert_rect", "target": {"selector": ".docx-image-crop img"}, "width": 160, "height": 80, "tolerance": 1},
    {"type": "assert_pixel", "target": {"selector": ".docx-document", "offset_x": 8, "offset_y": 8}, "max_r": 5, "min_g": 165, "max_g": 175, "min_b": 12, "max_b": 22},
    {"type": "assert_pixel", "target": {"selector": ".docx-document", "offset_x": -8, "offset_y": 8}, "min_r": 190},
    {"type": "assert_pixel", "target": {"selector": ".docx-image-crop", "offset_x": 10, "offset_y": 10}, "min_r": 245, "min_g": 245, "min_b": 245},
    {"type": "assert_pixel", "target": {"selector": ".docx-image-crop", "offset_x": 100, "offset_y": 90}, "min_r": 245, "min_g": 245, "min_b": 245},
    {"type": "assert_pixel", "target": {"selector": ".docx-image-crop", "offset_x": 100, "offset_y": 40}, "min_r": 30, "max_r": 42, "min_g": 102, "max_g": 116, "min_b": 186, "max_b": 200}
  ]
}
