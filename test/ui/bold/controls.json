{
  "name":"bold native controls, application requests, and mixed-family radio ownership",
  "html":"test/ui/bold/controls.ls",
  "viewport":{"width":1000,"height":1600},
  "events":[
    {"type":"type","target":{"selector":"#name"},"text":"Ada"},
    {"type":"assert_value","target":{"selector":"#name"},"equals":"Ada"},
    {"type":"assert_text","target":{"selector":"#last"},"equals":"name"},
    {"type":"type","target":{"selector":"#notes"},"text":"Retained notes"},
    {"type":"click","target":{"selector":"#increment"}},
    {"type":"assert_text","target":{"selector":"#count"},"equals":"1"},
    {"type":"assert_value","target":{"selector":"#name"},"equals":"Ada"},
    {"type":"assert_value","target":{"selector":"#notes"},"equals":"Retained notes"},
    {"type":"type","target":{"selector":"#fixed"},"text":"X"},
    {"type":"wait","ms":80},
    {"type":"assert_value","target":{"selector":"#fixed"},"equals":"seed"},
    {"type":"click","target":{"selector":"#fixed-check"}},
    {"type":"wait","ms":80},
    {"type":"assert_checked","target":{"selector":"#fixed-check"},"checked":false},
    {"type":"click","target":{"selector":"#check"}},
    {"type":"assert_checked","target":{"selector":"#check"},"checked":true},
    {"type":"click","target":{"selector":"#switch"}},
    {"type":"assert_checked","target":{"selector":"#switch"},"checked":true},
    {"type":"click","target":{"selector":"#radio-b"}},
    {"type":"assert_checked","target":{"selector":"#radio-a"},"checked":false},
    {"type":"assert_checked","target":{"selector":"#radio-b"},"checked":true},
    {"type":"click","target":{"selector":"#bold-radio"}},
    {"type":"wait","ms":80},
    {"type":"assert_checked","target":{"selector":"#ant-radio"},"checked":true},
    {"type":"assert_checked","target":{"selector":"#bold-radio"},"checked":false},
    {"type":"click","target":{"selector":"#select"}},
    {"type":"key_press","key":"down"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_value","target":{"selector":"#select"},"equals":"20"},
    {"type":"assert_text","target":{"selector":"#type"},"equals":"int"},
    {"type":"click","target":{"selector":"#disabled"}},
    {"type":"assert_text","target":{"selector":"#count"},"equals":"1"},
    {"type":"type","target":{"selector":"#accepted"},"text":"Accepted"},
    {"type":"wait","ms":80},
    {"type":"assert_value","target":{"selector":"#accepted"},"equals":"Accepted"},
    {"type":"click","target":{"selector":"#submit"}},
    {"type":"assert_text","target":{"selector":"#last"},"equals":"form:submit"},
    {"type":"assert_text","target":{"selector":"#requested"},"equals":"project=Lambda"},
    {"type":"type","target":{"selector":"#form-name"},"text":"X"},
    {"type":"click","target":{"selector":"#reset"}},
    {"type":"assert_value","target":{"selector":"#form-name"},"equals":"Lambda"},
    {"type":"assert_text","target":{"selector":"#last"},"equals":"form:reset"}
  ]
}
