{
  "name": "foreignObject CSS geometry changes layout, DOM bounds and actual HTML hit targets together",
  "html": "test/ui/svg_foreign_object_geometry.html",
  "viewport": {
    "width": 360,
    "height": 260
  },
  "events": [
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#scene"
      },
      "attribute": "data-rectangles",
      "equals": "20,20,100,40,20,90,200,50"
    },
    {
      "type": "assert_hit_test",
      "x": 25,
      "y": 25,
      "expected_selector": "#content"
    },
    {
      "type": "click",
      "x": 30,
      "y": 220
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#scene"
      },
      "attribute": "data-rectangles",
      "equals": "60,20,140,40,20,90,200,70"
    },
    {
      "type": "assert_pixel",
      "x": 65,
      "y": 25,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 195,
      "y": 55,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "assert_pixel",
      "x": 25,
      "y": 25,
      "min_r": 247,
      "max_r": 255,
      "min_g": 247,
      "max_g": 255,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 215,
      "y": 155,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_hit_test",
      "x": 65,
      "y": 25,
      "expected_selector": "#content"
    }
  ]
}
