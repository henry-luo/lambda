{
  "name": "Play runs and resumes the deck; Restart returns to the opening",
  "html": "test/demo/slides/slide_presentation.slides",
  "viewport": {"width": 1100, "height": 700},
  "events": [
    {"type": "click", "target": {"selector": "[data-slide-command=play]"}},
    {"type": "advance_time", "ms": 700, "steps": 14},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-autoplay", "equals": "true"},
    {"type": "assert_style", "target": {"selector": "#demo-s0-o0"}, "property": "opacity", "equals": "1"},
    {"type": "assert_style", "target": {"selector": "#demo-s0-o1"}, "property": "opacity", "equals": "0"},
    {"type": "click", "target": {"selector": "[data-slide-command=pause]"}},
    {"type": "advance_time", "ms": 5000, "steps": 10},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-paused", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "0"},
    {"type": "assert_style", "target": {"selector": "#demo-s0-o1"}, "property": "opacity", "equals": "0"},
    {"type": "click", "target": {"selector": "[data-slide-command=play]"}},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-paused", "equals": "false"},
    {"type": "advance_time", "ms": 20000, "steps": 40},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "1"},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-cue", "equals": "1"},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-autoplay", "equals": "false"},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-phase", "equals": "waiting"},
    {"type": "assert_text", "target": {"selector": ".slide-status"}, "equals": "2 / 2"},
    {"type": "assert_style", "target": {"selector": "#demo-s1-o2"}, "property": "opacity", "equals": "1"},
    {"type": "click", "target": {"selector": "[data-slide-command=restart]"}},
    {"type": "advance_time", "ms": 700, "steps": 14},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "0"},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-autoplay", "equals": "false"},
    {"type": "assert_text", "target": {"selector": ".slide-status"}, "equals": "1 / 2"},
    {"type": "assert_style", "target": {"selector": "#demo-s0-o0"}, "property": "opacity", "equals": "1"},
    {"type": "assert_style", "target": {"selector": "#demo-s0-o1"}, "property": "opacity", "equals": "0"},
    {"type": "click", "target": {"selector": "[data-slide-command=play]"}},
    {"type": "advance_time", "ms": 20000, "steps": 40},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "1"},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-autoplay", "equals": "false"},
    {"type": "click", "target": {"selector": "[data-slide-command=play]"}},
    {"type": "click", "target": {"selector": "[data-slide-command=pause]"}},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "0"},
    {"type": "assert_text", "target": {"selector": ".slide-status"}, "equals": "1 / 2"},
    {"type": "click", "target": {"selector": "[data-slide-command=next]"}},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-autoplay", "equals": "false"}
  ]
}
