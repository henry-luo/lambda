{
  "name": "SVG image HTML integration fragments follow the cached URL clock",
  "html": "test/ui/svg_smil_image_fragments.html",
  "viewport": {
    "width": 170,
    "height": 120
  },
  "events": [
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 247,
      "max_r": 255,
      "min_g": 0,
      "max_g": 8,
      "min_b": 0,
      "max_b": 8
    },
    {
      "type": "advance_time",
      "ms": 600
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#show"
      }
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 20,
      "min_r": 0,
      "max_r": 8,
      "min_g": 0,
      "max_g": 8,
      "min_b": 247,
      "max_b": 255
    },
    {
      "type": "assert_pixel",
      "x": 100,
