{
  "name": "Calculated animation times and piecewise easing reach opacity, transform paint and live mutation",
  "html": "test/ui/css_motion_math_animation.html",
  "viewport": {
    "width": 240,
    "height": 140
  },
  "events": [
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "animation-duration",
      "equals": "2s"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "animation-delay",
      "equals": "-1s"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "animation-timing-function",
      "equals": "linear(0 0%, 0.25 50%, 1 100%)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "opacity",
      "equals": "0.25",
      "animated": true,
      "tolerance": 0.001
    },
    {
      "type": "assert_pixel",
      "x": 40,
      "y": 70,
      "min_r": 254,
      "max_r": 255,
      "min_g": 190,
      "max_g": 192,
      "min_b": 190,
      "max_b": 192
    },
    {
      "type": "assert_hit_test",
      "x": 40,
      "y": 70,
      "expected_selector": "#box"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#web"
      },
      "property": "opacity",
      "equals": "0.25",
      "animated": true,
      "tolerance": 0.001
    },
    {
      "type": "advance_time",
      "ms": 500,
      "steps": 5
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "opacity",
      "equals": "0.25",
      "animated": true,
      "tolerance": 0.001
    },
    {
      "type": "click",
      "target": {
        "selector": "#duration"
      }
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "animation-duration",
      "equals": "4s"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "opacity",
      "equals": "0.125",
      "animated": true,
