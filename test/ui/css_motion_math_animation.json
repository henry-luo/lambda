    {
      "type": "assert_pixel",
      "x": 50,
      "y": 70,
      "min_r": 254,
      "max_r": 255,
      "min_g": 254,
      "max_g": 255,
      "min_b": 254,
      "max_b": 255
    },
    {
      "type": "assert_hit_test",
      "x": 30,
      "y": 70,
      "expected_selector": "#box"
    },
    {
      "type": "click",
      "target": {
        "selector": "#curve"
      }
    },
    {
