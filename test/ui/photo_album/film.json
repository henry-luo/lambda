{
  "name": "Photo album film: playback without player controls, film bar, chapters, scrubbing, deterministic seeks, offline soundtrack",
  "html": "test/demo/photo-album/photo-album.ls",
  "env": [
    {"key": "PHOTO_ALBUM_DIR", "value": "test/demo/photo-album/fixture"},
    {"key": "LAMBDA_AUDIO_OUTPUT", "value": "offline"}
  ],
  "viewport": {"width": 1400, "height": 900},
  "events": [
    {"type": "advance_time", "ms": 100},
    {"type": "click", "target": {"selector": "#film-button"}},
    {"type": "advance_time", "ms": 100},
    {"type": "assert_script", "js": "getComputedStyle(document.getElementById('film')).display==='flex' && document.getElementById('album').getAttribute('data-film')==='true'"},
    {"type": "assert_focus", "target": {"selector": "#film"}},
    {"type": "assert_text", "target": {"selector": "#film-length"}, "equals": "1:04"},
    {"type": "assert_attribute", "target": {"selector": "#album-film"}, "attribute": "data-slide-duration", "equals": "64000"},
    {"type": "assert_attribute", "target": {"selector": "#album-film"}, "attribute": "data-slide-toolbar", "equals": "false"},
    {"type": "assert_script", "js": "document.querySelector('#album-film .slide-toolbar-hide')===null && document.querySelector('#album-film .slide-toolbar-reveal')===null && getComputedStyle(document.querySelector('#album-film .slide-controls')).display==='none'"},
    {"type": "assert_script", "js": "[...document.querySelectorAll('[data-film-chapter]')].map(b=>b.getAttribute('data-film-seek')).join(',')==='3000,25000,47000'"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-sound", "equals": "playing"},
    {"type": "assert_attribute", "target": {"selector": "#album-film"}, "attribute": "data-slide-index", "equals": "0"},

    {"type": "advance_time", "ms": 4000},
    {"type": "assert_attribute", "target": {"selector": "#album-film"}, "attribute": "data-slide-index", "equals": "1"},
    {"type": "assert_text", "target": {"selector": "#film-time"}, "equals": "0:04"},
    {"type": "assert_script", "js": "const w=parseFloat(document.getElementById('film-fill').style.width); w>6 && w<7"},
    {"type": "assert_attribute", "target": {"selector": "[data-film-chapter='0']"}, "attribute": "aria-current", "equals": "true"},

    {"type": "key_press", "key": "space"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "false"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-sound", "equals": "paused"},
    {"type": "assert_attribute", "target": {"selector": "#film-play"}, "attribute": "aria-label", "equals": "Play"},
    {"type": "script", "js": "globalThis.parked=document.getElementById('album-film').getAttribute('data-slide-position')"},
    {"type": "advance_time", "ms": 1500},
    {"type": "assert_script", "js": "document.getElementById('album-film').getAttribute('data-slide-position')===parked && document.getElementById('film-time').textContent==='0:04'"},

    {"type": "click", "target": {"selector": "[data-film-chapter='1']"}},
    {"type": "assert_attribute", "target": {"selector": "#album-film"}, "attribute": "data-slide-position", "equals": "25000"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "false"},
    {"type": "assert_text", "target": {"selector": "#film-time"}, "equals": "0:25"},
    {"type": "assert_attribute", "target": {"selector": "[data-film-chapter='1']"}, "attribute": "aria-current", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#album-film"}, "attribute": "data-slide-index", "equals": "12"},

    {"type": "key_press", "key": "space"},
    {"type": "advance_time", "ms": 1000},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-sound", "equals": "playing"},
    {"type": "assert_text", "target": {"selector": "#film-time"}, "equals": "0:26"},
    {"type": "key_press", "key": "right"},
    {"type": "assert_script", "js": "const p=+document.getElementById('album-film').getAttribute('data-slide-position'); p>=30900 && p<=31100"},
    {"type": "key_press", "key": "left"},
    {"type": "key_press", "key": "left"},
    {"type": "assert_script", "js": "const p=+document.getElementById('album-film').getAttribute('data-slide-position'); p>=20900 && p<=21100"},

    {"type": "script", "js": "globalThis.pose=()=>[...document.querySelectorAll('#album-film [data-slide-active=true] .slide-effect')].map(e=>e.style.transform+'|'+e.style.opacity).join(';')"},
    {"type": "key_press", "key": "space"},
    {"type": "click", "target": {"selector": "[data-film-chapter='2']"}},
    {"type": "key_press", "key": "right"},
    {"type": "advance_time", "ms": 50},
    {"type": "script", "js": "globalThis.first=pose()"},
    {"type": "key_press", "key": "home"},
    {"type": "advance_time", "ms": 50},
    {"type": "click", "target": {"selector": "[data-film-chapter='2']"}},
    {"type": "key_press", "key": "right"},
    {"type": "advance_time", "ms": 50},
    {"type": "assert_script", "js": "first.length>0 && pose()===first && document.getElementById('album-film').getAttribute('data-slide-position')==='52000'"},

    {"type": "key_press", "key": "space"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "true"},
    {"type": "mouse_down", "target": {"selector": "#film-track", "offset_x": 500, "offset_y": 11}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "false"},
    {"type": "assert_script", "js": "const p=+document.getElementById('album-film').getAttribute('data-slide-position'); const w=document.getElementById('film-track').getBoundingClientRect().width; Math.abs(p-500/w*64000)<100"},
    {"type": "mouse_move", "target": {"selector": "#film-track", "offset_x": 750, "offset_y": 11}},
    {"type": "assert_script", "js": "const p=+document.getElementById('album-film').getAttribute('data-slide-position'); const w=document.getElementById('film-track').getBoundingClientRect().width; globalThis.dropped=750/w*64000; Math.abs(p-dropped)<100"},
    {"type": "mouse_up", "target": {"selector": "#film-track", "offset_x": 750, "offset_y": 11}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "true"},
    {"type": "advance_time", "ms": 1000},
    {"type": "assert_script", "js": "const p=+document.getElementById('album-film').getAttribute('data-slide-position'), at=+document.getElementById('album-film').getAttribute('data-slide-position-at'); document.getElementById('film').getAttribute('data-playing')==='true' && p>=dropped-1"},

    {"type": "click", "target": {"selector": "#film-stage"}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "false"},
    {"type": "key_press", "key": "m"},
    {"type": "assert_attribute", "target": {"selector": "#film-sound"}, "attribute": "aria-pressed", "equals": "false"},
    {"type": "click", "target": {"selector": "#film-play"}},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-sound", "equals": "paused"},
    {"type": "key_press", "key": "m"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-sound", "equals": "playing"},

    {"type": "key_press", "key": "end"},
    {"type": "advance_time", "ms": 100},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-ended", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#film-play"}, "attribute": "aria-label", "equals": "Play again"},
    {"type": "assert_text", "target": {"selector": "#film-time"}, "equals": "1:04"},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-sound", "equals": "paused"},
    {"type": "key_press", "key": "space"},
    {"type": "advance_time", "ms": 500},
    {"type": "assert_attribute", "target": {"selector": "#film"}, "attribute": "data-playing", "equals": "true"},
    {"type": "assert_attribute", "target": {"selector": "#album-film"}, "attribute": "data-slide-index", "equals": "0"},
    {"type": "advance_time", "ms": 1500},
    {"type": "capture_surface", "source": "page", "file": "temp/photo_album/film.png"},

    {"type": "key_press", "key": "escape"},
    {"type": "assert_script", "js": "getComputedStyle(document.getElementById('film')).display==='none' && document.getElementById('album-film')===null && document.getElementById('album').getAttribute('data-film')==='false'"},
    {"type": "assert_focus", "target": {"selector": "#port"}},

    {"type": "click", "target": {"selector": "#grid .tile"}},
    {"type": "click", "target": {"selector": "#grid .tile:nth-child(2)"}, "mods": 8},
    {"type": "click", "target": {"selector": "#grid .tile:nth-child(3)"}, "mods": 8},
    {"type": "assert_text", "target": {"selector": "#selection-count"}, "equals": "3 selected"},
    {"type": "click", "target": {"selector": "#selection-film"}},
    {"type": "advance_time", "ms": 100},
    {"type": "assert_text", "target": {"selector": "#film-length"}, "equals": "0:14"},
    {"type": "assert_script", "js": "document.querySelectorAll('[data-film-chapter]').length===1"},
    {"type": "click", "target": {"selector": "#film-close"}},
    {"type": "assert_focus", "target": {"selector": "#port"}}
  ]
}
