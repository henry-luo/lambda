{
  "name": "Content visibility relevance, remembered sizes, nested scrollports and hidden focus",
  "html": "test/ui/css_content_visibility_relevance.html",
  "viewport": {
    "width": 360,
    "height": 260
  },
  "events": [
    {
      "type": "assert_rect",
      "target": {
        "selector": "#auto"
      },
      "height": 40
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#nested"
      },
      "height": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#down"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#auto"
      },
      "height": 120
    },
    {
      "type": "click",
      "target": {
        "selector": "#up"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#auto"
      },
      "height": 120
    },
    {
      "type": "click",
      "target": {
        "selector": "#grow"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#auto"
      },
      "height": 120
    },
    {
      "type": "click",
      "target": {
        "selector": "#down"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#auto"
      },
      "height": 160
    },
    {
      "type": "click",
      "target": {
        "selector": "#up"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#auto"
      },
      "height": 160
    },
    {
      "type": "click",
      "target": {
        "selector": "#pane-down"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#nested"
      },
      "height": 70
    },
    {
      "type": "click",
      "target": {
        "selector": "#pane-up"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#nested"
      },
      "height": 70
    },
    {
      "type": "assert_pixel",
      "x": 50,
      "y": 170,
      "min_r": 0,
      "max_r": 0,
      "min_g": 128,
      "max_g": 128,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#hide"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#hidden"
      },
      "height": 40
    },
    {
      "type": "assert_pixel",
      "x": 50,
      "y": 170,
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "assert_hit_test",
      "x": 50,
      "y": 170,
      "expected_selector": "#hidden"
    },
    {
      "type": "click",
      "target": {
        "selector": "#focus-hidden"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#focus-hidden"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#show"
      }
    },
    {
      "type": "assert_pixel",
      "x": 50,
      "y": 170,
      "min_r": 0,
      "max_r": 0,
      "min_g": 128,
      "max_g": 128,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#focus-auto"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#auto-focus"
      }
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#auto"
      },
      "height": 160
    }
  ]
}
