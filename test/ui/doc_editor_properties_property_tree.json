{
  "name": "Document editor nests dotted Java properties keys as a property tree",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1600},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "test.properties"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_properties .tree-label"}},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "test.properties"},
    {"type": "assert_count", "target": {"selector": "#property-preview"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name=''] > .property-row .property-value"}, "equals": "empty_key_value"},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='app.name']"}, "count": 0},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='app'] > .property-row .property-value"}, "equals": "4 properties"},
    {"type": "click", "target": {"selector": ".property-entry[data-property-name='app'] > .property-row .property-toggle"}},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='name'] > .property-row .property-value"}, "equals": "MyApplication"},
    {"type": "assert_text", "target": {"selector": ".property-entry[data-property-name='log-level'] > .property-row .property-value"}, "equals": "INFO"},
    {"type": "click", "target": {"selector": "#property-filter"}},
    {"type": "type", "target": {"selector": "#property-filter"}, "text": "size"},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='size']"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".property-entry[data-property-name='app']"}, "count": 0},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "database.connection.pool.size"}
  ]
}
