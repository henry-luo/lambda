{
  "name": "Hide arrow and bottom-right hot corner: restored toolbar reserves its committed height and remains on screen without resize",
  "html": "test/demo/slides/presenter_tools.slides",
  "viewport": {"width": 724, "height": 596},
  "events": [
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 544, "height": 52},
    {"type": "assert_attribute", "target": {"selector": "[data-slide-command=previous]"}, "attribute": "aria-label", "equals": "Previous"},
    {"type": "assert_count", "target": {"selector": "[data-slide-command=previous] svg"}, "equals": 1},
    {"type": "click", "target": {"selector": ".slide-toolbar-hide"}},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_style", "target": {"selector": ".slide-controls"}, "property": "display", "equals": "none"},
    {"type": "assert_style", "target": {"selector": ".slide-toolbar-reveal"}, "property": "display", "equals": "block"},
    {"type": "assert_rect", "target": {"selector": ".slide-stage"}, "height": 596},
    {"type": "mouse_move", "target": {"selector": ".slide-stage", "offset_x": 200, "offset_y": 200}},
    {"type": "mouse_move", "target": {"selector": ".slide-toolbar-reveal"}},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_style", "target": {"selector": ".slide-toolbar-reveal"}, "property": "display", "equals": "none"},
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 544, "height": 52},
    {"type": "assert_pixel", "target": {"selector": "[data-slide-command=next]", "offset_x": 5, "offset_y": 16}, "min_r": 130, "max_r": 145, "min_g": 215, "max_g": 235, "min_b": 185, "max_b": 210},
    {"type": "key_press", "key": "h"},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-stage"}, "height": 596},
    {"type": "key_press", "key": "h"},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 544, "height": 52},
    {"type": "assert_pixel", "target": {"selector": "[data-slide-command=next]", "offset_x": 5, "offset_y": 16}, "min_r": 130, "max_r": 145, "min_g": 215, "max_g": 235, "min_b": 185, "max_b": 210},
    {"type": "key_press", "key": "h"},
    {"type": "key_press", "key": "h"},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 544, "height": 52},
    {"type": "key_press", "key": "h"},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "resize", "width": 1280, "height": 800},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-stage"}, "height": 800},
    {"type": "key_press", "key": "h"},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 748, "height": 52},
    {"type": "assert_pixel", "target": {"selector": "[data-slide-command=next]", "offset_x": 5, "offset_y": 16}, "min_r": 130, "max_r": 145, "min_g": 215, "max_g": 235, "min_b": 185, "max_b": 210},
    {"type": "resize", "width": 724, "height": 596},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 544, "height": 52},
    {"type": "click", "target": {"selector": "[data-slide-command=next]"}},
    {"type": "assert_attribute", "target": {"selector": "#presenter-demo"}, "attribute": "data-slide-index", "equals": "1"},
    {"type": "assert_text", "target": {"selector": ".slide-status"}, "equals": "2 / 3"},
    {"type": "click", "target": {"selector": "[data-slide-command=previous]"}},
