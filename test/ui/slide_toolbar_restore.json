    {"type": "resize", "width": 480, "height": 596},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 544, "height": 52},
    {"type": "assert_script", "js": "(()=>{const p=document.querySelector('[data-slide-command=previous]').getBoundingClientRect(),l=document.querySelector('[data-slide-tool=pointer]').getBoundingClientRect(),h=document.querySelector('.slide-toolbar-hide').getBoundingClientRect();return Math.abs(p.top-l.top)<1&&h.right<=480&&h.width>=28})()"}
