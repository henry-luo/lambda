    {"type": "click", "target": {"selector": ".slide-toolbar-toggle"}},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_style", "target": {"selector": ".slide-controls"}, "property": "display", "equals": "none"},
    {"type": "assert_rect", "target": {"selector": ".slide-stage"}, "height": 596},
    {"type": "click", "target": {"selector": ".slide-toolbar-toggle"}},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-controls"}, "y": 437, "height": 159},
    {"type": "assert_pixel", "target": {"selector": "[data-slide-command=next]", "offset_x": 10, "offset_y": 10}, "min_r": 130, "max_r": 145, "min_g": 215, "max_g": 235, "min_b": 185, "max_b": 210},
    {"type": "key_press", "key": "h"},
    {"type": "advance_time", "ms": 32, "steps": 2},
    {"type": "assert_rect", "target": {"selector": ".slide-stage"}, "height": 596},
