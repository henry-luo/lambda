    {"type":"assert_attribute","target":{"selector":"#far"},"attribute":"data-trace","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#far"},"attribute":"data-interface","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#far"},"attribute":"data-flags","equals":"true,false,false,false"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-inline","equals":"1"},
    {"type":"click","target":{"selector":"#probe"}},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-constructor","equals":"sample,true,true,false,false,function,undefined"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-new","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-argument","equals":"true"},
    {"type":"click","target":{"selector":"#down"}},
    {"type":"assert_attribute","target":{"selector":"#near"},"attribute":"data-trace","equals":"01"},
    {"type":"assert_attribute","target":{"selector":"#far"},"attribute":"data-trace","equals":"10"},
    {"type":"click","target":{"selector":"#touch"}},
    {"type":"assert_attribute","target":{"selector":"#far"},"attribute":"data-trace","equals":"10"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-bubbled","equals":"0"},
    {"type":"click","target":{"selector":"#remove"}},
    {"type":"click","target":{"selector":"#up"}},
    {"type":"assert_attribute","target":{"selector":"#near"},"attribute":"data-trace","equals":"010"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-inline","equals":"2"},
    {"type":"click","target":{"selector":"#restore"}},
    {"type":"assert_attribute","target":{"selector":"#far"},"attribute":"data-trace","equals":"101"},
    {"type":"click","target":{"selector":"#disable"}},
    {"type":"assert_attribute","target":{"selector":"#near"},"attribute":"data-trace","equals":"010"},
    {"type":"click","target":{"selector":"#enable"}},
    {"type":"assert_attribute","target":{"selector":"#near"},"attribute":"data-trace","equals":"010"},
    {"type":"click","target":{"selector":"#hide"}},
    {"type":"click","target":{"selector":"#show"}},
    {"type":"assert_attribute","target":{"selector":"#near"},"attribute":"data-trace","equals":"010"},
    {"type":"click","target":{"selector":"#cycle"}},
    {"type":"assert_attribute","target":{"selector":"#far"},"attribute":"data-trace","equals":"1011"}
