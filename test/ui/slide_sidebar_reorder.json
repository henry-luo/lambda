{
  "name": "Slides: thumbnail drag reorder, insertion marker, cancellation, auto-scroll, history and saved presentation order",
  "html": "test/demo/slides/slides.ls",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "input_turn_ms": 0,
  "events": [
    {
      "type": "advance_time",
      "ms": 100,
      "steps": 3
    },
    {
      "type": "script",
      "js": "window.thumbnailIds=()=>Array.from(document.querySelectorAll('#thumbnails [data-slide-id]')).map(e=>e.getAttribute('data-slide-id'));window.originalIds=thumbnailIds();window.retainedThumbnail=document.querySelector('[data-slide-id=opening] .thumb-render')"
    },
    {
      "type": "mouse_down",
      "target": {
        "selector": "[data-slide-id=opening]"
      }
    },
    {
      "type": "mouse_move",
      "target": {
        "selector": "[data-slide-id=chapter-4]",
        "offset_x": 40,
        "offset_y": 2
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#slides-editor"
      },
      "attribute": "data-slide-reordering",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#slides-editor"
      },
      "attribute": "data-slide-drop",
      "equals": "2"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#slides-editor"
      },
      "attribute": "data-undo",
      "equals": "0"
