{
  "name": "Document viewer renders RTF paragraphs and inline formatting",
  "html": "test/ui/doc_viewer.ls",
  "viewport": {"width": 1280, "height": 900},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_rtf .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#rtf-preview"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#rtf-preview p:first-child"}, "equals": "RTF Document Test"},
    {"type": "assert_style", "target": {"selector": "#rtf-preview p:first-child span"}, "property": "font-weight", "equals": "700"},
    {"type": "assert_text", "target": {"selector": "#rtf-preview p:nth-child(3) span:first-child"}, "equals": "Bold text"},
    {"type": "assert_style", "target": {"selector": "#rtf-preview p:nth-child(3) span:nth-child(3)"}, "property": "font-style", "equals": "italic"},
    {"type": "assert_style", "target": {"selector": "#rtf-preview p:nth-child(4) span:nth-child(2)"}, "property": "color", "equals": "rgb(255, 0, 0)"},
    {"type": "assert_text", "target": {"selector": "#rtf-preview p:last-child"}, "equals": "End of RTF test document."},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "{\\rtf1"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_count", "target": {"selector": "#rtf-preview"}, "count": 1}
  ]
}
