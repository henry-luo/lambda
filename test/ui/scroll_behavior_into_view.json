{
  "name": "scrollIntoView honors CSS and explicit scrolling behavior",
  "html": "test/ui/scroll_behavior_into_view.html",
  "viewport": {"width": 300, "height": 420},
  "events": [
    {"type": "click", "target": {"selector": "#auto"}},
    {"type": "render_pending"},
    {"type": "advance_time", "ms": 150, "steps": 10},
    {"type": "assert_text", "target": {"selector": "#auto-mid"}, "equals": "in-flight"},
    {"type": "advance_time", "ms": 250, "steps": 16},
    {"type": "assert_state_store", "target": {"selector": "#styled"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 200, "tolerance": 1},
    {"type": "click", "target": {"selector": "#explicit"}},
    {"type": "render_pending"},
    {"type": "advance_time", "ms": 150, "steps": 10},
    {"type": "assert_text", "target": {"selector": "#explicit-mid"}, "equals": "in-flight"},
    {"type": "advance_time", "ms": 250, "steps": 16},
    {"type": "assert_state_store", "target": {"selector": "#plain"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 200, "tolerance": 1},
    {"type": "click", "target": {"selector": "#instant"}},
    {"type": "assert_state_store", "target": {"selector": "#styled"},
     "view_state": true, "kind": "scroll", "view_scroll_y": 200, "tolerance": 1}
  ]
}
