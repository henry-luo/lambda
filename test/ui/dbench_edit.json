{
  "name": "DBench stages and applies an optimistic SQLite edit",
  "html": "temp/dbench-prepared/edit/dbench/dbench.ls",
  "prepare": ["python3", "test/demo/dbench/tests/_prepare_ui.py", "edit"],
  "viewport": {"width": 1280, "height": 800},
  "input_turn_ms": 0,
  "events": [
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"256"},
    {"type":"type","target":{"selector":"#target"},"text":"temp/dbench-edit-ui.sqlite","clear":true},
    {"type":"click","target":{"selector":"#connect"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-connected","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-editable-sqlite","equals":"true"},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"Customer 001"},
    {"type":"click","target":{"selector":"#result-0-1"}},
    {"type":"click","target":{"selector":"#edit-cell"}},
    {"type":"type","target":{"selector":"#edit-value"},"text":"Edited customer","clear":true},
    {"type":"click","target":{"selector":"#stage-value"}},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"Edited customer"},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"UPDATE"},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"Customer 001"},
    {"type":"click","target":{"selector":"#sample"}},
    {"type":"assert_text","target":{"selector":".error"},"contains":"Apply or revert"},
    {"type":"click","target":{"selector":"#apply-changes"}},
    {"type":"wait","ms":400},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"Edited customer"},
    {"type":"assert_count","target":{"selector":".pending"},"equals":0},
    {"type":"click","target":{"selector":"#result-0-1"}},
    {"type":"click","target":{"selector":"#edit-cell"}},
    {"type":"type","target":{"selector":"#edit-value"},"text":"Discarded","clear":true},
    {"type":"click","target":{"selector":"#stage-value"}},
    {"type":"click","target":{"selector":"#revert-changes"}},
    {"type":"assert_count","target":{"selector":".pending"},"equals":0},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"Edited customer"},
    {"type":"click","target":{"selector":"#delete-row"}},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"DELETE"},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"may cascade"},
    {"type":"click","target":{"selector":"#revert-changes"}},
    {"type":"assert_count","target":{"selector":".pending"},"equals":0},
    {"type":"click","target":{"selector":"[data-table=unkeyed]"}},
    {"type":"assert_text","target":{"selector":"#result-0-0"},"contains":"unchanged"},
    {"type":"click","target":{"selector":"#delete-row"}},
    {"type":"assert_text","target":{"selector":".error"},"contains":"no usable primary key"},
    {"type":"assert_count","target":{"selector":".pending"},"equals":0},
    {"type":"click","target":{"selector":"[data-table=customers]"}},
    {"type":"click","target":{"selector":"#insert-row"}},
    {"type":"type","target":{"selector":"#insert-values"},"text":"{\"customer_id\":301,\"name\":\"Inserted\",\"city\":\"Penang\",\"joined_on\":\"2026-11-04\",\"active\":1}","clear":true},
    {"type":"click","target":{"selector":"#stage-insert"}},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"INSERT"},
    {"type":"click","target":{"selector":"#apply-changes"}},
    {"type":"assert_count","target":{"selector":".pending"},"equals":0},
    {"type":"click","target":{"selector":"[data-table=empty_keyed]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-rows","equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"click","target":{"selector":"#insert-row"}},
    {"type":"type","target":{"selector":"#insert-values"},"text":"{\"id\":1,\"note\":\"first\"}","clear":true},
    {"type":"click","target":{"selector":"#stage-insert"}},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"INSERT"},
    {"type":"click","target":{"selector":"#apply-changes"}},
    {"type":"assert_text","target":{"selector":"#result-0-1"},"contains":"first"},
    {"type":"click","target":{"selector":"[data-table=customers]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"click","target":{"selector":"#result-0-5"}},
    {"type":"click","target":{"selector":"#edit-cell"}},
    {"type":"assert_script","js":"document.getElementById('edit-mode').value==='json'"},
    {"type":"type","target":{"selector":"#edit-value"},"text":"0","clear":true},
    {"type":"click","target":{"selector":"#stage-value"}},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"active: 1 → 0"},
    {"type":"click","target":{"selector":"#result-0-5"}},
    {"type":"key_press","key":"ArrowRight"},
    {"type":"click","target":{"selector":"#edit-cell"}},
    {"type":"select_option","target":{"selector":"#edit-mode"},"value":"text"},
    {"type":"type","target":{"selector":"#edit-value"},"text":"Set note","clear":true},
    {"type":"click","target":{"selector":"#stage-value"}},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"note: NULL → Set note"},
    {"type":"assert_text","target":{"selector":"#apply-changes"},"contains":"Apply 1 change"},
    {"type":"click","target":{"selector":"#apply-changes"}},
    {"type":"assert_text","target":{"selector":"#result-0-5"},"contains":"0"},
    {"type":"assert_text","target":{"selector":"#result-0-6"},"contains":"Set note"},
    {"type":"click","target":{"selector":"[data-table=products]"}},
    {"type":"assert_attribute","target":{"selector":"#dbench"},"attribute":"data-loading","equals":"false"},
    {"type":"click","target":{"selector":"#result-6-4"}},
    {"type":"click","target":{"selector":"#edit-cell"}},
    {"type":"assert_script","js":"document.getElementById('edit-mode').value==='hex' && document.getElementById('edit-value').value==='0001ff'"},
    {"type":"type","target":{"selector":"#edit-value"},"text":"aabb","clear":true},
    {"type":"click","target":{"selector":"#stage-value"}},
    {"type":"assert_text","target":{"selector":".pending"},"contains":"0xaabb"},
    {"type":"click","target":{"selector":"#apply-changes"}},
    {"type":"assert_text","target":{"selector":"#result-6-4"},"contains":"binary: 2 bytes"}
  ]
}
