{
  "name": "Document editor splash hands off to a top-level Lambda page",
  "html": "test/ui/doc_editor.html",
  "viewport": {"width": 1280, "height": 900},
  "events": [
    {"type": "assert_visible", "target": {"selector": "#splash"}, "visible": true},
    {"type": "assert_count", "target": {"selector": "#flow-art"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#editor-frame"}, "count": 0},
    {"type": "wait", "ms": 100},
    {"type": "assert_count", "target": {"selector": "#splash"}, "count": 1},
    {"type": "advance_time", "ms": 300, "steps": 6},
    {"type": "assert_style", "target": {"selector": ".loader span"},
     "property": "opacity", "equals": "0.8", "animated": true, "tolerance": 0.2},
    {"type": "assert_count", "target": {"selector": "#splash"}, "count": 0, "assert_timeout": 45000, "assert_interval": 1000},
    {"type": "assert_count", "target": {"selector": ".doc-editor"}, "count": 1},
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "doc_editor.ls"},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": "doc_editor.ls"},
    {"type": "assert_count", "target": {"selector": ".tree-filter-clear"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-filter-clear"}},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": ""},
    {"type": "assert_count", "target": {"selector": ".tree-filter-clear"}, "count": 0}
  ]
}
