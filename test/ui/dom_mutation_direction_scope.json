{
  "name": "Direction selectors retain local attribute updates and recascade real direction changes",
  "html": "test/ui/dom_mutation_direction_scope.html",
  "viewport": {"width": 480, "height": 360},
  "events": [
    {"type": "click", "target": {"selector": "#class-change"}},
    {"type": "assert_reconcile_mode", "mode": "incremental", "reason": "eligible"},
    {"type": "assert_rect", "target": {"selector": "#box"}, "width": 100},
    {"type": "click", "target": {"selector": "#style-change"}},
    {"type": "assert_reconcile_mode", "mode": "incremental", "reason": "eligible"},
    {"type": "assert_rect", "target": {"selector": "#box"}, "width": 140},
    {"type": "click", "target": {"selector": "#style-remove"}},
    {"type": "assert_reconcile_mode", "mode": "incremental", "reason": "eligible"},
    {"type": "assert_rect", "target": {"selector": "#box"}, "width": 100},
    {"type": "click", "target": {"selector": "#data-change"}},
    {"type": "assert_reconcile_mode", "mode": "incremental", "reason": "eligible"},
    {"type": "assert_attribute", "target": {"selector": "#box"}, "attribute": "data-state", "equals": "ready"},
    {"type": "click", "target": {"selector": "#direction-change"}},
    {"type": "assert_reconcile_mode", "mode": "retained_full_layout", "reason": "direction-sensitive-selector"},
    {"type": "assert_rect", "target": {"selector": "#box"}, "height": 30},
    {"type": "click", "target": {"selector": "#text-change"}},
    {"type": "assert_reconcile_mode", "mode": "retained_full_layout", "reason": "direction-sensitive-selector"},
    {"type": "assert_rect", "target": {"selector": "#automatic"}, "width": 120},
    {"type": "click", "target": {"selector": "#value-change"}},
    {"type": "assert_reconcile_mode", "mode": "retained_full_layout", "reason": "direction-sensitive-selector"},
    {"type": "assert_rect", "target": {"selector": "#field"}, "width": 120},
    {"type": "click", "target": {"selector": "#tree-change"}},
    {"type": "assert_reconcile_mode", "mode": "incremental", "reason": "eligible"},
    {"type": "assert_rect", "target": {"selector": "#box"}, "height": 30},
    {"type": "click", "target": {"selector": "#tree-auto-change"}},
    {"type": "assert_reconcile_mode", "mode": "retained_full_layout", "reason": "direction-sensitive-selector"},
    {"type": "assert_rect", "target": {"selector": "#tree-auto"}, "width": 120}
  ]
}
