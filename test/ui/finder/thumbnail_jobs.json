{
  "name":"Thumbnail workers own buffers, validate revisions, cache errors and cancel",
  "html":"test/demo/finder/tests/_thumbnail_jobs.ls",
  "env":[{"key":"LAMBDA_GC_FORCE_EVERY","value":"1"},{"key":"LAMBDA_GC_POISON_FREED","value":"1"}],
  "viewport":{"width":720,"height":200},
  "events":[
    {"type":"click","target":{"selector":"#red"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"red"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-cache","equals":"false"},
    {"type":"assert_pixel","x":20,"y":20,"min_r":254,"max_g":1,"max_b":1},
    {"type":"click","target":{"selector":"#cached"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"cached"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-cache","equals":"true"},
    {"type":"click","target":{"selector":"#blue"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"blue"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-cache","equals":"false"},
    {"type":"assert_pixel","x":20,"y":20,"max_r":1,"max_g":1,"min_b":254},
    {"type":"click","target":{"selector":"#invalidate"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"invalidate"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-cache","equals":"false"},
    {"type":"click","target":{"selector":"#budget"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"budget"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-bytes","equals":"0"},
    {"type":"click","target":{"selector":"#bad"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"bad"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-success","equals":"false"},
    {"type":"assert_pixel","x":20,"y":20,"max_r":1,"max_g":1,"min_b":254},
    {"type":"click","target":{"selector":"#bad-cached"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"bad-cached"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-success","equals":"false"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-cache","equals":"true"},
    {"type":"click","target":{"selector":"#missing"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"missing"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-success","equals":"false"},
    {"type":"click","target":{"selector":"#supersede"}},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-stale","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#probe"},"attribute":"data-label","equals":"supersede"},
    {"type":"click","target":{"selector":"#red"}},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
