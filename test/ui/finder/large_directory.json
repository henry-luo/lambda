{
  "name": "Finder windows large listings, retains selection and stops scrolling at the last row",
  "html": "test/demo/finder/finder.ls",
  "viewport": {"width":1000,"height":650},
  "events": [
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../../../../test","clear":true},
    {"type":"script","js":"globalThis.rowWrites=0;globalThis.rowObserver=new MutationObserver(ms=>{for(const m of ms)if(m.target.classList.contains('file')&&(m.attributeName==='data-focused'||m.attributeName==='aria-selected'))rowWrites++});rowObserver.observe(document.getElementById('files'),{subtree:true,attributes:true})"},
    {"type":"click","target":{"selector":"#go-confirm"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"test"},
    {"type":"assert_script","js":"globalThis.initialCount=Number(document.querySelector('#files .listing-window').getAttribute('data-total'));initialCount>100 && document.querySelectorAll('#files .file').length<initialCount && rowWrites===0"},
    {"type":"assert_script","js":"document.getElementById('files').getBoundingClientRect().height>300 && document.getElementById('files').scrollHeight>document.getElementById('files').clientHeight"},
    {"type":"key_press","key":"end"},
    {"type":"assert_script","js":"document.querySelector('#files [data-focused=true]')?.getAttribute('aria-posinset')===String(initialCount)"},
    {"type":"key_press","key":"home"},
    {"type":"assert_script","js":"document.querySelector('#files [data-focused=true]')?.getAttribute('aria-posinset')==='1'"},
    {"type":"script","js":"rowObserver.disconnect();globalThis.retainedRow=document.querySelector('#files .file');globalThis.retainedName=retainedRow.getAttribute('data-name');globalThis.listChanges=0;globalThis.listObserver=new MutationObserver(ms=>{listChanges+=ms.length});listObserver.observe(document.getElementById('files'),{childList:true})"},
    {"type":"click","target":{"selector":"#files .file"}},
    {"type":"assert_script","js":"document.querySelector('#files .file')===retainedRow && retainedRow.getAttribute('aria-selected')==='true' && retainedRow.getAttribute('data-focused')==='true' && listChanges===0"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"key_press","key":"escape"},
    {"type":"assert_script","js":"document.querySelector('#files .file')===retainedRow && listChanges===0"},
    {"type":"script","js":"listObserver.disconnect()"},
    {"type":"click","target":{"selector":"#list"}},
    {"type":"assert_script","js":"document.querySelector('#files [data-focused=true]').getAttribute('data-name')===retainedName && document.querySelector('#files [data-focused=true]').getAttribute('aria-selected')==='true'"},
    {"type":"click","target":{"selector":"#direction"}},
    {"type":"assert_script","js":"document.querySelector('#files [data-focused=true]').getAttribute('data-name')===retainedName && document.querySelector('#files [data-focused=true]').getAttribute('aria-selected')==='true'"},
    {"type":"type","target":{"selector":"#search"},"text":"README.md","clear":true},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===1 && document.querySelector('#files .file').getAttribute('data-name')==='README.md'"},
    {"type":"click","target":{"selector":"[data-name='README.md']"}},
    {"type":"type","target":{"selector":"#search"},"text":"","clear":true},
    {"type":"assert_script","js":"Number(document.querySelector('#files .listing-window').getAttribute('data-total'))===initialCount && document.querySelector('#files [aria-selected=true]').getAttribute('data-name')==='README.md'"},
    {"type":"click","target":{"selector":"#files"}},
    {"type":"key_combo","key":"a","mods_str":"ctrl"},
    {"type":"assert_script","js":"Number(document.getElementById('finder').getAttribute('data-selected'))===initialCount"},
    {"type":"key_press","key":"end"},
    {"type":"assert_script","js":"document.querySelector('#files [data-focused=true]').getAttribute('aria-posinset')===String(initialCount) && document.getElementById('files').scrollTop>0"},
    {"type":"assert_script","js":"(()=>{const f=document.getElementById('files'),r=document.querySelector('#files .file:last-child');return f.scrollHeight-(r.getBoundingClientRect().bottom-f.getBoundingClientRect().top+f.scrollTop)<40})()"},
    {"type":"key_press","key":"home"},
    {"type":"assert_script","js":"document.querySelector('#files .file').getAttribute('data-focused')==='true' && document.getElementById('files').scrollTop<10"},
    {"type":"click","target":{"selector":"#icons"}},
    {"type":"key_press","key":"end"},
    {"type":"assert_script","js":"document.querySelector('#files [data-focused=true]').getAttribute('aria-posinset')===String(initialCount)"},
    {"type":"assert_script","js":"(()=>{const f=document.getElementById('files'),r=document.querySelector('#files .file:last-child');return f.scrollHeight-(r.getBoundingClientRect().bottom-f.getBoundingClientRect().top+f.scrollTop)<40})()"},
    {"type":"resize","width":740,"height":520},
    {"type":"assert_script","js":"document.getElementById('files').getBoundingClientRect().height>200 && Number(document.querySelector('#files .listing-window').getAttribute('data-total'))===initialCount && document.querySelectorAll('#files .file').length<initialCount"},
    {"type":"script","js":"const f=document.getElementById('files');f.scrollTop=1000000;f.dispatchEvent(new Event('scroll'))"},
    {"type":"assert_script","js":"document.querySelector('#files .file:last-child').getAttribute('aria-posinset')===String(initialCount)"},
    {"type":"assert_script","js":"(()=>{const f=document.getElementById('files'),r=document.querySelector('#files .file:last-child');return f.scrollHeight-(r.getBoundingClientRect().bottom-f.getBoundingClientRect().top+f.scrollTop)<40})()"},
    {"type":"click","target":{"selector":"#preview"}},
    {"type":"assert_script","js":"document.querySelector('#files .file:last-child')?.getAttribute('aria-posinset')===String(initialCount) && document.querySelectorAll('#files .file').length<initialCount"},
    {"type":"assert_script","js":"(()=>{const f=document.getElementById('files'),r=document.querySelector('#files .file:last-child');return f.scrollHeight-(r.getBoundingClientRect().bottom-f.getBoundingClientRect().top+f.scrollTop)<40})()"},
    {"type":"capture_surface","source":"page","file":"temp/finder/large-directory.png"},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
