{
  "name":"Finder large listings retain rows, selection and scrolling",
  "html":"test/demo/finder/finder.ls",
  "viewport":{"width":1000,"height":650},
  "events":[
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../../../../test","clear":true},
    {"type":"script","js":"globalThis.rowWrites=0;globalThis.rowObserver=new MutationObserver(ms=>{for(const m of ms)if(m.target.classList.contains('file')&&(m.attributeName==='data-focused'||m.attributeName==='aria-selected'))rowWrites++});rowObserver.observe(document.getElementById('files'),{subtree:true,attributes:true})"},
    {"type":"click","target":{"selector":"#go-confirm"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"test"},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length>100 && rowWrites===0"},
    {"type":"assert_script","js":"document.getElementById('files').getBoundingClientRect().height>300 && document.getElementById('files').scrollHeight>document.getElementById('files').clientHeight"},
    {"type":"script","js":"rowObserver.disconnect();globalThis.retainedRow=document.querySelector('[data-name=\"README.md\"]');globalThis.listChanges=0;globalThis.listObserver=new MutationObserver(ms=>{listChanges+=ms.length});listObserver.observe(document.getElementById('files'),{childList:true});globalThis.initialCount=document.querySelectorAll('#files .file').length"},
    {"type":"click","target":{"selector":"[data-name='README.md']"}},
    {"type":"assert_script","js":"document.querySelector('[data-name=\"README.md\"]')===retainedRow && retainedRow.getAttribute('aria-selected')==='true' && retainedRow.getAttribute('data-focused')==='true' && listChanges===0"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"key_press","key":"escape"},
    {"type":"assert_script","js":"document.querySelector('[data-name=\"README.md\"]')===retainedRow && listChanges===0"},
    {"type":"script","js":"listObserver.disconnect()"},
    {"type":"click","target":{"selector":"#list"}},
    {"type":"assert_script","js":"document.querySelector('[data-name=\"README.md\"]').getAttribute('aria-selected')==='true' && document.querySelector('[data-name=\"README.md\"]').getAttribute('data-focused')==='true'"},
    {"type":"click","target":{"selector":"#direction"}},
    {"type":"assert_script","js":"document.querySelector('[data-name=\"README.md\"]').getAttribute('aria-selected')==='true'"},
    {"type":"type","target":{"selector":"#search"},"text":"README.md","clear":true},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===1 && document.querySelector('#files .file').getAttribute('aria-selected')==='true'"},
    {"type":"type","target":{"selector":"#search"},"text":"","clear":true},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===initialCount"},
    {"type":"click","target":{"selector":"#files"}},
    {"type":"key_press","key":"end"},
    {"type":"assert_script","js":"document.querySelector('#files .file:last-child').getAttribute('data-focused')==='true' && document.getElementById('files').scrollTop>0"},
    {"type":"key_press","key":"home"},
    {"type":"assert_script","js":"document.querySelector('#files .file').getAttribute('data-focused')==='true' && document.getElementById('files').scrollTop<10"},
    {"type":"resize","width":740,"height":520},
    {"type":"assert_script","js":"document.getElementById('files').getBoundingClientRect().height>200 && document.querySelectorAll('#files .file').length===initialCount"},
    {"type":"capture_surface","source":"page","file":"temp/finder/large-directory.png"},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
