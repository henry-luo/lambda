{
  "name": "Finder renders PDF, DOCX and EPUB previews through the native viewer",
  "html": "test/demo/finder/finder.ls",
  "viewport": {"width":1100,"height":760},
  "events": [
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../../../../test/input","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"type","target":{"selector":"#search"},"text":"simple_test.pdf","clear":true},
    {"type":"click","target":{"selector":"[data-name=\"simple_test.pdf\"]"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_count","target":{"selector":".pdf-page"},"min":1},
    {"type":"assert_count","target":{"selector":"svg"},"min":1},
    {"type":"switch_frame"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"docx","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"type","target":{"selector":"#search"},"text":"minimal.docx","clear":true},
    {"type":"click","target":{"selector":"[data-name=\"minimal.docx\"]"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":".docx-document"},"contains":"Hello, DOCX!"},
    {"type":"switch_frame"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../ebook","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"type","target":{"selector":"#search"},"text":"minimal.epub","clear":true},
    {"type":"click","target":{"selector":"[data-name=\"minimal.epub\"]"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":".ebook-title"},"equals":"A Small Book"},
    {"type":"switch_frame"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
