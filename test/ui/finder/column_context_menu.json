{
  "name":"Finder column context menus stay visible and act on the clicked file or folder",
  "html":"test/demo/finder/finder.ls",
  "viewport":{"width":1100,"height":720},
  "events":[
    {"type":"script","js":"globalThis.finderMenuVisible=()=>{const menu=document.getElementById('context-menu');const box=menu.getBoundingClientRect();const hit=document.elementFromPoint(box.x+10,box.y+10);return getComputedStyle(menu).display!=='none' && box.width>0 && box.height>0 && hit!==null && menu.contains(hit)}"},
    {"type":"click","target":{"selector":"#columns"}},
    {"type":"click","target":{"selector":"#column-0 [data-name='Assets']"}},
    {"type":"click","target":{"selector":"#column-1 [data-name='Palette.svg'] .file-name","offset_x":10,"offset_y":9},"button":1},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-menu","equals":"true"},
    {"type":"assert_script","js":"document.querySelector('#column-1 [data-name=\"Palette.svg\"]').getAttribute('aria-selected')==='true' && document.querySelectorAll('.file-column').length===2"},
    {"type":"assert_script","js":"finderMenuVisible()"},
    {"type":"capture_surface","source":"page","file":"temp/finder/column-context-file.png"},
    {"type":"click","target":{"selector":"#menu-rename"}},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-operation","equals":"rename"},
    {"type":"assert_script","js":"document.getElementById('operation-value').value==='Palette.svg'"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#column-0 [data-name='Projects'] .file-name","offset_x":10,"offset_y":9},"button":1},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-menu","equals":"true"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && document.querySelector('#column-0 [data-name=\"Projects\"]').getAttribute('aria-selected')==='true'"},
    {"type":"assert_script","js":"finderMenuVisible()"},
    {"type":"capture_surface","source":"page","file":"temp/finder/column-context-folder.png"},
    {"type":"click","target":{"selector":"#menu-rename"}},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-operation","equals":"rename"},
    {"type":"assert_script","js":"document.getElementById('operation-value').value==='Projects'"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#column-0 [data-name='Projects'] .file-graphic"},"button":1},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-menu","equals":"true"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#column-0 [data-name='Projects']"}},
    {"type":"click","target":{"selector":"#column-0 [data-name='Projects'] .folder-chevron"},"button":1},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-menu","equals":"true"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../../../../test/input/grep_tree","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"click","target":{"selector":"[data-name='code']"}},
    {"type":"click","target":{"selector":"[data-name='deep']"}},
    {"type":"resize","width":900,"height":620},
    {"type":"click","target":{"selector":"#column-2 [data-name='util.ls']"},"button":1},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-menu","equals":"true"},
    {"type":"assert_script","js":"document.getElementById('files').scrollLeft>0 && document.querySelector('#column-2 [data-name=\"util.ls\"]').getAttribute('aria-selected')==='true'"},
    {"type":"assert_script","js":"finderMenuVisible()"},
    {"type":"click","target":{"selector":"#menu-rename"}},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-operation')==='rename' && document.getElementById('operation-value').value==='util.ls'"},
    {"type":"key_press","key":"escape"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
