{
  "name":"Finder Move to folder selector navigates and synchronizes the destination without moving on browse",
  "html":"test/demo/finder/finder.ls",
  "viewport":{"width":1100,"height":720},
  "events":[
    {"type":"script","js":"globalThis.finderPickerHas=name=>Array.from(document.querySelectorAll('#destination-folders button')).some(row=>row.getAttribute('data-destination').endsWith('/'+name))"},
    {"type":"click","target":{"selector":"[data-name='Welcome.md']"}},
    {"type":"key_combo","key":"v","mods_str":"ctrl+shift"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-operation","equals":"move"},
    {"type":"assert_script","js":"getComputedStyle(document.getElementById('move-picker')).display==='block' && document.getElementById('operation-value').value.endsWith('/finder')"},
    {"type":"click","target":{"selector":"#destination-current"}},
    {"type":"assert_script","js":"document.getElementById('operation-value').value.endsWith('/finder/files') && finderPickerHas('Assets') && finderPickerHas('Projects') && !finderPickerHas('Welcome.md')"},
    {"type":"capture_surface","source":"page","file":"temp/finder/move-picker.png"},
    {"type":"click","target":{"selector":"#destination-folders [data-destination$='/Assets']"}},
    {"type":"assert_script","js":"document.getElementById('operation-value').value.endsWith('/Assets') && document.querySelectorAll('#destination-folders button').length===0"},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-path').endsWith('/files') && document.querySelector('[data-name=\"Welcome.md\"]').getAttribute('aria-selected')==='true'"},
    {"type":"click","target":{"selector":"#destination-parent"}},
    {"type":"type","target":{"selector":"#operation-value"},"text":"does-not-exist","clear":true},
    {"type":"click","target":{"selector":"#destination-browse"}},
    {"type":"assert_script","js":"document.getElementById('operation-error').textContent.length>0 && finderPickerHas('Assets') && finderPickerHas('Projects') && document.getElementById('operation-value').value==='does-not-exist'"},
    {"type":"type","target":{"selector":"#operation-value"},"text":"Assets","clear":true},
    {"type":"click","target":{"selector":"#destination-browse"}},
    {"type":"assert_script","js":"document.getElementById('operation-value').value.endsWith('/Assets') && document.getElementById('operation-error').textContent===''"},
    {"type":"click","target":{"selector":"#destination-breadcrumbs [data-destination$='/files']"}},
    {"type":"type","target":{"selector":"#operation-value"},"text":"Assets","clear":true},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#destination-parent"}},
    {"type":"key_press","key":"enter"},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-operation')==='move' && document.getElementById('operation-value').value.endsWith('/finder')"},
    {"type":"key_press","key":"escape"},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-operation')==='' && document.querySelector('[data-name=\"Welcome.md\"]')!==null"},
    {"type":"click","target":{"selector":"[data-name='Assets']"}},
    {"type":"key_combo","key":"v","mods_str":"ctrl+shift"},
    {"type":"click","target":{"selector":"#destination-current"}},
    {"type":"assert_script","js":"document.querySelector('#destination-folders [data-destination$=\"/Assets\"]').disabled && !document.querySelector('#destination-folders [data-destination$=\"/Projects\"]').disabled"},
    {"type":"type","target":{"selector":"#operation-value"},"text":"/","clear":true},
    {"type":"click","target":{"selector":"#destination-browse"}},
    {"type":"assert_script","js":"document.getElementById('destination-parent').disabled && document.getElementById('operation-value').value==='/'"},
    {"type":"key_press","key":"escape"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
