{
  "name":"Finder darker text, resizable retained preview and native document views",
  "html":"test/demo/finder/finder.ls",
  "viewport":{"width":1100,"height":720},
  "events":[
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../tests/fixtures","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"click","target":{"selector":"[data-name='Preview # ü.md']"}},
    {"type":"assert_style","target":{"selector":".preview-subtitle"},"property":"color","equals":"rgb(105, 116, 128)"},
    {"type":"assert_script","js":"document.querySelector('#preview-body pre')===null && document.getElementById('preview-document').getAttribute('src').endsWith('/Preview%20%23%20%C3%BC.md')"},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":"h1"},"equals":"Rendered preview"},
    {"type":"assert_text","target":{"selector":"strong"},"equals":"formatted Markdown"},
    {"type":"switch_frame"},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"script","js":"globalThis.originalDocumentWidth=document.body.getBoundingClientRect().width;globalThis.originalHeadingHeight=document.querySelector(\"h1\").getBoundingClientRect().height;globalThis.retainedHeading=document.querySelector(\"h1\")"},
    {"type":"switch_frame"},
    {"type":"script","js":"globalThis.retainedPreview=document.getElementById('preview-document');globalThis.originalPreviewWidth=document.getElementById('preview-pane').getBoundingClientRect().width"},
    {"type":"mouse_down","target":{"selector":"#preview-divider"}},
    {"type":"mouse_move","target":{"selector":"#preview-divider","offset_x":-100,"offset_y":20}},
    {"type":"mouse_up","target":{"selector":"#preview-divider"}},
    {"type":"assert_script","js":"document.getElementById('preview-pane').getBoundingClientRect().width>originalPreviewWidth+90 && document.getElementById('preview-document')===retainedPreview"},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_script","js":"document.body.getBoundingClientRect().width>originalDocumentWidth+90 && document.querySelector(\"h1\")===retainedHeading"},
    {"type":"switch_frame"},
    {"type":"key_press","key":"left"},
    {"type":"assert_script","js":"document.getElementById('preview-pane').getBoundingClientRect().width>originalPreviewWidth+110"},
    {"type":"key_press","key":"home"},
    {"type":"assert_script","js":"Math.abs(document.getElementById('preview-pane').getBoundingClientRect().width-180)<1"},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_script","js":"document.body.getBoundingClientRect().width<originalDocumentWidth-35 && document.querySelector(\"h1\")===retainedHeading"},
    {"type":"switch_frame"},
    {"type":"key_press","key":"end"},
    {"type":"assert_script","js":"document.getElementById('preview-pane').getBoundingClientRect().width===600 && document.getElementById('files').getBoundingClientRect().width>160"},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_script","js":"document.body.getBoundingClientRect().width>originalDocumentWidth+300 && document.querySelector(\"h1\").getBoundingClientRect().height<originalHeadingHeight && document.querySelector(\"h1\")===retainedHeading"},
    {"type":"switch_frame"},
    {"type":"capture_surface","source":"page","file":"temp/finder/reflow/markdown-wide.png"},
    {"type":"mouse_down","target":{"selector":"#preview-divider"}},
    {"type":"mouse_move","target":{"selector":"#preview-divider","offset_x":80,"offset_y":20}},
    {"type":"assert_script","js":"document.getElementById('preview-pane').getBoundingClientRect().width<550"},
    {"type":"key_press","key":"escape"},
    {"type":"mouse_up","target":{"selector":"#preview-divider"}},
    {"type":"assert_script","js":"document.getElementById('preview-pane').getBoundingClientRect().width===600 && document.getElementById('finder').getAttribute('data-preview-resizing')==='false'"},
    {"type":"click","target":{"selector":"[data-name='preview.html']"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":"h1"},"equals":"Rendered HTML"},
    {"type":"assert_style","target":{"selector":"#color-sample"},"property":"background-color","equals":"rgb(45, 139, 87)"},
    {"type":"script","js":"globalThis.htmlWidthBefore=document.body.getBoundingClientRect().width;globalThis.retainedFormatting=document.getElementById(\"formatted\")"},
    {"type":"switch_frame"},
    {"type":"capture_surface","source":"page","file":"temp/finder/preview-panel.png"},
    {"type":"resize","width":800,"height":640},
    {"type":"assert_script","js":"document.getElementById('preview-pane').getBoundingClientRect().width<=476 && document.getElementById('files').getBoundingClientRect().width>=160"},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_script","js":"document.body.getBoundingClientRect().width<htmlWidthBefore-70 && document.getElementById(\"formatted\")===retainedFormatting"},
    {"type":"switch_frame"},
    {"type":"click","target":{"selector":"#preview"}},
    {"type":"assert_script","js":"document.querySelector('#preview-body iframe')===null && document.getElementById('preview-divider').style.display==='none'"},
    {"type":"key_press","key":"space"},
    {"type":"switch_frame","selector":"#look-document"},
    {"type":"assert_text","target":{"selector":"h1"},"equals":"Rendered HTML"},
    {"type":"switch_frame"},
    {"type":"key_press","key":"escape"},
    {"type":"assert_script","js":"document.querySelector('#look-body iframe')===null"},
    {"type":"click","target":{"selector":"#preview"}},
    {"type":"click","target":{"selector":"[data-name='source.js']"}},
    {"type":"assert_text","target":{"selector":"#preview-body pre"},"contains":"A source preview must not execute this file."},
    {"type":"click","target":{"selector":"[data-name='_document.ls']"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":"#lambda-document"},"equals":"Rendered Lambda document"},
    {"type":"switch_frame"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
