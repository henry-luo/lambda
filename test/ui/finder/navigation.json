{
  "name": "Finder path dialog, errors, breadcrumbs, images and keyboard navigation",
  "html": "test/demo/finder/finder.ls",
  "viewport": {"width": 1100, "height": 720},
  "events": [
    {"type":"advance_time","ms":70},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"assert_focus","target":{"selector":"#folder-path"}},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#go-cancel"}},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#go-confirm"}},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#folder-path"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"does-not-exist","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-dialog","equals":"true"},
    {"type":"assert_script","js":"document.getElementById('go-error').textContent.length>0 && document.querySelectorAll('#files .file').length===4"},
    {"type":"key_press","key":"escape"},
    {"type":"assert_focus","target":{"selector":"#go"}},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"Welcome.md","clear":true},
    {"type":"click","target":{"selector":"#go-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-dialog","equals":"true"},
    {"type":"type","target":{"selector":"#folder-path"},"text":"Assets/../Projects","clear":true},
    {"type":"click","target":{"selector":"#go-confirm"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Projects"},
    {"type":"assert_focus","target":{"selector":"#files"}},
    {"type":"key_combo","key":"up","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"click","target":{"selector":"#list"}},
    {"type":"click","target":{"selector":"[data-name='Assets']"}},
    {"type":"key_press","key":"down"},
    {"type":"assert_script","js":"document.querySelector('[data-focused=true]').getAttribute('data-name')==='Projects'"},
    {"type":"key_combo","key":"down","mods_str":"shift"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-selected","equals":"2"},
    {"type":"dblclick","target":{"selector":"[data-name='Assets']"}},
    {"type":"click","target":{"selector":"[data-name='Palette.svg']"}},
    {"type":"assert_script","js":"document.querySelector('#preview-body img').getAttribute('src').endsWith('/Assets/Palette.svg')"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-look","equals":"true"},
    {"type":"capture_surface","source":"page","file":"temp/finder/quick-look.png"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":".crumbs button[title$='/files']"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"click","target":{"selector":"#place-project"}},
    {"type":"assert_script","js":"Array.from(document.querySelectorAll('#files .file')).some(e=>e.getAttribute('data-name')==='AGENTS.md')"},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"}
  ]
}
