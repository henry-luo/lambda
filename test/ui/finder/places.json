{
  "name":"Finder home favorites and tilde navigation use materialized system paths",
  "html":"test/demo/finder/finder.ls",
  "viewport":{"width":1100,"height":720},
  "events":[
    {"type":"assert_script","js":"(()=>{const h=document.getElementById('place-home').getAttribute('data-location');return typeof h==='string'&&h.startsWith('/')&&['Desktop','Documents','Downloads','Pictures'].every(name=>document.getElementById('place-'+name.toLowerCase()).getAttribute('data-location')===(h.endsWith('/')?h:h+'/')+name)})()"},
    {"type":"click","target":{"selector":"#place-home"}},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-path')===document.getElementById('place-home').getAttribute('data-location') && document.getElementById('place-home').getAttribute('aria-current')==='page'"},
    {"type":"assert_text","target":{"selector":"#error-text"},"equals":""},
    {"type":"click","target":{"selector":"#back"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"~","clear":true},
    {"type":"click","target":{"selector":"#go-confirm"}},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-path')===document.getElementById('place-home').getAttribute('data-location') && document.getElementById('finder').getAttribute('data-dialog')==='false'"},
    {"type":"assert_text","target":{"selector":"#error-text"},"equals":""},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"~/.","clear":true},
    {"type":"click","target":{"selector":"#go-confirm"}},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-path')===document.getElementById('place-home').getAttribute('data-location') && document.getElementById('finder').getAttribute('data-dialog')==='false'"},
    {"type":"assert_text","target":{"selector":"#error-text"},"equals":""},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
