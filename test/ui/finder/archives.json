{
  "name":"Finder ZIPs retain file details and browse read-only members in all views",
  "html":"test/demo/finder/finder.ls",
  "env":[{"key":"LAMBDA_GC_FORCE_EVERY","value":"1"},{"key":"LAMBDA_GC_POISON_FREED","value":"1"}],
  "viewport":{"width":1200,"height":760},
  "events":[
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../../../../test/input/zip","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"click","target":{"selector":"[data-name='sample.zip']"}},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"sample.zip"},
    {"type":"assert_script","js":"document.querySelector('#preview-body .metadata').textContent.includes('Archive') && document.querySelector('#preview-body .metadata').textContent.includes('KB') && document.querySelector('[data-name=\"sample.zip\"]').getAttribute('data-dir')==='false'"},
    {"type":"dblclick","target":{"selector":"[data-name='sample.zip']"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"sample.zip"},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"sample.zip"},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===7 && document.getElementById('finder').getAttribute('data-readonly')==='true' && document.getElementById('new-folder').hasAttribute('disabled')"},
    {"type":"assert_text","target":{"selector":"#status"},"contains":"Archive contents (read-only)"},
    {"type":"click","target":{"selector":"[data-name='data.json']"}},
    {"type":"assert_text","target":{"selector":"#preview-body pre"},"equals":"{\"answer\":42}"},
    {"type":"click","target":{"selector":"[data-name='data.json'] .file-name"},"button":1},
    {"type":"assert_script","js":"['rename','move','delete','new-file','new-folder'].every(a=>document.getElementById('menu-'+a).hasAttribute('disabled')) && !document.getElementById('menu-look').hasAttribute('disabled')"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#files"}},
    {"type":"key_combo","key":"n","mods_str":"ctrl+shift"},
    {"type":"assert_text","target":{"selector":"#error-text"},"equals":"Archive contents are read-only."},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-operation","equals":""},
    {"type":"click","target":{"selector":"[data-action='dismiss']"}},
    {"type":"dblclick","target":{"selector":"[data-name='nested.zip']"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"nested.zip"},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"nested.zip"},
    {"type":"click","target":{"selector":"[data-name='inner.txt']"}},
    {"type":"assert_text","target":{"selector":"#preview-body pre"},"equals":"nested"},
    {"type":"key_press","key":"space"},
    {"type":"assert_text","target":{"selector":"#look-body pre"},"equals":"nested"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#refresh"}},
    {"type":"assert_text","target":{"selector":"#preview-body pre"},"equals":"nested"},
    {"type":"click","target":{"selector":"#back"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"sample.zip"},
    {"type":"click","target":{"selector":"#forward"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"nested.zip"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../..","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"zip"},
    {"type":"click","target":{"selector":"#back"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"nested.zip"},
    {"type":"assert_count","target":{"selector":"[data-name='inner.txt']"},"equals":1},
    {"type":"click","target":{"selector":"#forward"}},
    {"type":"click","target":{"selector":"#list"}},
    {"type":"dblclick","target":{"selector":"[data-name='sample.zip']"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"sample.zip"},
    {"type":"dblclick","target":{"selector":"[data-name='word']"}},
    {"type":"assert_count","target":{"selector":"[data-name='document.xml']"},"equals":1},
    {"type":"key_combo","key":"up","mods_str":"ctrl"},
    {"type":"click","target":{"selector":"#columns"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.querySelector('#column-0 [data-name=\"sample.zip\"] .folder-chevron')!==null && document.querySelector('#column-1 [data-name=\"nested.zip\"] .folder-chevron')!==null"},
    {"type":"script","js":"globalThis.zipRow=document.querySelector('#column-0 [data-name=\"sample.zip\"]')"},
    {"type":"click","target":{"selector":"#column-1 [data-name='nested.zip']"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===3 && document.querySelector('#column-0 [data-name=\"sample.zip\"]')===zipRow && document.querySelector('#column-2 [data-name=\"inner.txt\"]').getAttribute('draggable')==='false'"},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"nested.zip"},
    {"type":"key_press","key":"down"},
    {"type":"assert_text","target":{"selector":"#preview-body pre"},"equals":"nested"},
    {"type":"key_press","key":"left"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.querySelector('#column-1 [data-name=\"nested.zip\"]').getAttribute('data-focused')==='true'"},
    {"type":"key_press","key":"right"},
    {"type":"assert_count","target":{"selector":".file-column"},"equals":3},
    {"type":"click","target":{"selector":"#column-1 [data-name='word']"}},
    {"type":"click","target":{"selector":"#column-2 [data-name='_rels']"}},
    {"type":"assert_count","target":{"selector":".file-column"},"equals":4},
    {"type":"click","target":{"selector":"#column-3 [data-name='document.xml.rels']"}},
    {"type":"assert_script","js":"document.querySelector('#preview-body h2').textContent==='document.xml.rels' && document.querySelectorAll('#files [data-readonly=true]').length>0"},
    {"type":"capture_surface","source":"page","file":"temp/finder/zip/columns.png"},
    {"type":"click","target":{"selector":"#column-0 [data-name='sample.zip'] .file-name"},"button":1},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && document.getElementById('finder').getAttribute('data-readonly')==='false' && ['rename','move','delete','new-file','new-folder'].every(a=>!document.getElementById('menu-'+a).hasAttribute('disabled'))"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#column-0 [data-name='sample.zip']"}},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"sample.zip"},
    {"type":"assert_count","target":{"selector":".file-column"},"equals":2},
    {"type":"click","target":{"selector":"#column-0 [data-name='empty.zip']"}},
    {"type":"assert_text","target":{"selector":"#column-1 .empty h2"},"equals":"This folder is empty"},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"empty.zip"},
    {"type":"click","target":{"selector":"#column-0 [data-name='traversal.zip']"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"zip"},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"traversal.zip"},
    {"type":"assert_script","js":"document.getElementById('error-text').textContent.length>0 && document.querySelectorAll('.file-column').length===1"},
    {"type":"click","target":{"selector":"[data-name='corrupt.zip']"}},
    {"type":"click","target":{"selector":"[data-name='word']"}},
    {"type":"assert_count","target":{"selector":"#column-2 .file"},"equals":2},
    {"type":"click","target":{"selector":"[data-name='document.xml']"}},
    {"type":"assert_text","target":{"selector":"#preview-body .preview-note"},"contains":"CRC"},
    {"type":"click","target":{"selector":"#column-0 [data-name='viewer.zip']"}},
    {"type":"assert_text","target":{"selector":"#preview-body h2"},"equals":"viewer.zip"},
    {"type":"click","target":{"selector":"[data-name='index.html']"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":"h1"},"equals":"Archive HTML"},
    {"type":"switch_frame"},
    {"type":"click","target":{"selector":"[data-name='readme.md']"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":"h1"},"equals":"Archive Markdown"},
    {"type":"switch_frame"},
    {"type":"key_press","key":"space"},
    {"type":"switch_frame","selector":"#look-document"},
    {"type":"assert_text","target":{"selector":"h1"},"equals":"Archive Markdown"},
    {"type":"switch_frame"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"[data-name='drawing.svg']"}},
    {"type":"assert_script","js":"document.querySelector('#preview-body img').getAttribute('src').startsWith('data:image/svg+xml;base64,') && document.querySelectorAll('#files [data-thumb-path]').length===0"},
    {"type":"capture_surface","source":"page","file":"temp/finder/zip/preview.png"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
