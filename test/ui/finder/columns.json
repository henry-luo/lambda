{
  "name":"Finder columns retain ancestors, branch and support keyboard navigation and previews",
  "html":"test/demo/finder/finder.ls",
  "viewport":{"width":1100,"height":720},
  "events":[
    {"type":"click","target":{"selector":"#columns"}},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-mode","equals":"columns"},
    {"type":"assert_attribute","target":{"selector":"#columns"},"attribute":"aria-pressed","equals":"true"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && document.querySelectorAll('#column-0 .file').length===4"},
    {"type":"script","js":"globalThis.assetsRow=document.querySelector('[data-name=\"Assets\"]')"},
    {"type":"click","target":{"selector":"[data-name='Assets']"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Assets"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.querySelector('[data-name=\"Assets\"]')===assetsRow && assetsRow.getAttribute('data-trail')==='true' && document.querySelector('#column-1 [data-name=\"Palette.svg\"]')!==null"},
    {"type":"assert_focus","target":{"selector":"#files"}},
    {"type":"key_press","key":"down"},
    {"type":"assert_script","js":"document.querySelector('#column-1 [data-focused=true]').getAttribute('data-name')==='Palette.svg'"},
    {"type":"assert_script","js":"document.querySelector('#preview-body img').getAttribute('src').endsWith('/Assets/Palette.svg')"},
    {"type":"key_press","key":"right"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-look","equals":"false"},
    {"type":"key_press","key":"space"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-look","equals":"true"},
    {"type":"key_press","key":"escape"},
    {"type":"key_press","key":"left"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && assetsRow.getAttribute('data-focused')==='true' && document.querySelector('#preview-body h2').textContent==='Assets'"},
    {"type":"key_press","key":"right"},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Assets"},
    {"type":"click","target":{"selector":"#column-0 [data-name='Projects']"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.querySelector('#column-1 [data-name=\"Brief.md\"]')!==null && document.querySelector('[data-name=\"Palette.svg\"]')===null && assetsRow.getAttribute('data-trail')==='false'"},
    {"type":"click","target":{"selector":"[data-name='Brief.md']"}},
    {"type":"switch_frame","selector":"#preview-document"},
    {"type":"assert_text","target":{"selector":"h1"},"contains":"The next small thing"},
    {"type":"switch_frame"},
    {"type":"click","target":{"selector":"#list"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===0 && document.querySelector('#files [data-focused=true]').getAttribute('data-name')==='Brief.md'"},
    {"type":"key_combo","key":"3","mods_str":"ctrl"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.querySelector('#column-1 [data-focused=true]').getAttribute('data-name')==='Brief.md'"},
    {"type":"click","target":{"selector":"#column-0 [data-name='Notes.txt']"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && document.querySelector('#files [data-focused=true]').getAttribute('data-name')==='Notes.txt'"},
    {"type":"type","target":{"selector":"#search"},"text":"assets","clear":true},
    {"type":"click","target":{"selector":"[data-name='Assets']"}},
    {"type":"assert_script","js":"document.querySelectorAll('#column-0 .file').length===1 && document.querySelectorAll('#column-1 .file').length===1 && document.getElementById('search').value===''"},
    {"type":"type","target":{"selector":"#search"},"text":"no-such-file","clear":true},
    {"type":"assert_text","target":{"selector":"#column-1 h2"},"equals":"Assets"},
    {"type":"assert_text","target":{"selector":"#column-1 .empty h2"},"equals":"No matching files"},
    {"type":"assert_script","js":"document.querySelectorAll('#column-0 .file').length===1"},
    {"type":"type","target":{"selector":"#search"},"text":"","clear":true},
    {"type":"click","target":{"selector":"#refresh"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.querySelector('#column-1 [data-name=\"Palette.svg\"]')!==null"},
    {"type":"click","target":{"selector":"#back"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1"},
    {"type":"click","target":{"selector":"#forward"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2"},
    {"type":"capture_surface","source":"page","file":"temp/finder/columns.png"},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"does-not-exist","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"assert_script","js":"document.getElementById('finder').getAttribute('data-dialog')==='true' && document.querySelectorAll('.file-column').length===2"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && document.querySelectorAll('#column-0 .file').length===4"},
    {"type":"click","target":{"selector":"#hidden"}},
    {"type":"assert_script","js":"document.querySelectorAll('#column-0 .file').length===5"},
    {"type":"select_option","target":{"selector":"#sort"},"value":"name"},
    {"type":"click","target":{"selector":"#direction"}},
    {"type":"assert_script","js":"document.querySelector('#column-0 .file').getAttribute('data-name')==='Projects'"},
    {"type":"click","target":{"selector":"#hidden"}},
    {"type":"click","target":{"selector":"[data-name='Projects']"},"mods_str":"ctrl"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && document.getElementById('finder').getAttribute('data-selected')==='1'"},
    {"type":"key_press","key":"enter"},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Projects"},
    {"type":"dblclick","target":{"selector":"#column-0 [data-name='Projects']"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.getElementById('finder').getAttribute('data-look')==='false'"},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"click","target":{"selector":"#go"}},
    {"type":"type","target":{"selector":"#folder-path"},"text":"../../../../test/input/grep_tree","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1"},
    {"type":"click","target":{"selector":"[data-name='code']"}},
    {"type":"click","target":{"selector":"[data-name='deep']"}},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===3 && document.querySelector('#column-2 [data-name=\"util.ls\"]')!==null"},
    {"type":"resize","width":900,"height":620},
    {"type":"click","target":{"selector":"#files"}},
    {"type":"key_press","key":"end"},
    {"type":"assert_script","js":"document.getElementById('files').scrollLeft>0 && document.querySelector('#column-2 [data-focused=true]').getAttribute('data-name')==='util.ls'"},
    {"type":"key_press","key":"left"},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===2 && document.querySelector('#column-1 [data-focused=true]').getAttribute('data-name')==='deep'"},
    {"type":"click","target":{"selector":"#back"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"deep"},
    {"type":"capture_surface","source":"page","file":"temp/finder/columns-deep.png"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
