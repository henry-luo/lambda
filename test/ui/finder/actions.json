{
  "name":"Finder context menus, file-operation dialogs and keyboard focus",
  "html":"test/demo/finder/finder.ls",
  "viewport":{"width":1100,"height":720},
  "events":[
    {"type":"click","target":{"selector":"[data-name='Welcome.md']"},"button":1},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-menu","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-selected","equals":"1"},
    {"type":"assert_focus","target":{"selector":"#menu-open"}},
    {"type":"key_press","key":"down"},
    {"type":"assert_focus","target":{"selector":"#menu-look"}},
    {"type":"click","target":{"selector":"#menu-rename"}},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-operation","equals":"rename"},
    {"type":"assert_focus","target":{"selector":"#operation-value"}},
    {"type":"assert_script","js":"document.getElementById('operation-value').value==='Welcome.md'"},
    {"type":"type","target":{"selector":"#operation-value"},"text":"../outside","clear":true},
    {"type":"key_press","key":"enter"},
    {"type":"assert_script","js":"document.getElementById('operation-error').textContent.length>0 && document.getElementById('finder').getAttribute('data-operation')==='rename'"},
    {"type":"key_press","key":"escape"},
    {"type":"assert_focus","target":{"selector":"#files"}},
    {"type":"key_combo","key":"e","mods_str":"ctrl"},
    {"type":"assert_text","target":{"selector":"#operation-title"},"equals":"Rename"},
    {"type":"key_press","key":"escape"},
    {"type":"key_combo","key":"m","mods_str":"ctrl+shift"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-menu","equals":"true"},
    {"type":"key_press","key":"escape"},
    {"type":"key_press","key":"delete"},
    {"type":"assert_text","target":{"selector":"#operation-title"},"equals":"Delete Permanently"},
    {"type":"assert_focus","target":{"selector":"#operation-cancel"}},
    {"type":"assert_script","js":"getComputedStyle(document.getElementById('operation-confirm')).backgroundColor==='rgb(189, 81, 74)' && getComputedStyle(document.getElementById('operation-confirm')).color==='rgb(255, 255, 255)'"},
    {"type":"capture_surface","source":"page","file":"temp/finder/delete-dialog.png"},
    {"type":"mouse_move","target":{"selector":"#operation-confirm"}},
    {"type":"assert_script","js":"getComputedStyle(document.getElementById('operation-confirm')).backgroundColor==='rgb(169, 66, 59)'"},
    {"type":"mouse_move","target":{"selector":"#operation-cancel"}},
    {"type":"assert_script","js":"getComputedStyle(document.getElementById('operation-confirm')).backgroundColor==='rgb(189, 81, 74)'"},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#operation-confirm"}},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#operation-cancel"}},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#actions"}},
    {"type":"click","target":{"selector":"#menu-new-file"}},
    {"type":"assert_text","target":{"selector":"#operation-title"},"equals":"New File"},
    {"type":"key_press","key":"escape"},
    {"type":"key_combo","key":"n","mods_str":"ctrl+shift"},
    {"type":"assert_text","target":{"selector":"#operation-title"},"equals":"New Folder"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#files"},"offset_x":10,"offset_y":550,"button":1},
    {"type":"assert_script","js":"document.getElementById('menu-rename').disabled && document.getElementById('menu-delete').disabled && !document.getElementById('menu-new-file').disabled"},
    {"type":"key_press","key":"escape"},
    {"type":"click","target":{"selector":"#columns"}},
    {"type":"click","target":{"selector":"[data-name='Projects']"},"button":1},
    {"type":"assert_script","js":"document.querySelectorAll('.file-column').length===1 && document.getElementById('finder').getAttribute('data-menu')==='true'"},
    {"type":"click","target":{"selector":"#menu-move"}},
    {"type":"assert_text","target":{"selector":"#operation-title"},"equals":"Move to Folder"},
    {"type":"key_press","key":"escape"},
    {"type":"capture_surface","source":"page","file":"temp/finder/actions.png"},
    {"type":"window_close"},
    {"type":"assert_window_closed","closed":true}
  ]
}
