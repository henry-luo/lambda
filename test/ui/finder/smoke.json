{
  "name": "Finder real folders, history, filtering, selection and Quick Look",
  "html": "test/demo/finder/finder.ls",
  "viewport": {"width": 1280, "height": 800},
  "events": [
    {"type":"advance_time","ms":70},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===4 && document.getElementById('back').disabled && document.getElementById('forward').disabled"},
    {"type":"click","target":{"selector":"[data-name='Welcome.md']"}},
    {"type":"assert_text","target":{"selector":"#preview-body pre"},"contains":"A place for everything."},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-selected","equals":"1"},
    {"type":"key_press","key":"space"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-look","equals":"true"},
    {"type":"assert_focus","target":{"selector":"#look-close"}},
    {"type":"assert_text","target":{"selector":"#look-body pre"},"contains":"A place for everything."},
    {"type":"key_press","key":"tab"},
    {"type":"assert_focus","target":{"selector":"#look-close"}},
    {"type":"key_press","key":"escape"},
    {"type":"assert_focus","target":{"selector":"#files"}},
    {"type":"click","target":{"selector":"#list"}},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-mode","equals":"list"},
    {"type":"select_option","target":{"selector":"#sort"},"value":"size"},
    {"type":"click","target":{"selector":"#direction"}},
    {"type":"assert_script","js":"Array.from(document.querySelectorAll('#files .file')).map(e=>e.getAttribute('data-name')).join(',')==='Assets,Projects,Notes.txt,Welcome.md'"},
    {"type":"type","target":{"selector":"#search"},"text":"welcome","clear":true},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===1"},
    {"type":"assert_focus","target":{"selector":"#search"}},
    {"type":"type","target":{"selector":"#search"},"text":"no-such-file","clear":true},
    {"type":"assert_text","target":{"selector":"#files h2"},"equals":"No matching files"},
    {"type":"type","target":{"selector":"#search"},"text":"","clear":true},
    {"type":"click","target":{"selector":"#hidden"}},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===5 && document.getElementById('finder').getAttribute('data-hidden')==='true'"},
    {"type":"click","target":{"selector":"#hidden"}},
    {"type":"click","target":{"selector":"[data-name='Assets']"}},
    {"type":"key_combo","key":"a","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-selected","equals":"4"},
    {"type":"key_press","key":"escape"},
    {"type":"assert_attribute","target":{"selector":"#finder"},"attribute":"data-selected","equals":"0"},
    {"type":"dblclick","target":{"selector":"[data-name='Projects']"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Projects"},
    {"type":"assert_script","js":"document.querySelectorAll('#files .file').length===1 && !document.getElementById('back').disabled"},
    {"type":"click","target":{"selector":"#back"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Demo Files"},
    {"type":"click","target":{"selector":"#forward"}},
    {"type":"assert_text","target":{"selector":"#folder-title"},"equals":"Projects"},
    {"type":"click","target":{"selector":"#place-demo"}},
    {"type":"click","target":{"selector":"#icons"}},
    {"type":"click","target":{"selector":"#preview"}},
    {"type":"assert_script","js":"document.getElementById('preview-pane').style.display==='none'"},
    {"type":"click","target":{"selector":"#preview"}},
    {"type":"click","target":{"selector":"#refresh"}},
    {"type":"assert_text","target":{"selector":"#status"},"equals":"4 items"},
    {"type":"capture_surface","source":"page","file":"temp/finder/smoke.png"}
  ]
}
