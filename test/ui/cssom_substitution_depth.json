{
  "name": "Bounded variable dependency depth, cache paths, defaults and live layout",
  "html": "test/ui/cssom_substitution_depth.html",
  "viewport": {
    "width": 400,
    "height": 180
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-boundary",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-over-depth",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-cached-path",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-registered-default",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-lazy-fallback",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live-leaf",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#verify"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-consumer-fallback",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live-depth-recovery",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#restored"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-consumer-recovery",
      "equals": "true"
    }
  ]
}
