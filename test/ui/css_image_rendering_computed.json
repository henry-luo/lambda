    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#main",
        "offset_x": 3,
        "offset_y": 2
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "assert_pixel",
