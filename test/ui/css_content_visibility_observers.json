{
  "name":"Skipped content freezes resize observations, never intersects, and contributes no innerText",
  "html":"test/ui/css_content_visibility_observers.html",
  "viewport":{"width":340,"height":260},
  "events":[
    {"type":"advance_time","ms":50,"steps":2},
    {"type":"assert_attribute","target":{"selector":"#resize"},"attribute":"data-resize","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#resize"},"attribute":"data-intersection","equals":"true"},
    {"type":"assert_attribute","target":{"selector":"#auto-child"},"attribute":"data-resize","equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#never"},"attribute":"data-resize","equals":"0"},
    {"type":"assert_attribute","target":{"selector":"#never"},"attribute":"data-intersection","equals":"false"},
    {"type":"click","target":{"selector":"#probe"}},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-text","equals":"first last"},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-hidden-text","equals":""},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-source-text","equals":"hidden "},
    {"type":"click","target":{"selector":"#text-show"}},
    {"type":"click","target":{"selector":"#probe"}},
    {"type":"assert_attribute","target":{"selector":"#report"},"attribute":"data-text","equals":"first hiddenlast"},
    {"type":"click","target":{"selector":"#hide"}},
    {"type":"advance_time","ms":100,"steps":2},
    {"type":"assert_attribute","target":{"selector":"#resize"},"attribute":"data-resize","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#resize"},"attribute":"data-intersection","equals":"false"},
    {"type":"click","target":{"selector":"#show"}},
    {"type":"advance_time","ms":50,"steps":2},
    {"type":"assert_attribute","target":{"selector":"#resize"},"attribute":"data-resize","equals":"2"},
    {"type":"assert_attribute","target":{"selector":"#resize"},"attribute":"data-intersection","equals":"true"},
    {"type":"click","target":{"selector":"#down"}},
    {"type":"advance_time","ms":50,"steps":2},
    {"type":"assert_attribute","target":{"selector":"#auto-child"},"attribute":"data-resize","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#auto-child"},"attribute":"data-intersection","equals":"true"},
    {"type":"click","target":{"selector":"#up"}},
    {"type":"click","target":{"selector":"#auto-resize"}},
    {"type":"advance_time","ms":50,"steps":2},
    {"type":"assert_attribute","target":{"selector":"#auto-child"},"attribute":"data-resize","equals":"1"},
    {"type":"assert_attribute","target":{"selector":"#auto-child"},"attribute":"data-intersection","equals":"false"},
    {"type":"click","target":{"selector":"#down"}},
    {"type":"advance_time","ms":50,"steps":2},
    {"type":"assert_attribute","target":{"selector":"#auto-child"},"attribute":"data-resize","equals":"2"},
    {"type":"assert_rect","target":{"selector":"#auto-child"},"width":75,"height":70}
  ]
