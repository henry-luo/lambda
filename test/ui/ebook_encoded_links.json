{
  "name": "EPUB percent-escaped source IDs survive navigation",
  "html": "test/ui/ebook_encoded_links.ls",
  "viewport": {"width":1100,"height":800},
  "events": [
    {"type":"switch_frame","selector":"iframe"},
    {"type":"click","target":{"selector":"a[data-ebook-href]"}},
    {"type":"wait","ms":150},
    {"type":"switch_frame"},
    {"type":"assert_text","target":{"selector":".ebook-status"},"equals":"2 / 2"},
    {"type":"assert_state_store","target":{"selector":".ebook-frame"},"view_scroll_y":1200,"tolerance":5},
    {"type":"switch_frame","selector":"iframe"},
    {"type":"assert_text","target":{"selector":"[id='part%2F']"},"equals":"Encoded anchor"}
  ]
}
