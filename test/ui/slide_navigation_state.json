{
  "name": "A .slides deck renders each slide once; navigation only changes layer state",
  "html": "test/demo/slides/slide_presentation.slides",
  "viewport": {"width": 1100, "height": 700},
  "events": [
    {"type": "assert_count", "target": {"selector": "#demo .slide-layer"}, "equals": 1},
    {"type": "click", "target": {"selector": "[data-slide-command=play]"}},
    {"type": "advance_time", "ms": 700, "steps": 14},
    {"type": "click", "target": {"selector": "[data-slide-command=next]"}},
    {"type": "advance_time", "ms": 700, "steps": 7},
    {"type": "click", "target": {"selector": "[data-slide-command=next]"}},
    {"type": "advance_time", "ms": 700, "steps": 7},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "1"},
    {"type": "assert_count", "target": {"selector": "#demo .slide-layer"}, "equals": 2},
    {"type": "assert_attribute", "target": {"selector": "#demo-s1"}, "attribute": "data-slide-active", "equals": "true"},
    {"type": "assert_style", "target": {"selector": "#demo-s0"}, "property": "display", "equals": "none"},
    {"type": "click", "target": {"selector": "[data-slide-command=previous]"}},
    {"type": "advance_time", "ms": 100, "steps": 1},
    {"type": "click", "target": {"selector": "[data-slide-command=previous]"}},
    {"type": "advance_time", "ms": 100, "steps": 1},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "0"},
    {"type": "assert_attribute", "target": {"selector": "#demo-s0"}, "attribute": "data-slide-active", "equals": "true"},
    {"type": "assert_style", "target": {"selector": "#demo-s0"}, "property": "display", "equals": "block"},
    {"type": "assert_style", "target": {"selector": "#demo-s1"}, "property": "display", "equals": "none"},
    {"type": "assert_style", "target": {"selector": "#demo-s0-o1"}, "property": "opacity", "equals": "0"},
    {"type": "click", "target": {"selector": "[data-slide-command=next]"}},
    {"type": "advance_time", "ms": 700, "steps": 7},
    {"type": "assert_style", "target": {"selector": "#demo-s0-o1"}, "property": "opacity", "equals": "1"},
    {"type": "click", "target": {"selector": "[data-slide-command=next]"}},
    {"type": "advance_time", "ms": 700, "steps": 7},
    {"type": "assert_attribute", "target": {"selector": "#demo"}, "attribute": "data-slide-index", "equals": "1"},
    {"type": "assert_count", "target": {"selector": "#demo .slide-layer"}, "equals": 2},
    {"type": "assert_text", "target": {"selector": ".slide-status"}, "equals": "2 / 2"}
  ]
}
