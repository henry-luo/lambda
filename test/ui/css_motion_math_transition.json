{
  "name": "Calculated transition time and piecewise retargeting preserve the visible opacity sample",
  "html": "test/ui/css_motion_math_transition.html",
  "viewport": {
    "width": 240,
    "height": 120
  },
  "events": [
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "transition-duration",
      "equals": "2s"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "transition-timing-function",
      "equals": "linear(0 0%, 0.25 50%, 1 100%)"
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 70,
      "min_r": 254,
      "max_r": 255,
      "min_g": 254,
      "max_g": 255,
      "min_b": 254,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#start"
      }
    },
    {
      "type": "advance_time",
      "ms": 500,
      "steps": 10
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "opacity",
      "equals": "0.125",
      "animated": true,
      "tolerance": 0.012
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 70,
      "min_r": 254,
      "max_r": 255,
      "min_g": 222,
      "max_g": 224,
      "min_b": 222,
      "max_b": 224
    },
    {
      "type": "click",
      "target": {
        "selector": "#retarget"
      }
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "transition-duration",
      "equals": "1s"
    },
    {
      "type": "advance_time",
      "ms": 250,
      "steps": 5
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#box"
      },
      "property": "opacity",
      "equals": "0.3125",
      "animated": true,
      "tolerance": 0.012
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 70,
      "min_r": 254,
      "max_r": 255,
      "min_g": 174,
      "max_g": 176,
      "min_b": 174,
      "max_b": 176
    },
    {
      "type": "click",
      "target": {
        "selector": "#remove"
      }
    },
    {
      "type": "advance_time",
      "ms": 1000,
      "steps": 5
    },
    {
      "type": "assert_pixel",
      "x": 20,
      "y": 70,
      "min_r": 254,
      "max_r": 255,
      "min_g": 254,
      "max_g": 255,
      "min_b": 254,
      "max_b": 255
    }
  ],
  "input_turn_ms": 0
}
