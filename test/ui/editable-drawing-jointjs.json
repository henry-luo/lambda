{
  "name": "JointJS SVG probe drags, reconnects, transforms, tools, and recreates a Paper",
  "html": "test/html/editable-jointjs.html",
  "viewport": {"width": 720, "height": 640},
  "events": [
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-ready", "equals": "true", "assert_timeout": 1000},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-svg-count", "equals": "1"},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-document-svg-count", "equals": "1"},
    {"type": "assert_count", "target": {"selector": "#drawing-host svg"}, "equals": 1},
    {"type": "assert_count", "target": {"selector": "#drawing-host canvas"}, "equals": 0},
    {"type": "assert_attribute", "target": {"selector": "#drawing-capabilities"}, "attribute": "data-library", "equals": "jointjs"},
    {"type": "assert_text", "target": {"selector": "#drawing-capabilities"}, "contains": "\"legacyCommandsPresent\":false"},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"textBounds\":{"},
    {"type": "mouse_drag", "target": {"selector": "#drawing-host", "offset_x": 85, "offset_y": 72}, "dx": 15, "dy": 10, "button": 0},
    {"type": "assert_attribute", "target": {"selector": "#drawing-host"}, "attribute": "data-jointjs-pointer-down", "equals": "joint-source"},
    {"type": "scroll", "target": {"selector": "#drawing-host"}, "dx": 0, "dy": -1},
    {"type": "assert_attribute", "target": {"selector": "#drawing-host"}, "attribute": "data-jointjs-wheel", "equals": "scaled"},
    {"type": "focus", "target": {"selector": "#drawing-host"}},
    {"type": "assert_focus", "target": {"selector": "#drawing-host"}},
    {"type": "key_press", "key": "m"},
    {"type": "assert_attribute", "target": {"selector": "#drawing-host"}, "attribute": "data-jointjs-key", "equals": "moved"},
    {"type": "click", "target": {"selector": "#resize-source"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"width\":145"},
    {"type": "click", "target": {"selector": "#reconnect-link"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"linkTarget\":\"joint-source\""},
    {"type": "click", "target": {"selector": "#pan-zoom"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"scaleX\":1.2"},
    {"type": "click", "target": {"selector": "#show-tools"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"toolsVisible\":true"},
    {"type": "click", "target": {"selector": "#remove-tools"}},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"toolsVisible\":false"},
    {"type": "click", "target": {"selector": "#destroy"}},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-destroyed", "equals": "true"},
    {"type": "assert_count", "target": {"selector": "#drawing-host svg"}, "equals": 0},
    {"type": "click", "target": {"selector": "#recreate"}},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-recreated", "equals": "true", "assert_timeout": 1000},
    {"type": "assert_attribute", "target": {"selector": "#drawing-state"}, "attribute": "data-document-svg-count", "equals": "1"},
    {"type": "assert_count", "target": {"selector": "#drawing-host svg"}, "equals": 1},
    {"type": "assert_text", "target": {"selector": "#drawing-state"}, "contains": "\"linkId\":\"joint-link\""}
  ]
}
