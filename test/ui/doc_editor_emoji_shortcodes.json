{
  "name": "Document editor renders standard Markdown emoji shortcodes",
  "html": "lmd/package/doc/doc_viewer.ls",
  "viewport": {"width": 1280, "height": 1800},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "comprehensive_emoji_test.md"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_comprehensive_emoji_test_md .tree-label"}},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "comprehensive_emoji_test.md"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": ":smiley:"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": ":joy:"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": ":worried:"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": ":ear:"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": ":monkey_face:"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": ":hamburger:"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "contains": ":invalid:"},
    {"type": "assert_text", "target": {"selector": "#rendered-preview"}, "not_contains": ":octocat:"},
    {"type": "assert_count", "target": {"selector": "#rendered-preview img[data-emoji='octocat']"}, "count": 2},
    {"type": "assert_attribute", "target": {"selector": "#rendered-preview img[data-emoji='shipit']"}, "attribute": "src", "equals": "https://github.githubassets.com/images/icons/emoji/shipit.png?v8"},
    {"type": "render", "file": "./temp/doc_editor_emoji_shortcodes.png"}
  ]
}
