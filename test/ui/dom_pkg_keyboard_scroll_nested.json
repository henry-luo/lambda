{
  "name": "ESO48: keyboard scroll selects the nearest live scrollport",
  "html": "test/ui/dom_pkg_keyboard_scroll_nested.html",
  "viewport": {"width": 640, "height": 380},
  "events": [
    {"type": "focus", "target": {"selector": "#pane"}},
    {"type": "assert_focus", "target": {"selector": "#pane"}},
    {"type": "key_press", "key": "PageDown"},
    {"type": "assert_state_store", "target": {"selector": "#pane"}, "view_state": true, "kind": "scroll", "view_scroll_y": 100, "tolerance": 24},
    {"type": "assert_scroll", "x": 0, "y": 0, "tolerance": 2},
    {"type": "key_press", "key": "Home"},
    {"type": "assert_state_store", "target": {"selector": "#pane"}, "view_scroll_y": 0, "tolerance": 2},
    {"type": "key_press", "key": "ArrowRight"},
    {"type": "assert_state_store", "target": {"selector": "#pane"}, "view_scroll_x": 40, "tolerance": 8},
    {"type": "key_press", "key": "ArrowLeft"},
    {"type": "assert_state_store", "target": {"selector": "#pane"}, "view_scroll_x": 0, "tolerance": 2}
  ]
}
