{
  "name": "Doc editor restores files when the name filter is cleared",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 4000},
  "events": [
    {"type": "assert_count", "target": {"selector": ".tree-filter-clear"}, "count": 0},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__AGENTS_md"}, "count": 1},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_pdf .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_pdf_essay_pdf"}, "count": 1},
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "zz"},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": "zz"},
    {"type": "assert_count", "target": {"selector": ".tree-filter-clear"}, "count": 1},
    {"type": "assert_text", "target": {"selector": ".tree-filter-clear"}, "contains": "×"},
    {"type": "assert_position", "element_a": {"selector": ".tree-filter-clear"},
     "element_b": {"selector": "#file-filter"}, "relation": "inside"},
    {"type": "assert_rect", "target": {"selector": ".tree-filter-clear"},
     "x": 255, "width": 26, "height": 26, "tolerance": 8},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__AGENTS_md"}, "count": 0},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_pdf_essay_pdf"}, "count": 0},
    {"type": "key_press", "key": "backspace"},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": "z"},
    {"type": "key_press", "key": "backspace"},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": ""},
    {"type": "assert_count", "target": {"selector": ".tree-filter-clear"}, "count": 0},
    {"type": "assert_text", "target": {"selector": ".file-panel-footer"}, "contains": "Project root"},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__AGENTS_md"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_pdf_essay_pdf"}, "count": 1},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "nomatch"},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__AGENTS_md"}, "count": 0},
    {"type": "click", "target": {"selector": ".tree-filter-clear"}},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": ""},
    {"type": "assert_count", "target": {"selector": ".tree-filter-clear"}, "count": 0},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__AGENTS_md"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_pdf_essay_pdf"}, "count": 1},
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "essay"},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_pdf_essay_pdf"}, "count": 1},
    {"type": "tripleclick", "target": {"selector": "#file-filter"}},
    {"type": "key_press", "key": "delete"},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": ""},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__AGENTS_md"}, "count": 1},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "nomatch"},
    {"type": "key_press", "key": "escape"},
    {"type": "assert_value", "target": {"selector": "#file-filter"}, "equals": ""},
    {"type": "assert_count", "target": {"selector": ".tree-hit-__test_pdf_essay_pdf"}, "count": 1}
  ]
}
