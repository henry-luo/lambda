    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#status"
      },
      "attribute": "data-count",
      "equals": "1"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#status"
      },
      "attribute": "data-matches",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
