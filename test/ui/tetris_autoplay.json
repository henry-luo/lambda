{
  "name": "tetris Auto Play, pause/resume, manual takeover and close",
  "html": "test/demo/tetris/tetris.ls",
  "viewport": {
    "width": 900,
    "height": 1000
  },
  "input_turn_ms": 0,
  "events": [
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-mode",
      "equals": "ready"
    },
    {
      "type": "assert_visible",
      "target": {
        "selector": "#auto-play"
      },
      "visible": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#auto-play"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-autoplay",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-mode",
      "equals": "playing"
    },
    {
      "type": "advance_time",
      "ms": 20000,
      "steps": 200
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#board .cell:not(.color-0):not(.ghost)"
      },
      "min": 8
    },
    {
      "type": "click",
      "target": {
        "selector": "#pause"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-mode",
      "equals": "paused"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-autoplay",
      "equals": "true"
    },
    {
      "type": "advance_time",
      "ms": 1000,
      "steps": 10
    },
    {
      "type": "click",
      "target": {
        "selector": "#overlay-action"
      }
    },
    {
      "type": "advance_time",
      "ms": 1000,
      "steps": 10
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-mode",
      "equals": "playing"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-autoplay",
      "equals": "true"
    },
    {
      "type": "key_press",
      "key": "ArrowLeft"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-autoplay",
      "equals": "false"
    },
    {
      "type": "click",
      "target": {
        "selector": "#restart"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tetris"
      },
      "attribute": "data-autoplay",
      "equals": "false"
    },
    {
      "type": "window_close"
    },
    {
      "type": "assert_window_closed",
      "closed": true
    }
  ]
}
