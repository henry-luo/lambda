{
  "name":"Diff review virtual rows, hunk navigation, search, selection and copy",
  "html":"test/ui/diff_review.ls",
  "viewport":{"width":1100,"height":720},
  "events":[
    {"type":"assert_count","target":{"selector":".diff-row"},"count":6},
    {"type":"assert_text","target":{"selector":".diff-title"},"equals":"Review fixture"},
    {"type":"assert_text","target":{"selector":".diff-position"},"equals":"1–6 / 44"},
    {"type":"click","target":{"selector":"[data-diff-command=next]"}},
    {"type":"wait","ms":60},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"new tail 😀"},
    {"type":"click","target":{"selector":"[data-diff-command=copy-new]"}},
    {"type":"assert_clipboard","contains":"line 1\nline 2\n"},
    {"type":"assert_clipboard","contains":"new tail 😀\n"},
    {"type":"click","target":{"selector":"[data-diff-command=previous]"}},
    {"type":"wait","ms":60},
    {"type":"assert_text","target":{"selector":".diff-position"},"equals":"1–6 / 44"},
    {"type":"click","target":{"selector":".diff-query"}},
    {"type":"type_physical","text":"tail"},
    {"type":"key_press","key":"Enter"},
    {"type":"wait","ms":60},
    {"type":"assert_text","target":{"selector":".diff-status"},"contains":"2 matches"},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"new tail 😀"},
    {"type":"click","target":{"selector":".diff-surface"}},
    {"type":"key_combo","key":"a","mods_str":"super"},
    {"type":"click","target":{"selector":"[data-diff-command=page-prev]"}},
    {"type":"key_combo","key":"c","mods_str":"super"},
    {"type":"assert_clipboard","contains":"line 1\nline 2\n"},
    {"type":"assert_clipboard","contains":"old tail\nnew tail 😀"},
    {"type":"click","target":{"selector":"[data-diff-command=previous]"}},
    {"type":"click","target":{"selector":".diff-row[data-row='1'] .diff-num"}},
    {"type":"click","target":{"selector":"[data-diff-command=next]"}},
    {"type":"click","target":{"selector":".diff-text[data-row='43']"},"mods_str":"shift"},
    {"type":"key_combo","key":"c","mods_str":"super"},
    {"type":"assert_clipboard","contains":"line 1\nline 2\n"},
    {"type":"assert_clipboard","contains":"old tail\n"},
    {"type":"assert_clipboard","not_contains":"new tail 😀"},
    {"type":"click","target":{"selector":"[data-diff-id='1']"}},
    {"type":"wait","ms":60},
    {"type":"assert_text","target":{"selector":".diff-surface"},"contains":"Mode:"},
    {"type":"assert_count","target":{"selector":".diff-row"},"count":1}
  ]
}
