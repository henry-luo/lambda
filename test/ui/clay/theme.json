{
  "name": "clay theme preserves shared behavior and scoped appearance",
  "html": "test/ui/clay/theme.ls",
  "viewport": {
    "width": 1000,
    "height": 1000
  },
  "events": [
    {
      "type": "assert_style",
      "target": {
        "selector": "#base"
      },
      "property": "color",
      "equals": "rgb(255, 255, 255)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#mint"
      },
      "property": "border-color",
      "equals": "rgb(40, 123, 99)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#inherited"
      },
      "property": "border-color",
      "equals": "rgb(40, 123, 99)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#inherited"
      },
      "property": "border-radius",
      "equals": "24px"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#rose"
      },
      "property": "border-color",
      "equals": "rgb(189, 69, 97)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#after"
      },
      "property": "border-color",
      "equals": "rgb(107, 81, 219)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#ant"
      },
      "property": "background-color",
      "equals": "rgb(22, 119, 255)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#bold"
      },
      "property": "background-color",
      "equals": "rgb(250, 204, 21)"
    },
    {
      "type": "assert_state",
      "target": {
        "selector": "#locked"
      },
      "state": ":disabled",
      "value": true
    },
    {
      "type": "assert_state",
      "target": {
        "selector": "#locked-button"
      },
      "state": ":disabled",
      "value": true
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#card"
      },
      "property": "border-radius",
      "equals": "26px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#layout"
      },
      "attribute": "class",
      "equals": "dtna-layout dtna-layout-has-sider"
    }
  ]
}
