{
  "name": "clay collections preserves shared behavior and scoped appearance",
  "html": "test/ui/clay/collections.ls",
  "viewport": {
    "width": 1000,
    "height": 2200
  },
  "events": [
    {
      "type": "type",
      "target": {
        "selector": "#retained"
      },
      "text": "Remember"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tabs-item-0"
      }
    },
    {
      "type": "key_press",
      "key": "right"
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#tabs-item-2"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tabs-item-2"
      },
      "attribute": "aria-selected",
      "equals": "true"
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#nested"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "#nested"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#last"
      },
      "equals": "nested:click"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tabs-item-0"
      }
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#retained"
      },
      "equals": "Remember"
    },
    {
      "type": "click",
      "target": {
        "selector": "#segments-item-1"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#segments-item-1"
      },
      "attribute": "aria-checked",
      "equals": "true"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#last"
      },
      "equals": "segments:select"
    },
    {
      "type": "click",
      "target": {
        "selector": "#fixed-tabs-item-1"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#fixed-tabs-item-0"
      },
      "attribute": "aria-selected",
      "equals": "true"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#last"
      },
      "equals": "fixed-tabs:select"
    },
    {
      "type": "click",
      "target": {
        "selector": "#pages [aria-label='Next page']"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#pages [aria-current=page]"
      },
      "equals": "2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#collapse-header-0"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#collapse-header-0"
      },
      "attribute": "aria-expanded",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#inside"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#last"
      },
      "equals": "inside:click"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tree-node-1 [data-dtna-tree-check]"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tree-node-1"
      },
      "attribute": "aria-checked",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#table [data-dtna-table-sort='0']"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#table [aria-sort]"
      },
      "attribute": "aria-sort",
      "equals": "ascending"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#table tbody tr:first-child td:last-child"
      },
      "equals": "Ada"
    },
    {
      "type": "click",
      "target": {
        "selector": "#table [data-dtna-table-select='1']"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#table [data-dtna-table-select='1']"
      },
      "attribute": "aria-checked",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#table [aria-label='Next page']"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#table [aria-current=page]"
      },
      "equals": "2"
    },
    {
      "type": "click",
      "target": {
        "selector": "#rating [data-dtna-rate-index='3']"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#rating"
      },
      "attribute": "data-value",
      "equals": "4"
    },
    {
      "type": "click",
      "target": {
        "selector": "#tag"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#tag"
      },
      "attribute": "aria-checked",
      "equals": "true"
    },
    {
      "type": "click",
      "target": {
        "selector": "#alert .dtna-alert-close"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#alert"
      },
      "count": 0
    }
  ]
}
