{
  "name": "Modern theme colors update inherited text, borders and mixed backgrounds",
  "html": "test/ui/css_theme_colors.html",
  "viewport": {
    "width": 240,
    "height": 150
  },
  "events": [
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#theme",
        "offset_x": 3,
        "offset_y": 3
      },
      "min_r": 185,
      "max_r": 187,
      "min_g": 99,
      "max_g": 101,
      "min_b": 91,
      "max_b": 93
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#theme",
        "offset_x": 150,
        "offset_y": 50
      },
      "min_r": 220,
      "max_r": 222,
      "min_g": 177,
      "max_g": 179,
      "min_b": 173,
      "max_b": 175
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#theme"
      },
      "property": "color",
      "equals": "oklab(0.6 0.1 0.05)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#label"
      },
      "property": "color",
      "equals": "oklab(0.6 0.1 0.05)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#theme"
      },
      "property": "border-top-color",
      "equals": "oklab(0.6 0.1 0.05)"
    },
    {
      "type": "click",
      "target": {
        "selector": "#change"
      }
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#theme",
        "offset_x": 3,
        "offset_y": 3
      },
      "min_r": 120,
      "max_r": 122,
      "min_g": 136,
      "max_g": 138,
      "min_b": 63,
      "max_b": 65
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#theme",
        "offset_x": 150,
        "offset_y": 50
      },
      "min_r": 187,
      "max_r": 189,
      "min_g": 195,
      "max_g": 197,
      "min_b": 159,
      "max_b": 161
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#theme"
      },
      "property": "color",
      "equals": "oklch(0.6 0.1 120)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#label"
      },
      "property": "color",
      "equals": "oklch(0.6 0.1 120)"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": "#theme"
      },
      "property": "border-top-color",
      "equals": "oklch(0.6 0.1 120)"
    }
  ]
}
