{
  "name": "Keyboard scroll chaining shares overscroll axis policy",
  "html": "test/ui/scroll_keyboard_chain.html",
  "viewport": {
    "width": 640,
    "height": 300
  },
  "events": [
    {
      "type": "focus",
      "target": {
        "selector": "#auto"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#auto"
      }
    },
    {
      "type": "key_press",
      "key": "ArrowDown"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#auto"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 40
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#ao"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 0
    },
    {
      "type": "key_press",
      "key": "PageDown"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#auto"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 91
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#ao"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 0
    },
    {
      "type": "key_press",
      "key": "Space"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#auto"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 142
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#ao"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#end"
      }
    },
    {
      "type": "focus",
      "target": {
        "selector": "#auto"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#auto"
      }
    },
    {
      "type": "key_press",
      "key": "ArrowDown"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#auto"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 240
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#ao"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 40
    },
    {
      "type": "key_press",
      "key": "ArrowRight"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#auto"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_x": 150
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#ao"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_x": 40
    },
    {
      "type": "focus",
      "target": {
        "selector": "#contained"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#contained"
      }
    },
    {
      "type": "key_press",
      "key": "ArrowDown"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#contained"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 240
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#co"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 0
    },
    {
      "type": "key_press",
      "key": "ArrowRight"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#contained"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_x": 150
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#co"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_x": 0
    },
    {
      "type": "focus",
      "target": {
        "selector": "#none"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#none"
      }
    },
    {
      "type": "key_press",
      "key": "ArrowDown"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#none"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 240
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#no"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 0
    },
    {
      "type": "key_press",
      "key": "ArrowRight"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#none"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_x": 150
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#no"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_x": 0
    },
    {
      "type": "focus",
      "target": {
        "selector": "#edit"
      }
    },
    {
      "type": "assert_focus",
      "target": {
        "selector": "#edit"
      }
    },
    {
      "type": "set_editing_selection",
      "target": {
        "selector": "#edit"
      },
      "start": 0,
      "end": 0
    },
    {
      "type": "key_press",
      "key": "ArrowDown"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#ao"
      },
      "view_state": true,
      "kind": "scroll",
      "tolerance": 0.01,
      "view_scroll_y": 40
    },
    {
      "type": "assert_value",
      "target": {
        "selector": "#edit"
      },
      "equals": "one\ntwo\nthree"
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#ei"
      },
      "view_state": true,
      "kind": "scroll",
      "view_scroll_y": 0
    },
    {
      "type": "assert_state_store",
      "target": {
        "selector": "#eo"
      },
      "view_state": true,
      "kind": "scroll",
      "view_scroll_y": 0
    },
    {
      "type": "assert_form_selection",
      "target": {
        "selector": "#edit"
      },
      "start": 4,
      "end": 4
    }
  ]
}
