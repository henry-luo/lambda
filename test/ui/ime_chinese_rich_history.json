{
  "html": "test/ui/ime_chinese.html",
  "viewport": {
    "width": 800,
    "height": 700
  },
  "name": "ime_chinese_rich_history",
  "events": [
    {
      "type": "script",
      "js": "document.getElementById('rich').textContent = 'seed'"
    },
    {
      "type": "set_editing_selection",
      "target": {
        "selector": "#rich"
      },
      "start": 0,
      "end": 4
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#rich"
      },
      "text": "beijing"
    },
    {
      "type": "key_press",
      "key": "space"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#rich"
      },
      "equals": "北京"
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "super"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#rich"
      },
      "equals": "seed"
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "super,shift"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#rich"
      },
      "equals": "北京"
    },
    {
      "type": "set_editing_selection",
      "target": {
        "selector": "#rich"
      },
      "start": 0,
      "end": 6
    },
    {
      "type": "type_physical",
      "target": {
        "selector": "#rich"
      },
      "text": "bei"
    },
    {
      "type": "key_press",
      "key": "escape"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#rich"
      },
      "equals": "北京"
    },
    {
      "type": "assert_editing_selection",
      "target": {
        "selector": "#rich"
      },
      "start": 0,
      "end": 6
    },
    {
      "type": "key_combo",
      "key": "z",
      "mods_str": "super"
    },
    {
      "type": "assert_text",
      "target": {
        "selector": "#rich"
      },
      "equals": "seed"
    }
  ]
}
