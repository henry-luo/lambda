{
  "name": "Controlled bindings preserve caret and IME, settle rejected edits, and emit typed actions once",
  "html": "test/ui/controlled_bindings.ls",
  "viewport": {"width": 1000, "height": 700},
  "events": [
    {"type":"assert_value","target":{"selector":"#field"},"equals":"seed"},
    {"type":"click","target":{"selector":"#field"}},
    {"type":"key_press","key":"End"},
    {"type":"type","target":{"selector":"#field"},"text":"X","clear":false},
    {"type":"assert_value","target":{"selector":"#field"},"equals":"seedX"},
    {"type":"assert_form_selection","target":{"selector":"#field"},"start":5,"end":5},
    {"type":"key_press","key":"ArrowLeft"},
    {"type":"type","target":{"selector":"#field"},"text":"Y","clear":false},
    {"type":"assert_value","target":{"selector":"#field"},"equals":"seedYX"},
    {"type":"assert_form_selection","target":{"selector":"#field"},"start":5,"end":5},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"2"},
    {"type":"key_press","key":"End"},
    {"type":"ime_compose","phase":"begin"},
    {"type":"ime_compose","phase":"update","preedit":"pre","caret":3},
    {"type":"assert_value","target":{"selector":"#field"},"equals":"seedYX"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"2"},
    {"type":"assert_text","target":{"selector":"#compositions"},"equals":"1"},
    {"type":"ime_compose","phase":"commit","commit":"好"},
    {"type":"assert_value","target":{"selector":"#field"},"equals":"seedYX好"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"3"},
    {"type":"type","target":{"selector":"#uncontrolled"},"text":"U","clear":false},
    {"type":"click","target":{"selector":"#programmatic"}},
    {"type":"assert_value","target":{"selector":"#field"},"equals":"program"},
    {"type":"assert_value","target":{"selector":"#ant-field"},"equals":"program"},
    {"type":"assert_value","target":{"selector":"#bold-field"},"equals":"program"},
    {"type":"assert_value","target":{"selector":"#wired-field"},"equals":"program"},
    {"type":"assert_value","target":{"selector":"#notes"},"equals":"other"},
    {"type":"assert_value","target":{"selector":"#choice"},"equals":"20"},
    {"type":"assert_checked","target":{"selector":"#enabled"},"checked":true},
    {"type":"assert_checked","target":{"selector":"#radio-a"},"checked":false},
    {"type":"assert_checked","target":{"selector":"#radio-b"},"checked":true},
    {"type":"assert_value","target":{"selector":"#uncontrolled"},"equals":"draftU"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"3"},
    {"type":"select_option","target":{"selector":"#choice"},"value":"10"},
    {"type":"assert_value","target":{"selector":"#choice"},"equals":"10"},
    {"type":"assert_text","target":{"selector":"#type"},"equals":"int"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"4"},
    {"type":"click","target":{"selector":"#enabled"}},
    {"type":"assert_checked","target":{"selector":"#enabled"},"checked":false},
    {"type":"assert_text","target":{"selector":"#type"},"equals":"bool"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"5"},
    {"type":"click","target":{"selector":"#radio-a"}},
    {"type":"assert_checked","target":{"selector":"#radio-a"},"checked":true},
    {"type":"assert_checked","target":{"selector":"#radio-b"},"checked":false},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"6"},
    {"type":"type","target":{"selector":"#notes"},"text":"Z","clear":false},
    {"type":"assert_value","target":{"selector":"#notes"},"equals":"otherZ"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"7"},
    {"type":"click","target":{"selector":"#reject"}},
    {"type":"type","target":{"selector":"#field"},"text":"Q","clear":false},
    {"type":"assert_value","target":{"selector":"#field"},"equals":"program"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"8"},
    {"type":"type","target":{"selector":"#wired-field"},"text":"W","clear":false},
    {"type":"assert_value","target":{"selector":"#wired-field"},"equals":"program"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"9"},
    {"type":"click","target":{"selector":"#programmatic"}},
    {"type":"assert_value","target":{"selector":"#choice"},"equals":"20"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"9"},
    {"type":"select_option","target":{"selector":"#choice"},"value":"1.5"},
    {"type":"assert_text","target":{"selector":"#type"},"equals":"float"},
    {"type":"assert_value","target":{"selector":"#choice"},"equals":"20"},
    {"type":"assert_text","target":{"selector":"#requests"},"equals":"10"}
  ]
}
