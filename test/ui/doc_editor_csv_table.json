{
  "name": "Document editor previews CSV as a resizable table",
  "html": "test/ui/doc_editor.ls",
  "viewport": {"width": 1280, "height": 1600},
  "events": [
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "test_tab.csv"},
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_tab_csv .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#csv-preview table.csv-table"}, "count": 1},
    {"type": "assert_count", "target": {"selector": ".csv-table thead th"}, "count": 5},
    {"type": "assert_count", "target": {"selector": ".csv-table tbody tr"}, "count": 5},
    {"type": "assert_text", "target": {"selector": ".csv-table thead th", "index": 0}, "equals": "name"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:first-child td", "index": 0}, "equals": "John Doe"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:nth-child(2) td", "index": 2}, "equals": "San Francisco"},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 150, "tolerance": 5},
    {"type": "assert_style", "target": {"selector": ".csv-table thead th:first-child .csv-resize"}, "property": "cursor", "equals": "col-resize"},
    {"type": "mouse_drag", "target": {"selector": ".csv-table thead th:first-child .csv-resize", "offset_x": 5, "offset_y": 12}, "dx": 70, "dy": 0, "button": 0},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 220, "tolerance": 5},
    {"type": "assert_rect", "target": {"selector": ".csv-table tbody tr:first-child td", "index": 0}, "width": 220, "tolerance": 5},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 1}, "width": 150, "tolerance": 5},
    {"type": "mouse_drag", "target": {"selector": ".csv-table thead th:nth-child(2) .csv-resize", "offset_x": 5, "offset_y": 12}, "dx": 45, "dy": 0, "button": 0},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 1}, "width": 195, "tolerance": 5},
    {"type": "render", "file": "./temp/doc_editor_csv_table.png"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "name\tage\tcity"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 220, "tolerance": 5},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 1}, "width": 195, "tolerance": 5},
    {"type": "mouse_drag", "target": {"selector": ".csv-table thead th:first-child .csv-resize", "offset_x": 5, "offset_y": 12}, "dx": -300, "dy": 0, "button": 0},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 72, "tolerance": 5},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 1}, "width": 195, "tolerance": 5},
    {"type": "click", "target": {"selector": ".tree-filter-clear"}},
    {"type": "click", "target": {"selector": "#file-filter"}},
    {"type": "type", "target": {"selector": "#file-filter"}, "text": "test.csv"},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_csv .tree-label"}},
    {"type": "assert_count", "target": {"selector": ".csv-table thead th"}, "count": 7},
    {"type": "assert_text", "target": {"selector": ".csv-table thead th", "index": 6}, "equals": "email"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:first-child td", "index": 0}, "equals": "John Doe"},
    {"type": "assert_text", "target": {"selector": ".csv-table tbody tr:nth-child(4) td", "index": 2}, "equals": "Los Angeles, CA"},
    {"type": "assert_rect", "target": {"selector": ".csv-table thead th", "index": 0}, "width": 150, "tolerance": 5}
  ]
}
