{
  "name": "Background computed components share shorthand/defaulting, owner-unit inheritance and causal font updates",
  "html": "test/ui/cssom_background_components.html",
  "viewport": {
    "width": 640,
    "height": 160
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-0",
      "equals": "no-repeat"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-1",
      "equals": "8px 4px"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-2",
      "equals": "calc(100% - 3px) calc(100% - 5px)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-3",
      "equals": "fixed, local"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-4",
      "equals": "8px 4px, min(50%, 8px) max(10%, 4px)"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-5",
      "equals": "calc(100% - 4px) calc(100% - max(25%, 4px))"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-6",
      "equals": "repeat-x, round space, no-repeat"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-7",
      "equals": "border-box, padding-box, content-box"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-8",
      "equals": "padding-box, text, content-box"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-9",
      "equals": "scroll, fixed, local"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-10",
      "equals": "multiply, screen, normal"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-11",
      "equals": "repeat"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-case-12",
      "equals": "8px 4px, 8px 4px"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#box",
        "offset_x": 2,
        "offset_y": 2
      },
      "search_radius": 0,
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#box",
        "offset_x": 12,
        "offset_y": 6
      },
      "search_radius": 0,
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#resize"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-size",
      "equals": "16px 8px, 16px 8px"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#box",
        "offset_x": 12,
        "offset_y": 6
      },
      "search_radius": 0,
      "min_r": 255,
      "max_r": 255,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#box",
        "offset_x": 20,
        "offset_y": 12
      },
      "search_radius": 0,
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-before-size",
      "equals": "12px 6px, auto"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-after-size",
      "equals": "16px 8px, 16px 8px"
    }
  ]
}
