      "equals": "muted"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#greetings-preview"
      },
      "attribute": "data-turning",
      "equals": "true"
    },
    {
      "type": "assert_script",
      "js": "document.querySelector(\".book\") === window.greetingsTurnBook"
    },
    {
      "type": "advance_time",
      "ms": 300,
      "steps": 10
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#greetings-preview"
      },
      "attribute": "data-turning",
      "equals": "true"
    },
    {
      "type": "render",
      "file": "temp/greetings/page-turn-popup-middle.png"
    },
