    {
      "type": "advance_time",
      "ms": 1000,
      "steps": 25
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".preview"
      },
      "count": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=\"preview\"][data-arg=\"closed\"]"
