    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#greetings-preview"
      },
      "attribute": "data-progress",
      "equals": "0"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#greetings-preview"
      },
      "attribute": "data-turning",
      "equals": "false"
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=\"preview-done\"]"
      }
    },
    {
      "type": "log",
      "message": "Pop-up hinges follow the fold; music controls preserve the live turn and half-open holds its pose."
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=\"template\"][data-arg=\"popup-love\"]"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "[data-act=\"preview\"][data-arg=\"closed\"]"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".preview [data-act=\"motion-toggle\"]"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".preview [data-act=\"preview\"][data-arg=\"open\"]"
      }
    },
    {
      "type": "advance_time",
      "ms": 180,
      "steps": 6
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#greetings-preview"
      },
      "attribute": "data-turning",
      "equals": "true"
    },
    {
      "type": "assert_style",
      "target": {
        "selector": ".face-inside .popup-plane-2"
      },
      "property": "opacity",
      "equals": "1",
      "animated": true,
      "tolerance": 0.01
    },
    {
      "type": "script",
      "js": "window.greetingsTurnBook = document.querySelector(\".book\"); true;"
    },
    {
      "type": "click",
      "target": {
        "selector": ".preview [data-act=\"music-toggle\"]"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#studio"
