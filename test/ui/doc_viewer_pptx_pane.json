{
  "name": "Bundled document pane retains PowerPoint preview and converted HTML across tabs",
  "html": "lmd/package/doc/doc_viewer.ls",
  "viewport": {"width": 1100, "height": 5000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_pptx .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_pptx_minimal_pptx .tree-label"}},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "minimal.pptx"},
    {"type": "assert_count", "target": {"selector": "#pptx-preview .slide-stage"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#pptx-preview p"}, "equals": "Hello, PPTX!"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "Hello, PPTX!</span>"},
    {"type": "click", "target": {"selector": ".root-toggle"}},
    {"type": "assert_count", "target": {"selector": ".tab-source.active"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "slide-handout"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_count", "target": {"selector": "#pptx-preview .slide-stage"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#pptx-preview p"}, "equals": "Hello, PPTX!"}
  ]
}
