{
  "name":"wired decoration preserves native editing, ownership, radio groups, and forms",
  "html":"test/ui/wired/controls.ls",
  "viewport":{"width":900,"height":1500},
  "events":[
    {"type":"type","target":{"selector":"#draft"},"text":"Idea"},
    {"type":"assert_value","target":{"selector":"#draft"},"equals":"Idea"},
    {"type":"assert_text","target":{"selector":"#last"},"equals":"draft"},
    {"type":"type","target":{"selector":"#notes"},"text":"Keep these notes"},
    {"type":"click","target":{"selector":"#increment"}},
    {"type":"assert_text","target":{"selector":"#count"},"equals":"1"},
    {"type":"assert_value","target":{"selector":"#draft"},"equals":"Idea"},
    {"type":"assert_value","target":{"selector":"#notes"},"equals":"Keep these notes"},
    {"type":"type","target":{"selector":"#fixed"},"text":"X"},
    {"type":"wait","ms":80},
    {"type":"assert_value","target":{"selector":"#fixed"},"equals":"seed"},
    {"type":"type","target":{"selector":"#accepted"},"text":"Accepted"},
    {"type":"wait","ms":80},
    {"type":"assert_value","target":{"selector":"#accepted"},"equals":"Accepted"},
    {"type":"click","target":{"selector":"#checked"}},
    {"type":"wait","ms":80},
    {"type":"assert_checked","target":{"selector":"#checked"},"checked":false},
    {"type":"click","target":{"selector":"#choice"}},
    {"type":"assert_checked","target":{"selector":"#choice"},"checked":true},
    {"type":"click","target":{"selector":"#toggle"}},
    {"type":"assert_checked","target":{"selector":"#toggle"},"checked":true},
    {"type":"click","target":{"selector":"#radio-b"}},
    {"type":"assert_checked","target":{"selector":"#radio-a"},"checked":false},
    {"type":"assert_checked","target":{"selector":"#radio-b"},"checked":true},
    {"type":"click","target":{"selector":"#wired-peer"}},
    {"type":"wait","ms":80},
    {"type":"assert_checked","target":{"selector":"#bold-peer"},"checked":true},
    {"type":"assert_checked","target":{"selector":"#wired-peer"},"checked":false},
    {"type":"click","target":{"selector":"#stage"}},
    {"type":"key_press","key":"down"},
    {"type":"key_press","key":"enter"},
    {"type":"wait","ms":80},
    {"type":"assert_value","target":{"selector":"#stage"},"equals":"10"},
    {"type":"assert_text","target":{"selector":"#request"},"equals":"20"},
    {"type":"assert_text","target":{"selector":"#selected-type"},"equals":"int"},
    {"type":"click","target":{"selector":"#disabled"}},
    {"type":"assert_text","target":{"selector":"#count"},"equals":"1"},
    {"type":"click","target":{"selector":"#submit"}},
    {"type":"assert_text","target":{"selector":"#last"},"equals":"form:submit"},
    {"type":"assert_text","target":{"selector":"#request"},"equals":"project=Notebook"},
    {"type":"type","target":{"selector":"#project"},"text":"X"},
    {"type":"click","target":{"selector":"#reset"}},
    {"type":"assert_value","target":{"selector":"#project"},"equals":"Notebook"},
    {"type":"assert_text","target":{"selector":"#last"},"equals":"form:reset"}
  ]
}
