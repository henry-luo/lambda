{
  "name": "Slides ribbon groups collapse into reachable command menus",
  "html": "test/demo/slides/slides.ls",
  "viewport": {"width": 600, "height": 600},
  "events": [
    {"type": "wait", "ms": 100},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon'),s=document.querySelector('.sample-label').getBoundingClientRect(),p=document.querySelector('.title-actions').getBoundingClientRect();return getComputedStyle(document.getElementById('ribbon')).overflowX==='visible'&&r.querySelectorAll('.ribbon-group[data-compact=true]').length>0&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1&&document.querySelector('[data-tab=Animations]').getBoundingClientRect().right<=window.innerWidth&&document.querySelector('.inspector').getBoundingClientRect().right<=window.innerWidth&&s.width>150&&s.right<=p.left})()"},
    {"type": "click", "target": {"selector": ".group-drawing[data-compact=true] .ribbon-group-trigger"}},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.group-drawing'),t=g.querySelector('.group-tools'),p=t.getBoundingClientRect(),r=document.querySelector('.editor-ribbon').getBoundingClientRect();return g.getAttribute('data-open')==='true'&&g.querySelector('.ribbon-group-trigger').getAttribute('aria-expanded')==='true'&&getComputedStyle(t).position==='absolute'&&p.width>100&&p.left>=r.left&&p.right<=r.right+1})()"},
    {"type": "render", "file": "temp/slide-ribbon-home-compact.png"},
    {"type": "click", "target": {"selector": "#home-shapes"}},
    {"type": "assert_visible", "target": {"selector": "#home-menu"}, "visible": true},
    {"type": "click", "target": {"selector": "[data-tab=Insert]"}},
    {"type": "wait", "ms": 70},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon');return r.classList.contains('insert-ribbon')&&r.querySelectorAll('.ribbon-group[data-compact=true]').length>0&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "click", "target": {"selector": ".group-media[data-compact=true] .ribbon-group-trigger"}},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.group-media'),p=g.querySelector('.group-tools').getBoundingClientRect(),r=document.querySelector('.editor-ribbon').getBoundingClientRect();return g.getAttribute('data-open')==='true'&&p.width>100&&p.left>=r.left&&p.right<=r.right+1})()"},
    {"type": "render", "file": "temp/slide-ribbon-insert-compact.png"},
    {"type": "click", "target": {"selector": "#insert-video"}},
    {"type": "assert_visible", "target": {"selector": "#insert-dialog"}, "visible": true},
    {"type": "assert_script", "js": "document.querySelector('.ribbon-group[data-open=true]')===null"},
    {"type": "click", "target": {"selector": "#insert-cancel"}},
    {"type": "click", "target": {"selector": ".group-media[data-compact=true] .ribbon-group-trigger"}},
    {"type": "key_press", "key": "Escape"},
    {"type": "assert_script", "js": "document.querySelector('.ribbon-group[data-open=true]')===null"},
    {"type": "click", "target": {"selector": "[data-tab=Design]"}},
    {"type": "wait", "ms": 70},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon');return r.classList.contains('design-ribbon')&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "click", "target": {"selector": "[data-tab=Transitions]"}},
    {"type": "wait", "ms": 70},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon');return r.classList.contains('transitions-ribbon')&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "click", "target": {"selector": "[data-tab=Animations]"}},
    {"type": "wait", "ms": 70},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon');return r.classList.contains('animations-ribbon')&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "resize", "width": 761, "height": 700},
    {"type": "click", "target": {"selector": "[data-tab=Insert]"}},
    {"type": "wait", "ms": 70},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon');return r.classList.contains('insert-ribbon')&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "resize", "width": 760, "height": 700},
    {"type": "wait", "ms": 70},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon');return r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "resize", "width": 1440, "height": 700},
    {"type": "wait", "ms": 70},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon');return r.querySelectorAll('.ribbon-group[data-compact=true]').length===0&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "script", "js": "window.stableWrites=[];window.stableObserver=new MutationObserver(ms=>stableWrites.push(...ms));stableObserver.observe(document.querySelector('.editor-ribbon'),{subtree:true,attributes:true,attributeFilter:['data-compact','data-layout-key','data-measured-tab','data-measured-labels']})"},
    {"type": "resize", "width": 1430, "height": 700},
    {"type": "resize", "width": 1420, "height": 700},
    {"type": "resize", "width": 1410, "height": 700},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon'),ms=stableWrites.concat(stableObserver.takeRecords());stableObserver.disconnect();return ms.length===0&&r.querySelectorAll('.ribbon-group[data-compact=true]').length===0&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "script", "js": "window.ribbonWrites=[];window.ribbonObserver=new MutationObserver(ms=>{for(let m of ms)ribbonWrites.push(m)});ribbonObserver.observe(document.querySelector('.editor-ribbon'),{subtree:true,attributes:true,attributeOldValue:true,attributeFilter:['data-compact']})"},
    {"type": "resize", "width": 900, "height": 700},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon'),ms=ribbonWrites.concat(ribbonObserver.takeRecords());window.ribbonWrites=[];window.slideCompactAt900=r.querySelectorAll('.ribbon-group[data-compact=true]').length;return window.slideCompactAt900>0&&ms.length===window.slideCompactAt900&&ms.every(m=>m.oldValue===null&&m.target.getAttribute('data-compact')==='true')&&r.lastElementChild.getAttribute('data-compact')==='true'&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "resize", "width": 600, "height": 700},
    {"type": "assert_script", "js": "(()=>{let r=document.querySelector('.editor-ribbon'),ms=ribbonWrites.concat(ribbonObserver.takeRecords()),n=r.querySelectorAll('.ribbon-group[data-compact=true]').length;window.ribbonWrites=[];window.slideCompactAt600=n;return n>=window.slideCompactAt900&&ms.length===n-window.slideCompactAt900&&ms.every(m=>m.oldValue===null&&m.target.getAttribute('data-compact')==='true')&&r.lastElementChild.getAttribute('data-compact')==='true'&&r.lastElementChild.getBoundingClientRect().right<=r.getBoundingClientRect().right+1})()"},
    {"type": "assert_script", "js": "(()=>{let stage=document.getElementById('stage').getBoundingClientRect(),paper=document.getElementById('paper').getBoundingClientRect();window.paperAt600=paper.width;return paper.width>0&&paper.left>=stage.left&&paper.right<=stage.right&&paper.top>=stage.top&&paper.bottom<=stage.bottom})()"},
    {"type": "resize", "width": 1440, "height": 700},
    {"type": "assert_script", "js": "(()=>{let ms=ribbonWrites.concat(ribbonObserver.takeRecords());return document.querySelectorAll('.editor-ribbon .ribbon-group[data-compact=true]').length===0&&ms.length===slideCompactAt600&&ms.every(m=>m.oldValue==='true'&&m.target.getAttribute('data-compact')===null)})()"},
    {"type": "assert_script", "js": "document.getElementById('paper').getBoundingClientRect().width>paperAt600"},
    {"type": "script", "js": "ribbonObserver.disconnect()"},
    {"type": "resize", "width": 600, "height": 700},
    {"type": "click", "target": {"selector": ".group-media[data-compact=true] .ribbon-group-trigger"}},
    {"type": "assert_script", "js": "document.querySelector('.group-media').getAttribute('data-open')==='true'"},
    {"type": "resize", "width": 620, "height": 700},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.group-media'),s=getComputedStyle(g.querySelector('.group-tools'));return g.getAttribute('data-compact')==='true'&&g.getAttribute('data-open')===null&&s.display==='none'&&s.position!=='absolute'&&(!s.boxShadow||s.boxShadow==='none')})()"},
    {"type": "click", "target": {"selector": ".group-media[data-compact=true] .ribbon-group-trigger"}},
    {"type": "resize", "width": 1440, "height": 700},
    {"type": "assert_script", "js": "(()=>{let g=document.querySelector('.group-media'),s=getComputedStyle(g.querySelector('.group-tools'));return g.getAttribute('data-compact')===null&&g.getAttribute('data-open')===null&&s.position!=='absolute'&&(!s.boxShadow||s.boxShadow==='none')})()"},
    {"type": "render", "file": "temp/slide-ribbon-expanded.png"}
  ]
}
