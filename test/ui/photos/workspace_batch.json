      "text": "[{\"source\": \"temp/photos/tab-source.photos\", \"target\": \"temp/photos/tab-batch.png\", \"format\": \"png\"}, {\"source\": \"temp/photos/not-present.photos\", \"target\": \"temp/photos/tab-failure.png\", \"format\": \"png\"}]",
