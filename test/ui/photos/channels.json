{
  "name": "Photos component previews and saved coverage channels",
  "html": "test/demo/photos/photos.ls",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "events": [
    {
      "type": "advance_time",
      "ms": 50
    },
    {
      "type": "click",
      "target": {
        "selector": "#new"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#image-width"
      },
      "text": "64",
      "clear": true
    },
    {
      "type": "type",
      "target": {
        "selector": "#image-height"
      },
      "text": "48",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#resize-canvas"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#add-layer"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#foreground"
      },
      "text": "#ff0000",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#fill-color"
      }
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#channel-view"
      },
      "value": "r"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-channel-view",
      "equals": "r"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#preview",
        "offset_x": 60,
        "offset_y": 60
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 255,
      "max_g": 255,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#channel-view"
      },
      "value": "g"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#preview",
        "offset_x": 60,
        "offset_y": 60
      },
      "min_r": 0,
      "max_r": 0,
      "min_g": 0,
      "max_g": 0,
      "min_b": 0,
      "max_b": 0
    },
    {
      "type": "click",
      "target": {
        "selector": "#select-all"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#channel-save"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-channels",
      "equals": "1"
    },
    {
      "type": "click",
      "target": {
        "selector": "#deselect"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#channel-preview"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-channel-view",
      "equals": "channel-1"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#preview",
        "offset_x": 60,
        "offset_y": 60
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 255,
      "max_g": 255,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "select_option",
      "target": {
        "selector": "#channel-view"
      },
      "value": "composite"
    },
    {
      "type": "click",
      "target": {
        "selector": "#channel-load"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-selection",
      "equals": "active"
    },
    {
      "type": "click",
      "target": {
        "selector": "#deselect"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#save"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#file-path"
      },
      "text": "temp/photos/channels.photos",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#file-confirm"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-dirty",
      "equals": "false"
    },
    {
      "type": "click",
      "target": {
        "selector": "#new"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "#open"
      }
    },
    {
      "type": "type",
      "target": {
        "selector": "#file-path"
      },
      "text": "temp/photos/channels.photos",
      "clear": true
    },
    {
      "type": "click",
      "target": {
        "selector": "#file-confirm"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-channels",
      "equals": "1"
    },
    {
      "type": "click",
      "target": {
        "selector": "#channel-preview"
      }
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#preview",
        "offset_x": 60,
        "offset_y": 60
      },
      "min_r": 255,
      "max_r": 255,
      "min_g": 255,
      "max_g": 255,
      "min_b": 255,
      "max_b": 255
    },
    {
      "type": "click",
      "target": {
        "selector": "#channel-delete"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-channels",
      "equals": "0"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-channel-view",
      "equals": "composite"
    },
    {
      "type": "click",
      "target": {
        "selector": "#undo"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-channels",
      "equals": "1"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#photos"
      },
      "attribute": "data-error",
      "equals": ""
    }
  ]
}
