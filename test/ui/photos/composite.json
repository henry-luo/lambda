{
  "name":"Photos retained transform and effect project roundtrip",
  "html":"test/demo/photos/photos.ls",
  "viewport":{"width":1280,"height":900},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"scroll_to","target":{"selector":".dock"},"y":1300},
    {"type":"type","target":{"selector":"#image-width"},"text":"64","clear":true},
    {"type":"type","target":{"selector":"#image-height"},"text":"48","clear":true},
    {"type":"click","target":{"selector":"#resize-canvas"}},
    {"type":"click","target":{"selector":"#add-layer"}},
    {"type":"type","target":{"selector":"#foreground"},"text":"#ff0000","clear":true},
    {"type":"click","target":{"selector":"#fill-color"}},
    {"type":"assert_pixel","target":{"selector":"#preview"},"offset_x":300,"offset_y":300,"color":"#ff0000","tolerance":1},
    {"type":"click","target":{"selector":"#mono"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-effects","equals":"1"},
    {"type":"assert_pixel","target":{"selector":"#preview"},"offset_x":300,"offset_y":300,"color":"#4c4c4c","tolerance":1},
    {"type":"click","target":{"selector":"#effect-toggle"}},
    {"type":"assert_pixel","target":{"selector":"#preview"},"offset_x":300,"offset_y":300,"color":"#ff0000","tolerance":1},
    {"type":"click","target":{"selector":"#effect-toggle"}},
    {"type":"type","target":{"selector":"#transform-angle"},"text":"90","clear":true},
    {"type":"click","target":{"selector":"#transform-apply"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-transform","equals":"active"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-transform","equals":"none"},
    {"type":"click","target":{"selector":"#redo"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-transform","equals":"active"},
    {"type":"click","target":{"selector":"#save"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/composite.photos","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-dirty","equals":"false"},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"click","target":{"selector":"#open"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/composite.photos","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-transform","equals":"active"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-effects","equals":"1"},
    {"type":"assert_pixel","target":{"selector":"#preview"},"offset_x":300,"offset_y":300,"color":"#4c4c4c","tolerance":1},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"render","file":"temp/photos/composite.png"}
  ]
}
