{
  "name":"Photos paint, selection mask, erase, undo and layered persistence",
  "html":"test/demo/photos/photos.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"click","target":{"selector":"#add-layer"}},
    {"type":"type","target":{"selector":"#foreground"},"text":"#ff0000","clear":true},
    {"type":"click","target":{"selector":"#tool-brush"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-tool","equals":"brush"},
    {"type":"pointer_drag","pointerType":"mouse","target":{"selector":"#preview","offset_x":120,"offset_y":120},"dx":60,"dy":0,"steps":5},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-history","equals":"2"},
    {"type":"assert_pixel","target":{"selector":"#preview","offset_x":145,"offset_y":120},"min_r":254,"max_g":1,"max_b":1},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-history","equals":"1"},
    {"type":"key_combo","key":"z","mods_str":"ctrl,shift"},
    {"type":"assert_pixel","target":{"selector":"#preview","offset_x":145,"offset_y":120},"min_r":254,"max_g":1,"max_b":1},
    {"type":"click","target":{"selector":"#tool-rectangle"}},
    {"type":"pointer_drag","pointerType":"mouse","target":{"selector":"#preview","offset_x":125,"offset_y":100},"dx":30,"dy":40,"steps":3},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-selection","equals":"active"},
    {"type":"scroll_to","target":{"selector":".dock"},"y":620},
    {"type":"click","target":{"selector":"#selection-mask"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-target","equals":"mask"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-selection","equals":"none"},
    {"type":"click","target":{"selector":"#tool-erase"}},
    {"type":"pointer_drag","pointerType":"touch","target":{"selector":"#preview","offset_x":140,"offset_y":120},"dx":10,"dy":0,"steps":2},
    {"type":"assert_pixel","target":{"selector":"#preview","offset_x":145,"offset_y":120},"min_g":10},
    {"type":"key_combo","key":"z","mods_str":"ctrl"},
    {"type":"assert_pixel","target":{"selector":"#preview","offset_x":145,"offset_y":120},"min_r":254,"max_g":1,"max_b":1},
    {"type":"click","target":{"selector":"#save"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/paint.psd","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-dirty","equals":"false"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"click","target":{"selector":"#open"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/paint.psd","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"2"},
    {"type":"assert_pixel","target":{"selector":"#preview","offset_x":145,"offset_y":120},"min_r":254,"max_g":1,"max_b":1},
    {"type":"render","file":"temp/photos/painting.png"}
  ]
}
