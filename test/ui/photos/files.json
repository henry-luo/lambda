{
  "name":"Photos three-image composition and protected document replacement",
  "html":"test/demo/photos/photos.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"click","target":{"selector":"#place"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"test/demo/photo/assets/mountains.jpg","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"2"},
    {"type":"click","target":{"selector":"#place"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"test/demo/photo/assets/coast.jpg","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"3"},
    {"type":"click","target":{"selector":"[data-layer='raster-1']"},"mods_str":"shift"},
    {"type":"click","target":{"selector":"#group"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"4"},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-dialog","equals":"discard"},
    {"type":"assert_focus","target":{"selector":"#discard-cancel"}},
    {"type":"click","target":{"selector":"#discard-cancel"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"4"},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"click","target":{"selector":"#discard-save"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/placed.psd","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"0"},
    {"type":"click","target":{"selector":"#open"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/placed.psd","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"4"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-dirty","equals":"false"}
  ]
}
