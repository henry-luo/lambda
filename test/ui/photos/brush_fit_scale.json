{
  "name":"Photos brush coordinates after a proportional fit resize",
  "html":"test/demo/photos/photos.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"click","target":{"selector":"#add-layer"}},
    {"type":"type","target":{"selector":"#image-width"},"text":"512","clear":true},
    {"type":"type","target":{"selector":"#image-height"},"text":"384","clear":true},
    {"type":"click","target":{"selector":"#resize-canvas"}},
    {"type":"assert_attribute","target":{"selector":"#preview"},"attribute":"width","equals":"512"},
    {"type":"assert_attribute","target":{"selector":"#preview"},"attribute":"height","equals":"384"},
    {"type":"type","target":{"selector":"#foreground"},"text":"#ff0000","clear":true},
    {"type":"click","target":{"selector":"#tool-brush"}},
    {"type":"pointer_drag","pointerType":"mouse","target":{"selector":"#preview","offset_x":120,"offset_y":120},"dx":60,"dy":0,"steps":3},
    {"type":"assert_pixel","target":{"selector":"#preview","offset_x":150,"offset_y":120},"min_r":254,"max_g":1,"max_b":1},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-history","equals":"3"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""}
  ]
}
