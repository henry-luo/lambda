{
  "name":"Photos layered raster editor and retained canvas",
  "html":"test/demo/photos/photos.ls",
  "viewport":{"width":1280,"height":820},
  "events":[
    {"type":"advance_time","ms":50},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"1"},
    {"type":"assert_rect","target":{"selector":"#preview"},"width":824,"height":548,"tolerance":2},
    {"type":"click","target":{"selector":"#add-layer"}},
    {"type":"click","target":{"selector":"#fill-white"}},
    {"type":"click","target":{"selector":"#add-mask"}},
    {"type":"click","target":{"selector":"[data-mask='raster-1']"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-target","equals":"mask"},
    {"type":"click","target":{"selector":"#clear"}},
    {"type":"click","target":{"selector":"#undo"}},
    {"type":"click","target":{"selector":"#redo"}},
    {"type":"click","target":{"selector":"#duplicate"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"3"},
    {"type":"click","target":{"selector":"[data-layer='raster-1']"},"mods_str":"shift"},
    {"type":"click","target":{"selector":"#group"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"4"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"click","target":{"selector":"#ungroup"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"3"},
    {"type":"click","target":{"selector":"#save"}},
    {"type":"assert_focus","target":{"selector":"#file-path"}},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-dirty","equals":"false"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"click","target":{"selector":"#new"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"0"},
    {"type":"click","target":{"selector":"#open"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/composition.photos","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"3"},
    {"type":"click","target":{"selector":"#export"}},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","equals":""},
    {"type":"click","target":{"selector":"#open"}},
    {"type":"type","target":{"selector":"#file-path"},"text":"temp/photos/missing.psd","clear":true},
    {"type":"click","target":{"selector":"#file-confirm"}},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-layers","equals":"3"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-dialog","equals":"open"},
    {"type":"assert_attribute","target":{"selector":"#photos"},"attribute":"data-error","not_equals":""},
    {"type":"key_press","key":"escape"},
    {"type":"assert_count","target":{"selector":"#preview"},"count":1},
    {"type":"render","file":"temp/photos/workspace.png"}
  ]
}
