{
  "name": "archive browser previews supported raster formats",
  "html": "temp/viewer-image-formats.zip",
  "prepare": [
    "python3",
    "-c",
    "import zipfile as z;f=z.ZipFile('temp/viewer-image-formats.zip','w');[f.write('test/input/image/sample.'+('tiff' if x=='tif' else x),'sample.'+x) for x in ('ico','bmp','tiff','tif','avif','webp')];f.close()"
  ],
  "viewport": {
    "width": 1100,
    "height": 900
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='/sample.ico'] .tree-label"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": "#image-preview img"
      },
      "count": 1
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#image-preview img"
      },
      "attribute": "src",
      "contains": "data:image/x-icon;base64,"
    },
    {
      "type": "assert_rect",
      "target": {
        "selector": "#image-preview img"
      },
      "width": 256,
      "height": 192,
      "tolerance": 1
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#image-preview img",
        "offset_x": 100,
        "offset_y": 50
      },
      "max_r": 110,
      "max_g": 125,
      "max_b": 160
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='/sample.bmp'] .tree-label"
