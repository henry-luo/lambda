{
  "name": "Bundled document pane retains DOCX across tabs and tree redraws",
  "html": "lmd/package/doc/doc_viewer.ls",
  "viewport": {"width": 1100, "height": 5000},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_docx .tree-label"}},
    {"type": "wait", "ms": 50},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_docx_minimal_docx .tree-label"}},
    {"type": "wait", "ms": 100},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "minimal.docx"},
    {"type": "assert_count", "target": {"selector": "#docx-preview .docx-document"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#docx-preview p"}, "equals": "Hello, DOCX!"},
    {"type": "click", "target": {"selector": ".tab-source"}},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "Hello, DOCX!</p>"},
    {"type": "click", "target": {"selector": ".root-toggle"}},
    {"type": "assert_count", "target": {"selector": ".tab-source.active"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#source-preview"}, "contains": "Hello, DOCX!</p>"},
    {"type": "click", "target": {"selector": ".tab-view"}},
    {"type": "assert_count", "target": {"selector": "#docx-preview .docx-document"}, "count": 1},
    {"type": "assert_text", "target": {"selector": "#docx-preview p"}, "equals": "Hello, DOCX!"}
  ]
}
