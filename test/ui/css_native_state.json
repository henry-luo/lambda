{
  "name": "Native state provider preserves live, detached and independent form state",
  "html": "test/ui/css_native_state.html",
  "viewport": {
    "width": 260,
    "height": 140
  },
  "events": [
    {
      "type": "set_device_scale",
      "scale": 1
    },
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-initial",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-detached",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-reinserted",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-other-owner",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-independent",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-repeated",
      "equals": "true"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#probe",
        "offset_x": 10,
        "offset_y": 10
      },
      "search_radius": 0,
      "min_r": 0,
      "max_r": 2,
      "min_g": 126,
      "max_g": 130,
      "min_b": 0,
      "max_b": 2
    },
    {
      "type": "set_device_scale",
      "scale": 2
    },
    {
      "type": "click",
      "target": {
        "selector": "#check"
      }
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-initial",
      "equals": "false"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-live",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-detached",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-reinserted",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-other-owner",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-independent",
      "equals": "true"
    },
    {
      "type": "assert_attribute",
      "target": {
        "selector": "#report"
      },
      "attribute": "data-repeated",
      "equals": "true"
    },
    {
      "type": "assert_pixel",
      "target": {
        "selector": "#probe",
        "offset_x": 10,
        "offset_y": 10
      },
      "search_radius": 0,
      "min_r": 0,
      "max_r": 2,
      "min_g": 126,
      "max_g": 130,
      "min_b": 0,
      "max_b": 2
    }
  ]
}
