{
  "name": "Sheet formula calls, lookups, conditional branches and recalculation",
  "html": "test/demo/sheet/sheet.ls",
  "viewport": {"width": 1440, "height": 900},
  "input_turn_ms": 0,
  "events": [
    {"type":"wait", "ms":100},
    {"type":"click", "target":{"selector":"#cell-B14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=IFERROR(VLOOKUP(42500,C5:E10,2,FALSE),0)", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-B14"}, "contains":"44000"},
    {"type":"click", "target":{"selector":"#cell-C14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=IF(C5>0,\"yes\",1/0)", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-C14"}, "contains":"yes"},
    {"type":"click", "target":{"selector":"#cell-C5"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"50000", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-B14"}, "contains":"0"},
    {"type":"assert_text", "target":{"selector":"#cell-C14"}, "contains":"yes"},
    {"type":"click", "target":{"selector":"#undo"}},
    {"type":"assert_text", "target":{"selector":"#cell-B14"}, "contains":"44000"},
    {"type":"click", "target":{"selector":"#cell-C14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=XLOOKUP(42500,C5:C10,D5:D10,\"missing\")", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-C14"}, "contains":"44000"},
    {"type":"click", "target":{"selector":"#cell-D14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=COUNTIF(A5:A10,\"*ing\")", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-D14"}, "contains":"2"},
    {"type":"click", "target":{"selector":"#cell-E14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=WORKDAY(DATE(2024,1,1),5)", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-E14"}, "contains":"45299"},
    {"type":"click", "target":{"selector":"#cell-F14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=CEILING.MATH(-5.5,2,1)", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-F14"}, "contains":"-6"},
    {"type":"click", "target":{"selector":"#cell-G14"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"=LET(x,OFFSET(C5,1,0),TEXT(x,\"0\"))", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-G14"}, "contains":"18200"},
    {"type":"click", "target":{"selector":"#cell-C6"}},
    {"type":"key_press", "key":"F2"},
    {"type":"type", "target":{"selector":"#cell-editor"}, "text":"20000", "clear":true},
    {"type":"key_press", "key":"Enter"},
    {"type":"assert_text", "target":{"selector":"#cell-G14"}, "contains":"20000"}
  ]
}
