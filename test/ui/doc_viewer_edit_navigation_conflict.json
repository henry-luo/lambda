{
  "name": "project editor navigation conflict",
  "html": "temp/view-pane-conflict",
  "prepare": [
    "python3",
    "-c",
    "from pathlib import Path;import shutil;p=Path('temp/view-pane-conflict');p.mkdir(parents=True,exist_ok=True);shutil.copyfile('test/fixtures/edit/property-tree.json',p/'first.json');shutil.copyfile('test/fixtures/edit/sample.json',p/'second.json')"
  ],
  "viewport": {
    "width": 1100,
    "height": 700
  },
  "events": [
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='/first.json'] .tree-label"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": ".tab-edit"
      }
    },
    {
      "type": "click",
      "target": {
        "selector": "textarea[aria-label='name']"
      }
    },
    {
      "type": "key_combo",
      "key": "a",
      "mods_str": "super"
    },
    {
      "type": "type",
      "text": "\"Edited\""
    },
    {
      "type": "write_file",
      "path": "temp/view-pane-conflict/first.json",
      "content": "{\"name\":\"external\"}\n"
    },
    {
      "type": "click",
      "target": {
        "selector": ".tree-entry[data-tree-path$='/second.json'] .tree-label"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-dialog-navigate"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-save"
      }
    },
    {
      "type": "assert_count",
      "target": {
        "selector": ".edit-dialog-changed"
      },
      "count": 1
    },
    {
      "type": "click",
      "target": {
        "selector": ".edit-dialog-overwrite"
      }
    },
    {
      "type": "assert_text",
      "target": {
        "selector": ".document-name"
      },
      "equals": "second.json"
    },
    {
      "type": "assert_file",
      "path": "temp/view-pane-conflict/first.json",
      "contains": "\"name\": \"Edited\""
    }
  ]
}
