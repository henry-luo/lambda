    {"type": "wait", "ms": 100},
    {"type": "assert_count", "target": {"selector": "#pdf-preview"}, "count": 1},
    {"type": "assert_count", "target": {"selector": "#pdf-preview .pdf-page"}, "min": 1},
    {"type": "assert_count", "target": {"selector": "#pdf-preview svg"}, "min": 1},
    {"type": "assert_count", "target": {"selector": "#pdf-preview text"}, "min": 1},
    {"type": "assert_text", "target": {"selector": ".document-name"}, "equals": "advanced_test.pdf"}
