{
  "name": "Styled XML in the document viewer scrolls under the mouse wheel",
  "html": "test/ui/doc_viewer.ls",
  "viewport": {"width": 1280, "height": 900},
  "events": [
    {"type": "click", "target": {"selector": ".tree-hit-__test .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input .tree-label"}},
    {"type": "click", "target": {"selector": ".tree-hit-__test_input_test_xml .tree-label"}},
    {"type": "assert_count", "target": {"selector": "#xml-preview"}, "count": 1},
    {"type": "mouse_move", "x": 700, "y": 450},
    {"type": "scroll", "x": 700, "y": 450, "dx": 0, "dy": -5},
    {"type": "render_pending"},
    {"type": "assert_state_store", "target": {"selector": "#xml-preview"}, "view_scroll_y": 250, "tolerance": 5}
  ]
}
