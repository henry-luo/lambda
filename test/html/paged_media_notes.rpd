<?xml version="1.0"?>
<r:page-document r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" r:line-stacking-strategy="max-height" xmlns:r="urn:lambda:radiant:page" style="margin:0; font-family:Arial; font-size:7.5pt; line-height:9pt; color:black; white-space:normal">
  <r:master-set r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">
    <r:page-master r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" name="sheet" style="size:150pt 75pt; margin:7.5pt"><r:region r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" role="body" name="main" style="overflow:hidden"/></r:page-master>
  </r:master-set>
  <r:page-sequence r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" master-reference="sheet" initial-page-number="4" force-page-count="no-force" format="i">
    <r:flow r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" region-name="main"><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Statement <r:note r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics"><r:note-call r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="color:red; font-size:6pt">[a]</r:note-call><r:note-body r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" id="note" style="color:blue"><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">[a] First note line</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Second note line</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Third note line</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Fourth note line</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Fifth note line</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Sixth note line</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Seventh note line</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Final note line: <r:folio r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics"/></div></r:note-body></r:note>.</div></r:flow>
  </r:page-sequence>
  <r:page-sequence r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" master-reference="sheet" initial-page-number="20" force-page-count="no-force">
    <r:flow r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" region-name="main"><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Following sequence. Note finishes on <r:folio-ref r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" ref-id="note" edge="last"/>.</div></r:flow>
  </r:page-sequence>
</r:page-document>
