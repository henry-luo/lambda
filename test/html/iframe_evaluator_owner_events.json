  "name": "parent links retain behavior after an iframe evaluator is replaced",
  "viewport": {"width": 1200, "height": 800},
  "events": [
    {"type": "assert_frame_url", "selector": "iframe", "contains": "sample1.html", "assert_timeout": 10000},
    {"type": "mouse_down", "x": 400, "y": 200},
    {"type": "mouse_up", "x": 400, "y": 200},
    {"type": "mouse_down", "x": 353, "y": 40},
    {"type": "mouse_up", "x": 353, "y": 40},
    {"type": "assert_frame_url", "selector": "iframe", "contains": "test.xml", "assert_timeout": 10000},
    {"type": "mouse_down", "x": 410, "y": 41},
    {"type": "mouse_up", "x": 410, "y": 41},
    {"type": "assert_frame_url", "selector": "iframe", "contains": "test.wiki", "assert_timeout": 10000},
    {"type": "mouse_down", "x": 146.94, "y": 41},
    {"type": "mouse_up", "x": 146.94, "y": 41},
    {"type": "assert_frame_url", "selector": "iframe", "contains": "comprehensive_test.md", "assert_timeout": 10000}
  ]
