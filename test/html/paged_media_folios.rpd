<?xml version="1.0"?>
<r:page-document r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" r:line-stacking-strategy="max-height" xmlns:r="urn:lambda:radiant:page" style="margin:0; font-family:Arial; font-size:7.5pt; line-height:9pt; color:black; white-space:normal">
  <r:master-set r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">
    <r:page-master r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" name="sheet" style="size:225pt 75pt; margin:7.5pt"><r:region r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" role="body" name="main" style="overflow:hidden"/></r:page-master>
  </r:master-set>
  <r:page-sequence r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" master-reference="sheet" initial-page-number="4" force-page-count="even" format="i">
    <r:flow r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" region-name="main"><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Page <r:folio r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics"/>. Chapter <r:folio-ref r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" ref-id="content" area="normal"/>–<r:folio-ref r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" ref-id="content" edge="last"/>. Including blank: <r:folio-ref r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" ref-id="chapter" edge="last"/>; normal: <r:folio-ref r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" ref-id="chapter" edge="last" area="normal"/>.</div></r:flow>
  </r:page-sequence>
  <r:page-sequence r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" id="chapter" master-reference="sheet" initial-page-number="12" force-page-count="even" format="(001)">
    <r:flow r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" region-name="main"><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" id="content"><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">Chapter begins: <r:folio r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics"/>.</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="break-before:page">Chapter continues: <r:folio r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics"/>.</div><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="break-before:page">Chapter ends: <r:folio r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics"/>.</div></div></r:flow>
  </r:page-sequence>
</r:page-document>
