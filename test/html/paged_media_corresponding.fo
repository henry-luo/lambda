<?xml version="1.0"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" font-family="Arial" font-size="7.5pt" line-height="9pt" orphans="1" widows="1" border-collapse="separate">
  <fo:layout-master-set><fo:simple-page-master master-name="sheet" page-width="150pt" page-height="120pt" margin="7.5pt"><fo:region-body overflow="visible"/></fo:simple-page-master></fo:layout-master-set>
  <fo:page-sequence master-reference="sheet" force-page-count="no-force"><fo:flow flow-name="xsl-region-body">
    <fo:table table-layout="fixed" width="100%"><fo:table-column column-width="30pt"/><fo:table-column/><fo:table-body><fo:table-row>
      <fo:table-cell><fo:block background-color="#ffdddd">Term</fo:block><fo:block background-color="#ffdddd">Second</fo:block></fo:table-cell>
      <fo:table-cell><fo:block>Lead</fo:block><fo:block border="6pt solid blue" border-width="4.5pt" border-top="0.75pt solid red" border-bottom="0.75pt solid red" border-left="0.75pt solid red" border-right="0.75pt solid red" border-before-width="1.5pt" border-top-width="0.75pt" border-start-width="1.5pt" border-left-width="0.75pt" border-after-color="red" border-end-color="blue" border-start-color="green" padding="9pt" padding-before="1.5pt" padding-after="1.5pt" padding-start="2.25pt" padding-left="1.5pt" padding-end="1.5pt">
        <fo:block linefeed-treatment="preserve" white-space-treatment="preserve" background-color="#ddffdd">A
B
C
D
E
F
G</fo:block>
        <fo:block padding-top="2.25pt" padding-bottom="2.25pt" background-color="#aaaaff"/>
        <fo:block linefeed-treatment="preserve" white-space-treatment="preserve" background-color="#dde0ff">H
I
J
K
L
M
N
O
P
Q
R
S
T
U
V
W
X
Y</fo:block>
      </fo:block><fo:block>Tail</fo:block></fo:table-cell>
    </fo:table-row></fo:table-body></fo:table>
  </fo:flow></fo:page-sequence>
</fo:root>
