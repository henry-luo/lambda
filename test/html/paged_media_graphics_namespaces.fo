<?xml version='1.0' encoding='utf-8'?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:s="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" font-family="Arial" font-size="7.5pt" line-height="9pt">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="sheet" page-width="180pt" page-height="135pt" margin="7.5pt">
      <fo:region-body />
    </fo:simple-page-master>
  </fo:layout-master-set>
  <fo:page-sequence master-reference="sheet" force-page-count="no-force">
    <fo:flow flow-name="xsl-region-body">
      <fo:block>
        <fo:external-graphic width="60pt" height="30pt" content-width="auto" content-height="auto" scaling="uniform" text-align="start" display-align="before" overflow="hidden" background-color="#e8f0ff" src="url('paged_media_graphics_namespaces.svg')" />
      </fo:block>
      <fo:block>
        <fo:external-graphic width="60pt" height="30pt" content-width="scale-to-fit" content-height="scale-to-fit" scaling="uniform" text-align="start" display-align="before" overflow="hidden" background-color="#e8ffe8" src="url('paged_media_graphics_namespaces.svg')" />
      </fo:block>
      <fo:block>
        <fo:external-graphic width="60pt" height="15pt" content-width="150%" content-height="auto" scaling="uniform" text-align="center" display-align="after" overflow="hidden" background-color="#fff0d0" src="url('paged_media_graphics_namespaces.svg')" />
      </fo:block>
    </fo:flow>
  </fo:page-sequence>
  <fo:page-sequence master-reference="sheet" force-page-count="no-force">
    <fo:flow flow-name="xsl-region-body">
      <fo:block>
        <fo:external-graphic width="30pt" height="15pt" content-width="200%" content-height="auto" scaling="uniform" text-align="start" display-align="center" overflow="hidden" background-color="#e8f0ff" src="url('paged_media_graphics_namespaces.svg')" />
      </fo:block>
      <fo:block>
        <fo:external-graphic width="60pt" height="30pt" content-width="200%" content-height="auto" scaling="uniform" text-align="center" display-align="after" overflow="visible" background-color="#e8ffe8" src="url('paged_media_graphics_namespaces.svg')" />
      </fo:block>
      <fo:block>
        <fo:external-graphic width="60pt" height="15pt" content-width="60pt" content-height="15pt" scaling="non-uniform" text-align="end" display-align="after" overflow="hidden" background-color="#fff0d0" src="url('paged_media_graphics_namespaces.svg')" />
      </fo:block>
    </fo:flow>
  </fo:page-sequence>
  <fo:page-sequence master-reference="sheet" force-page-count="no-force">
    <fo:flow flow-name="xsl-region-body">
      <fo:block>
        <fo:instream-foreign-object width="60pt" height="30pt" content-width="50%" content-height="200%" scaling="non-uniform" text-align="center" display-align="center" overflow="hidden" background-color="#e8f0ff">
          <s:svg width="30pt" height="15pt" viewBox="0 0 40 20" preserveAspectRatio="none">
            <s:style>.shape { fill:#d04020 }</s:style><s:defs><s:rect id="shape" class="shape" width="40" height="20" fill="#d04020" /></s:defs><s:use xlink:href="#shape" />
          </s:svg>
        </fo:instream-foreign-object>
      </fo:block>
      <fo:block>
        <fo:instream-foreign-object width="60pt" height="30pt" content-width="scale-down-to-fit" content-height="auto" scaling="uniform" text-align="end" display-align="after" overflow="hidden" background-color="#e8ffe8">
          <s:svg width="30pt" height="15pt" viewBox="0 0 40 20" preserveAspectRatio="none">
            <s:style>.shape { fill:#d04020 }</s:style><s:defs><s:rect id="shape" class="shape" width="40" height="20" fill="#d04020" /></s:defs><s:use xlink:href="#shape" />
          </s:svg>
        </fo:instream-foreign-object>
      </fo:block>
      <fo:block>
        <fo:instream-foreign-object width="60pt" height="15pt" content-width="scale-up-to-fit" content-height="auto" scaling="uniform" text-align="start" display-align="before" overflow="hidden" background-color="#fff0d0">
          <s:svg width="30pt" height="15pt" viewBox="0 0 40 20" preserveAspectRatio="none">
            <s:style>.shape { fill:#d04020 }</s:style><s:defs><s:rect id="shape" class="shape" width="40" height="20" fill="#d04020" /></s:defs><s:use xlink:href="#shape" />
          </s:svg>
        </fo:instream-foreign-object>
      </fo:block>
    </fo:flow>
  </fo:page-sequence>
</fo:root>