<?xml version="1.0"?>
<r:page-document xmlns:r="urn:lambda:radiant:page" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" r:line-stacking-strategy="max-height" r:linefeed-treatment="preserve" r:white-space-treatment="preserve" r:white-space-collapse="true" r:wrap-option="wrap" style="margin:0;font-family:Arial;font-size:10px;line-height:20px;color:black;orphans:1;widows:1">
  <r:master-set><r:page-master name="sheet" style="size:180pt 75pt;margin:7.5pt"><r:region role="body" name="xsl-region-body" style="overflow:hidden;column-count:2;column-gap:20px"/></r:page-master></r:master-set>
  <r:page-sequence master-reference="sheet" force-page-count="no-force"><r:flow region-name="xsl-region-body">
    <div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="background-color:#eeeeff">Lead
Lead</div>
    <div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="break-before:page;background-color:#ddffdd"><div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics">A
B
C
D
E
F
G</div></div>
    <div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="break-before:page;background-color:#ffe0cc">Tail
Tail</div>
  </r:flow></r:page-sequence>
</r:page-document>
