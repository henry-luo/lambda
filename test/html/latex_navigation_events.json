{
  "name": "latex iframe navigation accepts another parent link without scrolling",
  "viewport": {"width": 1200, "height": 800},
  "events": [
    {"type": "click", "target": {"selector": "a[href$='.tex']"}},
    {"type": "assert_frame_url", "selector": "iframe", "contains": "latex_navigation.tex", "assert_timeout": 10000},
    {"type": "mouse_down", "x": 192, "y": 24},
    {"type": "mouse_up", "x": 192, "y": 24},
    {"type": "assert_frame_url", "selector": "iframe", "contains": "comprehensive_test.md", "assert_timeout": 10000}
  ]
}
