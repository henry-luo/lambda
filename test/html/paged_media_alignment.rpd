              <div r:block-inline-geometry="reference" r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="background-color:#cce0ff;">A</div>
            </td>
            <td r:text-altitude="use-font-metrics" r:text-depth="use-font-metrics" style="padding:0; vertical-align:top;padding-top:6pt;" r:cell-alignment="relative-before">
