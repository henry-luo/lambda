{
  "schema_version": 1,
  "description": "S4.1.2/S6.1.2v2: finite signed int parity uses one low-bit test after the shared int53 band guard. The sentinel miss retains the shared remainder helper; the native parameter is copied without boxing.",
  "checks": [
    {
      "in_func": "mvp_#_tune26_is_even",
      "expect_seq": [
        "mov\t{{r:param}}, arg0",
        "mov\t{{r:value}}, {{r:param}}",
        "add\t{{r:band}}, {{r:value}}, 9007199254740991",
        "ubgt\t{{l:miss}}, {{r:band}}, 18014398509481982",
        "and\t{{r:result}}, {{r:value}}, 1",
        "{{l:miss}}:",
        "call\t{{p}}, lambda_int_lane_divmod_slow,",
        "eq\t{{r}}, {{r:result}}, 0"
      ],
      "count": {
        "call\t{{p}}, lambda_int_lane_divmod_slow,": 1
      }
    }
  ]
}
