{
  "schema_version": 1,
  "description": "D4.3.3/D6.3.3: MVP resolves immutable primitive certificates at compilation, so constructors pass them directly with no runtime resolver. Each source fill has one fast primitive constructor and an exact-count checked miss; loop metadata stays outside runtime allocation.",
  "checks": [
    {
      "in_func": "mvp_#_repeated",
      "expect_seq": [
        {
          "pattern": "ubgt\tL{{n}}, {{r}}, 9007199254740991"
        },
        {
          "pattern": "call\t{{p}}, lambda_fill_primitive_bits,"
        },
        {
          "pattern": "call\t{{p}}, lambda_fill_for_contract_int_lane_resolved,"
        }
      ],
      "count": {
        "call\t{{p}}, lambda_fill_primitive_bits,": 3,
        "call\t{{p}}, lambda_fill_for_contract_int_lane_resolved,": 3
      },
      "forbid": [
        "call\t{{p}}, lambda_array_rep_cert_resolve,",
        "call\t{{p}}, lambda_fill_for_contract_int_lane,"
      ]
    },
    {
      "in_func": "mvp_#_looped",
      "expect_seq": [
        {
          "pattern": "ubgt\tL{{n}}, {{r}}, 9007199254740991"
        },
        {
          "pattern": "call\t{{p}}, lambda_fill_primitive_bits,"
        },
        {
          "pattern": "call\t{{p}}, lambda_fill_for_contract_int_lane_resolved,"
        }
      ],
      "count": {
        "call\t{{p}}, lambda_fill_primitive_bits,": 3,
        "call\t{{p}}, lambda_fill_for_contract_int_lane_resolved,": 2
      },
      "forbid": [
        "call\t{{p}}, lambda_array_rep_cert_resolve,",
        "call\t{{p}}, lambda_fill_for_contract_int_lane,"
      ]
    },
    {
      "in_func": "mvp_#_other_lanes",
      "expect_seq": [
        {
          "pattern": "ubgt\tL{{n}}, {{r}}, 9007199254740991"
        },
        {
          "pattern": "call\t{{p}}, lambda_fill_primitive_bits,"
        },
        {
          "pattern": "call\t{{p}}, lambda_fill_for_contract_int_lane_resolved,"
        }
      ],
      "count": {
        "call\t{{p}}, lambda_fill_primitive_bits,": 2,
        "call\t{{p}}, lambda_fill_for_contract_int_lane_resolved,": 2
