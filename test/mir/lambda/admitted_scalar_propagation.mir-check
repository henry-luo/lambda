{
  "schema_version": 1,
  "description": "S7.6.3v3/S7.7.2v2/D6.2.1: MVP uses native floating success lanes where planned, inline Item float bits for observed outcomes and captures, and a checked cold path for indexed integers.",
  "checks": [
    {
      "in_func": "mvp_#_checked_float",
      "expect": [
        "func\ti64, p:runtime",
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    },
    {
      "in_func": "mvp_#_accumulate",
      "expect": [
        "func\ti64, p:runtime"
      ],
      "forbid": [
        "call\t{{p}}, push_d,",
        "call\tlambda_report_boundary_failure_p"
      ]
    },
    {
      "in_func": "mvp_#_read_int",
      "expect": [
        "mov\t{{r}}, i64:({{r}})"
      ],
      "forbid": [
        "call\t{{p}}, int2it_lane,"
      ],
      "in_range": {
        "from": "func\t",
        "to": "call\t{{p}}, fn_index,"
      }
    },
    {
      "in_func": "mvp_#_preserved_union",
      "forbid": [
        "call\t{{p}}, push_d,"
      ],
      "expect_any": [
        "func\td, i64, p:runtime",
        "func\td, p:runtime"
      ]
    },
    {
      "in_func": "mvp_#_inner",
      "expect": [
        "func\ti64, p:runtime"
      ],
      "forbid": [
        "func\td, i64, p:runtime"
      ]
    },
    {
      "in_func": "mvp_#_nullable",
      "forbid": [
        "call\t{{p}}, push_d,"
      ],
      "expect_any": [
        "func\td, i64, p:runtime",
        "func\td, p:runtime"
      ]
    }
  ]
}
