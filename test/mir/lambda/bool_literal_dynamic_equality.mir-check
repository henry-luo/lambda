{
  "schema_version": 1,
  "description": "S5.1.1v2\u2013S5.1.2v2: guarded bool operands compare native bits; the generic literal arm tests Error before comparing Items. Dynamic pairs retain the canonical equality helper.",
  "checks": [
    {
      "in_func": "mvp_#_equals_true",
      "forbid": [
        "fn_eq"
      ],
      "expect_seq": [
        {
          "pattern": "ursh\t{{r:tag}}, {{r:value}}, 56"
        },
        {
          "pattern": "eq\t{{r}}, {{r:tag}}, 3"
        },
        {
          "pattern": "and\t{{r}}, {{r:value}}, 1"
        },
        {
          "pattern": "beq\tL{{n}}, {{r:error_tag}}, 27"
        },
        {
          "pattern": "\teq\t{{r}}, {{r}}, {{r}}"
        }
      ]
    },
    {
      "in_func": "mvp_#_differs_false",
      "forbid": [
        "fn_ne"
      ],
      "expect_seq": [
        {
          "pattern": "ursh\t{{r:tag}}, {{r:value}}, 56"
        },
        {
          "pattern": "eq\t{{r}}, {{r:tag}}, 3"
        },
        {
          "pattern": "and\t{{r}}, {{r:value}}, 1"
        },
        {
          "pattern": "beq\tL{{n}}, {{r:error_tag}}, 27"
        },
        {
          "pattern": "\tne\t{{r}}, {{r}}, {{r}}"
        }
      ]
    },
    {
      "in_func": "mvp_#_both_dynamic",
      "expect": [
        "call\t{{p}}, fn_eq_value,"
      ]
    }
  ]
}
