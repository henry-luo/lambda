{
  "schema_version": 1,
  "description": "D4.2.5/D6.2.1: MVP returns owned record pointers rather than Full aggregate-result pseudo-locals. Exact records allocate once and fill native slots; extra fields retain descriptor fill and return admission.",
  "checks": [
    {
      "in_func": "mvp_#_extra",
      "expect": [
        "call\t{{p}}, map_alloc_for_type,",
        "call\t{{p}}, lambda_type_check_lazy,"
      ],
      "count": {
        "call\t{{p}}, set_field_value,": 2
      }
    },
    {
      "in_func": "mvp_#_floating",
      "expect": [
        "call\t{{p}}, map_alloc_for_type,"
      ],
      "forbid": [
        "call\t{{p}}, map_fill,"
      ],
      "count": {
        "call\t{{p}}, map_alloc_for_type,": 1
      }
    },
    {
      "in_func": "mvp_#_local",
      "expect": [
        "call\t{{p}}, map_alloc_for_type,"
      ],
      "forbid": [
        "call\t{{p}}, map_fill,"
      ],
      "count": {
        "call\t{{p}}, map_alloc_for_type,": 1
      }
    },
    {
      "in_func": "mvp_#_empty_args",
      "expect": [
        "call\t{{p}}, map_alloc_for_type,"
      ],
      "forbid": [
        "call\t{{p}}, map_fill,"
      ],
      "count": {
        "call\t{{p}}, map_alloc_for_type,": 1
      }
    }
  ]
}
