{
  "schema_version": 1,
  "description": "D2.3.4\u2013D2.3.5: MVP unsigned entry bounds reject negative/large countdowns, then use a four-way native accumulator and scalar tail. The checked sibling remains outside the proven region.",
  "checks": [
    {
      "in_func": "mvp_#_tune26_descending_sum",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:n}}, arg0"
        },
        {
          "pattern": "ubgt\tL{{n}}, {{r:n}}, 100000000"
        },
        {
          "pattern": "add\t{{r:sum}}, {{r:sum}}, {{r:n}}"
        },
        {
          "pattern": "sub\t{{r:n}}, {{r:n}}, 4"
        },
        {
          "pattern": "bge\tL{{n}}, {{r:n}}, 3"
        }
      ],
      "in_range": {
        "from": "func\t",
        "to": "call\t{{p}}, lambda_int_lane_add_slow,"
      },
      "forbid": [
        "call\t{{p}}, fn_add,",
        "call\t{{p}}, fn_sub,",
        "call\t{{p}}, int2it_lane,"
      ]
    }
  ]
}
