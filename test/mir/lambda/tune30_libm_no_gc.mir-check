{
  "schema_version": 1,
  "description": "Tune30 T30-3: `math.sqrt`/`math.sin` reach the libm leaves by native pointer, on the float lane, with no boxed helper. The other half of the track -- that such a call is NOT an allocation point, so the caller neither spills its roots before it nor reloads its container layouts after it -- is an ABSENCE between two instructions, which this DSL cannot express; the size probe `lambda_tune30_libm_no_gc` in mir_budgets.json states it instead (`_tune30_norms_#` at 213; removing `sqrt` from JIT_LIBM_LEAVES gives 222).",
  "checks": [
    {
      "in_func": "mvp_#_tune30_norms",
      "expect": [
        "call\t{{p}}, sqrt, {{r}}, {{r}}",
        "call\t{{p}}, sin, {{r}}, {{r}}",
        "dadd\t{{r}}, {{r}}, {{r}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_math_sqrt,",
        "call\t{{p}}, fn_math_sin,"
      ]
    }
  ]
}
