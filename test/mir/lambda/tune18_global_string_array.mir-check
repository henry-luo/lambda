{
  "schema_version": 1,
  "description": "Tune18 module-level string[] indexing uses a certificate-guarded direct pointer-lane load; a failed guard falls back to item_at rather than fn_index dispatch.",
  "checks": [
    {
      "in_func": "_main_#",
      "expect": [
        "mov\ti64:("
      ],
      "forbid": [
        "call\tfn_index_p, fn_index"
      ]
    }
  ]
}
