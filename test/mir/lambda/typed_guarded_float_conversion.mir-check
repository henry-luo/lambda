{
  "schema_version": 1,
  "description": "S4.5.3/S7.7.2v2: proven float conversion/division admits natively without a redundant validator; mixed nullable sums retain checked admission and native subtractions avoid boxed float conversion.",
  "checks": [
    {
      "in_func": "mvp_#_typed",
      "expect": [
        "ddiv\t",
        "call\t{{p}}, fn_float,",
        "i2d\t",
        "call\t{{p}}, lambda_int_lane_to_double_c,"
      ],
      "count": {
        "call\t{{p}}, lambda_type_check_lazy,": 0
      }
    },
    {
      "in_func": "mvp_#_mixed_decl",
      "expect": [
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    },
    {
      "in_func": "mvp_#_scalar_conversion",
      "expect": [
        "dsub\t"
      ],
      "forbid": [
        "call\t{{p}}, fn_float,"
      ]
    }
  ]
}
