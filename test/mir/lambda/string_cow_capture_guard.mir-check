{
  "schema_version": 1,
  "description": "S9.1.2/S9.3.1: MVP inline kind/flag guards bypass string sharing and mark container observations. Dynamic captures retain native marks and COW push publication.",
  "checks": [
    {
      "in_func": "mvp_#_capture_string",
      "expect": [
        "call\t{{p}}, pn_push_cow,"
      ],
      "forbid": [
        "call\t{{p}}, cow_bind_var,",
        "call\t{{p}}, cow_capture_value,"
      ]
    },
    {
      "in_func": "mvp_#_capture_dynamic",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:flags}}, u8:4({{r:owner}})"
        },
        {
          "pattern": "or\t{{r:marked}}, {{r:flags}}, 1"
        },
        {
          "pattern": "mov\tu8:4({{r:owner}}), {{r:marked}}"
        }
      ],
      "expect": [
        "call\t{{p}}, pn_push_cow,",
        "call\t{{p}}, fn_index,"
      ],
      "forbid": [
        "call\t{{p}}, cow_bind_var,",
        "call\t{{p}}, cow_capture_value,"
      ]
    }
  ]
}
