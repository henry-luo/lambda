{
  "schema_version": 1,
  "description": "S11.4.1v3, S7.1.1v3, D6.2: the fixed-read direct result has one length guard per borrowed array, scalar arithmetic on the valid arm, and an ordinary call on the absent arm; an escaping result retains the call.",
  "checks": [
    {
      "in_func": "mvp_#_fixed_result",
      "expect": [
        "dadd",
        "dsub",
        "dmul"
      ],
      "count": {
        "blt": 2,
        "call\t{{p}}, fn_index,": 0
      },
      "forbid": [
        "call\t{{p}}, array_float_new,",
        "call\t{{p}}, array_num_new_uninit,",
        "call\t{{p}}, lambda_fill_primitive_bits,",
        "call\t{{p}}, array_num_new,"
      ]
    },
    {
      "in_func": "mvp_#_escaping_result",
      "expect": [
        "call\tmvp_{{n}}_vector_mix_dp"
      ]
    },
    {
      "in_func": "mvp_#_rebound_result",
      "expect": [
        "call\tmvp_{{n}}_vector_mix_dp",
        "call\t{{p}}, lambda_fill_primitive_bits,"
      ]
    }
  ]
}
