{
  "schema_version": 1,
  "description": "D4.2.5/D4.3.3/S9.3.1: admitted arrays populate declared record slots directly after their snapshot image; dynamic arrays retain one element admission. Each path allocates one record without vararg fill.",
  "checks": [
    {
      "in_func": "mvp_#_from_global",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\ti64:({{r:data}}), {{r}}"
        }
      ],
      "expect": [
        "call\t{{p}}, map_alloc_for_type,",
        "call\t{{p}}, slot_image,"
      ],
      "count": {
        "call\t{{p}}, lambda_type_check_lazy,": 0,
        "call\t{{p}}, map_alloc_for_type,": 1
      },
      "forbid": [
        "call\t{{p}}, map_fill,"
      ]
    },
    {
      "in_func": "mvp_#_from_param",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\ti64:({{r:data}}), {{r}}"
        }
      ],
      "expect": [
        "call\t{{p}}, map_alloc_for_type,",
        "call\t{{p}}, slot_image,"
      ],
      "count": {
        "call\t{{p}}, lambda_type_check_lazy,": 0,
        "call\t{{p}}, map_alloc_for_type,": 1
      },
      "forbid": [
        "call\t{{p}}, map_fill,"
      ]
    },
    {
      "in_func": "mvp_#_from_dynamic",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\ti64:({{r:data}}), {{r}}"
        }
      ],
      "expect": [
        "call\t{{p}}, map_alloc_for_type,",
        "call\t{{p}}, slot_image,"
      ],
      "count": {
        "call\t{{p}}, lambda_type_check_lazy,": 1,
        "call\t{{p}}, map_alloc_for_type,": 1
      },
      "forbid": [
        "call\t{{p}}, map_fill,"
      ]
    }
  ]
}
