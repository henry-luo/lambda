{
  "schema_version": 1,
  "description": "The caller now saves a number base twice: `twice`'s `int` parameter uses the v5 i64 lane, so the int64 argument stays native at the callsite. Caller-donated scalar home: the deferred int64 argument is boxed and adopted before its number watermark is restored, then enters the boxed companion required by the inferred exact-shape plan (Stack API #15/#16/#19/#21).",
  "checks": [
    {
      "in_func": "_twice_#",
      "expect": [
        ":\tfunc\ti64, p:runtime, i64:_a, p:_scalar_home"
      ]
    },
    {
      "in_func": "main",
      "expect_seq": [
        { "pattern": "mov\tcall_number_base_" },
        { "pattern": "call\tbox_int64_result_or_error_p" },
        { "pattern": "lambda_item_adopt_scalar_home" },
        { "pattern": ", call_number_base_" }
      ],
      "count": {
        "call\tbox_int64_result_or_error_p": 1,
        "mov\tcall_number_base_": 2
      },
      "expect": [
        ", scalar_home_",
        "call\t_twice_b_"
      ]
    }
  ]
}
