{
  "schema_version": 1,
  "description": "The caller saves a number base twice: `twice`'s `int` parameter uses the v5 i64 lane, so its i64() argument remains a boxed Item until the wrapper's error boundary has accepted it. Return convention 3 (RV1 shape 2): the body carries no caller-home parameter and returns two lanes instead. Its public `_b` wrapper uses the RV12 context slot, so its direct caller must also carry no trailing home; the MT7 frame budget pins that physical ABI. The group pins the direct Item result and wrapper call, and forbids the retired sentinel boxer.",
  "checks": [
    {
      "in_func": "_twice_#",
      "return_convention": 3,
      "expect_any": [
        ":\tfunc\ti64, i64, p:runtime, i64:%p1",
        ":\tfunc\ti64, p:runtime, i64:%p1"
      ],
      "forbid": [
        "_scalar_home",
        "lambda_item_adopt_scalar_home"
      ]
    },
    {
      "in_func": "main",
      "expect_seq": [
        {
          "pattern": "call\tfn_int64_p"
        },
        {
          "pattern": "call\t_twice_b_"
        }
      ],
      "count": {
        "call\tfn_int64_p": 1
      },
      "expect": [
        "call\t_twice_b_"
      ],
      "forbid": [
        "lambda_item_adopt_scalar_home",
        "box_int64_result_or_error"
      ]
    },
    {
      "in_func": "main",
      "return_convention": 3,
      "expect": [
        "call\t_twice_b_"
      ],
      "forbid": [
        "lambda_item_adopt_scalar_home"
      ]
    }
  ]
}
