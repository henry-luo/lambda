      "expect_seq": [
        "call\tfn_index_p, fn_index, {{r:raw}},",
        "mov\t{{r:item}}, {{r:raw}}",
        "ursh\t{{r:tag}}, {{r:item}}, 56",
        "eq\t{{r}}, {{r:tag}}, 27",
        "call\t_sum_codes_"
      ],
      "forbid": [
        "call\tlambda_type_check_p, lambda_type_check"
      ]
    }
  ]
}
