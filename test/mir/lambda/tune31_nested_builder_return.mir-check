{
  "schema_version": 1,
  "description": "D4.3.1/D4.3.3/S9.2.2: exact homogeneous appends use private packed construction and checked append, without adding a source annotation. Native consumer reads jump over their generic miss kernel; unknown and absent inputs retain that kernel.",
  "checks": [
    {
      "in_func": "mvp_#_sum_codes",
      "expect_seq": [
        "mov\t{{r}}, i64:({{r}})",
        "jmp\t{{l:read_done}}",
        "call\t{{p}}, fn_index,",
        "{{l:read_done}}:",
        "add\t{{r}}, {{r}}, {{r}}"
      ],
      "count": {
        "call\t{{p}}, fn_index,": 1
      }
    },
    {
      "in_func": "mvp_#_main",
      "expect_seq": [
        "call\t{{p}}, fn_index, {{r:raw}},",
        "mov\t{{r:item}}, {{r:raw}}",
        "ursh\t{{r:tag}}, {{r:item}}, 56",
        "bne\t{{l:accepted}}, {{r:tag}}, 27",
        "{{l:accepted}}:",
        "call\tmvp_{{n}}_sum_codes_dp"
      ],
      "forbid": [
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    }
  ]
}
