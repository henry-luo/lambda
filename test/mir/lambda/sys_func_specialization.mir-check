{
  "schema_version": 1,
  "description": "Native MIR math preserves the full numeric domain: integer abs uses guarded negation; float transcendental calls use libm (S7.10.5v3, D2.2.2). Legacy boxed/native C-text specializations remain forbidden.",
  "checks": [
    {
      "in_func": "*",
      "expect": [
        "import\tfn_pow",
        "neg\t",
        "import\tsin",
        "import\tsqrt"
      ],
      "forbid": [
        "import\tfn_math_sin",
        "import\tfn_math_sqrt",
        "import\tfn_pow_u",
        "import\tfn_abs_i",
        "import\tfn_min2_u",
        "import\tfn_max2_u",
        "import\tfn_sign_i",
        "import\tfn_sign_f",
        "call\tfn_abs_p, fn_abs"
      ]
    }
  ]
}
