{
  "schema_version": 1,
  "description": "Procedural tail recursion becomes a counter-guarded loop, exactly as the functional form does: no self-call remains in the procedure body. Internal register spelling is deliberately opaque.",
  "checks": [
    {
      "in_func": "_countdown_#",
      "forbid": [
        "call\t_countdown_"
      ],
      "expect": [
        "add\t{{r}}, {{r}}, 1",
        "ble\t"
      ]
    }
  ]
}
