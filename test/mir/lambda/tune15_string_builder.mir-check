{
  "schema_version": 1,
  "description": "Tune15 B4: exclusive loop-carried string concatenation uses the builder path and freezes on read. T20-2 (2026-08-26): a statically-typed string operand no longer routes through fn_string -- that call is a CONVERSION, and converting a string to a string only unwrapped the Item while forcing the emitter to treat it as a safepoint. fn_string is now forbidden here to pin that; it remains correct and expected for non-string operands (see tune20_concat_operand_conversion).",
  "checks": [
    {
      "in_func": "_main_#",
      "expect": [
        "call\tfn_strcat_p, fn_strcat",
        "call\tfn_string_freeze_p, fn_string_freeze"
      ],
      "forbid": [
        "call\tfn_join_p, fn_join",
        "call\tfn_string_p, fn_string"
      ]
    }
  ]
}
