{
  "schema_version": 1,
  "description": "Action C dynamic-call boundary resolves the pending argument before fn_call1_into.",
  "checks": [
    {
      "return_convention": 3,
      "in_func": "mvp_#_pending_item",
      "expect": [
        "ret\t"
      ],
      "expect_any": [
        "func\ti64, i64, p:runtime, i64:arg0",
        "func\ti64, p:runtime, i64:arg0"
      ],
      "forbid": [
        "lambda_item_resolve_pending"
      ]
    },
    {
      "in_func": "mvp_#_apply_fn",
      "expect": [
        "call\t{{p}}, fn_call_into,",
        "call\t{{p}}, array_push_verbatim,"
      ]
    },
    {
      "in_func": "main",
      "expect": [
        "lambda_item_resolve_pending"
      ]
    }
  ]
}
