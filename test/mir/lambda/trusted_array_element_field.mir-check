{
  "schema_version": 1,
  "description": "D4.2.5/D4.3.3/S7.1.1v3: admitted array reads guard the carrier/index then decode the declared record slot; each read retains one index miss and one member miss per expanded source access.",
  "checks": [
    {
      "in_func": "mvp_#_read_value",
      "expect": [
        "mov\t{{r}}, i64:({{r}})",
        "p:16("
      ],
      "count": {
        "call\t{{p}}, fn_index,": 1,
        "call\t{{p}}, fn_member,": 1
      }
    },
    {
      "in_func": "mvp_#_read_flag",
      "expect": [
        "mov\t{{r}}, u8:8({{r}})",
        "p:16("
      ],
      "count": {
        "call\t{{p}}, fn_index,": 1,
        "call\t{{p}}, fn_member,": 1
      }
    },
    {
      "in_func": "mvp_#_read_nested",
      "expect": [
        "mov\t{{r}}, i64:({{r}})",
        "p:16("
      ],
      "count": {
        "call\t{{p}}, fn_index,": 1,
        "call\t{{p}}, fn_member,": 2
      }
    },
    {
      "in_func": "mvp_#_read_text",
      "expect": [
        "call\t{{p}}, fn_member,",
        "p:16("
      ],
      "count": {
        "call\t{{p}}, fn_index,": 1,
        "call\t{{p}}, fn_member,": 1
      }
    }
  ]
}
