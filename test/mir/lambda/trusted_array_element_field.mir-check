{
  "schema_version": 1,
  "description": "D3.3.3v3/S7.1.1v3: scalar fields of an admitted record-array element use the direct nullable receiver path, while a string field retains null-preserving generic access.",
  "checks": [
    {
      "in_func": "_read_value_#",
      "expect": ["mov\t{{r}}, i64:({{r}})"],
      "forbid": ["call\tfn_member_by_id_p, fn_member_by_id"]
    },
    {
      "in_func": "_read_flag_#",
      "expect": ["mov\t{{r}}, u8:8({{r}})"],
      "forbid": ["call\tfn_member_by_id_p, fn_member_by_id"]
    },
    {
      "in_func": "_read_nested_#",
      "expect": ["mov\t{{r}}, i64:({{r}})"],
      "forbid": ["call\tfn_member_by_id_p, fn_member_by_id"]
    },
    {
      "in_func": "_read_text_#",
      "expect": ["call\tfn_member_by_id_p, fn_member_by_id"]
    }
  ]
}
