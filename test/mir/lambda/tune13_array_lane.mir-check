{
  "schema_version": 1,
  "description": "Tune13 typed array stores retain native indexed arithmetic and type-preserving builtin results.",
  "checks": [
    {
      "in_func": "_tune13_store_#",
      "expect": [
        "call\tfn_array_set_p, fn_array_set",
        "mul\t{{r}}, {{r}}, 8"
      ]
    },
    {
      "in_func": "_tune13_builtin_#",
      "expect": [
        "call\tfn_abs_p, fn_abs",
        "call\tfn_min2_p, fn_min2",
        "call\tfn_array_set_p, fn_array_set"
      ]
    }
  ]
}
