{
  "schema_version": 1,
  "description": "S4.4.4 / D2.3.4–D2.3.5: raw u64 bitwise trees and nonnegative literal ushr counts retain their word carrier; dynamic, erased and nullable operands retain checked runtime fallbacks. A proven raw u64 return crosses its identity boundary without allocating a number home.",
  "checks": [
    {
      "in_func": "mvp_#_lane",
      "expect": [
        "xor\t%r",
        "or\t%r",
        "and\t%r"
      ],
      "forbid": [
        "call\t{{p}}, fn_bxor_item,",
        "call\t{{p}}, fn_band_item,",
        "call\t{{p}}, fn_bor_item,",
        "call\t{{p}}, it2u,"
      ],
      "count": {
        "call\t{{p}}, box_uint64_value,": 0
      }
    },
    {
      "in_func": "mvp_#_logical",
      "expect": [
        "ursh\t%r"
      ],
      "forbid": [
        "call\t{{p}}, fn_ushr_item,",
        "call\t{{p}}, it2u,"
      ],
      "count": {
        "call\t{{p}}, box_uint64_value,": 0
      }
    },
    {
      "in_func": "mvp_#_widths",
      "forbid": [
        "call\t{{p}}, fn_ushr_item,"
      ]
    },
    {
      "in_func": "mvp_#_dynamic_shift",
      "expect": [
        "call\t{{p}}, fn_ushr_item,"
      ]
    },
    {
      "in_func": "mvp_#_erased",
      "expect": [
        "call\t{{p}}, fn_bxor_item,"
      ]
    }
  ]
}
