{
  "schema_version": 1,
  "description": "D4.3.3/D2.3.4: deep local key chains retain native integer arithmetic and scaled packed reads with carrier-derived layout witnesses. The checked sibling keeps at most four index misses; there is no hidden Full witness operand.",
  "checks": [
    {
      "in_func": "mvp_#_count",
      "forbid": [
        "call\t{{p}}, fn_mul,",
        "call\t{{p}}, fn_add,"
      ],
      "expect_seq": [
        "i64:32(",
        "lsh\t{{r:offset}}, {{r}}, 3",
        "add\t{{r:address}}, {{r}}, {{r:offset}}",
        "mov\t{{r}}, i64:({{r:address}})"
      ],
      "expect": [
        "rsh\t",
        "mulo\t"
      ],
      "count": {
        "call\t{{p}}, fn_index,": {
          "max": 4
        }
      }
    }
  ]
}
