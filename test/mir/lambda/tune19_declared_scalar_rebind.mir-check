{
  "schema_version": 1,
  "description": "T19-A: rebinding a declared int from a lane-native int[] read stays on the raw lane -- the loop body computes the element address and loads it, and never boxes the lane to call lambda_type_check. Re-pinned 2026-09-13: the rebind boundary is now proven outright, so the old INT_LANE_NULL-compare-then-branch adjacency is gone (the read's bounds check subsumes it and the null arm is its own block) and no type check survives on the straight-line path at all. The group is scoped to the loop body, which is where a per-iteration boxed boundary would reappear. checked_rebind is the unproven twin and still crosses the boxed boundary.",
  "checks": [
    {
      "in_func": "_last_element_#",
      "expect_seq": [
        {
          "pattern": "\tlsh\t"
        },
        {
          "pattern": "\tadd\t"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r}})"
        }
      ],
      "in_range": {
        "from": "lt\t{{r}}, {{r}}, {{r}}",
        "to": "jmp\tL"
      },
      "forbid": [
        "lambda_type_check,"
      ]
    },
    {
      "in_func": "_checked_rebind_#",
      "expect": [
        "lambda_type_check,"
      ]
    }
  ]
}
