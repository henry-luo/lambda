{
  "schema_version": 1,
  "description": "S7.7.4v2/D4.3.3: a declared integer receives a native packed load in the proven region; the unknown-source twin still uses checked admission. MVP branches directly on the loop bound.",
  "checks": [
    {
      "in_func": "mvp_#_last_element",
      "expect_seq": [
        {
          "pattern": "lsh\t{{r:offset}}, {{r}}, 3"
        },
        {
          "pattern": "add\t{{r:address}}, {{r}}, {{r:offset}}"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r:address}})"
        }
      ],
      "in_range": {
        "from": "\tlsh\t",
        "to": "call\t{{p}}, fn_index,"
      },
      "forbid": [
        "lambda_type_check_lazy,"
      ]
    },
    {
      "in_func": "mvp_#_checked_rebind",
      "expect": [
        "lambda_type_check_lazy,"
      ]
    }
  ]
}
