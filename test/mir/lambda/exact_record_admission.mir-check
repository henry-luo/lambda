{
  "schema_version": 1,
  "description": "D4.2.5: exact and nullable record boundaries keep native pointer-typed packed reads; reordered dynamic input still reifies through admission. D4.2.5: an admitted read-only prefix has no reachable member fallback.",
  "checks": [
    {
      "in_func": "mvp_#_read_node",
      "forbid": [
        "call\t{{p}}, lambda_type_check_lazy,"
      ],
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r:data}})"
        }
      ],
      "count": {
        "call\t{{p}}, fn_member,": 0
      }
    },
    {
      "in_func": "main",
      "expect": [
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    }
  ]
}
