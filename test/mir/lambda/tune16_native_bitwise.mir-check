{
  "schema_version": 1,
  "description": "Tune16 C2 keeps proved integer band, bor, and bxor operations on native MIR lanes.",
  "checks": [
    {
      "in_func": "mvp_#_tune16_native_bitwise",
      "expect": [
        "and\t{{r}}",
        "xor\t{{r}}",
        "or\t{{r}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_band_item,",
        "call\t{{p}}, fn_bxor_item,",
        "call\t{{p}}, fn_bor_item,"
      ]
    }
  ]
}
