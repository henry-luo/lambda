{
  "schema_version": 1,
  "description": "D4.2.5: recursive declared records allocate their destination shape and fill native slots without generic fill or return validation. Two expanded recursive observations retain one checked member miss per source field.",
  "checks": [
    {
      "in_func": "mvp_#_build",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\ti64:({{r:data}}), {{r}}"
        }
      ],
      "expect": [
        "call\t{{p}}, map_alloc_for_type,"
      ],
      "count": {
        "call\t{{p}}, map_alloc_for_type,": 1
      },
      "forbid": [
        "call\t{{p}}, map_fill,",
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    },
    {
      "in_func": "mvp_#_total",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r:data}})"
        }
      ],
      "count": {
        "call\t{{p}}, fn_member,": {
          "max": 4
        }
      },
      "expect": [
        "call\tmvp_{{n}}_total_dp"
      ]
    }
  ]
}
