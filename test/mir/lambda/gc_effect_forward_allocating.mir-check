{
  "schema_version": 1,
  "description": "D5.3.1-D5.3.2/S7.4.2v3: an allocating direct callee retains the live string and its boxed success/error join. The int^ return reuses the exact integer outcome proof, removing three admission-only root slots. The string is still saved before the allocating call and reloaded before the NO_GC length call.",
  "checks": [
    {
      "in_func": "_gc_order_alloc_caller_#",
      "expect": [
        "call\t_gc_order_alloc_leaf_",
        "call\tlambda_stack_is_exhausted",
        "call\tlambda_side_stack_ensure_for_p, lambda_side_stack_ensure_for, {{r}}, runtime, 2, 0"
      ],
      "expect_seq": [
        "mov\ti64:({{r}}), %p1",
        "call\t_gc_order_alloc_leaf_",
        "mov\t%p1, i64:({{r}})",
        "call\tfn_len_s_p, fn_len_s"
      ],
      "forbid": [
        "call\tlambda_type_check_lazy"
      ]
    }
  ]
}
