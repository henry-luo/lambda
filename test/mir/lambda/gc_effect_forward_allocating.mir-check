{
  "schema_version": 1,
  "description": "D5.3.1/D6.3.2\u2013D6.3.3: the allocating leaf inlines; its fill call publishes the live string before its stable register is used by the noncollecting length read.",
  "checks": [
    {
      "in_func": "mvp_#_gc_order_alloc_caller",
      "expect": [
        "call\t{{p}}, fn_fill,",
        "call\t{{p}}, lambda_stack_is_exhausted,",
        "call\t{{p}}, lambda_side_stack_ensure_for,"
      ],
      "expect_seq": [
        {
          "pattern": "mov\t{{r:text}}, arg0"
        },
        {
          "pattern": "mov\ti64:({{r:roots}}), {{r:text}}"
        },
        {
          "pattern": "call\t{{p}}, fn_fill,"
        },
        {
          "pattern": "mov\t{{r:arg}}, {{r:text}}"
        },
        {
          "pattern": "call\t{{p}}, fn_len_s, {{r}}, {{r:arg}}"
        }
      ],
      "forbid": [
        "call\tlambda_type_check_lazy"
      ]
    }
  ]
}
