{
  "schema_version": 1,
  "description": "S9.1.2\u2013S9.1.3v3/D5.4.4: MVP keeps rooted RMW handles for read-only/escaping calls; an intervening var mutation uses a snapshot and refreshes the checked place.",
  "checks": [
    {
      "in_func": "mvp_#_read_then_write",
      "expect": [
        "call\t{{p}}, cow_bind_rmw_root,",
        "call\t{{p}}, index_assign_cow,"
      ],
      "forbid": [
        "call\t{{p}}, cow_bind_var,"
      ]
    },
    {
      "in_func": "mvp_#_root_escapes",
      "expect_seq": [
        {
          "pattern": "call\t{{p}}, cow_bind_rmw_root,"
        },
        {
          "pattern": "mov\t{{r:flags}}, u8:4({{r:owner}})"
        },
        {
          "pattern": "or\t{{r:marked}}, {{r:flags}}, 1"
        },
        {
          "pattern": "mov\tu8:4({{r:owner}}), {{r:marked}}"
        },
        {
          "pattern": "call\t{{p}}, lambda_map_set_checked,"
        }
      ]
    },
    {
      "in_func": "mvp_#_root_to_var",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:flags}}, u8:4({{r:owner}})"
        },
        {
          "pattern": "or\t{{r:marked}}, {{r:flags}}, 1"
        },
        {
          "pattern": "mov\tu8:4({{r:owner}}), {{r:marked}}"
        }
      ],
      "expect": [
        "call\t{{p}}, lambda_map_path_set_checked_keys,",
        "call\t{{p}}, index_assign_cow,"
      ],
      "forbid": [
        "call\t{{p}}, cow_bind_rmw_root,"
      ]
    }
  ]
}
