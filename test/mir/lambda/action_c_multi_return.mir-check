{
  "schema_version": 1,
  "description": "Action C multi-return guard: a direct pending return resolves instead of poisoning the shared pair epilogue.",
  "checks": [
    {
      "return_convention": 3,
      "in_func": "mvp_#_pending_item",
      "expect": ["ret\t"],
      "expect_any": [
        "func\ti64, i64, p:runtime, i64:%p1",
        "func\ti64, p:runtime, i64:%p1"
      ],
      "forbid": [
        "lambda_item_resolve_pending"
      ]
    },
    {
      "return_convention": 3,
      "in_func": "mvp_#_maybe_pending",
      "expect": [
        "lambda_item_resolve_pending"
      ]
    }
  ]
}
