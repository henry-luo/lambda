{
  "schema_version": 1,
  "description": "D7.4.2/D6.2.1: MVP inlines the identity producer, owns its scalar payload, and returns the selected value through the companion transport. The public module entry resolves the pair.",
  "checks": [
    {
      "return_convention": 3,
      "in_func": "mvp_#_pending_item",
      "expect": [
        "ret\t"
      ],
      "expect_any": [
        "func\ti64, i64, p:runtime, i64:arg0",
        "func\ti64, p:runtime, i64:arg0"
      ],
      "forbid": [
        "lambda_item_resolve_pending"
      ]
    },
    {
      "return_convention": 3,
      "in_func": "mvp_#_maybe_pending",
      "expect": [
        "call\t{{p}}, lambda_item_adopt_scalar_home,",
        "ret\t"
      ],
      "forbid": [
        "call\tmvp_{{n}}_pending_item_dp"
      ]
    },
    {
      "in_func": "main",
      "expect": [
        "call\t{{p}}, lambda_item_resolve_pending,"
      ]
    }
  ]
}
