{
  "schema_version": 1,
  "description": "D4.3.3/S5.1.1v2/S7.1.1v3: admitted string reads keep nullable pointers. Pointer equality handles both absences; only distinct strings call the string comparator. No generic equality helper is required.",
  "checks": [
    {
      "in_func": "mvp_#_same",
      "expect_seq": [
        {
          "pattern": "eq\t{{r:same}}, {{r:left}}, {{r:right}}"
        },
        {
          "pattern": "bt\tL{{n}}, {{r:same}}"
        },
        {
          "pattern": "call\t{{p}}, fn_str_eq_ptr, {{r}}, {{r:left}}, {{r:right}}"
        }
      ],
      "expect": [
        "i64:32(",
        "i64:40("
      ],
      "count": {
        "call\t{{p}}, fn_str_eq_ptr,": 1,
        "call\t{{p}}, fn_index,": 2
      },
      "forbid": [
        "call\t{{p}}, fn_eq_value,",
        "call\t{{p}}, fn_ne_value,"
      ]
    },
    {
      "in_func": "mvp_#_different",
      "expect": [
        "i64:32(",
        "i64:40("
      ],
      "expect_seq": [
        {
          "pattern": "eq\t{{r:same}}, {{r:left}}, {{r:right}}"
        },
        {
          "pattern": "bt\tL{{n}}, {{r:same}}"
        },
        {
          "pattern": "call\t{{p}}, fn_str_eq_ptr, {{r}}, {{r:left}}, {{r:right}}"
        }
      ],
      "count": {
        "call\t{{p}}, fn_str_eq_ptr,": 1,
        "call\t{{p}}, fn_index,": 2
      },
      "forbid": [
        "call\t{{p}}, fn_eq_value,",
        "call\t{{p}}, fn_ne_value,"
      ]
    }
  ]
}
