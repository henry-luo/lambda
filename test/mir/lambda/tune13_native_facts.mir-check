{
  "schema_version": 1,
  "description": "Tune13 audited abs/min result facts preserve the native int lane from indexed reads through typed locals and return. Typed-performance audit: abs keeps the integer lane and its poison/null sentinels directly (S7.10.5v3, D2.2.2).",
  "checks": [
    {
      "in_func": "mvp_#_tune13_native_fact",
      "expect": [
        "call\t{{p}}, lambda_type_check_lazy,",
        "neg\t",
        "call\t{{p}}, fn_min2,",
        "mov\t{{r}}, i64:({{r}})"
      ],
      "expect_seq": [
        {
          "pattern": "mov\t{{r}}, i64:({{r}})"
        },
        {
          "pattern": "neg\t"
        },
        {
          "pattern": "call\t{{p}}, fn_min2,"
        }
      ],
      "forbid": [
        "call\t{{p}}, fn_abs,"
      ]
    }
  ]
}
