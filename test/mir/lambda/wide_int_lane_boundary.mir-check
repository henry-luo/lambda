{
  "schema_version": 1,
  "description": "S4.4/D2.3.4: mixed-width arithmetic stays in the exact integer tower, and division stays tower-based. Closed direct parameters already passed their admission, so narrow multiply needs no repeated coerce helper.",
  "checks": [
    {
      "in_func": "mvp_#_tower_join",
      "expect": [
        "call\t{{p}}, fn_add,"
      ]
    },
    {
      "in_func": "mvp_#_narrow_join",
      "expect": [
        "call\t{{p}}, fn_mul,"
      ],
      "forbid": [
        "mulo\t"
      ]
    },
    {
      "in_func": "mvp_#_wide_div",
      "expect": [
        "call\t{{p}}, fn_idiv,"
      ]
    }
  ]
}
