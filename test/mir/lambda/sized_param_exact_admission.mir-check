{
  "schema_version": 1,
  "description": "S4.4.1 and D2.3.4-D2.3.5: canonical packed integer-sized parameters take an identity path after a tag, subtype, and reserved-bit check. Other Item carriers keep coerce_num_sized; int() decodes exact signed and unsigned payloads without fn_int.",
  "checks": [
    {
      "in_func": "mvp_#_accept_u32",
      "expect_seq": [
        { "pattern": "and\t{{r:tag}}, %p1, -4294967296" },
        { "pattern": "beq\tL", "next_line": true },
        { "pattern": "call\t{{p}}, coerce_num_sized," },
        { "pattern": "mov\t{{r:admitted}}, {{r}}" },
        { "pattern": "jmp\tL", "next_line": true },
        { "pattern": "mov\t{{r:admitted}}, %p1" },
        { "pattern": "and\t{{r}}, {{r:admitted}}, 4294967295" }
      ],
      "count": {
        "call\t{{p}}, coerce_num_sized,": 1
      },
      "forbid": ["call\t{{p}}, fn_int,"]
    },
    {
      "in_func": "mvp_#_accept_i8",
      "expect_seq": [
        { "pattern": "and\t{{r:tag}}, %p1, -256" },
        { "pattern": "beq\tL", "next_line": true },
        { "pattern": "call\t{{p}}, coerce_num_sized," },
        { "pattern": "mov\t{{r:admitted}}, %p1" },
        { "pattern": "and\t{{r}}, {{r:admitted}}, 255" },
        { "pattern": "lsh\t{{r}}" },
        { "pattern": "rsh\t{{r}}" }
      ],
      "count": {"call\t{{p}}, coerce_num_sized,": 1},
      "forbid": ["call\t{{p}}, fn_int,"]
    },
    {
      "in_func": "mvp_#_accept_u16",
      "expect_seq": [
        { "pattern": "and\t{{r:tag}}, %p1, -65536" },
        { "pattern": "beq\tL", "next_line": true },
        { "pattern": "call\t{{p}}, coerce_num_sized," },
        { "pattern": "mov\t{{r:admitted}}, %p1" },
        { "pattern": "and\t{{r}}, {{r:admitted}}, 65535" }
      ],
      "count": {"call\t{{p}}, coerce_num_sized,": 1},
      "forbid": ["call\t{{p}}, fn_int,"]
    },
    {
      "in_func": "mvp_#_main",
      "count": {
        "call\t{{p}}, fn_bor_item,": 2,
        "call\t{{p}}, fn_int,": 2,
        "call\t{{p}}, fn_add,": 1,
        "call\t{{p}}, fn_ushr_item,": 1,
        "call\t{{p}}, fn_shl_item,": 1
      }
    }
  ]
}
