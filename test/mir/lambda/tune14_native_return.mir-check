{
  "schema_version": 1,
  "description": "Tune14 A3 publishes a native recursive success return for a closed immutable result. The mutable accumulator originally kept the boxed arithmetic path ('until mutation-aware lane tracking exists'); T21-2c added that tracking -- a reassigned binding keeps its lane when its initializer and every write prove the lane, with a self-referencing write proved inductively -- so `value = value + tune14_mutable(n - 1)` now stays on the native int lane too.",
  "checks": [
    {
      "in_func": "mvp_#_tune14_recursive",
      "expect": [
        ":\tfunc\ti64,",
        "add\t{{r}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_add,",
        "call\t{{p}}, lambda_item_adopt_scalar_home,",
        "call\t{{p}}, lambda_restore_number_frame_top,"
      ]
    },
    {
      "in_func": "mvp_#_tune14_mutable",
      "forbid": [
        "call\t{{p}}, fn_add,"
      ],
      "expect": [
        ":\tfunc\ti64,",
        "add\t{{r}}"
      ]
    }
  ]
}
