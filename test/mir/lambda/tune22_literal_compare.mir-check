{
  "schema_version": 1,
  "description": "S5.1.4v2/D2.3.4: short literals use direct constant-pointer lookup, exact byte length and inline character checks without equality helpers.",
  "checks": [
    {
      "in_func": "mvp_#_literal_match_tune22",
      "expect": [
        "_mod_consts_ptr",
        "u32:(",
        "u8:5(",
        "u8:11(",
        "\tbne\tL"
      ],
      "forbid": [
        "call\t{{p}}, fn_eq,",
        "call\t{{p}}, fn_str_eq_ptr,",
        "call\t{{p}}, lambda_module_const_at,",
        "call\t{{p}}, fn_eq_value,"
      ]
    }
  ]
}
