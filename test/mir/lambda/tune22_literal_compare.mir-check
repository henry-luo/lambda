{
  "schema_version": 1,
  "description": "T22-1b/c: short literal-RHS string equality emits a direct context-owned constant load and byte comparison, without either generic equality helper or a module-constant helper (S5.1.1/2, D6.4.3).",
  "checks": [
    {
      "in_func": "mvp_#_literal_match_tune22",
      "expect": [
        "i64:24(",
        "u8:5(",
        "\tbne\tL"
      ],
      "forbid": [
        "call\t{{p}}, fn_eq,",
        "call\t{{p}}, fn_str_eq_ptr,",
        "call\t{{p}}, lambda_module_const_at,"
      ]
    }
  ]
}
