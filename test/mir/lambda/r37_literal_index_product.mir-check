{
  "schema_version": 1,
  "description": "D2.3.4/D4.3.3: finite literal-loop index products use raw integer multiply/add and scaled native float loads; no overflow-flag multiply or double validity conversion splits the region.",
  "checks": [
    {
      "in_func": "mvp_#_mul4",
      "forbid": [
        "dlt\t{{r}}, {{r}}, 9007199254740992",
        "mulo\t",
        "call\t{{p}}, lambda_int_lane_mul_slow,",
        "call\t{{p}}, lambda_int_lane_add_slow,"
      ],
      "expect_seq": [
        "mul\t{{r:product}}, {{r}}, {{r}}",
        "add\t{{r:index}}, {{r:product}}, {{r}}",
        "lsh\t{{r:offset}}, {{r:index}}, 3",
        "add\t{{r:address}}, {{r}}, {{r:offset}}",
        "dmov\t{{r}}, d:({{r:address}})"
      ]
    }
  ]
}
