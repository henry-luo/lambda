{
  "schema_version": 1,
  "description": "S3.4/D2.3: boxed scalar comparisons admit only the true Item in branch and logical consumers, retaining original error/null values without is_truthy calls.",
  "checks": [
    {
      "in_func": "mvp_#_classify",
      "expect": ["call\t{{p}}, fn_eq_value,", "call\t{{p}}, fn_lt,"],
      "forbid": ["call\t{{p}}, is_truthy,"]
    },
    {
      "in_func": "mvp_#_logical",
      "forbid": ["call\t{{p}}, is_truthy,"]
    },
    {
      "in_func": "mvp_#_error_branch",
      "forbid": ["call\t{{p}}, is_truthy,"]
    },
    {
      "in_func": "mvp_#_compound",
      "forbid": ["call\t{{p}}, is_truthy,"]
    }
  ]
}
