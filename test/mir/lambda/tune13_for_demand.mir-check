{
  "schema_version": 1,
  "description": "Tune13 result demand removes dead comprehension output allocation while preserving observed for-expression output.",
  "checks": [
    {
      "in_func": "mvp_#_tune13_discard",
      "forbid": [
        "call\t{{p}}, array_spreadable,",
        "call\t{{p}}, array_push_spread,",
        "call\t{{p}}, array_end,"
      ],
      "expect": [
        "add\t{{r}}, {{r}}, {{r}}"
      ]
    },
    {
      "in_func": "mvp_#_tune13_observed",
      "expect": [
        "call\t{{p}}, array_spreadable,",
        "call\t{{p}}, array_push_spread,",
        "call\t{{p}}, array_end,"
      ]
    }
  ]
}
