{
  "schema_version": 1,
  "description": "D5.4.4/S9.1.2: a collecting split refreshes a stable admitted int[] data pointer but does not reload its unchanged logical length; a var-resizing path retains checked mutation and fresh length reads.",
  "checks": [
    {
      "in_func": "mvp_#_stable_length",
      "expect_seq": [
        {
          "pattern": "mov\t{{r}}, i64:40({{r}})"
        },
        {
          "pattern": "call\t{{p}}, fn_split2,"
        },
        {
          "pattern": "mov\t{{r:items}}, i64:32({{r}})"
        },
        {
          "pattern": "add\t{{r:address}}, {{r:items}}, {{r}}"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r:address}})"
        }
      ],
      "count": {
        "mov\t{{r}}, i64:40({{r}})": {
          "max": 2
        }
      }
    },
    {
      "in_func": "mvp_#_changing_length",
      "expect": [
        "call\t{{p}}, fn_split2,",
        "call\t{{p}}, lambda_array_push_checked,",
        "i64:40({{r}})"
      ]
    },
    {
      "in_func": "mvp_#_resize_local",
      "expect_seq": [
        {
          "pattern": "call\t{{p}}, fn_split2,"
        },
        {
          "pattern": "call\t{{p}}, lambda_array_push_checked,"
        },
        {
          "pattern": "mov\t{{r}}, i64:40({{r}})"
        }
      ]
    }
  ]
}
