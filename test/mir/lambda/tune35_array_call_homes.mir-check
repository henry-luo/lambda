{
  "schema_version": 1,
  "description": "D6.3.3/S9.1.3v3: MVP inlines the late owner replacement. Its plain-argument snapshot is marked before the replacement constructor and the direct consuming call; the defaulted entry preserves its checked scalar default.",
  "checks": [
    {
      "in_func": "mvp_#_defaulted",
      "expect": [
        "call\tmvp_{{n}}_consume_dp"
      ]
    },
    {
      "in_func": "mvp_#_main",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:flags}}, u8:4({{r:owner}})"
        },
        {
          "pattern": "or\t{{r:shared}}, {{r:flags}}, 1"
        },
        {
          "pattern": "mov\tu8:4({{r:owner}}), {{r:shared}}"
        },
        {
          "pattern": "call\t{{p}}, lambda_fill_primitive_bits,"
        },
        {
          "pattern": "call\tmvp_{{n}}_consume_dp"
        }
      ],
      "forbid": [
        "call\tmvp_{{n}}_replace_values_dp"
      ]
    }
  ]
}
