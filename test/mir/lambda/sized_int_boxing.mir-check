{
  "schema_version": 1,
  "description": "D6.2.1/D7.4.2: signed/unsigned extreme constants use the audited boxers and owned binding homes. No dynamic type validation is needed for literal storage.",
  "checks": [
    {
      "in_func": "main",
      "expect": [
        "call\tbox_int64_value_p",
        "call\tbox_uint64_value_p",
        "call\t{{p}}, lambda_item_adopt_scalar_home,"
      ],
      "count": {
        "call\t{{p}}, box_int64_value,": 1,
        "call\t{{p}}, box_uint64_value,": 1
      },
      "forbid": [
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    }
  ]
}
