{
  "schema_version": 1,
  "description": "D8.2.6/D6.2.1: a nonescaping exact local array scalarizes into native values; escaping and absent-read controls retain their primitive constructor.",
  "checks": [
    {
      "in_func": "mvp_#_fixed_reads",
      "forbid": [
        "call\t{{p}}, array_float_new,",
        "call\t{{p}}, array_num_new_uninit,",
        "call\t{{p}}, lambda_fill_primitive_bits,",
        "call\t{{p}}, array_num_new,"
      ],
      "expect": [
        "dadd\t"
      ]
    },
    {
      "in_func": "mvp_#_escape",
      "expect": [
        "call\t{{p}}, lambda_fill_primitive_bits,"
      ]
    },
    {
      "in_func": "mvp_#_absent_read",
      "expect": [
        "call\t{{p}}, lambda_fill_primitive_bits,"
      ]
    }
  ]
}
