{
  "schema_version": 1,
  "description": "Tune15 B2.2 keeps statically-bound scalar procedure calls on the native ABI.",
  "checks": [
    {
      "in_func": "_tune15_call_#",
      "expect": [
        "call\t_tune15_add_",
        "add\t{{r}}, {{r}}, {{r}}"
      ],
      "forbid": [
        "call\tfn_add_p, fn_add",
        "call\t_tune15_add_#_b"
      ]
    }
  ]
}
