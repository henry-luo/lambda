{
  "schema_version": 1,
  "description": "D3.3.4 / S9.1.3: an admitted carrier retains its layout proof independently of the live COW owner check. Shared snapshots and zero-trip loops keep their semantics.",
  "checks": [
    {
      "in_func": "_tune32_phase2_admitted_store_#",
      "expect": [
        "mov\t{{r}}, u8:4({{r}})",
        "dmov\td:({{r}}), {{r}}"
      ],
      "forbid": [
        "u8:2({{r}})",
        "u8:3({{r}})"
      ]
    },
    {
      "in_func": "_tune32_phase2_admitted_read_#",
      "expect": [
        "dmov\t{{r}}, d:({{r}})"
      ],
      "forbid": [
        "u8:2({{r}})",
        "u8:3({{r}})"
      ]
    }
  ]
}
