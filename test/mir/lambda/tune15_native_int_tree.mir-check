{
  "schema_version": 1,
  "description": "Tune15 F1 keeps a closed integer arithmetic tree native through the float boundary.",
  "checks": [
    {
      "in_func": "mvp_#_tune15_integer_tree",
      "expect": [
        "mulo\t{{r}}, {{r}}, {{r}}",
        "ddiv\t{{r}}, {{r}}, {{r}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_add,",
        "call\t{{p}}, fn_mul,",
        "call\t{{p}}, fn_div,"
      ]
    }
  ]
}
