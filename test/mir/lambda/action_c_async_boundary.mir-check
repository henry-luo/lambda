{
  "schema_version": 1,
  "description": "RA1: a wait is an ordinary call. The suspending procedure emits no async-frame protocol and no pending-pair resolution around it; the caller still resolves the wide result it receives.",
  "checks": [
    {
      "in_func": "_delayed_value_#",
      "forbid": [
        "lambda_async_frame",
        "lambda_item_resolve_pending"
      ]
    },
    {
      "in_func": "main",
      "expect": [
        "lambda_item_resolve_pending"
      ]
    }
  ]
}
