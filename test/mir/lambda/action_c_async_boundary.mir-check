{
  "schema_version": 1,
  "description": "Action C async boundary: suspension stores/restores the async frame and does not let a pending companion enter the word spill protocol.",
  "checks": [
    {
      "in_func": "_delayed_value_#",
      "expect": [
        "lambda_async_frame_set_state",
        "lambda_async_frame_get_word"
      ],
      "forbid": [
        "lambda_item_resolve_pending"
      ]
    },
    {
      "in_func": "main",
      "expect": [
        "lambda_item_resolve_pending"
      ]
    }
  ]
}
