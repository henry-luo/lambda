{
  "schema_version": 1,
  "description": "D3.3.3v3: the dynamic ArrayNum carrier guard reads Container.type_id at byte 0, then layout flags at byte 2; reading Map.type at byte 8 rejects the fast arm for valid numeric arrays. Result44: the extent and unique-owner store guards stay separate, so a failed store ownership word does not force sibling reads to the checked arm.",
  "checks": [
    {
      "in_func": "_matmul_#",
      "expect_seq": [
        { "pattern": "mov\t{{r:dense_type}}, u8:({{r:array}})" },
        { "pattern": ", {{r:dense_type}}, 17", "next_line": true },
        { "pattern": "mov\t{{r}}, u8:2({{r:array}})", "next_line": true }
      ]
    },
    {
      "in_func": "_matmul_#",
      "expect_seq": [
        {
          "pattern": "mulo\t{{r}}, {{r}}, {{r}}"
        },
        {
          "pattern": "and\t{{r:g}}, {{r:g}}, {{r}}"
        },
        {
          "pattern": "and\t{{r!g}}, {{r:g}}, {{r}}"
        }
      ]
    }
  ]
}
