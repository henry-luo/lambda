      "in_func": "_equals_null_#",
      "expect": [
        "ursh\t{{r}},",
        "bne\t",
        "eq\t{{r}}, {{r}}, 1"
      ]
    },
    {
      "in_func": "_differs_null_#",
      "expect": [
        "ursh\t{{r}},",
        "bne\t",
        "ne\t{{r}}, {{r}}, 1"
      ]
    },
    {
      "in_func": "_indexed_#",
      "expect": [
        "ursh\t{{r}},",
        "bne\t",
        "ne\t{{r}}, {{r}}, 1"
      ]
    },
    {
      "in_func": "_local_#",
      "expect": [
        "ursh\t{{r}},",
        "bne\t",
        "eq\t{{r}}, {{r}}, 1"
      ]
    }
  ]
}
