        "\tdle\t",
        "\tdgt\t",
        "\tdge\t"
      ],
      "expect": [
        "\tlt\t",
        "\tle\t",
        "\tgt\t",
        "\tge\t"
      ],
      "in_range": {
        "from": "func\t",
        "to": "call\t{{p}}, lambda_int_lane_to_double_c,"
      }
    },
    {
