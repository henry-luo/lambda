{
  "schema_version": 1,
  "description": "D2.3.4\u2013D2.3.5/S4.1.2: native shifts and bitwise instructions consume raw copied parameter lanes. MVP finite guards retain one boxed helper per sentinel/invalid-count miss; no operand tag bits reach the word instruction.",
  "checks": [
    {
      "in_func": "mvp_#_half",
      "expect_seq": [
        "mov\t{{r:param}}, arg0",
        "mov\t{{r:value}}, {{r:param}}",
        "mov\t{{r:count}}, 1",
        "rsh\t{{r}}, {{r:value}}, {{r:count}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_shr_item,",
        "call\t{{p}}, int2it_lane,"
      ]
    },
    {
      "in_func": "mvp_#_shift",
      "expect_seq": [
        "mov\t{{r:a}}, arg0",
        "mov\t{{r:b}}, arg1",
        "mov\t{{r:left}}, {{r:a}}",
        "mov\t{{r:right}}, {{r:b}}",
        "lsh\t{{r}}, {{r:left}}, {{r:right}}"
      ],
      "count": {
        "call\t{{p}}, fn_shl_item,": 1
      }
    },
    {
      "in_func": "mvp_#_shift",
      "in_range": {
        "from": "mov\t{{r}}, arg0",
        "to": "lsh\t"
      },
      "forbid": [
        "call\t{{p}}, int2it_lane,",
        "360287970189639680"
      ]
    },
    {
      "in_func": "mvp_#_mask",
      "expect_seq": [
        "xor\t{{r}}, {{r}}, -1",
        "call\t{{p}}, fn_bnot_item,",
        "and\t{{r}}, {{r}}, {{r}}"
      ],
      "count": {
        "call\t{{p}}, fn_bnot_item,": 1,
        "call\t{{p}}, fn_band_item,": 1
      }
    }
  ]
}
