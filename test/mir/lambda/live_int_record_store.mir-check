{
  "schema_version": 1,
  "description": "D3.2.1/D3.2.2/S7.1.3v2: a local nullable int lane checks the null sentinel before a trusted record write, while an unproven indexed value retains the checked setter.",
  "checks": [
    {
      "in_func": "_advance_#",
