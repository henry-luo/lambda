{
  "schema_version": 1,
  "description": "Tune17 T1 emits the same native recursive int lane for inferred and declared procedures.",
  "checks": [
    {
      "in_func": "mvp_#_tune17_tak_inferred",
      "expect": [
        "call\tmvp_{{n}}_tune17_tak_inferred_dp"
      ],
      "forbid": [
        "lambda_type_check_lazy",
        "call\t{{p}}, fn_call_into,"
      ]
    },
    {
      "in_func": "mvp_#_tune17_tak_declared",
      "expect": [
        "call\tmvp_{{n}}_tune17_tak_declared_dp"
      ],
      "forbid": [
        "lambda_type_check_lazy",
        "call\t{{p}}, fn_call_into,"
      ]
    }
  ]
}
