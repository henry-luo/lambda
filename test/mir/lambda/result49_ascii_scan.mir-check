{
  "schema_version": 1,
  "description": "D7.3.1/S7.1.1v3: MVP compares guarded ASCII bytes directly; ord-at retains Unicode and absent-index semantics.",
  "checks": [
    {
      "in_func": "mvp_#_last_code",
      "expect": [
        "u8:4",
        "u8:5",
        "call\t{{p}}, fn_string_ord_at,"
      ],
      "count": {
        "u8:4(": 1,
        "u8:5(": 1,
        "call\t{{p}}, fn_string_ord_at,": 1
      },
      "forbid": [
        "call\t{{p}}, fn_string_ascii_at,",
        "call\t{{p}}, fn_ord_str,"
      ]
    },
    {
      "in_func": "mvp_#_fold_digits",
      "expect": [
        "u8:4",
        "u8:5",
        "call\t{{p}}, fn_string_ord_at,"
      ],
      "count": {
        "u8:4(": 1,
        "u8:5(": 1,
        "call\t{{p}}, fn_string_ord_at,": 1
      },
      "forbid": [
        "call\t{{p}}, fn_string_ascii_at,",
        "call\t{{p}}, fn_ord_str,"
      ]
    },
    {
      "in_func": "mvp_#_skip_spaces",
      "expect": [
        "u8:5",
        "call\t{{p}}, fn_string_ord_at,"
      ],
      "count": {
        "u8:4(": 1,
        "u8:5(": 1,
        "call\t{{p}}, fn_string_ord_at,": 1
      },
      "forbid": [
        "call\t{{p}}, fn_string_ascii_at,"
      ]
    },
    {
      "in_func": "mvp_#_scan_word",
      "expect": [
        "u8:5",
        "call\t{{p}}, fn_string_ord_at,"
      ],
      "count": {
        "u8:4(": 1,
        "u8:5(": 1,
        "call\t{{p}}, fn_string_ord_at,": 1
      },
      "forbid": [
        "call\t{{p}}, fn_string_ascii_at,"
      ]
    },
    {
      "in_func": "mvp_#_changing_source",
      "expect": [
        "call\t{{p}}, fn_string_ord_at,"
      ],
      "count": {
        "u8:4(": 1,
        "u8:5(": 1,
        "call\t{{p}}, fn_string_ord_at,": 1
      }
    }
  ]
}
