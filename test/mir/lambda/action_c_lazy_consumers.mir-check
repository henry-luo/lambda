{
  "schema_version": 1,
  "description": "D7.4.2/D6.2.1: MVP inlines the pending identity into its arithmetic/truth/type/comparison consumers. Owned scalar homes precede observation; the public module boundary resolves the result.",
  "checks": [
    {
      "return_convention": 3,
      "in_func": "mvp_#_pending_item",
      "expect": [
        "ret\t"
      ],
      "expect_any": [
        "func\ti64, i64, p:runtime, i64:arg0",
        "func\ti64, p:runtime, i64:arg0"
      ],
      "forbid": [
        "lambda_item_resolve_pending"
      ]
    },
    {
      "return_convention": 3,
      "in_func": "mvp_#_consume_arithmetic",
      "expect": [
        "call\t{{p}}, lambda_item_adopt_scalar_home,",
        "call\t{{p}}, fn_add,"
      ],
      "forbid": [
        "call\tmvp_{{n}}_pending_item_dp"
      ]
    },
    {
      "return_convention": 3,
      "in_func": "mvp_#_consume_truth",
      "expect": [
        "call\t{{p}}, lambda_item_adopt_scalar_home,",
        "call\t{{p}}, is_truthy,"
      ],
      "forbid": [
        "call\tmvp_{{n}}_pending_item_dp"
      ]
    },
    {
      "return_convention": 3,
      "in_func": "mvp_#_consume_type",
      "expect": [
        "call\t{{p}}, lambda_item_adopt_scalar_home,",
        "call\t{{p}}, fn_type,"
      ],
      "forbid": [
        "call\tmvp_{{n}}_pending_item_dp"
      ]
    },
    {
      "return_convention": 3,
      "in_func": "mvp_#_consume_compare",
      "expect": [
        "call\t{{p}}, lambda_item_adopt_scalar_home,",
        "call\t{{p}}, fn_eq_value,"
      ],
      "forbid": [
        "call\tmvp_{{n}}_pending_item_dp"
      ]
    },
    {
      "in_func": "main",
      "expect": [
        "call\t{{p}}, lambda_item_resolve_pending,"
      ]
    }
  ]
}
