{
  "schema_version": 1,
  "description": "D4.3.3/S8.2.4v3: scalar and selection keys retain checked index/member misses. Guarded record arms load their declared offsets, including byte flags and the unaligned integer after three bool fields.",
  "checks": [
    {
      "in_func": "mvp_#_local_key",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r:data}})"
        }
      ],
      "expect": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, fn_member,"
      ]
    },
    {
      "in_func": "mvp_#_selected_key",
      "expect": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, fn_member_by_id,"
      ]
    },
    {
      "in_func": "mvp_#_nullable_position",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r:data}})"
        }
      ],
      "expect": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, fn_member,"
      ]
    },
    {
      "in_func": "mvp_#_task_flag",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\t{{r}}, u8:34({{r:data}})"
        }
      ],
      "expect": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, fn_member,"
      ]
    },
    {
      "in_func": "mvp_#_task_id",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\t{{r}}, i64:35({{r:data}})"
        }
      ],
      "expect": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, fn_member,"
      ]
    }
  ]
}
