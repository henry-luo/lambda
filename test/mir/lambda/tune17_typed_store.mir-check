{
  "schema_version": 1,
  "description": "S7.1.3v2: typed cold stores retain the checked error boundary. Tune17 T2 keeps declared int and bool array writes on their raw lanes with checked fallbacks. T29-5 (2026-09-17): a non-null int value takes the compact COW store (array_num_set_cow_idx) on a statically proven int[] root, as bool and non-null float values already did; out-of-range stores still raise through fn_array_set.",
  "checks": [
    {
      "in_func": "_tune17_typed_store_#",
      "expect": [
        "call\tarray_num_set_cow_idx",
        "mov\ti64:({{r}}), {{r}}",
        "mov\tu8:({{r}}), {{r}}"
      ]
    }
  ]
}
