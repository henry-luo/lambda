{
  "schema_version": 1,
  "description": "D6.3/D8.2.6: total native math on stable homes executes once before the initial loop test, including zero-trip inputs; the captured backedge enters a body with no repeated call. Changed operands stay in the loop, retained streams allocate, and procedural effects keep their inlined checked stores.",
  "checks": [
    {
      "in_func": "mvp_#_local_while",
      "expect_seq": [
        "call\t{{p}}, fabs, {{r:absolute}},",
        "jmp\t{{l:test}}",
        "{{l:body}}:",
        "dadd\t{{r}}, {{r}}, {{r:absolute}}",
        "{{l:test}}:",
        "blt\t{{l:body}},"
      ],
      "count": {
        "call\t{{p}}, fabs,": 1
      }
    },
    {
      "in_func": "mvp_#_local_while",
      "in_range": {
        "from": "jmp\tL",
        "to": "ret\t"
      },
      "forbid": [
        "call\t{{p}}, fabs,"
      ]
    },
    {
      "in_func": "mvp_#_counted",
      "expect_seq": [
        "call\t{{p}}, fabs,",
        "bgt\t"
      ],
      "forbid": [
        "array_spreadable",
        "array_push_spread"
      ]
    },
    {
      "in_func": "mvp_#_changing",
      "expect_seq": [
        "bgt\t",
        "call\t{{p}}, fabs,",
        "dadd\t",
        "ble\t"
      ],
      "forbid": [
        "array_spreadable",
        "array_push_spread"
      ]
    },
    {
      "in_func": "mvp_#_retained",
      "expect": [
        "call\tarray_spreadable",
        "call\tarray_push_spread"
      ]
    },
    {
      "in_func": "mvp_#_effects",
      "expect": [
        "call\t{{p}}, lambda_array_set_checked_item,",
        "mov\ti64:({{r}}), {{r}}"
      ],
      "forbid": [
        "call\t{{p}}, array_spreadable,",
        "call\t{{p}}, array_push_spread,"
      ]
    }
  ]
}
