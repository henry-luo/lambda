{
  "schema_version": 1,
  "description": "S11.1.2v2/S2.5.1v2: generic map/array tests use the audited value kind, while a first-class type value still uses fn_is.",
  "checks": [
    {
      "in_func": "mvp_#_classify",
      "count": {"call\t{{p}}, item_type_id,": 2},
      "forbid": ["call\t{{p}}, fn_is,", "call\t{{p}}, base_type,"]
    },
    {
      "in_func": "mvp_#_dynamic",
      "expect": ["call\t{{p}}, fn_is,"]
    },
    {
      "in_func": "mvp_#_error_kind",
      "count": {"eq\t{{r}}, {{r}}, 27": 2},
      "forbid": ["call\t{{p}}, fn_is,", "call\t{{p}}, base_type,"]
    }
  ]
}
