{
  "schema_version": 1,
  "description": "D4.2.5/D4.3.3/S9.1.2: MVP guards packed record reads, validates dynamic constructor fields and preserves snapshots through writes. D4.2.5: admitted read-only prefixes reuse entry admission; erased controls keep live shape guards.",
  "checks": [
    {
      "in_func": "mvp_#_typed_read",
      "expect_seq": [
        "mov\t{{r:base}}, arg0",
        "mov\t{{r:alias}}, {{r:base}}",
        "mov\t{{r:data}}, p:16({{r:alias}})",
        "mov\t{{r}}, i64:1({{r:data}})"
      ],
      "forbid": [
        "call\t{{p}}, fn_call_into,",
        "call\t{{p}}, fn_member,",
        "i64:144("
      ]
    },
    {
      "in_func": "mvp_#_erased_read",
      "expect": [
        "i64:144(",
        "i64:1(",
        "call\t{{p}}, fn_member_by_id,"
      ],
      "forbid": [
        "call\t{{p}}, fn_call_into,"
      ]
    },
    {
      "in_func": "mvp_#_construct",
      "expect_seq": [
        {
          "pattern": "call\t{{p}}, lambda_type_check_lazy,"
        },
        {
          "pattern": "call\t{{p}}, map_alloc_for_type,"
        },
        {
          "pattern": "call\t{{p}}, set_field_value,"
        }
      ]
    },
    {
      "in_func": "mvp_#_parsed",
      "expect_seq": [
        {
          "pattern": "call\t{{p}}, fn_parse2,"
        },
        {
          "pattern": "call\t{{p}}, lambda_type_check_lazy,"
        },
        {
          "pattern": "call\t{{p}}, map_alloc_for_type,"
        },
        {
          "pattern": "call\t{{p}}, set_field_value,"
        }
      ]
    },
    {
      "in_func": "mvp_#_write",
      "expect": [
        "mov\ti64:1(",
        "call\t{{p}}, lambda_map_set_checked,",
        "call\t{{p}}, lambda_report_boundary_failure,"
      ]
    }
  ]
}
