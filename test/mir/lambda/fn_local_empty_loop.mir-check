{
  "schema_version": 1,
  "description": "S2.5.3v3/S2.5.5v2/D2.3.4: statement-only functions allocate no result list. Native shift/branch arithmetic retains one checked sentinel fallback, rather than forbidding its cold arm.",
  "checks": [
    {
      "in_func": "mvp_#_spin",
      "forbid": [
        "call\tlist_p",
        "call\tlist_end"
      ]
    },
    {
      "in_func": "mvp_#_shifted",
      "forbid": [
        "call\t{{p}}, fn_mod,",
        "call\t{{p}}, fn_gt,",
        "call\t{{p}}, list,",
        "call\t{{p}}, list_end,"
      ],
      "expect": [
        "rsh\t",
        "ble\t"
      ],
      "count": {
        "call\t{{p}}, fn_shr_item,": 1
      }
    }
  ]
}
