{
  "schema_version": 1,
  "description": "S5.1.4v2/D2.3.4: an empty string literal uses the immutable shared String and does not resolve a module constant; a nonempty literal still uses its module slab.",
  "checks": [
    {
      "in_func": "mvp_#_empty",
      "forbid": ["call\t{{p}}, lambda_module_state_for_unit,"]
    },
    {
      "in_func": "mvp_#_filled",
      "expect": ["call\t{{p}}, lambda_module_state_for_unit,"]
    }
  ]
}
