{
  "schema_version": 1,
  "description": "D8.2.6/S9.1.2: a checked int result in a braced block loops to the same body label after its allocating local and native updates, retaining a live array parameter. Non-tail and changed-owner controls retain calls.",
  "checks": [
    {
      "in_func": "mvp_#_checked_tail",
      "forbid": [
        "call\tmvp_{{n}}_checked_tail_dp"
      ],
      "in_range": {
        "from": "call\t{{p}}, lambda_stack_is_exhausted,",
        "to": "ret\t"
      },
      "expect_seq": [
        "{{l:body}}:",
        "call\t{{p}}, fn_string,",
        "add\t{{r}}, {{r}}, {{r}}",
        "call\t{{p}}, fn_len_s,",
        "jmp\t{{l:body}}"
      ]
    },
    {
      "in_func": "mvp_#_non_tail",
      "expect": [
        "call\tmvp_{{n}}_non_tail_dp"
      ]
    },
    {
      "in_func": "mvp_#_changing_owner",
      "expect": [
        "call\tmvp_{{n}}_changing_owner_dp"
      ]
    }
  ]
}
