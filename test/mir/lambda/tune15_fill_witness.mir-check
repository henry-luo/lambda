{
  "schema_version": 1,
  "description": "Tune15 B1.3 preserves the packed integer witness inferred from an unannotated fill(n, int) binding.",
  "checks": [
    {
      "in_func": "mvp_#_tune15_fill_witness",
      "expect": [
        "call\t{{p}}, fn_fill,",
        "lsh\t{{r}}, {{r}}, 3",
        "mov\t{{r}}, i64:({{r}})"
      ],
      "forbid": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, item_at,"
      ]
    }
  ]
}
