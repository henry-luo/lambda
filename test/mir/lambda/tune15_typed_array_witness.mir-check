{
  "schema_version": 1,
  "description": "Tune15 B2.2 passes a proven packed typed array through the direct native call ABI with an explicit witness mask.",
  "checks": [
    {
      "in_func": "mvp_#_main",
      "expect": [
        "call\tmvp_{{n}}_tune15_array_consumer_dp"
      ],
      "forbid": [
        "call\tmvp_{{n}}_tune15_array_consumer_dp#_b"
      ]
    },
    {
      "in_func": "mvp_#_tune15_array_consumer",
      "expect": [
        "and\t{{r}}, _array_witness, 1",
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    }
  ]
}
