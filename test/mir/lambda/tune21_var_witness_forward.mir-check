{
  "schema_version": 1,
  "description": "T21-2d: unannotated forwarding helpers remain on the generic COW access path because no declaration-derived certificate proves their element contract; this preserves correctness rather than treating inferred narrowing as a value proof (D3.3.3v3).",
  "checks": [
    {
      "in_func": "_set_row_#",
      "expect": [
        "call\tfn_array_set_p, fn_array_set"
      ],
      "forbid": [
        "call\tlambda_array_set_checked_inplace_p, lambda_array_set_checked_inplace",
        "call\tindex_assign_cow_p, index_assign_cow"
      ]
    },
    {
      "in_func": "_place_#",
      "expect": [
        "call\tfn_array_set_p, fn_array_set"
      ]
    },
    {
      "in_func": "_widen_#",
      "forbid": [
        "call\tlambda_array_set_checked_inplace_p, lambda_array_set_checked_inplace",
        "call\tindex_assign_cow_p, index_assign_cow"
      ]
    }
  ]
}
