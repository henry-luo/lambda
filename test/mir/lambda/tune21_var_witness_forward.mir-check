{
  "schema_version": 1,
  "description": "T21-2d / Tune31 T31-1: an inferred witness may reach a self-forwarding var raw entry, whose representation-agnostic COW setter preserves widening and boxed-wrapper fallback without promoting inference to a declared contract (D3.2.1, D3.3.3v3). LR07-28/D3.3.3v3 (2026-10-28): an inferred bool Array has no element tag to guard after unknown var stores. set_row therefore keeps fn_array_set on its boxed path, without inventing a bool[] contract; place retains the numeric taken-array witness.",
  "checks": [
    {
      "in_func": "_set_row_#",
      "expect": [
        "call\tfn_array_set_p, fn_array_set"
      ],
      "forbid": [
        "call\tlambda_array_set_checked_inplace_p, lambda_array_set_checked_inplace",
        "call\tindex_assign_cow_p, index_assign_cow"
      ]
    },
    {
      "in_func": "_place_#",
      "expect": [
        "call\tarray_num_set_cow_idx_p, array_num_set_cow_idx"
      ]
    },
    {
      "in_func": "_widen_#",
      "forbid": [
        "call\tlambda_array_set_checked_inplace_p, lambda_array_set_checked_inplace",
        "call\tindex_assign_cow_p, index_assign_cow"
      ]
    }
  ]
}
