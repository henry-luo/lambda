{
  "schema_version": 1,
  "description": "D2.4.3/S7.1.3v2: shrinking indices use the shared inclusive dense extent guard, with checked stores on a miss and invalidation across growth. Match comparison opcodes exactly: a scalar boxing blt is not an index lt.",
  "checks": [
    {
      "in_func": "mvp_#_reverse_span",
      "expect": [
        "addo\t{{r}}, {{r}}, 1",
        "call\tlambda_array_set_checked_inplace_lane_p, lambda_array_set_checked_inplace_lane"
      ]
    },
    {
      "in_func": "mvp_#_reverse_span",
      "in_range": {
        "from": "lsh\t{{r}}, {{r}}, 3",
        "to": "bt\tL"
      },
      "expect_seq": [
        {
          "pattern": "mov\t{{r}}, i64:({{r}})"
        },
        {
          "pattern": "lsh\t{{r}}, {{r}}, 3"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r}})"
        }
      ],
      "forbid": [
        "\tge\t",
        "\tlt\t",
        "call\tfn_index"
      ]
    },
    {
      "in_func": "mvp_#_reverse_growing",
      "expect": [
        "call\tlambda_array_push_checked_p, lambda_array_push_checked",
        "call\tlambda_array_set_checked_inplace_lane_p, lambda_array_set_checked_inplace_lane"
      ]
    }
  ]
}
