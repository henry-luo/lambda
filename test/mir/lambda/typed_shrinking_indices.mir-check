{
  "schema_version": 1,
  "description": "D2.4.3/S7.1.3v2: the shrinking loop keeps its shared native access region and checked growing/invalid alternatives. Integer induction uses raw add/sub with explicit int53 slow guards rather than Full ADDO.",
  "checks": [
    {
      "in_func": "mvp_#_reverse_span",
      "expect": [
        "add\t{{r}}, {{r}}, {{r}}",
        "sub\t",
        "call\t{{p}}, lambda_array_set_checked_item,"
      ]
    },
    {
      "in_func": "mvp_#_reverse_span",
      "in_range": {
        "from": "lsh\t{{r}}, {{r}}, 3",
        "to": "call\t{{p}}, lambda_int_lane_add_slow,"
      },
      "expect_seq": [
        {
          "pattern": "mov\t{{r}}, i64:({{r}})"
        },
        {
          "pattern": "lsh\t{{r}}, {{r}}, 3"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r}})"
        }
      ],
      "forbid": [
        "\tge\t",
        "\tlt\t",
        "call\tfn_index"
      ],
      "count": {
        "mov\ti64:({{r}}), {{r}}": 2
      }
    },
    {
      "in_func": "mvp_#_reverse_growing",
      "expect": [
        "call\t{{p}}, lambda_array_push_checked,",
        "call\t{{p}}, lambda_array_set_checked_item,"
      ]
    }
  ]
}
