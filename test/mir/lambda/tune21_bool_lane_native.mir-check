{
  "schema_version": 1,
  "description": "D2.3.5/D4.3.3: MVP bool-array conditions consume native byte lanes and branch on their value without a redundant low-bit mask, boxed truthiness or wide boxing. Misses use the primitive nullable index helper.",
  "checks": [
    {
      "in_func": "mvp_#_count_set",
      "forbid": [
        "call\t{{p}}, is_truthy,",
        "call\t{{p}}, box_int64_value,"
      ],
      "expect": [
        "mov\t{{r}}, u8:({{r}})",
        "beq\t",
        "call\t{{p}}, lambda_array_primitive_index,"
      ]
    },
    {
      "in_func": "mvp_#_count_pairs",
      "forbid": [
        "call\t{{p}}, is_truthy,",
        "call\t{{p}}, box_int64_value,",
        "call\t{{p}}, fn_not,"
      ],
      "expect": [
        "mov\t{{r}}, u8:({{r}})",
        "beq\t",
        "call\t{{p}}, lambda_array_primitive_index,"
      ]
    }
  ]
}
