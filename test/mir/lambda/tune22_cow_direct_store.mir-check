{
  "schema_version": 1,
  "description": "A static nested integer field store uses the bounded COW spine borrow and emits the guarded direct-store registers.",
  "checks": [
    {
      "in_func": "*",
      "expect_seq": [
        { "pattern": "call\tcow_path_borrow_fixed" },
        { "pattern": "mov\t{{r}}, u8:({{r}})" },
        { "pattern": "mov\t{{r}}, i64:8({{r}})" },
        { "pattern": "mov\t{{r}}, i64:16({{r}})" },
        { "pattern": "mov\ti64:({{r}}), {{r}}" }
      ]
    }
  ]
}
