{
  "schema_version": 1,
  "description": "S9.1.2/D5.4.4: MVP native uniqueness guards protect borrowed writes; observed snapshots and escaped children share-mark inline before checked mutation.",
  "checks": [
    {
      "in_func": "mvp_#_borrowed",
      "forbid": [
        "call\tcow_bind_var"
      ],
      "expect": [
        "and\t{{r}}, {{r}}, 4294979584",
        "call\t{{p}}, lambda_array_set_checked_item,"
      ]
    },
    {
      "in_func": "mvp_#_snapshot",
      "expect": [
        "call\t{{p}}, lambda_array_set_checked_item,"
      ],
      "expect_seq": [
        {
          "pattern": "mov\t{{r:flags}}, u8:4({{r:owner}})"
        },
        {
          "pattern": "or\t{{r:marked}}, {{r:flags}}, 1"
        },
        {
          "pattern": "mov\tu8:4({{r:owner}}), {{r:marked}}"
        }
      ]
    },
    {
      "in_func": "mvp_#_escaped_child",
      "expect": [
        "call\t{{p}}, cow_path_set_keys,"
      ],
      "expect_seq": [
        {
          "pattern": "mov\t{{r:flags}}, u8:4({{r:owner}})"
        },
        {
          "pattern": "or\t{{r:marked}}, {{r:flags}}, 1"
        },
        {
          "pattern": "mov\tu8:4({{r:owner}}), {{r:marked}}"
        }
      ]
    }
  ]
}
