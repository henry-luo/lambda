{
  "schema_version": 1,
  "description": "D4.4.4v4 / D5.3.1: a direct packed-field write reloads its data zone after a collecting RHS, with the owner rooted across the call; bool stores use one byte.",
  "checks": [
    {
      "in_func": "_update_#",
      "expect_seq": [
        { "pattern": "mov\ti64:({{r}}), %p1" },
        { "pattern": "call\t_computed_" },
        { "pattern": "mov\t{{r}}, i64:16({{r}})" },
        { "pattern": "mov\ti64:({{r}}), {{r}}" }
      ],
      "expect": ["mov\tu8:8({{r}}), {{r}}"],
      "forbid": ["call\tlambda_map_set_checked"]
    }
  ]
}
