{
  "schema_version": 1,
  "description": "D5.4.4 / D6.3.1: a direct packed-field write reloads its data zone after a collecting RHS, with the owner rooted across the call; bool stores use one byte.",
  "checks": [
    {
      "in_func": "mvp_#_update",
      "expect_seq": [
        { "pattern": "mov\ti64:({{r}}), %p1" },
        { "pattern": "call\tmvp_{{n}}_computed_dp" },
        { "pattern": "mov\t{{r}}, i64:16({{r}})" },
        { "pattern": "mov\ti64:({{r}}), {{r}}" }
      ],
      "expect": ["mov\tu8:8({{r}}), {{r}}"],
      "forbid": ["call\tlambda_map_set_checked"]
    }
  ]
}
