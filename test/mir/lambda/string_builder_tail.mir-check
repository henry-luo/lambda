{
  "schema_version": 1,
  "description": "Self-tail recursion reuses an exclusive final string argument and freezes at publication.",
  "checks": [
    {"in_func": "mvp_#_tail_builder", "expect": ["call\t{{p}}, fn_strcat,", "call\t{{p}}, fn_string_freeze,"], "forbid": ["call\t{{p}}, fn_join,"]},
    {"in_func": "mvp_#_field_tail", "expect": ["call\t{{p}}, fn_strcat,"]}
  ]
}
