{
  "schema_version": 1,
  "description": "Typed numeric-array loads retain their guarded fast path; typed writes go through the checked replacement helper so a widened alias cannot mutate the bound array into an invalid representation.",
  "checks": [
    {
      "in_func": "_guarded_load_#",
      "expect_seq": [
        { "pattern": "mov\tidx_type_" },
        { "pattern": "eq\tidx_type_ok_" },
        { "pattern": "mov\tidx_flags_" },
        { "pattern": "and\tidx_shaped_" },
        { "pattern": "mov\tidx_elem_" },
        { "pattern": "eq\tidx_elem_ok_" },
        { "pattern": "call\titem_at_p, item_at" }
      ],
      "count": {
        "call\titem_at_p, item_at": 1
      }
    },
    {
      "in_func": "_guarded_store_#",
      "expect_seq": [
        { "pattern": "call\tensure_typed_array_p, ensure_typed_array" },
        { "pattern": "call\tlambda_array_set_checked_p, lambda_array_set_checked" },
        { "pattern": "call\titem_type_id_p, item_type_id" },
        { "pattern": "eq\tstmt_err_" },
        { "pattern": "call\tfn_index_p, fn_index" }
      ],
      "count": {
        "call\tlambda_array_set_checked_p, lambda_array_set_checked": 1
      }
    }
  ]
}
