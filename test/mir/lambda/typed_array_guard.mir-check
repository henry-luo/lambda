{
  "schema_version": 1,
  "description": "Typed numeric-array loads use the guarded direct ArrayNum data lane. A proven float procedure parameter validates the physical array header before reading or writing in place, preserving the caller-visible procedure ABI without generic item_at dispatch.",
  "checks": [
    {
      "in_func": "_guarded_load_#",
      "forbid": [
        "call\titem_at_p, item_at"
      ],
      "expect_seq": [
        { "pattern": "call\tensure_typed_array_p, ensure_typed_array" },
        { "pattern": "mov\t{{r}}, i64:8({{r}})" },
        { "pattern": "mov\t{{r}}, i64:16({{r}})" },
        { "pattern": "and\t{{r}}, {{r}}, 72057594037927935" },
        { "pattern": "lts\t{{r}}, %p2, 0" },
        { "pattern": "ges\t{{r}}, %p2, {{r}}" },
        { "pattern": "mul\t{{r}}, %p2, 8" },
        { "pattern": "dmov\t{{r}}, d:({{r}})" }
      ]
    },
    {
      "in_func": "_guarded_store_#",
      "forbid": [
        "call\tlambda_array_set_checked_p, lambda_array_set_checked"
      ],
      "expect_seq": [
        { "pattern": "call\tensure_typed_array_p, ensure_typed_array" },
        { "pattern": "call\tlambda_module_const_at_p" },
        { "pattern": "call\tfn_array_set_p, fn_array_set" }
      ]
    },
    {
      "in_func": "_dense_int_sum_#",
      "forbid": [
        "call\titem_at_p, item_at",
        "dmov\t{{r}}, d:({{r}})"
      ],
      "expect": [
        "mov\t{{r}}, i64:({{r}})"
      ]
    },
    {
      "in_func": "_dense_int_linear_sum_#",
      "forbid": [
        "call\titem_at_p, item_at",
        "dmov\t{{r}}, d:({{r}})"
      ],
      "expect": [
        "mov\t{{r}}, i64:({{r}})"
      ]
    }
  ]
}
