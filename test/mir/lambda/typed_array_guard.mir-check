{
  "schema_version": 1,
  "description": "D4.3.3: MVP derives native carrier/bounds guards rather than passing Full witness parameters. Packed reads/stores retain canonical checked misses; integer reductions use integer memory lanes.",
  "checks": [
    {
      "in_func": "mvp_#_guarded_load",
      "expect_seq": [
        {
          "pattern": "lsh\t{{r:scaled}}, {{r}}, 3"
        },
        {
          "pattern": "add\t{{r:addr}}, {{r}}, {{r:scaled}}"
        },
        {
          "pattern": "dmov\t{{r}}, d:({{r:addr}})"
        }
      ],
      "expect": [
        "mov\t{{r}}, u32:(",
        "i64:40(",
        "call\t{{p}}, lambda_array_primitive_index,"
      ],
      "forbid": [
        "call\t{{p}}, lambda_type_check_lazy,"
      ]
    },
    {
      "in_func": "mvp_#_guarded_store",
      "expect_seq": [
        {
          "pattern": "and\t{{r}}, {{r}}, 4294979584"
        },
        {
          "pattern": "lsh\t{{r:scaled}}, {{r}}, 3"
        },
        {
          "pattern": "add\t{{r:addr}}, {{r}}, {{r:scaled}}"
        },
        {
          "pattern": "dmov\td:({{r:addr}}), {{r}}"
        }
      ],
      "expect": [
        "9.50000000000000000000000000000000000000000000000000000e+00",
        "call\t{{p}}, lambda_array_set_checked_item,"
      ]
    },
    {
      "in_func": "mvp_#_dense_int_sum",
      "forbid": [
        "call\t{{p}}, item_at,",
        "dmov\t{{r}}, d:({{r}})"
      ],
      "expect": [
        "mov\t{{r}}, i64:({{r}})"
      ]
    },
    {
      "in_func": "mvp_#_dense_int_linear_sum",
      "forbid": [
        "call\t{{p}}, item_at,",
        "dmov\t{{r}}, d:({{r}})"
      ],
      "expect": [
        "mov\t{{r}}, i64:({{r}})"
      ]
    }
  ]
}
