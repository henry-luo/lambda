{
  "schema_version": 1,
  "description": "Typed numeric-array loads retain their guarded fast path. A proven float procedure parameter validates the physical array guard before writing in place, preserving the caller-visible procedure ABI without a per-store whole-array scan.",
  "checks": [
    {
      "in_func": "_guarded_load_#",
      "expect_seq": [
        { "pattern": "mov\tidx_type_" },
        { "pattern": "eq\tidx_type_ok_" },
        { "pattern": "mov\tidx_flags_" },
        { "pattern": "and\tidx_shaped_" },
        { "pattern": "mov\tidx_elem_" },
        { "pattern": "eq\tidx_elem_ok_" },
        { "pattern": "call\titem_at_p, item_at" }
      ],
      "count": {
        "call\titem_at_p, item_at": 1
      }
    },
    {
      "in_func": "_guarded_store_#",
      "forbid": [
        "call\tlambda_array_set_checked_p, lambda_array_set_checked"
      ],
      "expect_seq": [
        { "pattern": "call\tensure_typed_array_p, ensure_typed_array" },
        { "pattern": "mov\tgtid_" },
        { "pattern": "eq\tgtidok_" },
        { "pattern": "call\tfn_array_set_p, fn_array_set" },
        { "pattern": "mov\tfitms_" }
      ]
    }
  ]
}
