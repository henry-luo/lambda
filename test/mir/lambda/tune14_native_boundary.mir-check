{
  "schema_version": 1,
  "description": "Tune14 A1 keeps proved float and integer array paths on native MIR lanes, preserves the same-contract array witness across rebinding, and retains generic admission for a widened any[] control.",
  "checks": [
    {
      "in_func": "mvp_#_tune14_float_sum",
      "expect": [
        "call\t{{p}}, lambda_type_check_lazy,",
        "dadd\t{{r}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_add,"
      ]
    },
    {
      "in_func": "mvp_#_tune14_bitwise",
      "expect": [
        "call\t{{p}}, lambda_type_check_lazy,",
        "rsh\t{{r}}",
        "and\t{{r}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_shr_item,",
        "call\t{{p}}, fn_band_item,",
        "call\t{{p}}, fn_int,"
      ]
    },
    {
      "in_func": "mvp_#_tune14_rebind",
      "expect": [
        "call\t{{p}}, lambda_type_check_lazy,",
        "mov\t{{r}}, i64:({{r}})",
        "add\t{{r}}, {{r}}, {{r}}"
      ],
      "forbid": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, fn_add,"
      ]
    },
    {
      "in_func": "mvp_#_tune14_widened",
      "expect": [
        "call\t{{p}}, fn_index,",
        "call\t{{p}}, fn_add,"
      ],
      "forbid": [
        "call\t{{p}}, ensure_typed_array,"
      ]
    }
  ]
}
