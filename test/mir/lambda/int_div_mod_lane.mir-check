{
  "schema_version": 1,
  "description": "Exact int div/mod use native signed lanes for finite operands while retaining the shared poison slow arm.",
  "checks": [
    {
      "in_func": "mvp_#_lane_div",
      "forbid": [
        "call\t{{p}}, fn_idiv,",
        "call\t{{p}}, fn_mod,",
        "call\t{{p}}, fmod,",
        "call\t{{p}}, lambda_numeric_boundary_admit,"
      ],
      "expect": [
        "div\t%r",
        "call\t{{p}}, lambda_int_lane_divmod_slow,"
      ]
    },
    {
      "in_func": "mvp_#_lane_mod",
      "forbid": [
        "call\t{{p}}, fn_idiv,",
        "call\t{{p}}, fn_mod,",
        "call\t{{p}}, fmod,",
        "call\t{{p}}, lambda_numeric_boundary_admit,"
      ],
      "expect": [
        "mod\t%r",
        "call\t{{p}}, lambda_int_lane_divmod_slow,"
      ]
    }
  ]
}
