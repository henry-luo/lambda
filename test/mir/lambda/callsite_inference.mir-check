{
  "schema_version": 1,
  "description": "Tune4 M2 / v5: the closed integer caller set emits native i64 subtraction with a band guard, while an escaped callee keeps generic arithmetic for unseen float callers.",
  "checks": [
    {
      "in_func": "_closed_gap_#",
      "expect": [
        "sub\tia_raw_"
      ],
      "forbid": [
        "call\tfn_sub_p, fn_sub"
      ]
    },
    {
      "in_func": "_open_gap_#",
      "expect": [
        "sub\tia_raw_"
      ]
    },
    {
      "in_func": "_open_gap_b_#",
      "expect": [
        "call\tfn_sub_p, fn_sub"
      ]
    }
  ]
}
