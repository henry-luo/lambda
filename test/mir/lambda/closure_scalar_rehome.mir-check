{
  "schema_version": 1,
  "description": "Bound-entry wrapper epilogue. Return convention 3 (RV12 slot transport): the wrapper is the C-reachable entry, so it takes no caller home at all — it builds the pending pair, stores lane 2 into Context::mir_companion_slot, restores the watermark, and returns a single result.",
  "checks": [
    {
      "in_func": "_inner_b_#",
      "return_convention": 3,
      "forbid": [
        "_scalar_home",
        "lambda_item_adopt_scalar_home",
        "lambda_item_heap_rehome"
      ],
      "expect_seq": [
        { "pattern": "ursh\t" },
        { "pattern": "ubgt\t" },
        { "pattern": "mov\ti64:" },
        { "pattern": "ret\t" }
      ]
    }
  ]
}
