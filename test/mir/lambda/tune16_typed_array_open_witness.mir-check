{
  "schema_version": 1,
  "description": "Tune16 C4.1 keeps an open typed-array source on the native call edge and admits it once at the caller.",
  "checks": [
    {
      "in_func": "_main_#",
      "expect": [
        "call\t_tune16_open_consumer_"
      ],
      "forbid": [
        "call\t_tune16_open_consumer_#_b"
      ]
    },
    {
      "in_func": "_main_#",
      "expect": [
        "call\tlambda_type_check_p, lambda_type_check"
      ]
    }
  ]
}
