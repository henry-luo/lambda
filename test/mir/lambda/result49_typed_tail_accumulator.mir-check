      "expect": [
        "call\t{{p}}, fn_join_fresh_array_item,"
      ],
      "count": {
        "call\t{{p}}, fn_join_fresh_array_item,": 1
      },
      "forbid": [
        "call\t{{p}}, array_plain,",
        "call\t{{p}}, array_end,",
