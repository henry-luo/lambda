        "call\t{{p}}, array_end,",
        "call\t{{p}}, fn_join,"
      ]
    },
    {
      "in_func": "mvp_#_build_pair",
      "expect": [
        "call\t{{p}}, fn_join_fresh_array_item,"
      ],
      "count": {
        "call\t{{p}}, fn_join_fresh_array_item,": 2
      },
      "forbid": [
        "call\t{{p}}, array_plain,",
        "call\t{{p}}, array_end,",
        "call\t{{p}}, fn_join,"
      ]
    },
    {
