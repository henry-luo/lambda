{
  "schema_version": 1,
  "description": "D4.2.5/S7.1.1v3: a dominated nullable receiver reads the packed string pointer. Unguarded/rebound receivers retain absence and member misses; MVP uses full named-field lookup for declared contracts.",
  "checks": [
    {
      "in_func": "mvp_#_guarded",
      "expect": [
        "mov\t{{r}}, i64:({{r}})"
      ],
      "count": {
        "call\t{{p}}, fn_member,": 1
      }
    },
    {
      "in_func": "mvp_#_unguarded",
      "expect": [
        "call\t{{p}}, fn_member,"
      ],
      "count": {
        "call\t{{p}}, fn_member,": 1
      }
    },
    {
      "in_func": "mvp_#_rebound",
      "expect": [
        "call\t{{p}}, fn_member,"
      ],
      "count": {
        "call\t{{p}}, fn_member,": 1
      }
    }
  ]
}
