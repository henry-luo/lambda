{
  "schema_version": 1,
  "description": "D2.8.2/D8.2.4v2: guarded float result loads retain OOB, while defect and rebound receivers keep the boxed read.",
  "checks": [
    {"in_func": "_read_probabilities_#", "expect": ["dmov\t{{r}}, d:("]},
    {"in_func": "_changed_probabilities_#", "expect": ["call\tfn_index_p, fn_index"]},
    {"in_func": "_main_#", "expect": ["call\tfn_index_p, fn_index"]},
    {"in_func": "_guarded_fill_#", "expect": ["call\tfn_fill_p, fn_fill", "call\t_first_value_"],
     "forbid": ["call\tlambda_type_check_p, lambda_type_check"]}
  ]
}
