{
  "schema_version": 1,
  "description": "D2.5.2/D8.2.4: guarded float result loads retain OOB, while defect and rebound receivers keep the boxed read.",
  "checks": [
    {"in_func": "mvp_#_read_probabilities", "expect": ["dmov\t{{r}}, d:("]},
    {"in_func": "mvp_#_changed_probabilities", "expect": ["call\t{{p}}, fn_index,"]},
    {"in_func": "mvp_#_main", "expect": ["call\t{{p}}, fn_index,"]},
    {"in_func": "mvp_#_guarded_fill", "expect": ["call\t{{p}}, fn_fill,", "call\tmvp_{{n}}_first_value_dp"],
     "forbid": ["call\t{{p}}, lambda_type_check_lazy,"]}
  ]
}
