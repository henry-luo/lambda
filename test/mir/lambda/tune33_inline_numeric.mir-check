{
  "schema_version": 1,
  "description": "S4.1.2/S4.1.5: bounded recursive expansion keeps a real deeper call; nested leaves inline, and fallible sized declarations retain their checked boundary.",
  "checks": [
    {
      "in_func": "_recursive_sum_#",
      "count": {
        "call\t_recursive_sum_": 1
      }
    },
    {
      "in_func": "_nested_#",
      "forbid": [
        "call\t_twice_"
      ]
    },
    {
      "in_func": "_main_#",
      "expect": [
        "lambda_type_check"
      ]
    },
    {
      "in_func": "_tail_div_#",
      "forbid": [
        "call\t_tail_div_"
      ]
    }
  ]
}
