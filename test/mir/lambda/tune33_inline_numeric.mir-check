{
  "schema_version": 1,
  "description": "S4.1.2/S4.1.5: bounded recursive expansion keeps a real deeper call; nested leaves inline, and fallible sized declarations retain their checked boundary.",
  "checks": [
    {
      "in_func": "mvp_#_recursive_sum",
      "count": {
        "call\tmvp_{{n}}_recursive_sum_dp": 1
      }
    },
    {
      "in_func": "mvp_#_nested",
      "forbid": [
        "call\tmvp_{{n}}_twice_dp"
      ]
    },
    {
      "in_func": "mvp_#_main",
      "expect": [
        "lambda_type_check_lazy"
      ]
    },
    {
      "in_func": "mvp_#_tail_div",
      "forbid": [
        "call\tmvp_{{n}}_tail_div_dp"
      ]
    }
  ]
}
