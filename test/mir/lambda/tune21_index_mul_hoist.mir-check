{
  "schema_version": 1,
  "description": "D2.3.4/D4.3.3: the MVP closed numeric region multiplies the native index, adds the peer index and loads its scaled float address without flag-carrying overflow or double-lane validity tests.",
  "checks": [
    {
      "in_func": "mvp_#_dot_rows",
      "forbid": [
        "mulo\t",
        "bo\t",
        "xor\t{{r}}, {{r}}, 9223372036854775807",
        "ult\t{{r}}, {{r}}, 67108864"
      ],
      "expect_seq": [
        "mul\t{{r:product}}, {{r}}, {{r}}",
        "add\t{{r:index}}, {{r:product}}, {{r}}",
        "lsh\t{{r:offset}}, {{r:index}}, 3",
        "add\t{{r:address}}, {{r}}, {{r:offset}}",
        "dmov\t{{r}}, d:({{r:address}})"
      ],
      "in_range": {
        "from": "\tmul\t",
        "to": "dadd\t"
      }
    }
  ]
}
