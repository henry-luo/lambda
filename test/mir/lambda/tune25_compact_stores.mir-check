{
  "schema_version": 1,
  "description": "D4.3.3/S9.1.2: exact compact numeric stores guard physical lane, unique ownership and bounds before native byte/word writes. Conversion, views and shared snapshots retain the canonical checked setter.",
  "checks": [
    {
      "in_func": "mvp_#_bytes",
      "expect": [
        "mov\tu8:",
        "and\t{{r}}, {{r}}, 4294979584",
        "call\t{{p}}, lambda_array_set_checked_item,"
      ]
    },
    {
      "in_func": "mvp_#_widths",
      "expect": [
        "mov\tu8:",
        "mov\tu16:",
        "mov\tu32:",
        "call\tlambda_array_set_checked_item"
      ]
    }
  ]
}
