{
  "schema_version": 1,
  "description": "D4.2.5/D6.2.1: MVP uses pointer result lanes with native record slots and companion error transport. Recursive calls remain direct; the boxed entry admits dynamic fields before filling their declared offsets.",
  "checks": [
    {
      "in_func": "mvp_#_render",
      "expect": [
        "p, i64, p:runtime",
        "call\tmvp_{{n}}_render_dp",
        "call\tmvp_{{n}}_result_dp",
        "p:16("
      ],
      "forbid": [
        "call\t{{p}}, map_fill,",
        "call\t{{p}}, fn_call_into,"
      ]
    },
    {
      "in_func": "mvp_#_project",
      "expect": [
        "call\tmvp_{{n}}_render_dp",
        "call\t{{p}}, fn_member,",
        "p:16("
      ],
      "forbid": [
        "call\t{{p}}, map_fill,"
      ]
    },
    {
      "in_func": "mvp_#_result",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:data}}, p:16({{r}})"
        },
        {
          "pattern": "mov\ti64:({{r:data}}), {{r}}"
        }
      ],
      "expect": [
        "call\t{{p}}, map_alloc_for_type,",
        "call\t{{p}}, lambda_type_check_lazy,"
      ],
      "forbid": [
        "call\t{{p}}, map_fill,"
      ]
    }
  ]
}
