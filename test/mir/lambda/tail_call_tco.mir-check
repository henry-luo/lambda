{
  "schema_version": 1,
  "description": "Self-recursive tail call is turned into a counter-guarded loop: the function contains no call back into itself and retains the documented 1000000 iteration cap. Internal register spelling is deliberately opaque, so this checks the emitted loop shape rather than a diagnostic register name.",
  "checks": [
    {
      "in_func": "_factorial_#",
      "forbid": [
        "call\t_factorial_"
      ],
      "expect": [
        "add\t{{r}}, {{r}}, 1",
        "ble\t"
      ],
      "count": {
        ", 1000000": 1
      }
    }
  ]
}
