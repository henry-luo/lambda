{
  "schema_version": 1,
  "description": "Tune31 follow-on / D4.3.3: after source text is admitted as int[] code lanes, the repeated comparison loop emits raw lane equality and must not call string indexing or generic equality.",
  "checks": [
    {
      "in_func": "mvp_#_count_equal_codes",
      "expect": [
        "\tbne\t",
        "mov\t{{r}}, i64:({{r}})"
      ],
      "forbid": [
        "call\t{{p}}, fn_string_ascii_at,",
        "call\t{{p}}, fn_eq,"
      ]
    }
  ]
}
