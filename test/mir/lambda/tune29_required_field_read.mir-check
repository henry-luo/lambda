{
  "schema_version": 1,
  "description": "D4.2.6/S11.4.10: the enforced non-null prefix reads required child and scalar slots directly, without fallback member calls. Optional fields and nullable receivers retain their absence arms.",
  "checks": [
    {
      "in_func": "mvp_#_read_required",
      "expect_seq": [
        "mov\t{{r:parent_data}}, p:16({{r}})",
        "mov\t{{r:child}}, i64:8({{r:parent_data}})",
        "mov\t{{r:child_data}}, p:16({{r:child}})",
        "mov\t{{r}}, i64:({{r:child_data}})"
      ],
      "forbid": [
        "call\t{{p}}, fn_member,",
        "call\t{{p}}, fn_member_by_id,"
      ],
      "count": {
        "mov\t{{r}}, p:16({{r}})": 2
      }
    },
    {
      "in_func": "mvp_#_read_optional",
      "expect": [
        "beq\t",
        "72057594037927936"
      ]
    },
    {
      "in_func": "mvp_#_read_nullable_receiver",
