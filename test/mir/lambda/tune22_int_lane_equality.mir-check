{
  "schema_version": 1,
  "description": "T22-2a: equality and inequality on two nullable int[] reads have a raw integer arm for in-band lanes and retain the double-lane arm for null/nan/infinity semantics (S5.1.2, D2.2.2, D2.4.1). T28-7: when one operand is proven in band (a literal), a sentinel on the other side is out of band and the raw compare is already exact, so no double arm is emitted.",
  "checks": [
    {
      "in_func": "mvp_#_classify_tune22",
      "expect": [
        "\teq\t",
        "\tdeq\t",
        "\tne\t",
        "\tdne\t"
      ]
    },
    {
      "in_func": "mvp_#_classify_literal",
      "expect": [
        "\teq\t",
        "\tne\t"
      ],
      "forbid": [
        "\tdeq\t",
        "\tdne\t"
      ]
    }
  ]
}
