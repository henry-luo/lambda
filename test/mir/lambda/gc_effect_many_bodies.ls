pn gc_middle(x: int) int {
    var y = x
    while (y > 0) { y = y - 1 }
    return gc_leaf_69(x)
}

pn gc_after_many(s: string) int {
    return gc_middle(1) + len(s)
}

pn main() {
    print(gc_after_many("abc")); print("\n")
}
