{
  "schema_version": 1,
  "description": "D2.4.3, D6.2.1, D8.2.6: callback-capable numeric consumers retain the element snapshot, inherited-index lookup and RHS Get before either operand's ToPrimitive. Fixed coercion is ineligible.",
  "checks": [
    {
      "in_func": "mvp_lmd_f1",
      "expect_seq": [
        "call\tmvp_lmd_array_index_property",
        "call\tmvp_lmd_class_property",
        "call\tmvp_lmd_to_primitive",
        "call\tmvp_lmd_to_primitive",
        "dmul\t"
      ],
      "count": {
        "call\tmvp_lmd_to_primitive": 2,
        "call\tmvp_lmd_primitive_to_number": 2,
        "dmul\t": 1
      },
      "forbid": [
        "call\tmvp_lmd_to_primitive_fixed",
        "call\tmvp_lmd_primitive_to_number_fixed"
      ]
    }
  ]
}
