{
  "schema_version": 1,
  "description": "D8.4.1v2/D8.4.3v2: a Number-proven computed read uses the native-key element kernel while its write retains the canonical Set kernel.",
  "checks": [
    {
      "in_func": "_js_readRecord_#_body",
      "expect": [
        "call\tjs_get_name_id"
      ],
      "forbid": [
        "js_shaped_slot_get",
        "js_literal_shape"
      ]
    },
    {
      "in_func": "_js_writeRecord_#_body",
      "expect": [
        "call\tjs_get_name_id",
        "call\tjs_set_name_id"
      ],
      "forbid": [
        "js_shaped_slot_get",
        "js_literal_shape"
      ]
    },
    {
      "in_func": "_js_numericRegion_#_body",
      "expect": [
        "call\tjs_elements_get_number",
        "call\tjs_set"
      ],
      "forbid": [
        "js_get_number_reference",
        "js_set_number_assignment",
        "js_number_key_to_index_fast"
      ]
    }
  ]
}
