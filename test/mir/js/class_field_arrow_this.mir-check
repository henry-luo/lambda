{
  "schema_version": 1,
  "description": "D5.4, D6.2.2v2: a field arrow retains lexical this in the shared Lambda closure environment instead of consulting its caller receiver.",
  "checks": [
    {
      "in_func": "mvp_lmd_f3",
      "expect": [
        "call\theap_calloc_closure_env",
        "call\towned_item_slot_store"
      ]
    },
    {
      "in_func": "mvp_lmd_f4",
      "expect_seq": [
        {
          "pattern": "mov\t{{r:env}}, i64:24(self)"
        },
        {
          "pattern": "mov\t{{r}}, i64:({{r:env}})"
        }
      ],
      "forbid": [
        "js_get_current_this",
        "js_resolve_lexical_this"
      ]
    }
  ]
}
