{
  "schema_version": 1,
  "description": "Dynamic JS calls address fixed argument-root slots in the generated function frame and do not pay a per-call save, push, or restore protocol.",
  "checks": [
    {
      "in_func": "_js_callDynamic_#_body",
      "expect_seq": [
        { "pattern": "add\t{{r}}, {{r}}, 0" },
        { "pattern": "call\tjs_call_function_prerooted_args_into_p" }
      ],
      "forbid": [
        "js_args_save",
        "js_args_push",
        "js_args_restore"
      ]
    }
  ]
}
