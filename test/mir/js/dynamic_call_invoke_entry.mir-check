{
  "schema_version": 1,
  "description": "JC18: a dynamic call site guards on callee layout (container pointer, JS-layout LMD_TYPE_FUNC, published invoke), selects the stored [[Call]] entry or, on a miss, the observably identical js_call, and makes one indirect call under js_call's proto. The displacement is offsetof(JsFunction, invoke): 104 since JsFunction derives from the 72-byte Lambda Function base (919d24a12), 40 before; the emitter reads it through js_function_offset(&JsFunction::invoke), so a layout change moves this number and nothing else.",
  "checks": [
    {
      "in_func": "_js_callDyn_#_body",
      "expect_seq": [
        { "pattern": "ursh\t{{r:callee_tag}}, {{r:callee}}, 56" },
        { "pattern": "mov\t{{r}}, u8:({{r:callee}})" },
        { "pattern": "mov\t{{r}}, u8:3({{r:callee}})" },
        { "pattern": "mov\t{{r:target}}, p:104({{r:callee}})" },
        { "pattern": ", {{r:target}}, 0" },
        { "pattern": "mov\t{{r:target}}, js_call" },
        { "pattern": "call\tjs_call_p_r6_n1_a6, {{r:target}}, {{r}}, {{r:callee}}" }
      ],
      "forbid": [
        "js_call_function_prerooted_args_into",
        "js_call_function_into"
      ]
    }
  ]
}
