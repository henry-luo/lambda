{
  "schema_version": 1,
  "description": "D6.2.2v2, D8.1.3v25: formal callable dispatch reads Function.entry_abi and Function.ptr, guards the owning context/unit and preserves its semantic fallback.",
  "checks": [
    {
      "in_func": "mvp_lmd_f2",
      "expect": [
        "u8:3(",
        "i64:40(",
        "i64:72("
      ],
      "expect_seq": [
        {
          "pattern": "mov\t{{r:entry}}, i64:16({{r:callee}})"
        },
        {
          "pattern": "mov\ti64:({{r:args}}),"
        },
        {
          "pattern": "call\tmvp_lmd_class_invoke_p_r6_n1_a5, mvp_lmd_class_invoke,"
        },
        {
          "pattern": "mov\ti64:80(runtime), {{r}}"
        },
        {
          "pattern": "call\tmvp_lmd_signature, {{r:entry}}, {{r}}, runtime, {{r}}, {{r:args}},"
        }
      ],
      "count": {
        "call\tmvp_lmd_signature,": 1
      },
      "forbid": [
        "js_args_save",
        "js_args_push",
        "js_args_restore",
        "js_call_function_into",
        "js_call_function_prerooted_args_into"
      ]
    }
  ]
}
