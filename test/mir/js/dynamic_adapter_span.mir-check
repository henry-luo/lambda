{
  "schema_version": 1,
  "description": "Dynamic JS calls reserve rooted source argument spans; adaptation remains in the runtime boundary.",
  "checks": [
    {
      "in_func": "_js_invoke2_#_body",
      "expect_seq": [
        { "pattern": "add\t{{r}}, {{r}}, 0" },
        { "pattern": "call\tjs_call_function_prerooted_args_into_p" }
      ],
      "forbid": [
        "js_args_save",
        "js_args_push",
        "js_args_restore"
      ]
    },
    {
      "in_func": "_js_invokeMany_#_body",
      "expect_seq": [
        { "pattern": "call\tjs_call_function_prerooted_args_into_p" }
      ]
    }
  ]
}
