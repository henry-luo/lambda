// Native Lambda port of test/interp/gen_bench.py.
pn generate(lines: int) {
    var source = "// generated by test/interp/gen_bench.py — do not edit\nlet seed = 7\n"
    var previous = "seed"
    var i = 0
    while (i < lines) {
        let name = "v" ++ string(i)
        let op = if (i % 3 == 0) "+" else if (i % 3 == 1) "-" else "*"
        source = source ++ "let " ++ name ++ " = (" ++ previous ++ " " ++ op ++ " " ++
                 string(i % 97 + 1) ++ ") + " ++ string(i % 13) ++ "\n"
        previous = name
        i = i + 1
    }
    source ++ previous ++ "\n"
}

pn write_benchmarks(out_dir: string, sizes) {
    io.mkdir(out_dir)^
    for (size in sizes) {
        let path = out_dir ++ "/gen_" ++ string(size) ++ ".ls"
        let written = output(generate(size), path, "text")^
        print(path ++ "\n")
    }
    return
}

pn main() {
    write_benchmarks("temp/interp_bench", [1000, 5000, 20000])
    return
}
