flowchart TB
  A["call / new expression lowered"]
  S["jm_begin_arg_stack_scope<br/>JsMirArgStackScope, saved arg_frame_depth"]
  P["jm_build_args_array<br/>next arg_frame_depth slots at compile time<br/>(end of caller's side-root frame)"]
  F["JIT fills slots<br/>(nested calls take higher slots)"]
  PR{"jm_args_are_prerooted?"}
  K1["js_call / invoke<br/>args_prerooted = 1: no re-root"]
  K2["copying path (generators, suspending args)<br/>kernel roots one owned RootSpan"]
  E["jm_end_arg_stack_scope<br/>zero slots, restore depth"]
  X["error-lane exit<br/>jm_clear_active_arg_frames"]
  N["C / native caller<br/>args_prerooted = 0: kernel RootSpan"]
  AST["AST call site<br/>RootSpan, passed pre-rooted"]

  A --> S --> P --> F --> PR
  PR -->|yes| K1
  PR -->|no| K2
  K1 --> E
  K2 --> E
  F -.-> X
  N -.-> K2
  AST -.-> K1
