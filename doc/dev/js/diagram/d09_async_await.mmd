sequenceDiagram
    autonumber
    participant Caller
    participant async_drive
    participant activation as body on its activation
    participant result_promise
    participant awaited_promise
    Caller->>async_drive: js_async_context_create then js_async_start
    async_drive->>activation: js_suspended_activation_step (create + resume)
    activation->>activation: run to an await, js_await_park(v)
    activation-->>async_drive: parked, payload = PromiseResolve(v)
    async_drive->>awaited_promise: js_promise_then resume and reject handlers
    async_drive-->>Caller: return pending result promise
    awaited_promise->>async_drive: microtask js_async_resume_handler(value)
    async_drive->>activation: resume, js_await_park returns value
    activation-->>async_drive: done, body returned value or error Item
    async_drive->>result_promise: resolve with value, or reject with error payload
