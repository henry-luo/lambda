flowchart TD
    SRC["JS/TS source text (const char*, length)"]
    LEX["js_lexer.c<br/>lexical goals: regexp vs division, templates"]
    PARSE["js_parser.c<br/>recursive descent + JS/TS Pratt loops"]
    ERR{"parse error?"}
    REJECT["JsParseError<br/>original span + expected tokens"]
    SINK["js_c_reduce<br/>direct JsAstNode construction"]
    SCOPE["js_rebuild_direct_scope_graph"]
    AST["typed indexed JsAstNode tree"]
    EE["js_check_early_errors"]
    REF["lambda-cst only<br/>Tree-sitter JS/TS acceptance reference"]

    SRC --> LEX --> PARSE --> ERR
    ERR -- yes --> REJECT
    ERR -- no --> SINK --> SCOPE --> AST --> EE
    SRC -. differential only .-> REF
