stateDiagram-v2
    direction TB
    [*] --> Binding : "js_generator_create (MIR steps it now)"
    Binding : "Bind params on the activation"
    Binding : "then js_gen_park(undefined, YIELD)"
    Parked : "Parked in place (gen->state = park kind)"
    Parked : "native stack + root segment kept"
    Running : "Body running on its own stack"
    Delegate : "yield* delegate active (driver steps it)"
    Done : "Done (activation destroyed)"

    Binding --> Parked : "implicit param-binding park"
    Parked --> Running : "next(v): js_generator_step resumes with v"
    Parked --> Running : "return/throw: resume via next with a signal"
    Running --> Parked : "yield v: js_gen_park(v, YIELD)"
    Running --> Parked : "await p (async gen): js_gen_park(p, AWAIT)"
    Running --> Delegate : "yield* it: js_gen_park(it, DELEGATE)"
    Delegate --> Delegate : "next(v): js_yield_delegate_next_result"
    Delegate --> Running : "delegate done: resume yield* with its value"
    Running --> Done : "body returns value or error Item"
    Done --> [*]
