flowchart TB
  subgraph lane["merged Item error lane (D8.4.3)"]
    SV["js_throw_value(v):<br/>returns ERROR-tagged<br/>LambdaError Item"]
    CK["jm_emit_error_lane_test:<br/>test returned Item tag"]
    CL["js_error_lane_payload:<br/>unwrap at catch/rejection/host boundary"]
  end

  subgraph emit["per-call propagation (jm_emit_error_lane_route)"]
    P{"topmost non-yield try ctx?"}
    PT["MIR_BT to catch_label / finally_label"]
    PF["MIR_BT to func_error_lane_label<br/>(return ERROR Item from function)"]
  end

  subgraph trycf["try / catch / finally lowering"]
    PUSH["push JsTryContext on try_ctx_stack[16]:<br/>catch_label, finally_label, end_label,<br/>return_val_reg, has_return_reg"]
    TRY["try body: after each stmt,<br/>route returned ERROR Item to catch/finally"]
    CATCH["catch: js_args_restore + js_with_restore,<br/>thrown = js_error_lane_payload,<br/>bind param, run body"]
    FIN["finally: save routed ERROR Item,<br/>run body, re-throw saved lane<br/>unless body returned a new one"]
  end

  subgraph so["stack overflow (lambda-stack.cpp)"]
    ARM["sigsetjmp(_lambda_recovery_point);<br/>_lambda_recovery_armed = 1"]
    SIG["SIGSEGV on alt stack → if armed,<br/>siglongjmp back"]
    RNG["js_throw_range_error('Maximum call stack size exceeded')"]
  end

  SV --> CK --> CL
  P -->|inside try| PT
  P -->|outside| PF
  PUSH --> TRY --> CATCH
  TRY --> FIN
  ARM --> SIG --> RNG --> SV
