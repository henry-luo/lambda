flowchart TD
    Start(["require or import specifier"]) --> Cache{"js_module_get hit?"}
    Cache -->|yes| Ret["return cached namespace or default export"]
    Cache -->|no| Read["read_text_file path"]
    Read --> Kind{"CJS file? js_is_cjs_file"}
    Kind -->|cjs / js| Wrap["js_wrap_cjs_source: prefix module/exports, suffix export default"]
    Kind -->|mjs / esm| Raw["use source as-is"]
    Wrap --> Mod["transpile_js_module_to_mir"]
    Raw --> Mod
    Mod --> Enter["js_tla_enter_module depth++"]
    Enter --> Scope["one RuntimeExecutionScope for the graph; outermost inits the event loop"]
    Scope --> Reg["register placeholder namespace"]
    Reg --> Compile["lower module, detect top-level await"]
    Compile --> Imports["jm_load_imports: recurse deps first, register async parents"]
    Imports --> Link["js_mir_link_main; reserve and activate module state slab"]
    Link --> Carrier{"TLA nested or dynamic, or pending_async_deps &gt; 0?"}
    Carrier -->|no| RunBody["js_main returns namespace object"]
    Carrier -->|yes| MakeCarrier["js_async_context_create_module"]
    MakeCarrier --> Pending{"pending_async_deps &gt; 0?"}
    Pending -->|yes| Defer["park carrier in descriptor; the ready scan starts it"]
    Pending -->|no| Start2["js_async_start: js_main runs on the carrier, parks at each await"]
    RunBody --> Entry{"entry module?"}
    Defer --> Entry
    Start2 --> Entry
    Entry -->|yes| DrainE["flush microtasks, js_event_loop_drain"]
    Entry -->|no| Exit
    DrainE --> Exit["js_tla_exit_module depth--, ready scan at depth 0; defer MIR cleanup"]
    Exit --> Ret
