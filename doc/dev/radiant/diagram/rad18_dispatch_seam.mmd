flowchart TD
    PLATFORM["Platform, automation, or replay input"]
    KEY["DOM keydown; canceled key suppresses correlated text"]
    INTENT["Normalize EditingIntent and resolve canonical contenteditable host"]
    PREPARE["Prepare immutable ranges/selection, route, and one registry snapshot"]
    E0["Record mutation epoch E0"]
    BEFORE["Cancelable beforeinput notification"]
    E1["Record mutation epoch E1"]
    GUARD{"Canceled or E1 differs from E0?"}
    ACTION["Invoke one selected action synchronously"]
    ROUTE{"Selected action route"}
    DOM["dom-compat: narrow text/selection/composition mutation"]
    TEMPLATE["radiant-template: model handler and reconciliation"]
    VERIFY["Verify E2, DOM/model/selection outcome"]
    INPUT["Non-cancelable input notification on claim or change"]
    BATCH["One retained dispatch batch; observer checkpoint follows input"]

    PLATFORM --> KEY --> INTENT --> PREPARE --> E0 --> BEFORE --> E1 --> GUARD
    GUARD -- no --> ACTION
    ACTION --> ROUTE
    ROUTE -- DOM-script --> DOM --> VERIFY
    ROUTE -- template --> TEMPLATE --> VERIFY
    GUARD -- yes --> BATCH
    VERIFY --> INPUT --> BATCH
