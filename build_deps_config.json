{
  "description": "Lambda dependency recipes and input-owned native target interfaces",
  "config_imports": [
    {
      "path": "../lambda-input/build_native_deps_config.json",
      "root_env": "LAMBDA_INPUT_ROOT",
      "root_path": "build_native_deps_config.json",
      "include_keys": ["targets"]
    }
  ],
  "dependency_builds": {
    "googletest": {
      "source_dir": "build_temp/googletest",
      "projects": [
        {
          "name": "gtest",
          "lang": "c++17",
          "source_files": [
            "${source}/googletest/src/gtest-all.cc"
          ],
          "includes": [
            "${source}/googletest",
            "${source}/googletest/include"
          ],
          "defines": [],
          "install_archive": "lib/libgtest.a"
        },
        {
          "name": "gtest_main",
          "lang": "c++17",
          "source_files": [
            "${source}/googletest/src/gtest_main.cc"
          ],
          "includes": [
            "${source}/googletest/include"
          ],
          "defines": [],
          "install_archive": "lib/libgtest_main.a"
        },
        {
          "name": "gmock",
          "lang": "c++17",
          "source_files": [
            "${source}/googlemock/src/gmock-all.cc"
          ],
          "includes": [
            "${source}/googlemock",
            "${source}/googlemock/include",
            "${source}/googletest/include"
          ],
          "defines": [],
          "install_archive": "lib/libgmock.a"
        },
        {
          "name": "gmock_main",
          "lang": "c++17",
          "source_files": [
            "${source}/googlemock/src/gmock_main.cc"
          ],
          "includes": [
            "${source}/googlemock/include",
            "${source}/googletest/include"
          ],
          "defines": [],
          "install_archive": "lib/libgmock_main.a"
        }
      ],
      "install_files": [
        {
          "source": "${source}/googletest/include/gtest",
          "destination": "include/gtest",
          "directory": false
        },
        {
          "source": "${source}/googlemock/include/gmock",
          "destination": "include/gmock",
          "directory": false
        }
      ]
    },
    "libpq": {
      "source_dir": "mac-deps/rdb/build/postgresql-18.6",
      "prepare": [
        {
          "directory": "${build}/configure",
          "command": [
            "${source}/configure",
            "--prefix=${prefix}",
            "--without-gssapi",
            "--without-ldap",
            "--without-icu",
            "--without-readline",
            "--without-zlib",
            "--without-lz4",
            "--without-zstd",
            "--disable-nls",
            "--without-libxml",
            "--without-libxslt",
            "--without-pam",
            "--without-bonjour",
            "--without-selinux",
            "--without-systemd",
            "--without-libcurl"
          ],
          "cache": true,
          "outputs": [
            "${build}/configure/src/include/pg_config.h",
            "${build}/configure/src/Makefile.global"
          ]
        },
        {
          "directory": "${build}/configure",
          "command": [
            "make",
            "-C",
            "src/backend",
            "generated-headers"
          ]
        },
        {
          "directory": "${build}/configure",
          "command": [
            "make",
            "-C",
            "src/port",
            "pg_config_paths.h"
          ]
        },
        {
          "directory": "${build}/configure",
          "command": [
            "make",
            "-C",
            "src/common",
            "kwlist_d.h"
          ]
        }
      ],
      "projects": [
        {
          "name": "pq",
          "lang": "c17",
          "source_files": [],
          "includes": [
            "${build}/configure/src/common",
            "${build}/configure/src/include",
            "${source}/src/include",
            "${source}/src/interfaces/libpq",
            "${build}/configure/src/interfaces/libpq",
            "${build}/configure/src/port",
            "${source}/src/port",
            "${source}/src/common"
          ],
          "defines": [
            "SO_MAJOR_VERSION=5"
          ],
          "install_archive": "lib/libpq.a",
          "make_sources": {
            "directory": "${build}/configure/src/interfaces/libpq",
            "source_directory": "${source}/src/interfaces/libpq",
            "variables": [
              "OBJS",
              "OBJS_STATIC"
            ],
            "make_variables": {
              "WIN32RES": ""
            }
          }
        },
        {
          "name": "pgcommon_shlib",
          "lang": "c17",
          "source_files": [
            "${source}/src/common/archive.c",
            "${source}/src/common/base64.c",
            "${source}/src/common/binaryheap.c",
            "${source}/src/common/blkreftable.c",
            "${source}/src/common/checksum_helper.c",
            "${source}/src/common/compression.c",
            "${source}/src/common/controldata_utils.c",
            "${source}/src/common/encnames.c",
            "${source}/src/common/exec.c",
            "${source}/src/common/file_perm.c",
            "${source}/src/common/file_utils.c",
            "${source}/src/common/hashfn.c",
            "${source}/src/common/ip.c",
            "${source}/src/common/jsonapi.c",
            "${source}/src/common/keywords.c",
            "${source}/src/common/kwlookup.c",
            "${source}/src/common/link-canary.c",
            "${source}/src/common/md5_common.c",
            "${source}/src/common/parse_manifest.c",
            "${source}/src/common/percentrepl.c",
            "${source}/src/common/pg_get_line.c",
            "${source}/src/common/pg_lzcompress.c",
            "${source}/src/common/pg_prng.c",
            "${source}/src/common/pgfnames.c",
            "${source}/src/common/psprintf.c",
            "${source}/src/common/relpath.c",
            "${source}/src/common/rmtree.c",
            "${source}/src/common/saslprep.c",
            "${source}/src/common/scram-common.c",
            "${source}/src/common/string.c",
            "${source}/src/common/stringinfo.c",
            "${source}/src/common/unicode_case.c",
            "${source}/src/common/unicode_category.c",
            "${source}/src/common/unicode_norm.c",
            "${source}/src/common/username.c",
            "${source}/src/common/wait_error.c",
            "${source}/src/common/wchar.c",
            "${source}/src/common/cryptohash.c",
            "${source}/src/common/hmac.c",
            "${source}/src/common/md5.c",
            "${source}/src/common/sha1.c",
            "${source}/src/common/sha2.c",
            "${source}/src/common/restricted_token.c",
            "${source}/src/common/sprompt.c"
          ],
          "includes": [
            "${build}/configure/src/common",
            "${build}/configure/src/include",
            "${source}/src/include",
            "${source}/src/interfaces/libpq",
            "${build}/configure/src/interfaces/libpq",
            "${build}/configure/src/port",
            "${source}/src/port",
            "${source}/src/common"
          ],
          "defines": [
            "FRONTEND",
            "JSONAPI_USE_PQEXPBUFFER"
          ],
          "install_archive": "lib/libpgcommon_shlib.a"
        },
        {
          "name": "pgport_shlib",
          "lang": "c17",
          "source_files": [],
          "includes": [
            "${build}/configure/src/common",
            "${build}/configure/src/include",
            "${source}/src/include",
            "${source}/src/interfaces/libpq",
            "${build}/configure/src/interfaces/libpq",
            "${build}/configure/src/port",
            "${source}/src/port",
            "${source}/src/common"
          ],
          "defines": [
            "FRONTEND"
          ],
          "install_archive": "lib/libpgport_shlib.a",
          "make_sources": {
            "directory": "${build}/configure/src/port",
            "source_directory": "${source}/src/port",
            "variable": "OBJS",
            "file_flags": {
              "${source}/src/port/pg_crc32c_armv8.c": "CFLAGS_CRC",
              "${source}/src/port/pg_crc32c_sse42.c": "CFLAGS_CRC"
            }
          }
        }
      ],
      "install_files": [
        {
          "source": "${source}/src/interfaces/libpq/libpq-fe.h",
          "destination": "include/libpq-fe.h",
          "directory": false
        },
        {
          "source": "${source}/src/include/postgres_ext.h",
          "destination": "include/postgres_ext.h",
          "directory": false
        }
      ]
    },
    "mariadb": {
      "source_dir": "mac-deps/rdb/build/mariadb-connector-c-3.3.21",
      "projects": [
        {
          "name": "mariadbclient",
          "lang": "gnu17",
          "source_files": [
            "${source}/plugins/auth/my_auth.c",
            "${source}/plugins/compress/c_zlib.c",
            "${source}/plugins/pvio/pvio_socket.c",
            "${source}/libmariadb/ma_array.c",
            "${source}/libmariadb/ma_charset.c",
            "${source}/libmariadb/ma_decimal.c",
            "${source}/libmariadb/ma_hashtbl.c",
            "${source}/libmariadb/ma_net.c",
            "${source}/libmariadb/mariadb_charset.c",
            "${source}/libmariadb/ma_time.c",
            "${source}/libmariadb/ma_default.c",
            "${source}/libmariadb/ma_errmsg.c",
            "${source}/libmariadb/mariadb_lib.c",
            "${source}/libmariadb/ma_list.c",
            "${source}/libmariadb/ma_pvio.c",
            "${source}/libmariadb/ma_tls.c",
            "${source}/libmariadb/ma_alloc.c",
            "${source}/libmariadb/ma_compress.c",
            "${source}/libmariadb/ma_init.c",
            "${source}/libmariadb/ma_password.c",
            "${source}/libmariadb/ma_ll2str.c",
            "${source}/libmariadb/ma_sha1.c",
            "${source}/libmariadb/mariadb_stmt.c",
            "${source}/libmariadb/ma_loaddata.c",
            "${source}/libmariadb/ma_stmt_codec.c",
            "${source}/libmariadb/ma_string.c",
            "${source}/libmariadb/ma_dtoa.c",
            "${source}/libmariadb/mariadb_rpl.c",
            "${build}/generated/ma_client_plugin.c",
            "${source}/libmariadb/ma_io.c",
            "${source}/external/zlib/adler32.c",
            "${source}/external/zlib/compress.c",
            "${source}/external/zlib/crc32.c",
            "${source}/external/zlib/deflate.c",
            "${source}/external/zlib/gzclose.c",
            "${source}/external/zlib/gzlib.c",
            "${source}/external/zlib/gzread.c",
            "${source}/external/zlib/gzwrite.c",
            "${source}/external/zlib/infback.c",
            "${source}/external/zlib/inffast.c",
            "${source}/external/zlib/inflate.c",
            "${source}/external/zlib/inftrees.c",
            "${source}/external/zlib/trees.c",
            "${source}/external/zlib/uncompr.c",
            "${source}/external/zlib/zutil.c",
            "${source}/libmariadb/mariadb_dyncol.c",
            "${source}/libmariadb/mariadb_async.c",
            "${source}/libmariadb/ma_context.c"
          ],
          "includes": [
            "${build}/include",
            "${source}/include",
            "${source}/plugins/auth",
            "${source}/plugins/compress",
            "${source}/plugins/pvio",
            "${source}/libmariadb",
            "${build}/zlib",
            "${source}/external/zlib"
          ],
          "defines": [
            "HAVE_COMPRESS",
            "LIBMARIADB",
            "THREAD",
            "DBUG_OFF",
            "_XOPEN_SOURCE",
            "LIBICONV_PLUG"
          ],
          "install_archive": "lib/libmariadbclient.a"
        }
      ],
      "variables": {
        "PROTOCOL_VERSION": 10,
        "MARIADB_CLIENT_VERSION": "10.8.8",
        "MARIADB_BASE_VERSION": "mariadb-10.8",
        "MARIADB_VERSION_ID": 100808,
        "MARIADB_PORT": 3306,
        "MARIADB_UNIX_ADDR": "/tmp/mysql.sock",
        "CPACK_PACKAGE_VERSION": "3.3.21",
        "MARIADB_PACKAGE_VERSION_ID": 30321,
        "CMAKE_SYSTEM_NAME": "${system_name}",
        "CMAKE_SYSTEM_PROCESSOR": "${architecture}",
        "CMAKE_INSTALL_PREFIX": "${prefix}",
        "INSTALL_PLUGINDIR": "lib/mariadb/plugin",
        "default_charset": "",
        "CC_SOURCE_REVISION": "",
        "DEFAULT_CHARSET": "utf8mb4",
        "ENABLED_LOCAL_INFILE": "AUTO",
        "Z_HAVE_UNISTD_H": 1,
        "EXTERNAL_PLUGINS": "extern struct st_mysql_client_plugin_AUTH mysql_native_password_client_plugin;\nextern struct st_mysql_client_plugin_COMPRESSION zlib_client_plugin;\nextern struct st_mysql_client_plugin_PVIO pvio_socket_client_plugin;\n",
        "BUILTIN_PLUGINS": "  (struct st_mysql_client_plugin *)&mysql_native_password_client_plugin,\n  (struct st_mysql_client_plugin *)&zlib_client_plugin,\n  (struct st_mysql_client_plugin *)&pvio_socket_client_plugin,\n"
      },
      "probes": {
        "headers": {
          "HAVE_ALLOCA_H": "alloca.h",
          "HAVE_DLFCN_H": "dlfcn.h",
          "HAVE_FCNTL_H": "fcntl.h",
          "HAVE_FLOAT_H": "float.h",
          "HAVE_LIMITS_H": "limits.h",
          "HAVE_LINUX_LIMITS_H": "linux/limits.h",
          "HAVE_PWD_H": "pwd.h",
          "HAVE_SELECT_H": "select.h",
          "HAVE_STDDEF_H": "stddef.h",
          "HAVE_STDINT_H": "stdint.h",
          "HAVE_STDLIB_H": "stdlib.h",
          "HAVE_STDIO_H": "stdio.h",
          "HAVE_STRING_H": "string.h",
          "HAVE_SYS_IOCTL_H": "sys/ioctl.h",
          "HAVE_SYS_SELECT_H": "sys/select.h",
          "HAVE_SYS_SOCKET_H": "sys/socket.h",
          "HAVE_SYS_STREAM_H": "sys/stream.h",
          "HAVE_SYS_STAT_H": "sys/stat.h",
          "HAVE_SYS_SYSCTL_H": "sys/sysctl.h",
          "HAVE_SYS_TYPES_H": "sys/types.h",
          "HAVE_SYS_UN_H": "sys/un.h",
          "HAVE_UNISTD_H": "unistd.h",
          "HAVE_UCONTEXT_H": "ucontext.h",
          "HAVE_LOCALE_H": "locale.h",
          "HAVE_LANGINFO_H": "langinfo.h",
          "HAVE_POLL_H": "poll.h"
        },
        "expressions": {
          "HAVE_DLERROR": "&dlerror",
          "HAVE_DLOPEN": "&dlopen",
          "HAVE_GETPWUID": "&getpwuid",
          "HAVE_MEMCPY": "&memcpy",
          "HAVE_POLL": "&poll",
          "HAVE_STRTOK_R": "&strtok_r",
          "HAVE_STRTOL": "&strtol",
          "HAVE_STRTOLL": "&strtoll",
          "HAVE_STRTOUL": "&strtoul",
          "HAVE_STRTOULL": "&strtoull",
          "HAVE_TELL": "&tell",
          "HAVE_THR_SETCONCURRENCY": "&thr_setconcurrency",
          "HAVE_THR_YIELD": "&thr_yield",
          "HAVE_VASPRINTF": "&vasprintf",
          "HAVE_VSNPRINTF": "&vsnprintf",
          "HAVE_CUSERID": "&cuserid",
          "HAVE_SETLOCALE": "&setlocale",
          "HAVE_NL_LANGINFO": "&nl_langinfo"
        },
        "sizes": {
          "SIZEOF_CHARP": "char *",
          "SIZEOF_INT": "int",
          "SIZEOF_LONG": "long",
          "SIZEOF_LONG_LONG": "long long",
          "SIZEOF_SIZE_T": "size_t",
          "SIZEOF_SOCKLEN_T": "socklen_t"
        },
        "types": {
          "SOCKET_SIZE_TYPE": [
            "socklen_t",
            "int"
          ]
        }
      },
      "generated_files": [
        {
          "path": "${build}/include/ma_config.h",
          "template": "${source}/include/ma_config.h.in"
        },
        {
          "path": "${build}/include/mariadb_version.h",
          "template": "${source}/include/mariadb_version.h.in"
        },
        {
          "path": "${build}/generated/ma_client_plugin.c",
          "template": "${source}/libmariadb/ma_client_plugin.c.in"
        },
        {
          "path": "${build}/zlib/zconf.h",
          "template": "${source}/external/zlib/zconf.h.cmakein"
        }
      ],
      "install_files": [
        {
          "source": "${source}/include/*.h",
          "destination": "include/mariadb",
          "directory": true
        },
        {
          "source": "${build}/include/*.h",
          "destination": "include/mariadb",
          "directory": true
        },
        {
          "source": "${source}/include/mysql/*.h",
          "destination": "include/mariadb/mysql",
          "directory": true
        }
      ]
    },
    "typemeta-extract": {
      "source_dir": "utils",
      "queries": [
        {
          "name": "llvm_include",
          "tool": "llvm-config",
          "search_paths": [
            "/opt/homebrew/opt/llvm/bin",
            "/usr/local/opt/llvm/bin"
          ],
          "args": [
            "--includedir"
          ]
        },
        {
          "name": "llvm_libdir",
          "tool": "llvm-config",
          "search_paths": [
            "/opt/homebrew/opt/llvm/bin",
            "/usr/local/opt/llvm/bin"
          ],
          "args": [
            "--libdir"
          ]
        }
      ],
      "projects": [
        {
          "name": "typemeta_extract",
          "lang": "c++17",
          "link": "executable",
          "target_extension": "",
          "source_files": [
            "${source}/typemeta_extract.cpp"
          ],
          "includes": [
            "${llvm_include}"
          ],
          "libraries": [
            "clang-cpp",
            "LLVM"
          ],
          "link_options": [
            "-L${llvm_libdir}",
            "-Wl,-rpath,${llvm_libdir}"
          ],
          "install_executable": "bin/typemeta_extract"
        }
      ]
    }
  },
  "dependency_defaults": {
    "macos": {
      "deployment_target": "15.0"
    }
  }
}
