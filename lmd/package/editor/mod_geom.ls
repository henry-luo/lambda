// compatibility exports; the drawing package owns the implementation.
import core: lambda.editor.draw.geometry

pub fn v2(x, y) => core.v2(x,y)
pub fn rect(x, y, width, height) => core.rect(x,y,width,height)
pub fn rect_from_points(a, b) => core.rect_from_points(a,b)
pub fn rect_center(r) => core.rect_center(r)
pub fn rect_right(r) => core.rect_right(r)
pub fn rect_bottom(r) => core.rect_bottom(r)
pub fn v2_add(a, b) => core.v2_add(a,b)
pub fn v2_sub(a, b) => core.v2_sub(a,b)
pub fn v2_scale(a, k) => core.v2_scale(a,k)
pub fn v2_dot(a, b) => core.v2_dot(a,b)
pub fn hypot(dx, dy) => core.hypot(dx,dy)
pub fn v2_len(a) => core.v2_len(a)
pub fn v2_dist(a, b) => core.v2_dist(a,b)
pub fn rect_contains(r, p) => core.rect_contains(r,p)
pub fn rect_intersects(a, b) => core.rect_intersects(a,b)
pub fn rect_union(a, b) => core.rect_union(a,b)
pub fn rotate_point(p, center, angle_deg) => core.rotate_point(p,center,angle_deg)
pub fn point_to_segment_dist_sq(p, a, b) => core.point_to_segment_dist_sq(p,a,b)
pub fn point_to_segment_dist(p, a, b) => core.point_to_segment_dist(p,a,b)
pub fn point_near_polyline(p, poly, tolerance) => core.point_near_polyline(p,poly,tolerance)
pub fn point_in_polygon(p, poly) => core.point_in_polygon(p,poly)
pub fn point_in_ellipse(p, bbox) => core.point_in_ellipse(p,bbox)
pub fn polyline_to_svg_d(points) => core.polyline_to_svg_d(points)
pub fn get_shape_kind(shape) => core.get_shape_kind(shape)
pub fn get_shape_attr_number(shape, name, def) => core.get_shape_attr_number(shape,name,def)
pub fn get_shape_attr_string(shape, name, def) => core.get_shape_attr_string(shape,name,def)
pub fn get_shape_id(shape) => core.get_shape_id(shape)
pub fn get_shape_bbox(shape) => core.get_shape_bbox(shape)
pub fn parse_points(s) => core.parse_points(s)
pub fn get_line_endpoints(shape) => core.get_line_endpoints(shape)
pub fn find_shape_by_id(doc, id) => core.find_shape_by_id(doc,id)
pub let HIT_TOLERANCE = core.HIT_TOLERANCE
pub fn hit_test_shape(shape, p) => core.hit_test_shape(shape,p)
pub fn hit_test_drawing(drawing, p) => core.hit_test_drawing(drawing,p)
