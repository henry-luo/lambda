% nomencl.sty -- Lambda-owned binding of nomencl (CTAN), written from its manual
% rather than copied.
%
% Like the other declaration bindings (vibe/latex/Lambda_Design_TeX_Engine.md §4),
% it defines the macros a document redefines (\nomname, \nompreamble,
% \nompostamble) with nomencl's defaults, so \renewcommand is legal and the echoed
% definition reaches the script adapter (lmd/package/latex/packages/terms.ls).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nomencl}[2026/10/13 Lambda binding]
\DeclareOption*{}
\ProcessOptions\relax

\providecommand\nomname{Nomenclature}
\providecommand\nompreamble{}
\providecommand\nompostamble{}
\providecommand\nomgroup[1]{}
\providecommand\nomlabel[1]{#1}
\providecommand\nomentryend{}
