% minitoc.sty -- Lambda-owned binding of minitoc (CTAN), written from its manual
% rather than copied.
%
% The mini-table titles are macros a document redefines; this binding defines
% them with minitoc's English defaults so \renewcommand is legal, and the echoed
% definitions reach the script adapter (lmd/package/latex/packages/contents.ls).
% \dominitoc, \minitoc and the other commands stay constructors.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{minitoc}[2026/10/13 Lambda binding]
\DeclareOption*{}
\ProcessOptions\relax

\providecommand\mtctitle{Contents}
\providecommand\stctitle{Contents}
\providecommand\ptctitle{Table of Contents}
\newcounter{minitocdepth}\setcounter{minitocdepth}{2}
\newcounter{secttocdepth}\setcounter{secttocdepth}{2}
\newcounter{parttocdepth}\setcounter{parttocdepth}{2}
