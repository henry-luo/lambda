% authblk.sty -- Lambda-owned binding of authblk (CTAN), written from its manual
% rather than copied.
%
% authblk's fonts and separators are macros a document redefines; this binding
% defines them with authblk's defaults so \renewcommand is legal, and the echoed
% definitions reach the script adapter (lmd/package/doc/latex/packages/frontmatter.ls).
% \author[mark]{name} and \affil[mark]{institution} stay constructors.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{authblk}[2026/10/13 Lambda binding]
\DeclareOption*{}
\ProcessOptions\relax

\providecommand\Authfont{}
\providecommand\Affilfont{}
\providecommand\Authsep{, }
\providecommand\Authand{ and }
\providecommand\Authands{, and }
