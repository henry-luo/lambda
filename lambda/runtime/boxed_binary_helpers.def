// Generic Lambda operands are Items. Keep the legacy Bool return ABI explicit.
BOXED_BINARY_ITEM(ADD, fn_add)
BOXED_BINARY_ITEM(SUB, fn_sub)
BOXED_BINARY_ITEM(MUL, fn_mul)
BOXED_BINARY_ITEM(DIV, fn_div)
BOXED_BINARY_ITEM(IDIV, fn_idiv)
BOXED_BINARY_ITEM(MOD, fn_mod)
BOXED_BINARY_ITEM(POW, fn_pow)
BOXED_BINARY_ITEM(JOIN, fn_join)
BOXED_BINARY_ITEM(UNION, fn_union)
BOXED_BINARY_ITEM(INTERSECT, fn_intersect)
BOXED_BINARY_ITEM(EXCLUDE, fn_exclude)
BOXED_BINARY_ITEM(EQ, fn_eq_value)
BOXED_BINARY_ITEM(NE, fn_ne_value)
BOXED_BINARY_ITEM(REF_EQ, fn_ref_eq_value)
BOXED_BINARY_ITEM(LT, fn_lt)
BOXED_BINARY_ITEM(LE, fn_le)
BOXED_BINARY_ITEM(GT, fn_gt)
BOXED_BINARY_ITEM(GE, fn_ge)
BOXED_BINARY_ITEM(TO, fn_to)
BOXED_BINARY_BOOL(AT, fn_at)
BOXED_BINARY_BOOL(IN, fn_in)
BOXED_BINARY_BOOL(OF, fn_of)
BOXED_BINARY_BOOL(SUBTYPE, fn_subtype)
