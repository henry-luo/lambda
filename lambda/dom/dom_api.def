// dom_api.def — the DOM operation catalog (ES39, vibe/Lambda_Design_DOM_Host_API.md).
//
// ONE row per DOM operation. This file is the only place an operation's name,
// signature, tier and body are declared; every surface -- the host table, the
// Lambda `dom.*` face, the `radiant.*` aliases, the JS bindings -- is an
// expansion of it. Add a row here or nowhere.
//
//   DOM_OP(tier, name, cluster, argc, signature, body, flags, derivation)
//
//   tier       CORE      irreducible mechanism (section 4 of the design doc)
//              DERIVED   defined by `derivation` over core (section 5)
//   name       canonical snake_case; also the `dom.*` name
//   argc       number of Item parameters of `body` (checked at compile time)
//   signature  Lambda type syntax for the Jube registration. Host types are
//              spelled `any` until the dom module registers them (F32).
//   body       `Item body(Item x argc)`, or DOM_NO_BODY when the body is
//              engine-provided (filled at table time, F30) or Lambda-only.
//   flags      DOM_F_NEUTRAL   callable with no JS realm (ESO81 property)
//              DOM_F_MUTATES   writes the tree, a buffer, or the state store
//              DOM_F_SNAPSHOT  returns a Lambda array snapshot (S9.2.2)
//              DOM_F_ENGINE    body lives in the Radiant engine target
//              DOM_F_FASTPATH  a DERIVED row whose native body must equal its
//                              derivation (ES43 oracle)
//   derivation normative pseudo-Lambda over core names ("" for CORE)
//
// Realm-dependence is a *fact recorded per row*, not a guess: a row is NEUTRAL
// only if a Lambda-only document has exercised it.

#ifndef DOM_OP
#error "define DOM_OP(tier, name, cluster, argc, sig, body, flags, deriv) before including dom_api.def"
#endif

// ---------------------------------------------------------------------------
// CORE — node identity and links (the tree is the mechanism)
// Two row kinds. DOM_OP is the Lambda-expressible operation: uniform Item
// arity, a Lambda signature, an operation id, a compile-checked arity, and a
// `dom.*` face when it is realm-neutral. DOM_RAW is an operation whose shape no
// Lambda function can carry -- a `void` return, a raw `DomNode*`, a C string --
// declared with its own C signature. A DOM_RAW row is in the catalog and the
// module calls it there, but it is structurally unpublishable: it never reaches
// the Lambda face, so there is no absence rule and no signature to state.
//
//   DOM_RAW(name, cluster, ret, params, body, flags)
//
// A site includes this file with either macro (or both) defined; whichever it
// leaves out expands to nothing.
#ifndef DOM_OP
#define DOM_OP(tier, name, cluster, argc, sig, body, flags, deriv)
#define DOM_API_DEF_CLEAR_OP
#endif
#ifndef DOM_RAW
#define DOM_RAW(name, cluster, ret, params, body, flags)
#define DOM_API_DEF_CLEAR_RAW
#endif

// ---------------------------------------------------------------------------
DOM_OP(CORE, node_type,        node, 1, "fn(n: any) -> int",        dom_core_node_type,        DOM_F_NEUTRAL, "")
DOM_OP(CORE, node_name,        node, 1, "fn(n: any) -> string",     dom_core_node_name,        DOM_F_NEUTRAL, "")
DOM_OP(CORE, node_value,       node, 1, "fn(n: any) -> string|null",dom_core_node_value,       DOM_F_NEUTRAL, "")
DOM_OP(CORE, parent_node,      node, 1, "fn(n: any) -> any",        dom_core_parent_node,      DOM_F_NEUTRAL, "")
DOM_OP(CORE, first_child,      node, 1, "fn(n: any) -> any",        dom_core_first_child,      DOM_F_NEUTRAL, "")
DOM_OP(CORE, last_child,       node, 1, "fn(n: any) -> any",        dom_core_last_child,       DOM_F_NEUTRAL, "")
DOM_OP(CORE, next_sibling,     node, 1, "fn(n: any) -> any",        dom_core_next_sibling,     DOM_F_NEUTRAL, "")
DOM_OP(CORE, previous_sibling, node, 1, "fn(n: any) -> any",        dom_core_previous_sibling, DOM_F_NEUTRAL, "")
DOM_OP(CORE, owner_document,   node, 1, "fn(n: any) -> any",        dom_core_owner_document,   DOM_F_NEUTRAL, "")
DOM_OP(CORE, same_node,       node, 2, "fn(a: any, b: any) -> bool", dom_core_same_node,      DOM_F_NEUTRAL, "")
// S5.1.4: Lambda has no identity operator and never will, and a node wrapper
// materialises no entries, so `a == b` compares two empty maps and answers
// true for ANY two nodes. Node identity is therefore a DOM operation, and
// every derivation that needs it says same_node(...) — never `==` (ESO96).

// ---------------------------------------------------------------------------
// CORE — attributes
// ---------------------------------------------------------------------------
DOM_OP(CORE, get_attribute,    attr, 2, "fn(n: any, name: string) -> string|null",          dom_core_get_attribute,    DOM_F_NEUTRAL, "")
DOM_OP(CORE, set_attribute,    attr, 3, "fn(n: any, name: string, value: string) -> null",  dom_core_set_attribute,    DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, remove_attribute, attr, 2, "fn(n: any, name: string) -> null",                 dom_core_remove_attribute, DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, attribute_names,  attr, 1, "fn(n: any) -> array",                              dom_core_attribute_names,  DOM_F_NEUTRAL | DOM_F_SNAPSHOT, "")

// ---------------------------------------------------------------------------
// CORE — tree mutation
// ---------------------------------------------------------------------------
DOM_OP(CORE, create_node,      tree, 4, "fn(doc: any, type: int, name: string|null, data: string|null) -> any", dom_core_create_node, DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, insert_before,    tree, 3, "fn(parent: any, node: any, ref: any) -> any",      dom_core_insert_before,    DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, remove_child,     tree, 2, "fn(parent: any, node: any) -> any",                dom_core_remove_child,     DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, set_node_value,   tree, 2, "fn(n: any, data: string) -> null",                 dom_core_set_node_value,   DOM_F_NEUTRAL | DOM_F_MUTATES, "")

// ---------------------------------------------------------------------------
// CORE — matching, parsing, serializing
// ---------------------------------------------------------------------------
DOM_OP(CORE, matches,          query, 2, "fn(n: any, selector: string) -> bool",            dom_core_matches,          DOM_F_NEUTRAL, "")
DOM_OP(CORE, parse_fragment,   parse, 2, "fn(context: any, markup: string) -> any",         dom_core_parse_fragment,   DOM_F_NEUTRAL, "")
DOM_OP(CORE, serialize,        parse, 2, "fn(n: any, outer: bool) -> string",               dom_core_serialize,        DOM_F_NEUTRAL, "")

// ---------------------------------------------------------------------------
// CORE — documents (engine-provided until F30; ESO80)
// ---------------------------------------------------------------------------
DOM_OP(CORE, load,             document, 1, "fn(path: string) -> any",                     dom_engine_load_document,  DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, parse_document,   document, 2, "fn(markup: string, mime: string) -> any",     dom_parser_parse_from_string, 0, "")

// ---------------------------------------------------------------------------
// CORE — state and events (S9.1.4 store, the dispatch loop) — engine-provided
// ---------------------------------------------------------------------------
DOM_OP(CORE, get_state,        state, 2, "fn(n: any, name: string) -> any",                 dom_engine_get_state, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, set_state,        state, 3, "fn(n: any, name: string, value: any) -> bool",    dom_engine_set_state, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, request_change,   state, 1, "fn(n: any) -> bool",                              dom_engine_request_change, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dispatch,         event, 2, "fn(n: any, event: any) -> bool",                  dom_core_dispatch, DOM_F_NEUTRAL, "")
DOM_OP(CORE, add_listener,     event, 4, "fn(n: any, type: string, fn: any, opts: any) -> null", dom_add_event_listener_bridge, 0, "")
DOM_OP(CORE, remove_listener,  event, 4, "fn(n: any, type: string, fn: any, opts: any) -> null", dom_remove_event_listener_bridge, 0, "")
// JS's legacy document.createEvent: it answers a JS Event object, so it needs
// the realm and is JS-only by nature rather than by omission. Lambda does not
// need it -- an event value is a map literal, {type: ..., bubbles: ...}, which
// `dispatch` above accepts directly. Wiring a native factory for something the
// language already writes would add a body to keep in step for no gain.
DOM_OP(CORE, create_event,     event, 2, "fn(type: string, init: any) -> any",              DOM_NO_BODY, 0, "")

