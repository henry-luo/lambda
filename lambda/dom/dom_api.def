DOM_RAW(get_ui_context, host, void*, (void), dom_get_ui_context, DOM_F_NATIVE)
DOM_RAW(has_committed_geometry_snapshot, geometry, bool, (void* doc), dom_has_committed_geometry_snapshot, DOM_F_NATIVE)
