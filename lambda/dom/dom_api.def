DOM_OP(CORE, tc_value,         textctl, 1, "fn(n: any) -> string",                          DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, tc_set_value,     textctl, 2, "fn(n: any, v: string) -> bool",                 DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, tc_selection,     textctl, 1, "fn(n: any) -> map",                             DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, tc_set_selection, textctl, 4, "fn(n: any, start: int, end: int, dir: string|null) -> bool", DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, tc_replace_range, textctl, 4, "fn(n: any, start: int, end: int, text: string) -> bool", DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, set_caret,        editing, 2, "fn(n: any, offset: int) -> bool",               DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, caret_operation,  editing, 3, "fn(n: any, op: string, extend: bool) -> bool",  DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, edit_range,       editing, 1, "fn(host: any) -> map|null",                     DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, edit_replace_range, editing, 4, "fn(host: any, start: int, end: int, text: string) -> int|null", DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, edit_insert_at_boundary, editing, 2, "fn(host: any, text: string) -> int|null", DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, edit_split_block, editing, 1, "fn(host: any) -> bool",                         DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, edit_insert_break, editing, 1, "fn(host: any) -> bool",                        DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, set_password_reveal, textctl, 3, "fn(n: any, start: int, end: int) -> bool",   DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, key_intent,       input, 2, "fn(n: any, name: string) -> bool",                DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, ime_preedit,      input, 1, "fn(n: any) -> any",                               DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, set_ime_preedit,  input, 3, "fn(n: any, text: any, caret: int) -> bool",       DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, clear_ime_preedit, input, 1, "fn(n: any) -> bool",                             DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, clipboard_text,   input, 0, "fn() -> string|null",                             DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, open_context_menu, input, 2, "fn(n: any, enabled_mask: int) -> bool",          DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, context_menu_target, input, 1, "fn(n: any) -> any",                            DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")

// ---------------------------------------------------------------------------
// CORE — ranges and selection (boundary storage is mechanism)
// ---------------------------------------------------------------------------
DOM_OP(CORE, create_range,     range, 0, "fn() -> any",                                     dom_create_range,          0, "")
DOM_OP(CORE, range_boundaries, range, 1, "fn(r: any) -> map",                               dom_core_range_boundaries, 0, "")
DOM_OP(CORE, range_set_start,  range, 3, "fn(r: any, n: any, offset: int) -> null",         js_range_set_start,        DOM_F_MUTATES, "")
DOM_OP(CORE, range_set_end,    range, 3, "fn(r: any, n: any, offset: int) -> null",         js_range_set_end,          DOM_F_MUTATES, "")
DOM_OP(CORE, selection,        selection, 0, "fn() -> any",                                 dom_global_get_selection,  0, "")
DOM_OP(CORE, selection_boundaries, selection, 1, "fn(s: any) -> map",                       dom_core_selection_boundaries, 0, "")
DOM_OP(CORE, set_base_and_extent, selection, 5, "fn(s: any, an: any, ao: int, fn_: any, fo: int) -> null", js_selection_set_base_and_extent, DOM_F_MUTATES, "")
DOM_OP(CORE, selection_modify, selection, 4, "fn(s: any, alter: string, dir: string, gran: string) -> null", js_selection_modify, DOM_F_MUTATES, "")

// ---------------------------------------------------------------------------
// CORE — style and CSSOM
// ---------------------------------------------------------------------------
DOM_OP(CORE, computed_style,   style, 2, "fn(n: any, prop: string) -> string",              dom_core_computed_style,   0, "")
DOM_OP(CORE, stylesheet_rules, style, 1, "fn(sheet: any) -> array",                         dom_cssom_stylesheet_get_css_rules, DOM_F_SNAPSHOT, "")
DOM_OP(CORE, stylesheet_insert_rule, style, 3, "fn(sheet: any, rule: string, index: int) -> int", dom_cssom_insert_rule, DOM_F_MUTATES, "")
DOM_OP(CORE, stylesheet_delete_rule, style, 2, "fn(sheet: any, index: int) -> null",        dom_cssom_delete_rule,     DOM_F_MUTATES, "")

//
// Three helpers are shared by the derivations below and defined once in the
// derived module (they are themselves derivations over core):
//   element_or_next(c) = if (c == null or node_type(c) == 1) c
//                        else element_or_next(next_sibling(c))
//   element_or_prev(c) = if (c == null or node_type(c) == 1) c
//                        else element_or_prev(previous_sibling(c))
//   siblings_from(c)   = if (c == null) null else (c, siblings_from(next_sibling(c)))
//   descendants(n)     = for (c in child_nodes(n)) (c, descendants(c))
// `(head, tail)` builds a FLATTENED sequence and strips nulls, which is how a
// pure `fn` accumulates a list: `var`/`while`/assignment are procedure-only
// (E224), so every derivation here is written functionally and can be a `fn`.
// ===========================================================================
// DERIVED — each row's derivation is normative (section 5). A FASTPATH body
// must produce exactly what the derivation produces (ES43 oracle).
// ===========================================================================

// --- 5.1 element-only traversal
DOM_OP(DERIVED, first_element_child, node, 1, "fn(n: any) -> any", dom_fp_first_element_child, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_next(first_child(n))")
DOM_OP(DERIVED, last_element_child,  node, 1, "fn(n: any) -> any", dom_fp_last_element_child,  DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_prev(last_child(n))")
DOM_OP(DERIVED, next_element_sibling, node, 1, "fn(n: any) -> any", dom_fp_next_element_sibling, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_next(next_sibling(n))")
DOM_OP(DERIVED, previous_element_sibling, node, 1, "fn(n: any) -> any", dom_fp_previous_element_sibling, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_prev(previous_sibling(n))")
DOM_OP(DERIVED, parent_element,  node, 1, "fn(n: any) -> any", dom_fp_parent_element, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (parent_node(n) != null and node_type(parent_node(n)) == 1) parent_node(n) else null")
DOM_OP(DERIVED, children,        node, 1, "fn(n: any) -> array", dom_fp_children, DOM_F_NEUTRAL | DOM_F_SNAPSHOT | DOM_F_FASTPATH,
       "[for (c in child_nodes(n) where node_type(c) == 1) c]")
DOM_OP(DERIVED, child_nodes,     node, 1, "fn(n: any) -> array", dom_fp_child_nodes, DOM_F_NEUTRAL | DOM_F_SNAPSHOT | DOM_F_FASTPATH,
       "siblings_from(first_child(n))")
DOM_OP(DERIVED, contains,        node, 2, "fn(a: any, b: any) -> bool", dom_fp_contains, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "same_node(b, a) or (parent_node(b) != null and contains(a, parent_node(b)))")
DOM_OP(DERIVED, equal_node,      node, 2, "fn(a: any, b: any) -> bool", dom_fp_equal_node, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "node_type(a) == node_type(b) and node_name(a) == node_name(b) and node_value(a) == node_value(b) and attribute_names(a) == attribute_names(b) and all([for (k in attribute_names(a)) get_attribute(a, k) == get_attribute(b, k)]) and len(child_nodes(a)) == len(child_nodes(b)) and all([for (p in zip(child_nodes(a), child_nodes(b))) equal_node(p[0], p[1])])")
DOM_OP(DERIVED, root_node,       node, 1, "fn(n: any) -> any", dom_fp_root_node, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (parent_node(n) == null) n else root_node(parent_node(n))")

// --- 5.2 structural sugar
DOM_OP(DERIVED, append_child,    tree, 2, "fn(parent: any, child: any) -> any", dom_fp_append_child, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "insert_before(parent, child, null)")
DOM_OP(DERIVED, remove,          tree, 1, "fn(n: any) -> any", dom_fp_remove, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "remove_child(parent_node(n), n)")
DOM_OP(DERIVED, replace_child,   tree, 3, "fn(parent: any, new: any, old: any) -> any", dom_fp_replace_child, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "insert_before(parent, new, old); remove_child(parent, old); old")
DOM_OP(DERIVED, create_element,  tree, 2, "fn(doc: any, tag: string) -> any", dom_fp_create_element, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "create_node(doc, 1, tag, null)")
DOM_OP(DERIVED, create_text_node, tree, 2, "fn(doc: any, data: string) -> any", dom_fp_create_text_node, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "create_node(doc, 3, null, data)")
DOM_OP(DERIVED, clone_node,      tree, 2, "fn(n: any, deep: bool) -> any", dom_fp_clone_node, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "let c = create_node(owner_document(n), node_type(n), node_name(n), node_value(n)); for (name in attribute_names(n)) set_attribute(c, name, get_attribute(n, name)); if (deep) for (k in child_nodes(n)) append_child(c, clone_node(k, true)); c")

// --- 5.3 character data
DOM_OP(DERIVED, text_content,    text, 1, "fn(n: any) -> string", dom_fp_text_content, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (node_type(n) == 3 or node_type(n) == 8) node_value(n) else join([for (k in child_nodes(n)) text_content(k)], \"\")")
DOM_OP(DERIVED, set_text_content, text, 2, "fn(n: any, s: string) -> null", dom_core_set_text_content, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "for (k in child_nodes(n)) remove_child(n, k); if (s != \"\") append_child(n, create_text_node(owner_document(n), s))")

// --- 5.4 queries over matches + traversal
DOM_OP(DERIVED, query_selector,  query, 2, "fn(root: any, selector: string) -> any", dom_fp_query_selector, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "first([for (d in descendants(root) where matches(d, selector)) d])")
DOM_OP(DERIVED, query_selector_all, query, 2, "fn(root: any, selector: string) -> array", dom_fp_query_selector_all, DOM_F_NEUTRAL | DOM_F_SNAPSHOT | DOM_F_FASTPATH,
       "[for (d in descendants(root) where matches(d, selector)) d]")
DOM_OP(DERIVED, closest,         query, 2, "fn(n: any, selector: string) -> any", dom_fp_closest, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (node_type(n) != 1) null else if (matches(n, selector)) n else if (parent_element(n) != null) closest(parent_element(n), selector) else null")
DOM_OP(DERIVED, get_element_by_id, query, 2, "fn(root: any, id: string) -> any", dom_fp_get_element_by_id, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "first of [for (d in descendants(root) where node_type(d) == 1 and get_attribute(d, \"id\") == id) d]")
DOM_OP(DERIVED, has_attribute,   attr, 2, "fn(n: any, name: string) -> bool", dom_fp_has_attribute, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "get_attribute(n, name) != null")

// --- 5.5 serialization
DOM_OP(DERIVED, inner_html,      parse, 1, "fn(n: any) -> string", dom_fp_inner_html, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "serialize(n, false)")
DOM_OP(DERIVED, outer_html,      parse, 1, "fn(n: any) -> string", dom_fp_outer_html, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "serialize(n, true)")
DOM_OP(DERIVED, set_inner_html,  parse, 2, "fn(n: any, html: string) -> null", dom_core_set_inner_html, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "for (k in child_nodes(n)) remove_child(n, k); let f = parse_fragment(n, html); for (k in child_nodes(f)) append_child(n, k)")

// --- 5.6 ranges and selection sugar (fast paths are the existing bindings)
DOM_OP(DERIVED, range_collapsed, range, 1, "fn(r: any) -> bool", js_range_get_collapsed, DOM_F_FASTPATH,
       "let b = range_boundaries(r); b.start_container == b.end_container and b.start_offset == b.end_offset")
DOM_OP(DERIVED, range_collapse,  range, 2, "fn(r: any, to_start: bool) -> null", js_range_collapse, DOM_F_MUTATES | DOM_F_FASTPATH,
       "let b = range_boundaries(r); if (to_start) range_set_end(r, b.start_container, b.start_offset) else range_set_start(r, b.end_container, b.end_offset)")
DOM_OP(DERIVED, range_select_node, range, 2, "fn(r: any, n: any) -> null", js_range_select_node, DOM_F_MUTATES | DOM_F_FASTPATH,
       "range_set_start(r, parent_node(n), index_of(n)); range_set_end(r, parent_node(n), index_of(n) + 1)")
DOM_OP(DERIVED, range_select_node_contents, range, 2, "fn(r: any, n: any) -> null", js_range_select_node_contents, DOM_F_MUTATES | DOM_F_FASTPATH,
       "range_set_start(r, n, 0); range_set_end(r, n, length_of(n))")
DOM_OP(DERIVED, range_to_string, range, 1, "fn(r: any) -> string", js_range_to_string, DOM_F_FASTPATH,
       "concatenation of the text data within the boundaries")
DOM_OP(DERIVED, range_delete_contents, range, 1, "fn(r: any) -> null", js_range_delete_contents, DOM_F_MUTATES | DOM_F_FASTPATH,
       "DOM 5.5 'delete the contents': remove_child / set_node_value over the boundaries, then collapse")
DOM_OP(DERIVED, selection_collapse, selection, 3, "fn(s: any, n: any, offset: int) -> null", js_selection_collapse, DOM_F_MUTATES | DOM_F_FASTPATH,
       "set_base_and_extent(s, n, offset, n, offset)")
DOM_OP(DERIVED, selection_extend, selection, 3, "fn(s: any, n: any, offset: int) -> null", js_selection_extend, DOM_F_MUTATES | DOM_F_FASTPATH,
       "let b = selection_boundaries(s); set_base_and_extent(s, b.anchor_node, b.anchor_offset, n, offset)")
DOM_OP(DERIVED, selection_select_all_children, selection, 2, "fn(s: any, n: any) -> null", js_selection_select_all_children, DOM_F_MUTATES | DOM_F_FASTPATH,
       "set_base_and_extent(s, n, 0, n, len(child_nodes(n)))")

// --- 5.7 forms and controls (cold: Lambda bodies, F30/F31)
DOM_OP(DERIVED, form_of,         forms, 1, "fn(n: any) -> any", DOM_NO_BODY, DOM_F_NEUTRAL,
       "if (has_attribute(n, \"form\")) get_element_by_id(root_node(n), get_attribute(n, \"form\")) else closest(n, \"form\")")
DOM_OP(DERIVED, radio_group,     forms, 1, "fn(n: any) -> array", DOM_NO_BODY, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "let scope = if (form_of(n) != null) form_of(n) else root_node(n); [for (c in query_selector_all(scope, \"input[type=radio]\") where get_attribute(c, \"name\") == get_attribute(n, \"name\") and same_node(form_of(c), form_of(n))) c]")
DOM_OP(DERIVED, details_group,   forms, 1, "fn(n: any) -> array", DOM_NO_BODY, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "[for (d in query_selector_all(root_node(n), \"details[name]\") where get_attribute(d, \"name\") == get_attribute(n, \"name\")) d]")
DOM_OP(DERIVED, focus_candidates, focus, 1, "fn(root: any) -> array", DOM_NO_BODY, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "[for (d in descendants(root) where is_focusable(d)) d]")
DOM_OP(DERIVED, form_controls,   forms, 1, "fn(f: any) -> array", DOM_NO_BODY, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "[for (c in query_selector_all(root_node(f), \"input,select,textarea,button,fieldset,object,output\") where same_node(form_of(c), f)) c]")
DOM_OP(DERIVED, click,           event, 1, "fn(n: any) -> bool", DOM_NO_BODY, DOM_F_NEUTRAL,
       "dispatch(n, create_event(\"click\", {bubbles: true, cancelable: true, composed: true}))")
