DOM_RAW(location_navigate_bridge, navigation, Item, (void* doc, Item next_url, bool replace), dom_location_navigate_bridge, DOM_F_NATIVE)
DOM_RAW(navigate_submit_target, navigation, bool, (const char* target_name, const char* url), dom_navigate_submit_target, DOM_F_NATIVE)
DOM_RAW(normalize_bridge, tree, Item, (void* elem), dom_normalize_bridge, DOM_F_NATIVE)
DOM_RAW(notify_mutation, notify, void, (int kind, void* target, void* parent), jube_host_dom_notify_mutation, DOM_F_NATIVE)
DOM_RAW(notify_mutation_detail, notify, void, (int kind, void* target, void* parent, const char* attribute_name, const char* old_value), jube_host_dom_notify_mutation_detail, DOM_F_NATIVE)
DOM_RAW(owner_document_for_node, host, Item, (void* node), dom_owner_document_for_node, DOM_F_NATIVE)
DOM_RAW(popover_target_action, forms, int, (void* button), dom_popover_target_action, DOM_F_NATIVE)
