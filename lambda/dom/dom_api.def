DOM_OP(CORE, value_at_focus, input, 1, "fn(n: any) -> any", dom_engine_value_at_focus, DOM_F_ENGINE | DOM_F_NEUTRAL, "")

// ===========================================================================
// DERIVED — each row's derivation is normative (section 5). A FASTPATH body
// must produce exactly what the derivation produces (ES43 oracle).
// ===========================================================================

// The generic entries a binding layer needs, because `el[name]` is dynamic and
// no fixed row can serve it. Not published to `dom.*`: a Lambda script has named
// rows and does not need a stringly-typed accessor, and publishing them would
// force the Lambda absence rule onto a path JS shares. Publishing them is what puts the whole of JS's DOM
// access behind the API rather than most of it (ES45); `invoke` takes its
// arguments as an array so the row stays fixed-arity while the executor behind
// it stays variadic.
DOM_OP(CORE, get_property, node, 2, "fn(n: any, name: string) -> any", dom_core_get_property, 0, "")
DOM_OP(CORE, set_property, node, 3, "fn(n: any, name: string, value: any) -> any", dom_core_set_property, DOM_F_MUTATES, "")
DOM_OP(CORE, invoke, node, 3, "fn(n: any, op: int, args: array) -> any", dom_core_invoke, DOM_F_MUTATES, "")

// The CSS statics and the two node writes the JS runtime used to reach by
// direct extern (ES45). set_event_handler is derived in substance -- it drives
// the same listener store as add_listener/remove_listener -- but stating it as
// a derivation needs a read for the current IDL handler that no row exposes.
DOM_OP(CORE, css_supports, style, 2, "fn(property: string, value: string|null) -> bool", dom_core_css_supports, DOM_F_NEUTRAL, "")
DOM_OP(CORE, css_escape, style, 1, "fn(text: string) -> string", dom_core_css_escape, DOM_F_NEUTRAL, "")
DOM_OP(CORE, set_data, attr, 3, "fn(n: any, name: string, value: any) -> any", dom_core_set_data, DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, set_event_handler, event, 3, "fn(n: any, name: string, handler: any) -> null", dom_core_set_event_handler, DOM_F_MUTATES, "")

// --- 5.1 element-only traversal
DOM_OP(DERIVED, first_element_child, node, 1, "fn(n: any) -> any", dom_fp_first_element_child, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_next(first_child(n))")
DOM_OP(DERIVED, last_element_child,  node, 1, "fn(n: any) -> any", dom_fp_last_element_child,  DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_prev(last_child(n))")
DOM_OP(DERIVED, next_element_sibling, node, 1, "fn(n: any) -> any", dom_fp_next_element_sibling, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_next(next_sibling(n))")
DOM_OP(DERIVED, previous_element_sibling, node, 1, "fn(n: any) -> any", dom_fp_previous_element_sibling, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "element_or_prev(previous_sibling(n))")
DOM_OP(DERIVED, parent_element,  node, 1, "fn(n: any) -> any", dom_fp_parent_element, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (parent_node(n) != null and node_type(parent_node(n)) == 1) parent_node(n) else null")
DOM_OP(DERIVED, children,        node, 1, "fn(n: any) -> array", dom_fp_children, DOM_F_NEUTRAL | DOM_F_SNAPSHOT | DOM_F_FASTPATH,
       "[for (c in child_nodes(n) where node_type(c) == 1) c]")
DOM_OP(DERIVED, child_nodes,     node, 1, "fn(n: any) -> array", dom_fp_child_nodes, DOM_F_NEUTRAL | DOM_F_SNAPSHOT | DOM_F_FASTPATH,
       "siblings_from(first_child(n))")
DOM_OP(DERIVED, contains,        node, 2, "fn(a: any, b: any) -> bool", dom_fp_contains, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "same_node(b, a) or (parent_node(b) != null and contains(a, parent_node(b)))")
DOM_OP(DERIVED, equal_node,      node, 2, "fn(a: any, b: any) -> bool", dom_fp_equal_node, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "node_type(a) == node_type(b) and node_name(a) == node_name(b) and node_value(a) == node_value(b) and attribute_names(a) == attribute_names(b) and all([for (k in attribute_names(a)) get_attribute(a, k) == get_attribute(b, k)]) and len(child_nodes(a)) == len(child_nodes(b)) and all([for (p in zip(child_nodes(a), child_nodes(b))) equal_node(p[0], p[1])])")
// The document ELEMENT -- <html> -- as distinct from the document itself.
// `radiant.document_root` means this one, and mapping it to root_node during
// the alias pass would have handed callers the Document instead: the same
// class of near-miss as ownerDocument, caught by comparing the two bodies
// rather than trusting the names.
DOM_OP(CORE, document_element, node, 1, "fn(n: any) -> any", dom_fp_document_element, DOM_F_NEUTRAL, "")
DOM_OP(DERIVED, root_node,       node, 1, "fn(n: any) -> any", dom_fp_root_node, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (parent_node(n) == null) n else root_node(parent_node(n))")

// --- 5.2 structural sugar
DOM_OP(DERIVED, append_child,    tree, 2, "fn(parent: any, child: any) -> any", dom_fp_append_child, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "insert_before(parent, child, null)")
DOM_OP(DERIVED, remove,          tree, 1, "fn(n: any) -> any", dom_fp_remove, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "remove_child(parent_node(n), n)")
DOM_OP(DERIVED, replace_child,   tree, 3, "fn(parent: any, new: any, old: any) -> any", dom_fp_replace_child, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "insert_before(parent, new, old); remove_child(parent, old); old")
DOM_OP(DERIVED, create_element,  tree, 2, "fn(doc: any, tag: string) -> any", dom_fp_create_element, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "create_node(doc, 1, tag, null)")
DOM_OP(DERIVED, create_text_node, tree, 2, "fn(doc: any, data: string) -> any", dom_fp_create_text_node, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "create_node(doc, 3, null, data)")
DOM_OP(DERIVED, clone_node,      tree, 2, "fn(n: any, deep: bool) -> any", dom_fp_clone_node, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "let c = create_node(owner_document(n), node_type(n), node_name(n), node_value(n)); for (name in attribute_names(n)) set_attribute(c, name, get_attribute(n, name)); if (deep) for (k in child_nodes(n)) append_child(c, clone_node(k, true)); c")

// --- 5.3 character data
DOM_OP(DERIVED, text_content,    text, 1, "fn(n: any) -> string", dom_fp_text_content, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (node_type(n) == 3 or node_type(n) == 8) node_value(n) else join([for (k in child_nodes(n)) text_content(k)], \"\")")
DOM_OP(DERIVED, set_text_content, text, 2, "fn(n: any, s: string) -> null", dom_core_set_text_content, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "for (k in child_nodes(n)) remove_child(n, k); if (s != \"\") append_child(n, create_text_node(owner_document(n), s))")

// --- 5.4 queries over matches + traversal
DOM_OP(DERIVED, query_selector,  query, 2, "fn(root: any, selector: string) -> any", dom_fp_query_selector, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "first([for (d in descendants(root) where matches(d, selector)) d])")
DOM_OP(DERIVED, query_selector_all, query, 2, "fn(root: any, selector: string) -> array", dom_fp_query_selector_all, DOM_F_NEUTRAL | DOM_F_SNAPSHOT | DOM_F_FASTPATH,
       "[for (d in descendants(root) where matches(d, selector)) d]")
DOM_OP(DERIVED, closest,         query, 2, "fn(n: any, selector: string) -> any", dom_fp_closest, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "if (node_type(n) != 1) null else if (matches(n, selector)) n else if (parent_element(n) != null) closest(parent_element(n), selector) else null")
DOM_OP(DERIVED, get_element_by_id, query, 2, "fn(root: any, id: string) -> any", dom_fp_get_element_by_id, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "first of [for (d in descendants(root) where node_type(d) == 1 and get_attribute(d, \"id\") == id) d]")
DOM_OP(DERIVED, has_attribute,   attr, 2, "fn(n: any, name: string) -> bool", dom_fp_has_attribute, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "get_attribute(n, name) != null")

// --- 5.5 serialization
DOM_OP(DERIVED, inner_html,      parse, 1, "fn(n: any) -> string", dom_fp_inner_html, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "serialize(n, false)")
DOM_OP(DERIVED, outer_html,      parse, 1, "fn(n: any) -> string", dom_fp_outer_html, DOM_F_NEUTRAL | DOM_F_FASTPATH,
       "serialize(n, true)")
DOM_OP(DERIVED, set_inner_html,  parse, 2, "fn(n: any, html: string) -> null", dom_core_set_inner_html, DOM_F_NEUTRAL | DOM_F_MUTATES | DOM_F_FASTPATH,
       "for (k in child_nodes(n)) remove_child(n, k); let f = parse_fragment(n, html); for (k in child_nodes(f)) append_child(n, k)")

// --- 5.6 ranges and selection sugar (fast paths are the existing bindings)
DOM_OP(DERIVED, range_collapsed, range, 1, "fn(r: any) -> bool", js_range_get_collapsed, DOM_F_FASTPATH,
       "let b = range_boundaries(r); b.start_container == b.end_container and b.start_offset == b.end_offset")
DOM_OP(DERIVED, range_collapse,  range, 2, "fn(r: any, to_start: bool) -> null", js_range_collapse, DOM_F_MUTATES | DOM_F_FASTPATH,
       "let b = range_boundaries(r); if (to_start) range_set_end(r, b.start_container, b.start_offset) else range_set_start(r, b.end_container, b.end_offset)")
DOM_OP(DERIVED, range_select_node, range, 2, "fn(r: any, n: any) -> null", js_range_select_node, DOM_F_MUTATES | DOM_F_FASTPATH,
       "range_set_start(r, parent_node(n), index_of(n)); range_set_end(r, parent_node(n), index_of(n) + 1)")
DOM_OP(DERIVED, range_select_node_contents, range, 2, "fn(r: any, n: any) -> null", js_range_select_node_contents, DOM_F_MUTATES | DOM_F_FASTPATH,
       "range_set_start(r, n, 0); range_set_end(r, n, length_of(n))")
DOM_OP(DERIVED, range_to_string, range, 1, "fn(r: any) -> string", js_range_to_string, DOM_F_FASTPATH,
       "concatenation of the text data within the boundaries")
DOM_OP(DERIVED, range_delete_contents, range, 1, "fn(r: any) -> null", js_range_delete_contents, DOM_F_MUTATES | DOM_F_FASTPATH,
       "DOM 5.5 'delete the contents': remove_child / set_node_value over the boundaries, then collapse")
DOM_OP(DERIVED, selection_collapse, selection, 3, "fn(s: any, n: any, offset: int) -> null", js_selection_collapse, DOM_F_MUTATES | DOM_F_FASTPATH,
       "set_base_and_extent(s, n, offset, n, offset)")
DOM_OP(DERIVED, selection_extend, selection, 3, "fn(s: any, n: any, offset: int) -> null", js_selection_extend, DOM_F_MUTATES | DOM_F_FASTPATH,
       "let b = selection_boundaries(s); set_base_and_extent(s, b.anchor_node, b.anchor_offset, n, offset)")
DOM_OP(DERIVED, selection_select_all_children, selection, 2, "fn(s: any, n: any) -> null", js_selection_select_all_children, DOM_F_MUTATES | DOM_F_FASTPATH,
       "set_base_and_extent(s, n, 0, n, len(child_nodes(n)))")

// --- 5.7 forms and controls (cold: Lambda bodies, F30/F31)
DOM_OP(DERIVED, form_of,         forms, 1, "fn(n: any) -> any", DOM_NO_BODY, DOM_F_NEUTRAL,
       "if (has_attribute(n, \"form\")) get_element_by_id(root_node(n), get_attribute(n, \"form\")) else closest(n, \"form\")")
DOM_OP(DERIVED, radio_group,     forms, 1, "fn(n: any) -> array", DOM_NO_BODY, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "let scope = if (form_of(n) != null) form_of(n) else root_node(n); [for (c in query_selector_all(scope, \"input[type=radio]\") where get_attribute(c, \"name\") == get_attribute(n, \"name\") and same_owner(form_of(c), form_of(n))) c]")
DOM_OP(DERIVED, details_group,   forms, 1, "fn(n: any) -> array", DOM_NO_BODY, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "let g = get_attribute(n, \"name\"); if (g == null or g == \"\") [] else [for (d in query_selector_all(root_node(n), \"details[name]\") where get_attribute(d, \"name\") == g and not same_node(d, n)) d]")
// The engine's list, not the derivation: focus order carries tab_index and
// document order, which the derivation over is_focusable cannot reconstruct.
DOM_OP(DERIVED, focus_candidates, focus, 1, "fn(root: any) -> array", dom_engine_focus_candidates, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "[for (d in descendants(root) where is_focusable(d)) d]")
DOM_OP(DERIVED, form_controls,   forms, 1, "fn(f: any) -> array", DOM_NO_BODY, DOM_F_NEUTRAL | DOM_F_SNAPSHOT,
       "[for (c in query_selector_all(root_node(f), \"input,select,textarea,button,fieldset,object,output\") where same_node(form_of(c), f)) c]")
DOM_OP(DERIVED, click,           event, 1, "fn(n: any) -> bool", DOM_NO_BODY, DOM_F_NEUTRAL,
       "dispatch(n, {type: \"click\", bubbles: true, cancelable: true})")

// ---------------------------------------------------------------------------
// CORE — operations whose body is their JS-facing bridge (ESO107)
// Each of these was a `->dom` slot with no row. The row's body is literally the
// slot's function, so the module crossing here is a spelling change, not a
// second implementation; the bridges answer `undefined` and the publication
// boundary renders that as null for Lambda. None carries DOM_F_NEUTRAL: they
// need a realm (CSSOM objects, the document wrapper), so they are catalog
// operations the module reaches, not `dom.*` functions a script calls.
// ---------------------------------------------------------------------------
DOM_OP(CORE, adopt_node, node, 1, "fn(n: any) -> any", dom_adopt_node_bridge, DOM_F_MUTATES, "")
DOM_OP(CORE, style_has_property, style, 2, "fn(n: any, prop: string) -> any", dom_style_css_has, 0, "")
DOM_OP(CORE, style_get_property, style, 2, "fn(n: any, prop: string) -> any", dom_get_style_property, 0, "")
DOM_OP(CORE, style_set_property, style, 3, "fn(n: any, prop: string, value: any) -> any", dom_set_style_property, DOM_F_MUTATES, "")
DOM_OP(CORE, rule_style_has_property, style, 2, "fn(d: any, prop: string) -> any", dom_cssom_decl_css_has, 0, "")
DOM_OP(CORE, rule_style_get_property, style, 2, "fn(d: any, prop: string) -> any", dom_cssom_rule_decl_get_property, 0, "")
DOM_OP(CORE, rule_style_set_property, style, 3, "fn(d: any, prop: string, value: any) -> any", dom_cssom_rule_decl_set_property, DOM_F_MUTATES, "")
DOM_OP(CORE, rule_style_remove_property, style, 2, "fn(d: any, prop: string) -> any", dom_cssom_rule_decl_remove_property, DOM_F_MUTATES, "")
DOM_OP(CORE, set_selector_text, style, 2, "fn(rule: any, text: string) -> any", dom_cssom_rule_set_selector_text, DOM_F_MUTATES, "")
DOM_OP(CORE, document_stylesheets, document, 0, "fn() -> any", dom_document_stylesheets_bridge, DOM_F_SNAPSHOT, "")
DOM_OP(CORE, document_implementation, document, 0, "fn() -> any", dom_document_implementation_bridge, 0, "")
DOM_OP(CORE, document_fonts, document, 0, "fn() -> any", dom_document_fonts_bridge, 0, "")
DOM_OP(CORE, design_mode, document, 0, "fn() -> any", dom_document_design_mode_bridge, 0, "")
DOM_OP(CORE, exec_command, editing, 2, "fn(command: string, value: any) -> any", dom_document_exec_command_bridge, DOM_F_MUTATES, "")
DOM_OP(CORE, create_tree_walker, tree, 2, "fn(root: any, what: any) -> any", dom_create_tree_walker_bridge, 0, "")
DOM_OP(CORE, report_validity, forms, 1, "fn(n: any) -> any", dom_report_validity_bridge, 0, "")
DOM_OP(CORE, submit_form, forms, 1, "fn(f: any) -> any", dom_form_submit_bridge, DOM_F_MUTATES, "")
DOM_OP(CORE, request_submit, forms, 2, "fn(f: any, submitter: any) -> any", dom_form_request_submit_bridge, DOM_F_MUTATES, "")


// ---------------------------------------------------------------------------
// NATIVE — the retired `->dom` section (ES40)
// These are catalog rows so the module has one door and only one. They keep
// their native C signatures because no Lambda function can carry them: a
// `void` return, a raw DomNode*, a C string. Every one is DOM_F_NATIVE -- in
// the catalog for the module, absent from `dom.*` -- and promoting one to a
// DOM_OP row is the per-operation contract work the A/B/C census describes.
// Names are verbatim from the section they came from, so the migration was a
// section rename at each call site and nothing else.
// ---------------------------------------------------------------------------
DOM_RAW(activate_popover_native, forms, bool, (void* popover, int action), dom_activate_popover, DOM_F_NATIVE)
// The ordinal executor. A DOM_OP row is fixed-arity because a row is a Lambda
// function, so the uniform `invoke` row has to pack its arguments into an array;
// that packing is pure ceremony for a native caller, an allocation per method
// call on the hottest path in the DOM. This is the shape the executor actually
// has. Same body, two doors (ES38); `invoke` stays the door for a caller that
// already holds an array (ESO106).
DOM_RAW(invoke_raw, node, Item, (Item node, JubeDomElementOperation op, Item* args, int argc), dom_element_operation_impl, DOM_F_NATIVE)
DOM_RAW(after_default_checked_set, notify, void, (void* elem, bool checked), dom_after_default_checked_set, DOM_F_NATIVE)
DOM_RAW(after_default_selected_set, notify, void, (void* elem, bool selected), dom_after_default_selected_set, DOM_F_NATIVE)
DOM_RAW(after_disabled_attribute_set, notify, void, (void* elem), dom_after_disabled_attribute_set, DOM_F_NATIVE)
DOM_RAW(after_remove_attribute, notify, void, (void* elem, const char* attr_name), dom_after_remove_attribute, DOM_F_NATIVE)
DOM_RAW(after_select_multiple_removed, notify, void, (void* elem), dom_after_select_multiple_removed, DOM_F_NATIVE)
DOM_RAW(after_set_attribute, notify, void, (void* elem, const char* attr_name, const char* attr_value), dom_after_set_attribute, DOM_F_NATIVE)
DOM_RAW(after_srcdoc_set, notify, void, (void* elem), dom_after_srcdoc_set, DOM_F_NATIVE)
DOM_RAW(after_toggle_attribute_remove, notify, void, (void* elem, const char* attr_name), dom_after_toggle_attribute_remove, DOM_F_NATIVE)
DOM_RAW(append_child_bridge, tree, Item, (void* parent, Item child), dom_append_child_bridge, DOM_F_NATIVE)
DOM_RAW(append_variadic_bridge, tree, Item, (void* elem, Item* args, int argc), dom_append_variadic_bridge, DOM_F_NATIVE)
DOM_RAW(boundary_from_point_bridge, geometry, Item, (void* elem, Item x, Item y, Item behavior), dom_boundary_from_point_bridge, DOM_F_NATIVE)
DOM_RAW(check_validity_bridge, forms, Item, (Item elem_item), dom_check_validity_bridge, DOM_F_NATIVE)
DOM_RAW(click_method_bridge, event, Item, (Item elem_item), dom_click_method_bridge, DOM_F_NATIVE)
DOM_RAW(clone_node_bridge, tree, Item, (void* elem, Item deep, bool has_deep), dom_clone_node_bridge, DOM_F_NATIVE)
DOM_RAW(computed_style_get_property, style, Item, (Item style_item, Item prop_name), dom_computed_style_get_property, DOM_F_NATIVE)
DOM_RAW(dispatch_event_bridge, event, Item, (Item target_item, Item event_item), dom_dispatch_event_bridge, DOM_F_NATIVE)
DOM_RAW(doc_has_browsing_context, document, bool, (void* doc), dom_doc_has_browsing_context, DOM_F_NATIVE)
DOM_RAW(document_active_element_bridge, document, Item, (void* doc), dom_document_active_element_bridge, DOM_F_NATIVE)
DOM_RAW(document_element_from_point_bridge, document, Item, (void* doc, Item x, Item y), dom_document_element_from_point_bridge, DOM_F_NATIVE)
DOM_RAW(document_open_bridge, document, Item, (void* doc), dom_document_open_bridge, DOM_F_NATIVE)
DOM_RAW(document_write_bridge, document, Item, (void* doc, Item text), dom_document_write_bridge, DOM_F_NATIVE)
DOM_RAW(focus_first_invalid_form_control, focus, bool, (void* form_elem), dom_focus_first_invalid_form_control, DOM_F_NATIVE)
DOM_RAW(focus_method_bridge, focus, Item, (void* elem, bool focus), dom_focus_method_bridge, DOM_F_NATIVE)
DOM_RAW(form_reset_bridge, forms, Item, (Item form_item), dom_form_reset_bridge, DOM_F_NATIVE)
DOM_RAW(formdata_collect_form_entries, forms, Item, (void* form_elem, void* submitter_elem), js_formdata_collect_form_entries, DOM_F_NATIVE)
DOM_RAW(get_bounding_client_rect_bridge, geometry, Item, (void* elem), dom_get_bounding_client_rect_bridge, DOM_F_NATIVE)
DOM_RAW(get_client_rects_bridge, geometry, Item, (void* elem), dom_get_client_rects_bridge, DOM_F_NATIVE)
DOM_RAW(get_document, host, void*, (void), dom_get_document, DOM_F_NATIVE)
DOM_RAW(get_foreign_doc, host, void*, (Item item), dom_get_foreign_doc, DOM_F_NATIVE)
DOM_RAW(get_or_create_doc_node, host, void*, (void* doc), dom_get_or_create_doc_node, DOM_F_NATIVE)
