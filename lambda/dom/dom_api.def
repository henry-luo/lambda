DOM_OP(CORE, tc_replace_range, textctl, 4, "fn(n: any, start: int, end: int, text: string) -> bool", dom_core_tc_replace_range, DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, set_caret,        editing, 2, "fn(n: any, offset: int) -> bool",               dom_engine_set_caret, DOM_F_ENGINE | DOM_F_NEUTRAL | DOM_F_MUTATES, "")
