DOM_OP(CORE, is_focusable,     focus, 1, "fn(n: any) -> bool",                              DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, focus_set,        focus, 2, "fn(n: any, from_keyboard: bool) -> bool",         dom_engine_focus_set, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, focused,          focus, 1, "fn(n: any) -> bool",                              dom_engine_focused, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, request_navigation, navigation, 1, "fn(request: map) -> bool",                 DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, navigation_destination, navigation, 3, "fn(src: any, url: string, root: any) -> map", DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, activate_popover, action, 1, "fn(n: any) -> bool",                             DOM_NO_BODY, DOM_F_ENGINE | DOM_F_NEUTRAL, "")

// ---------------------------------------------------------------------------
