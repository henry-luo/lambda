//
// Three helpers are shared by the derivations below and defined once in the
// derived module (they are themselves derivations over core):
//   element_or_next(c) = if (c == null or node_type(c) == 1) c
//                        else element_or_next(next_sibling(c))
//   element_or_prev(c) = if (c == null or node_type(c) == 1) c
//                        else element_or_prev(previous_sibling(c))
//   siblings_from(c)   = if (c == null) null else (c, siblings_from(next_sibling(c)))
//   descendants(n)     = for (c in child_nodes(n)) (c, descendants(c))
// `(head, tail)` builds a FLATTENED sequence and strips nulls, which is how a
// pure `fn` accumulates a list: `var`/`while`/assignment are procedure-only
// (E224), so every derivation here is written functionally and can be a `fn`.
// Engine-resident DOM operations: editing, form validation and submission,
// select and range widget state, embedded documents. Each reads or mutates
// state only the engine has, so the body stays native -- but the *entry
// point* is here, which is what ES45 requires and what lets radiant.* retire.
DOM_OP(CORE, caret_surface, editing, 1, "fn(n: any) -> string|null", dom_engine_caret_surface, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, check_validity, forms, 1, "fn(form: any) -> bool", dom_engine_check_validity, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, close_context_menu, input, 1, "fn(n: any) -> bool", dom_engine_close_context_menu, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, custom_validity, forms, 1, "fn(n: any) -> string", dom_engine_custom_validity, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_delete_dom_range, editing, 1, "fn(n: any) -> bool", dom_engine_dom_delete_dom_range, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_edit_text, editing, 1, "fn(n: any) -> string|null", dom_engine_dom_edit_text, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_insert_html, editing, 2, "fn(n: any, html: string) -> bool", dom_engine_dom_insert_html, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_range_format, editing, 2, "fn(n: any, tag: string) -> bool", dom_engine_dom_range_format, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_replace_dom_range, editing, 2, "fn(n: any, text: string) -> bool", dom_engine_dom_replace_dom_range, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_replace_range, editing, 4, "fn(n: any, start: int, end: int, text: string) -> int|null", dom_engine_dom_replace_range, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_unwrap_range, editing, 4, "fn(n: any, start: int, end: int, tag: string) -> bool", dom_engine_dom_unwrap_range, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dom_wrap_range, editing, 4, "fn(n: any, start: int, end: int, tag: string) -> bool", dom_engine_dom_wrap_range, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, dropdown_open, select, 1, "fn(n: any) -> bool", dom_engine_dropdown_open, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, embedded_document_root, document, 1, "fn(iframe: any) -> any", dom_engine_embedded_document_root, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
