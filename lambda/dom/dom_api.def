DOM_OP(CORE, edit_start, editing, 1, "fn(host: any) -> int", dom_engine_edit_start, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, edit_end, editing, 1, "fn(host: any) -> int", dom_engine_edit_end, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
DOM_OP(CORE, tc_value,         textctl, 1, "fn(n: any) -> string",                          dom_engine_tc_value, DOM_F_ENGINE | DOM_F_NEUTRAL, "")
