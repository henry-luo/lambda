DOM_OP(CORE, bounding_box,     geometry, 1, "fn(n: any) -> map|null",                       dom_core_bounding_box,     DOM_F_NEUTRAL, "")
DOM_OP(CORE, client_rects,     geometry, 1, "fn(n: any) -> array",                          dom_core_client_rects,     DOM_F_NEUTRAL | DOM_F_SNAPSHOT, "")
DOM_OP(CORE, scroll_state,     geometry, 1, "fn(n: any) -> map",                            dom_core_scroll_state,     DOM_F_NEUTRAL, "")
DOM_OP(CORE, set_scroll_state, geometry, 3, "fn(n: any, x: float, y: float) -> null",       dom_core_set_scroll_state, DOM_F_NEUTRAL | DOM_F_MUTATES, "")
DOM_OP(CORE, element_from_point, geometry, 3, "fn(doc: any, x: float, y: float) -> any",    dom_core_element_from_point, DOM_F_NEUTRAL, "")
DOM_OP(CORE, scroll_into_view, geometry, 1, "fn(n: any) -> bool",                           dom_core_scroll_into_view, DOM_F_NEUTRAL, "")

// ---------------------------------------------------------------------------
