// dom_element_ops.def — the DOM element-operation ordinals, declared once.
//
// One row per operation. The ordinal enum (jube.h), the radiant module's
// binding thunks and their `extern` declarations are all expansions of this
// file; before it, each operation was written out three times and the three
// had to agree by inspection.
//
//   DOM_ELEMENT_OP(NAME, thunk)
//
//   NAME   enum suffix; the ordinal is JUBE_DOM_<NAME>
//   thunk  symbol suffix; the module binding is radiant_dom_m4d_<thunk>.
//          Equal to lowercase(NAME) for all but the three `__lambda_`
//          automation entries, whose script-facing spelling is deliberately
//          reserved rather than derived.
//
// ROW ORDER IS THE ABI: the ordinal is the value passed across the host API,
// so rows are appended, never reordered or removed in place.
//
// This is a staging table. Once dom_api.def rows carry their receiver
// interface and JS spelling (DS1), these rows merge into it and the enum stops
// existing (DS2) -- see vibe/impl/Lambda_Impl_DOM_Simplify.md.

#ifndef DOM_ELEMENT_OP
#error "define DOM_ELEMENT_OP(NAME, thunk) before including dom_element_ops.def"
#endif

DOM_ELEMENT_OP(NAMED_ITEM, named_item)
DOM_ELEMENT_OP(ADD, add)
DOM_ELEMENT_OP(REMOVE, remove)
DOM_ELEMENT_OP(CONTAINS, contains)
DOM_ELEMENT_OP(COMPARE_DOCUMENT_POSITION, compare_document_position)
DOM_ELEMENT_OP(GET_ROOT_NODE, get_root_node)
DOM_ELEMENT_OP(REPLACE_WITH, replace_with)
DOM_ELEMENT_OP(HAS_CHILD_NODES, has_child_nodes)
DOM_ELEMENT_OP(CLONE_NODE, clone_node)
DOM_ELEMENT_OP(REPLACE_DATA, replace_data)
DOM_ELEMENT_OP(INSERT_DATA, insert_data)
DOM_ELEMENT_OP(APPEND_DATA, append_data)
DOM_ELEMENT_OP(DELETE_DATA, delete_data)
DOM_ELEMENT_OP(SUBSTRING_DATA, substring_data)
DOM_ELEMENT_OP(GET_ATTRIBUTE, get_attribute)
DOM_ELEMENT_OP(SET_ATTRIBUTE, set_attribute)
DOM_ELEMENT_OP(REMOVE_ATTRIBUTE, remove_attribute)
DOM_ELEMENT_OP(TOGGLE_ATTRIBUTE, toggle_attribute)
DOM_ELEMENT_OP(HAS_ATTRIBUTE, has_attribute)
DOM_ELEMENT_OP(GET_ATTRIBUTE_NAMES, get_attribute_names)
DOM_ELEMENT_OP(MATCHES, matches)
DOM_ELEMENT_OP(QUERY_SELECTOR, query_selector)
DOM_ELEMENT_OP(QUERY_SELECTOR_ALL, query_selector_all)
DOM_ELEMENT_OP(CLOSEST, closest)
DOM_ELEMENT_OP(GET_ELEMENTS_BY_TAG_NAME, get_elements_by_tag_name)
