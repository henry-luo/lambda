DOM_ELEMENT_OP(GET_ELEMENT_BY_ID, get_element_by_id)
DOM_ELEMENT_OP(ADD_EVENT_LISTENER, add_event_listener)
DOM_ELEMENT_OP(REMOVE_EVENT_LISTENER, remove_event_listener)
DOM_ELEMENT_OP(DISPATCH_EVENT, dispatch_event)
DOM_ELEMENT_OP(APPEND_CHILD, append_child)
DOM_ELEMENT_OP(REMOVE_CHILD, remove_child)
DOM_ELEMENT_OP(INSERT_BEFORE, insert_before)
DOM_ELEMENT_OP(REPLACE_CHILD, replace_child)
DOM_ELEMENT_OP(NORMALIZE, normalize)
