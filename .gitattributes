# Force LF line endings for all files (project developed on macOS/Linux)
* text=auto eol=lf

# empty final TSV fields require trailing tab delimiters.
test/css/support_inventory.tsv whitespace=-blank-at-eol

# Explicitly force LF for tree-sitter generated/vendored files
lambda/tree-sitter/**        text eol=lf
lambda/tree-sitter-lambda/** text eol=lf
lambda/tree-sitter-javascript/** text eol=lf

# Binary files - don't touch
*.a    binary
*.o    binary
*.exe  binary
*.dll  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary

# io.grep fixtures: keep their CRLF line endings (test/lambda/proc/io_grep.ls)
test/input/grep_tree/crlf.txt -text
test/input/grep_tree/eol.txt -text
test/input/fts_tree/crlf.txt -text

# RFC round-trip fixtures require their exact CRLF wire representation.
test/input/script_formats/*.eml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
test/input/script_formats/*.vcf -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
test/input/script_formats/*.ics -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# preserve the pinned upstream SoundFont header and its recorded checksum
lib/tinysoundfont/tsf.h -text

# preserve archive-reader upstream bytes, including the Android header's CRLF
lib/zip/*.[ch] -text
