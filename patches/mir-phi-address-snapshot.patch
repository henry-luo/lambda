@@ -5643,7 +5642,7 @@ static int var_plus_const (gen_ctx_t gen_ctx, ssa_edge_t se, bb_t from_bb, MIR_o
   } else {
     return FALSE;
   }
-  if ((se = res_ref->data) != NULL && se->def->bb != from_bb && cycle_phi_p (se->def)) return FALSE;
+  if ((se = res_ref->data) != NULL && outside_phi_p (se->def, from_bb)) return FALSE;
   *var_op_ref = res_ref;
   return TRUE;
 }
