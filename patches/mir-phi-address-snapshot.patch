Preserve saved PHI values when folding addresses across basic blocks.

Approved 2026-11-03, USER. Conventional SSA assigns a PHI's register on its
incoming edges. A move after the PHI snapshots its current value. Forwarding
that PHI register into a later block can instead read the next iteration's
assignment. The old same-block-cycle test missed multi-block loops.

Use one guard for the existing add, multiply and indexed-address consumers:
a PHI may only be forwarded within its own block. No optimization pass is
disabled. Regression: test/mir/native/phi_saved_loop_value.mir and
MirOptimizer.CrossBlockPhiAddressFoldingKeepsSavedValue.

diff --git a/mir-gen.c b/mir-gen.c
index c80c08b34b..36865e1ed8 100644
--- a/mir-gen.c
+++ b/mir-gen.c
@@ -5614,12 +5614,11 @@ static int get_int_const (gen_ctx_t gen_ctx, MIR_op_t *op_ref, int64_t *c) {
   return TRUE;
 }

-static int cycle_phi_p (bb_insn_t bb_insn) { /* we are not in pure SSA at this stage */
-  ssa_edge_t se;
-  if (bb_insn->insn->code != MIR_PHI) return FALSE;
-  for (size_t i = 1; i < bb_insn->insn->nops; i++)
-    if ((se = bb_insn->insn->ops[i].data) != NULL && se->def->bb == bb_insn->bb) return TRUE;
-  return FALSE;
+static int outside_phi_p (bb_insn_t bb_insn, bb_t from_bb) {
+  /* conventional SSA assigns phi registers on incoming edges. A saved move
+     snapshots that value; bypassing it in another block can read the next
+     iteration's assignment, including in multi-block loops. */
+  return bb_insn->bb != from_bb && bb_insn->insn->code == MIR_PHI;
 }

