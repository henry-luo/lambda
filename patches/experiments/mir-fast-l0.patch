+/* Share assignment setup; the compact variant keeps the ordinary L0 priority. */
+static void fast_l0_order (gen_ctx_t gen_ctx, int ranges_p) {
+  MIR_reg_t max_var = get_max_var (gen_ctx);
+  reg_info_t *infos = VARR_ADDR (reg_info_t, curr_cfg->reg_info);
+  func_stack_slots_num = 0;
+  VARR_TRUNC (MIR_reg_t, reg_renumber, 0);
+  VARR_TRUNC (allocno_info_t, sorted_regs, 0);
+  for (MIR_reg_t var = 0; var <= max_var; var++) {
+    VARR_PUSH (MIR_reg_t, reg_renumber, MIR_NON_VAR);
+    if (var <= MAX_HARD_REG) continue;
+    if (bitmap_bit_p (addr_regs, var)) {
+      int slots;
+      MIR_type_t type = MIR_reg_type (gen_ctx->ctx, var - MAX_HARD_REG, curr_func_item->u.func);
+      MIR_reg_t loc = get_new_stack_slot (gen_ctx, type, &slots);
+      VARR_SET (MIR_reg_t, reg_renumber, var, loc);
+      continue;
+    }
+    if (!ranges_p && infos[var].freq == 0) continue;
+    infos[var].live_length = ranges_p ? 0 : 1;
+    if (ranges_p)
+      for (live_range_t lr = VARR_GET (live_range_t, var_live_ranges, var); lr; lr = lr->next)
+        infos[var].live_length += lr->finish - lr->start + 1;
+    allocno_info_t entry = {var, FALSE, infos};
+    VARR_PUSH (allocno_info_t, sorted_regs, entry);
+  }
+  qsort (VARR_ADDR (allocno_info_t, sorted_regs), VARR_LENGTH (allocno_info_t, sorted_regs),
+         sizeof (allocno_info_t), allocno_info_compare_func);
+}
