+/* Probe only words touched by this pseudo's live ranges, skipping empty prefixes. */
+static int compact_l0_conflict (bitmap_t points, bitmap_t occupied, live_range_t ranges) {
+  size_t length = VARR_LENGTH (bitmap_el_t, occupied);
+  bitmap_el_t *a = VARR_ADDR (bitmap_el_t, points), *b = VARR_ADDR (bitmap_el_t, occupied);
+  for (live_range_t lr = ranges; lr; lr = lr->next) {
+    size_t last = (size_t) lr->finish / BITMAP_WORD_BITS;
+    if (last >= length) last = length;
+    for (size_t word = (size_t) lr->start / BITMAP_WORD_BITS;
+         word <= last && word < length; word++)
+      if ((a[word] & b[word]) != 0) return TRUE;
+  }
+  return FALSE;
+}
