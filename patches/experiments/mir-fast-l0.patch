+/* Experimental whole-function homes: no liveness fixed point, live ranges,
+   interference bitmaps or stack-slot coloring.  Existing reload/ABI code stays. */
+static int fast_l0_p (gen_ctx_t gen_ctx) {
+  return optimize_level == 0 && gen_ctx->fast_l0 != 0 && bitmap_empty_p (tied_regs);
+}
+
+static void fast_l0_assign (gen_ctx_t gen_ctx) {
+  MIR_context_t ctx = gen_ctx->ctx;
+  MIR_reg_t var;
+  MIR_func_t func = curr_func_item->u.func;
+  bitmap_t occupied = temp_bitmap;
+  bitmap_t globals = _MIR_get_module_global_var_hard_regs (ctx, curr_func_item->module);
+  insn_var_iterator_t iter;
+  int op_num, slots;
+
+  func_stack_slots_num = 0;
+  bitmap_clear (func_used_hard_regs);
+  bitmap_copy (occupied, call_used_hard_regs[MIR_T_UNDEF]);
+  if (globals != NULL) bitmap_ior (occupied, occupied, globals);
+  /* Explicit machine operands and early clobbers must never alias a fixed home. */
+  for (MIR_insn_t insn = DLIST_HEAD (MIR_insn_t, func->insns); insn != NULL;
+       insn = DLIST_NEXT (MIR_insn_t, insn)) {
+    MIR_reg_t clobber1, clobber2;
+    FOREACH_IN_INSN_VAR (gen_ctx, iter, insn, var, op_num)
+      if (var <= MAX_HARD_REG) bitmap_set_bit_p (occupied, var);
+    FOREACH_OUT_INSN_VAR (gen_ctx, iter, insn, var, op_num)
+      if (var <= MAX_HARD_REG) bitmap_set_bit_p (occupied, var);
+    target_get_early_clobbered_hard_regs (insn, &clobber1, &clobber2);
+    if (clobber1 != MIR_NON_VAR) bitmap_set_bit_p (occupied, clobber1);
+    if (clobber2 != MIR_NON_VAR) bitmap_set_bit_p (occupied, clobber2);
+  }
+  fast_l0_order (gen_ctx, FALSE);
+  for (size_t i = 0; i < VARR_LENGTH (allocno_info_t, sorted_regs); i++) {
+    var = VARR_GET (allocno_info_t, sorted_regs, i).reg;
+    MIR_type_t type = MIR_reg_type (ctx, var - MAX_HARD_REG, func);
+    MIR_reg_t loc = MIR_NON_VAR;
+    if (gen_ctx->fast_l0 == 2 && !bitmap_bit_p (addr_regs, var))
+      loc = get_hard_reg (gen_ctx, type, occupied);
+    if (loc == MIR_NON_VAR) {
+      loc = get_new_stack_slot (gen_ctx, type, &slots);
+    } else {
+      setup_used_hard_regs (gen_ctx, type, loc);
+      for (int n = 0; n < target_locs_num (loc, type); n++)
+        bitmap_set_bit_p (occupied, target_nth_loc (loc, type, n));
+    }
+    VARR_SET (MIR_reg_t, reg_renumber, var, loc);
+  }
+}
