+/* Transpose occupancy: one bitmap of live points per location, rather than
+   one bitmap of locations per point. Preserve L0 ordering and stack coloring. */
+static void compact_l0_assign (gen_ctx_t gen_ctx) {
+  MIR_alloc_t alloc = gen_alloc (gen_ctx);
+  MIR_context_t ctx = gen_ctx->ctx;
+  bitmap_t points = temp_bitmap2, conflicts = conflict_locs1;
+  bitmap_t globals = _MIR_get_module_global_var_hard_regs (ctx, curr_func_item->module);
+  int slots;
+
+  fast_l0_order (gen_ctx, TRUE);
+  start_mem_loc = func_stack_slots_num + MAX_HARD_REG + 1;
+  bitmap_clear (func_used_hard_regs);
+  while (VARR_LENGTH (bitmap_t, used_locs) <= MAX_HARD_REG)
+    VARR_PUSH (bitmap_t, used_locs, bitmap_create2 (alloc, 128));
+  for (size_t i = 0; i < VARR_LENGTH (bitmap_t, used_locs); i++)
+    bitmap_clear (VARR_GET (bitmap_t, used_locs, i));
+  for (MIR_reg_t reg = 0; reg <= MAX_HARD_REG; reg++)
+    for (live_range_t lr = VARR_GET (live_range_t, var_live_ranges, reg); lr; lr = lr->next)
+      bitmap_set_bit_range_p (VARR_GET (bitmap_t, used_locs, reg),
+                             lr->start, lr->finish - lr->start + 1);
+  for (size_t i = 0; i < VARR_LENGTH (allocno_info_t, sorted_regs); i++) {
+    MIR_reg_t reg = VARR_GET (allocno_info_t, sorted_regs, i).reg;
+    live_range_t lr = VARR_GET (live_range_t, var_live_ranges, reg);
+    if (lr == NULL) continue;
+    bitmap_clear (points);
+    for (; lr; lr = lr->next)
+      bitmap_set_bit_range_p (points, lr->start, lr->finish - lr->start + 1);
+    bitmap_clear (conflicts);
+    if (globals != NULL) bitmap_copy (conflicts, globals);
+    live_range_t ranges = VARR_GET (live_range_t, var_live_ranges, reg);
+    for (size_t loc = 0; loc <= MAX_HARD_REG; loc++)
+      if (compact_l0_conflict (points, VARR_GET (bitmap_t, used_locs, loc), ranges))
+        bitmap_set_bit_p (conflicts, loc);
+    MIR_type_t type = MIR_reg_type (ctx, reg - MAX_HARD_REG, curr_func_item->u.func);
+    MIR_reg_t loc = get_hard_reg (gen_ctx, type, conflicts);
+    if (loc == MIR_NON_VAR) {
+      /* Stack interference matters only after hard registers are exhausted. */
+      for (size_t slot = start_mem_loc; slot < VARR_LENGTH (bitmap_t, used_locs); slot++)
+        if (compact_l0_conflict (points, VARR_GET (bitmap_t, used_locs, slot), ranges))
+          bitmap_set_bit_p (conflicts, slot);
+      loc = get_stack_loc (gen_ctx, start_mem_loc, type, conflicts, &slots);
+    } else {
+      setup_used_hard_regs (gen_ctx, type, loc);
+    }
+    VARR_SET (MIR_reg_t, reg_renumber, reg, loc);
+    slots = target_locs_num (loc, type);
+    for (int n = 0; n < slots; n++) {
+      MIR_reg_t part = target_nth_loc (loc, type, n);
+      while (VARR_LENGTH (bitmap_t, used_locs) <= part)
+        VARR_PUSH (bitmap_t, used_locs, bitmap_create2 (alloc, 128));
+      bitmap_t occupied = VARR_GET (bitmap_t, used_locs, part);
+      for (live_range_t range = ranges; range; range = range->next)
+        bitmap_set_bit_range_p (occupied, range->start, range->finish - range->start + 1);
+    }
+  }
+}
