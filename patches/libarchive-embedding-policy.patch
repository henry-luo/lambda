+int
+archive_read_set_charset(struct archive *_a, const char *charset,
+    int preserve_unicode)
+{
+    char *copy;
+
+    archive_check_magic(_a, ARCHIVE_READ_MAGIC, ARCHIVE_STATE_NEW,
+        "archive_read_set_charset");
+    if (charset == NULL || charset[0] == '\0') {
+        archive_set_error(_a, EINVAL, "An application charset is required");
+        return ARCHIVE_FAILED;
+    }
+    copy = strdup(charset);
+    if (copy == NULL) {
+        archive_set_error(_a, ENOMEM, "Cannot allocate application charset");
+        return ARCHIVE_FATAL;
+    }
+    free(_a->current_code);
+    _a->current_code = copy;
+#if defined(_WIN32) && !defined(__CYGWIN__)
+    if (strcmp(charset, "UTF-8") == 0)
+        _a->current_codepage = CP_UTF8;
+#endif
+
+    _a->preserve_unicode = preserve_unicode != 0;
+    return ARCHIVE_OK;
+}
